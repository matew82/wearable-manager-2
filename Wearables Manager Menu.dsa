(function () {
	// Qt 6 uses a small default iconSize even when pixmap is larger.
	function setWearablesButtonPixmap(button, pixmap, iconSize) {
		button.pixmap = pixmap;
		if (parseInt(App.versionString, 10) < 6 || !pixmap || pixmap.isNull()) return;
		button.getWidget().iconSize = iconSize || new Size(pixmap.width, pixmap.height);
	}

