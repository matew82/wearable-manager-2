var sWM2ResourcesPath = new DzFileInfo(getScriptFileName()).path() + "/Resources";
include(sWM2ResourcesPath + "/WM2 Support.dsa");
include(sWM2ResourcesPath + "/WM2 Settings UI.dsa");

(function () {
	// Qt 6 uses a small default iconSize even when pixmap is larger.
	function setWearablesButtonPixmap(button,pixmap,iconSize) {
		WM2Support.setMenuPixmap(button,pixmap,iconSize);
	}

	/*-----------------------------------------------------------------*\
							   DECLARATIONS
	\*-----------------------------------------------------------------*/

	var PATH_TEMP = App.getTempPath() + "/matew/";

	var PATH_ICONS = sWM2ResourcesPath;
	var JSON_NAME = "Wearables Manager.json";
	var ICONS_EXTENSION = ".PNG";

	var DATA_ITEM_NAME = "MatewWearables";
	var SETTINGS_FILE_NAME = "FileName";
	var SETTINGS_ID = "ID";
	var SETTINGS_UVS = "UV";
	var SETTINGS_TARGET = "Target";
	var SETTINGS_COLLISION_ITEM = "Collision_Item";
	var SETTIGNS_TRANSFER = "Transfer";
	var VALUE_TRANSFER_YES = "Yes";
	var VALUE_TRANSFER_NO = "No";
	var VALUE_EMISSIVE = "Emissive"

	var ARRAY_SEPARATOR = ",,";
	var ARR_HUMAN_FIGURES_NAMES = ["Genesis", "Genesis2Female", "Genesis2Male", "Genesis3Female", "Genesis3Male", "Genesis8Female", "Genesis8Male", "Genesis8_1Female", "Genesis8_1Male", "Genesis9"];
	var oWM2Config = WM2Support.load(PATH_ICONS).config;

	// Launch-time Alt overrides belong to the Full launcher.
	var bAltPressed = false;
	var bTransferByDefault = true;



	var oNode, oHumanFigure;
	var oWearablesManager;
	var dialog_result = false;

	/*-----------------------------------------------------------------*\
						WEARABLES ICONS CLASS
	\*-----------------------------------------------------------------*/
	function WearablesIconsClass() {
		return WM2Support.createIconResolver(PATH_ICONS,function(){return typeof oWM2Config!=="undefined" && oWM2Config ? oWM2Config.iconRules : [];});
	}

	/*-----------------------------------------------------------------*\
						TAG IMAGE MANAGER CLASS
	\*-----------------------------------------------------------------*/
	function TagImageManagerClass(oHumanFigure) {
		/*
		<--------------- DECLARATIONS ---------------->
		*/
		this.TAG_IMAGE_LIGHT = 0;
		this.TAG_IMAGE_EMISSIVE = 1;
		this.TAG_IMAGE_VISIBILITY = 2;
		this.TAG_IMAGE_FIT_TO = 3;
		this.TAG_IMAGE_DFORCE = 4;
		this.TAG_IMAGE_SUBD = 5;
		this.TAG_IMAGE_SMOOTH = 6;

		function TagImageItemClass() {
			this.type;
			this.wearable;
			this.widgetImageHumanFigure;
			this.widgetImageGroup;
		}

		var arrPixmaps = {}; // arrPixmaps[icon name with extension] = pixmap object

		var arrTagImages = [];
		this.container;
		this.layout;
		this.bHumanContainer;
		this.humanFigure = oHumanFigure;

		/*
		<--------------- PRIVATE ---------------->
		*/

		this.iGetPixmapByIconName = function (sIconName) {
			//sIconName = name of the icon file with extension
			if (arrPixmaps.hasOwnProperty(sIconName)) return arrPixmaps[sIconName];

			//create a new pixmap
			var dir_icons = new DzDir(PATH_ICONS);
			var oPixMap = new Pixmap(dir_icons.filePath(sIconName));
			if (!oPixMap) {
				dir_icons.deleteLater();
				return false;
			}

			//save pixmap and return it
			arrPixmaps[sIconName] = oPixMap;
			return oPixMap;
			dir_icons.deleteLater();
		}

		this.iFindTagImageItem = function (oWearable, eType) {
			var n = arrTagImages.length;
			if (n == 0) return false;
			var sID = oWearable.elementID;

			for (var i = 0; i < n; i++) {
				var oItem = arrTagImages[i];
				if (oItem.type == eType && oItem.wearable.elementID == sID) return oItem;
			}

			return false;
		}

		this.iCreateTagImageWidget = function (oWearable, arrWidgetData, fSignal) {
			if (!arrWidgetData) return false;
			//arrWidgetData [0 - tool tip, 1 - pixmap]
			var IMG_SIZE = 30;
			var wImage = new DzPushButton(this.container);
			wImage.sizedFromIcon = true;
			wImage.buttonStyle = DzPushButton.BTool;
			wImage.setFixedSize(IMG_SIZE, IMG_SIZE);
			wImage.text = "";
			wImage.toolTip = arrWidgetData[0];
			setWearablesButtonPixmap(wImage, arrWidgetData[1]);
			wImage.wearable = oWearable;
			connect(wImage, "clicked()", wImage, fSignal);

			this.layout.addWidget(wImage);
			return wImage;
		}

		this.iUpdateTagIcon = function (oWearable, eType) {
			if (!oWearable) return false;
			var cItem = this.iFindTagImageItem(oWearable, eType);
			if (!cItem) return;

			var wImage1 = cItem.widgetImageHumanFigure;
			var wImage2 = cItem.widgetImageGroup;
			if (!wImage1 || !wImage2) return;

			if (eType == this.TAG_IMAGE_VISIBILITY) {
				var arrInfo = this.iGetIconAndDescription_Visibility(oWearable);
			} else if (eType == this.TAG_IMAGE_LIGHT) {
				var arrInfo = this.iGetIconAndDescription_Light(oWearable);
			} else if (eType == this.TAG_IMAGE_EMISSIVE) {
				var arrInfo = this.iGetIconAndDescription_Emissive(oWearable);
			} else if (eType == this.TAG_IMAGE_FIT_TO) {
				var arrInfo = this.iGetIconAndDescription_FitTo(oWearable);
			} else if (eType == this.TAG_IMAGE_DFORCE) {
				var arrInfo = this.iGetIconAndDescription_Simulation(oWearable);
			} else if (eType == this.TAG_IMAGE_SUBD) {
				var arrInfo = this.iGetIconAndDescription_Resolution(oWearable);
			} else if (eType == this.TAG_IMAGE_SMOOTH) {
				var arrInfo = this.iGetIconAndDescription_Smooth(oWearable);
			}

			if (!arrInfo) return;
			wImage1.toolTip = arrInfo[0];
			setWearablesButtonPixmap(wImage1, arrInfo[1]);
			wImage2.toolTip = arrInfo[0];
			setWearablesButtonPixmap(wImage2, arrInfo[1]);
		}

		this.iGetIconAndDescription_Visibility = function (oWearable) {
			var oHelper = DzSceneHelper();
			var oVisibleProp = oHelper.findPropertyByInternalName("Visible", oWearable);
			if (!oVisibleProp) return false;
			var sToolTip, oPixMap;


			var bVisible = oVisibleProp.getBoolValue();
			if (bVisible) {
				//Visible in general
				var oVisibleInRenderProp = oHelper.findPropertyByInternalName("Renderable", oWearable); // Visible in Render
				var oVisibleInViewportProp = oHelper.findPropertyByInternalName("Visible in Viewport", oWearable); // Visible in Viewport

				var bVisibleInRender = true;
				var bVisibleInViewport = true;

				if (oVisibleInRenderProp && oVisibleInViewportProp) {
					bVisibleInRender = oVisibleInRenderProp.getBoolValue();
					bVisibleInViewport = oVisibleInViewportProp.getBoolValue();
					bVisible = bVisibleInRender && bVisibleInViewport;
				}

				if (bVisible) {
					sToolTip = "Element is visible."
					oPixMap = this.iGetPixmapByIconName("Wearables Manager - Visible.png");
				} else {
					if (!bVisibleInRender & !bVisibleInViewport) {
						//Not really visible
						sToolTip = "Element is hidden. 'Visible' property is true, but both 'Visible In Render' and 'Visible In Viewport' are false."
						oPixMap = this.iGetPixmapByIconName("Wearables Manager - Hidden.png");
					} else if (!bVisibleInRender) {
						// Partially Visible - not visible in Render, Visible in Viewport
						sToolTip = "Element is visible in Viewport, but invisible in render."
						oPixMap = this.iGetPixmapByIconName("Wearables Manager - Partially Visible.png");
					} else {
						// Partially Visible - Visible in Render, not visible in Viewport
						sToolTip = "Element will be visible in render, but it's invisible in Viewport."
						oPixMap = this.iGetPixmapByIconName("Wearables Manager - Partially Visible.png");
					}
				}
			} else {
				//Not visible
				sToolTip = "Element is hidden."
				oPixMap = this.iGetPixmapByIconName("Wearables Manager - Hidden.png");
			}

			return [sToolTip, oPixMap];
		}

		this.iGetIconAndDescription_Light = function (oWearable) {
			if (!oWearable.inherits("DzLight")) return false;

			var isIlluminationOn = oWearable.isOn();
			if (isIlluminationOn) {
				//Visible
				sToolTip = "The light is ON."
				oPixMap = this.iGetPixmapByIconName("Wearables Manager - Light On.png");
			} else {
				//Not visible
				sToolTip = "The light is OFF."
				oPixMap = this.iGetPixmapByIconName("Wearables Manager - Light Off.png");
			}

			return [sToolTip, oPixMap];
		}

		this.iGetIconAndDescription_Emissive = function (oWearable) {
			var arrEmissives = this.iWearableEmissivesCount(oWearable); //[active emissives n, inactive emissives n]

			if (!arrEmissives && !Array.isArray(arrEmissives)) return false;

			var iActiveEmissivesCount = arrEmissives[0];
			var iInactiveEmissivesCount = arrEmissives[1];
			if (iActiveEmissivesCount == 0 && iInactiveEmissivesCount == 0) return false;

			if (iActiveEmissivesCount == 1) {
				var sToolTip = oWearable.getLabel() + " has one active emissive surface";
			} else if (iActiveEmissivesCount > 1) {
				var sToolTip = oWearable.getLabel() + " has " + iActiveEmissivesCount.toString() + " active emissive surfaces";
			} else {
				var sToolTip = oWearable.getLabel() + " has ";
			}

			if (iInactiveEmissivesCount == 1) {
				if (iActiveEmissivesCount == 0) {
					sToolTip += "one inactivated emissive surface.";
				} else {
					sToolTip += " and one turned off.";
				}
			} else if (iInactiveEmissivesCount > 1) {
				if (iActiveEmissivesCount == 0) {
					sToolTip += iInactiveEmissivesCount.toString() + " inactivated emissive surfaces.";
				} else {
					sToolTip += " and " + iInactiveEmissivesCount.toString() + " turned off.";
				}

			} else {
				sToolTip += ".";
			}

			if (iActiveEmissivesCount > 0 && iInactiveEmissivesCount == 0) {
				oPixMap = this.iGetPixmapByIconName("Wearables Manager - Emissive.png");
			} else if (iActiveEmissivesCount > 0) {
				oPixMap = this.iGetPixmapByIconName("Wearables Manager - Emissive Half.png");
			} else {
				oPixMap = this.iGetPixmapByIconName("Wearables Manager - Emissive Off.png");
			}

			return [sToolTip, oPixMap];
		}

		this.iWearableEmissivesCount = function (oWearable) {
			var oHelper = DzSceneHelper();
			var arrMaterials = this.iGetMaterialsArray(oWearable);
			if (!arrMaterials) return false;
			var iEmissivesActiveCount = 0;
			var iEmissivesInactiveCount = 0;
			var arrEmissiveColors = this.iRetreiveEmissivesFromTag(oWearable) || {}; //item[material] = color

			for (var i = 0; i < arrMaterials.length; i++) {
				var oMaterial = arrMaterials[i];
				var sMaterialName = oMaterial.name;
				var oProp = oHelper.findPropertyOnMaterial("Emission Color", oMaterial);
				if (!oProp) continue;

				var oCurrentColor = oProp.getColorValue();
				if (oCurrentColor.value != 0) {
					//emissive is on
					iEmissivesActiveCount++;
					continue;
				}

				//emissive is off
				if (!Object.prototype.hasOwnProperty.call(arrEmissiveColors, sMaterialName)) continue; //not an emissive surface - continue;

				iEmissivesInactiveCount++; //incativated emissive
			}
			return [iEmissivesActiveCount, iEmissivesInactiveCount];
		}

		this.iGetShape = function (oWearable) {
			if (!oWearable) return null;
			var oObject = oWearable.getObject();
			if (!oObject) return null;
			return oObject.getCurrentShape();
		}

		this.iGetMaterialsArray = function (oWearable) {
			var oShape = this.iGetShape(oWearable);
			if (!oShape) return false;
			return oShape.getAllMaterials();
		}

		this.iSelectEmissiveMaterials = function (oWearable) {
			if (!oWearable) return;

			Scene.selectAllNodes(false);
			Scene.setPrimarySelection(oWearable);
			processEvents();
			var oPaneMgr = MainWindow.getPaneMgr();
			var oPane = oPaneMgr.findPane("DzSurfacesPane");
			if (!oPane) return;
			if (!oPane.visible) {
				oPane.showPane();
				processEvents();
			}

			var oHelper = DzSceneHelper();
			var arrMaterials = this.iGetMaterialsArray(oWearable);
			if (!arrMaterials) return;
			var arrEmissiveColors = this.iRetreiveEmissivesFromTag(oWearable) || {}; //item[material] = color

			for (var i = 0; i < arrMaterials.length; i++) {
				var oMaterial = arrMaterials[i];
				var sMaterialName = oMaterial.name;
				var oProp = oHelper.findPropertyOnMaterial("Emission Color", oMaterial);
				if (!oProp) {
					oMaterial.select(false);
					continue;
				}

				var oCurrentColor = oProp.getColorValue();
				if (oCurrentColor.value != 0) {
					//emissive is on
					oMaterial.select(true);
					continue;
				}

				//emissive is off
				if (!Object.prototype.hasOwnProperty.call(arrEmissiveColors, sMaterialName)) {
					//not an emissive surface - continue;
					oMaterial.select(false);
					continue;
				}

				oMaterial.select(true); //incativated emissive
			}

		}

		this.iRetreiveEmissivesFromTag = function (oWearable) {
			if (!oWearable) return false;
			var oData = oWearable.findDataItem(DATA_ITEM_NAME);
			if (!oData) return false;
			var oDataSettings = oData.getSettings();
			if (!oDataSettings) return false;
			var sFullString = oDataSettings.getStringValue(VALUE_EMISSIVE, "");
			if (!sFullString) return false;
			try {
				var arrEmissiveColors = JSON.parse(sFullString);
				if (!arrEmissiveColors || typeof arrEmissiveColors != "object" || Array.isArray(arrEmissiveColors)) throw new Error("Expected a material/color map.");
				var arrMaterialNames = Object.keys(arrEmissiveColors);
				for (var i = 0; i < arrMaterialNames.length; i++) {
					var sMaterialName = arrMaterialNames[i];
					var colorData = arrEmissiveColors[sMaterialName];
					if (!colorData || typeof colorData != "object" || Array.isArray(colorData)) throw new Error("Invalid color for " + sMaterialName);
					var channels = [colorData.red, colorData.green, colorData.blue, colorData.alpha];
					for (var j = 0; j < channels.length; j++) {
						if (typeof channels[j] != "number" || !isFinite(channels[j]) || channels[j] < 0 || channels[j] > 255) throw new Error("Invalid color channel for " + sMaterialName);
					}
					arrEmissiveColors[sMaterialName] = new Color(channels[0], channels[1], channels[2], channels[3]);
				}
				return arrEmissiveColors;
			} catch (e) {
				print("Wearables Manager: invalid emissive recovery metadata on " + oWearable.getLabel() + ": " + e.message);
				return null; // Invalid metadata is kept unchanged; writes must refuse this record.
			}
		}

		this.iAddEmissiveTagToWearable = function (oWearable) {
			var arrEmissiveColors = this.iRetreiveEmissivesFromTag(oWearable); //item[material] = color
			if (arrEmissiveColors === null) return null;
			if (!arrEmissiveColors) {
				arrEmissiveColors = {};
			}

			var arrMaterials = this.iGetMaterialsArray(oWearable);
			if (!arrMaterials) return;

			var oHelper = DzSceneHelper();
			for (var i = 0; i < arrMaterials.length; i++) {
				var oMaterial = arrMaterials[i];
				var oProp = oHelper.findPropertyOnMaterial("Emission Color", oMaterial);
				if (!oProp) continue;
				var oColor = oProp.getColorValue();
				if (oColor.value != 0) {
					arrEmissiveColors[oMaterial.name] = oColor;
				}
			}

			this.iAddStringDataToNode(oWearable, DATA_ITEM_NAME, VALUE_EMISSIVE, JSON.stringify(arrEmissiveColors));
			return arrEmissiveColors;
		}

		this.iAddStringDataToNode = function (oNode, sDataName, sKey, sValue) {
			if (!sKey || !sDataName || !oNode) return;

			var oData = oNode.findDataItem(sDataName);
			if (!oData) {
				oData = new DzSimpleElementData(sDataName, true);
				oNode.addDataItem(oData);
			}
			var oDataSettings = oData.getSettings();
			oDataSettings.setStringValue(sKey, sValue);
		}

		this.iToggleEmissives = function (oWearable) {
			if (!oWearable) return false;
			var saved = this.iRetreiveEmissivesFromTag(oWearable);
			if (saved === null) { err("Invalid emissive recovery metadata; the existing record was kept unchanged."); return false; }
			saved = saved || {};
			var materials = this.iGetMaterialsArray(oWearable);
			if (!materials) return false;
			var updates = [], firstFound = false, turnOn = false;
			var black = new Color("black"), oHelper = DzSceneHelper();
			for (var i = 0; i < materials.length; i++) {
				var material = materials[i], prop = oHelper.findPropertyOnMaterial("Emission Color", material);
				if (!prop) continue;
				var current = prop.getColorValue();
				var original = Object.prototype.hasOwnProperty.call(saved, material.name) ? saved[material.name] : black;
				if (current.value == 0 && original.value == 0) continue;
				if (!firstFound) { firstFound = true; turnOn = current.value == 0; }
				if (turnOn) { if (current.value == 0 && original.value > 0) updates.push([prop, original]); }
				else if (current.value != 0) updates.push([prop, black]);
			}
			if (updates.length == 0) return false;
			var manager = this;
			var changed = this.iApplyControlEdit("Emissives", function () {
				if (!manager.iAddEmissiveTagToWearable(oWearable)) throw new Error("Emissive recovery colors could not be saved.");
				for (var i = 0; i < updates.length; i++) updates[i][0].setColorValue(updates[i][1]);
				return true;
			});
			if (changed) this.iUpdateTagIcon(oWearable, this.TAG_IMAGE_EMISSIVE);
			return changed;
		}

		//Fit To property
		this.iGetIconAndDescription_FitTo = function (oWearable) {
			var oHelper = DzSceneHelper();
			var oFitToProp, bGeoShell;
			if (oWearable.inherits("DzSkeleton")) {
				oFitToProp = oHelper.findPropertyByInternalName("Fit to", oWearable);
				bGeoShell = false;
			} else if (oWearable.inherits("DzGeometryShellNode")) {
				oFitToProp = oHelper.findPropertyByInternalName("Shell Node", oWearable);
				bGeoShell = true;
			}

			if (!oFitToProp) return false;

			var oFitNode = bGeoShell ? oFitToProp.getValue() : oWearable.getFollowTarget();

			if (oFitNode) {
				//Fit To  = true
				sToolTip = "Fits to " + oFitNode.getLabel() + ".";
				if (oFitNode.elementID == this.humanFigure.elementID) {
					oPixMap = this.iGetPixmapByIconName("Wearables Manager - Fit To.png");
				} else {
					oPixMap = this.iGetPixmapByIconName("Wearables Manager - Fit To Other.png");
				}
			} else {
				//Fit To  = false
				sToolTip = "Fits to None."
				oPixMap = this.iGetPixmapByIconName("Wearables Manager - Fit To None.png");
			}

			return [sToolTip, oPixMap];
		}

		//Freeze Simulation property
		this.iGetIconAndDescription_Simulation = function (oWearable) {
			var oHelper = DzSceneHelper();
			var oFreezeProp = oHelper.findPropertyByInternalName("Freeze Simulation", oWearable);

			if (!oFreezeProp) return false;
			if (oFreezeProp.isDynamicallyHidden()) return false; //no hidden properties

			// - 2 invisible in materials; -1 invisible in regular properties; 1 visible
			var iSimVisible = this.iGetWearableVisiblilityInSimulation(oWearable);

			var bFrozen = oFreezeProp.getBoolValue();
			if (bFrozen) {
				//Freeze Simulation  = true
				sToolTip = "dForce simulation is frozen."
				oPixMap = this.iGetPixmapByIconName("Wearables Manager - dForce Freeze.png");
			} else if (iSimVisible == 0) {
				sToolTip = "dForce simulation visibility is unavailable for this node.";
				oPixMap = this.iGetPixmapByIconName("Wearables Manager - dForce Off.png");
			} else if (iSimVisible == -1) {
				//Visible in Simulation
				sToolTip = "The wearable is invisible in dForce simulation. Property 'Visible in Simulation' is Off."
				oPixMap = this.iGetPixmapByIconName("Wearables Manager - dForce Off.png");
			} else if (iSimVisible == -2) {
				//Visible in Simulation
				sToolTip = "The wearable is invisible in dForce simulation. All " + oWearable.getLabel() + "'s materials are invisible in simulation."
				oPixMap = this.iGetPixmapByIconName("Wearables Manager - dForce Off.png");
			} else {
				//Freeze Simulation  = false; simulation visible = true
				sToolTip = "dForce simulation is active."
				oPixMap = this.iGetPixmapByIconName("Wearables Manager - dForce.png");
			}

			return [sToolTip, oPixMap];
		}

		this.iGetIconAndDescription_Resolution = function (oWearable) {
			//Resolution Level property
			var oResolutionProperty, oShape;
			if (oWearable.inherits("DzFigure")) {
				oShape = this.iGetShape(oWearable);
				if (!oShape) return false;
				var oResolutionProperty = oShape.findProperty("lodlevel");
			}

			if (!oResolutionProperty) return false;

			var iValue = oResolutionProperty.getValue();
			if (iValue == 0) {
				//SubD 0 (Base)
				if (oResolutionProperty.getNumItems() == 1) {
					sToolTip = "Base Resolution. Item is not converted to SubD."
					oPixMap = this.iGetPixmapByIconName("Wearables Manager - SubD Off.png");
				} else {
					sToolTip = "Base Resolution."
					oPixMap = this.iGetPixmapByIconName("Wearables Manager - SubD 0.png");
				}
			} else {
				//SubD X 
				var oSubDProp = oShape.findProperty("SubDIALevel");
				if (oSubDProp) {
					iSubD = oSubDProp.getValue();
					sToolTip = "High Resolution, SubD " + iSubD.toString() + "."
					if (iSubD == 1) {
						oPixMap = this.iGetPixmapByIconName("Wearables Manager - SubD 1.png");
					} else {
						oPixMap = this.iGetPixmapByIconName("Wearables Manager - SubD 2.png");
					}
				}
			}

			return [sToolTip, oPixMap];
		}

		this.iGetIconAndDescription_Smooth = function (oWearable) {
			//Enable Smoothing property
			var oHelper = DzSceneHelper();
			var eSmoothing = oHelper.findPropertyByInternalName("Enable Smoothing", oWearable);
			if (!eSmoothing) return false;

			var bVisible = eSmoothing.getBoolValue();

			var bInteractive = false;
			var oInteractiveProp = oHelper.findPropertyByInternalName("Interactive Update", oWearable);
			if (oInteractiveProp) bInteractive = oInteractiveProp.getBoolValue();

			var oCollisionNode;
			var oCollisionProp = oHelper.findPropertyByInternalName("Collision Item", oWearable);
			if (oCollisionProp) oCollisionNode = oCollisionProp.getValue();

			if (bVisible) {
				//Enable Smoothing  = true
				sToolTip = "Smoothing is enabled."
				if (bInteractive) {
					// Interactive Update = true
					if (oCollisionNode) {
						// Collision node is set
						if (oCollisionNode.elementID == this.humanFigure.elementID) {
							// Collision with main figure
							oPixMap = this.iGetPixmapByIconName("Wearables Manager - Smooth Interactive.png");
							sToolTip += " Collision with " + this.humanFigure.getLabel() + "."
						} else {
							// Collision with another figure
							oPixMap = this.iGetPixmapByIconName("Wearables Manager - Smooth Interactive Other.png");
							sToolTip += " Collision with " + oCollisionNode.getLabel() + "."
						}
					} else {
						// Collision node is not set
						oPixMap = this.iGetPixmapByIconName("Wearables Manager - Smooth Interactive No Collision.png");
						sToolTip += " No collision."
					}
					sToolTip += " Interactive Update is ON (may significantly decrease the system responsiveness)."
				} else {
					// Interactive Update = false
					if (oCollisionNode) {
						// Collision node is set
						if (oCollisionNode.elementID == this.humanFigure.elementID) {
							// Collision with main figure
							oPixMap = this.iGetPixmapByIconName("Wearables Manager - Smooth.png");
							sToolTip += " Collision with " + this.humanFigure.getLabel() + "."
						} else {
							// Collision with another figure
							oPixMap = this.iGetPixmapByIconName("Wearables Manager - Smooth Other.png");
							sToolTip += " Collision with " + oCollisionNode.getLabel() + "."
						}
					} else {
						// Collision node is not set
						oPixMap = this.iGetPixmapByIconName("Wearables Manager - Smooth No Collision.png");
						sToolTip += " No collision."
					}
				}
			} else {
				//Enable Smoothing  = false
				sToolTip = "Smoothing is disabled."
				oPixMap = this.iGetPixmapByIconName("Wearables Manager - Smooth Off.png");
			}


			return [sToolTip, oPixMap];
		}

		this.iLaunchPropertyDialog = function (oWearable, arrPropNames) {
			var wDialog = new DzBasicDialog();
			var oDlgWgt = wDialog.getWidget();
			wDialog.caption = "Matew Wearables: Edit Properties.";
			var sKey = wDialog.caption.replace(/ /g, "") + "Dlg";
			oDlgWgt.objectName = sKey;
			wDialog.showHelpButton(false);
			wDialog.showCancelButton(true);
			wDialog.showAcceptButton(true);

			var iDlgWidth = 600;

			var fontLabels = new Font();
			fontLabels.pixelSize = 14;

			// Containers with wearables

			// 1 Outer V Container
			var oHelper = DzSceneHelper();
			var wgroupProperties = new DzVGroupBox(wDialog); //Holds all Properties
			var layoutProperties = new DzBoxLayout(wgroupProperties);

			var objProValues = {};

			for (var i = 0; i < arrPropNames.length; i++) {
				//Add widgets with properties:

				//Get property object
				var sPropName = arrPropNames[i];
				var oProp = oHelper.findPropertyByInternalName(sPropName, oWearable);
				if (!oProp) continue;

				//create container for property widgets
				var wPropContainer = new DzHGroupBox(wgroupProperties);
				layoutProperties.addWidget(wPropContainer);

				//get current property value & fill out objProValues structure
				var propValue = oProp.getBoolValue();
				objProValues[sPropName] = [propValue, propValue]; //[current value; initial value] - right now they are equal

				//create property edit widgets
				var wCheckBox = new DzCheckBox(wPropContainer);
				wCheckBox.checked = propValue;
				wCheckBox.text = oProp.getLabel();
				wCheckBox.propName = sPropName;
				connect(wCheckBox, "toggled(bool)", wCheckBox, wCheckBoxToggled);
			}

			function wCheckBoxToggled(bState) {
				var sPropName = this.propName;
				var arrValue = objProValues[sPropName];
				arrValue[0] = bState;
			}

			// Add the widget to the dialog
			wDialog.addWidget(wgroupProperties);
			wDialog.setFixedSize(iDlgWidth, oDlgWgt.minimumSizeHint.height);
			if (!wDialog.exec()) return false;
			var names = Object.keys(objProValues), updates = [];
			for (var i = 0; i < names.length; i++) {
				var values = objProValues[names[i]];
				if (values[0] == values[1]) continue;
				var prop = oHelper.findPropertyByInternalName(names[i], oWearable);
				if (prop) updates.push([prop, values[0]]);
			}
			if (updates.length == 0) return false;
			return this.iApplyControlEdit("Visibility Properties", function () {
				for (var i = 0; i < updates.length; i++) updates[i][0].setBoolValue(updates[i][1]);
				return true;
			});
		}

		this.iLaunchEmissiveMaterialsDialog = function (oWearable) {
			if (!oWearable) return;

			var oHelper = DzSceneHelper();
			var arrMaterialNames = this.iGetMaterialsArray(oWearable);
			if (!arrMaterialNames) return;
			var arrEmissiveColorsFromTag = this.iRetreiveEmissivesFromTag(oWearable); //item[material] = color
			if (arrEmissiveColorsFromTag === null) return err("Invalid emissive recovery metadata; the existing record was kept unchanged.");
			var oEmissiveColorsTotal = {};
			var oColorBlack = new Color("black");

			for (var i = 0; i < arrMaterialNames.length; i++) {
				var oMaterial = arrMaterialNames[i];
				var sMaterialName = oMaterial.name;
				var oProp = oHelper.findPropertyOnMaterial("Emission Color", oMaterial);
				if (!oProp) continue;

				var oCurrentColor = oProp.getColorValue();
				if (oCurrentColor.value != 0) {
					//emissive is on
					oEmissiveColorsTotal[sMaterialName] = [oCurrentColor, oCurrentColor, oCurrentColor, oMaterial]; //[sMaterial] = [changed color, initial color, not black color, material]
					continue;
				}

				//emissive is off
				if (!Object.prototype.hasOwnProperty.call(arrEmissiveColorsFromTag, sMaterialName)) continue;

				//incativated emissive
				var oTagColor = arrEmissiveColorsFromTag[sMaterialName];
				oEmissiveColorsTotal[sMaterialName] = [oColorBlack, oColorBlack, oTagColor, oMaterial];
			}

			var arrMaterialNames = Object.keys(oEmissiveColorsTotal);
			if (arrMaterialNames.length == 0) return err("No emissive surfaces weere found.");


			var wDialog = new DzBasicDialog();
			var oDlgWgt = wDialog.getWidget();
			wDialog.caption = "Matew Wearables: Emissive surfaces.";
			var sKey = wDialog.caption.replace(/ /g, "") + "Dlg";
			oDlgWgt.objectName = sKey;
			wDialog.showHelpButton(false);
			wDialog.showCancelButton(true);
			wDialog.showAcceptButton(true);

			var iDlgWidth = 300;

			var fontLabels = new Font();
			fontLabels.pixelSize = 14;

			// Containers with wearables

			// 1 Outer V Container
			var wgroupProperties = new DzVGroupBox(wDialog); //Holds all Properties
			var layoutProperties = new DzBoxLayout(wgroupProperties);
			layoutProperties.direction = DzBoxLayout.TopToBottom;

			for (var i = 0; i < arrMaterialNames.length; i++) {
				//Add widgets with properties:
				var sMaterialName = arrMaterialNames[i];

				//create container for property widgets
				var wPropContainer = new DzHGroupBox(wgroupProperties);
				wPropContainer.setFixedHeight(40);
				layoutProperties.addWidget(wPropContainer);
				var layoutInternal = DzBoxLayout(wPropContainer);

				//get if emissive is active
				var oColor = oEmissiveColorsTotal[sMaterialName][0];
				var bEmissiveOn = !(oColor == oColorBlack);

				//create property edit widgets
				var wCheckBox = new DzCheckBox(wPropContainer);
				wCheckBox.checked = bEmissiveOn;
				wCheckBox.text = sMaterialName;
				layoutInternal.addSpacing(10);
				layoutInternal.addWidget(wCheckBox);
				wCheckBox.materialName = sMaterialName;
				connect(wCheckBox, "toggled(bool)", wCheckBox, wCheckBoxToggled);

			}

			function wCheckBoxToggled(bState) {
				var sMaterialName = this.materialName;
				var cItem = oEmissiveColorsTotal[sMaterialName];

				if (bState) {
					cItem[0] = cItem[2]; // [sMaterial] = [changed color, initial color, not black color, material]
				} else {
					var oBlackColor = new Color("black");
					cItem[0] = oBlackColor; // [sMaterial] = [changed color, initial color, not black color, material]
				}
			}

			// Add the widget to the dialog
			wDialog.addWidget(wgroupProperties);
			wDialog.setFixedSize(iDlgWidth, oDlgWgt.minimumSizeHint.height);
			if (!wDialog.exec()) return false;
			var names = Object.keys(oEmissiveColorsTotal), updates = [];
			for (var i = 0; i < names.length; i++) {
				var values = oEmissiveColorsTotal[names[i]];
				if (values[0] == values[1]) continue;
				var prop = oHelper.findPropertyOnMaterial("Emission Color", values[3]);
				if (prop) updates.push([prop, values[0]]);
			}
			if (updates.length == 0) return false;
			var manager = this;
			return this.iApplyControlEdit("Emissive Surfaces", function () {
				if (!manager.iAddEmissiveTagToWearable(oWearable)) throw new Error("Emissive recovery colors could not be saved.");
				for (var i = 0; i < updates.length; i++) updates[i][0].setColorValue(updates[i][1]);
				return true;
			});
		}

		/*
		<--------------- TAG IMAGES CLICK FUNCTIONS ---------------->
		*/

		this.iApplyControlEdit = function (sLabel, fApply) {
			var bOwnUndoOpen = false;
			try {
				beginUndo();
				bOwnUndoOpen = true;
				var result = fApply();
				bOwnUndoOpen = false;
				if (result === false) { cancelUndo(); return false; }
				acceptUndo("Wearables Manager - " + sLabel);
				return true;
			} catch (e) {
				if (bOwnUndoOpen) { bOwnUndoOpen = false; cancelUndo(); }
				err(e.message);
				return false;
			}
		}

		this.iToggleVisible = function (oWearable) {
			if (!oWearable) return false;
			var oProp = DzSceneHelper().findPropertyByInternalName("Visible", oWearable);
			if (!oProp) return false;
			var value = !oProp.getBoolValue();
			var changed = this.iApplyControlEdit("Visibility", function () { oProp.setBoolValue(value); return true; });
			if (changed) this.iUpdateTagIcon(oWearable, this.TAG_IMAGE_VISIBILITY);
			return changed;
		}

		this.iToggleSmooth = function (oWearable) {
			if (!oWearable) return false;
			var oProp = DzSceneHelper().findPropertyByInternalName("Enable Smoothing", oWearable);
			if (!oProp) return false;
			var value = !oProp.getBoolValue();
			var changed = this.iApplyControlEdit("Smoothing", function () { oProp.setBoolValue(value); return true; });
			if (changed) this.iUpdateTagIcon(oWearable, this.TAG_IMAGE_SMOOTH);
			return changed;
		}

		this.iToggleLight = function (oWearable) {
			if (!oWearable || !oWearable.inherits("DzLight")) return false;
			var oProp = DzSceneHelper().findPropertyByInternalName("Illumination", oWearable);
			if (!oProp) return false;
			var value = oWearable.isOn() ? "Off" : "On";
			var changed = this.iApplyControlEdit("Light", function () {
				if (oProp.setValueFromString(value) === false) throw new Error("The light illumination value could not be set.");
				return true;
			});
			if (changed) this.iUpdateTagIcon(oWearable, this.TAG_IMAGE_LIGHT);
			return changed;
		}

		this.iJumpToFitTo = function (oWearable) {
			if (!oWearable) return;
			var oHelper = DzSceneHelper();
			var oFitToProp;
			if (oWearable.inherits("DzSkeleton")) {
				oFitToProp = oHelper.findPropertyByInternalName("Fit to", oWearable);
			} else if (oWearable.inherits("DzGeometryShellNode")) {
				oFitToProp = oHelper.findPropertyByInternalName("Shell Node", oWearable);
			}

			if (!oFitToProp) return false;

			Scene.selectAllNodes(false);
			Scene.setPrimarySelection(oWearable);
			processEvents();
			var oPaneMgr = MainWindow.getPaneMgr();
			var oPane = oPaneMgr.findPane("DzParametersPane");
			if (!oPane) return;
			if (!oPane.visible) {
				oPane.showPane();
				processEvents();
			}
			oPane.jumpToProperty(oFitToProp);
		}

		this.iJumpToProperty = function (oWearable, sPropertyName) {
			if (!oWearable || !sPropertyName) return;
			var oHelper = DzSceneHelper();
			var oProp = oHelper.findPropertyByInternalName(sPropertyName, oWearable);
			if (!oProp) return false;

			Scene.selectAllNodes(false);
			Scene.setPrimarySelection(oWearable);
			processEvents();
			var oPaneMgr = MainWindow.getPaneMgr();
			var oPane = oPaneMgr.findPane("DzParametersPane");
			if (!oPane) return;
			if (!oPane.visible) {
				oPane.showPane();
				processEvents();
			}
			oPane.jumpToProperty(oProp);
		}


		/*
		this.iLaunchFitToAction = function (oWearable) {
			var actionMgr = MainWindow.getActionMgr();
			var oAction = actionMgr.findAction("DzFitToAction");
			if (!oAction) return;
			beginUndo();
			oAction.trigger()
			acceptUndo("Fit To Action");
			this.iUpdateTagIcon(oWearable, this.TAG_IMAGE_FIT_TO);
		}*/

		this.iToggleFreezeSimulation = function (oWearable) {
			if (!oWearable) return false;
			var oProp = DzSceneHelper().findPropertyByInternalName("Freeze Simulation", oWearable);
			if (!oProp) return false;
			var value = !oProp.getBoolValue();
			var changed = this.iApplyControlEdit("Freeze Simulation", function () { oProp.setBoolValue(value); return true; });
			if (changed) this.iUpdateTagIcon(oWearable, this.TAG_IMAGE_DFORCE);
			return changed;
		}

		//-1 if Usual property "Visible in Simulation" = false;
		//-2 if none of materials has Visible in Simulation On
		//1 if it's visible in simulation
		this.iGetWearableVisiblilityInSimulation = function (oWearable) {
			var oHelper = DzSceneHelper();

			var oSimVisibleProp = oHelper.findPropertyByInternalName("Visible in Simulation", oWearable);
			if (oSimVisibleProp) {
				//Usual property "Visible in Simulation" = false
				if (!oSimVisibleProp.getBoolValue()) return -1;
			}

			//Check "Visible in Simulation" on all materials. If at least one material has true value - visible = true;
			var oShape = this.iGetShape(oWearable);
			if (!oShape) return 0;
			var arrMaterials = oShape.getAllMaterials();

			for (var i = 0; i < arrMaterials.length; i++) {
				var oProp = oHelper.findPropertyOnMaterial("Visible in Simulation", arrMaterials[i]);
				if (!oProp) continue;
				if (oProp.getBoolValue()) return 1
			}
			return -2;
		}

		this.iJumpToSubD = function (oWearable) {
			if (!oWearable) return;
			if (!oWearable.inherits("DzFigure")) return;
			var oShape = this.iGetShape(oWearable);
			if (!oShape) return false;
			var oProp = oShape.findProperty("lodlevel");

			if (!oProp) return false;

			Scene.selectAllNodes(false);
			Scene.setPrimarySelection(oWearable);
			processEvents();
			var oPaneMgr = MainWindow.getPaneMgr();
			var oPane = oPaneMgr.findPane("DzParametersPane");
			if (!oPane) return;
			if (!oPane.visible) {
				oPane.showPane();
				processEvents();
			}
			oPane.jumpToProperty(oProp);
		}

		this.iToggleSubD = function (oWearable) {
			if (!oWearable || !oWearable.inherits("DzFigure")) return;
			var oShape = this.iGetShape(oWearable);
			if (!oShape) return;
			var oResolutionProperty = oShape.findProperty("lodlevel");
			if (!oResolutionProperty) return;
			if (oResolutionProperty.getNumItems() == 1) {
				var actionMgr = MainWindow.getActionMgr();
				var action = actionMgr.findAction("DzSubDAction");
				if (!action) return;
				if (question("Do you want to convert " + oWearable.getLabel() + " to SubD?") == 1) return;
				beginNodeSelectionHold();
				try {
					Scene.selectAllNodes(false);
					Scene.setPrimarySelection(oWearable);
					action.trigger();
					// Conversion can replace the shape and its property objects.
					oShape = this.iGetShape(oWearable);
					if (!oShape) return;
					oResolutionProperty = oShape.findProperty("lodlevel");
					var convertedSubD = oShape.findProperty("SubDIALevel");
					if (!oResolutionProperty || oResolutionProperty.getNumItems() < 2 || !convertedSubD) return;
					convertedSubD.setValue(1);
					this.iUpdateTagIcon(oWearable, this.TAG_IMAGE_SUBD);
				} catch (e) {
					err(e.message);
				} finally {
					restoreNodeSelectionHold();
				}
				return;
			}
			var oSubDProp = oShape.findProperty("SubDIALevel");
			if (!oSubDProp) return;
			var iLodValue = oResolutionProperty.getValue();
			var iSubDValue = oSubDProp.getValue();
			if (iLodValue == 0) {
				iLodValue = 1;
				iSubDValue = 1;
				oResolutionProperty.setValue(iLodValue);
				oSubDProp.setValue(iSubDValue);
			} else {
				iSubDValue++;
				if (iSubDValue < 3) oSubDProp.setValue(iSubDValue);
				else {
					iSubDValue = 1;
					iLodValue = 0;
					oResolutionProperty.setValue(iLodValue);
					oSubDProp.setValue(iSubDValue);
				}
			}
			this.iUpdateTagIcon(oWearable, this.TAG_IMAGE_SUBD);
		}

		/*
		<--------------- SIGNALS ---------------->
		*/

		function dForceClicked() {
			var oWearable = this.wearable;
			var nModifierKeyState = App.modifierKeyState();
			var bShiftPressed = (nModifierKeyState & 0x02000000) != 0;
			if (bShiftPressed) {
				oTagImageManager.iJumpToProperty(oWearable, "Freeze Simulation");
			} else {
				oTagImageManager.iToggleFreezeSimulation(oWearable);
			}
		}

		function visibleClicked() {
			var oWearable = this.wearable;
			if (!oWearable) return;
			var nModifierKeyState = App.modifierKeyState();
			var bControlPressed = (nModifierKeyState & 0x04000000) != 0;
			var bShiftPressed = (nModifierKeyState & 0x02000000) != 0;

			if (bControlPressed) {
				if (oTagImageManager.iLaunchPropertyDialog(oWearable, ["Visible", "Renderable", "Visible in Viewport"])) {
					//changed
					oTagImageManager.iUpdateTagIcon(oWearable, oTagImageManager.TAG_IMAGE_VISIBILITY);
				}
			} else if (bShiftPressed) {
				oTagImageManager.iJumpToProperty(oWearable, "Visible");
			} else {
				oTagImageManager.iToggleVisible(oWearable);
			}
		}

		function FitToClicked() {
			var oWearable = this.wearable;
			oTagImageManager.iJumpToFitTo(oWearable);
		}

		function SubDClicked() {
			var oWearable = this.wearable;
			var nModifierKeyState = App.modifierKeyState();
			var bShiftPressed = (nModifierKeyState & 0x02000000) != 0;
			if (bShiftPressed) {
				oTagImageManager.iJumpToSubD(oWearable);
			} else {
				oTagImageManager.iToggleSubD(oWearable);
			}
		}

		function SmoothModifierClicked() {
			var oWearable = this.wearable;
			var nModifierKeyState = App.modifierKeyState();
			var bShiftPressed = (nModifierKeyState & 0x02000000) != 0;
			if (bShiftPressed) {
				oTagImageManager.iJumpToProperty(oWearable, "Enable Smoothing");
			} else {
				oTagImageManager.iToggleSmooth(oWearable);
			}
		}

		function lightClicked() {
			var oWearable = this.wearable;
			var nModifierKeyState = App.modifierKeyState();
			var bShiftPressed = (nModifierKeyState & 0x02000000) != 0;
			if (bShiftPressed) {
				oTagImageManager.iJumpToProperty(oWearable, "Illumination");
			} else {
				oTagImageManager.iToggleLight(oWearable);
			}
		}

		function emissiveClicked() {
			var oWearable = this.wearable;
			var nModifierKeyState = App.modifierKeyState();
			var bControlPressed = (nModifierKeyState & 0x04000000) != 0;
			var bShiftPressed = (nModifierKeyState & 0x02000000) != 0;

			if (bControlPressed) {
				if (oTagImageManager.iLaunchEmissiveMaterialsDialog(oWearable)) {
					//changed
					oTagImageManager.iUpdateTagIcon(oWearable, oTagImageManager.TAG_IMAGE_EMISSIVE);
				}
			} else if (bShiftPressed) {
				oTagImageManager.iSelectEmissiveMaterials(oWearable);
			} else {
				oTagImageManager.iToggleEmissives(oWearable);
			}
		}

		/*
		<--------------- PUBLIC ---------------->
		*/

		this.AddTagImage = function (oWearable, eType) {
			var wImage;
			if (eType == this.TAG_IMAGE_VISIBILITY) {
				wImage = this.iCreateTagImageWidget(oWearable, this.iGetIconAndDescription_Visibility(oWearable), visibleClicked);
			} else if (eType == this.TAG_IMAGE_LIGHT) {
				wImage = this.iCreateTagImageWidget(oWearable, this.iGetIconAndDescription_Light(oWearable), lightClicked);
			} else if (eType == this.TAG_IMAGE_EMISSIVE) {
				wImage = this.iCreateTagImageWidget(oWearable, this.iGetIconAndDescription_Emissive(oWearable), emissiveClicked);
			} else if (eType == this.TAG_IMAGE_FIT_TO) {
				wImage = this.iCreateTagImageWidget(oWearable, this.iGetIconAndDescription_FitTo(oWearable), FitToClicked);
			} else if (eType == this.TAG_IMAGE_DFORCE) {
				wImage = this.iCreateTagImageWidget(oWearable, this.iGetIconAndDescription_Simulation(oWearable), dForceClicked);
			} else if (eType == this.TAG_IMAGE_SUBD) {
				wImage = this.iCreateTagImageWidget(oWearable, this.iGetIconAndDescription_Resolution(oWearable), SubDClicked);
			} else if (eType == this.TAG_IMAGE_SMOOTH) {
				wImage = this.iCreateTagImageWidget(oWearable, this.iGetIconAndDescription_Smooth(oWearable), SmoothModifierClicked);
			}

			if (!wImage) return false

			var oTagImageItem = this.iFindTagImageItem(oWearable, eType);
			if (!oTagImageItem) {
				var oTagImageItem = new TagImageItemClass();
				oTagImageItem.type = eType;
				oTagImageItem.wearable = oWearable;
				arrTagImages.push(oTagImageItem);
			}

			//save link to the widget to be able to change its pixmap. We will have both widgetImage to change them synchronously
			if (this.bHumanContainer) {
				oTagImageItem.widgetImageHumanFigure = wImage;
			} else {
				oTagImageItem.widgetImageGroup = wImage;
			}

			return true
		}

		this.SetCurrentWidgetsContainer = function (wContainer, oLayout, bHumanContainer) {
			this.container = wContainer;
			this.layout = oLayout;
			this.bHumanContainer = bHumanContainer;
		}

		this.HasTagIcons = function (oWearable) {
			var n = arrTagImages.length;
			if (n == 0) return false;
			var sID = oWearable.elementID;

			for (var i = 0; i < n; i++) {
				var oItem = arrTagImages[i];
				if (oItem.wearable.elementID == sID) return true;
			}

			return false;
		}

	}


	/*-----------------------------------------------------------------*\
						WEARABLES MANAGER CLASS
	\*-----------------------------------------------------------------*/
	function WearablesManagerClass() {
		function WearablesItemClass(oWearable, oParent, isInGroup) {
			this.node = oWearable;
			this.nodeParent = oParent;
			this.isInGroup = isInGroup;
			this.isInGroupInitially = isInGroup;
			this.wGroupContainer;
			this.wHumanFigureContainer;
		}

		this.arrWearableItems = [];
		this.wEmptyHumanFigure;
		this.wEmptyGroup;
		this.wBtnMoveAllToGroup;
		this.wBtnMoveAllToHuman;
		this.wBtnTransfer;
		this.wBtnSave;


		/*
		<--------------- PRIVATE ---------------->
		*/
		this.iAddItem = function (oWearable, oParent, isInGroup) {
			var newItem = new WearablesItemClass(oWearable, oParent, isInGroup);
			this.arrWearableItems.push(newItem);
		}

		this.iSortNodesByElementID = function (nodeA, nodeB) {
			var a = nodeA.getLabel();
			var b = nodeB.getLabel();
			return a < b ? -1 : a > b ? 1 : 0;
		}

		this.iFindWearableIndex = function (oWearable) {
			var n = this.arrWearableItems.length;
			if (n == 0) return -1;
			var iID = oWearable.elementID;
			for (var i = 0; i < n; i++) {
				if (this.arrWearableItems[i].node.elementID == iID) return i;
			}
			return -1;
		}

		this.iNeedToTransfer = function () {
			var n = this.arrWearableItems.length;
			if (n == 0) return false;
			for (var i = 0; i < n; i++) {
				var cItem = this.arrWearableItems[i];
				if (cItem.isInGroup != cItem.isInGroupInitially) return true;
			}
			return false
		}


		this.iAddStringDataToNode = function (oNode, sDataName, sKey, sValue) {
			if (!sKey || !sDataName || !oNode) return;

			var oData = oNode.findDataItem(sDataName);
			if (!oData) {
				oData = new DzSimpleElementData(sDataName, true);
				oNode.addDataItem(oData);
			}
			var oDataSettings = oData.getSettings();
			oDataSettings.setStringValue(sKey, sValue);
		}

		this.GetWearableParentNode = function (oWearable) {
			if (!oWearable) return false;
			var iIndex = this.iFindWearableIndex(oWearable);
			if (iIndex < 0) return false;
			var cItem = this.arrWearableItems[iIndex];
			return cItem.nodeParent;
		}

		/*
		<--------------- PUBLIC ---------------->
		*/

		this.SetNoItemsWidgets = function (oWidgetEmpyHuman, oWidgetEmptyGroup) {
			this.wEmptyHumanFigure = oWidgetEmpyHuman;
			this.wEmptyGroup = oWidgetEmptyGroup;
		}

		this.SetMoveSensitiveButtons = function (wBtnMoveToHuman, wBtnMoveToGroup, wBtnTransfer, wBtnSave) {
			this.wBtnMoveAllToHuman = wBtnMoveToHuman;
			this.wBtnMoveAllToGroup = wBtnMoveToGroup;
			this.wBtnTransfer = wBtnTransfer;
			this.wBtnSave = wBtnSave;
		}

		this.LoadItemsFromHumanFigure = function (oHumanFigure) {
			var arrFigureChildren = WM2Support.menuGraph(Scene,oWM2Config).attachedRoots(oHumanFigure);

			for (var i = 0; i < arrFigureChildren.length; i++) {
				var oWearable = arrFigureChildren[i];
				this.iAddItem(oWearable, oWearable.getNodeParent(), false);
			}

		}

		this.LoadItemsFromGroup = function (oHumanFigure, oGroup) {
			var bOK = WM2LoadItemsFromGroup(this, oHumanFigure, oGroup);
			if (!bOK) {
				var arrMessages = [];
				for (var i = 0; i < this.arrPendingStorageItems.length; i++) arrMessages.push(this.arrPendingStorageItems[i].node.getLabel() + ": " + this.arrPendingStorageItems[i].message);
				MessageBox.information("Some stored items remain pending:\n" + arrMessages.join("\n"), "Wearables Manager - Pending Recovery", "&OK");
			}
			return bOK;
		}

		this.GetListofNodes = function () {
			var arrResult = [];
			var n = this.arrWearableItems.length;
			if (n == 0) return false;

			for (var i = 0; i < n; i++) arrResult.push(this.arrWearableItems[i].node);
			return arrResult.sort(this.iSortNodesByElementID);

		}

		this.HasWearablesOnFigure = function () {
			var n = this.arrWearableItems.length;
			if (n == 0) return false;
			for (var i = 0; i < n; i++) {
				if (!this.arrWearableItems[i].isInGroup) return true;
			}
			return false;
		}

		this.HasWearablesInGroup = function () {
			var n = this.arrWearableItems.length;
			if (n == 0) return false;
			for (var i = 0; i < n; i++) {
				if (this.arrWearableItems[i].isInGroup) return true;
			}
			return false;
		}

		this.IsWearableInTheGroup = function (oWearable) {
			var iIndex = this.iFindWearableIndex(oWearable);
			if (iIndex < 0) return false;
			var cItem = this.arrWearableItems[iIndex];
			return cItem.isInGroup;

		}

		this.IsWearableInGroupAndNotMoved = function (oWearable) {
			var iIndex = this.iFindWearableIndex(oWearable);
			if (iIndex < 0) return false;
			var cItem = this.arrWearableItems[iIndex];
			return (cItem.isInGroup && cItem.isInGroupInitially);
		}


		this.MoveWearableToGroup = function (oWearable) {
			var iIndex = this.iFindWearableIndex(oWearable);
			if (iIndex < 0) return;
			var cItem = this.arrWearableItems[iIndex];
			cItem.isInGroup = true;
			cItem.wGroupContainer.show();
			cItem.wHumanFigureContainer.hide();
			this.UpdateMoveItemsSensitiveWidgets();
		}

		this.MoveWearableToHuman = function (oWearable) {
			var iIndex = this.iFindWearableIndex(oWearable);
			if (iIndex < 0) return;
			var cItem = this.arrWearableItems[iIndex];
			cItem.isInGroup = false;
			cItem.wGroupContainer.hide();
			cItem.wHumanFigureContainer.show();
			this.UpdateMoveItemsSensitiveWidgets();
		}

		this.MoveAllWearablesToHuman = function () {
			var n = this.arrWearableItems.length;
			if (n == 0) return;
			for (var i = 0; i < n; i++) {
				var cItem = this.arrWearableItems[i];
				if (!cItem.isInGroup) continue;
				cItem.isInGroup = false;
				cItem.wGroupContainer.hide();
				cItem.wHumanFigureContainer.show();
			}
			this.UpdateMoveItemsSensitiveWidgets();
		}

		this.MoveAllWearablesToGroup = function () {
			var n = this.arrWearableItems.length;
			if (n == 0) return;
			for (var i = 0; i < n; i++) {
				var cItem = this.arrWearableItems[i];
				if (cItem.isInGroup) continue;
				cItem.isInGroup = true;
				cItem.wGroupContainer.show();
				cItem.wHumanFigureContainer.hide();
			}
			this.UpdateMoveItemsSensitiveWidgets();
		}

		this.SetWearableHumanFigureWidgetContainer = function (oWearable, oContainer) {
			var iIndex = this.iFindWearableIndex(oWearable);
			if (iIndex < 0) return;
			var cItem = this.arrWearableItems[iIndex];
			cItem.wHumanFigureContainer = oContainer;
		}

		this.SetWearableGroupWidgetContainer = function (oWearable, oContainer) {
			var iIndex = this.iFindWearableIndex(oWearable);
			if (iIndex < 0) return;
			var cItem = this.arrWearableItems[iIndex];
			cItem.wGroupContainer = oContainer;
		}

		this.UpdateMoveItemsSensitiveWidgets = function () {
			var wEmpty = this.wEmptyHumanFigure;
			var wBtn = this.wBtnMoveAllToGroup;
			if (wEmpty) {
				var bHasWearables = this.HasWearablesOnFigure();
				if (bHasWearables) {
					wEmpty.hide();
					wBtn.enabled = true;
				} else {
					wEmpty.show();
					wBtn.enabled = false;
				}
			}

			wEmpty = this.wEmptyGroup;
			wBtn = this.wBtnMoveAllToHuman;
			var bHasWearablesInGroup = false;
			if (wEmpty) {
				var bHasWearablesInGroup = this.HasWearablesInGroup();
				if (bHasWearablesInGroup) {
					wEmpty.hide();
					wBtn.enabled = true;
				} else {
					wEmpty.show();
					wBtn.enabled = false;
				}
			}

			wBtn = this.wBtnTransfer;
			var bNeedToTransfer = this.iNeedToTransfer();
			wBtn.enabled = bNeedToTransfer;

			wBtn = this.wBtnSave;
			wBtn.enabled = (bNeedToTransfer && bHasWearablesInGroup);
		}

		//returns two arrays:
		//0 - arr of nodes to move to the group;
		//1 - arr of pairs [node to move back to the figure, its parent bone on the figure];
		this.GetListsOfMovingWearables = function () {
			var n = this.arrWearableItems.length;
			if (n == 0) return false;
			var arrMoveToGroup = [];
			var arrMoveToFigure = []
			for (var i = 0; i < n; i++) {
				var cItem = this.arrWearableItems[i];
				if (cItem.isInGroup && !cItem.isInGroupInitially) {
					//node was moved to the group
					arrMoveToGroup.push(cItem.node);
				} else if ((!cItem.isInGroup && cItem.isInGroupInitially)) {
					//node was moved back to the figure
					arrMoveToFigure.push([cItem.node, cItem.nodeParent]);
				}
			}

			return [arrMoveToGroup, arrMoveToFigure];
		}

		this.SetTransferringMarks = function () {
			var sValue;
			var n = this.arrWearableItems.length;
			if (n == 0) return;
			for (var i = 0; i < n; i++) {
				var cItem = this.arrWearableItems[i];
				sValue = cItem.isInGroup ? VALUE_TRANSFER_YES : VALUE_TRANSFER_NO;
				this.iAddStringDataToNode(cItem.node, DATA_ITEM_NAME, SETTIGNS_TRANSFER, sValue);
			}
		}

	}

	/*-----------------------------------------------------------------*\
					DATA SETTINGS REMOVE QUEUE CLASS
	\*-----------------------------------------------------------------*/
	function RemoveQueueClass() {
		this.arrDataSettingsItems = [];
		this.arrFiles = [];
		this.AddDataToQueue = function (oDataItem, oSettings, oKey) {
			// This queue contains only the one MatewWearables data item per node.
			// QObject wrappers may be fresh aliases: capture the live owner now.
			var oOwner = oDataItem ? oDataItem.getOwner() : null;
			if (!oOwner || !WM2SceneContains(oOwner) || !oSettings) throw new Error("The recovery data owner is no longer available.");
			for (var i = 0; i < this.arrDataSettingsItems.length; i++) {
				var oItem = this.arrDataSettingsItems[i];
				if (WM2SameNode(oItem.oOwner, oOwner) && oItem.oKey == oKey) return;
			}
			this.arrDataSettingsItems.push({oDataItem: oDataItem, oSettings: oSettings, oOwner: oOwner, oKey: oKey});
		}
		this.AddFileToQueue = function (fFile) { this.arrFiles.push(fFile); }
		this.Finalize = function () {
			var arrGroups = [];
			// Group every wrapper alias before disposing any native data item.
			for (var i = 0; i < this.arrDataSettingsItems.length; i++) {
				var oItem = this.arrDataSettingsItems[i], oGroup = null;
				for (var j = 0; j < arrGroups.length; j++) {
					if (WM2SameNode(arrGroups[j].oOwner, oItem.oOwner)) { oGroup = arrGroups[j]; break; }
				}
				if (!oGroup) {
					oGroup = {oOwner: oItem.oOwner, oDataItem: oItem.oDataItem, oSettings: oItem.oSettings, arrKeys: []};
					arrGroups.push(oGroup);
				}
				if (oGroup.arrKeys.indexOf(oItem.oKey) < 0) oGroup.arrKeys.push(oItem.oKey);
			}
			// Validate all owners before mutating any acknowledged recovery record.
			for (var i = 0; i < arrGroups.length; i++) {
				if (!WM2SceneContains(arrGroups[i].oOwner)) throw new Error("The recovery data owner changed before cleanup.");
			}
			for (var i = 0; i < arrGroups.length; i++) {
				var oGroup = arrGroups[i];
				for (var j = 0; j < oGroup.arrKeys.length; j++) oGroup.oSettings.removeValue(oGroup.arrKeys[j]);
			}
			for (var i = 0; i < arrGroups.length; i++) {
				var oGroup = arrGroups[i];
				if (oGroup.oSettings.getNumValues() == 0) oGroup.oOwner.removeDataItem(oGroup.oDataItem);
			}
			// Retain sidecars while Undo can refer to them; release wrappers only.
			for (var i = 0; i < this.arrFiles.length; i++) this.arrFiles[i].deleteLater();
			this.Clear();
		}
		this.Clear = function () { this.arrDataSettingsItems = []; this.arrFiles = []; }
	}
	var oRemoveQueue = new RemoveQueueClass();
	var bWM2UndoOpen = false;

	function WM2NodeKey(oNode) {
	    if (!oNode) return null;
	    try {
	        if (!oNode.inherits("DzNode")) return null;
	        var vID = oNode.elementID;
	        if (typeof vID === "undefined" || vID === null) return null;
	        var sID = String(vID), sClass = String(oNode.className());
	        if (!sID || !sClass) return null;
	        return { id: sID, className: sClass };
	    } catch (e) { return null; }
	}

	function WM2SameNode(oA, oB) {
	    var oKeyA = WM2NodeKey(oA), oKeyB = WM2NodeKey(oB);
	    return !!(oKeyA && oKeyB && oKeyA.id === oKeyB.id && oKeyA.className === oKeyB.className);
	}

	function WM2LiveNode(oNode) {
	    var oKey = WM2NodeKey(oNode);
	    if (!oKey) return null;
	    var arrNodes = Scene.getNodeList(), oLive = null;
	    for (var i = 0; i < arrNodes.length; i++) {
	        if (!WM2SameNode(arrNodes[i], oNode)) continue;
	        if (oLive) return null; // Fail closed if the scene unexpectedly repeats an identity.
	        oLive = arrNodes[i];
	    }
	    return oLive;
	}

	function WM2NodeIndexOf(arrNodes, oNode) {
	    for (var i = 0; i < arrNodes.length; i++) if (WM2SameNode(arrNodes[i], oNode)) return i;
	    return -1;
	}

	function WM2BeginUndo() {
		if (bWM2UndoOpen) throw new Error("A Wearables Manager Undo operation is already open.");
		beginUndo(); bWM2UndoOpen = true;
	}

	function WM2AcceptUndo(sLabel) {
		if (!bWM2UndoOpen) return;
		try { acceptUndo(sLabel); } finally { bWM2UndoOpen = false; }
	}

	function WM2CancelUndo() {
		if (!bWM2UndoOpen) return;
		try { cancelUndo(); } finally { bWM2UndoOpen = false; }
	}

	function WM2SnapshotPath(oSettings, sFileName) {
		var sPath = oSettings ? oSettings.getStringValue("BackupPath", "") : "";
		return sPath || (PATH_TEMP + sFileName + ".duf");
	}

	function WM2BackupDirectory() {
		// New snapshots survive temporary-directory cleanup. Old snapshots retain their fallback.
		var sPath = App.getAppDataPath() + "/matew/WearablesManager/Backups/";
		var oDir = new DzDir(sPath);
		try {
			if (!oDir.exists() && !oDir.mkpath(sPath)) throw new Error("Unable to create the Wearables Manager backup directory: " + sPath);
		} finally { oDir.deleteLater(); }
		return sPath;
	}

	function WM2ReviewAndAdoptLegacyProxy(oGroup, oProxy, oHumanFigure) {
		var oPrior = WM2ResolveBoneProxy(oGroup, oProxy, oHumanFigure);
		if (oPrior.status !== "needs-migration") return oPrior;
		// During restoration this belongs to the outer operation; during UI loading it owns a small block.
		var bOwnUndo = !bWM2UndoOpen;
		if (bOwnUndo) WM2BeginUndo();
		try {
			var oResult = WM2ReviewLegacyBoneProxy(oGroup, oProxy, oHumanFigure);
			if (bOwnUndo) {
				if (oResult.ok) WM2AcceptUndo("Wearables Manager - Review Legacy Storage");
				else WM2CancelUndo();
			}
			return oResult;
		} catch (e) { if (bOwnUndo) WM2CancelUndo(); throw e; }
	}

	function WM2ReferenceResult(bOK, sStatus, oNode, sMessage) {
	    return { ok: bOK, status: sStatus, node: oNode || null, message: sMessage || "" };
	}

	function WM2NodeSettings(oNode, bCreate) {
	    if (!oNode) return null;
	    var oData = oNode.findDataItem(DATA_ITEM_NAME);
	    if (!oData && bCreate) {
	        oData = new DzSimpleElementData(DATA_ITEM_NAME, true);
	        oNode.addDataItem(oData);
	    }
	    return oData ? oData.getSettings() : null;
	}

	function WM2SceneContains(oNode) {
	    return !!WM2LiveNode(oNode);
	}

	function WM2NodesWithValue(sKey, sValue) {
	    var arrNodes = Scene.getNodeList();
	    var arrMatches = [];
	    if (!sValue) return arrMatches;
	    for (var i = 0; i < arrNodes.length; i++) {
	        var oSettings = WM2NodeSettings(arrNodes[i], false);
	        if (oSettings && oSettings.getStringValue(sKey, "") === sValue) arrMatches.push(arrNodes[i]);
	    }
	    return arrMatches;
	}

	function WM2UniqueToken(sKey) {
	    for (var i = 0; i < 10; i++) {
	        var sID = "WM2_" + GenerateUniqueID(20);
	        if (WM2NodesWithValue(sKey, sID).length === 0) return sID;
	    }
	    throw new Error("Unable to create a unique Wearables Manager identity.");
	}

	function WM2EnsureNodeID(oNode) {
	    if (!oNode || !WM2SceneContains(oNode)) return WM2ReferenceResult(false, "missing", null, "Reference target is no longer in the scene.");
	    var oSettings = WM2NodeSettings(oNode, false);
	    var sID = oSettings ? oSettings.getStringValue("NodeID", "") : "";
	    if (sID) {
	        var arrMatches = WM2NodesWithValue("NodeID", sID);
	        if (arrMatches.length !== 1 || !WM2SameNode(arrMatches[0], oNode)) return WM2ReferenceResult(false, "ambiguous", null, "Several scene nodes share a saved node identity.");
	    } else {
	        sID = WM2UniqueToken("NodeID");
	        oSettings = WM2NodeSettings(oNode, true);
	        if (!oSettings) return WM2ReferenceResult(false, "failed", null, "Unable to store a node identity.");
	        oSettings.setStringValue("NodeID", sID);
	    }
	    var oResult = WM2ReferenceResult(true, "resolved", oNode, "");
	    oResult.nodeID = sID;
	    return oResult;
	}

	function WM2GetNodeReferenceKeys(sPrefix) {
	    return [sPrefix, sPrefix + "_NodeID", sPrefix + "_Name", sPrefix + "_Label", sPrefix + "_Class"];
	}

	function WM2ResolveNodeReference(oSettings, sPrefix, sLegacyMode) {
		return WM2Support.menuGraph(Scene,oWM2Config).resolveNodeReference(oSettings, sPrefix, sLegacyMode);
	}

	function WM2SaveNodeReference(oSettings, sPrefix, oTarget, sLegacyMode) {
	    if (!oSettings || !oTarget) return WM2ReferenceResult(false, "missing", null, "Reference settings or target are unavailable.");
	    if (oSettings.getStringValue(sPrefix + "_NodeID", "") || oSettings.getStringValue(sPrefix, "")) {
	        var oExisting = WM2ResolveNodeReference(oSettings, sPrefix, sLegacyMode);
	        if (!oExisting.ok) return oExisting;
	        if (!WM2SameNode(oExisting.node, oTarget)) return WM2ReferenceResult(false, "conflict", null, "An unresolved or different saved reference must be recovered before recording another target.");
	    }
	    var oIdentity = WM2EnsureNodeID(oTarget);
	    if (!oIdentity.ok) return oIdentity;
	    oSettings.setStringValue(sPrefix, sLegacyMode === "label" ? oTarget.getLabel() : oTarget.name);
	    oSettings.setStringValue(sPrefix + "_NodeID", oIdentity.nodeID);
	    oSettings.setStringValue(sPrefix + "_Name", oTarget.name);
	    oSettings.setStringValue(sPrefix + "_Label", oTarget.getLabel());
	    oSettings.setStringValue(sPrefix + "_Class", oTarget.className());
	    return WM2ReferenceResult(true, "resolved", oTarget, "");
	}

	function WM2BoundPair(oSource) {
		return WM2Support.menuGraph(Scene,oWM2Config).boundPair(oSource);
	}

	function WM2IsBoneOfFigure(oBone, oFigure) {
		return WM2Support.menuGraph(Scene,oWM2Config).isBoneOfFigure(oBone, oFigure);
	}

	function WM2LegacyBoneMatches(oGroup, oProxy, oHumanFigure) {
	    var arrMatches = [];
	    if (!oGroup || !oProxy || !oHumanFigure || oProxy.className() !== "DzGroupNode") return arrMatches;
	    var sPrefix = oGroup.name + "_";
	    if (oProxy.name.indexOf(sPrefix) !== 0) return arrMatches;
	    var sBoneName = oProxy.name.substring(sPrefix.length);
	    var arrChildren = oHumanFigure.getNodeChildren(true);
	    for (var i = 0; i < arrChildren.length; i++) {
	        if (arrChildren[i].name === sBoneName && WM2IsBoneOfFigure(arrChildren[i], oHumanFigure)) arrMatches.push(arrChildren[i]);
	    }
	    return arrMatches;
	}

	function WM2ResolveBoneProxy(oGroup, oProxy, oHumanFigure) {
		return WM2Support.menuGraph(Scene,oWM2Config).resolveBoneProxy(oGroup, oProxy, oHumanFigure);
	}

	function WM2MarkBoneProxy(oProxy, oHumanFigure, oBone) {
	    if (!oProxy || oProxy.className() !== "DzGroupNode" || !WM2IsBoneOfFigure(oBone, oHumanFigure)) return WM2ReferenceResult(false, "wrong-class", null, "Invalid bone proxy or bone.");
	    if (!WM2SceneContains(oProxy)) return WM2ReferenceResult(false, "missing", null, "The bone proxy is no longer in the scene.");
	    var oOwnerID = WM2EnsureNodeID(oHumanFigure);
	    if (!oOwnerID.ok) return oOwnerID;
	    var oBoneID = WM2EnsureNodeID(oBone);
	    if (!oBoneID.ok) return oBoneID;
	    var oSettings = WM2NodeSettings(oProxy, true);
	    var oOwner = WM2SaveNodeReference(oSettings, "WM2Owner", oHumanFigure, "name");
	    if (!oOwner.ok) return oOwner;
	    var oSavedBone = WM2SaveNodeReference(oSettings, "WM2Bone", oBone, "name");
	    if (!oSavedBone.ok) return oSavedBone;
	    oSettings.setStringValue("WM2Role", "BoneProxy");
	    return WM2ReferenceResult(true, "resolved", oBone, "");
	}

	function WM2AdoptLegacyBoneProxy(oGroup, oProxy, oHumanFigure, oReviewedBone) {
	    // Invoke only after the user explicitly confirms this particular legacy group.
	    if (!oGroup || !oProxy || !oHumanFigure) return WM2ReferenceResult(false, "missing", null, "The reviewed legacy bone group is missing.");
	    var arrMatches = WM2LegacyBoneMatches(oGroup, oProxy, oHumanFigure);
	    if (!WM2SameNode(oProxy.getNodeParent(), oGroup) || arrMatches.length !== 1 || !WM2SameNode(arrMatches[0], oReviewedBone)) return WM2ReferenceResult(false, "ambiguous", null, "The reviewed legacy bone group no longer matches the selected bone.");
	    return WM2MarkBoneProxy(oProxy, oHumanFigure, oReviewedBone);
	}

	function WM2ReviewLegacyBoneProxy(oGroup, oProxy, oHumanFigure) {
	    var oResult = WM2ResolveBoneProxy(oGroup, oProxy, oHumanFigure);
	    if (oResult.status !== "needs-migration") return oResult;
	    var arrMatches = WM2LegacyBoneMatches(oGroup, oProxy, oHumanFigure);
	    if (arrMatches.length !== 1) return WM2ReferenceResult(false, arrMatches.length > 1 ? "ambiguous" : "missing", null, "The legacy storage group has no unique destination bone. Its items remain stored.");
	    var oBone = arrMatches[0];
	    var nItems = oProxy.getNodeChildren(false).length;
	    var sMessage = "Review this legacy storage connection:\n\n" +
	        "Storage group: " + oProxy.getLabel() + "\n" +
	        "Figure: " + oHumanFigure.getLabel() + "\n" +
	        "Destination bone: " + oBone.getLabel() + " (" + oBone.name + ")\n" +
	        "Direct items in this group: " + nItems + "\n\n" +
	        "Confirm that this group stores items for this bone. Use this bone records the connection for future restoration. Keep stored leaves this group pending. No items move during this review.";
	    var nAnswer = MessageBox.warning(sMessage, "Wearables Manager 2 - Review legacy storage", "&Use this bone", "&Keep stored");
	    if (nAnswer !== 0) return WM2ReferenceResult(false, "declined", null, "Legacy storage review was declined. Its items remain stored.");
	    // Revalidate after the modal prompt; a reviewed node may have changed meanwhile.
	    return WM2AdoptLegacyBoneProxy(oGroup, oProxy, oHumanFigure, oBone);
	}

	function WM2LoadItemsFromGroup(oManager,oHumanFigure,oGroup) {
		var stored=WM2Support.menuGraph(Scene,oWM2Config).storedRoots(oHumanFigure,oGroup,WM2ReviewAndAdoptLegacyProxy);
		oManager.arrPendingStorageItems=stored.pending;
		for(var i=0;i<stored.roots.length;i++)oManager.iAddItem(stored.roots[i].node,stored.roots[i].parent,true);
		return stored.pending.length===0;
	}

	// Storage recovery helpers: one operation, one pending record, no backup deletion.
	function WM2ReadableBackup(fBackup) {
		// DzFileInfo caches existence/size: refresh after saving a new candidate.
		fBackup.refresh();
		if (!fBackup.exists() || (typeof fBackup.isFile == "function" && !fBackup.isFile()) || fBackup.size() <= 0) return false;
		if (!fBackup.open(DzFile.ReadOnly)) return false;
		try { return true; } finally { fBackup.close(); }
	}
	function WM2CheckPendingShellSnapshot(oHumanFigure, oShellNode, oSettings) {
		var oObject = oShellNode.getObject();
		var oShape = oObject ? oObject.getCurrentShape() : null;
		if (!oShape) return err("Shell shape is unavailable for " + oShellNode.getLabel() + ". Restore the pending wearables first.", false);
		var arrLive = GetExtraMaterialsArray(oShape, GetHumanFigureMaterialsNames(oHumanFigure));
		if (!arrLive) return true;
		var sUVs = oSettings.getStringValue(SETTINGS_UVS, "");
		var arrSaved = sUVs ? sUVs.split(ARRAY_SEPARATOR) : [];
		if (arrSaved.length % 2) return err("Pending shell UV data is incomplete. Restore the pending wearables before removing more.", false);
		for (var i = 0; i < arrLive.length; i++) {
			var oUV = arrLive[i].getUVSetControl();
			var bFound = false;
			for (var j = 0; j < arrSaved.length; j += 2) {
				if (arrSaved[j] == arrLive[i].name && oUV && arrSaved[j + 1] == oUV.getStringValue()) { bFound = true; break; }
			}
			if (!bFound) return err("Shell surfaces or UVs changed while recovery was pending. Restore the pending wearables before removing more.", false);
		}
		return true;
	}
	function WM2SaveShellSnapshots(oHumanFigure, arrShells) {
		for (var i = 0; i < arrShells.length; i++) if (!SaveShellMaterialsInFile(oHumanFigure, arrShells[i])) return false;
		return true;
	}
	function WM2CheckShellSnapshots(arrShells) {
		for (var i = 0; i < arrShells.length; i++) {
			var oData = arrShells[i].findDataItem(DATA_ITEM_NAME);
			var oSettings = oData ? oData.getSettings() : null;
			var sFileName = oSettings ? oSettings.getStringValue(SETTINGS_FILE_NAME, "") : "";
			if (!sFileName) continue;
			var fBackup = new DzFile(WM2SnapshotPath(oSettings, sFileName));
			try { if (!WM2ReadableBackup(fBackup)) return err("Shell backup is missing, empty, or unreadable: " + WM2SnapshotPath(oSettings, sFileName) + ". Recovery remains pending.", false); }
			finally { fBackup.deleteLater(); }
		}
		return true;
	}
	function WM2CheckShellUVMaterials(oNode, arrUVs) {
		var oObject = oNode.getObject();
		var oShape = oObject ? oObject.getCurrentShape() : null;
		if (!oShape) return err("Shell shape is unavailable for " + oNode.getLabel() + ". Recovery remains pending.", false);
		for (var i = 0; i < arrUVs.length; i += 2) {
			var oMaterial = oShape.findMaterial(arrUVs[i]);
			if (!oMaterial || !oMaterial.getUVSetControl()) return err("Shell surface " + arrUVs[i] + " is unavailable. Restore its related assets together. Recovery remains pending.", false);
		}
		return true;
	}
	function WM2QueueReferenceRemoval(oData, oSettings, sPrefix) {
		var arrKeys = WM2GetNodeReferenceKeys(sPrefix);
		for (var i = 0; i < arrKeys.length; i++) oRemoveQueue.AddDataToQueue(oData, oSettings, arrKeys[i]);
	}
	function WM2RestoreNodeState(oHumanFigure, arrNodes, arrShells) {
		for (var i = 0; i < arrNodes.length; i++) {
			if (arrNodes[i].inherits("DzSkeleton") && !RestoreNodeFollowTarget(arrNodes[i], oHumanFigure)) return false;
		}
		processEvents();
		for (var i = 0; i < arrNodes.length; i++) if (!RestoreCollisionItem(arrNodes[i])) return false;
		for (var i = 0; i < arrShells.length; i++) if (!RestoreMaterialsFromFile(arrShells[i])) return false;
		return true;
	}
	function WM2RestoreWearablePairs(oHumanFigure, oGroup, arrPairs, arrShells) {
	    if (!WM2CheckShellSnapshots(arrShells)) return false;
	    if (!oGroup || !WM2SceneContains(oGroup)) return err("The selected storage group changed. Recovery remains pending.", false);
	    // Validate every source ownership relation before moving the first item.
	    for (var i = 0; i < arrPairs.length; i++) {
	        var oWearable = arrPairs[i][0], oParent = arrPairs[i][1];
	        if (!WM2SceneContains(oWearable) || !WM2SceneContains(oParent) || (!WM2SameNode(oParent, oHumanFigure) && !WM2IsBoneOfFigure(oParent, oHumanFigure))) return err("A selected wearable or destination parent changed. Recovery remains pending.", false);
	        var oCurrentParent = oWearable.getNodeParent();
	        if (WM2SameNode(oParent, oHumanFigure)) {
	            if (!WM2SameNode(oCurrentParent, oGroup)) return err("The stored parent changed for " + oWearable.getLabel() + ". Recovery remains pending.", false);
	        } else {
	            var oProxy = WM2ResolveBoneProxy(oGroup, oCurrentParent, oHumanFigure);
	            if (!oProxy.ok || oProxy.status !== "resolved" || !WM2SameNode(oProxy.node, oParent)) return err("The stored bone connection changed for " + oWearable.getLabel() + ". Recovery remains pending.", false);
	        }
	    }
	    var arrNodes = [];
	    for (var i = 0; i < arrPairs.length; i++) {
	        var oWearable = arrPairs[i][0], oParent = arrPairs[i][1];
	        var arrChildren = [oWearable].concat(oWearable.getNodeChildren(true));
	        for (var j = 0; j < arrChildren.length; j++) if (WM2NodeIndexOf(arrNodes, arrChildren[j]) < 0) arrNodes.push(arrChildren[j]);
	        oParent.addNodeChild(oWearable);
	        if (!WM2SameNode(oWearable.getNodeParent(), oParent)) return err("Parent recovery did not apply for " + oWearable.getLabel() + ".", false);
	    }
	    return WM2RestoreNodeState(oHumanFigure, arrNodes, arrShells);
	}
	function WM2RemoveEmptyStorageGroup(oGroup, oHumanFigure) {
		if (!oGroup) return false;
		var arrChildren = oGroup.getNodeChildren(false);
		for (var i = 0; i < arrChildren.length; i++) {
			var oChild = arrChildren[i];
			if (!oChild.inherits("DzGroupNode") || oChild.getNodeChildren(false).length != 0) continue;
			var oProxy = WM2ResolveBoneProxy(oGroup, oChild, oHumanFigure);
			if (oProxy.ok && oProxy.status != "not-proxy") Scene.removeNode(oChild);
		}
		if (oGroup.getNodeChildren(false).length == 0) { Scene.removeNode(oGroup); return true; }
		return false;
	}



	/*-----------------------------------------------------------------*\
							   MAIN BLOCK
	\*-----------------------------------------------------------------*/
	if (!CheckForAnotherProcessActive()) return;
	if (!(oNode = Scene.getPrimarySelection())) return err("Please, select a human figure to proceed.");
	oHumanFigure = GetCurrentHumanFigure(oNode);
	if (!oHumanFigure) {
		// Offer setup before the supported-owner gate; registration remains explicit.
		var wmFigureSetup = WM2ShowSupportedFigures(PATH_ICONS);
		if (!wmFigureSetup.saved) return;
		oWM2Config = WM2Support.load(PATH_ICONS).config;
		if (!CheckForAnotherProcessActive()) return;
		oNode = Scene.getPrimarySelection();
		oHumanFigure = GetCurrentHumanFigure(oNode);
		if (!oHumanFigure) return err("The current selection is still unsupported. No wearables were transferred.");
	}
	var oAnotherFigure = GetAnotherHumanFigureParentedToTheCurrent(oHumanFigure);
	if (oAnotherFigure) return err("Human figure '" + oAnotherFigure.getLabel() + "' is parented to " + oHumanFigure.getLabel() + ". This could potentially cause problems. Please unparent it before continuing.");

	SetStatusBusy();
	try {

	/*
	<--------------- Show Dialog ---------------->
	*/

	var oWearablesManager = new WearablesManagerClass();
	var oWearablesIcons = new WearablesIconsClass();
	var oTagImageManager = new TagImageManagerClass(oHumanFigure);

	var oGroup = GetBelongingsGroup(oHumanFigure, false);
	ShowWearablesDialog(oHumanFigure, oGroup);
	if (!dialog_result) {
		SetStatusFinished();
		return;
	}

	//returns two arrays:
	//0 - arr of nodes to move to the group;
	//1 - arr of pairs [node to move back to the figure, its parent bone on the figure];
	var arrAll = oWearablesManager.GetListsOfMovingWearables();
	if (!arrAll) {
		SetStatusFinished();
		return;
	}

	var arrMovetoGroup = arrAll[0].filter(FilterParentedToHumanFigureAndNotAnExemption, GetDefaultTransferExemptionsList(oHumanFigure));
	var arrMoveToFigurePairs = arrAll[1];
	if (!arrMovetoGroup.length && !arrMoveToFigurePairs.length) { WM2NoEligibleTransfers(); SetStatusFinished(); return; }
	WM2BeginUndo();
	var arrShells = GetAllShells(oHumanFigure, oGroup, true); // get array with all geoshells
	if (arrMovetoGroup.length > 0) {
		//Move wearables into group
		var oGroup = GetBelongingsGroup(oHumanFigure, true); //create group it doesn't exist
		//get an array of nodes parented to the human figure and not to another figure and where no transfer exemptions (like eyelashes)
		arrMovetoGroup = arrMovetoGroup.filter(FilterParentedToHumanFigureAndNotAnExemption, GetDefaultTransferExemptionsList(oHumanFigure)); //just in case, but by this time it should be already filtered

		//save materials for Shells
		if (!WM2SaveShellSnapshots(oHumanFigure, arrShells)) {
			oRemoveQueue.Clear(); WM2CancelUndo(); SetStatusFinished(); return;
		}
		//place wearables into groups
		for (var i = 0; i < arrMovetoGroup.length; i++) PlaceWearableIntoGroup(oHumanFigure, arrMovetoGroup[i], oGroup);
	}

	if (arrMoveToFigurePairs.length > 0) {
		if (!WM2RestoreWearablePairs(oHumanFigure, oGroup, arrMoveToFigurePairs, arrShells)) {
			oRemoveQueue.Clear(); WM2CancelUndo(); SetStatusFinished(); return;
		}
		oRemoveQueue.Finalize();
		WM2RemoveEmptyStorageGroup(oGroup, oHumanFigure);
	}
	WM2AcceptUndo("matew's Wearables - Move Wearables");

	SetStatusFinished();


	} catch (e) {
		oRemoveQueue.Clear();
		WM2CancelUndo();
		err("Wearables Manager stopped safely: " + String(e) + ". Pending recovery records were retained.", false);
	} finally {
		SetStatusFinished();
	}

	/*-----------------------------------------------------------------*\
								   FUNCTIONS
	\*-----------------------------------------------------------------*/

	//Function creatres and checks global variable g_matewWearablesStatus
	//It doesn't allow to launch several matew's wearables scripts together - it could lead to losing data
	function CheckForAnotherProcessActive() {
		if (typeof g_matewWearablesStatus == "undefined" || g_matewWearablesStatus <= 0) {
			g_matewWearablesStatus = 0;
			return true;
		}
		err("Another Wearables Manager operation is active. Close its dialog or let it finish before continuing.", false);
		return false;
	}

	function SetStatusFinished() {
		g_matewWearablesStatus = 0;
	}

	function SetStatusBusy() {
		g_matewWearablesStatus += 1;
	}

	function ReturnAllWearableToTheFigure(oHumanFigure) {
		var oGroup = GetBelongingsGroup(oHumanFigure, false);
		if (!oGroup) return true;
		var arrTop = oGroup.getNodeChildren(false);
		var arrAll = oGroup.getNodeChildren(true);
		var arrShells = GetAllShells(oHumanFigure, oGroup, false);
		// Check sidecars before any parenting/FitTo change.
		if (!WM2CheckShellSnapshots(arrShells)) return false;
		WM2BeginUndo();
		try {
			for (var i = 0; i < arrTop.length; i++) {
				if (!ReturnWearable(oHumanFigure, arrTop[i], oGroup)) { oRemoveQueue.Clear(); WM2CancelUndo(); return false; }
			}
			if (!WM2RestoreNodeState(oHumanFigure, arrAll, arrShells)) { oRemoveQueue.Clear(); WM2CancelUndo(); return false; }
			oRemoveQueue.Finalize();
			WM2RemoveEmptyStorageGroup(oGroup, oHumanFigure);
			WM2AcceptUndo("matew's Wearables - Return Belongings");
			return true;
		} catch (e) {
			oRemoveQueue.Clear(); WM2CancelUndo();
			return err("Wearables recovery stopped: " + String(e) + ". Stored recovery records were retained.", false);
		}
	}

	function GetListOfSkeletonsFromMoveToFigurePairs(arrPairs) {
		//arrPairs[x][0] - node to return; arrPairs[x][1] - its parent on the figure
		var n = arrPairs.length;
		if (n == 0) return;

		var arrResult = [];
		for (var i = 0; i < n; i++) {
			var oWearable = arrPairs[i][0];
			if (oWearable.inherits("DzSkeleton")) arrResult.push(oWearable);
		}
		return arrResult;
	}

	function GetAllShells(oHumanFigure, oGroup, bFilterNotMoved) {
		var arrHumanNodes = oHumanFigure.getNodeChildren(true);
		var arrGroupNodes = [];
		if (oGroup) arrGroupNodes = oGroup.getNodeChildren(true);


		if (arrGroupNodes && arrGroupNodes.length > 0) {
			var arrShells = arrHumanNodes.concat(arrGroupNodes);
		} else {
			var arrShells = arrHumanNodes;
		}

		if (bFilterNotMoved) {
			return arrShells.filter(FilterShellsInGroupsAndNotMoved);
		} else {
			return arrShells.filter(FilterShells);
		}
	}

	function GetListOfShellsFromMoveToFigurePairs(arrPairs) {
		//arrPairs[x][0] - node to return; arrPairs[x][1] - its parent on the figure
		var n = arrPairs.length;
		if (n == 0) return;

		var arrResult = [];
		for (var i = 0; i < n; i++) {
			var oWearable = arrPairs[i][0];
			if (oWearable.inherits("DzGeometryShellNode")) arrResult.push(oWearable);
			var arrChildren = oWearable.getNodeChildren(true);
			if (!arrChildren) continue;

			for (var j = 0; j < arrChildren.length; j++) {
				var oChild = arrChildren[j];
				if (oChild.inherits("DzGeometryShellNode")) arrResult.push(oChild);
			}
		}
		return arrResult;
	}

	function PlaceWearableIntoGroup(oHumanFigure, oWearable, oGroup) {
		if (WM2Support.isProtectedTransfer(oWearable, oHumanFigure, oWM2Config)) throw new Error("This item contains a protected child or its ownership changed. Review Supported Figures > Protected Children.");
		if (!WM2SceneContains(oWearable) || !WM2SceneContains(oHumanFigure) || !WM2SceneContains(oGroup)) throw new Error("A wearable, figure, or storage group is no longer in the scene.");
		var oParent = oWearable.getNodeParent();
		if (!WM2SameNode(oParent, oHumanFigure) && !WM2IsBoneOfFigure(oParent, oHumanFigure)) throw new Error("The wearable's parent changed before transfer.");
		if (oWearable.inherits("DzSkeleton")) {
			var oTarget = oWearable.getFollowTarget();
			if (oTarget) {
				var oSaved = WM2SaveNodeReference(WM2NodeSettings(oWearable, true), SETTINGS_TARGET, oTarget, "name");
				if (!oSaved.ok) throw new Error("Cannot record FitTo recovery: " + oSaved.message);
				if (!SaveCollisionItem(oHumanFigure, oWearable)) throw new Error("Collision recovery could not be recorded.");
				oWearable.setFollowTarget(null);
				if (oWearable.getFollowTarget()) throw new Error("FitTo did not detach for " + oWearable.getLabel() + ".");
			}
		}
		if (WM2SameNode(oParent, oHumanFigure)) oGroup.addNodeChild(oWearable);
		else ParentToBoneGroup(oParent, oWearable);
		if (WM2SameNode(oWearable.getNodeParent(), oParent)) throw new Error("The wearable did not move into storage.");
	}

	function SaveCollisionItem(oHumanFigure, oWearable) {
		var oHelper = new DzSceneHelper();
		var oProp = oHelper.findPropertyByInternalName("Collision Item", oWearable);
		var oTarget = oProp ? oProp.getValue() : null;
		if (!oTarget || WM2SameNode(oTarget, oHumanFigure)) return true;
		var oResult = WM2SaveNodeReference(WM2NodeSettings(oWearable, true), SETTINGS_COLLISION_ITEM, oTarget, "label");
		return oResult.ok ? true : err("Cannot record collision recovery for " + oWearable.getLabel() + ": " + oResult.message, false);
	}

	function RestoreCollisionItem(oWearable) {
		var oData = oWearable.findDataItem(DATA_ITEM_NAME);
		if (!oData) return true;
		var oSettings = oData.getSettings();
		if (!oSettings) return err("Collision recovery settings are unavailable for " + oWearable.getLabel() + ".", false);
		if (!oSettings.getStringValue(SETTINGS_COLLISION_ITEM, "") && !oSettings.getStringValue(SETTINGS_COLLISION_ITEM + "_NodeID", "")) return true;
		var oResolved = WM2ResolveNodeReference(oSettings, SETTINGS_COLLISION_ITEM, "label");
		if (!oResolved.ok) return err("Collision recovery remains pending for " + oWearable.getLabel() + ": " + oResolved.message, false);
		var oHelper = new DzSceneHelper();
		var oCollisionProp = oHelper.findPropertyByInternalName("Collision Item", oWearable);
		if (!oCollisionProp) return err("Collision property is unavailable for " + oWearable.getLabel() + ". Recovery remains pending.", false);
		oCollisionProp.setValue(oResolved.node);
		if (!WM2SameNode(oCollisionProp.getValue(), oResolved.node)) return err("Collision recovery did not apply for " + oWearable.getLabel() + ".", false);
		WM2QueueReferenceRemoval(oData, oSettings, SETTINGS_COLLISION_ITEM);
		return true;
	}

	function ReturnWearable(oHumanFigure, oWearable, oGroup) {
		var oResolved = WM2ReviewAndAdoptLegacyProxy(oGroup, oWearable, oHumanFigure);
		if (oResolved.status != "not-proxy") {
			if (!oResolved.ok) return err("Parent recovery remains pending for " + oWearable.getLabel() + ": " + oResolved.message, false);
			var arrChildren = oWearable.getNodeChildren(false);
			for (var i = arrChildren.length - 1; i >= 0; i--) {
				oResolved.node.addNodeChild(arrChildren[i]);
				if (!WM2SameNode(arrChildren[i].getNodeParent(), oResolved.node)) return err("Parent recovery did not apply for " + arrChildren[i].getLabel() + ".", false);
			}
			// Keep the empty proxy alive until captured descendants finish restoration.
			return true;
		}
		oHumanFigure.addNodeChild(oWearable);
		return WM2SameNode(oWearable.getNodeParent(), oHumanFigure);
	}
	function FilterSkeletons(oNode) {
		if (!oNode) return false;
		return (oNode.inherits("DzSkeleton"));
	}

	function FilterShells(oNode) {
		if (!oNode) return false;
		return (oNode.inherits("DzGeometryShellNode"));
	}

	function FilterShellsInGroupsAndNotMoved(oNode) {
		if (!oNode) return false;
		if (!oNode.inherits("DzGeometryShellNode")) return false;
		return !oWearablesManager.IsWearableInGroupAndNotMoved(oNode);
	}


	function RestoreNodeFollowTarget(oNode, oHumanFigure) {
		var oData = oNode.findDataItem(DATA_ITEM_NAME);
		if (!oData) return true;
		var oSettings = oData.getSettings();
		if (!oSettings) return err("FitTo recovery settings are unavailable for " + oNode.getLabel() + ".", false);
		if (!oSettings.getStringValue(SETTINGS_TARGET, "") && !oSettings.getStringValue(SETTINGS_TARGET + "_NodeID", "")) return true;
		var oResolved = WM2ResolveNodeReference(oSettings, SETTINGS_TARGET, "name");
		if (!oResolved.ok) return err("FitTo recovery remains pending for " + oNode.getLabel() + ": " + oResolved.message, false);
		oNode.setFollowTarget(oResolved.node);
		if (!WM2SameNode(oNode.getFollowTarget(), oResolved.node)) return err("FitTo recovery did not apply for " + oNode.getLabel() + ".", false);
		WM2QueueReferenceRemoval(oData, oSettings, SETTINGS_TARGET);
		return true;
	}

	function RestoreMaterialsFromFile(oNode) {
		var oData = oNode.findDataItem(DATA_ITEM_NAME);
		if (!oData) return true;
		var oDataSettings = oData.getSettings();
		if (!oDataSettings) return err("Shell recovery settings are unavailable for " + oNode.getLabel() + ".", false);
		var sFileName = oDataSettings.getStringValue(SETTINGS_FILE_NAME, "");
		var sUVs = oDataSettings.getStringValue(SETTINGS_UVS, "");
		if (!sFileName) return sUVs ? err("Shell recovery has UV values but no backup filename for " + oNode.getLabel() + ".", false) : true;
		var sPath = WM2SnapshotPath(oDataSettings, sFileName);
		var fMaterial = new DzFile(sPath);
		try {
			if (!WM2ReadableBackup(fMaterial)) return err("Shell backup is missing, empty, or unreadable: " + sPath + ". Recovery remains pending.", false);
			var arrUVs = sUVs ? sUVs.split(ARRAY_SEPARATOR) : [];
			if (arrUVs.length % 2) return err("Shell recovery UV data is incomplete for " + oNode.getLabel() + ".", false);
			if (!WM2CheckShellUVMaterials(oNode, arrUVs)) return false;
			var bLoaded = false;
			beginNodeSelectionHold();
			try {
				Scene.selectAllNodes(false);
				Scene.setPrimarySelection(oNode);
				bLoaded = App.getContentMgr().openFile(sPath, true);
			} finally { restoreNodeSelectionHold(); }
			if (!bLoaded) return err("Shell backup could not be applied: " + sPath + ". Recovery remains pending.", false);
			if (!WM2CheckShellUVMaterials(oNode, arrUVs)) return false;
			var oObject = oNode.getObject();
			var oShape = oObject ? oObject.getCurrentShape() : null;
			for (var i = 0; i < arrUVs.length; i += 2) {
				var oMaterial = oShape.findMaterial(arrUVs[i]);
				var oUVControl = oMaterial.getUVSetControl();
				if (!oUVControl.setValueFromString(arrUVs[i + 1]) || oUVControl.getStringValue() != arrUVs[i + 1]) return err("Shell UV recovery did not apply for surface " + arrUVs[i] + ". Recovery remains pending.", false);
			}
			// Acknowledge only after the preset and every saved UV were applied.
			oRemoveQueue.AddDataToQueue(oData, oDataSettings, SETTINGS_FILE_NAME);
			oRemoveQueue.AddDataToQueue(oData, oDataSettings, "BackupPath");
			oRemoveQueue.AddDataToQueue(oData, oDataSettings, SETTINGS_UVS);
			// Keep the physical sidecar for Undo and retry. Temp cleanup is deferred.
			return true;
		} catch (e) {
			return err("Shell recovery failed for " + oNode.getLabel() + ": " + String(e), false);
		} finally { fMaterial.deleteLater(); }
	}

	function GenerateUniqueGroupFileName(oFigure) {
		return GenerateUniqueID(5) + oFigure.elementID.toString();
	}

	function GenerateUniqueID(id_length) {
		if (!id_length) id_length = 10;
		var result = '';
		var characters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
		var charactersLength = characters.length;
		for (var i = 0; i < id_length; i++) {
			result += characters.charAt(Math.floor(Math.random() * charactersLength));
		}

		return result;
	}

	function BindHumanFigureToGroup(oHumanFigure, oGroup) {
	    if (!oHumanFigure || !IsNodeHumanFigure(oHumanFigure) || !oGroup || oGroup.className() !== "DzGroupNode") throw new Error("Invalid figure or storage group.");
	    if (!WM2SceneContains(oHumanFigure) || !WM2SceneContains(oGroup)) throw new Error("The figure or storage group is no longer in the scene.");
	    var oFigureSettings = WM2NodeSettings(oHumanFigure, true);
	    var oGroupSettings = WM2NodeSettings(oGroup, true);
	    var sID = oFigureSettings.getStringValue(SETTINGS_ID, "");
	    var sGroupID = oGroupSettings.getStringValue(SETTINGS_ID, "");
	    if (sGroupID && sGroupID !== sID) throw new Error("The storage group already belongs to another figure.");
	    if (sID) {
	        var arrMatches = WM2NodesWithValue(SETTINGS_ID, sID);
	        for (var i = 0; i < arrMatches.length; i++) {
	            if (!WM2SameNode(arrMatches[i], oHumanFigure) && !WM2SameNode(arrMatches[i], oGroup)) throw new Error("The saved figure binding is ambiguous.");
	        }
	    } else {
	        sID = WM2UniqueToken(SETTINGS_ID);
	    }
	    oFigureSettings.setStringValue(SETTINGS_ID, sID);
	    oGroupSettings.setStringValue(SETTINGS_ID, sID);
	}

	function SaveShellMaterialsInFile(oHumanFigure, oShellNode) {
		// Keep the original backup while any removal using it is still pending.
		var oPendingData = oShellNode.findDataItem(DATA_ITEM_NAME);
		var oPendingSettings = oPendingData ? oPendingData.getSettings() : null;
		var sPendingFile = oPendingSettings ? oPendingSettings.getStringValue(SETTINGS_FILE_NAME, "") : "";
		if (sPendingFile) {
			var fPending = new DzFile(WM2SnapshotPath(oPendingSettings, sPendingFile));
			try {
				if (!WM2ReadableBackup(fPending)) return err("The original shell backup is missing, empty, or unreadable: " + WM2SnapshotPath(oPendingSettings, sPendingFile) + ". No wearables were moved.", false);
				if (!WM2CheckPendingShellSnapshot(oHumanFigure, oShellNode, oPendingSettings)) return false;
				return true;
			} finally { fPending.deleteLater(); }
		}
		var oObject = oShellNode.getObject();
		if (!oObject) return err("Cannot back up shell " + oShellNode.getLabel() + ": no object.", false);
		var oShape = oObject.getCurrentShape();
		if (!oShape) return err("Cannot back up shell " + oShellNode.getLabel() + ": no shape.", false);
		var aExtraMaterials = GetExtraMaterialsArray(oShape, GetHumanFigureMaterialsNames(oHumanFigure));
		if (!aExtraMaterials) return true;
		var oAssetIOMgr = App.getAssetIOMgr();
		var nAssetIOFilter = oAssetIOMgr.findAssetFilterIndex("DzMaterialAssetFilter");
		if (nAssetIOFilter < 0) return err("The DzMaterialAssetFilter is unavailable. No wearables were moved.", false);
		var oAssetIOFilter = oAssetIOMgr.getAssetFilter(nAssetIOFilter);
		if (!oAssetIOFilter) return err("The DzMaterialAssetFilter is unavailable. No wearables were moved.", false);
		var fCandidate = null;
		try {
			var oSettings = new DzFileIOSettings();
			oAssetIOFilter.getDefaultOptions(oSettings);
			if (!oAssetIOFilter.getOptions(oSettings, false, "")) return err("Shell backup options could not be prepared. No wearables were moved.", false);
			oSettings.setBoolValue("OmitDefinitions", false);
			oSettings.setStringValue("RootLabel", oShellNode.getLabel());
			var aMaterials = oShape.getAllMaterials();
			for (var i = 0; i < aMaterials.length; i++) {
				var oMaterial = aMaterials[i];
				var aPropertyNames = [];
				var aProps = getElementProperties(oMaterial, true, true);
				for (var j = 0; j < aProps.length; j++) {
					var vProp = getPropertyEntry(aProps[j], true, true);
					if (vProp) aPropertyNames.push(vProp);
				}
				// Apply each material's own entries once; preserve Value/Image options.
				if (aPropertyNames.length) setMaterialPropertyOptions(oSettings, oMaterial.name, aPropertyNames);
			}
			oSettings.setBoolValue("BypassFilter", false);
			oSettings.setBoolValue("CompressOutput", false);
			oSettings.setBoolValue("RunSilent", true);
			var sFileName = GenerateUniqueGroupFileName(oShellNode);
			var sBackupDirectory = WM2BackupDirectory();
			var sFilePath = sBackupDirectory + sFileName;
			fCandidate = new DzFile(sFilePath + ".duf");
			if (fCandidate.exists()) return err("A shell backup filename is already in use. Please retry. No wearables were moved.", false);
			var sUVs = GetSerializedUVs(aExtraMaterials);
			var nSaveError = oAssetIOMgr.doSaveWithOptions(oAssetIOFilter, oSettings, true, sFilePath, sBackupDirectory, "");
			// DzAssetIOMgr returns DzError: DZ_NO_ERROR is numeric zero.
			if (nSaveError !== 0 || !WM2ReadableBackup(fCandidate)) return err("Shell backup failed for " + oShellNode.getLabel() + " (DzError " + nSaveError + "). No wearables were moved.", false);
			AddStringDataToNodeEx(oShellNode, DATA_ITEM_NAME, [[SETTINGS_FILE_NAME, sFileName], [SETTINGS_UVS, sUVs], ["BackupPath", sFilePath + ".duf"]]);
			return true;
		} catch (e) {
			return err("Shell backup failed for " + oShellNode.getLabel() + ": " + String(e), false);
		} finally {
			if (fCandidate) fCandidate.deleteLater();
			oAssetIOFilter.deleteLater();
		}
	}
	function AddStringDataToNodeEx(oNode, sDataName, arrSettingsValuePairs) {
		if (!arrSettingsValuePairs) return;

		var oData = oNode.findDataItem(sDataName);
		if (!oData) {
			oData = new DzSimpleElementData(sDataName, true);
			oNode.addDataItem(oData);
		}
		var oDataSettings = oData.getSettings();
		for (var i = 0; i < arrSettingsValuePairs.length; i++) {
			var arrPair = arrSettingsValuePairs[i];
			oDataSettings.setStringValue(arrPair[0], arrPair[1]);
		}
	}

	function AddStringDataToNode(oNode, sDataName, sKey, sValue) {
		if (!sKey || !sDataName || !oNode) return;

		var oData = oNode.findDataItem(sDataName);
		if (!oData) {
			oData = new DzSimpleElementData(sDataName, true);
			oNode.addDataItem(oData);
		}
		var oDataSettings = oData.getSettings();
		oDataSettings.setStringValue(sKey, sValue);
	}



	function GetSerializedUVs(arrMaterials) {
		var arrResult = [];
		for (var i = 0; i < arrMaterials.length; i++) {
			var oMaterial = arrMaterials[i];
			var oUVprop = oMaterial.getUVSetControl();
			var sUV = oUVprop.getStringValue();
			arrResult.push(oMaterial.name);
			arrResult.push(sUV);
		}
		var sResult = arrResult.join(ARRAY_SEPARATOR);
		return sResult;
	}

	//create/find a group for belongins oGroup
	function GetBelongingsGroup(oFigure, bCreateIfNotExists) {
		var sGroupName = String(oFigure.elementID) + "_belongings";

		//var oGroup = Scene.findNode(sGroupName);
		var oGroup = FindBoundGroup(oFigure);
		if (!bCreateIfNotExists) return oGroup;

		if (!oGroup) {
			//create new group
			oGroup = new (DzGroupNode);
			oGroup.setVisible(false);
			var sGroupLabel = oFigure.getLabel() + "_belongings";
			oGroup.setName(sGroupName);
			oGroup.setLabel(sGroupLabel);
			Scene.addNode(oGroup);
			BindHumanFigureToGroup(oFigure, oGroup);
		}

		return oGroup;
	}

	function FindBoundGroup(oHumanFigure) {
	    if (!oHumanFigure || !IsNodeHumanFigure(oHumanFigure)) return false;
	    var oPair = WM2BoundPair(oHumanFigure);
	    if (oPair.status === "ambiguous") throw new Error("Several figures or storage groups share this Wearables Manager binding. Recover the binding before transferring wearables.");
	    return WM2SameNode(oPair.owner, oHumanFigure) && oPair.group ? oPair.group : false;
	}

	function FindBoundFigure(oGroup) {
	    if (!oGroup || oGroup.className() !== "DzGroupNode") return false;
	    var oPair = WM2BoundPair(oGroup);
	    if (oPair.status === "ambiguous") throw new Error("Several figures or storage groups share this Wearables Manager binding. Recover the binding before transferring wearables.");
	    return WM2SameNode(oPair.group, oGroup) && oPair.owner && !WM2SameNode(oPair.owner, oGroup) ? oPair.owner : false;
	}


	//return the human figure where the selected node is parented to
	function GetCurrentHumanFigure(oNode) {
		return WM2Support.menuGraph(Scene,oWM2Config).owner(oNode);
	}

	function IsNodeHumanFigure(oNode) {
		return WM2Support.isSupportedFigure(oNode, oWM2Config);
	}

	function GetAnotherHumanFigureParentedToTheCurrent(oHumanFigure) {
		if (!oHumanFigure) return;
		var arrNodes = oHumanFigure.getNodeChildren(true);
		for (var i = 0; i < arrNodes.length; i++) {
			var oNode = arrNodes[i];
			if (WM2Support.isSupportedFigureType(oNode, oWM2Config)) return oNode;
		}
		return false;
	}

	//Get/Create a group to place nodes that were parented to bones of the figure
	//and parents the oChild to it
	function ParentToBoneGroup(oBone, oChild) {
	    if (!oGroup || !WM2SceneContains(oGroup)) throw new Error("The storage group is no longer in the scene.");
	    if (!WM2IsBoneOfFigure(oBone, oHumanFigure) || !oChild || !WM2SameNode(oChild.getNodeParent(), oBone)) throw new Error("The wearable parent changed before transfer.");
	    var arrChildren = oGroup.getNodeChildren(false);
	    var oBoneGroup = null;
	    for (var i = 0; i < arrChildren.length; i++) {
	        var oSettings = WM2NodeSettings(arrChildren[i], false);
	        if (!oSettings || oSettings.getStringValue("WM2Role", "") !== "BoneProxy") continue;
	        var oResolved = WM2ResolveBoneProxy(oGroup, arrChildren[i], oHumanFigure);
	        if (!oResolved.ok) throw new Error(oResolved.message);
	        if (WM2SameNode(oResolved.node, oBone)) {
	            if (oBoneGroup) throw new Error("Several storage proxies reference the same bone.");
	            oBoneGroup = arrChildren[i];
	        }
	    }
	    if (!oBoneGroup) {
	        oBoneGroup = new DzGroupNode();
	        var sName = oGroup.name + "_" + oBone.name;
	        if (oGroup.findNodeChild(sName, false)) sName += "_" + GenerateUniqueID(10);
	        oBoneGroup.setName(sName);
	        oBoneGroup.setLabel(oGroup.getLabel() + "_" + oBone.getLabel());
	        Scene.addNode(oBoneGroup);
	        if (!WM2SceneContains(oBoneGroup)) {
	            throw new Error("The new bone storage group could not be added to the scene.");
	        }
	        oGroup.addNodeChild(oBoneGroup);
	        if (!WM2SameNode(oBoneGroup.getNodeParent(), oGroup)) {
	            if (oBoneGroup.getNodeChildren(false).length === 0) Scene.removeNode(oBoneGroup);
	            throw new Error("The new bone storage group could not be attached to its storage owner.");
	        }
	        var oMarked = WM2MarkBoneProxy(oBoneGroup, oHumanFigure, oBone);
	        if (!oMarked.ok) {
	            if (oBoneGroup.getNodeChildren(false).length === 0) Scene.removeNode(oBoneGroup);
	            throw new Error(oMarked.message);
	        }
	    }
	    oBoneGroup.addNodeChild(oChild);
	}


	//returns True if its parented to the root of the human figure or to one of its bones
	//and false it its parented to another node
	function FilterParentedToHumanFigureAndNotAnExemption(oChild) {
	    if (!oChild || oChild.inherits("DzBone") || !oHumanFigure) return false;
	    if (WM2Support.isProtectedTransfer(oChild, oHumanFigure, oWM2Config)) return false;
	    var oNode = oChild;
	    while (oNode && !WM2SameNode(oNode, oHumanFigure)) {
	        if (this && this.indexOf(oNode.name) > -1) return false;
	        oNode = oNode.getNodeParent();
	    }
	    if (!WM2SameNode(oNode, oHumanFigure)) return false;
	    return IsParentedToHuman(oChild.getNodeParent());
	}

	function FilterNoBones(oChild) {
		return (!oChild.inherits("DzBone"));
	}

	function FilterMarkedForTransferring(oWearable) {
		var oData = oWearable.findDataItem(DATA_ITEM_NAME);
		if (!oData) return bTransferByDefault;

		var oDataSettings = oData.getSettings();
		var sValue = oDataSettings.getStringValue(SETTIGNS_TRANSFER, bTransferByDefault ? VALUE_TRANSFER_YES : VALUE_TRANSFER_NO);
		return (sValue == VALUE_TRANSFER_YES);
	}

	//returns true if oNode is parented to the human figure directly and false if its parented to another node
	function IsParentedToHuman(oNode) {
	    while (oNode && oNode.inherits("DzBone")) oNode = oNode.getNodeParent();
	    return WM2SameNode(oNode, oHumanFigure);
	}

	function err(sMessage, retValue) {
		MessageBox.critical(sMessage, "Critical Error", "&OK");
		//MessageBox.critical(qsTr(sMessage), qsTr("Critical Error"), qsTr("&OK"));
		return retValue;
	}
	function question(sMessage) {
		return MessageBox.warning(sMessage, "matew's Wearables", "&Yes", "&No");
	}

	function GetHumanFigureMaterialsNames(oFigure) {
		if (!oFigure) return false;
		var sName = oFigure.name;
		var arrMaterials = [];
		if (sName == "Genesis9") {
			arrMaterials = ["Fingernails", "Toenails", "Legs", "Mouth Cavity", "Arms", "Head", "Body"];
		} else if (sName == "Genesis8_1Female" || sName == "Genesis8_1Male") {
			arrMaterials = ["Body", "Face", "Lips", "Teeth", "Head", "Ears", "Legs", "EyeSocket", "Mouth", "Arms", "Pupils", "EyeMoisture", "Fingernails", "Cornea", "Irises", "Sclera", "Toenails"];
		} else if (sName == "Genesis8Female" || sName == "Genesis8Male") {
			arrMaterials = ["Torso", "Face", "Lips", "Teeth", "Ears", "Legs", "EyeSocket", "Mouth", "Arms", "Pupils", "EyeMoisture", "Fingernails", "Cornea", "Irises", "Sclera", "Toenails"];
		} else if (sName == "Genesis3Female" || sName == "Genesis3Male") {
			arrMaterials = ["Eyelashes", "Fingernails", "Toenails", "Cornea", "Pupils", "Face", "Lips", "Teeth", "Sclera", "Torso", "Ears", "Irises", "Legs", "EyeSocket", "EyeMoisture", "Mouth", "Arms"];
		} else if (sName == "Genesis2Female" || sName == "Genesis2Male") {
			arrMaterials = ["Legs", "EyeReflection", "Nostrils", "Lacrimals", "Pupils", "Lips", "Tear", "Gums", "Irises", "Teeth", "Cornea", "Face", "Toenails", "Sclera", "Fingernails", "Head", "Ears", "Hands", "Shoulders", "Neck", "Hips", "Torso", "Nipples", "Forearms", "Feet", "Eyelashes", "Tongue", "InnerMouth"];
		} else if (sName == "Genesis") {
			arrMaterials = ["3_SkinFoot", "6_Eyelash", "5_Sclera", "5_Pupil", "5_Iris", "5_Cornea", "4_Tongue", "4_Teeth", "4_InnerMouth", "4_Gums", "3_SkinArm", "2_SkinTorso", "2_Nipple", "2_SkinNeck", "3_SkinForearm", "3_SkinLeg", "2_SkinHip", "2_SkinHead", "3_SkinHand", "7_Tear", "1_Nostril", "1_Lip", "5_Lacrimal", "1_SkinFace", "3_Fingernail", "3_Toenail"];
		}

		return arrMaterials;
	}

	function GetDefaultTransferExemptionsList(oFigure) {
		if (!oFigure) return [];
		return WM2Support.protectedChildNames(oWM2Config, WM2Support.figureInternalName(oFigure));
	}


	function GetExtraMaterialsArray(oShape, arrDefaultMaterialsNames) {
		if (!arrDefaultMaterialsNames || !oShape) return false;
		var arrMaterials = oShape.getAllMaterials();

		var n = arrMaterials.length;
		if (n == arrDefaultMaterialsNames.length) return false;

		var arrExtra = [];
		for (var i = 0; i < n; i++) {
			var oMat = arrMaterials[i];
			if (arrDefaultMaterialsNames.indexOf(oMat.name) >= 0) continue;
			arrExtra.push(oMat);
		}

		return arrExtra;
	}


	/*********************************************************************/
	// void : A function for setting the property options for a node
	function setMaterialPropertyOptions(oSettings, sMaterialName, aPropNames) {
		// Set the property options for the named material
		setElementPropertyOptions(oSettings, "MaterialNames", sMaterialName, aPropNames, true, false);
	};

	/*********************************************************************/
	// void : A function for setting common property options for multiple nodes
	function setCommonMaterialPropertyOptions(oSettings, aMaterialNames, aPropNames) {
		// Iterate over the material names array
		for (var i = 0; i < aMaterialNames.length; i += 1) {
			// Set the property options for the 'current' material name
			setMaterialPropertyOptions(oSettings, aMaterialNames[i], aPropNames);
		}
	};

	/*********************************************************************/
	// String || Array<String,String> : A function for getting the property entry
	function getPropertyEntry(oProperty, bIncludeValue, bIncludeImage) {
		// If the property is numeric and mappable
		if (oProperty.inherits("DzNumericProperty") && oProperty.isMappable()) {
			// If we are including value and image
			if (bIncludeValue == bIncludeImage) {
				// Use the label
				return oProperty.getLabel();
				// If we are only including the value
			} else if (bIncludeValue) {
				// Use the label and Value keyword
				return [oProperty.getLabel(), "Value"];
				// If we are only including the image
			} else if (bIncludeImage) {
				// Use the label and Image keyword
				return [oProperty.getLabel(), "Image"];
			} else {
				return undefined;
			}
		}

		// Use the label
		return oProperty.getLabel();
	};

	/*********************************************************************/

	/*********************************************************************/
	// Array<DzProperty> : A function for getting a list of the properties in a group
	function getGroupProperties(oGroup, bTraverse, bRecurse) {
		// Declare an array to hold properties
		var aProperties = [];

		// If a group is not passed in
		if (!oGroup) {
			// We are done, return an empty array
			return aProperties;
		}

		// Get the number of proeprties in the group
		var nProperties = oGroup.getNumProperties();
		// Pre-size the properties array
		aProperties = new Array(nProperties);
		// Iterate over the properties, setting each element in the array
		for (var i = 0; i < nProperties; i += 1) {
			// Assign the property to the position in the array
			aProperties[i] = oGroup.getProperty(i);
		}

		// If we are recursing
		if (bRecurse) {
			// Concatenate the properties array from child groups
			aProperties = aProperties.concat(
				getGroupProperties(oGroup.getFirstChild(), true, bRecurse));
		}

		// If we are traversing
		if (bTraverse) {
			// Concatenate the properties array from sibling groups
			aProperties = aProperties.concat(
				getGroupProperties(oGroup.getNextSibling(), bTraverse, bRecurse));
		}

		// Return the array of properties
		return aProperties;
	};

	/*********************************************************************/
	// Array<DzProperty> : A function for getting the list properties for an element
	function getElementProperties(oElement, bTraverse, bRecurse) {
		// Get the property group tree for the element
		var oPropertyGroupTree = oElement.getPropertyGroups();

		// If the application version is 4.9.0.101 or newer and we want all properties
		if (App.version64 >= 0x0004000900040065 && bTraverse && bRecurse) {
			// Return the properties for the element
			return oPropertyGroupTree.getAllProperties();
		}

		// Get the first group in the tree
		var oPropertyGroup = oPropertyGroupTree.getFirstChild();
		// Return the properties for the element
		return getGroupProperties(oPropertyGroup, bTraverse, bRecurse);
	};


	/*********************************************************************/
	// void : A function for setting the property options for an element
	function setElementPropertyOptions(oSettings, sElementSettingsKey, sElementName, aPropNames, bSubItems, bNameAsKey) {
		// Get the (nested) settings that hold the named element and properties
		var oElementsSettings = oSettings.getSettingsValue(sElementSettingsKey);
		// If the object doesn't already exist
		if (!oElementsSettings) {
			// Create it
			oElementsSettings = oSettings.setSettingsValue(sElementSettingsKey);
		}

		// Get the (nested) settings object for the element
		var oElementSettings = oElementsSettings.getSettingsValue(sElementName);
		// If the object doesn't already exist
		if (!oElementSettings) {
			// Create it
			oElementSettings = oElementsSettings.setSettingsValue(sElementName);
		}

		// Declare working variable
		var vPropertyItem;
		var sPropertyName;
		var oPropertySettings, oSubItemSettings;

		// Iterate over the property items
		for (var i = 0; i < aPropNames.length; i += 1) {
			// Get the 'current' property item
			vPropertyItem = aPropNames[i];

			// If the filter doesn't support property sub-items,
			// or the property item is a string
			if (!bSubItems || typeof (vPropertyItem) == "string") {
				// Set the property name to the item
				sPropertyName = vPropertyItem;

				// Add a setting wherein the key is the index in the list
				// and the value is the property name
				oElementSettings.setStringValue(String(i), sPropertyName);
				// If the property item is an array
			} else if (typeof (vPropertyItem) == "object" && Array.isArray(vPropertyItem)) {
				// Set the property name to the first item, which should be a string
				sPropertyName = (vPropertyItem.length > 0 &&
					typeof (vPropertyItem[0]) == "string" ? vPropertyItem[0] : "");
				// If the name was not set
				if (sPropertyName.isEmpty()) {
					// Next!!
					continue;
				}

				if (bNameAsKey) {
					// Get the (nested) settings object for the property
					oPropertySettings = oElementSettings.getSettingsValue(sPropertyName);
					// If the object doesn't already exist
					if (!oPropertySettings) {
						// Create it
						oPropertySettings = oElementSettings.setSettingsValue(sPropertyName);
					}

					// Iterate over the items, skippping the first element
					for (var j = 1; j < vPropertyItem.length; j += 1) {
						// Set a named key to the value
						oPropertySettings.setStringValue(String(j - 1), vPropertyItem[j])
					}
				} else {
					// Get the (nested) settings object for the property
					oPropertySettings = oElementSettings.getSettingsValue(i);
					// If the object doesn't already exist
					if (!oPropertySettings) {
						// Create it
						oPropertySettings = oElementSettings.setSettingsValue(i);
					}

					// Set the name setting
					oPropertySettings.setStringValue("name", sPropertyName);
					// Get the (nested) settings object for the subitems
					oSubItemSettings = oPropertySettings.getSettingsValue("subitems");
					// If the object doesn't already exist
					if (!oSubItemSettings) {
						// Create it
						oSubItemSettings = oPropertySettings.setSettingsValue("subitems");
					}

					// Iterate over the items, skippping the first element
					for (var j = 1; j < vPropertyItem.length; j += 1) {
						// Set an index key to the value
						oSubItemSettings.setStringValue(String(j - 1), vPropertyItem[j])
					}
				}
			}
		}
	};





	/*-----------------------------------------------------------------*\
							   CREATE DIALOG
	\*-----------------------------------------------------------------*/



	function ShowWearablesDialog(oHumanFigure, oGroup) {

		var dir_icons = new DzDir(PATH_ICONS);
		var pixImageEmpty = new Pixmap(dir_icons.filePath("Wearables Manager - Empty.png"));
		var pixImageArrowRight = new Pixmap(dir_icons.filePath("Wearables Manager - Arrow Right.png"));
		var pixImageArrowLeft = new Pixmap(dir_icons.filePath("Wearables Manager - Arrow Left.png"));
		var pixImageOk = new Pixmap(dir_icons.filePath("Wearables Manager - Ok.png"));
		var pixImageCancel = new Pixmap(dir_icons.filePath("Wearables Manager - Cancel.png"));
		var pixImageSave = new Pixmap(dir_icons.filePath("Wearables Manager - Save.png"));
		dir_icons.deleteLater();

		var arrWM2IconButtons = [];
		var sHumanLabel = oHumanFigure.getLabel();



		var wDlg = new DzBasicDialog();
		var oDlgWgt = wDlg.getWidget();
		wDlg.caption = "Matew Wearables: Custom Relocation of " + sHumanLabel + "'s Wearables";
		var sKey = wDlg.caption.replace(/ /g, "") + "Dlg";
		oDlgWgt.objectName = sKey;
		wDlg.showHelpButton(false);
		wDlg.showCancelButton(false);
		wDlg.showAcceptButton(false);

		var iDlgWidth = 1600;
		var iScrlHeight = 640;
		var WCONTAINER_HEIGHT = 100;
		var WCONTAINER_PADDING_LEFT = 10;
		var WCONTAINER_PADDING_RIGHT = 10;
		var INDENT_PER_TREE_LEVEL = 40;

		var fontLabels = new Font();
		fontLabels.pixelSize = 14;

		/*
		<--------------- Containers with wearables ---------------->
		*/

		// 1 Outer V Container
		var wgroupOuter = new DzVGroupBox(wDlg); //Holds all Groups, TextBox, Buttons
		var wmSettingsRow = new DzHGroupBox(wgroupOuter);
		var wmIconRulesButton = WM2SettingsButton(wmSettingsRow, "Icon Rules...", PATH_ICONS, "Wearables Manager - Prop.png");
		function WM2OpenIconRulesFromDialog() {
			var result = WM2ShowIconRules(PATH_ICONS,function(){return {owner:oHumanFigure,items:oWearablesManager.arrWearableItems};});
			if (result && result.saved) {
				// Keep this transfer dialog's figure registry while refreshing icon rules.
				oWM2Config.iconRules = WM2Support.clone(result.config.iconRules);
				for (var i=0; i<arrWM2IconButtons.length; i++) setWearablesButtonPixmap(arrWM2IconButtons[i].button, oWearablesIcons.GetIconForWearable(arrWM2IconButtons[i].node));
			}
		}
		connect(wmIconRulesButton, "clicked()", wmIconRulesButton, WM2OpenIconRulesFromDialog);

		// 2 H Container for Scrool areas
		var wcontScrollsHolder = new DzHGroupBox(wgroupOuter);
		var layoutScrollsHolder = new DzBoxLayout(wcontScrollsHolder);

		// 3 Scroll Area for Human Figure Wearables
		var wscrollHumanFigure = new DzScrollArea(wcontScrollsHolder);
		wscrollHumanFigure.minHeight = iScrlHeight;
		wscrollHumanFigure.alignment = wDlg.AlignVCenter;
		wscrollHumanFigure.setHorizontalScrollbarDisplay(false);
		wscrollHumanFigure.widgetResizable = true;
		layoutScrollsHolder.addWidget(wscrollHumanFigure);

		// 3.1 V Container for Human's wearables
		var wcontHumanFigureContainer = new DzVGroupBox(wscrollHumanFigure);
		wcontHumanFigureContainer.title = "Stay with " + sHumanLabel + ":";
		wscrollHumanFigure.setWidget(wcontHumanFigureContainer);


		// 4 Scroll Area for Wearables in the Group
		layoutScrollsHolder.addSpacing(20);
		var wscrollGroup = new DzScrollArea(wcontScrollsHolder);
		wscrollGroup.minHeight = iScrlHeight;
		wscrollGroup.alignment = wDlg.AlignVCenter;
		wscrollGroup.setHorizontalScrollbarDisplay(false);
		wscrollGroup.widgetResizable = true;
		layoutScrollsHolder.addWidget(wscrollGroup);

		// 4.1 V Container for wearables in the group
		var wcontGroupContainer = new DzVGroupBox(wscrollGroup);
		wcontGroupContainer.title = "Move to the Group";
		wscrollGroup.setWidget(wcontGroupContainer);

		// 5 Empty containers (when no wearables)

		// 5.1 for Human Figure
		var wcontEmptyWearableFigure = new DzHGroupBox(wcontHumanFigureContainer);
		wcontEmptyWearableFigure.setFixedHeight(WCONTAINER_HEIGHT);

		var wImage = new DzLabel(wcontEmptyWearableFigure);
		wImage.sizedFromIcon = false;
		wImage.setFixedSize(91, 91);
		wImage.text = "";
		wImage.pixmap = pixImageEmpty;

		var wLabel = new DzLabel(wcontEmptyWearableFigure);
		wLabel.font = fontLabels;
		wLabel.text = "[No wearables]";

		// 5.1 for Group
		var wcontEmptyWearableGroup = new DzHGroupBox(wcontGroupContainer);
		wcontEmptyWearableGroup.setFixedHeight(WCONTAINER_HEIGHT);

		var wImage = new DzLabel(wcontEmptyWearableGroup);
		wImage.sizedFromIcon = false;
		wImage.setFixedSize(91, 91);
		wImage.text = "";
		wImage.pixmap = pixImageEmpty;

		var wLabel = new DzLabel(wcontEmptyWearableGroup);
		wLabel.font = fontLabels;
		wLabel.text = "[No wearables]";

		/*
		<--------------- Buttons ---------------->
		*/

		var grButtonsGroup = new DzHGroupBox(wgroupOuter);
		grButtonsGroup.setFixedSize(iDlgWidth - 10, 50);
		var oBtnLayout = new DzBoxLayout(grButtonsGroup);

		// 1 - Button move to group
		var wBtnMoveAllToGroup = new DzPushButton(grButtonsGroup);
		wBtnMoveAllToGroup.text = "Unparent All from " + sHumanLabel;
		wBtnMoveAllToGroup.setFixedSize(200, 30);
		wBtnMoveAllToGroup.sizedFromIcon = false;
		setWearablesButtonPixmap(wBtnMoveAllToGroup, pixImageArrowRight, new Size(16, 16));
		oBtnLayout.addWidget(wBtnMoveAllToGroup);
		connect(wBtnMoveAllToGroup, "clicked()", wBtnMoveAllToGroup, wBtnMoveAllToGroupClicked);

		oBtnLayout.addSpacing(60);

		// 2 - Button Cancel
		var wBtnClose = new DzPushButton(grButtonsGroup);
		wBtnClose.text = "Cancel Transfer";
			wBtnClose.toolTip = "Cancel the pending transfer. Property changes apply immediately.";
		wBtnClose.setFixedSize(150, 30);
		wBtnClose.sizedFromIcon = false;
		setWearablesButtonPixmap(wBtnClose, pixImageCancel, new Size(16, 16));
		oBtnLayout.addWidget(wBtnClose);
		connect(wBtnClose, "clicked()", wBtnClose, wBtnCloseClicked);

		// 3 - Button Ok
		var wBtnTransfer = new DzPushButton(grButtonsGroup);
		wBtnTransfer.text = "Transfer Wearables";
		wBtnTransfer.setFixedSize(150, 30);
		//wBtnSave.setFixedSize(91, 91);
		wBtnTransfer.sizedFromIcon = false;
		setWearablesButtonPixmap(wBtnTransfer, pixImageOk, new Size(16, 16));
		connect(wBtnTransfer, "clicked()", wBtnTransfer, wBtnTransferClicked);
		oBtnLayout.addWidget(wBtnTransfer);

		// 4 - Button Save State
		var wBtnSaveState = new DzPushButton(grButtonsGroup);
		wBtnSaveState.text = "Transfer & Save Current State";
		wBtnSaveState.setFixedSize(220, 30);
		wBtnSaveState.sizedFromIcon = false;
		setWearablesButtonPixmap(wBtnSaveState, pixImageSave, new Size(16, 16));
		oBtnLayout.addWidget(wBtnSaveState);
		connect(wBtnSaveState, "clicked()", wBtnSaveState, wBtnSaveStateClicked);

		oBtnLayout.addSpacing(60);

		// 5 - Button move to figure
		var wBtnMoveAllToHuman = new DzPushButton(grButtonsGroup);
		wBtnMoveAllToHuman.text = "Return All to " + sHumanLabel;

		wBtnMoveAllToHuman.setFixedSize(200, 30);
		wBtnMoveAllToHuman.sizedFromIcon = false;
		setWearablesButtonPixmap(wBtnMoveAllToHuman, pixImageArrowLeft, new Size(16, 16));
		oBtnLayout.addWidget(wBtnMoveAllToHuman);
		connect(wBtnMoveAllToHuman, "clicked()", wBtnMoveAllToHuman, wBtnMoveAllToHumanClicked);


		// Add the widget to the dialog
		wDlg.addWidget(wgroupOuter);
		wDlg.setFixedSize(iDlgWidth, oDlgWgt.minimumSizeHint.height);

		//Fill Data
		oWearablesManager.SetNoItemsWidgets(wcontEmptyWearableFigure, wcontEmptyWearableGroup);
		oWearablesManager.SetMoveSensitiveButtons(wBtnMoveAllToHuman, wBtnMoveAllToGroup, wBtnTransfer, wBtnSaveState);
		FillWidgetContainers(wcontHumanFigureContainer, wcontGroupContainer, oGroup);
		oWearablesManager.UpdateMoveItemsSensitiveWidgets();


		/*-----------------------------------------------------------------*\
								 DIALOG'S SIGNALS
		\*-----------------------------------------------------------------*/
		if (wDlg.exec()) {
		}

		wDlg.deleteLater();

		function wBtnCloseClicked() {
			dialog_result = false;
			wDlg.close();
		}


		function wBtnMoveAllToHumanClicked() {
			oWearablesManager.MoveAllWearablesToHuman();
		}

		function wBtnMoveAllToGroupClicked() {
			oWearablesManager.MoveAllWearablesToGroup();
		}

		function wBtnMoveToGroupClicked() {
			oWearablesManager.MoveWearableToGroup(this.wearable);
		}

		function wBtnMoveToHumanFigureClicked() {
			oWearablesManager.MoveWearableToHuman(this.wearable);
		}

		function wBtnSaveStateClicked() {
			dialog_result = true;
			oWearablesManager.SetTransferringMarks();
			wDlg.close();
		}

		function wBtnTransferClicked() {
			dialog_result = true;
			wDlg.close();
		}



		/*-----------------------------------------------------------------*\
								 DIALOG'S FUNCTIONS
		\*-----------------------------------------------------------------*/

		function FillWidgetContainers(wHumanFigureContainer, wGroupContainer, oGroup) {
			oWearablesManager.LoadItemsFromHumanFigure(oHumanFigure);
			oWearablesManager.LoadItemsFromGroup(oHumanFigure, oGroup);
			var arrWearables = oWearablesManager.GetListofNodes();

			for (var i = 0; i < arrWearables.length; i++) {
				AddWidgetToContainer(wHumanFigureContainer, arrWearables[i], true);
				AddWidgetToContainer(wGroupContainer, arrWearables[i], false);
			}
		}

		function AddWidgetToContainer(wContainer, oWearable, bHumanContainer) {
			// 1 V Container for the wearable and all parented
			var wwvOuter = new DzVGroupBox(wContainer);
			if (bHumanContainer) {
				oWearablesManager.SetWearableHumanFigureWidgetContainer(oWearable, wwvOuter);
			} else {
				oWearablesManager.SetWearableGroupWidgetContainer(oWearable, wwvOuter);
			}

			AddWearableInfoToWidget(wwvOuter, oWearable, bHumanContainer, 0);

			var isInTheGroup = oWearablesManager.IsWearableInTheGroup(oWearable);
			if ((!isInTheGroup && bHumanContainer) || (isInTheGroup && !bHumanContainer)) {
				wwvOuter.show();
			} else {
				wwvOuter.hide();
			}

		}

		function AddWearableInfoToWidget(wwvOuter, oWearable, bHumanContainer, treeLevel) {
			// 2 H Container for each wearable (the wearable and each paranted)
			var wwhPersonal = new DzHGroupBox(wwvOuter);
			wwhPersonal.setFixedHeight(WCONTAINER_HEIGHT);
			var layoutPersonal = new DzBoxLayout(wwhPersonal);
			layoutPersonal.addSpacing(WCONTAINER_PADDING_LEFT);
			if (bHumanContainer) layoutPersonal.addSpacing(treeLevel * INDENT_PER_TREE_LEVEL);

			// 2.3 Button Move (group)
			var wBtnMove
			if (!bHumanContainer && treeLevel == 0) {
				wBtnMove = new DzPushButton(wwhPersonal);
				connect(wBtnMove, "clicked()", wBtnMove, wBtnMoveToHumanFigureClicked);
				setWearablesButtonPixmap(wBtnMove, pixImageArrowLeft);
				layoutPersonal.addWidget(wBtnMove);
				layoutPersonal.addSpacing(WCONTAINER_PADDING_LEFT);
			}

			// 2.1 Image (human figure)
			if (bHumanContainer) {
				var wImage = new DzPushButton(wwhPersonal);
				layoutPersonal.addWidget(wImage);
				layoutPersonal.addSpacing(WCONTAINER_PADDING_LEFT);
			}

			// 2.2 Label
			var wLabel = new DzLabel(wwhPersonal);
			wLabel.font = fontLabels;
			var sItemAuthor = GetWearableItemAuthorString(oWearable);

			var sText = "";
			var oParent = oWearablesManager.GetWearableParentNode(oWearable);
			if (oParent && oParent.elementID != oHumanFigure.elementID) {
				//wLabel.wordWrap = true;
				sText += "<span style='font-size: 12px;'>" + oParent.getLabel() + "</span> >> ";
			}


			sText += "<span style='color:#FFFFDE'><b>" + oWearable.getLabel() + "</b></span>";

			if (sItemAuthor) {
				wLabel.wordWrap = true;
				sText += "<br><span style='font-size: 12px;'><i>" + sItemAuthor + "</i></span>";
			} else {
				//var sText = oWearable.getLabel();
			}

			wLabel.text = sText;
			layoutPersonal.addWidget(wLabel);


			// 3 Image Tags
			AddTagImages(wwhPersonal, layoutPersonal, oWearable, bHumanContainer);


			// 2.1 Image (group)
			if (!bHumanContainer) {
				var wImage = new DzPushButton(wwhPersonal);
				layoutPersonal.addWidget(wImage);
			}
			wImage.sizedFromIcon = true;
			wImage.setFixedSize(91, 91);
			wImage.buttonStyle = DzPushButton.BTool;
			wImage.text = "";
			setWearablesButtonPixmap(wImage, oWearablesIcons.GetIconForWearable(oWearable));
			arrWM2IconButtons.push({button:wImage,node:oWearable});
			wImage.wearable = oWearable;
			connect(wImage, "clicked()", wImage, wImageClicked);


			// 2.3 Button Move (human figure)
			if (treeLevel == 0) {
				if (bHumanContainer) {
					wBtnMove = new DzPushButton(wwhPersonal);
					connect(wBtnMove, "clicked()", wBtnMove, wBtnMoveToGroupClicked);
					setWearablesButtonPixmap(wBtnMove, pixImageArrowRight);
					layoutPersonal.addWidget(wBtnMove);
				}
				wBtnMove.text = "";
				wBtnMove.setFixedSize(80, 50);
				wBtnMove.sizedFromIcon = true;
				wBtnMove.wearable = oWearable;
			}

			layoutPersonal.addSpacing(WCONTAINER_PADDING_RIGHT);
			if (!bHumanContainer) layoutPersonal.addSpacing(treeLevel * INDENT_PER_TREE_LEVEL);

			var arrChildren = oWearable.getNodeChildren(false);
			if (!arrChildren) return;
			arrChildren = arrChildren.filter(FilterNoBones);

			for (var i = 0; i < arrChildren.length; i++) {
				var oChild = arrChildren[i];
				AddWearableInfoToWidget(wwvOuter, oChild, bHumanContainer, treeLevel + 1)
			}
		}

		function wImageClicked() {
			var oWearable = this.wearable;
			if (!oWearable) return;
			var nModifierKeyState = App.modifierKeyState();
			var bShiftPressed = (nModifierKeyState & 0x02000000) != 0;
			if (!bShiftPressed) {
				Scene.selectAllNodes(false);
				Scene.setPrimarySelection(oWearable);
				return;
			}

			bSelected = oWearable.isSelected();
			oWearable.select(!bSelected);

			this.checkable = true;
			this.checked = true;
		}

		function AddTagImages(oContainer, oLayout, oWearable, bHumanContainer) {
			var INTERIMAGE_SPACING = 7;

			oTagImageManager.SetCurrentWidgetsContainer(oContainer, oLayout, bHumanContainer);

			var arrImageTypes = [oTagImageManager.TAG_IMAGE_LIGHT, oTagImageManager.TAG_IMAGE_EMISSIVE, oTagImageManager.TAG_IMAGE_VISIBILITY, oTagImageManager.TAG_IMAGE_FIT_TO, oTagImageManager.TAG_IMAGE_DFORCE, oTagImageManager.TAG_IMAGE_SUBD, oTagImageManager.TAG_IMAGE_SMOOTH];
			for (var i = 0; i < arrImageTypes.length; i++) {
				if (oTagImageManager.AddTagImage(oWearable, arrImageTypes[i])) oLayout.addSpacing(INTERIMAGE_SPACING);
			}

			if (oTagImageManager.HasTagIcons(oWearable)) oLayout.addSpacing(50);

		}

		function GetWearableItemAuthorString(oWearable) {
			if (!oWearable) return false;

			// Get the asset URI from the node
			var oAssetUri = oWearable.assetUri;
			// Get the relative file path portion of the URI
			var sRelPath = oAssetUri.filePath;

			var sVendor = "", sProduct = "", sItemKey = "";
			// Split the path into its constituent parts
			var aParts = sRelPath.split("/");
			if (aParts.length == 6) {
				// If the standard has been followed;
				// i.e., /data/Vendor/Product/Item/Name.dsf
				// We can extract information from their positions
				sVendor = aParts[2];
				sProduct = aParts[3];
				sItemKey = aParts[4];
			}

			var sAuthor = oWearable.assetAuthor.toString();
			if (!sAuthor) {
				sAuthor = sVendor;
			} else if (sAuthor.indexOf("\"") >= 0) {
				//["Author name","",""]
				arrAuthor = sAuthor.split("\"");
				if (arrAuthor.length > 2) sAuthor = arrAuthor[1];
			}

			//if (sProduct) sItemKey = sProduct;
			if (!sItemKey) sItemKey = oWearable.assetId;

			if (sItemKey && sAuthor) {
				var sResult = sItemKey + " by " + sAuthor;
			} else if (sItemKey) {
				var sResult = sItemKey;
			} else if (sAuthor) {
				var sResult = "by " + sAuthor;
			} else {
				sResult = "";
			}
			return sResult;
		};

	}

})();
