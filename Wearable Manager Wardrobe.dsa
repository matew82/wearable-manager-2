            if (!m) throw problem("SETTINGS_NAME", String(names[i]));
            if (Number(m[1]) === n) throw problem("SETTINGS_FORK", "Conflicting settings revisions.");
            if (Number(m[1]) > n) { n = Number(m[1]); best = String(names[i]); }
        }
