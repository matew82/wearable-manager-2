            var v=Number(control.getValue());
            if(timing) timing.evaluatedMs+=Math.max(0,new Date().getTime()-stamp);
            if(!isFinite(v)) throw new Error("Non-finite transform on "+n.getLabel()+" / "+method);
            values.push({method:method,value:v});
            if(keepHandles) handles.push(control);
            if(timing) timing.controls++;
        }
        try {
            p=null; started=timing?new Date().getTime():0;
            if(typeof n.getXPosControl === "function") { requested++; p=n.getXPosControl(); }
            if(timing) timing.controlResolutionMs+=Math.max(0,new Date().getTime()-started);
            capture(p,"getXPosControl");
            p=null; started=timing?new Date().getTime():0;
            if(typeof n.getYPosControl === "function") { requested++; p=n.getYPosControl(); }
            if(timing) timing.controlResolutionMs+=Math.max(0,new Date().getTime()-started);
            capture(p,"getYPosControl");
            p=null; started=timing?new Date().getTime():0;
            if(typeof n.getZPosControl === "function") { requested++; p=n.getZPosControl(); }
            if(timing) timing.controlResolutionMs+=Math.max(0,new Date().getTime()-started);
            capture(p,"getZPosControl");
            p=null; started=timing?new Date().getTime():0;
            if(typeof n.getXRotControl === "function") { requested++; p=n.getXRotControl(); }
            if(timing) timing.controlResolutionMs+=Math.max(0,new Date().getTime()-started);
            capture(p,"getXRotControl");
            p=null; started=timing?new Date().getTime():0;
            if(typeof n.getYRotControl === "function") { requested++; p=n.getYRotControl(); }
            if(timing) timing.controlResolutionMs+=Math.max(0,new Date().getTime()-started);
            capture(p,"getYRotControl");
            p=null; started=timing?new Date().getTime():0;
            if(typeof n.getZRotControl === "function") { requested++; p=n.getZRotControl(); }
            if(timing) timing.controlResolutionMs+=Math.max(0,new Date().getTime()-started);
            capture(p,"getZRotControl");
            p=null; started=timing?new Date().getTime():0;
            if(typeof n.getScaleControl === "function") { requested++; p=n.getScaleControl(); }
            if(timing) timing.controlResolutionMs+=Math.max(0,new Date().getTime()-started);
            capture(p,"getScaleControl");
            p=null; started=timing?new Date().getTime():0;
            if(typeof n.getXScaleControl === "function") { requested++; p=n.getXScaleControl(); }
            if(timing) timing.controlResolutionMs+=Math.max(0,new Date().getTime()-started);
            capture(p,"getXScaleControl");
            p=null; started=timing?new Date().getTime():0;
            if(typeof n.getYScaleControl === "function") { requested++; p=n.getYScaleControl(); }
            if(timing) timing.controlResolutionMs+=Math.max(0,new Date().getTime()-started);
            capture(p,"getYScaleControl");
            p=null; started=timing?new Date().getTime():0;
            if(typeof n.getZScaleControl === "function") { requested++; p=n.getZScaleControl(); }
