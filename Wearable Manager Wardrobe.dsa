            if(!exact)throw problem("GEO_PROBE_UNSAFE_SELECTION",
                "DAZ exported a different set of material surfaces. No restoration attempted. Inspect "+path);
            if(!persistentRelative)log("INFO","GEO_PROBE_EXPORT_OPTIONS",typeof options.toJsonString==="function"?
                String(options.toJsonString()).slice(0,7000):"option serialization unavailable");
