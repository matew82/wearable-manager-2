    function validateSelectedStorageNodeID(selected, storageCandidates) {
        var id = value(selected, "NodeID");
        if (!id) throw problem("NODE_ID_MISSING", selected.getLabel());
        checkedID(id, "Wardrobe storage Node ID");
        var matches = findData("NodeID", id);
        if (matches.length === 1 && same(matches[0], selected)) return id;

        // The narrow exception below is not an identity repair. It permits
        // reading exactly one populated wardrobe group even when DAZ 4 has
        // copied the storage node and its ID into one or more empty groups.
        // It MUST NOT permit an ambiguous figure, garment, or recovery node.
        var chosenChildren = selected.getNodeChildren(false);
        if (storageCandidates.length < 2 || !chosenChildren || !chosenChildren.length)
            throw problem("DUPLICATE_NODE_ID", selected.getLabel() +
                ". A unique populated wardrobe storage could not be proved. No metadata changed.");

        var owner = value(selected, "OwnerFigureID"), library = value(selected, "LibraryID");
        var selectedMatches = 0, duplicates = 0, i, j, other, member, kids;
        var details = [];
        for (i = 0; i < matches.length; i++) {
            other = matches[i]; member = false;
            for (j = 0; j < storageCandidates.length; j++)
                if (same(other, storageCandidates[j])) { member = true; break; }
            kids = other.getNodeChildren(false);
            details.push(String(other.getLabel()) + " (children=" + (kids ? kids.length : "unknown") + ")");
            if (same(other, selected)) { selectedMatches++; continue; }
            if (!member || other.className() !== "DzGroupNode" || other.getNodeParent() ||
                    !kids || kids.length !== 0 || value(other, "Role") !== "WardrobeStorage" ||
                    value(other, "LibraryID") !== library || value(other, "OwnerFigureID") !== owner) {
                throw problem("DUPLICATE_NODE_ID", "The Node ID of " + selected.getLabel() +
                    " is also used by a nonempty, unrelated, or unverified scene node. Nothing changed.\n" +
                    details.join("\n"));
            }
            duplicates++;
        }
        if (selectedMatches !== 1 || duplicates < 1) {
            throw problem("DUPLICATE_NODE_ID", "Cannot uniquely identify " + selected.getLabel() +
                ". Nothing changed.\n" + details.join("\n"));
        }
        var note = "STORAGE_EMPTY_DUPLICATE_ID: " + selected.getLabel() +
            " has " + duplicates + " empty storage clone(s) with the same Node ID. " +
            "Using only the nonempty group; leaving all objects and metadata unchanged.";
        if (app.lastStorageIDAdvisory !== note) {
            app.lastStorageIDAdvisory = note;
            print(TITLE + " / " + note);
        }
        return id;
    }

    // Persistent recovery records refer to parents by UNIQUE NodeID. Merely
    // tolerating an empty clone while reading the storage is not sufficient:
    // durableRecord() later records the parent of an already stored garment,
    // and must never record a duplicated ID. Do not relax uniqueNodeID or
    // nodeByID. Offer a conservative, explicitly confirmed cleanup instead.
    function inspectEmptyStorageCopies(fig) {
        return withReadScope(function () {
            var owner = figureIdentity(fig, false), nodes = sceneNodes(), groups = [], i, n;
            if (!owner) return null;
            for (i = 0; i < nodes.length; i++) {
                n = nodes[i];
                if (value(n, "Role") === "WardrobeStorage" &&
                    value(n, "LibraryID") === app.db.libraryID &&
                    value(n, "OwnerFigureID") === owner) groups.push(n);
            }
            if (groups.length < 2) return null;
            var populated = [], empty = [], groupIDs = {}, details = [];
            for (i = 0; i < groups.length; i++) {
                n = groups[i];
                if (n.className() !== "DzGroupNode" || n.getNodeParent())
                    throw problem("STORAGE_STRUCTURE", "Storage is not a top-level DzGroupNode: " + n.getLabel());
                var kids = n.getNodeChildren(false);
                if (!kids) throw problem("STORAGE_STRUCTURE", "Cannot inspect storage children: " + n.getLabel());
                var id = value(n, "NodeID");
                if (!id) throw problem("NODE_ID_MISSING", "Storage " + n.getLabel());
                checkedID(id, "Storage Node ID");
                groupIDs[key(n)] = id;
                details.push(n.getLabel() + " [children=" + kids.length + ", NodeID=" + id + "]");
                if (kids.length) populated.push(n); else empty.push(n);
            }
            // Two populated or all-empty groups are inherently ambiguous.
            // The existing storage guard handles those situations unchanged.
            if (populated.length !== 1 || !empty.length) return null;
            var active = populated[0], activeID = value(active, "NodeID"), seenKeys = {}, changeIDs = {};
            for (i = 0; i < groups.length; i++) seenKeys[key(groups[i])] = true;
            // Every duplicated ID found on one of these groups must occur ONLY
            // among the precisely validated storage candidates. Any other
            // duplicate (garment/figure/foreign node) is a hard error.
            for (i = 0; i < groups.length; i++) {
                n = groups[i];
                var all = findData("NodeID", value(n, "NodeID"));
                for (var j = 0; j < all.length; j++)
                    if (!own(seenKeys, key(all[j])))
                        throw problem("DUPLICATE_NODE_ID", "Storage ID is also used outside this figure's storage groups: " + n.getLabel());
                if (all.length > 1) {
                    for (var x = 0; x < empty.length; x++)
                        if (value(empty[x], "NodeID") === value(n, "NodeID")) changeIDs[key(empty[x])] = true;
                }
            }
            return {activeKey:key(active), activeID:activeID, owner:owner,
                emptyKeys:empty.map(function(e){return key(e);}),
                newIDsFor:changeIDs, description:details.join("\n")};
        }, false);
    }
    function repairEmptyStorageCopiesForTransition(fig) {
        requireUnscoped("repairEmptyStorageCopiesForTransition");
        var scan = inspectEmptyStorageCopies(fig);
        if (!scan) return false;
        assertNoPending(fig);
        var prompt = "Wardrobe Sets found one populated wardrobe storage and " + scan.emptyKeys.length +
            " EMPTY duplicate storage group(s) for " + fig.getLabel() + ".\n\n" +
            "Stored clothes cannot be safely restored while their storage parent has a duplicated Node ID.\n\n" +
            "Repair will leave the populated group, its Node ID and all garments unchanged. " +
            "It will mark only the verified empty groups as inactive and give a fresh Node ID " +
            "to empty groups whose IDs are duplicated. No groups will be deleted or merged.\n\n" +
            scan.description + "\n\n" +
            "Repair storage metadata now and continue applying the outfit? " +
            "You should do this only on a saved COPY of your scene.";
        if (MessageBox.warning(prompt, TITLE + " - Empty Storage Repair", "&Repair && Continue", "&Cancel") !== 0)
            throw problem("STORAGE_REPAIR_DECLINED", "Duplicate empty storage groups were left unchanged.");
        frameGuard();
        var fresh = inspectEmptyStorageCopies(fig);
        if (!fresh || !same(live(fresh.activeKey), live(scan.activeKey)) ||
            fresh.activeID !== scan.activeID || fresh.owner !== scan.owner ||
            !closeNumbers(fresh.emptyKeys.slice(0).sort(), scan.emptyKeys.slice(0).sort()) ||
            !closeNumbers(fresh.newIDsFor, scan.newIDsFor))
            throw problem("STORAGE_REPAIR_CHANGED", "Storage groups changed during confirmation. Nothing was repaired.");
        var fixed = [];
        for (var i = 0; i < fresh.emptyKeys.length; i++) {
            var empty = live(fresh.emptyKeys[i]);
            if (!empty || empty.className() !== "DzGroupNode" || empty.getNodeParent() ||
                empty.getNodeChildren(false).length || value(empty, "Role") !== "WardrobeStorage" ||
                value(empty, "LibraryID") !== app.db.libraryID ||
                value(empty, "OwnerFigureID") !== fresh.owner)
                throw problem("STORAGE_REPAIR_CHANGED", "Empty storage changed during repair. Rollback required.");
            var oldID = value(empty, "NodeID"), fields = {
                Role:"WardrobeStorageInactiveEmpty", ReplacedStorageNodeID:fresh.activeID
            };
            if (own(fresh.newIDsFor, fresh.emptyKeys[i])) {
                var newID;
                do { newID = unique("node"); } while (findData("NodeID", newID).length);
                fields.NodeID = newID;
            }
            txData(empty, fields); // exact previous metadata recorded for rollback
            fixed.push({label:String(empty.getLabel()),oldID:oldID,newID:fields.NodeID || oldID});
        }
        // Inactive empty groups no longer participate in storage enumeration;
        // the active ID must be genuinely unique for Recovery parent lookup.
        var active = live(fresh.activeKey), only = findData("NodeID", fresh.activeID);
        if (!active || only.length !== 1 || !same(active, only[0]) ||
            !same(existingStorageGroup(fig), active))
            throw problem("STORAGE_REPAIR_VERIFY", "Working storage identity did not become unambiguous. Rolling back.");
        log("PASS", "EMPTY_STORAGE_REPAIR", "Retired " + fixed.length +
            " empty storage group(s), without deleting groups or changing garments/active storage. " + jsonText(fixed));
        ctx.diag.emptyStorageRepair = fixed;
        return true;
    }

    function existingStorageGroup(fig) {
        var owner = figureIdentity(fig, false), nodes = sceneNodes(), found = [];
        for (var i = 0; owner && i < nodes.length; i++) if (value(nodes[i], "LibraryID") === app.db.libraryID &&
            value(nodes[i], "Role") === "WardrobeStorage" && value(nodes[i], "OwnerFigureID") === owner) found.push(nodes[i]);
        if (!found.length) return null;
        // More than one tagged storage group may result from merging or duplicating
        // a DAZ scene. Never delete, reparent, retag, or merge them automatically.
        // A group with absolutely no direct children is not holding garments;
        // only if exactly ONE candidate contains children may we read/use it.
        // More complex duplicates remain a hard error with a useful diagnosis.
        var occupied = [], details = [];
        for (i = 0; found.length > 1 && i < found.length; i++) {
            var candidate = found[i];
            if (candidate.className() !== "DzGroupNode" || candidate.getNodeParent())
                throw problem("STORAGE_STRUCTURE", "Wardrobe storage must remain a top-level group: " + candidate.getLabel());
            var children = candidate.getNodeChildren(false);
            var count = children ? children.length : 0;
            var nodeID = value(candidate, "NodeID");
            details.push(String(candidate.getLabel()) + " (children=" + count + ", NodeID=" + (nodeID || "missing") + ")");
            if (count) occupied.push(candidate);
        }
        if (found.length > 1 && occupied.length !== 1)
            throw problem("AMBIGUOUS_STORAGE", "Found " + found.length + " Wardrobe Sets storages for " + fig.getLabel() +
                ". Content is present in " + occupied.length + ". Nothing was changed.\n" +
                details.join("\n") +
                "\nDo not delete or merge these groups until their contents are inspected in the Scene pane.");
        var g = occupied.length === 1 ? occupied[0] : found[0];
        if (g.className() !== "DzGroupNode" || g.getNodeParent())
            throw problem("STORAGE_STRUCTURE", "Wardrobe storage must remain a top-level group: " + g.getLabel());
        // Unlike a registered garment or a figure, an EMPTY orphaned storage
        // group is not referenced as a live garment instance. A DAZ 4 scene may
        // contain a copy of this group with its scene metadata duplicated.
        // Permit the ONLY nonempty storage while leaving every node and all
        // metadata untouched. Never weaken the general uniqueNodeID guard.
        validateSelectedStorageNodeID(g, found);
        if (found.length > 1) {
            var note = "Multiple Wardrobe Sets storages for " + fig.getLabel() +
                ": using the only nonempty group. " + (found.length - 1) +
                " empty group(s) left untouched.";
            // Display once per launch, not on every status/read pass.
            if (app.lastStorageAdvisory !== note) {
                app.lastStorageAdvisory = note;
                print(TITLE + " / STORAGE_DUPLICATE_EMPTY: " + note);
            }
        }
        var p = prop(g, "Visible");
        if (p && p.getBoolValue()) throw problem("STORAGE_VISIBLE", "The wardrobe storage group was made visible. Hide it before continuing.");
        return g;
    }
    function storageGroup(fig, create) {
        if (create) requireUnscoped("storageGroup/create");
        var existing = withReadScope(function () { return existingStorageGroup(fig); }, false);
        if (existing || !create) return existing;
        var owner = figureIdentity(fig, true);
        var node = new DzGroupNode(); node.setName(unique("storage")); node.setLabel("Wardrobe Sets - " + fig.getLabel());
        Scene.addNode(node); ctx.created[key(node)] = true;
        uniqueNodeID(node, true);
        updateData(node, {Schema: "1", Role: "WardrobeStorage", LibraryID: app.db.libraryID, OwnerFigureID: owner});
        node.setVisible(false); audit("CREATE_STORAGE", "", node, owner); return node;
    }
    function inspectInstance(it, root) {
        var token = profileBegin("instance_validation");
        try { return withReadScope(function () { return inspectInstanceImpl(it, root); }, false); }
        finally { profileEnd(token); }
    }
    function inspectInstanceImpl(it, root) {
        var o = dataObject(root);
        if (!o || o.Role !== "ItemRoot" || o.LibraryID !== app.db.libraryID || o.ItemID !== it.id || o.VariantID !== it.variantID || !o.InstanceID)
            throw problem("ITEM_IDENTITY", root.getLabel());
        checkedID(o.InstanceID, "Instance ID");
        var all = [root].concat(root.getNodeChildren(true)), parts = {}, allIDs = {}, partKeys = [], i;
        for (i = 0; i < all.length; i++) {
            var n = all[i], id = value(n, "NodeID");
            // Bones get durable IDs only when referenced by a recovery record.
            if (id) { uniqueNodeID(n, false); allIDs[id] = true; }
            if (n.inherits("DzBone")) continue;
            var d = dataObject(n);
            if (!d || d.LibraryID !== app.db.libraryID || d.ItemID !== it.id || d.VariantID !== it.variantID || d.InstanceID !== o.InstanceID || d.OwnerFigureID !== o.OwnerFigureID ||
                !d.PartID || own(parts, d.PartID)) throw problem("ITEM_HIERARCHY", "Foreign, duplicate or untagged child: " + n.getLabel());
            if (!id) throw problem("NODE_ID_MISSING", n.getLabel());
            parts[d.PartID] = n; partKeys.push(key(n));
        }
        if (Object.keys(parts).length !== it.parts.length) throw problem("INCOMPLETE_ITEM", it.name);
        for (i = 0; i < it.parts.length; i++) {
            var spec = it.parts[i], p = parts[spec.id];
            if (!p || p.className() !== spec.className || (spec.root && !same(p, root))) throw problem("PART_MISMATCH", it.name + " / " + spec.name);
            if ((value(p, "Role") === "ItemRoot") !== !!spec.root) throw problem("PART_ROLE", spec.name);
        }
        // Catch split hierarchies and copied instance IDs outside this subtree.
        var peers = findData("InstanceID", o.InstanceID);
        if (peers.length !== it.parts.length) throw problem("DUPLICATE_OR_SPLIT_INSTANCE", it.name);
        for (i = 0; i < peers.length; i++) if (!own(parts, value(peers[i], "PartID")) || !same(parts[value(peers[i], "PartID")], peers[i]))
            throw problem("DUPLICATE_INSTANCE", it.name);
        return {root: root, rootID: value(root, "NodeID"), instanceID: o.InstanceID, parts: parts, partKeys: partKeys,
            allKeys: all.map(function(n) { return key(n); }), where: "other", itemID: it.id};
    }
    // A new untagged physical child may have been parented to a previously
    // registered wearable. The catalog describes an IMMUTABLE composite and
    // must never adopt the new child without a new item definition. This
    // read-only classifier is intentionally separate from inspectInstance().
    function inspectCompositeAddition(fig, root, db) {
        var d=dataObject(root),owner=figureIdentity(fig,false);
        if(!owner||!d||d.Role!=="ItemRoot"||d.OwnerFigureID!==owner||
            d.LibraryID!==db.libraryID||!d.ItemID||!own(db.items,d.ItemID))return null;
        var it=db.items[d.ItemID];
        if(it.variantID!==d.VariantID||!d.InstanceID||it.figureType!==String(fig.objectName))
            throw problem("COMPOSITE_IDENTITY","Registered wearable identity has changed: "+root.getLabel());
        if(!same(humanAncestor(root),fig)&&!(!root.getNodeParent()&&same(follow(root),fig)))return null;
        var all=[root].concat(root.getNodeChildren(true)),parts={},extras=[],oldByID={},missing=[],i;
        for(i=0;i<it.parts.length;i++)oldByID[it.parts[i].id]=it.parts[i];
        for(i=0;i<all.length;i++){
            var n=all[i];if(n.inherits("DzBone"))continue;
            if(isFigure(n))throw problem("COMPOSITE_FIGURE","Another supported figure is nested under "+root.getLabel());
            var md=dataObject(n);
            if(md&&md.LibraryID===db.libraryID&&md.ItemID===it.id&&
                md.InstanceID===d.InstanceID&&md.VariantID===it.variantID&&md.OwnerFigureID===owner&&
                md.PartID&&own(oldByID,md.PartID)&&!own(parts,md.PartID)){
                if(n.className()!==oldByID[md.PartID].className||
                    (!!oldByID[md.PartID].root)!==(same(n,root)))
                    throw problem("COMPOSITE_PART_CHANGED","Registered part changed: "+n.getLabel());
                uniqueNodeID(n,false);parts[md.PartID]=n;
            }else if(n!==root&&!md&&
                    !n.findDataItem("matewWardrobeCoreProbe_v1")&&
                    !n.findDataItem("matewWardrobeSwitchProbe_v1")){
                extras.push(n);
            }else{
                throw problem("COMPOSITE_FOREIGN","Already registered, duplicated or foreign child: "+n.getLabel()+
                    ". Detach it first; another item cannot be absorbed into this variant.");
            }
        }
        for(i=0;i<it.parts.length;i++)if(!own(parts,it.parts[i].id))missing.push(it.parts[i]);
        // A removed part is safe to exclude ONLY if it no longer exists anywhere
        // in the scene. A reparented or duplicated part still has the old
        // InstanceID; accepting it would leave an orphaned registered object.
        var peers=findData("InstanceID",d.InstanceID);
        if(peers.length!==Object.keys(parts).length)
            throw problem("COMPOSITE_INSTANCE_SPLIT","An old wearable child still exists outside this hierarchy: "+it.name+
                ". Delete it from the test scene or restore it to the original item before retrying.");
        for(i=0;i<peers.length;i++)if(!own(parts,value(peers[i],"PartID"))||
            !same(parts[value(peers[i],"PartID")],peers[i]))
            throw problem("COMPOSITE_INSTANCE_DUPLICATE","A registered child is duplicated or reparented: "+it.name);
        // Validate native links of every surviving saved part. Native-link
        // targets that referred to removed parts must fail closed rather than
        // silently being replaced with a different node.
        if(!missing.length)nativeLinkCheck(it,{parts:parts},fig);
        else for(i=0;i<it.parts.length;i++){
            var spec=it.parts[i],present=parts[spec.id];if(!present)continue;
            var actual=nodeReferences(present);
            for(var r=0;r<REF_FIELDS.length;r++){
                var field=REF_FIELDS[r],matches;
                try{matches=portableLinkMatches(spec,field,actual[field],fig,parts,actual.follow);}
                catch(dependencyError){throw problem("COMPOSITE_MISSING_DEPENDENCY",
                    "A remaining part still references a removed wearable child: "+spec.name+" / "+field);}
                if(!matches)throw problem("COMPOSITE_LINK_CHANGED",
                    "A saved native link changed on "+spec.name+" / "+field+
                    ". Restore the original link before creating a variant.");
            }
        }
        if(!extras.length&&!missing.length)return null;
        // Changes may consist of additions, removals, or a replacement of a
        // previously saved child. Never overwrite a registered definition.
        if(value(root,"Pending"))throw problem("COMPOSITE_PENDING","The source item has an unfinished transaction.");
        if(value(root,"GeoWardrobeSnapshot"))throw problem("COMPOSITE_DEFERRED_MATERIALS",
            "Restore pending GeoShell materials before creating a composite variant.");
        // A changed hierarchy must remain DISCOVERABLE when old item overrides
        // are active. Strict inventory rejects that hierarchy, so trying to
        // switch another Set to reset the overrides would otherwise deadlock.
        // Report the active overrides; the explicit new-variant transaction
        // will preflight/reset only this old item after user confirmation.
        var activeOverrideCount=0,activeOverrideRows=[];
        if(value(fig,"PropertyState")){
            var state=readAppliedPropertyState(fig);
            for(i=0;i<state.entries.length;i++)if(state.entries[i].targetKind==="item"&&state.entries[i].itemID===it.id){
                activeOverrideCount++;activeOverrideRows.push(clonePlain(state.entries[i]));
            }
        }
        return {rootKey:key(root),itemID:it.id,instanceID:d.InstanceID,
            activeOverrideCount:activeOverrideCount,
            activeOverrideSnapshot:jsonText(activeOverrideRows),
            originalName:it.name,extraKeys:extras.map(function(n){return key(n);}),
            extraLabels:extras.map(function(n){return String(n.getLabel());}),
            missingPartIDs:missing.map(function(p){return p.id;}),
            missingLabels:missing.map(function(p){return p.name;}),
            originalParts:it.parts.length,partCount:it.parts.length-missing.length+extras.length};
    }
    function compositeAdditionOnFigure(fig){
        return withReadScope(function(){
            var nodes=sceneNodes(),owner=figureIdentity(fig,false);
            if(!owner)return null;
            for(var i=0;i<nodes.length;i++){
                var n=nodes[i],d=dataObject(n);
                if(d&&d.Role==="ItemRoot"&&d.LibraryID===app.db.libraryID&&d.OwnerFigureID===owner){
                    var info=inspectCompositeAddition(fig,n,app.db);
                    if(info)return info;
                }
            }
            return null;
        },false);
    }
    // Preflight an explicit reset of overrides for an item whose registered
    // child hierarchy has changed. Do NOT call inventory() here: the valid
    // structural guard is precisely what blocks ordinary Apply/Take Off All.
    // An absent old PartID is safe to discard only after the composite scan
    // proved it does not exist anywhere in the scene (no split instance).
    function compositeOverrideResetPlan(fig,root,scan){
        var state=readAppliedPropertyState(fig), old=app.db.items[scan.itemID], nodes=nonBones(root);
        var liveParts={}, registeredParts={}, missing={}, i;
        for(i=0;i<old.parts.length;i++)registeredParts[old.parts[i].id]=true;
        for(i=0;i<scan.missingPartIDs.length;i++)missing[scan.missingPartIDs[i]]=true;
        for(i=0;i<nodes.length;i++){
            var md=dataObject(nodes[i]);
            if(md&&md.ItemID===old.id&&md.InstanceID===scan.instanceID&&
                md.LibraryID===app.db.libraryID&&md.PartID&&registeredParts[md.PartID])
                liveParts[md.PartID]=nodes[i];
        }
        var plan={state:state,resets:[],discarded:[],retained:[],targetCount:0};
        for(i=0;i<state.entries.length;i++){
            var rec=state.entries[i];
            if(rec.targetKind!=="item"||rec.itemID!==old.id){plan.retained.push(clonePlain(rec));continue;}
            plan.targetCount++;
            var node=liveParts[rec.partID];
            if(!node){
                if(!missing[rec.partID])throw problem("COMPOSITE_OVERRIDE_PART",
                    "Cannot resolve the old override part; restore the original hierarchy before retrying.");
                plan.discarded.push(clonePlain(rec));continue;
            }
            // No native setters until EVERY present override is known to be
            // writable and its saved Reset value meets the current limits.
            var handle=propertyHandleForOverride(node,rec);
            checkPropertyOverrideValue(handle,rec,Number(rec.resetValue),"composite variant reset preflight");
            plan.resets.push({node:node,entry:clonePlain(rec)});
        }
        return plan;
    }
    function applyCompositeOverrideReset(fig,scan,plan){
        if(!plan.targetCount)return;
        var updated=0;
        for(var i=0;i<plan.resets.length;i++){
            var r=plan.resets[i];
            if(writePropertyOverride(r.node,r.entry,Number(r.entry.resetValue),"reset"))updated++;
        }
        // Preserve applied overrides of unrelated items and the figure.
        // No Set can still be marked active as a whole after the old item's
        // overrides have been removed from its live figure metadata.
        if(plan.retained.length)txData(fig,{PropertyState:jsonText({
            schemaVersion:1,setID:"",entries:clonePlain(plan.retained)})});
        else unsetData(fig,"PropertyState");
        if(updated){try{Scene.update();processEvents();}catch(ignoreCompositeUpdate){}}
        log("PASS","COMPOSITE_OVERRIDE_RESET", "oldItem="+scan.itemID+
            " | liveReset="+plan.resets.length+" | changed="+updated+
            " | deletedPartEntries="+plan.discarded.length+
            " | unrelatedOverridesPreserved="+plan.retained.length);
        if(plan.discarded.length)log("INFO","COMPOSITE_ABSENT_OVERRIDE",
            "Old PartID no longer exists in the scene; its obsolete applied override reference was cleared. No property was written to a replacement child.");
    }

    function createCompositeVariant(fig,payload){
        requireUnscoped("createCompositeVariant");
        frameGuard();assertNoPending(fig);
        var root=live(payload.rootKey);
        if(!root)throw problem("COMPOSITE_ROOT_MISSING","Reopen the editor; the registered root was removed.");
        var scan=withReadScope(function(){return inspectCompositeAddition(fig,root,app.db);},false);
        if(!scan||scan.itemID!==payload.itemID||scan.instanceID!==payload.instanceID||
            !closeNumbers(scan.extraKeys,payload.extraKeys)||
            !closeNumbers(scan.missingPartIDs,payload.missingPartIDs)||
            scan.activeOverrideCount!==payload.activeOverrideCount||
            scan.activeOverrideSnapshot!==payload.activeOverrideSnapshot)
            throw problem("COMPOSITE_CHANGED","The wearable or its active overrides changed during confirmation. Reopen the dialog; nothing was modified.");
        foreignDataGuard(root,true);
        var old=app.db.items[scan.itemID],all=nonBones(root),owner=figureIdentity(fig,false),parts={};
        if(all.length!==scan.partCount)
            throw problem("COMPOSITE_CHANGED","The candidate hierarchy changed. No changes made.");
        var pathSet={},i;
        for(i=0;i<all.length;i++){
            var p=all[i],name=String(p.getLabel());
            if(own(pathSet,"$"+name))throw problem("COMPOSITE_LABEL_DUPLICATE","Duplicate part label: "+name);
            pathSet["$"+name]=true;
        }
        var overridePlan=compositeOverrideResetPlan(fig,root,scan);
        if(overridePlan.targetCount && payload.resetOverrides!==true)
            throw problem("COMPOSITE_ACTIVE_OVERRIDE",
                "Confirm Reset Overrides & Create Variant. No existing property was changed.");
        // Snapshot the ORIGINAL (pre-reset) scene for failure rollback. A
        // second baseline after an authorized reset is used solely to prove
        // that variant capture itself changed no property or material.
        ctx.rollbackPose=poseRecord(fig);
        ctx.rollbackMeasurements=measured(all.map(function(n){return key(n);}),true);
        applyCompositeOverrideReset(fig,scan,overridePlan);
        var baseline=clonePlain(measured(all.map(function(n){return key(n);}),true)),
            next=clonePlain(app.db),itemID=unique("item"),variant=unique("variant"),instance=unique("instance");
        var displayName=old.name+(scan.extraLabels.length?" + "+scan.extraLabels.join(" + "):
            " (without "+scan.missingLabels.join(" + ")+")");
        if(displayName.length>160)displayName=displayName.slice(0,157)+"...";
        var record={id:itemID,variantID:variant,name:displayName,figureType:String(fig.objectName),
            parts:[],created:String(new Date()),preset:"Items/"+variant+".duf"};
        for(i=0;i<all.length;i++){
            var node=all[i],before=dataObject(node),nodeID=uniqueNodeID(node,true),partID=unique("part");
            if(!own(ctx.metaBefore,key(node)))ctx.metaBefore[key(node)]=before;
            var fields=clonePlain(dataObject(node)||{});
            delete fields.Recovery;delete fields.GeoWardrobeSnapshot;
            delete fields.Pending;delete fields.ExportDefinition;
            fields.Schema="1";fields.LibraryID=next.libraryID;fields.ItemID=itemID;
            fields.VariantID=variant;fields.PartID=partID;fields.InstanceID=instance;
            fields.OwnerFigureID=owner;fields.Role=i===0?"ItemRoot":"Part";
            putData(node,fields);parts[partID]=node;
            record.parts.push({id:partID,name:String(node.getLabel()),className:String(node.className()),
                root:i===0,refs:{},materials:materials(node)});
        }
        for(i=0;i<record.parts.length;i++){
            var spec=record.parts[i],refs=nodeReferences(parts[spec.id]);
            for(var j=0;j<REF_FIELDS.length;j++)spec.refs[REF_FIELDS[j]]=portableRef(refs[REF_FIELDS[j]],fig,parts);
        }
        var newInfo=inspectInstance(record,root);
        nativeLinkCheck(record,newInfo,fig,"COMPOSITE_LINKS");
        saveItemPreset(record,root,fig,parts);
        // Identity fields necessarily change; every other observed property,
        // native link and exposed material must remain exactly as before.
        var after=measured(all.map(function(n){return key(n);}),true),bs=clonePlain(baseline),ks=Object.keys(bs);
        for(i=0;i<ks.length;i++){delete bs[ks[i]].identity;delete after[ks[i]].identity;}
        var diffs=changeList(bs,after);
        must(!diffs.length,"COMPOSITE_STATE_UNCHANGED",diffs.length?diffs.length+
            " non-identity changes after variant capture. See diagnostics.":
            "Native references, transforms and comparable materials unchanged; only Wardrobe item identity updated.");
        next.items[itemID]=record;
        commitCatalog(next,app.catalogFile);ctx.catalogCommitted=true;
        ctx.outcome="New composite item created: "+record.name+
            ". Original item definition and all existing Sets were preserved."+
            (overridePlan.targetCount?" Old item's active Overrides were reset/cleared after explicit confirmation.":"")+
            " Reopen Set Editor and select the new item.";
        log("PASS","COMPOSITE_VARIANT_REGISTERED",record.name+" | original="+old.id+
            " | newItem="+itemID+" | parts="+record.parts.length+
            " | original Set membership untouched; new variant available in editor.");
    }

    function wardrobeCoverageRecord(fig, inv) {
        // Diagnostic ONLY: do not turn labels, asset names or visual similarity
        // into item identity. Reuse the editor's candidate boundary; no promise
        // that every candidate is clothing or every fitted object is included.
        var owner=figureIdentity(fig,false), ids=Object.keys(inv), managed={}, roots=[];
        for (var i=0;i<ids.length;i++) {
            var inf=inv[ids[i]];
            roots.push({itemID:ids[i],itemName:app.db.items[ids[i]].name,where:inf.where,
                instanceID:inf.instanceID,rootNodeID:inf.rootID,runtimeKey:key(inf.root)});
            for (var p=0;p<inf.partKeys.length;p++) managed["$"+inf.partKeys[p]]=ids[i];
        }
        var can=candidates(fig), excluded=[];
        for (var c=0;c<can.length;c++) {
            var n=can[c], k=key(n);
            if (own(managed,"$"+k)) continue;
            var md=dataObject(n), reason;
            if (!md) reason="NO_WARDROBE_METADATA";
            else if (!md.LibraryID || !md.ItemID) reason="NO_REGISTERED_ITEM_IDENTITY";
            else if (md.LibraryID!==app.db.libraryID) reason="ANOTHER_LIBRARY";
            else if (!owner || md.OwnerFigureID!==owner) reason="OWNER_ID_DOES_NOT_MATCH";
            else if (!own(app.db.items,md.ItemID)) reason="ITEM_NOT_IN_CATALOG";
            else reason="NOT_IN_VALIDATED_OWNER_INVENTORY";
            excluded.push({label:String(n.getLabel()),runtimeKey:k,reason:reason,
                hasReferenceManagerData:!!n.findDataItem("MatewWearables"),
                ownMetadataPresent:!!md,libraryID:md&&md.LibraryID||"",ownerFigureID:md&&md.OwnerFigureID||"",
                itemID:md&&md.ItemID||"",nodeID:md&&md.NodeID||"",instanceID:md&&md.InstanceID||"",
                parentKey:key(n.getNodeParent()),followKey:key(follow(n))});
        }
        return {policy:"editor_candidate_coverage_readonly_v043",figureLabel:String(fig.getLabel()),figureKey:key(fig),
            targetFigureID:owner,libraryID:app.db.libraryID,managed:roots,candidateCount:can.length,
            excludedCandidates:excluded,identityAdoption:false,sceneWrites:0,
            limitation:"Editor candidate roots only; bones/human figures/exempt nodes excluded. No visibility, geometry or full-clothing classification. Labels are display text, never matching keys."};
    }
    function logWardrobeCoverage(fig, inv, phase) {
        var t=profileBegin("wardrobe_coverage");
        try {
            var detail=withReadScope(function(){return wardrobeCoverageRecord(fig,inv);},false);
            detail.phase=phase;
            if (!ctx.diag.wardrobeCoverage) ctx.diag.wardrobeCoverage=[];
            ctx.diag.wardrobeCoverage.push(detail);
            var active=0, stored=0;
            for (var i=0;i<detail.managed.length;i++) {
                if(detail.managed[i].where==="active")active++;
                if(detail.managed[i].where==="stored")stored++;
            }
            log("INFO","WARDROBE_COVERAGE","phase="+phase+" | figure="+detail.figureLabel+
                " | figureID="+(detail.targetFigureID||"<unregistered>")+" | managedActive="+active+" | managedStored="+stored+
                " | attachedCandidates="+detail.candidateCount+" | unmanagedCandidates="+detail.excludedCandidates.length+
                " | unmanaged nodes are left unchanged; no adoption or name matching");
            for (var m=0;m<detail.managed.length && m<30;m++)
                log("INFO","MANAGED_ITEM",JSON.stringify(detail.managed[m]));
            for (var e=0;e<detail.excludedCandidates.length && e<30;e++)
                log("INFO","UNMANAGED_CANDIDATE",JSON.stringify(detail.excludedCandidates[e]));
            if(detail.managed.length>30 || detail.excludedCandidates.length>30)
                log("INFO","WARDROBE_COVERAGE_MORE","Full records are in diagnostics.json / wardrobeCoverage.");
            return detail;
        } finally {profileEnd(t);}
    }

    function inventory(fig, db) {
        var token = profileBegin("inventory");
        try {
            return withReadScope(function () {
                // UI open runs readOutfitSummary then card diagnostics. Both need
                // the same owner inventory; rebuild only after the scope ends or
                // invalidateReadScope() discards it.
                if (readScope && fig && db) {
                    var inventoryKey = key(fig) + "|" + String(db.libraryID || "") + "|" + String(db.commitID || "");
                    if (!readScope.inventory) readScope.inventory = {};
                    if (own(readScope.inventory, inventoryKey)) {
                        profileCount("inventoryCacheHits", 1);
                        return readScope.inventory[inventoryKey];
                    }
                    var built = inventoryImpl(fig, db);
                    readScope.inventory[inventoryKey] = built;
                    return built;
                }
                return inventoryImpl(fig, db);
            }, false);
        } finally { profileEnd(token); }
    }
    function inReferenceStorage(node, cache) {
        if (cache) {
            var cachedKey = key(node);
            if (own(cache, cachedKey)) return cache[cachedKey];
        }
        var seen={}, current=node, chain=[];
        while(current){
            var token=key(current);if(own(seen,token))throw problem("PARENT_CYCLE","Storage ancestry");seen[token]=true;
            if (cache && own(cache, token)) {
                var known=cache[token];
                for (var ci=0;ci<chain.length;ci++) cache[chain[ci]]=known;
                return known;
            }
            chain.push(token);
            if(current.inherits("DzGroupNode")){
                var data=current.findDataItem("MatewWearables"),settings=data?data.getSettings():null;
                if(settings&&settings.getStringValue("ID","")){
                    if (cache) for (var ti=0;ti<chain.length;ti++) cache[chain[ti]]=true;
                    return true;
                }
            }
            current=current.getNodeParent();
        }
        if (cache) for (var fi=0;fi<chain.length;fi++) cache[chain[fi]]=false;
        return false;
    }
    function inventoryImpl(fig, db) {
        var owner = figureIdentity(fig, false), nodes = sceneNodes(), group = storageGroup(fig, false), roots = {}, out = {}, i;
        var referenceCache = {};
        // Only selected owner's items; never take clothing from a different
        // person's wardrobe or the reference Wearables Manager's storage.
        for (i = 0; i < nodes.length; i++) {
            var n = nodes[i], d = dataObject(n);
            if (!d || d.LibraryID !== db.libraryID || !d.ItemID) continue;
            if(inReferenceStorage(n, referenceCache))continue;
            var onFigure = same(humanAncestor(n), fig) || (!n.getNodeParent() && same(follow(n), fig));
            if (d.Role === "ItemRoot" && onFigure && d.OwnerFigureID !== owner)
                throw problem("OWNER_MISMATCH", n.getLabel() + " was moved manually between figures. No ownership was guessed.");
            if (!owner || d.OwnerFigureID !== owner) continue;
            if (!own(db.items, d.ItemID)) throw problem("CATALOG_ITEM_MISSING", n.getLabel() + " belongs to an unavailable item record.");
            if (d.Role === "ItemRoot") {
                if (own(roots, d.ItemID)) throw problem("MULTIPLE_ELIGIBLE_INSTANCES", db.items[d.ItemID].name);
                roots[d.ItemID] = n;
            }
        }
        for (i = 0; i < nodes.length; i++) {
            var pd = dataObject(nodes[i]);
            if (pd && owner && pd.LibraryID === db.libraryID && pd.OwnerFigureID === owner && pd.ItemID && !own(roots, pd.ItemID) && !inReferenceStorage(nodes[i], referenceCache))
                throw problem("ORPHAN_PART", nodes[i].getLabel() + ". The item root is missing; delete/recover the entire test item, not only its root.");
        }
        var ids = Object.keys(roots);
        for (i = 0; i < ids.length; i++) {
            var it = db.items[ids[i]], root = roots[ids[i]], inf = inspectInstance(it, root), p = root.getNodeParent();
            foreignDataGuard(root, false);
            if (group && same(p, group)) inf.where = "stored";
            else if (same(humanAncestor(root), fig) || (!p && same(follow(root), fig))) inf.where = "active";
            else throw problem("FOREIGN_STORAGE_OR_OWNER", it.name + " is outside this figure and its wardrobe storage. Return it using the other manager first.");
            out[it.id] = inf;
        }
        return out;
    }

    function smallControls(n) {
        var token = profileBegin("node_controls");
        try { return smallControlsImpl(n); }
        finally { profileEnd(token); }
    }
    function smallControlsImpl(n) {
        // No simulation-presence detector, simulation property queries, cache
        // management, Freeze/clear/bake/re-simulate commands in this prototype.
        var names = ["Visible", "Renderable", "Visible in Viewport", "Enable Smoothing", "Interactive Update"], out = {};
        for (var i = 0; i < names.length; i++) {
            var p = prop(n, names[i]); if (!p) continue;
            var v = p.getValue();
            if (typeof v === "string" || typeof v === "number" || typeof v === "boolean") out[names[i]] = v;
        }
        return out;
    }
    function measured(keys, includeMaterials) {
        var token = profileBegin("measurement");
        try { return withReadScope(function () { return measuredImpl(keys, includeMaterials); }, false); }
        finally { profileEnd(token); }
    }
    function measuredImpl(keys, includeMaterials) {
        profileCount("measuredNodes", keys.length);
        var map = sceneIndex(), out = {};
        for (var i = 0; i < keys.length; i++) {
            var n = map[keys[i]];
            if (!n) throw problem("MEASURE_NODE_MISSING", keys[i]);
            var refs = nodeReferences(n), refKeys = {}, d = dataObject(n) || {};
            for (var r = 0; r < REF_FIELDS.length; r++) refKeys[REF_FIELDS[r]] = key(refs[REF_FIELDS[r]]);
            out[keys[i]] = {name: String(n.name), label: String(n.getLabel()), refs: refKeys, controls: smallControls(n),
                identity: {nodeID: d.NodeID || "", itemID: d.ItemID || "", variantID: d.VariantID || "", partID: d.PartID || "", instanceID: d.InstanceID || ""},
                channels: storageChannels(n), world: storageWorld(n)};
            if (includeMaterials && !n.inherits("DzBone")) {
                var mats = materials(n); out[keys[i]].materials = mats.surfaces;
                if (mats.skipped) warnOnce("MATERIAL_COVERAGE", "Some non-scalar or unreadable material properties cannot be compared.");
            }
        }
        return out;
    }
    function changeList(before, after, path, out) {
        var token = profileBegin("snapshot_diff");
        try {
            if (!optimizedReads()) return changeListReference(before, after, path, out);
            return changeListLinear(before, after, path || "", out || []);
        } finally { profileEnd(token); }
    }
    function changeListLinear(before, after, path, out) {
        // Plain value snapshots only; same numeric comparator, same diff order.
        // Avoid sorting keys and recursively comparing a whole subtree AGAIN
        // before descending into that same subtree to describe a difference.
        if (typeof before === "number" && typeof after === "number") {
            if (closeNumbers(before, after)) return out;
        } else if (before === after) return out;
        if (before && after && typeof before === "object" && typeof after === "object") {
            var names = Object.keys(before), extra = Object.keys(after), seen = {};
            for (var i = 0; i < names.length; i++) {
                seen[names[i]] = true;
                changeListLinear(before[names[i]], after[names[i]], path + "/" + names[i], out);
            }
            for (var j = 0; j < extra.length; j++) if (!own(seen, extra[j]))
                out.push({field:path + "/" + extra[j],expected:"<absent>",actual:after[extra[j]]});
        } else out.push({field:path,expected:typeof before === "undefined" ? "<absent>" : before,
            actual:typeof after === "undefined" ? "<absent>" : after});
        return out;
    }
    function changeListReference(before, after, path, out) {
        path = path || ""; out = out || [];
        if (closeNumbers(before, after)) return out;
        if (before && after && typeof before === "object" && typeof after === "object") {
            var keys = Object.keys(before), extra = Object.keys(after), seen = {};
            for (var i = 0; i < keys.length; i++) { seen[keys[i]] = true; changeListReference(before[keys[i]], after[keys[i]], path + "/" + keys[i], out); }
            for (var j = 0; j < extra.length; j++) if (!own(seen, extra[j])) out.push({field: path + "/" + extra[j], expected: "<absent>", actual: after[extra[j]]});
        } else out.push({field: path, expected: typeof before === "undefined" ? "<absent>" : before, actual: typeof after === "undefined" ? "<absent>" : after});
        return out;
    }
    function compareMeasured(before, keys, code, mode) {
        var after = measured(keys, true), b = clonePlain(before), a = clonePlain(after), ks = Object.keys(b);
        if (mode === "restore") {
            // Across wardrobe uses the pose may legitimately differ. Observe
            // world/evaluated values for settling, NEVER restore old coordinates.
            // Check raw controls and materials captured immediately before this
            // restore, along with resolved persistent references separately.
            for (var i = 0; i < ks.length; i++) {
                if (!a[ks[i]]) continue;
                delete b[ks[i]].world; delete a[ks[i]].world;
                delete b[ks[i]].refs; delete a[ks[i]].refs;
                for (var j = 0; j < b[ks[i]].channels.length; j++) { delete b[ks[i]].channels[j].value; delete b[ks[i]].channels[j].controllers; delete b[ks[i]].channels[j].locked; }
                for (var q = 0; q < a[ks[i]].channels.length; q++) { delete a[ks[i]].channels[q].value; delete a[ks[i]].channels[q].controllers; delete a[ks[i]].channels[q].locked; }
            }
        }
        if(ctx&&ctx.geoMaterialTxn){
            for(var ex=0;ex<ks.length;ex++)if(ctx.geoMaterialTxn.allowed[ks[ex]]&&b[ks[ex]]&&a[ks[ex]]){
                delete b[ks[ex]].materials;delete a[ks[ex]].materials;
            }
        }
        var diffs = changeList(b, a);
        ctx.diag.comparisons.push({name: code, mode: mode || "fixed", differences: diffs, before: b, after: a});
        for (var n = 0; n < diffs.length && n < 12; n++) log("INFO", "DIFF_" + code, JSON.stringify(diffs[n]));
        must(!diffs.length, code, diffs.length ? diffs.length + " measured differences; see diagnostics. No compensating transform/material writes." :
            (mode === "restore" ? "Current pre-restore raw values, identity, settings and exposed materials preserved; old pose/world coordinates were not imposed." : "Fixed current-operation snapshot matches: identities, references, measured raw/evaluated/world values and exposed materials."));
    }
    function observationBudget(initialMs, slowestSampleMs, policy) {
        // Estimate enough room for the required samples plus two extra samples.
        // The deadline is always relative to the ORIGINAL start, never a
        // repeatedly renewed timeout. Native calls cannot be interrupted here.
        return Math.min(policy.hardMaximumMs, Math.max(policy.maximumMs,
            Math.ceil(initialMs + slowestSampleMs *
                (policy.minimumSamples + policy.sampleBudgetMargin) + policy.quietMs)));
    }
    function observationBuildState(keys) {
        var token = profileBegin("build_state");
        try { return withReadScope(function () { return observationBuildStateImpl(keys); }, false); }
        finally { profileEnd(token); }
    }
    function observationBuildStateImpl(keys) {
        var map = sceneIndex(), busy = [], errors = [], unsupported = 0;
        for (var k = 0; k < keys.length; k++) {
            var n = map[keys[k]];
            if (!n) { errors.push(keys[k] + ": node missing"); continue; }
            try {
                var obj = n.getObject();
                if (!obj) continue;
                if (typeof obj.isBuildingGeom === "function") {
                    if (obj.isBuildingGeom()) busy.push(keys[k]);
                } else unsupported++;
            } catch (e) { errors.push(keys[k] + ": " + errorText(e)); }
        }
        return {busy:busy, errors:errors, unsupported:unsupported};
    }
    function observe(keys, code, integrity, extraCapture) {
        requireUnscoped("observe");
        frameGuard();
        var policy = observationPolicyFor(code, extraCapture);
        if (typeof sleep !== "function" || typeof Scene.update !== "function") throw problem("OBSERVATION_API", "Requires sleep(milliseconds) and Scene.update().");
        if (!keys || !keys.length) throw problem("OBSERVATION_EMPTY", "No nodes to observe.");
        function takeObservationSnapshot() {
            var sample = measured(keys, false);
            if (extraCapture) sample.$additionalObservedState = extraCapture();
            return sample;
        }
        log("INFO", "OBSERVATION_POLICY_" + code, "id=" + policy.id +
            " | pollMs=" + policy.pollMs + " | quietMs=" + policy.quietMs +
            " | minimumSamples=" + policy.minimumSamples + " | maximumMs=" + policy.maximumMs +
            " | hardMaximumMs=" + policy.hardMaximumMs + " | maximumSamples=" + policy.maximumSamples +
            " | sampleBudgetMargin=" + policy.sampleBudgetMargin + " | numeric comparator unchanged");
        var start = new Date().getTime(), initial = takeObservationSnapshot();
        var initialMs = new Date().getTime() - start, quiet = new Date().getTime();
        var count = 0, anchor = initial, previous = initial, last = initial, stable = false;
        var trace = [], bad = [], badSeen = {}, maxSampleMs = 0;
        var budget = observationBudget(initialMs, 0, policy), reason = "sample_limit";
        var build = {busy:[], errors:[], unsupported:0}, maxUnsupported = 0, totalChanges = 0;
        var entry = {name:code, stable:false, policy:clonePlain(policy), watchedNodes:keys.length,
            verificationProfile:verificationPolicy().effective,
            focusedApplyWindow:operationalVerification() && ordinaryApplyWindow(code),
            initialMeasurementMs:initialMs, trace:trace};
        log("INFO", "OBSERVATION_SCOPE_" + code,
            "profile=" + entry.verificationProfile + " | nodes=" + keys.length +
            (entry.focusedApplyWindow ? (code==="REGISTERED_ITEM_PRE" ?
                " | figure root + selected registered item parts; whole-figure pose audit disabled" :
                " | figure root + all registered non-bone parts; whole-figure pose audit disabled (including boundaries); root/item checks retained") :
                " | existing caller-defined node set; full reader-audit policy"));
        ctx.diag.observations.push(entry);
        frameGuard();
        for (var i = 0; i < policy.maximumSamples; i++) {
            var stepStart = new Date().getTime();
            if (stepStart - start >= policy.hardMaximumMs) { reason = "hard_deadline"; break; }
            if (stepStart - start >= budget) { reason = "time_budget"; break; }
            var t = stepStart;
            sleep(policy.pollMs); processEvents();
            var waitMs = new Date().getTime() - t; t = new Date().getTime();
            Scene.update(); processEvents(); frameGuard();
            var updateMs = new Date().getTime() - t; t = new Date().getTime();
            last = takeObservationSnapshot();
            var measureMs = new Date().getTime() - t; t = new Date().getTime();
            build = observationBuildState(keys); maxUnsupported = Math.max(maxUnsupported, build.unsupported);
            var buildMs = new Date().getTime() - t; t = new Date().getTime();
            var differences = changeList(anchor, last), adjacent = changeList(previous, last);
            totalChanges += adjacent.length;
            // A temporary raw/reference/identity change must not disappear from
            // baseline-integrity evidence just because it later returns to zero.
            if (integrity) {
                var fromInitial = changeList(initial, last);
                for (var d = 0; d < fromInitial.length; d++) {
                    var diff = fromInitial[d];
                    if (!/\/world\//.test(diff.field) && !/\/channels\/\d+\/value$/.test(diff.field)) {
                        var signature = jsonText(diff);
                        if (!own(badSeen, signature)) { badSeen[signature] = true; bad.push(diff); }
                    }
                }
            }
            frameGuard();
            var now = new Date().getTime(), compareMs = now - t;
            if (differences.length || build.busy.length || build.errors.length) {
                anchor = last; quiet = now; count = 0;
            } else count++;
            previous = last;
            maxSampleMs = Math.max(maxSampleMs, now - stepStart);
            var oldBudget = budget;
            budget = Math.max(budget, observationBudget(initialMs, maxSampleMs, policy));
            trace.push({sample:i+1, elapsedMs:now-start, sampleMs:now-stepStart,
                waitMs:waitMs, updateMs:updateMs, measurementMs:measureMs, buildQueryMs:buildMs,
                comparisonMs:compareMs, changes:differences.length, changesFromPrevious:adjacent.length,
                quietSamples:count, quietMs:now-quiet, budgetMs:budget,
                busy:build.busy, buildErrors:build.errors, unsupported:build.unsupported});
            if (budget > oldBudget) log("INFO", "OBSERVE_BUDGET_" + code,
                "budgetMs=" + budget + "; slowestSampleMs=" + maxSampleMs +
                "; requiredQuietSamples=" + policy.minimumSamples + "; requiredQuietMs=" + policy.quietMs +
                ". Policy=" + policy.id + "; bounded allowance for slow native calls.");
            // Check the absolute bound before success. A native call can return
            // after the bound; that is a timeout, not an automatic PASS.
