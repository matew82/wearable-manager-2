                result.push({method:v.method,propertyName:String(p.name),value:v.value,
                    rawAvailable:rawOK,raw:rawOK?Number(raw.value):null,
                    rawIssue:rawOK?"":(raw.reason||"Raw value is not a finite number"),
                    controllers:controllers.ok?Number(controllers.value):null,
                    locked:locked.ok?Boolean(locked.value):null});
