    function recordBulkIssue(n, phase, e) {
        if (!ctx) return;
        if (!ctx.bulkIssueCounts) ctx.bulkIssueCounts = {};
        var code = e && e.code ? String(e.code) : "BULK_NATIVE_EXCEPTION";
        ctx.bulkIssueCounts[code] = (ctx.bulkIssueCounts[code] || 0) + 1;
        if (!ctx.diag.channelBindingIssues) ctx.diag.channelBindingIssues = [];
        if (ctx.diag.channelBindingIssues.length < 24) {
            var issue = {phase:phase,code:code,nodeKey:"",label:"",message:String(e),differences:e.differences||[]};
            try { issue.nodeKey=key(n); issue.label=String(n.getLabel()); } catch(ignore) {}
            ctx.diag.channelBindingIssues.push(issue);
