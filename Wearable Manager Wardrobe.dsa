                if(shownCommit!==app.db.commitID){action={type:"refresh",figureKey:key(fig)};dlg.close();return;}
                readSceneStatus();
            }catch(e){status.text="Stopped - "+userErrorText(e);MessageBox.critical(userErrorText(e),TITLE,"&OK");}
            finally{busy=false;box.enabled=true;renderCards();}
        }
        function restoreCardHandPoses(st) {
            var fig=currentFigure();if(!fig||busy||action)return;
            busy=true;box.enabled=false;status.text="Restoring hand poses for "+st.name+"...";
            try{
