    // binding descriptions while THIS script invocation stays open. These are
    // not wardrobe metadata or property/value handles. Full stays action-local.
    function channelReuseRequested() {
        return operationalVerification() && bulkChannelsEnabled() && ctx.reuseChannelBindings !== false;
    }
    function channelSessionContext() {
        return JSON.stringify([app.libraryPath, app.db.libraryID, app.db.commitID || app.catalogFile,
            key(ctx.target), String(App.versionString)]);
    }
    function channelSessionSceneChanged() {
        channelSession.dirty = true; channelSession.sceneEvents++;
        var maps = [channelSession.registry, channelSession.active];
        for (var m = 0; m < maps.length; m++) {
            if (!maps[m] || (m && maps[m] === maps[0])) continue;
            var ids = Object.keys(maps[m]);
            for (var i = 0; i < ids.length; i++) {
                var rec = maps[m][ids[i]];
                if (rec.alive) { rec.serial++; rec.bindings = null; }
            }
        }
        // Do not disconnect or enumerate a possibly mutating scene in a signal.
    }
    function connectChannelSessionGuards() {
        if (channelSession.guardsAttempted) return channelSession.guardsReady;
        channelSession.guardsAttempted = true;
        var signals = ["nodeListChanged()", "sceneCleared()"];
        try {
            if (typeof connect !== "function" || typeof disconnect !== "function") throw new Error("Signal API unavailable");
            for (var i = 0; i < signals.length; i++) {
                if (typeof Scene[signals[i].slice(0,-2)] !== "function") throw new Error("Missing signal: " + signals[i]);
                var result = connect(Scene, signals[i], channelSessionSceneChanged);
                if (result === false) throw new Error("Signal connection rejected: " + signals[i]);
                channelSession.connected.push(signals[i]);
            }
