        var mats = shape.getAllMaterials(), out = [], omitted = 0;
        for (var i = 0; i < mats.length; i++) {
            var p = scalarProperties(mats[i]), uv = mats[i].getUVSetControl();
            omitted += p.skipped;
            out.push({name: String(mats[i].name), uv: uv ? String(uv.getStringValue()) : "", values: p.values});
        }
        out.sort(function (a, b) { return a.name < b.name ? -1 : a.name > b.name ? 1 : 0; });
        return {surfaces: out, skipped: omitted};
    }

    function storageWorld(n) {
        var token = profileBegin("world_matrix");
        try { return storageWorldImpl(n); }
        finally { profileEnd(token); }
    }
    function storageWorldImpl(n) {
        // A composed world matrix avoids interpreting individual Euler angles
        // as a measurement of physical angular displacement. Read only.
        var names = ["m11", "m21", "m31", "m12", "m22", "m32",
            "m13", "m23", "m33", "m14", "m24", "m34"], out = {};
        if (typeof n.getWSTransform !== "function") return {available: false, reason: "getWSTransform unavailable"};
        try {
            var mat = n.getWSTransform();
