        if (st.scope.kind === "label" && figureIconBaseLabel(fig.getLabel()) !== figureIconBaseLabel(st.scope.label)) return "Requires figure Label: " + st.scope.label;
        if (st.scope.kind === "figure" && figureIdentity(fig, false) !== st.scope.figureID) return "Restricted to its original tagged figure";
        return "";
