        var target=convertedFigureHandBone(fig,ref.path);
        if(!target)return; // Normal validation reports unresolved/ambiguous references.
        var root=inf.root,parent=root.getNodeParent();
        if(same(parent,target))return;
        if(spec.refs.follow.kind!=="none" || (parent&&!same(parent,fig)&&!same(boneOwner(parent),fig)))
