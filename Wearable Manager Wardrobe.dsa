        for(var i=0;i<DEFAULT_FIGURE_PROFILES.length;i++) {
            var d=DEFAULT_FIGURE_PROFILES[i];
            out.push({type:d.type,name:d.name,resource:d.resource,iconPath:"",enabled:d.enabled!==false});
        }
        return out;
    }
    function validateFigureProfiles(list) {
        if(!Array.isArray(list) || !list.length) throw problem("FIGURE_PROFILE_SCHEMA","Supported figure list is empty or invalid.");
        var out=[],seen={};
        for(var i=0;i<list.length;i++) {
            var p=list[i];
            if(!p || typeof p!=="object" || Array.isArray(p)) throw problem("FIGURE_PROFILE_SCHEMA","Invalid supported figure row.");
            var type=String(p.type||""),name=trim(String(p.name||"")),resource=String(p.resource||""),iconPath=String(p.iconPath||"");
            if(!catalogFigureTypeAllowed(type) || own(seen,type)) throw problem("FIGURE_PROFILE_SCHEMA","Unsupported or repeated figure type: "+type);
            if(!name || !resource) throw problem("FIGURE_PROFILE_SCHEMA","Figure name/icon is missing for "+type);
            if(typeof p.enabled!=="boolean") throw problem("FIGURE_PROFILE_SCHEMA","Enabled flag must be boolean for "+type);
            seen[type]=true;out.push({type:type,name:name,resource:resource,iconPath:iconPath,enabled:p.enabled});
        }
        return out;
    }
    function defaultFigureProfileForType(type) {
        for(var i=0;i<DEFAULT_FIGURE_PROFILES.length;i++) if(DEFAULT_FIGURE_PROFILES[i].type===type) return DEFAULT_FIGURE_PROFILES[i];
        return null;
    }
    function figureProfileForType(type,includeDisabled) {
        var list=DEFAULT_FIGURE_PROFILES;
        for(var i=0;i<list.length;i++)if(list[i].type===type)
            return {type:type,name:list[i].name,resource:list[i].resource,iconPath:"",enabled:true};
        // WM2 may support additional figure types (e.g. Horse 2). A neutral
        // label/empty picture is preferable to showing an unrelated Genesis icon.
        if(wm2Figures.available)return {type:type,name:type,resource:"",iconPath:"",enabled:true};
        return null;
    }
    // v0.4 user preferences remain local; no catalog/scene schema changes.
    function validateFigureIconBindings(value) {
        var out={specific:{},label:{}};
        if(value===undefined||value===null)return out;
        if(typeof value!=="object"||Array.isArray(value))throw problem("FIGURE_ICON_BINDINGS_SCHEMA","Invalid figure icon bindings.");
        var kinds=["specific","label"];
        for(var i=0;i<kinds.length;i++){
            var kind=kinds[i],src=own(value,kind)?value[kind]:{};
            if(!src||typeof src!=="object"||Array.isArray(src))throw problem("FIGURE_ICON_BINDINGS_SCHEMA",kind);
            var keys=Object.keys(src);
            for(var j=0;j<keys.length;j++){
                var k=keys[j],v=src[k];
                if(typeof v!=="string")throw problem("FIGURE_ICON_BINDINGS_SCHEMA",kind+" / "+k);
                out[kind][k]=v;
            }
        }
        return out;
    }
    function uiSettingsSnapshot() {
        return {schemaVersion:3,verificationMode:app.verificationMode,optimizeReads:app.optimizeReads,
            bulkChannels:app.bulkChannels,reuseChannelBindings:app.reuseChannelBindings,
            blockViewportRedraw:app.blockViewportRedraw,experimentalGeoShellRecovery:app.experimentalGeoShellRecovery,debugMode:app.debugMode,showSuccessReports:app.showSuccessReports,
            onlyCompatible:true,
            figureIconBindings:clonePlain(app.figureIconBindings||{specific:{},label:{}})};
    }
    function applyUISettings(ui) {
        if (!ui) { app.figureProfiles=defaultFigureProfiles();app.figureIconBindings={specific:{},label:{}};app.onlyCompatible=true;return; }
        if (ui.schemaVersion !== 1 && ui.schemaVersion !== 2 && ui.schemaVersion !== 3) throw problem("UI_SETTINGS_SCHEMA", "Unsupported local UI settings version.");
        var next = uiSettingsSnapshot(), names = ["optimizeReads","bulkChannels","reuseChannelBindings",
            "blockViewportRedraw","experimentalGeoShellRecovery","debugMode","showSuccessReports"];
        if (ui.verificationMode !== "full" && ui.verificationMode !== "operational")
            throw problem("UI_SETTINGS_MODE", "Unknown saved verification mode.");
        next.verificationMode=ui.verificationMode;
        for (var i=0;i<names.length;i++) {
            var name=names[i];
            if (own(ui,name)) {
                if (typeof ui[name] !== "boolean") throw problem("UI_SETTINGS_TYPE",name);
                next[name]=ui[name];
            }
        }
        // Older UI revisions may contain figureProfiles; intentionally ignore
        // them. WM2 owns supported figure settings from v0.8.1 onward.
        next.figureIconBindings=ui.schemaVersion>=3 && own(ui,"figureIconBindings") ?
            validateFigureIconBindings(clonePlain(ui.figureIconBindings)) : {specific:{},label:{}};
        app.verificationMode=next.verificationMode;
        for (var j=0;j<names.length;j++) app[names[j]]=next[names[j]];
        app.figureProfiles=defaultFigureProfiles();
        app.figureIconBindings=next.figureIconBindings;
        app.onlyCompatible=true;
    }
    function persistUISettings() {
        if (!app.libraryPath) return;
        savePreferences(app.libraryPath);
    }
    function reportCounts(results) {
        var c={warnings:0,failures:0,warningMessages:[]};
        for(var i=0;i<results.length;i++) {
            if(results[i].status==="WARN") { c.warnings++;c.warningMessages.push(results[i].code+": "+results[i].message); }
            if(results[i].status==="FAIL") c.failures++;
        }
        return c;
    }
    function shortActionStatus(report) {
        if(!report) return "Ready. Choose a figure and an outfit.";
        var s;
        if(report.blocked === "GEO_SHELL_SAFETY") {
            s = "Blocked: GeoGraft/GeoShell safety protection";
        } else if(report.action === "undress_all") {
            s = !report.ok ? "Stopped: take off all registered items" :
                (report.fastNoop || report.undressedCount === 0 ? "No registered items worn" :
                 "Taken off: " + report.undressedCount + " registered item(s)");
        } else if(report.action === "bulk_move") {
            s = report.ok ? "Moved selected registered items" : "Stopped: Move Selected";
        } else if(report.action === "remove_set") {
            s = report.ok ? "Taken off Set: " + (report.setName||"") : "Stopped: Take Off Set";
        } else if(report.action === "store_registered") {
            s = report.ok ? "Moved registered item to wardrobe" : "Stopped: store registered item";
        } else if(report.action === "return_registered") {
            s = report.ok ? "Returned registered item" : "Stopped: return registered item";
        } else if(report.action === "unregister_registered") {
            s = report.ok ? "Returned and unregistered item" : "Stopped: unregister item";
        } else {
            s=report.ok ? (report.fastNoop ? "Already applied: " : "Completed: ") : "Stopped: ";
            s += report.setName || report.action || "operation";
        }
        if(report.figureLabel) s+=" / "+report.figureLabel;
        if(typeof report.elapsedMs==="number") s+=" | "+(report.elapsedMs/1000).toFixed(3)+" s (action)";
        if(report.warningCount) s+=" | "+report.warningCount+" warning(s) - Last Report";
        if(report.failureCount) s+=" | "+report.failureCount+" error(s) - Last Report";
        return s;
    }
    function shouldShowActionReport(report) {
        return !!report && (report.action==="inspect" || !report.ok || report.failureCount>0);
    }
    function actionFailureSummary(report) {
        if(!report)return "Wardrobe Sets operation failed.";
        var message=shortActionStatus(report);
        if(report.outcome)message+="\n\n"+report.outcome;
        message+="\n\nOpen Settings > Last Report for the complete diagnostic log.";
        return message;
    }
    function presentActionReport(report) {
        if(!report)return null;
        if(report.blocked==="GEO_SHELL_SAFETY") {
            var choice=MessageBox.information(
                "This outfit change was blocked to protect GeoShell materials.\n\n"+
                "Moving a GeoGraft while GeoShells are present can change their materials. No wardrobe items or scene materials were changed.\n\n"+
                "Enable 'GeoShell Material Recovery' in Settings to protect the shells during this change.\n\n"+
                "Save a separate scene copy before moving GeoGrafts; some shader values cannot be fully checked.\n\nOpen Settings now?",
                TITLE+" - GeoShell Protection","&Open Settings","&Not Now");
            return choice===0?"settings":null;
        }
        if(report.action==="inspect"){showReport(report);return null;}
        if(!report.ok || report.failureCount>0)MessageBox.critical(actionFailureSummary(report),TITLE,"&OK");
        else if(report.unavailableProperties&&report.unavailableProperties.length){
            var list=[],seen={};
            for(var i=0;i<report.unavailableProperties.length;i++){
                var r=report.unavailableProperties[i],tag=r.target+"|"+r.propertyName;
                if(own(seen,tag))continue;
                seen[tag]=true;
                list.push("- "+r.target+" / "+r.name+" ("+r.propertyName+")");
            }
            MessageBox.warning("Outfit operation completed, but "+list.length+
                " saved Property Override(s) could not be resolved and were skipped:\n\n"+
                list.slice(0,12).join("\n")+(list.length>12?"\n... and "+(list.length-12)+" more.":"")+
                "\n\nThe items are still worn. Open Edit Outfit Set > Properties to review or remove missing overrides. See Last Report for details.",
                TITLE+" - Missing Properties","&OK");
        }
    }
    function viewportLockSupported() {
        return typeof beginViewportRedrawLock==="function" && typeof dropViewportRedrawLock==="function";
    }
    function viewportDiagnostic() {
        if(!ctx) return null;
        if(!ctx.diag.viewportRedraw) ctx.diag.viewportRedraw={requested:ctx.blockViewportRedraw===true,
            available:viewportLockSupported(),api:"beginViewportRedrawLock/dropViewportRedrawLock",
            scope:"store_restore_batch_only",blocks:[],acquired:0,released:0,
            note:"No lock during preflight, imports/material rechecks, settling, or result validation. Scene evaluation/events are not disabled. Pixel redraw suppression/speed require native testing."};
        return ctx.diag.viewportRedraw;
    }
    function releaseWardrobeViewportLocks(reason) {
        // Balanced release of ONLY this module's acquisitions. Never clear all
        // global locks or change QWidget state owned by another script.
        while(viewportLocksOwned>0) {
            dropViewportRedrawLock();
            viewportLocksOwned--;
            var vd=viewportDiagnostic(); if(vd) { vd.released++;vd.finalOwnedDepth=viewportLocksOwned; }
        }
        if(ctx) log("INFO","VIEWPORT_RELEASE",reason+" | ownedLocks="+viewportLocksOwned);
    }
    function withViewportRedrawLock(code,fn) {
        requireUnscoped("withViewportRedrawLock");
        if(!wardrobeChangeAction() || ctx.blockViewportRedraw!==true) return fn();
        var vd=viewportDiagnostic();
        if(!viewportLockSupported()) {
            warnOnce("VIEWPORT_LOCK_UNAVAILABLE","Requested redraw lock is not exposed by this DAZ build. Continuing with normal redraw; no guessed fallback.");
            return fn();
        }
        if(viewportLocksOwned) throw problem("VIEWPORT_LOCK_NESTING","Unexpected nested wardrobe lock.");
        var row={name:code,acquired:false,released:false,startedMs:new Date().getTime()}, originalError=null, result;
        vd.blocks.push(row);
        // The global DAZ API also releases this script's locks on script exit.
        try { beginViewportRedrawLock(); }
        catch(acquireError) {
            row.acquireError=errorText(acquireError);app.abortRequested=true;
            // A throwing native call has no reliable acquisition result. Exit
            // this script rather than risking an unmatched release of a lock.
            throw problem("VIEWPORT_ACQUIRE",row.acquireError+". Closing the script for native lock cleanup.");
        }
        viewportLocksOwned++;vd.acquired++;row.acquired=true;
        log("INFO","VIEWPORT_LOCK",code+" | acquired=true; redraw only; default observation/event calls unchanged");
        try { result=fn(); }
        catch(e) { originalError=e; }
        finally {
            var t=new Date().getTime();
            row.lockedMs=t-row.startedMs;
            try { releaseWardrobeViewportLocks(code);row.released=true; }
            catch(releaseError) {
                row.releaseError=errorText(releaseError);
                log("FAIL","VIEWPORT_RELEASE",row.releaseError+"; final cleanup will retry, and the script will close if release remains unconfirmed.");
                if(!originalError) originalError=problem("VIEWPORT_RELEASE",row.releaseError);
            }
            row.releaseMs=new Date().getTime()-t;
        }
        if(originalError) throw originalError;
        return result;
    }
    function finishViewportDiagnostics() {
        var vd=viewportDiagnostic();
        if(!vd) return;
        vd.finalOwnedDepth=viewportLocksOwned;
        vd.actual=vd.acquired ? (vd.acquired===vd.released && !viewportLocksOwned ? "balanced_native_redraw_lock" : "release_unconfirmed") :
            (ctx.fastNoop ? "not_requested_structural_noop" : (vd.requested ? (vd.available ? "no_store_restore_batch" : "unavailable") : "off"));
        log("INFO","PERF_VIEWPORT","requested="+vd.requested+" | actual="+vd.actual+" | acquired="+vd.acquired+
            " | released="+vd.released+" | ownedLocks="+viewportLocksOwned+" | scope=store_restore_batch_only");
    }
    function resolveRestorePair(nodeID,targetID,purpose) {
        // Share lookup work ONLY between two adjacent reads, ending the scope
        // before the native setter. No handles/index survive any mutation/event.
        return withReadScope(function(){
            profileCount("restoreLookupPairs",1);
            return {node:nodeByID(nodeID,"Part"),target:nodeByID(targetID,purpose)};
        },false);
    }
    function readOutfitSummary(fig) {
        if(!fig) return {valid:false,activeIDs:[],message:"No figure selected."};
        try {
            return withReadScope(function(){
                assertNoPending(fig);
                var inv=inventory(fig,app.db),ids=Object.keys(inv),active=[];
                for(var i=0;i<ids.length;i++) if(inv[ids[i]].where==="active") {
                    nativeLinkCheck(app.db.items[ids[i]],inv[ids[i]],fig);active.push(ids[i]);
                }
                active.sort();
                // All fully present, in-scope sets contribute coverage. A
                // complete Jewelry Set and a complete Casual Set may both be
                // Worn. A stray default-Remove item not covered by any such
                // set must still invalidate a Worn claim.
                var covered={},setIDs=Object.keys(app.db.sets),activeMap={};
                for(var ai=0;ai<active.length;ai++)activeMap[active[ai]]=true;
                for(var si=0;si<setIDs.length;si++){
                    var other=app.db.sets[setIDs[si]],compatible=false;
                    try{compatible=!scopeProblem(other,fig);}catch(ignoreOtherScope){}
                    if(!compatible)continue;
                    var complete=true;
                    for(var mi=0;mi<other.items.length;mi++)if(!own(activeMap,other.items[mi])){complete=false;break;}
                    if(complete)for(mi=0;mi<other.items.length;mi++)covered[other.items[mi]]=true;
                }
                var propertyText=value(fig,"PropertyState"),propertySetID="",propertyEntries=[];
                if(propertyText){var ps=readAppliedPropertyState(fig);propertySetID=String(ps.setID||"");propertyEntries=clonePlain(ps.entries||[]);}
                return {valid:true,activeIDs:active,coveredIDs:Object.keys(covered),propertyStatePresent:!!propertyText,propertySetID:propertySetID,propertyEntries:propertyEntries,message:active.length+" registered item(s) worn. Status excludes unregistered clothes; Apply revalidates the scene."};
            },false);
        } catch(e) { return {valid:false,activeIDs:[],message:"Scene status unavailable: "+String(e)}; }
    }
    function outfitMatches(st,summary) {
        // A fully present set can coexist with another fully present set
        // (Casual + Jewelry). Extra active items not accounted for by any
        // complete set must be intentionally retainable by their own policy.
        // Material/property differences are evaluated separately as Modified.
        if(!st||!summary||!summary.valid||!Array.isArray(summary.activeIDs))return false;
        var active={},required={},covered={};
        for(var i=0;i<summary.activeIDs.length;i++)active[summary.activeIDs[i]]=true;
        for(i=0;i<st.items.length;i++){
            var reqID=st.items[i];required[reqID]=true;
            if(!own(active,reqID))return false;
        }
        for(i=0;i<st.items.length;i++){
            var requiredItem=app.db&&app.db.items?app.db.items[st.items[i]]:null;
            var policy=itemTransitionPolicy(requiredItem);
            if(policy.mode!=="replace")continue;
            for(var pi=0;pi<policy.replacementIDs.length;pi++){
                var candidate=policy.replacementIDs[pi];
                if(!own(required,candidate)&&own(active,candidate))return false;
            }
        }
        var ids=summary.coveredIDs||[];
        for(i=0;i<ids.length;i++)covered[ids[i]]=true;
        var groupDomain=groupScopedDomain(st,null,app.db);
        for(i=0;i<summary.activeIDs.length;i++){
            var id=summary.activeIDs[i];
            // Group-scoped sets do not claim other groups' items.
            if(groupDomain&&!own(groupDomain,id))continue;
            if(own(required,id)||own(covered,id))continue;
            var item=app.db&&app.db.items?app.db.items[id]:null;
            if(!item||!transitionCanRemain(item,st.items))return false;
        }
        return true;
    }
    function overrideTargetDescription(rec) {
        if(rec.targetKind==="figure")return "Figure"+(rec.propertyNodePath&&rec.propertyNodePath.length?" / "+rec.propertyNodePath.join(" / "):"");
        var it=app.db&&app.db.items?app.db.items[rec.itemID]:null;
        var partLabel="";
        if(it&&rec.partID)for(var ip=0;ip<it.parts.length;ip++)if(it.parts[ip].id===rec.partID){
            partLabel=it.parts[ip].root?"":" / "+String(it.parts[ip].name||"Part");break;}
        return "Item: "+String(it&&it.name?it.name:rec.itemID||"(unknown)")+partLabel+
            (rec.propertyNodePath&&rec.propertyNodePath.length?" / "+rec.propertyNodePath.join(" / "):"");
    }
    function diagnoseOutfitProperties(st,fig,summary,inv) {
        // This is a read-only, fresh scene check. No native property wrappers
        // or values are retained between UI refreshes or scene operations.
        var list=setPropertyOverrides(st);
        var result={worn:outfitMatches(st,summary),status:"not_worn",changed:[],missing:[],total:list.length};
        if(!result.worn)return result;
        for(var i=0;i<list.length;i++){
            var rec=list[i],where=overrideTargetDescription(rec),name=String(rec.propertyLabel||rec.propertyName);
            try{
                var node=propertyTargetNode(rec,fig,inv),p=propertyHandleForOverride(node,rec),actual=Number(p.getValue());
                if(!isFinite(actual))throw problem("PROPERTY_VALUE","Non-finite live value.");
                if(!closeNumbers(actual,Number(rec.applyValue)))result.changed.push({target:where,name:name,
                    propertyName:String(rec.propertyName),actual:actual,expected:Number(rec.applyValue)});
            }catch(e){result.missing.push({target:where,name:name,propertyName:String(rec.propertyName),reason:String(e)});}
        }
        var partRows=partStateEntries(st);result.partStates=partRows.length;
        for(var si=0;si<partRows.length;si++){
            var row=partRows[si],it=app.db.items[row.itemID],spec=null;
            if(it)for(var spi=0;spi<it.parts.length;spi++)if(it.parts[spi].id===row.partID){spec=it.parts[spi];break;}
            var partLabel=(it?it.name:row.itemID)+" / "+(spec?spec.name:row.partID);
            try{
                var actualState=readPartVisibility(partStateNode(row,inv)),wantedState=row.state,fields=Object.keys(wantedState);
                for(var sf=0;sf<fields.length;sf++)if(actualState[fields[sf]]!==wantedState[fields[sf]])
                    result.changed.push({target:partLabel,name:fields[sf]+" visibility",propertyName:"partState."+fields[sf],actual:actualState[fields[sf]],expected:wantedState[fields[sf]]});
            }catch(stateError){result.missing.push({target:partLabel,name:"Part visibility",propertyName:"partStates",reason:String(stateError)});}
        }
        result.status=result.missing.length?"missing":(result.changed.length?"modified":"worn");
        return result;
    }
    // Read-only, per-Set material status: a set with matching clothing stays
    // Worn even if another saved style is currently visible. JSON snapshots are
    // the source of truth here; availability of a Restore .duf does not affect
    // whether live materials match the selected Set's snapshot.
    function diagnoseOutfitMaterialStatus(st,inv,fig) {
        var entries=setMaterialSnapshots(st),ids=Object.keys(entries),out={tracked:ids.length,
            matched:0,changed:[],unavailable:[],compatible:0};
        for(var i=0;i<ids.length;i++){
            var id=ids[i],it=app.db.items[id],inf=inv[id],saved=entries[id];
            var display=it?String(it.name):String(id);
            if(!it||!inf||inf.where!=="active"){
                out.unavailable.push(display+": registered garment is not currently available on the figure.");
                continue;
            }
            try{
                var status=autoSetMaterialStatus(it,inf,saved,fig);
                if(status.changed.length){
                    out.changed.push({item:display,differences:status.changed.slice(0,12)});
                }else{out.matched++;if(status.compatible)out.compatible++;}
                for(var k=0;k<status.incomplete.length;k++)out.unavailable.push(status.incomplete[k]);
            }catch(e){out.unavailable.push(display+": "+String(e));}
        }
        return out;
    }
    function outfitHasPartiallyVerifiedMaterials(properties,materialStatus){
        // Partial verification takes display priority if some material fields
        // are unreadable. Detailed changed values remain in Details, without
        // showing a second competing Modified status on the outfit card.
        return !!(properties&&properties.status!=="unavailable"&&materialStatus&&
            materialStatus.unavailable&&materialStatus.unavailable.length&&
            materialStatus.unavailable.every(function(row){
                var s=String(row);
                return s.indexOf("partially readable properties")>=0||
                    s.indexOf("unavailable material fields")>=0;
            }));
    }
    function outfitCombinedWornStatus(properties,materialStatus){
        if(!properties||!properties.worn)return "not_worn";
        var modified=!!(properties.changed.length||materialStatus&&materialStatus.changed.length),
            missing=!!properties.missing.length,
            unavailable=!!(properties.status==="unavailable"||materialStatus&&materialStatus.unavailable.length);
        if(modified)return missing?"modified_missing":"modified";
        if(missing)return "missing";
        // Some 3Delight properties cannot be read as JSON scalar/image pairs.
        // Clothing and all readable material values can still be verified.
        // Distinguish this uncertainty from a failed material comparison.
        if(unavailable){
            if(outfitHasPartiallyVerifiedMaterials(properties,materialStatus))return "partially_verified";
            return "unavailable";
        }
        return "worn";
    }
    function outfitCombinedStatusText(status){
        if(status==="worn")return "Worn";
        if(status==="modified")return "Worn \u00B7 Modified";
        if(status==="modified_missing")return "Worn \u00B7 Modified";
        if(status==="missing")return "Worn \u00B7 Missing Property";
        if(status==="partially_verified")return "Worn \u00B7 Partially Verified";
        return "Worn \u00B7 Status Unavailable";
    }
    function outfitPropertyDiagnosticText(st,diagnosis,materialStatus) {
        var lines=["Set: "+String(st.name),"Registered clothing: "+(diagnosis.worn?"all required items worn (compatible co-worn sets permitted)":"does not match this set"),
            "Property overrides: "+diagnosis.total,"Changed: "+diagnosis.changed.length,"Unavailable: "+diagnosis.missing.length];
        if(diagnosis.changed.length){lines.push("","Changed properties:");for(var i=0;i<diagnosis.changed.length;i++){
            var c=diagnosis.changed[i];lines.push("- "+c.target+" / "+c.name+" ["+c.propertyName+"]", "    Current: "+c.actual+" | Apply: "+c.expected);
        }}
        if(diagnosis.missing.length){lines.push("","Missing / unresolved properties:");for(var j=0;j<diagnosis.missing.length;j++){
            var m=diagnosis.missing[j];lines.push("- "+m.target+" / "+m.name+" ["+m.propertyName+"]", "    "+m.reason);
        }}
        if(materialStatus){
            lines.push("","Material snapshots: "+materialStatus.tracked,
                "Matching material items: "+materialStatus.matched,
                "Material items changed: "+materialStatus.changed.length,
                "Material diagnostics unavailable: "+materialStatus.unavailable.length);
            for(var mi=0;mi<materialStatus.changed.length;mi++){
                var row=materialStatus.changed[mi];lines.push("- Modified materials: "+row.item);
                for(var md=0;md<row.differences.length;md++)lines.push("    "+row.differences[md]);
            }
            if(materialStatus.unavailable.length){lines.push("","Unavailable material checks:");
                for(var mu=0;mu<materialStatus.unavailable.length;mu++)lines.push("- "+materialStatus.unavailable[mu]);}
        }
        lines.push("","No wardrobe item, material or native property is modified by this diagnostic.");
        return lines.join("\n");
    }
    // Named groups are pure presentation metadata. The implicit Default group
    // is the empty ID and is never added to the catalog's groups dictionary.
    function setGroupID(st){return st&&typeof st.groupID==="string"?st.groupID:"";}
    function setGroupEntries(db){
        var groups=db&&db.groups?db.groups:{},ids=Object.keys(groups),out=[];
        for(var i=0;i<ids.length;i++)out.push({id:ids[i],name:groups[ids[i]].name});
        out.sort(function(a,b){var al=a.name.toLowerCase(),bl=b.name.toLowerCase();
            return al<bl?-1:(al>bl?1:(a.id<b.id?-1:(a.id>b.id?1:0)));});
        return out;
    }
    function validateGroupName(raw){
        if(typeof raw!=="string")throw problem("GROUP_NAME","Enter a group name.");
        var name=trim(raw);
        if(!name||name.length>64||/[\x00-\x1f\x7f]/.test(name))
            throw problem("GROUP_NAME","Group name must contain 1 to 64 characters and no control characters.");
        var lower=name.toLowerCase();
        if(lower==="default"||lower==="all groups")
            throw problem("GROUP_NAME","Default and All Groups are reserved group names.");
        return name;
    }
    function groupNameTaken(db,name){
        var needle=trim(name).toLowerCase(),entries=setGroupEntries(db);
        for(var i=0;i<entries.length;i++)if(entries[i].name.toLowerCase()===needle)return true;
        return false;
    }
    function resolveSetGroupForSave(spec,old,next){
        var selectedGroup=String(spec.groupID===undefined?(old?setGroupID(old):""):spec.groupID);
        if(selectedGroup==="__new_group__"){
            var newName=validateGroupName(spec.newGroupName);
            if(groupNameTaken(next,newName))throw problem("GROUP_DUPLICATE","This group already exists. Select it in the Group list.");
            selectedGroup=unique("group");
            next.groups=next.groups||{};
            next.groups[selectedGroup]={id:selectedGroup,name:newName,created:String(new Date())};
        }else if(selectedGroup&&!own(next.groups||{},selectedGroup))
            throw problem("GROUP_MISSING","The selected group no longer exists. Reopen Edit Outfit Set.");
        return selectedGroup;
    }
    // v0.9.9.1: Create/Rename/Delete cosmetic groups as one catalog revision.
    // Group IDs remain stable on rename. Deleted groups move their sets into
    // Default. Group operations never change the currently edited Set's items.
    function groupCatalogChange(kind, groupID, requestedName, observedCommit) {
        if(kind!=="create"&&kind!=="rename"&&kind!=="delete")
            throw problem("GROUP_ACTION","Unsupported group operation.");
        if(!app.libraryPath||!app.db)throw problem("LIBRARY_UNAVAILABLE","Open a wardrobe library first.");
        if(kind!=="create"&&(!groupID||groupID==="__all__"||groupID==="__default__"))
            throw problem("GROUP_DEFAULT","Default cannot be renamed or deleted.");
        var locked=false;
        try{
            lockLibrary();locked=true;
            var current=readCatalog(),previousFile=app.catalogFile;
            app.db=current;
            if(current.commitID!==observedCommit)
                throw problem("GROUP_STALE","The library changed. Reopen Manage Groups and try again.");
            if(kind!=="create"&&!own(current.groups||{},groupID))
                throw problem("GROUP_MISSING","The selected group no longer exists.");
            var next=clonePlain(current),affected=0,scoped=0;
            if(kind==="create"){
                var createdName=validateGroupName(requestedName);
                if(groupNameTaken(next,createdName))
                    throw problem("GROUP_DUPLICATE","Another group already has that name.");
                groupID=unique("group");
                next.groups[groupID]={id:groupID,name:createdName,created:String(new Date())};
            }else if(kind==="rename"){
                var name=validateGroupName(requestedName);
                var ids=Object.keys(next.groups);
                for(var i=0;i<ids.length;i++)if(ids[i]!==groupID &&
                    next.groups[ids[i]].name.toLowerCase()===name.toLowerCase())
                    throw problem("GROUP_DUPLICATE","Another group already has that name.");
                if(next.groups[groupID].name===name)return {changed:false,id:groupID,name:name,sets:0,scoped:0};
                next.groups[groupID].name=name;
            }else{
                var all=Object.keys(next.sets);
                for(var j=0;j<all.length;j++){
                    var st=next.sets[all[j]];
                    if(setGroupID(st)!==groupID)continue;
                    st.groupID="";affected++;
                    if(st.replaceWithinGroup===true)scoped++;
                }
                delete next.groups[groupID];
            }
            commitCatalog(next,previousFile);
            if(kind==="delete"&&app.groupFilterID===groupID)app.groupFilterID="__all__";
            return {changed:true,id:groupID,name:kind==="delete"?"Default":next.groups[groupID].name,
                sets:affected,scoped:scoped};
        } finally {
            if(locked)unlockLibrary();
        }
    }
    function outfitGroupContents(db,groupID){
        var ids=Object.keys(db.sets||{}),rows=[],scoped=0;
        for(var i=0;i<ids.length;i++){
            var st=db.sets[ids[i]];
            if(setGroupID(st)!==groupID)continue;
            if(st.replaceWithinGroup===true)scoped++;
            rows.push(st.name);
        }
        rows.sort(function(a,b){var al=a.toLowerCase(),bl=b.toLowerCase();
            return al<bl?-1:(al>bl?1:0);});
        return {names:rows,count:rows.length,scoped:scoped};
    }
    function groupNamePrompt(currentName,isNew){
        var dialog=newGeorgiaDialog();dialog.caption=TITLE+(isNew?" - New Group":" - Rename Group");
        // Use the same native custom action footer as Partial Sets. The
        // default DzBasicDialog buttons have a different style and position.
        dialog.showHelpButton(false);dialog.showAcceptButton(false);dialog.showCancelButton(false);
        var contents=new DzVGroupBox(dialog);flattenGroupBox(contents);
        contents.insideMargin=4;contents.insideSpacing=5;
        var caption=label(contents,isNew?"New group name:":"Group name:"),input=new DzLineEdit(contents);
        caption.setFixedHeight(23);input.text=currentName;
        // The original 410px field left ~35px of unnecessary empty space on
        // the right in a 470px dialog. Match the visible left/right margins.
        input.setFixedSize(445,30);
        var footer=new DzHGroupBox(contents);flattenGroupBox(footer);
        footer.insideMargin=0;footer.insideSpacing=8;footer.setFixedSize(445,42);
        var spacer=new DzLabel(footer),accept=new DzPushButton(footer),cancel=new DzPushButton(footer);
        spacer.text="";spacer.setFixedWidth(159);
        function groupPromptAction(button,text,width,borderColor,backgroundColor){
            button.text=text;button.autoDefault=false;button.sizedFromIcon=false;
            button.setFixedSize(width,36);
            try{button.getWidget().setStyleSheet(
                'QPushButton { color: #F0F0F0; font-weight: bold; background-color: '+backgroundColor+'; '+
                'border: 1px solid '+borderColor+'; border-radius: 4px; padding: 3px 9px; }'+
                'QPushButton:hover { border: 2px solid '+borderColor+'; }'+
                'QPushButton:pressed { background-color: #55565A; }');}
            catch(ignoreGroupButtonStyle){}
        }
        groupPromptAction(accept,isNew?"Create Group":"Rename Group",150,"#69B58A","#33483D");
        groupPromptAction(cancel,"Cancel",120,"#B87B7B","#453737");
        setTextButtonResourceIcon(cancel,"Wearable Manager Close.png",24,24);
        var accepted=false;
        connect(accept,"clicked()",function(){accepted=true;dialog.close();});
        connect(cancel,"clicked()",function(){dialog.close();});
        // Preserve the native prompt's Enter-to-accept convenience.
        connect(input,"returnPressed()",function(){accepted=true;dialog.close();});
        contents.setFixedSize(459,108);dialog.addWidget(contents);dialog.setFixedSize(470,150);
        var result=null;
        try{dialog.exec();if(accepted)result=String(input.text);}finally{dialog.deleteLater();}
        return result;
    }
    function manageGroupsDialog(initialGroupID){
        if(!app.libraryPath||!app.db){MessageBox.warning("Open a wardrobe library first.",TITLE,"&OK");return;}
        app.db=readCatalog();
        var dialog=newGeorgiaDialog();dialog.caption=TITLE+" - Manage Groups";
        dialog.showHelpButton(false);dialog.showAcceptButton(false);dialog.showCancelButton(false);
        var container=new DzVGroupBox(dialog);flattenGroupBox(container);
        container.insideMargin=9;container.insideSpacing=4;
        var top=new DzHGroupBox(container);flattenGroupBox(top);top.insideSpacing=9;top.setFixedHeight(34);
        var title=label(top,"Group:"),choices=new DzComboBox(top);
        title.setFixedWidth(55);choices.minWidth=435;
        // The group membership list is collapsed on opening; the count and
        // disclosure button stay visible next to each other.
        var summaryRow=new DzHGroupBox(container);flattenGroupBox(summaryRow);
        summaryRow.insideMargin=0;summaryRow.insideSpacing=5;summaryRow.setFixedHeight(28);
        var summary=label(summaryRow,"");summary.setFixedHeight(26);summary.minWidth=460;
        var expandMembers=new DzPushButton(summaryRow);expandMembers.text="\u25bc";
        expandMembers.autoDefault=false;expandMembers.setFixedSize(30,26);
        expandMembers.toolTip="Show outfit sets in this group";
        var members=new DzTextEdit(container);members.readOnly=true;members.acceptRichText=false;
        members.setFixedSize(500,180);members.hide();
        var membersExpanded=false;
        var actions=new DzHGroupBox(container);flattenGroupBox(actions);actions.insideSpacing=8;actions.setFixedHeight(42);
        var create=new DzPushButton(actions),rename=new DzPushButton(actions),
            remove=new DzPushButton(actions),close=new DzPushButton(actions);
        wardrobePolicyActionStyle(create,"Create Group...",118,"#69B58A","#33483D");
        wardrobePolicyActionStyle(rename,"Rename Group...",124,"#79A7E1","#303E58");
        wardrobePolicyActionStyle(remove,"Delete Group...",124,"#B87B7B","#453737");
        close.text="Close";close.setFixedSize(98,36);close.autoDefault=false;
        function refreshMemberPanel(){
            expandMembers.text=membersExpanded?"\u25b2":"\u25bc";
            expandMembers.toolTip=membersExpanded?"Hide outfit sets":"Show outfit sets in this group";
            if(membersExpanded)members.show();else members.hide();
            dialog.setFixedSize(545,membersExpanded?376:184);
        }
        connect(expandMembers,"clicked()",function(){membersExpanded=!membersExpanded;refreshMemberPanel();});
        var groupRows=[];
        function selectedGroup(){return groupRows[choices.currentItem]||groupRows[0];}
        function refreshSelection(){
            var row=selectedGroup();if(!row)return;
            var info=outfitGroupContents(app.db,row.id);
            summary.text=info.count+" outfit set(s)"+(info.scoped?" | "+info.scoped+" group-scoped transition(s)":"");
            members.plainText=info.names.length?info.names.join("\n"):"No outfit sets in this group.";
            rename.enabled=remove.enabled=!!row.id;
        }
        function refreshGroups(preferredID){
            groupRows=[{id:"",name:"Default"}].concat(setGroupEntries(app.db));
            choices.clear();var at=0;
            for(var i=0;i<groupRows.length;i++){
                choices.addItem(groupRows[i].name);
                if(groupRows[i].id===preferredID)at=i;
            }
            choices.currentItem=at;refreshSelection();
        }
        function reloadAfterChange(preferredID){
            app.db=readCatalog();refreshGroups(preferredID);
        }
        connect(choices,"activated(int)",refreshSelection);
        connect(create,"clicked()",function(){
            var name=groupNamePrompt("",true);if(name===null)return;
            try{
                var created=groupCatalogChange("create","",name,app.db.commitID);
                reloadAfterChange(created.id);
            }catch(e){
                MessageBox.warning(userErrorText(e),TITLE+" - Create Group","&OK");
                try{reloadAfterChange(selectedGroup().id);}catch(ignoreReload){}
            }
        });
        connect(rename,"clicked()",function(){
            var entry=selectedGroup();if(!entry||!entry.id)return;
            var nextName=groupNamePrompt(entry.name,false);if(nextName===null)return;
            try{
                groupCatalogChange("rename",entry.id,nextName,app.db.commitID);
                reloadAfterChange(entry.id);
            }catch(e){
                MessageBox.warning(userErrorText(e),TITLE+" - Rename Group","&OK");
                try{reloadAfterChange(entry.id);}catch(ignoreReload){}
            }
        });
        connect(remove,"clicked()",function(){
            var entry=selectedGroup();if(!entry||!entry.id)return;
            var info=outfitGroupContents(app.db,entry.id);
            var confirmation="Delete group '"+entry.name+"'?\n\n"+
                info.count+" outfit set(s) will be moved to Default. No set, registered clothing, material preset, image, or catalog history will be deleted."+
                (info.scoped?"\n\nWARNING: "+info.scoped+" Set(s) use 'Replace Items Within This Group Only'. Their transition scope will change to the Default group. Review those Sets before applying them.":"")+
                "\n\nThis creates a new catalog revision.";
            // Cancel is button zero: ESC must never delete a group.
            if(MessageBox.warning(confirmation,TITLE+" - Delete Group","&Cancel","&Delete Group")!==1)return;
            try{
                groupCatalogChange("delete",entry.id,"",app.db.commitID);
                reloadAfterChange("");
            }catch(e){
                MessageBox.warning(userErrorText(e),TITLE+" - Delete Group","&OK");
                try{reloadAfterChange(entry.id);}catch(ignoreReload){}
            }
        });
        connect(close,"clicked()",function(){dialog.close();});
        refreshGroups(initialGroupID||"");dialog.addWidget(container);refreshMemberPanel();
        var selectedID="";
        try{dialog.exec();selectedID=selectedGroup()?selectedGroup().id:"";}
        finally{dialog.deleteLater();}
        return selectedID;
    }
    function groupFilterMatches(st,selected){
        if(!selected||selected==="__all__")return true;
        var id=setGroupID(st);
        return selected==="__default__"?!id:id===selected;
    }
    function groupDisplayName(st,db){
        var id=setGroupID(st);return id&&db&&db.groups&&own(db.groups,id)?db.groups[id].name:"Default";
    }

    function cardVisible(st,compatible,query) {
        if(!compatible) return false;
        var q=trim(query).toLowerCase();
        return !q || (st.name+" "+describeIDs(st.items)).toLowerCase().indexOf(q)>=0;
    }

    // v0.3.4 read engine. Scopes are explicit, synchronous phases, NOT an action-
    // long scene cache. Fresh transforms/material values are always read natively.
    function optimizedReads() { return ctx ? ctx.optimizeReads !== false : app.optimizeReads !== false; }
    function profileBegin(name) {
        if (!ctx || !ctx.profile) return null;
        var p = ctx.profile, token = {name:name,started:new Date().getTime(),childMs:0,parent:p.current};
        p.current = token; return token;
    }
    function profileEnd(token) {
        if (!token || !ctx || !ctx.profile) return;
        var p = ctx.profile, elapsed = Math.max(0,new Date().getTime()-token.started), row=p.rows[token.name];
        if (!row) row=p.rows[token.name]={calls:0,inclusiveMs:0,selfMs:0,maxMs:0};
        row.calls++;row.inclusiveMs+=elapsed;row.selfMs+=Math.max(0,elapsed-token.childMs);row.maxMs=Math.max(row.maxMs,elapsed);
        if (token.parent) token.parent.childMs+=elapsed;
        p.current=token.parent;
    }
    function profileCount(name, amount) {
        if (!ctx || !ctx.profile) return;
        var c=ctx.profile.counters;c[name]=(c[name]||0)+amount;
    }
    function withReadScope(fn, allowMetadata) {
        if (!optimizedReads()) return fn();
        if (readScope) return fn();
        // inventory/materials maps live only for this synchronous scope. They
        // never span Scene.update(), sleep(), processEvents() or metadata writes.
        readScope={nodes:null,index:null,data:{},fields:{},inventory:null,materials:null,
            identityReady:false,epoch:0,allowMetadata:!!allowMetadata};
        profileCount("readScopes",1);
        try { return fn(); }
        finally { readScope=null; }
    }
    function withMetadataBatch(name, fn, allowMetadata) {
        // Group ONLY adjacent synchronous reads, or the existing allowed own-ID
        // writes. Never span a native link setter/import/update/event boundary.
        // No cached data is exported from this scope: callers return ordinary
        // snapshots/Recovery records exactly as before, not an index or plan cache.
        if (!optimizedReads()) return fn();
        var counters = ctx && ctx.profile ? ctx.profile.counters : null;
        var nr = counters ? counters.metadataNativeReads || 0 : 0;
        var se = counters ? counters.sceneEnumerations || 0 : 0;
        var start = new Date().getTime();
        profileCount("metadataReadBatches", 1);
        try { return withReadScope(fn, allowMetadata); }
        finally {
            if (counters && ctx && ctx.profile) {
                var groups = ctx.profile.metadataBatches || (ctx.profile.metadataBatches = {});
                var row = groups[name] || (groups[name] = {calls:0,elapsedMs:0,nativeReads:0,sceneEnumerations:0});
                row.calls++; row.elapsedMs += Math.max(0, new Date().getTime() - start);
                row.nativeReads += (counters.metadataNativeReads || 0) - nr;
                row.sceneEnumerations += (counters.sceneEnumerations || 0) - se;
            }
        }
    }
    function invalidateReadScope() {
        if (!readScope) return;
        readScope.nodes=null;readScope.index=null;readScope.data={};readScope.fields={};
        readScope.inventory=null;readScope.materials=null;
        readScope.identityReady=false;readScope.epoch++;
        profileCount("scopeInvalidations",1);
    }
    function requireUnscoped(where) {
        if (readScope) throw problem("READ_SCOPE_BOUNDARY","Unexpected event-loop/native-write boundary inside a read phase: "+where);
    }
    function sceneNodes() {
        if (readScope && readScope.nodes) { profileCount("sceneListHits",1);return readScope.nodes; }
        profileCount("sceneEnumerations",1);
        var nodes=Scene.getNodeList();
        if (readScope) readScope.nodes=nodes;
        return nodes;
    }
    function releasePropertyHelper() {
        var h=sharedPropertyHelper;sharedPropertyHelper=null;
        if (h && typeof h.deleteLater==="function") {
            try { h.deleteLater(); } catch(e) { print(TITLE+" / helper disposal: "+String(e)); }
        }
    }
    function performanceSnapshot() {
        if (!ctx || !ctx.profile) return null;
        var p=ctx.profile, observations=[];
        for(var i=0;i<ctx.diag.observations.length;i++) {
            var e=ctx.diag.observations[i],trace=e.trace||[],r={name:e.name,watchedNodes:e.watchedNodes,
                policy:clonePlain(e.policy),samples:trace.length,elapsedMs:e.elapsedMs,initialMeasurementMs:e.initialMeasurementMs||0,
                waitMs:0,updateMs:0,measurementMs:0,buildQueryMs:0,comparisonMs:0,stable:!!e.stable};
            for(var j=0;j<trace.length;j++) {
                r.waitMs+=trace[j].waitMs||0;r.updateMs+=trace[j].updateMs||0;
                r.measurementMs+=trace[j].measurementMs||0;r.buildQueryMs+=trace[j].buildQueryMs||0;r.comparisonMs+=trace[j].comparisonMs||0;
            }
            observations.push(r);
        }
        return {schemaVersion:1,prototypeVersion:VERSION,mode:ctx.optimizeReads?"optimized":"reference",
            operationID:ctx.id,dazVersion:String(App.versionString),elapsedToCaptureMs:Math.max(0,new Date().getTime()-p.startedMs),
            note:"Inclusive function times overlap. selfMs excludes instrumented child functions. Wall time includes native waits; UI selection/report reading and the final small performance export are excluded.",
            channelReader:{algorithm:ctx.optimizeReads?(ctx.bulkChannels?"owner_scoped_fresh_property_list":"direct_single_resolution"):"reference_double_resolution",
                actualUsage:channelActualUsage(),bindingPolicy:"unique_owned_public_name_v1",
                bindings:clonePlain(ctx.bulkStats||{}),fallbackReasons:clonePlain(ctx.bulkFallbackReasons||{}),
                issueCounts:clonePlain(ctx.bulkIssueCounts||{}),issues:clonePlain(ctx.diag.channelBindingIssues||[]),
                valueCache:false,handleLifetime:"One synchronous node snapshot only; no event processing inside the reader.",
                bindingDescriptors:"Owner runtime key, native class, name and method role only; signal-invalidated, optionally reused within this script in Operational. Never serialized into wardrobe data. Fresh public/private lists and native values each snapshot.",
                sampledStageTiming:true,sampleLimits:{full:24,values:8},
                note:"Stage timings cover only the sampled node reads, not the entire action. They include script/native dispatch and use a millisecond clock; do not extrapolate a speedup from them.",
                summaries:channelTimingSummary(p.channelSamples||[]),samples:clonePlain(p.channelSamples||[])},
            channelSession:clonePlain(ctx.diag.channelSession||{}),
            viewportRedraw:clonePlain(ctx.diag.viewportRedraw||{}),
            figurePoseAudit:{enabled:figurePoseAuditEnabled(), snapshots:ctx.profile.counters.figurePoseSnapshots || 0,
                wholeFigurePosePreservationVerified:figurePoseAuditEnabled() ? "see_action_checks" : false,
                note:"Operational never collects a whole-figure pose; root/item observation remains. Full/maintenance keep existing pose diagnostics."},
            metadataReader:{algorithm:ctx.optimizeReads ? "synchronous_batches_identity_index_v041" : "reference_v040",
                fields:["NodeID","FigureID","InstanceID"], searchCoverage:"all_scene_nodes_all_matches",
                cacheLifetime:"one_synchronous_read_scope_only", sessionCache:false, actionCache:false,
                ownWriteInvalidation:"all_indexes_before_and_after_including_failure",
                unchangedValueReads:true, batches:clonePlain(p.metadataBatches || {}),
                batchTimingNote:"Batch times include nested functions; do not add to PERF_FUNCTION or PERF_TOTAL."},
            counters:clonePlain(p.counters),functions:clonePlain(p.rows),observations:observations,
            validationPolicy:{selection:"named_per_window_v0310",definitions:clonePlain(OBSERVATION_POLICIES)},
            fastNoop:clonePlain(ctx.diag.fastNoop || null),
            verificationPolicy:verificationPolicy()};
    }
    function logPerformanceSummary() {
        var perf=performanceSnapshot();if(!perf)return;
        ctx.diag.performance=perf;
        log("INFO","PERF_ACTION","mode="+perf.mode+" | beforeReportExportMs="+perf.elapsedToCaptureMs+" | imports="+ctx.loadCalls+" | verification="+perf.verificationPolicy.effective+" | numeric tolerances unchanged; coverage depends on profile");
        log("INFO","PERF_READS",JSON.stringify(perf.counters));
        log("INFO","PERF_METADATA","algorithm="+perf.metadataReader.algorithm+
            " | nativeReads="+(perf.counters.metadataNativeReads||0)+
            " | identityIndexPasses="+(perf.counters.identityIndexPasses||0)+
            " | identityNodesVisited="+(perf.counters.identityIndexNodesVisited||0)+
            " | readBatches="+(perf.counters.metadataReadBatches||0)+
            " | allMatches=true | cache=one_synchronous_scope | acrossWritesOrEvents=false");
        log("INFO","PERF_POSE_AUDIT","enabled="+perf.figurePoseAudit.enabled+" | snapshots="+perf.figurePoseAudit.snapshots+
            " | whole-figure pose diagnostics only; root/item observations counted separately");
        for(var i=0;i<perf.observations.length;i++) {
            var o=perf.observations[i];
            log("INFO","PERF_OBSERVE_"+o.name,"policy="+(o.policy ? o.policy.id : "unknown")+" | nodes="+o.watchedNodes+" | totalMs="+o.elapsedMs+
                " | initialReadMs="+o.initialMeasurementMs+" | samples="+o.samples+" | waitMs="+o.waitMs+
                " | sceneUpdateMs="+o.updateMs+" | readMs="+o.measurementMs+" | buildQueryMs="+o.buildQueryMs+" | compareMs="+o.comparisonMs);
        }
        var names=Object.keys(perf.functions);
        names.sort(function(a,b){return perf.functions[b].selfMs-perf.functions[a].selfMs;});
        for(var j=0;j<names.length&&j<12;j++) {
            var r=perf.functions[names[j]];
            log("INFO","PERF_FUNCTION",names[j]+" | calls="+r.calls+" | selfMs="+r.selfMs+" | inclusiveMs="+r.inclusiveMs+" | maxMs="+r.maxMs);
        }
        var timing=perf.channelReader, kinds=Object.keys(timing.summaries);
        log("INFO","PERF_CHANNEL_BINDINGS",JSON.stringify(timing.bindings)+" | fallbacks="+JSON.stringify(timing.fallbackReasons)+" | descriptors only; values never cached");
        log("INFO","PERF_CHANNEL_READER","configured="+timing.algorithm+" | actual="+timing.actualUsage+
            " | bulkSnapshots="+(timing.bindings.bulkSnapshots||0)+" | certificationDirectSnapshots="+(timing.bindings.certificationDirectSnapshots||0)+
            " | fallbackSnapshots="+(timing.bindings.fallbackSnapshots||0)+" | valuesCached=false | original snapshot fields retained");
        if(Object.keys(timing.issueCounts).length)log("INFO","PERF_CHANNEL_ISSUES",JSON.stringify(timing.issueCounts)+" | details retained in diagnostics.json/performance.json");
        for(var k=0;k<kinds.length;k++) {
            var c=timing.summaries[kinds[k]];
            log("INFO","PERF_CHANNEL_DETAIL","kind="+kinds[k]+" | sampledNodes="+c.sampledNodes+" | sampledControls="+c.controls+
                " | controlResolutionMs="+c.controlResolutionMs+" | evaluatedMs="+c.evaluatedMs+" | rawMs="+c.rawMs+
                " | controllerCountMs="+c.controllerCountMs+" | lockedMs="+c.lockedMs+" | formatMs="+c.formatMs+
                " | rawUnavailable="+c.rawUnavailable+" | controllerCountUnavailable="+c.controllerCountUnavailable+
                " | lockedUnavailable="+c.lockedUnavailable+" | sampled subset only");
        }
    }
    function finishPerformanceReport() {
        var perf=performanceSnapshot();if(!perf)return;
        log("INFO","PERF_TOTAL","mode="+perf.mode+" | elapsedToExportMs="+perf.elapsedToCaptureMs+
            " | verification="+perf.verificationPolicy.effective+" | includesMainDiagnosticsExport=true | excludesUserDialogTime=true");
        if(ctx.directory) {
            try { writeText(ctx.directory+"/performance.json",jsonText(perf),false); }
            catch(e) { log("WARN","PERF_EXPORT",errorText(e)); }
        }
    }

    function own(obj, key) { return Object.prototype.hasOwnProperty.call(obj, key); }

    function trim(s) { return String(s).replace(/^\s+|\s+$/g, ""); }

    function key(node) {
        if (!node) return "";
        return String(node.elementID) + ":" + String(node.className());
    }

    function same(a, b) { return a && b ? key(a) === key(b) : !a && !b; }

    function sceneIndex() {
        var token = profileBegin("scene_index");
        try {
            if (readScope && readScope.index) { profileCount("sceneIndexHits", 1); return readScope.index; }
            var result = {}, nodes = sceneNodes();
            profileCount("sceneIndexBuilds", 1);
            for (var i = 0; i < nodes.length; i++) {
                var k = key(nodes[i]);
                if (own(result, k)) throw new Error("Duplicate live scene identity: " + k);
                result[k] = nodes[i];
            }
            if (readScope) readScope.index = result;
            return result;
        } finally { profileEnd(token); }
    }

    function live(k) { var map = sceneIndex(); return own(map, k) ? map[k] : null; }

    function unique(prefix) {
        sequence++;
        return "matew_" + prefix + "_" + (new Date()).getTime().toString(36) +
            "_" + sequence.toString(36) + "_" + Math.floor(Math.random() * 0x7fffffff).toString(36);
    }

    function isFigure(node) {
        if(!node || !node.inherits("DzFigure"))return false;
        if(wm2Figures.available){
            // WM2's canonical type rules, evaluated without rebuilding the
            // full scene index per object (otherwise quadratic on big scenes).
            if(!wm2ConfiguredFigureName(node))return false;
            if(node.inherits("DzBone")||node.inherits("DzGroupNode"))return false;
            // Preserve the verified v0.8.0 DzFigure classification instead of
            // requiring newer WM2-only methods to exist in every DAZ version.
            // If Fit To is available, a fitted figure cannot act as the owner.
            try{return typeof node.getFollowTarget!=="function"||!node.getFollowTarget();}
            catch(e){return false;}
        }
        return wm2Figures.fallback && FIGURES.indexOf(String(node.objectName)) >= 0;
    }

    function humanAncestor(node) {
        var n = node, guard = 0;
        while (n && guard++ < 1024) {
            if (isFigure(n)) return n;
            n = n.getNodeParent();
        }
        return null;
    }

    function follow(node) {
        return node && node.inherits("DzSkeleton") ? node.getFollowTarget() : null;
    }

    function boneOwner(node) {
        if (!node || !node.inherits("DzBone")) return null;
        var n = node;
        while (n && n.inherits("DzBone")) n = n.getNodeParent();
        return n;
    }

    function prop(node, name) {
        var token = profileBegin("property_resolution");
        profileCount("propertyFinds", 1);
        try {
            var helper;
            if (optimizedReads()) {
                if (!sharedPropertyHelper) { sharedPropertyHelper = new DzSceneHelper(); profileCount("helperConstructions", 1); }
                helper = sharedPropertyHelper;
            } else { helper = new DzSceneHelper(); profileCount("helperConstructions", 1); }
            // Deliberately retain the EXACT native resolver, including searches
            // on modifiers/providers and its first-match rules. No negative cache.
            return helper.findPropertyByInternalName(name, node);
        } finally { profileEnd(token); }
    }

    function linked(node, name) { var p = prop(node, name); return p ? p.getValue() : null; }

    function readText(path) {
        var f = new DzFile(path);
        try {
            if (!f.open(DzFile.ReadOnly)) throw new Error("Cannot read: " + path);
            return String(f.read());
        } finally { f.close(); f.deleteLater(); }
    }

    function writeText(path, text, append) {
        var f = new DzFile(path);
        try {
            if (!f.open(append ? DzFile.Append : DzFile.WriteOnly)) throw new Error("Cannot write: " + path);
            var result = f.write(String(text));
            if (result === false || (typeof result === "number" && result < 0)) throw new Error("Write failed: " + path);
        } finally { f.close(); f.deleteLater(); }
    }

    function mkdir(path) {
        var d = new DzDir(path);
        try { if (!d.exists() && !d.mkpath(path)) throw new Error("Cannot create folder: " + path); }
        finally { d.deleteLater(); }
    }

    function problem(code, message) {
        var e = new Error(code + ": " + message); e.code = code; return e;
    }
    function clonePlain(o) { return JSON.parse(JSON.stringify(o)); }
    function transformValues(n) {
        return optimizedReads() ? transformValuesDirect(n) : transformValuesReference(n);
    }

    function transformValuesReference(n) {
        var names = ["getXPosControl", "getYPosControl", "getZPosControl", "getXRotControl",
            "getYRotControl", "getZRotControl", "getScaleControl", "getXScaleControl",
            "getYScaleControl", "getZScaleControl"];
        var out = [];
        for (var i = 0; i < names.length; i++) {
            if (typeof n[names[i]] !== "function") continue;
            var p = n[names[i]]();
            if (p) {
                var v = Number(p.getValue());
                if (!isFinite(v)) throw new Error("Non-finite transform on " + n.getLabel() + " / " + names[i]);
                out.push({method: names[i], value: v});
            }
        }
        return out;
    }

    function closeNumbers(a, b) {
        if (typeof a === "number" && typeof b === "number") return isFinite(a) && isFinite(b) && Math.abs(a - b) <= 1e-5 * Math.max(1, Math.abs(a), Math.abs(b));
        if (a === b) return true;
        if (!a || !b || typeof a !== "object" || typeof b !== "object") return false;
        var ak = Object.keys(a).sort(), bk = Object.keys(b).sort();
        if (ak.join("|") !== bk.join("|")) return false;
        for (var i = 0; i < ak.length; i++) if (!closeNumbers(a[ak[i]], b[ak[i]])) return false;
        return true;
    }

    function scalarProperties(element) {
        var ps = element.getPropertyList(), out = {}, skipped = 0;
        for (var i = 0; i < ps.length; i++) {
            var p = ps[i], k = String(p.name), v;
            if(k==="matewWardrobeState_v1")continue;
            try {
                if (p.inherits("DzColorProperty")) {
                    var c = p.getColorValue();
                    out[k] = [Number(c.red), Number(c.green), Number(c.blue), Number(c.alpha)];
                } else if (p.inherits("DzNumericProperty") || p.inherits("DzStringProperty")) {
                    v = p.getValue();
                    if (typeof v === "number" || typeof v === "string" || typeof v === "boolean") out[k] = v;
                    else skipped++;
                } else skipped++;
                if (typeof p.getMapValue === "function") {
                    var map = p.getMapValue();
                    if (!map) out[k + "|map"] = "";
                    else if (typeof map.getFilename === "function") out[k + "|map"] = String(map.getFilename()).replace(/\\/g, "/");
                    else skipped++;
                }
            } catch (e) { skipped++; }
        }
        return {values: out, skipped: skipped};
    }

    // v0.9.10.1: Safe GeoShell export capability probe. It does NOT detach a
    // graft or apply any preset. It diagnoses native selective-material saves
    // before these files may be used for a protected GeoGraft transition.
    // v0.9.10.1: Classify each GeoShell material surface against each active
    // GeoGraft separately. A prior probe selected the UNION of all grafts,
    // which could overwrite unrelated graft surfaces on a selective import.
    // Exclude ordinary parent-figure materials (e.g. "Arms") and any surface
    // matching multiple grafts. This is diagnostic only, NOT a recovery path.
    function probeGeoShells(fig, verifyImport, verifyRecovery) {
        verifyImport=verifyImport===true;verifyRecovery=verifyRecovery===true;
        if(verifyRecovery)verifyImport=true;
        frameGuard();assertNoPending(fig);
        if(typeof fig.getNumGraftFigures!=="function"||typeof fig.getGraftFigure!=="function")
            throw problem("GEO_PROBE_API","This DAZ build does not expose graft enumeration on the selected figure.");
        var grafts=[],graftCount=Number(fig.getNumGraftFigures());
        if(!isFinite(graftCount)||graftCount<0||graftCount>128)
            throw problem("GEO_PROBE_GRAFT_LIST","Unexpected graft count on selected figure.");
        var parentNames={},parentSnap=materials(fig).surfaces;
        for(var pi=0;pi<parentSnap.length;pi++)
            parentNames["$"+String(parentSnap[pi].name).toLowerCase()]=true;
        for(var g=0;g<graftCount;g++){
            var graft=fig.getGraftFigure(g);if(!graft)continue;
            var snap=materials(graft),names={},raw=[];
            for(var j=0;j<snap.surfaces.length;j++){
                var name=String(snap.surfaces[j].name||"");if(!name)continue;
                var lower=name.toLowerCase();names["$"+lower]=true;raw.push(name);
            }
            grafts.push({node:graft,name:String(graft.getLabel?graft.getLabel():graft.getName()),names:names,materials:raw});
        }
        log("INFO","GEO_PROBE_GRAFTS","Count="+grafts.length+
            " | parent surfaces="+Object.keys(parentNames).length);
        for(var gi=0;gi<grafts.length;gi++)
            log("INFO","GEO_PROBE_GRAFT","index="+gi+" | label="+grafts[gi].name+
                " | material names="+grafts[gi].materials.join(", "));
        var found=0,exported=0,skipped=0,ambiguous=0,baseExcluded=0,all=sceneNodes();
        for(var i=0;i<all.length;i++){
            var shell=all[i];if(!shell||typeof shell.inherits!=="function"||!shell.inherits("DzGeometryShellNode"))continue;
            var target=null;try{target=typeof shell.getTarget==="function"?shell.getTarget():null;}catch(e){}
            if(!target||!same(target,fig))continue;
            found++;
            var shellSnapshot=materials(shell),selectedByGraft=[],ambiguousNames=[],parentExcluded=[],unmatched=[];
            for(var k=0;k<grafts.length;k++)selectedByGraft[k]=[];
            for(var si=0;si<shellSnapshot.surfaces.length;si++){
                var surface=String(shellSnapshot.surfaces[si].name||""),lower=surface.toLowerCase();
                if(!surface)continue;
                // An identically named surface on the parent is not a graft-
                // added surface, even if a graft also has an "Arms" material.
                if(parentNames["$"+lower]){parentExcluded.push(surface);baseExcluded++;continue;}
                var owners=[];
                for(var gidx=0;gidx<grafts.length;gidx++){
                    var graftNames=Object.keys(grafts[gidx].names),hit=false;
                    for(var nm=0;nm<graftNames.length;nm++){
                        var suffix=graftNames[nm].slice(1);
                        if(lower===suffix ||
                           (lower.length>suffix.length+1 && lower.slice(-(suffix.length+1))==="_"+suffix)){
                            hit=true;break;
                        }
                    }
                    if(hit)owners.push(gidx);
                }
                if(owners.length===1)selectedByGraft[owners[0]].push(surface);
                else if(owners.length>1){ambiguousNames.push(surface);ambiguous++;}
                else unmatched.push(surface);
            }
            log("INFO","GEO_PROBE_SHELL","name="+String(shell.getName?shell.getName():shell.name)+
                " | label="+String(shell.getLabel())+" | surfaces="+shellSnapshot.surfaces.length+
                " | baseExcluded="+parentExcluded.join(", ")+
                " | ambiguous="+ambiguousNames.join(", ")+" | unmatched="+unmatched.join(", "));
            // No native import until a full native backup has been written,
            // including unrelated surfaces. Some shaders have unreadable fields;
            // report that limitation rather than misrepresenting verification.
            // The backup is deliberately kept in Logs for manual recovery.
            var fullBackup="",probeBaseline=null,hasSubsets=false;
            for(var sg=0;sg<grafts.length;sg++)if(selectedByGraft[sg].length)hasSubsets=true;
            if(verifyImport&&hasSubsets){
                probeBaseline=materials(shell);
                if(probeBaseline.skipped>0)log("WARN","GEO_IMPORT_PROBE_PARTIAL_COVERAGE",
                    String(shell.getLabel())+" | unreadable/non-scalar fields="+probeBaseline.skipped+
                    " | all EXPOSED readable values will be checked, but complete shader equivalence cannot be certified.");
                var allSurfaceNames=[];
                for(var bs=0;bs<probeBaseline.surfaces.length;bs++)
                    allSurfaceNames.push(probeBaseline.surfaces[bs].name);
                if(!allSurfaceNames.length)throw problem("GEO_IMPORT_PROBE_NO_BASELINE","GeoShell has no surfaces to back up.");
                fullBackup=exportProbeGeoShellMaterials(shell,allSurfaceNames,String(i)+"_full_backup");
                log("PASS","GEO_IMPORT_PROBE_BACKUP",String(shell.getLabel())+
                    " | surfaces="+allSurfaceNames.length+" | file="+fullBackup);
            }
            for(var cg=0;cg<grafts.length;cg++){
                var subset=selectedByGraft[cg];
                log("INFO","GEO_PROBE_GRAFT_SURFACES","shell="+String(shell.getLabel())+
                    " | graft="+grafts[cg].name+" | selected="+subset.join(", ")+
                    " | count="+subset.length);
                if(!subset.length){skipped++;continue;}
                var file=exportProbeGeoShellMaterials(shell,subset,String(i)+"_g"+String(cg));
                log("PASS","GEO_PROBE_GRAFT_PARTIAL_EXPORTED",
                    String(shell.getLabel())+" | graft="+grafts[cg].name+
                    " | selected="+subset.length+" | file="+file+" | no scene materials modified by export");
                exported++;
                if(verifyImport&&fullBackup)
                    verifyGeoShellPartialImport(shell,file,fullBackup,probeBaseline,grafts[cg].name,subset,verifyRecovery);
            }
        }
        if(!found)log("WARN","GEO_PROBE_NO_SHELLS","No GeoShell with getTarget() equal to the selected figure was found. No changes made.");
        if(ambiguous)log("WARN","GEO_PROBE_AMBIGUOUS","Skipped "+ambiguous+
            " ambiguous surface occurrence(s). These will NOT be assigned to any graft automatically.");
        ctx.outcome="Per-GeoGraft GeoShell "+(verifyRecovery?"CHANGED-VALUE recovery":(verifyImport?"selective import integrity":"export"))+" probe: "+
            grafts.length+" graft(s), "+found+" target GeoShell(s), "+exported+" partial preset(s), "+
            skipped+" graft/shell pairs without matches, "+ambiguous+" ambiguous, "+baseExcluded+
            " base-surface exclusions. "+(verifyImport?
            verifyRecovery?"Controlled numeric material changes were restored using native partial presets, checked against all exposed surface fields; see GEO_RECOVERY_PROBE_* records. Unreadable shader fields are NOT certified. This does NOT exercise GeoGraft detach/return.":"In-place native imports of same-state partial presets were checked against all readable surface fields; see GEO_IMPORT_PROBE_* records. Unreadable shader fields are NOT certified. This does NOT prove restoration of deliberately changed materials.":
            "No wardrobe item or material was changed.");
    }
    // v0.9.10.2: Validate native partial DUF import on an EXISTING GeoShell.
    // The scene starts and should finish with identical material values.
    // This proves import selectivity/integrity, NOT restoration after graft removal.
    function importProbePreset(shell,path){
        if(!readable(path))throw problem("GEO_IMPORT_PROBE_FILE","Missing native partial preset: "+path);
        var content=App.getContentMgr();
        if(!content||typeof content.openFile!=="function")
            throw problem("GEO_IMPORT_PROBE_LOADER","DzContentMgr.openFile unavailable.");
        var held=false;
        try{
            beginNodeSelectionHold();held=true;
            Scene.selectAllNodes(false);Scene.setPrimarySelection(shell);
            var loaded=content.openFile(path,true);
            log(loaded===true?"PASS":"FAIL","GEO_IMPORT_PROBE_NATIVE_LOAD",
                String(shell.getLabel())+" | file="+path+" | result="+String(loaded));
            if(loaded!==true)throw problem("GEO_IMPORT_PROBE_LOAD","Native partial material import returned "+String(loaded));
        }finally{if(held)restoreNodeSelectionHold();}
        try{Scene.update();}catch(ignoreSceneUpdate){}
    }

    // v0.9.10.3: Controlled material-change test. Only numerical shader channels
    // in the currently SELECTED graft-added surface are eligible. Do not change
    // UVs, texture maps, visibility, displacement, render priorities or topology.
    // The entire shell has a verified native backup before this is called.
    function geoRecoveryProbeMutate(shell,selectedSurface) {
        var obj=shell.getObject(),shape=obj?obj.getCurrentShape():null;
        if(!shape)throw problem("GEO_RECOVERY_PROBE_SHAPE","Selected GeoShell has no current shape.");
        var mats=shape.getAllMaterials(),m=null;
        for(var i=0;i<mats.length;i++)if(String(mats[i].name)===String(selectedSurface)){m=mats[i];break;}
        if(!m)throw problem("GEO_RECOVERY_PROBE_SURFACE","The selected surface disappeared before the mutation test.");
        var props=m.getPropertyList(),preferred=["Diffuse Strength","Glossy Roughness","Glossiness","Diffuse Weight","Glossy Weight","Metallic Weight"];
        for(var p=0;p<preferred.length;p++)for(var j=0;j<props.length;j++){
            var prop=props[j];if(String(prop.name)!==preferred[p]&&String(prop.getLabel?prop.getLabel():"")!==preferred[p])continue;
            if(typeof prop.getValue!=="function"||typeof prop.setValue!=="function")continue;
            var original;
            try{original=prop.getValue();}catch(readError){continue;}
            if(typeof original!=="number"||!isFinite(original))continue;
            var minimum=0,maximum=1;
            try{if(typeof prop.getMin==="function")minimum=Number(prop.getMin());}catch(ignoreMin){}
            try{if(typeof prop.getMax==="function")maximum=Number(prop.getMax());}catch(ignoreMax){}
            if(!isFinite(minimum)||!isFinite(maximum)||maximum-minimum<0.00001)continue;
            var trial=minimum+(maximum-minimum)*(original<minimum+(maximum-minimum)*0.5?0.7:0.3);
            if(Math.abs(trial-original)<0.0001)trial=minimum+(maximum-minimum)*0.9;
            if(Math.abs(trial-original)<0.0001)continue;
            try{prop.setValue(trial);}catch(writeError){continue;}
            var current;
            try{current=Number(prop.getValue());}catch(verifyError){current=NaN;}
            if(!isFinite(current)||Math.abs(current-original)<0.0001)continue;
            log("INFO","GEO_RECOVERY_PROBE_MUTATION",String(shell.getLabel())+
                " | surface="+selectedSurface+" | property="+String(prop.name)+
                " | before="+original+" | changed="+current);
            return {surface:String(selectedSurface),property:String(prop.name),before:original,changed:current};
        }
        throw problem("GEO_RECOVERY_PROBE_NO_CHANNEL","No suitable writable numeric material channel in "+String(selectedSurface)+". Test stopped; shell backup retained.");
    }
    function verifyGeoShellPartialImport(shell,partial,backup,before,graftName,surfaceNames,verifyRecovery){
        var attempted=false;
        try{
            if(verifyRecovery){
                // Baseline was captured before ANY mutation. A complete native
                // backup also exists in Logs in case DAZ cannot restore.
                attempted=true;
                var mutation=geoRecoveryProbeMutate(shell,surfaceNames[0]);
                var changed=materials(shell),preDiff=materialDifferences(before.surfaces,changed.surfaces);
                if(!preDiff.length||closeNumbers(before,changed))
                    throw problem("GEO_RECOVERY_PROBE_UNCHANGED","Mutation did not produce a measurable shader difference.");
            }
            attempted=true;
            importProbePreset(shell,partial);
            var after=materials(shell),unchanged=closeNumbers(before,after),diffs=materialDifferences(before.surfaces,after.surfaces);
            log(unchanged?"PASS":"FAIL","GEO_IMPORT_PROBE_SURFACE_CHECK",
                String(shell.getLabel())+" | graft="+graftName+" | selected="+surfaceNames.join(", ")+
                " | all="+before.surfaces.length+" | unchanged="+unchanged+
                " | differences="+diffs.length+" | beforeSkipped="+before.skipped+
                " | afterSkipped="+after.skipped);
            if(verifyRecovery)log(unchanged?"PASS":"FAIL","GEO_RECOVERY_PROBE_RESTORED",
                String(shell.getLabel())+" | graft="+graftName+
                " | changedSurface="+mutation.surface+" | property="+mutation.property+
                " | selected="+surfaceNames.join(", ")+" | all="+before.surfaces.length+
                " | differences="+diffs.length+" | restored="+unchanged);
            if(!unchanged){
                for(var d=0;d<Math.min(10,diffs.length);d++)
                    log("FAIL","GEO_IMPORT_PROBE_DIFF",JSON.stringify(diffs[d]));
                throw problem("GEO_IMPORT_PROBE_CHANGED","Partial import altered saved GeoShell material state. See GEO_IMPORT_PROBE_DIFF.");
            }
        }catch(e){
            if(attempted){
                try{
                    importProbePreset(shell,backup);
                    var recovered=materials(shell);
                    if(!closeNumbers(before,recovered))throw problem("GEO_IMPORT_PROBE_ROLLBACK_MISMATCH",
                        "Full native backup did not recover all visible material values.");
                    log("PASS","GEO_IMPORT_PROBE_ROLLBACK",String(shell.getLabel())+
                        " | restored before-state from "+backup);
                }catch(recoveryError){
                    log("FAIL","GEO_IMPORT_PROBE_ROLLBACK",String(shell.getLabel())+
                        " | original="+errorText(e)+" | rollback="+errorText(recoveryError)+
                        " | backup retained="+backup);
                    throw problem("GEO_IMPORT_PROBE_UNSAFE", "Native partial import failed and rollback could not be verified. Reopen the saved pre-probe scene. Backup at "+backup);
                }
            }
            throw e;
        }
    }
    function exportProbeGeoShellMaterials(shell, surfaceNames, serial, persistentRelative, backupSplitAllowed) {
        if(!surfaceNames||!surfaceNames.length)throw problem("GEO_PROBE_NO_SURFACES","Nothing selected for export.");
        var mgr=App.getAssetIOMgr(),index=mgr.findAssetFilterIndex("DzMaterialAssetFilter");
        if(index<0)throw problem("GEO_PROBE_FILTER","DzMaterialAssetFilter is unavailable.");
        var filter=mgr.getAssetFilter(index),options=new DzFileIOSettings(),held=false;
        if(!filter)throw problem("GEO_PROBE_FILTER","Failed to obtain native material filter.");
        var nodeLabel=String(shell.getLabel()),nodes=sceneNodes(),sameLabel=0;
        for(var ni=0;ni<nodes.length;ni++)if(String(nodes[ni].getLabel())===nodeLabel)sameLabel++;
        if(sameLabel!==1)throw problem("GEO_PROBE_LABEL","GeoShell label is not unique; refusing to select an ambiguous native export target.");
        if(persistentRelative){
            validateNativeMaterialPresetRelative(persistentRelative);
            mkdir(inLibrary("Materials"));
        }
        var root=persistentRelative?inLibrary(persistentRelative).slice(0,-4):
            String(ctx.directory)+"/geoshell_partial_"+String(ctx.id).replace(/[^a-zA-Z0-9_]/g,"_")+
            "_"+String(serial)+"_"+String(shell.getName?shell.getName():shell.name).replace(/[^a-zA-Z0-9_]/g,"_").slice(0,36);
        var path=root+".duf";
        if(pathExists(path))throw problem("GEO_PROBE_OUTPUT","Diagnostic file unexpectedly exists: "+path);
        try{
            beginNodeSelectionHold();held=true;Scene.selectAllNodes(false);Scene.setPrimarySelection(shell);
            filter.getDefaultOptions(options);options.setStringValue("RootLabel",nodeLabel);
            if(!filter.getOptions(options,false,""))throw problem("GEO_PROBE_OPTIONS","Native filter options unavailable.");
            clearSetting(options,"MaterialNames");clearSetting(options,"NodeNames");
            var materialOpts=options.setSettingsValue("MaterialNames");
            var obj=shell.getObject(),shape=obj?obj.getCurrentShape():null;
            if(!shape)throw problem("GEO_PROBE_SHAPE","GeoShell has no current shape.");
            var mats=shape.getAllMaterials(),selected={};
            for(var t=0;t<surfaceNames.length;t++)selected["$"+String(surfaceNames[t])]=false;
            var selectedCount=0;
            for(var a=0;a<mats.length;a++){
                var mat=mats[a],matName=String(mat.name);
                if(!Object.prototype.hasOwnProperty.call(selected,"$"+matName))continue;
                selected["$"+matName]=true;selectedCount++;
                var surfaceOptions=materialOpts.setSettingsValue(matName),props=mat.getPropertyList(),seen={},slot=0;
                for(var k=0;k<props.length;k++){
                    var prop=props[k],propName=String(prop.name||""),label=String(prop.getLabel()||"");
                    var aliases=[propName];if(label&&label!==propName)aliases.push(label);
                    var mappable=false;try{mappable=typeof prop.isMappable==="function"&&prop.isMappable()===true;}catch(ignoreMap){}
                    for(var h=0;h<aliases.length;h++){
                        var selector=aliases[h];if(!selector||seen["$"+selector])continue;
                        seen["$"+selector]=true;
                        if(!mappable)surfaceOptions.setStringValue(String(slot++),selector);
                        else{
                            var keyed=surfaceOptions.setSettingsValue(String(slot++));keyed.setStringValue("name",selector);
                            var sub=keyed.setSettingsValue("subitems");sub.setStringValue("0","Value");sub.setStringValue("1","Image");
                        }
                    }
                }
            }
            if(selectedCount!==surfaceNames.length)throw problem("GEO_PROBE_SELECTION","Some selected graft surfaces disappeared before export.");
            options.setStringValue("RootLabel",nodeLabel);
            options.setBoolValue("OmitDefinitions",false);options.setBoolValue("CompressOutput",false);
            options.setBoolValue("RunSilent",true);
            var err=mgr.doSaveWithOptions(filter,options,true,root,app.libraryPath,"");
            if(Number(err)!==0||!readable(path))throw problem("GEO_PROBE_SAVE","Native partial save failed: "+String(err));
            var json=JSON.parse(readText(path).replace(/^\uFEFF/,""));
            if(!json.asset_info||!/material/i.test(String(json.asset_info.type)))throw problem("GEO_PROBE_DUF_TYPE","Export is not a material asset.");
            if(!Array.isArray(json.material_library))throw problem("GEO_PROBE_DSON","No material_library in native output.");
            var exportedNames={},requestedNames={},actualNames=[];
            for(var ei=0;ei<json.material_library.length;ei++){
                var entry=json.material_library[ei];
                if(!entry||typeof entry.id!=="string")throw problem("GEO_PROBE_DSON","Unrecognised material_library entry.");
                exportedNames["$"+entry.id]=true;actualNames.push(entry.id);
            }
            for(var ri=0;ri<surfaceNames.length;ri++)requestedNames["$"+surfaceNames[ri]]=true;
            var expectedKeys=Object.keys(requestedNames),actualKeys=Object.keys(exportedNames);
            var exact=expectedKeys.length===actualKeys.length;
            for(var ai=0;ai<expectedKeys.length;ai++)if(!exportedNames[expectedKeys[ai]])exact=false;
            log(exact?"PASS":(backupSplitAllowed===true?"WARN":"FAIL"),"GEO_PROBE_EXPORT_COVERAGE",
                "requested="+surfaceNames.join(", ")+" | DSON material_library="+actualNames.join(", ")+
