    }

    function materials(node) {
        var token = profileBegin("materials");
        try { return materialsImpl(node); }
        finally { profileEnd(token); }
    }
    function materialsImpl(node) {
        // Within one read scope, overlapping Worn-set diagnostics repeatedly
        // ask for the same garment surfaces. Cache the immutable snapshot only
        // for this scope; callers always receive a plain clone.
        if (readScope && node) {
            var materialKey = key(node);
