        if (!resolved) return resolvedTransformBundle(n, keepHandles, timing);
        var values = [], handles = resolved.handles;
        try {
            for (var i = 0; i < handles.length; i++) {
                var stamp = timing ? new Date().getTime() : 0;
                var v = Number(handles[i].getValue());
                if (timing) { timing.evaluatedMs += Math.max(0, new Date().getTime() - stamp); timing.controls++; }
                if (!isFinite(v)) throw new Error("Non-finite transform on " + n.getLabel() + " / " + resolved.methods[i]);
                values.push({method:resolved.methods[i],value:v});
            }
            if (rec.serial !== resolved.serial) throw problem("CHANNEL_LAYOUT_CHANGED_DURING_READ", n.getLabel());
            bulkStat("bulkSnapshots"); bulkStat("bulkEvaluatedReads", values.length);
