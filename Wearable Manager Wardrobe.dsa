            checkedID(id, "Figure ID"); var found = findData("FigureID", id);
            if (found.length !== 1 || !same(found[0], n)) throw problem("DUPLICATE_FIGURE_ID", n.getLabel() + ". Independently load the second figure; do not duplicate tagged figures in this prototype.");
            uniqueNodeID(n, false); return id;
