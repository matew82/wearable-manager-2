    }
    function frameGuard() {
        if (!ctx) return;
        if (ctx.frame !== null && Number(Scene.getFrame()) !== ctx.frame) throw problem("FRAME_CHANGED", "Do not change the timeline during an operation.");
        if (typeof Scene.isPlaying === "function" && Scene.isPlaying()) throw problem("PLAYBACK", "Stop timeline playback before operating the wardrobe.");
        if (ctx.target && !live(key(ctx.target))) throw problem("FIGURE_MISSING", "The selected figure left the scene.");
    }
    function log(status, code, message) {
        var line = "[" + status + "] " + code + " - " + String(message);
        print(line);
        if (!ctx) { app.lines.push(line); return; }
        ctx.lines.push(line); ctx.results.push({status: status, code: code, message: String(message)});
        if (ctx.logPath && !ctx.logBroken) {
            try { writeText(ctx.logPath, line + "\n", true); }
            catch (e) { ctx.logBroken = true; ctx.lines.push("[FAIL] LOG_WRITE - " + e); ctx.results.push({status: "FAIL", code: "LOG_WRITE", message: String(e)}); }
        }
    }
    function must(ok, code, text) {
        log(ok ? "PASS" : "FAIL", code, text);
        if (!ok) { var e = problem(code, text); e.recorded = true; throw e; }
    }
    function warnOnce(code, text) { if (!own(ctx.warned, code)) { ctx.warned[code] = true; log("WARN", code, text); } }
    function errorText(e) { return String(e) + (e.lineNumber ? " | line " + e.lineNumber : "") + (e.stack ? "\n" + e.stack : ""); }
    // Keep full diagnostics in the DAZ Log; dialogs show only readable guidance.
    function userErrorText(e) {
        try{print(TITLE+" / UI_ERROR - "+errorText(e));}catch(ignoreLog){}
        var code=String(e&&e.code||"");
        if(code==="FIGURE_ICON_RENDER"||code==="SET_ICON_RENDER")return "Render was not created.";
        if(code==="DUPLICATE_NODE_ID"||code==="DUPLICATE_FIGURE_ID"||code==="AMBIGUOUS_REFERENCE")
            return "Wardrobe found conflicting scene identities. The operation cannot continue safely. Technical details are in the DAZ Log.";
        var message=String(e&&e.message||e||"").replace(/^Error:\s*/,"");
        if(code&&message.indexOf(code+":")===0)message=message.slice(code.length+1).replace(/^\s+/,"");
        // Native exceptions, stacks and serialized diagnostics are not UI text.
        if(!code||message.length>400||/file:\/\/|\n|\r|\| line |\{/.test(message))
            return "The operation could not be completed. Technical details are in the DAZ Log.";
        return message||"The operation could not be completed. Technical details are in the DAZ Log.";
    }
    function compositeDialogError(e){
        var code=String(e&&e.code||"");
        if(code.indexOf("COMPOSITE_")!==0 && code!=="ITEM_HIERARCHY")return false;
        print(TITLE+" / COMPOSITE_DIAGNOSTIC - "+errorText(e));
        var message="";
        if(code==="COMPOSITE_INSTANCE_SPLIT"||code==="COMPOSITE_INSTANCE_DUPLICATE")
            message="A previously registered child still exists outside this wearable. " +
                "Remove it from the test scene or return it to its original parent, then try again.";
        else if(code==="COMPOSITE_FOREIGN")
            message="This wearable contains a child already registered elsewhere. " +
                "Use an unregistered child or detach the other registered item.";
        else if(code==="COMPOSITE_MISSING_DEPENDENCY"||code==="COMPOSITE_LINK_CHANGED")
            message="A saved parent, Fit To, or shell link is no longer valid. " +
                "Restore the original link before creating a new variant.";
        else if(code==="COMPOSITE_DEFERRED_MATERIALS")
            message="Some GeoShell materials are still pending restoration. " +
                "Restore them before changing this wearable's composition.";
        else if(code==="COMPOSITE_ACTIVE_OVERRIDE")
            message="This wearable has active Property Overrides. Choose Reset and Create Variant to reset them safely.";
        else if(code==="COMPOSITE_OVERRIDE_PART")
            message="A saved Override points to a child that cannot be verified. Restore the original child, then try again.";
        else if(code==="COMPOSITE_PENDING")
            message="An earlier Wardrobe operation is unfinished. Reload the saved pre-operation scene.";
        else if(code==="COMPOSITE_CHANGED")
            message="The wearable hierarchy changed while the dialog was open. Reopen Set Editor and try again.";
        else if(code==="ITEM_HIERARCHY"||code==="COMPOSITE_PART_MISSING")
            message="This registered wearable has different child items than its saved definition. " +
                "Use Create New Variant when prompted, or restore its original children.";
        else message="The composite wearable cannot be registered safely: "+
            String(e&&e.message||e).replace(/^[A-Z_]+:\s*/,"");
        MessageBox.warning(message+"\n\nNo wearable definition or Set was changed. " +
            "Technical details are in the DAZ Log.",TITLE+" - Wearable Hierarchy","&OK");
        return true;
    }

    function audit(action, itemID, n, detail) {
        ctx.operations.push({action: action, itemID: itemID || "", nodeID: n ? value(n, "NodeID") : "", runtimeKey: key(n), detail: detail || ""});
    }
    function nonBones(root) {
        var nodes = [root].concat(root.getNodeChildren(true)), out = [];
        for (var i = 0; i < nodes.length; i++) {
            if (isFigure(nodes[i])) throw problem("NESTED_FIGURE", "Wearable hierarchy contains a human figure.");
            if (!nodes[i].inherits("DzBone")) out.push(nodes[i]);
        }
        return out;
    }
    function foreignDataGuard(root, exporting) {
        var nodes = [root].concat(root.getNodeChildren(true));
        for (var i = 0; i < nodes.length; i++) {
            if (nodes[i].findDataItem("matewWardrobeCoreProbe_v1") || nodes[i].findDataItem("matewWardrobeSwitchProbe_v1"))
                throw problem("PROBE_DATA", "Use original source clothes, not retained copies from diagnostic probes: " + nodes[i].getLabel());
            // Previous use by WM is not a conflict. Export temporarily detaches
            // its data item and restores the exact same object in finally.
            var foreign=nodes[i].findDataItem("MatewWearables");
            if(foreign){
                var saved=foreign.getSettings();
                if(!saved)throw problem("FOREIGN_RECOVERY","Wearable Manager metadata is unreadable. Recover the item in that manager first.");
                var fields=["Target","Target_NodeID","Collision_Item","Collision_Item_NodeID","FileName","UV"];
                for(var f=0;f<fields.length;f++)if(saved.getStringValue(fields[f],""))
                    throw problem("FOREIGN_RECOVERY","Wearable Manager recovery is still pending for "+nodes[i].getLabel()+". Return/recover it in that manager before using Wardrobe.");
            }
        }
    }
    function candidates(fig) {
        var all = sceneNodes(), out = [];
        for (var i = 0; i < all.length; i++) {
            var n = all[i], p = n.getNodeParent();
            if (same(n, fig) || n.inherits("DzBone") || isFigure(n) || wm2ProtectedChild(n,fig)) continue;
            if (same(p, fig) || same(boneOwner(p), fig) || (!p && same(follow(n), fig))) out.push(n);
        }
        out.sort(function (a, b) { return String(a.getLabel()).localeCompare(String(b.getLabel())); }); return out;
    }
    function portableRef(n, fig, parts) {
        if (!n) return {kind: "none"};
