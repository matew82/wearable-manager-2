        profileCount("metadataNativeReads", 1);
        var d = n ? n.findDataItem(DATA) : null;
        if (!d) return null;
        if (typeof d.getSettings !== "function") throw problem("DATA_TYPE", "Unexpected own data type on " + n.getLabel());
        var s = d.getSettings(), out = {};
        for (var i = 0; i < s.getNumValues(); i++) {
            var k = String(s.getKey(i));
