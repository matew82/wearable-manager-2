            var ix = bulkPropertyIndex(n), bindings = [], seen = {};
            for (var i = 0; i < bundle.handles.length; i++) {
                var p = bundle.handles[i], name = p ? p.name : "", k = "$" + name;
                if (own(seen,k)) throw problem("BULK_REPEATED_ACCESSOR_NAME", String(name));
