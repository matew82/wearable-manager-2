    function disconnectDescriptorRegistry(registry) {
        if (!registry) return;
        var ids = Object.keys(registry), map = {}, nodes, i, rec;
        // Disable callbacks FIRST; even a failed disconnect can no longer act.
        for (i = 0; i < ids.length; i++) { rec = registry[ids[i]]; rec.alive = false; rec.bindings = null; }
        nodes = Scene.getNodeList();
        for (i = 0; i < nodes.length; i++) map[key(nodes[i])] = nodes[i];
        for (i = 0; i < ids.length; i++) {
            rec = registry[ids[i]]; var node = map[ids[i]];
            if (!node) continue; // destroyed senders disconnect natively
            for (var j = 0; j < rec.connected.length; j++) {
