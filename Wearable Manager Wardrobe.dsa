            else log("INFO","CHANNEL_BINDINGS_"+code,"No certified node bindings to audit; direct-reader fallback is not reported as bulk success.");
        } finally { profileEnd(token); }
    }

    function releaseBulkBindings() {
        if (!ctx || !ctx.bulkBindings) return;
        var registry = ctx.bulkBindings, nodes = Scene.getNodeList(), map = {}, ids = Object.keys(registry);
        for (var a = 0; a < nodes.length; a++) map[key(nodes[a])] = nodes[a];
        for (var i = 0; i < ids.length; i++) {
