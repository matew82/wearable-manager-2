        entry.initialDrift = drift; entry.integrityDifferences = bad;
        entry.totalInterSampleDifferences = totalChanges; entry.stopReason = reason;
        entry.budgetMs = budget; entry.slowestSampleMs = maxSampleMs;
        entry.quietSamples = count; entry.finalBuildState = build;
        entry.quietElapsedMs = trace.length ? trace[trace.length-1].quietMs : 0;
        log("INFO", "OBSERVE_" + code, "observedStable=" + stable + "; samples=" + trace.length +
            "; policy=" + policy.id + "; elapsedMs=" + elapsed + "; drift=" + drift.length + "; interSampleChanges=" + totalChanges +
            "; quietSamples=" + count + "; quietMs=" + entry.quietElapsedMs + "; budgetMs=" + budget +
            "; slowestSampleMs=" + maxSampleMs + "; busy=" + build.busy.length + "; buildErrors=" + build.errors.length +
            "; stopReason=" + reason + ". Finite observation, not an all-jobs-complete guarantee.");
        if (!stable) log("INFO", "OBSERVE_BLOCKERS_" + code,
