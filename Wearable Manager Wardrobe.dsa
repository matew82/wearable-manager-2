    // https://docs.daz3d.com/public/software/dazstudio/4/referenceguide/scripting/api_reference/object_index/element_dz
    // https://docs.daz3d.com/public/software/dazstudio/4/referenceguide/scripting/api_reference/object_index/property_dz
    // This is owner-scoped semantic matching, NOT a C++ pointer/address assertion.
    // These names are CHANNEL names, never an identity for a wardrobe item/figure.
    function bulkOwnedDescriptor(n, p, expectedName, expectedClass) {
        if (!p) throw problem("BULK_CONTROL_MISSING", expectedName || "native accessor");
        var name = p.name;
        if (typeof name !== "string" || !name || (expectedName !== null && name !== expectedName))
            throw problem("BULK_CONTROL_NAME", "Expected " + expectedName + "; got " + String(name));
        if (typeof p.className !== "function" || String(p.className()) !== expectedClass)
            throw problem("BULK_CONTROL_CLASS", name + ": expected " + expectedClass);
        if (typeof p.getValue !== "function") throw problem("BULK_VALUE_API", name);
        if (typeof p.isUserProperty !== "function" || p.isUserProperty() !== false)
            throw problem("BULK_USER_PROPERTY", name + ": expected boolean false");
        if (typeof p.isAlias !== "function" || p.isAlias() !== false)
