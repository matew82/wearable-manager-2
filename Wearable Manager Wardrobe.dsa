    }

    function bulkPropertyIndex(n) {
        var t = new Date().getTime(), byName = {}, count = {}, privateCount = {};
        try {
            bulkStat("propertyListCalls");
            var list = n.getPropertyList();
            if (!list || typeof list.length !== "number") throw problem("BULK_PUBLIC_LIST", "Unreadable public property list");
            for (var i = 0; i < list.length; i++) {
                var p = list[i];
                if (!p) throw problem("BULK_PUBLIC_LIST", "Null property in public list");
                var k = "$" + String(p.name);
                count[k] = (count[k] || 0) + 1; byName[k] = p;
            }
            // A same-named private property would make owner+name alone ambiguous.
            // Enumerate afresh; no property-list or property-wrapper cache.
            if (typeof n.getPrivatePropertyList !== "function") throw problem("BULK_PRIVATE_LIST_API", "getPrivatePropertyList unavailable");
            bulkStat("privatePropertyListCalls");
            var priv = n.getPrivatePropertyList();
            if (!priv || typeof priv.length !== "number") throw problem("BULK_PRIVATE_LIST", "Unreadable private property list");
            for (var j = 0; j < priv.length; j++) {
                if (!priv[j]) throw problem("BULK_PRIVATE_LIST", "Null property in private list");
                var pk = "$" + String(priv[j].name);
                privateCount[pk] = (privateCount[pk] || 0) + 1;
            }
            return {list:list,byName:byName,count:count,privateCount:privateCount};
        } finally { bulkStat("propertyListAndIndexMs", Math.max(0, new Date().getTime() - t)); }
    }

    function bulkNativeProperty(p, expectedClass) {
        // Restrict reuse to non-user, non-alias native transform properties.
        // Unknown types/absence are a DIRECT-READER fallback, never zero values.
        return !!p && typeof p.getValue === "function" &&
            typeof p.className === "function" && String(p.className()) === expectedClass &&
            typeof p.isUserProperty === "function" && p.isUserProperty() === false &&
            typeof p.isAlias === "function" && p.isAlias() === false;
    }

    // v0.3.7: DzElement documents property-name uniqueness within an owner;
