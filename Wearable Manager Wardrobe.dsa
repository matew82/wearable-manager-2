    function directRaw(p) {
        if(typeof p.getRawValue !== "function") return {ok:false,reason:"getRawValue unavailable"};
        try { return {ok:true,value:p.getRawValue()}; }
        catch(e) { return {ok:false,reason:String(e)}; }
    }
    function directControllerCount(p) {
        if(typeof p.getNumControllers !== "function") return {ok:false,reason:"getNumControllers unavailable"};
        try { return {ok:true,value:p.getNumControllers()}; }
        catch(e) { return {ok:false,reason:String(e)}; }
    }
    function directLocked(p) {
        if(typeof p.isLocked !== "function") return {ok:false,reason:"isLocked unavailable"};
        try { return {ok:true,value:p.isLocked()}; }
        catch(e) { return {ok:false,reason:String(e)}; }
    }
    function storageChannelsDirect(n) {
        var timing=channelSampleStart(n,"full"), bundle=resolvedTransformBundle(n,true,timing);
        var values=bundle.values,handles=bundle.handles,result=[],t,raw,controllers,locked;
        try {
            // Keep the legacy ordering: all evaluated reads first, followed by
            // raw/controller/lock reads per channel. Only the duplicate node
            // accessor has been removed; no evaluated value is used as raw.
            for(var i=0;i<values.length;i++) {
                var v=values[i],p=handles[i];
                t=timing?new Date().getTime():0; raw=directRaw(p);
                if(timing) { timing.rawMs+=Math.max(0,new Date().getTime()-t); if(!raw.ok)timing.rawUnavailable++; }
                t=timing?new Date().getTime():0; controllers=directControllerCount(p);
                if(timing) { timing.controllerCountMs+=Math.max(0,new Date().getTime()-t); if(!controllers.ok)timing.controllerCountUnavailable++; }
                t=timing?new Date().getTime():0; locked=directLocked(p);
                if(timing) { timing.lockedMs+=Math.max(0,new Date().getTime()-t); if(!locked.ok)timing.lockedUnavailable++; }
                t=timing?new Date().getTime():0;
