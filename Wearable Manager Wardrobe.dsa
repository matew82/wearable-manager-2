        if(/^Genesis(?:3|8)/.test(type)){
            if(leaf==="r_hand")name="rHand";
            if(leaf==="l_hand")name="lHand";
        }else if(type==="Genesis9"){
            if(leaf==="rHand")name="r_hand";
            if(leaf==="lHand")name="l_hand";
        }
        if(!name)return null;
