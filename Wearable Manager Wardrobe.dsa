        channelSession.dirty = false; channelSession.context = context;
        ctx.bulkBindings = reuse; ctx.channelReuseEnabled = true; ctx.channelReuseContext = context;
        var count = Object.keys(reuse).length;
        ctx.diag.channelSession.enabled = true; ctx.diag.channelSession.reusedNodes = count;
        ctx.diag.channelSession.sceneEventsAtStart = channelSession.sceneEvents;
        bulkStat("sessionReusedNodes", count);
