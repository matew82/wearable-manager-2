    function materialDifferences(expected, actual) {
        var out = [];
        function add(surface, field, category, ep, e, ap, a) {
            var d = {surface: surface, field: field, category: category,
                expectedPresent: ep, actualPresent: ap,
                expectedType: materialType(e, ep), actualType: materialType(a, ap),
                expected: ep ? materialReportValue(e) : null, actual: ap ? materialReportValue(a) : null};
            if (ep && ap && typeof e === "number" && typeof a === "number" && isFinite(e) && isFinite(a)) {
                d.delta = a - e; d.allowedTolerance = 1e-5 * Math.max(1, Math.abs(e), Math.abs(a));
            }
            out.push(d);
        }
        if (!Array.isArray(expected) || !Array.isArray(actual)) {
            add("<snapshot>", "surfaces", "snapshot_schema", true, expected, true, actual); return out;
        }
        function index(list, side) {
            var map = {};
            for (var i = 0; i < list.length; i++) {
                var s = list[i];
                if (!s || typeof s.name !== "string") {
                    add("<snapshot>", side + "[" + i + "]", "surface_schema", side === "expected", s, side === "actual", s); continue;
                }
                var k = "$" + s.name;
                if (own(map, k)) add(s.name, "name", "duplicate_surface_" + side, true, "unique", true, "duplicate");
                map[k] = s;
            }
            return map;
        }
        var em = index(expected, "expected"), am = index(actual, "actual"), names = Object.keys(em), i;
        for (i = 0; i < names.length; i++) {
            var e = em[names[i]], ap = own(am, names[i]), a = ap ? am[names[i]] : null;
            if (!ap) { add(e.name, "surface", "missing_surface", true, e, false, null); continue; }
            if (!closeNumbers(e.uv, a.uv)) add(e.name, "UV Set", "uv", own(e,"uv"), e.uv, own(a,"uv"), a.uv);
            var ev = e.values, av = a.values;
            if (!ev || !av || typeof ev !== "object" || typeof av !== "object" || Array.isArray(ev) || Array.isArray(av)) {
                add(e.name, "values", "property_schema", true, ev, true, av); continue;
            }
            var fields = Object.keys(ev), f;
            for (f = 0; f < fields.length; f++) {
                var name = fields[f], present = own(av, name);
                if (present && closeNumbers(ev[name], av[name])) continue;
                var cat = !present ? "missing_property" : /\|map$/.test(name) ? "texture_path" :
                    materialType(ev[name],true) !== materialType(av[name],true) ? "value_type" : "value";
                add(e.name, name, cat, true, ev[name], present, av[name]);
            }
            fields = Object.keys(av);
            for (f = 0; f < fields.length; f++) if (!own(ev, fields[f]))
                add(e.name, fields[f], "extra_property", false, null, true, av[fields[f]]);
        }
        names = Object.keys(am);
        for (i = 0; i < names.length; i++) if (!own(em, names[i]))
            add(am[names[i]].name, "surface", "extra_surface", false, null, true, am[names[i]]);
        // The verdict remains the original sorted-array comparison. This fallback
        // also reports order/shape differences not captured by named-field diffs.
        if (!out.length && !closeNumbers(expected, actual))
            add("<snapshot>", "surfaces", "snapshot_layout", true, expected, true, actual);
        return out;
    }
    // v0.9.1 Material & Style Presets, phase 1. The catalog is already immutable
    // JSON, so each set embeds its own small per-item material baseline there.
    // Each item may be shared by many sets without mutating the registered item's
    // immutable DUF or its original import-verification material baseline.
    // Material & Style v0.9.2: native DAZ material presets are immutable
    // companions to the JSON read-only snapshots, NOT a replacement for them.
    // The catalog records an optional library-relative DUF only after a native
    // export succeeded. No native material preset is loaded during Apply.
    function validateNativeMaterialPresetRelative(rel) {
        if (typeof rel!=="string" || !/^Materials\/[a-zA-Z0-9_]+\.duf$/.test(rel))
            throw problem("MATERIAL_PRESET_PATH","Invalid native material preset location.");
        safeRelative(rel);return rel;
    }
    function validateSetMaterialSnapshots(raw,db,st) {
        if(raw===undefined||raw===null)return {};
        expectObject(raw,"Set material snapshots");
        var out={},ids=Object.keys(raw);
        if(ids.length>st.items.length)throw problem("MATERIAL_SCHEMA","More material items than set members.");
        for(var i=0;i<ids.length;i++){
            var id=ids[i],r=raw[id],item=db.items[id];
            if(st.items.indexOf(id)<0||!item)throw problem("MATERIAL_SCHEMA","Material snapshot references an item outside the set.");
            expectObject(r,"Material item snapshot");
            if(r.schemaVersion!==1||typeof r.captured!=="string"||!Array.isArray(r.parts)||r.parts.length!==item.parts.length)
                throw problem("MATERIAL_SCHEMA","Invalid material snapshot for "+item.name);
            var parts={},validated=[];
            for(var j=0;j<r.parts.length;j++){
                var rec=r.parts[j],part=null;
                expectObject(rec,"Material part");
                for(var k=0;k<item.parts.length;k++)if(item.parts[k].id===rec.partID)part=item.parts[k];
                if(!part||parts[rec.partID])throw problem("MATERIAL_SCHEMA","Unknown or repeated material part: "+rec.partID);
                parts[rec.partID]=true;
                expectObject(rec.snapshot,"Material values");
                if(!Array.isArray(rec.snapshot.surfaces)||typeof rec.snapshot.skipped!=="number"||
                    rec.snapshot.skipped<0||rec.snapshot.skipped!==Math.floor(rec.snapshot.skipped))
                    throw problem("MATERIAL_SCHEMA","Invalid material surfaces/skipped count.");
                var surfaces={},entries=rec.snapshot.surfaces;
                if(entries.length>500)throw problem("MATERIAL_SCHEMA","Too many material surfaces.");
                for(var e=0;e<entries.length;e++){
                    var mat=entries[e];expectObject(mat,"Material surface");
                    if(typeof mat.name!=="string"||!mat.name||surfaces["$"+mat.name]||typeof mat.uv!=="string")
                        throw problem("MATERIAL_SCHEMA","Invalid or duplicate material surface.");
                    surfaces["$"+mat.name]=true;
                    expectObject(mat.values,"Material parameter values");
                    var fields=Object.keys(mat.values);
                    if(fields.length>1000)throw problem("MATERIAL_SCHEMA","Too many material properties.");
                    for(var f=0;f<fields.length;f++){
                        var v=mat.values[fields[f]];
                        if(typeof v==="number"&&!isFinite(v))throw problem("MATERIAL_SCHEMA","Non-finite material scalar.");
                        if(Array.isArray(v)){
                            if(v.length!==4)throw problem("MATERIAL_SCHEMA","Malformed material color.");
                            for(var ci=0;ci<v.length;ci++)if(typeof v[ci]!=="number"||!isFinite(v[ci]))
                                throw problem("MATERIAL_SCHEMA","Malformed material color channel.");
                        }else if(typeof v!=="number"&&typeof v!=="string"&&typeof v!=="boolean")
                            throw problem("MATERIAL_SCHEMA","Unsupported material property value.");
                    }
                }
                validated.push({partID:rec.partID,snapshot:clonePlain(rec.snapshot)});
            }
            var saved={schemaVersion:1,captured:r.captured,parts:validated};
            if(own(r,"nativePreset"))saved.nativePreset=validateNativeMaterialPresetRelative(r.nativePreset);
            out[id]=saved;
        }
        return out;
    }
    function setMaterialSnapshots(st){return st&&st.materialSnapshots?st.materialSnapshots:{};}
    function hasSetMaterialSnapshots(st){return Object.keys(setMaterialSnapshots(st)).length>0;}
    function saveNativeMaterialPreset(item,inf,expectedRecord,allowUnverifiedSetCapture) {
        if(!inf||(inf.where!=="active"&&inf.where!=="stored")||!inf.root)
            throw problem("MATERIAL_PRESET_ITEM",item.name+": a registered active or stored scene instance is required.");
        // Prefer hierarchical material presets when the logical item includes
        // native non-bone child nodes. The ordinary filter is more predictable
        // for a simple one-node item.
        var filterClass=item.parts.length>1?"DzHierarchicalMaterialAssetFilter":"DzMaterialAssetFilter";
        var mgr=App.getAssetIOMgr(),idx=mgr.findAssetFilterIndex(filterClass);
        if(idx<0)throw problem("MATERIAL_PRESET_FILTER",filterClass+" is unavailable in this DAZ Studio version.");
        var filter=mgr.getAssetFilter(idx),options=new DzFileIOSettings(),held=false;
        if(!filter)throw problem("MATERIAL_PRESET_FILTER","Could not obtain "+filterClass);
        var root=inf.root,rootLabel=String(root.getLabel()),rel="Materials/"+unique("material")+".duf";
        validateNativeMaterialPresetRelative(rel);
        var folder=inLibrary("Materials"),path=inLibrary(rel),exported=false;
        mkdir(folder);
        if(pathExists(path))throw problem("MATERIAL_PRESET_EXISTS",path);
        try {
            // DAZ native filters identify their target by the primary scene
            // selection and RootLabel. Never permit an ambiguous selector.
            var nodes=sceneNodes(),duplicates=0;
            for(var n=0;n<nodes.length;n++)if(String(nodes[n].getLabel())===rootLabel)duplicates++;
            if(duplicates!==1)throw problem("MATERIAL_PRESET_SELECTOR",item.name+": non-unique node label "+rootLabel);
            beginNodeSelectionHold();held=true;
            Scene.selectAllNodes(false);Scene.setPrimarySelection(root);
            filter.getDefaultOptions(options);
            options.setStringValue("RootLabel",rootLabel);
            if(!filter.getOptions(options,false,""))throw problem("MATERIAL_PRESET_OPTIONS",item.name);
            // Discard remembered manual surface/property selections. No partial
            // subset is requested: DAZ should export the complete native preset.
            clearSetting(options,"MaterialNames");clearSetting(options,"NodeNames");
            // Name every logical, non-bone item part and every exposed surface.
            // Default preset options can remember a *partial* Surfaces Pane
            // selection. An explicit all-properties list avoids that problem.
            var selectedNodes=0,selectedSurfaces=0;
            for(var ip=0;ip<item.parts.length;ip++){
                var part=inf.parts[item.parts[ip].id];
                if(!part)throw problem("MATERIAL_PRESET_PART",item.name+": missing part "+item.parts[ip].id);
                var partObject=part.getObject(),shape=partObject?partObject.getCurrentShape():null;
                if(!shape)continue;
                part.select(true);
                var nodeSelector=String(part.getLabel());
                if(filterClass==="DzHierarchicalMaterialAssetFilter" &&
                   typeof App.version64==="number" && App.version64>=0x0004000a0000006f &&
                   typeof part.getSkeleton==="function"){
                    var skeleton=part.getSkeleton();
                    if(skeleton&&!same(skeleton,part))nodeSelector=String(skeleton.getLabel())+"::"+nodeSelector;
                }
                var allSurfaces=shape.getAllMaterials(),allOptions=filterClass==="DzHierarchicalMaterialAssetFilter"?
                    options.getSettingsValue("NodeNames"):options.getSettingsValue("MaterialNames");
                if(!allOptions)allOptions=options.setSettingsValue(filterClass==="DzHierarchicalMaterialAssetFilter"?"NodeNames":"MaterialNames");
                var nodeOptions=filterClass==="DzHierarchicalMaterialAssetFilter"?
                    allOptions.setSettingsValue(nodeSelector):allOptions;
                for(var si=0;si<allSurfaces.length;si++){
                    var surface=allSurfaces[si],surfaceOptions=nodeOptions.setSettingsValue(String(surface.name));
                    // DAZ Material(s) Preset: indexed entries for ordinary
                    // DzMaterialAssetFilter; property-name keys for hierarchical
                    // presets. For a mappable property explicitly export BOTH
                    // Value and Image. Simple string entries are documented as
                    // shorthand, but did not reliably retain every texture in
                    // some exported native presets.
                    // Some DAZ shader channels expose a UI label that differs
                    // from the internal property name (e.g. an Iray Base Color
                    // label for the Diffuse Color channel). The preset filter
                    // may resolve these by internal name. Emit both distinct
                    // identifiers rather than silently dropping those maps.
                    var properties=surface.getPropertyList(),propertyNames={},oi=0;
                    var aliasPairs=[];
                    for(var pi=0;pi<properties.length;pi++){
                        var prop=properties[pi],internalName=String(prop.name||"");
                        var label=String(prop.getLabel()||"");
                        var selectors=[];
                        if(internalName)selectors.push(internalName);
                        if(label && label!==internalName)selectors.push(label);
                        if(label && internalName && label!==internalName && aliasPairs.length<16)
                            aliasPairs.push(internalName+" => "+label);
                        var mappable=false;
                        try{mappable=typeof prop.isMappable==="function"&&prop.isMappable()===true;}
                        catch(ignoreMapCapability){}
                        for(var siName=0;siName<selectors.length;siName++){
                            var selector=selectors[siName];
                            if(own(propertyNames,"$"+selector))continue;
                            propertyNames["$"+selector]=true;
                            if(!mappable){
                                surfaceOptions.setStringValue(String(oi++),selector);
                            }else if(filterClass==="DzHierarchicalMaterialAssetFilter"){
                                var named=surfaceOptions.setSettingsValue(selector);
                                named.setStringValue("0","Value");named.setStringValue("1","Image");
                            }else{
                                var keyed=surfaceOptions.setSettingsValue(String(oi++));
                                keyed.setStringValue("name",selector);
                                var subitems=keyed.setSettingsValue("subitems");
                                subitems.setStringValue("0","Value");subitems.setStringValue("1","Image");
                            }
                        }
                    }
                    if(aliasPairs.length)log("INFO","MATERIAL_PRESET_PROPERTY_ALIASES",item.name+
                        " / "+String(surface.name)+" | "+aliasPairs.join("; "));
                    selectedSurfaces++;
                }
                selectedNodes++;
            }
            if(!selectedSurfaces)throw problem("MATERIAL_PRESET_EMPTY",item.name+": no material surfaces could be selected.");
            options.setStringValue("RootLabel",rootLabel);
            options.setBoolValue("OmitDefinitions",false);
            options.setBoolValue("CompressOutput",false);
            options.setBoolValue("RunSilent",true);
            var err=mgr.doSaveWithOptions(filter,options,true,path.slice(0,-4),app.libraryPath,"");
            if(Number(err)!==0||!readable(path))throw problem("MATERIAL_PRESET_SAVE",item.name+" / "+filterClass+" / error "+err);
            // Verify it is a parseable native material asset, not an empty file
            // or an accidentally exported wearable/scene preset.
            var document;
            try{document=JSON.parse(readText(path).replace(/^\uFEFF/,""));}
            catch(parseError){throw problem("MATERIAL_PRESET_INVALID",item.name+": "+String(parseError));}
            if(!document.asset_info||!/material/i.test(String(document.asset_info.type)))
                throw problem("MATERIAL_PRESET_TYPE",item.name+": native output is not a material preset.");
            if(expectedRecord){
                var coverage=nativeMaterialTextureAudit(rel,expectedRecord,item.name);
                if(coverage&&coverage.missing.length){
                    try{
                        if(typeof options.toJsonString==="function")
                            log("INFO","MATERIAL_PRESET_EXPORT_OPTIONS",item.name+" | "+String(options.toJsonString()).slice(0,12000));
                    }catch(ignoreOptionDiagnostics){}
                    // Filename scanning is an advisory heuristic, not a complete
                    // DSON image-reference resolver. A Save Set must never fail
                    // solely on an unconfirmed filename. Keep JSON independently.
                    // CRITICAL: transaction backups for Restore are strict: do NOT
                    // allow an unconfirmed native preset to be used for rollback.
                    if(allowUnverifiedSetCapture===true){
                        log("WARN","MATERIAL_PRESET_IMAGE_UNCONFIRMED",item.name+
                            " | missing by filename="+coverage.missing.join(", ")+
                            " | JSON snapshot will be saved, but this native preset will NOT be linked for Restore.");
                        log("INFO","MATERIAL_PRESET_DIAGNOSTIC_DUF",item.name+
                            " | "+path+" | unlinked diagnostic file; inspect its DSON before trusting export.");
                        // This immutable diagnostic output is intentionally kept.
                        // No set/revision points to it; no scene materials changed.
                        exported=true;
                        return "";
                    }
                    throw problem("MATERIAL_PRESET_MISSING_IMAGES",item.name+
                        ": native export has unconfirmed texture references; unsafe as a Restore rollback backup. "+
                        coverage.missing.join(", "));

                }
            }
            exported=true;
        } finally {
            if(held)restoreNodeSelectionHold();
            filter.deleteLater();
            // No catalog references a failed/new incomplete export; try to
            // remove only the unique file owned by this attempt.
            if(!exported&&pathExists(path))try{
                var discard=new DzFile(path);discard.remove();discard.deleteLater();
            }catch(cleanupError){log("WARN","MATERIAL_PRESET_ORPHAN",path+" | "+String(cleanupError));}
        }
        log("PASS","MATERIAL_NATIVE_SAVED",item.name+" | "+rel+" | filter="+filterClass);
        return rel;
    }
    function captureItemMaterials(item,inf){
        if(!inf||!inf.parts)throw problem("MATERIAL_CAPTURE_ITEM","Registered item must be present in this figure's scene.");
        var parts=[],skipped=0;
        for(var p=0;p<item.parts.length;p++){
            var part=item.parts[p],node=inf.parts[part.id];
            if(!node)throw problem("MATERIAL_CAPTURE_PART","Cannot find "+item.name+" part "+part.id);
            var snap=materials(node);skipped+=snap.skipped;
            parts.push({partID:part.id,snapshot:clonePlain(snap)});
        }
        return {record:{schemaVersion:1,captured:String(new Date()),parts:parts},skipped:skipped};
    }
    function diagnoseSetMaterials(st,fig){
        var configured=setMaterialSnapshots(st),ids=Object.keys(configured),result={setName:st.name,items:ids.length,
            matched:0,changed:[],unavailable:[],incomplete:[],absentDonorSurfaces:[]};
        if(!ids.length)return result;
        var inv=inventory(fig,app.db);
        for(var i=0;i<ids.length;i++){
            var id=ids[i],item=app.db.items[id],info=inv[id],saved=configured[id];
            if(!saved.nativePreset)
                result.unavailable.push(item.name+": JSON material snapshot saved; no verified native Restore preset is linked.");
            else if(!readable(inLibrary(saved.nativePreset)))
                result.unavailable.push(item.name+": native material preset is missing: "+saved.nativePreset);
            if(!info){result.unavailable.push(item.name+": registered instance is missing.");continue;}
            if(info.where!=="active"){
                result.unavailable.push(item.name+": stored in wardrobe; not currently worn.");continue;
            }
            var changed=false,incomplete=false;
            for(var p=0;p<saved.parts.length;p++){
                var part=saved.parts[p],node=info.parts[part.partID];
                if(!node){result.unavailable.push(item.name+": registered part missing: "+part.partID);changed=true;continue;}
                try{
                    var actual=materials(node),old=part.snapshot,diffs=materialDifferences(old.surfaces,actual.surfaces);
                    var topology=geoDonorOnlyShellSurfaces(node,fig,old,actual),absent={};
                    for(var gm=0;gm<topology.names.length;gm++)absent["$"+topology.names[gm]]=true;
                    var blocking=[];for(var gd=0;gd<diffs.length;gd++){
                        if(diffs[gd].category==="missing_surface"&&own(absent,"$"+diffs[gd].surface)){
                            result.absentDonorSurfaces.push(item.name+" / "+diffs[gd].surface);
                        }else blocking.push(diffs[gd]);
                    }
                    diffs=blocking;
                    if(old.skipped||actual.skipped){incomplete=true;result.incomplete.push(item.name+" / "+String(node.getLabel())+
                        ": unavailable material fields (saved="+old.skipped+", current="+actual.skipped+").");}
                    if(diffs.length){changed=true;
                        for(var d=0;d<Math.min(30,diffs.length);d++){
                            var diff=diffs[d];result.changed.push(item.name+" / "+String(node.getLabel())+" / "+
                                diff.surface+" / "+diff.field+" ("+diff.category+"): expected "+
                                JSON.stringify(diff.expected)+", current "+JSON.stringify(diff.actual));
                        }
                        if(diffs.length>30)result.changed.push(item.name+": ... "+(diffs.length-30)+" additional differences.");
                    }
                }catch(err){result.unavailable.push(item.name+": "+String(err));changed=true;}
            }
            if(!changed&&!incomplete)result.matched++;
        }
        return result;
    }
    function materialDiagnosticText(st,diag){
        var nativeCount=0,records=setMaterialSnapshots(st),ids=Object.keys(records);
        for(var q=0;q<ids.length;q++)if(records[ids[q]].nativePreset)nativeCount++;
        var out=["Set: "+st.name,"Material snapshots: "+diag.items,"Native DAZ presets: "+nativeCount,
            "Fully comparable and matching: "+diag.matched,
            "Differences: "+diag.changed.length,"Unavailable: "+diag.unavailable.length,
            "Incomplete reads: "+diag.incomplete.length,
            "Absent donor-only GeoShell surfaces (not compared): "+(diag.absentDonorSurfaces||[]).length];
        function lines(title,list){if(!list.length)return;out.push("",title);
            for(var i=0;i<Math.min(60,list.length);i++)out.push("- "+list[i]);
            if(list.length>60)out.push("... and "+(list.length-60)+" more.");}
        var exported=[];
        for(var n=0;n<ids.length;n++)if(records[ids[n]].nativePreset){
            var itemName=app.db.items[ids[n]]?app.db.items[ids[n]].name:ids[n];
            exported.push(itemName+" => "+records[ids[n]].nativePreset);
        }
        lines("Native DAZ material presets:",exported);
        lines("Changed material fields:",diag.changed);lines("Unavailable material checks:",diag.unavailable);
        lines("Incomplete material reads:",diag.incomplete);
        lines("Absent donor-only GeoShell surfaces:",diag.absentDonorSurfaces||[]);
        out.push("","This diagnostic does not change the scene. To restore a saved preset, use Materials... and choose a worn item.",
            "Some shader fields may be missing from JSON even though the native DUF retains them.");
        return out.join("\n");
    }


    // v0.9.3: Explicit one-item Material Restore. The JSON baseline is used
    // only for a post-load verification; the native DAZ .duf restores shader
    // definitions, images and fields that our read-only JSON cannot represent.
    function nativeMaterialRestoreToItem(item,inf,rel) {
        validateNativeMaterialPresetRelative(rel);
        var path=inLibrary(rel);
        if(!readable(path))throw problem("MATERIAL_RESTORE_PRESET_MISSING",item.name+": "+path);
        if(!inf||inf.where!=="active"||!inf.root)
            throw problem("MATERIAL_RESTORE_NOT_WORN",item.name+" must be worn before its material can be restored.");
        var scene=sceneNodes(),seenLabels={},selectedNodes=[];
        for(var i=0;i<item.parts.length;i++){
            var part=inf.parts[item.parts[i].id];
            if(!part)throw problem("MATERIAL_RESTORE_PART",item.name+" / "+item.parts[i].id);
            var nm=String(part.getLabel());
            if(own(seenLabels,"$"+nm))throw problem("MATERIAL_RESTORE_LABEL","Repeated item part label: "+nm);
            seenLabels["$"+nm]=true;
            var count=0;
            for(var j=0;j<scene.length;j++)if(String(scene[j].getLabel())===nm)count++;
            if(count!==1)throw problem("MATERIAL_RESTORE_LABEL",item.name+": part label is not unique: "+nm);
            selectedNodes.push(part);
        }
        // v0.9.3.6: Material presets are user-facing content assets. Use the
        // same high-level content pipeline as double-clicking a DUF in Content
        // Library, NOT DzAssetIOMgr.doLoad(): a zero DzError from that low-level
        // call does not guarantee the material was applied to selected nodes.
        // openFile(path, true) merges a preset with the CURRENT scene; never
        // replace the whole scene. Strict post-application material verification
        // and the existing native-preset rollback remain mandatory.
        var content=App.getContentMgr(),held=false;
        if(!content||typeof content.openFile!=="function")
            throw problem("MATERIAL_RESTORE_LOADER","DzContentMgr.openFile is unavailable.");
        try {
            beginNodeSelectionHold();held=true;
            Scene.selectAllNodes(false);Scene.setPrimarySelection(inf.root);
            for(var k=0;k<selectedNodes.length;k++)selectedNodes[k].select(true);
            // Reassert the saved root as primary after adding child parts.
            Scene.setPrimarySelection(inf.root);
            var opened=content.openFile(path,true);
            log(opened===true?"PASS":"FAIL","MATERIAL_RESTORE_NATIVE_LOAD",
                item.name+" | loader=DzContentMgr.openFile | merge=true | result="+String(opened)+" | preset="+rel);
            if(opened!==true)throw problem("MATERIAL_RESTORE_LOAD",item.name+": DzContentMgr.openFile returned "+String(opened));
        }finally{if(held)restoreNodeSelectionHold();}
    }
    // v0.9.3.2: Native DSON loading can represent an existing texture file via
    // a different path spelling. Accept equivalence ONLY after both references
    // resolve to the SAME existing canonical file. Identical basenames, missing
    // files, unrelated paths and blank maps never qualify for this exception.
    // Keep the ordinary read-only Material Diagnostics comparator unchanged.
    function materialCanonicalMapPath(raw) {
        if (typeof raw !== "string" || !raw) return {resolved: false, path: "", reason: "empty map path"};
        var file = null;
        try {
            if (typeof DzFileInfo !== "function")return {resolved: false, path: "", reason: "DzFileInfo unavailable"};
            var localPath = String(raw).replace(/\\/g, "/");
            // A file:// URL is a filesystem path only for local drive paths.
            // All other URI schemes remain unresolved and are never equated.
            if (localPath.toLowerCase().indexOf("file://")===0) {
                if (localPath.toLowerCase().indexOf("file:///")===0 && /^[A-Za-z]:\//.test(localPath.slice(8)))localPath=localPath.slice(8);
                else return {resolved: false, path: "", reason: "non-local file URL"};
            }
            file=new DzFileInfo(localPath);
            if (typeof file.exists !== "function" || !file.exists() ||
                typeof file.canonicalFilePath !== "function")
                return {resolved: false, path: "", reason: "file missing or canonical path unavailable"};
            var canonical=String(file.canonicalFilePath()).replace(/\\/g,"/");
            if (!canonical)return {resolved: false, path: "", reason: "canonical path empty"};
            return {resolved: true, path: canonical, reason: ""};
        } catch (err) {return {resolved: false, path: "", reason: errorText(err)};}
        finally {if(file && typeof file.deleteLater === "function")file.deleteLater();}
    }
    function materialMapSameExistingFile(expected,actual) {
        var left=materialCanonicalMapPath(expected),right=materialCanonicalMapPath(actual);
        if (!left.resolved || !right.resolved)return {match:false,left:left,right:right};
        var a=left.path,b=right.path;
        if (/^[A-Za-z]:\//.test(a) && /^[A-Za-z]:\//.test(b)) {
            a=a.toLowerCase();b=b.toLowerCase();
        }
        return {match:a===b,left:left,right:right};
    }
    // Cross-runtime UV Set IDs are enum ordinals, not portable semantic UV
    // identifiers. DAZ 4.24 can report "Base Female" as ordinal 6 whereas a
    // DAZ 6.25 saved Set recorded ordinal 7. The UV name is portable. Never
    // change the stored Set or the native control to manufacture index 7.
    // This read-only projection is scoped to a registered GeoShell targeted
    // at the chosen figure, and only for saved Set comparisons on DAZ 4.24.
    // No generalized compatibility is applied to same-scene transaction
    // snapshots, native import verification or measured rollback comparisons.
    function geoProjectSetShellUVOrdinals(node,fig,expected,actual,emitLog,importProof) {
        if (!( /^4\.24(?:\.|$)/.test(String(App.versionString)) ||
               (importProof===true && /^6\.25(?:\.|$)/.test(String(App.versionString))) ) || !node || !fig ||
            typeof node.inherits!=="function" || !node.inherits("DzGeometryShellNode") ||
            typeof node.getTarget!=="function" || !same(node.getTarget(),fig) ||
            !expected || !actual || !Array.isArray(expected.surfaces) ||
            !Array.isArray(actual.surfaces)) return expected;
        var object=node.getObject(),shape=object?object.getCurrentShape():null;
        if (!shape || typeof shape.findMaterial!=="function")return expected;
        var actualByName={},seen={};
        for(var a=0;a<actual.surfaces.length;a++){
            var ar=actual.surfaces[a];
            if(!ar||typeof ar.name!=="string"||own(actualByName,"$"+ar.name))return expected;
            actualByName["$"+ar.name]=ar;
        }
        var projected=null,changed=[];
        for(var i=0;i<expected.surfaces.length;i++){
            var er=expected.surfaces[i];
            if(!er||typeof er.name!=="string"||own(seen,"$"+er.name))return expected;
            seen["$"+er.name]=true;
            var cur=actualByName["$"+er.name];
            if(!cur || typeof er.uv!=="string" || !er.uv || er.uv!==cur.uv ||
                !er.values || !cur.values || !own(er.values,"UV Set") ||
                !own(cur.values,"UV Set") || typeof er.values["UV Set"]!=="number" ||
                typeof cur.values["UV Set"]!=="number" ||
                !isFinite(er.values["UV Set"]) || !isFinite(cur.values["UV Set"]) ||
                closeNumbers(er.values["UV Set"],cur.values["UV Set"]))continue;
            var mat=shape.findMaterial(er.name);
            if(!mat||typeof mat.getUVSetControl!=="function")continue;
            var uv=mat.getUVSetControl();
            if(!uv || typeof uv.getStringValue!=="function" ||
                typeof uv.getValue!=="function")continue;
            var nativeName=String(uv.getStringValue()),nativeOrdinal=Number(uv.getValue());
            // The *current* surface snapshot must agree with a fresh native
            // control read. The saved name and runtime name must be identical.
            if(nativeName!==er.uv || !isFinite(nativeOrdinal) ||
                !closeNumbers(nativeOrdinal,cur.values["UV Set"]))continue;
            if(!projected)projected=clonePlain(expected);
            projected.surfaces[i].values["UV Set"]=nativeOrdinal;
            changed.push({surface:er.name,uv:nativeName,savedOrdinal:er.values["UV Set"],nativeOrdinal:nativeOrdinal});
        }
        if(projected && emitLog===true)for(var c=0;c<changed.length;c++){
            var p=changed[c];
            log("INFO","GEO_SET_UV_ORDINAL_COMPAT",String(node.getLabel())+
                " / "+p.surface+" | uv="+p.uv+" | savedOrdinal="+p.savedOrdinal+
                " | daz424Ordinal="+p.nativeOrdinal+
                " | fresh native name/value confirmed; comparison-only; all other fields verified");
        }
        return projected||expected;
    }
    function setMaterialsMatchSnapshot(item,inf,saved,fig) {
        var changed=[],incomplete=[],equivalentPaths=[],topologyMissing=[];
        for(var i=0;i<saved.parts.length;i++){
            var spec=saved.parts[i],part=inf.parts[spec.partID];
            if(!part){changed.push("Missing part "+spec.partID);continue;}
            var read=materials(part),expected=spec.snapshot;
            if(expected.skipped||read.skipped)incomplete.push(item.name+" / "+String(part.getLabel())+
                ": partially readable properties (saved="+expected.skipped+", current="+read.skipped+").");
            var normalized=geoProjectSetShellUVOrdinals(part,fig,expected,read,true);
            var diffs=materialDifferences(normalized.surfaces,read.surfaces);
            var topology=fig?geoDonorOnlyShellSurfaces(part,fig,expected,read):{names:[]};
            var absent={};for(var m=0;m<topology.names.length;m++)absent["$"+topology.names[m]]=true;
            for(var d=0;d<diffs.length;d++){
                var diff=diffs[d];
                if(diff.category==="missing_surface"&&own(absent,"$"+diff.surface)){
                    topologyMissing.push(String(part.getLabel())+" / "+diff.surface);continue;
                }
                var prefix=String(part.getLabel())+" / "+diff.surface+" / "+diff.field+
                    " ("+diff.category+")";
                if(diff.category==="texture_path"&&diff.expectedPresent&&diff.actualPresent&&
                    typeof diff.expected==="string"&&typeof diff.actual==="string") {
                    var fileCheck=materialMapSameExistingFile(diff.expected,diff.actual);
                    if(fileCheck.match){
                        equivalentPaths.push(prefix+": saved="+JSON.stringify(diff.expected)+
                            "; loaded="+JSON.stringify(diff.actual)+
                            "; canonical="+JSON.stringify(fileCheck.left.path));
                        continue;
                    }
                    prefix+="; saved="+JSON.stringify(diff.expected)+
                        "; loaded="+JSON.stringify(diff.actual)+
                        "; savedCanonical="+JSON.stringify(fileCheck.left.path)+
                        "; loadedCanonical="+JSON.stringify(fileCheck.right.path)+
                        "; savedPathIssue="+fileCheck.left.reason+
                        "; loadedPathIssue="+fileCheck.right.reason;
                }
                if(changed.length<32)changed.push(prefix);
            }
            if(diffs.length>32 && changed.length>=32)changed.push("Additional material differences omitted; see Materials diagnostics.");
        }
        return {changed:changed,incomplete:incomplete,equivalentPaths:equivalentPaths,topologyMissing:topologyMissing};
    }
    function cleanupTemporaryMaterialPreset(rel){
        // A restore backup is an unreferenced, newly generated preset.
        // Do not touch any preset linked from a catalog revision.
        validateNativeMaterialPresetRelative(rel);
        var file=new DzFile(inLibrary(rel));
        try{if(file.exists())file.remove();}finally{file.deleteLater();}
    }
    // v0.9.3.6: Diagnose content/JSON drift without trusting the native
    // import return code. We do not parse DSON into a new material writer.
    // This read-only check is deliberately advisory: a preset may refer to
    // images via an ID/URI rather than a literal filename.
    function nativeMaterialTextureAudit(rel,record,itemName) {
        try {
            var nativeText=readText(inLibrary(validateNativeMaterialPresetRelative(rel)));
            var decoded=nativeText;
            try{decoded=decodeURIComponent(nativeText);}catch(ignoreDecode){}
            var names={},present=[],missing=[];
            for(var i=0;i<record.parts.length;i++){
                var surfaces=record.parts[i].snapshot.surfaces;
                for(var j=0;j<surfaces.length;j++){
                    var values=surfaces[j].values,keys=Object.keys(values);
                    for(var k=0;k<keys.length;k++){
                        if(!/\|map$/.test(keys[k]) || !values[keys[k]])continue;
                        var raw=String(values[keys[k]]).replace(/\\/g,"/");
                        var basename=raw.slice(raw.lastIndexOf("/")+1);
                        if(!basename || names["$"+basename])continue;
                        names["$"+basename]=true;
                        if(nativeText.indexOf(basename)>=0 || decoded.indexOf(basename)>=0)
                            present.push(basename);
                        else missing.push(basename);
                    }
                }
            }
            log("INFO","MATERIAL_PRESET_TEXTURE_AUDIT",itemName+" | preset="+rel+
                " | snapshotMaps="+(present.length+missing.length)+
                " | referencedByName="+present.length+" | notFoundByName="+missing.length+
                (missing.length?" | unconfirmed="+missing.slice(0,12).join(", "):"")+
                " | advisory=true");
            return {present:present,missing:missing};
        }catch(e){
            log("WARN","MATERIAL_PRESET_TEXTURE_AUDIT",itemName+" | "+errorText(e));
            return null;
        }
    }
    function restoreItemMaterials(st,fig,itemID) {
        requireUnscoped("restore_item_materials");
        var item=app.db.items[itemID],saved=setMaterialSnapshots(st)[itemID];
        if(st.items.indexOf(itemID)<0||!item||!saved||!saved.nativePreset)
            throw problem("MATERIAL_RESTORE_SELECTION","This set does not have a native preset for the selected item.");
        if(!readable(inLibrary(saved.nativePreset)))
            throw problem("MATERIAL_RESTORE_PRESET_MISSING",saved.nativePreset);
        assertNoPending(fig);
        var inv=inventory(fig,app.db),inf=inv[itemID];
        if(!inf||inf.where!=="active")throw problem("MATERIAL_RESTORE_NOT_WORN",item.name+" must be worn to restore its materials.");
        // Audit the immutable saved preset BEFORE any scene mutation. If the
        // reference JSON expects D02 but the DUF never mentions D02, this log
        // distinguishes an export/capture issue from an import/selection issue.
        geoVerifySetShellPresetCoverage(item,inf,saved,saved.nativePreset,"MANUAL_PREFLIGHT");
        var savedCoverage=nativeMaterialTextureAudit(saved.nativePreset,saved,item.name);
        if(savedCoverage&&savedCoverage.missing.length)
            throw problem("MATERIAL_PRESET_INCOMPLETE",item.name+
                ": the saved native DUF has no confirmed references for "+savedCoverage.missing.join(", ")+
                ". It cannot safely restore the JSON baseline. Reapply the desired material manually, then edit and save this outfit with Save Materials to create a NEW complete preset.");
        // Capture BEFORE any external DSON load. The temporary backup includes
        // shader data omitted by our JSON comparator, exactly like Save Materials.
        var before=captureItemMaterials(item,inf).record;
        var temporary=saveNativeMaterialPreset(item,inf,before),attempted=false,restored=false;
        try{
            try {
                attempted=true;
                nativeMaterialRestoreToItem(item,inf,saved.nativePreset);
                try{Scene.update();}catch(ignoreUpdate){}
                var now=inventory(fig,app.db);
                geoRebindSavedShellUVs(item,now[itemID],saved,"MANUAL_RESTORE");
                var manualShell=geoSetRestoreNativeShell(item,now[itemID],fig);
                var after=manualShell?autoSetMaterialStatus(item,now[itemID],saved,fig,true):
                    setMaterialsMatchSnapshot(item,now[itemID],saved,fig);
                if(after.changed.length){
                    log("FAIL","MATERIAL_RESTORE_DIFF",item.name+" | "+after.changed.join("; "));
                    throw problem("MATERIAL_RESTORE_VERIFICATION",item.name+": "+after.changed.join("; "));
                }
                if(after.equivalentPaths.length)
                    log("PASS","MATERIAL_RESTORE_PATH_EQUIVALENT",after.equivalentPaths.join("; "));
                if(after.topologyMissing.length)
                    log("WARN","MATERIAL_RESTORE_GEOSHELL_TOPOLOGY",item.name+
                        " | absent donor-only surfaces="+after.topologyMissing.join(", ")+
                        " | existing native shell material surfaces verified.");
                restored=true;
                if(after.incomplete.length)log("WARN","MATERIAL_RESTORE_INCOMPLETE",after.incomplete.join("; "));
                log("PASS","MATERIAL_RESTORED",item.name+" | set="+st.name+" | preset="+saved.nativePreset);
                ctx.outcome="Restored saved materials for "+item.name+" from "+st.name+"."+
                    (after.incomplete.length?" Some shader fields could not be verified; see report.":"");
            }catch(failure){
                if(attempted){
                    var rollbackError="";
                    try{
                        nativeMaterialRestoreToItem(item,inf,temporary);
                        try{Scene.update();}catch(ignoreUpdate){}
                        var rollbackInfo=inventory(fig,app.db)[itemID];
                        geoRebindSavedShellUVs(item,rollbackInfo,before,"MANUAL_ROLLBACK");
                        var check=setMaterialsMatchSnapshot(item,rollbackInfo,before);
                        if(check.changed.length){
                            log("FAIL","MATERIAL_ROLLBACK_DIFF",item.name+" | "+check.changed.join("; "));
                            throw problem("MATERIAL_ROLLBACK_VERIFICATION",check.changed.join("; "));
                        }
                        if(check.equivalentPaths.length)
                            log("PASS","MATERIAL_ROLLBACK_PATH_EQUIVALENT",check.equivalentPaths.join("; "));
                        log("PASS","MATERIAL_RESTORE_ROLLBACK",item.name+" reverted to its before-action native material preset.");
                    }catch(rollbackFailure){rollbackError=errorText(rollbackFailure);}
                    if(rollbackError){
                        log("FAIL","MATERIAL_RESTORE_ROLLBACK",rollbackError+" | backup remains at "+inLibrary(temporary));
                        // Keep the backup for manual recovery, including after
                        // this action's ordinary report has been saved.
                        temporary="";
                        throw problem("MATERIAL_RESTORE_INCOMPLETE",errorText(failure)+
                            ". Rollback failed: "+rollbackError+". Reopen the pre-action scene. A backup preset was kept in Materials.");
                    }
                }
                throw failure;
            }
        }finally{
            if(temporary)try{cleanupTemporaryMaterialPreset(temporary);}catch(cleanupError){
                log("WARN","MATERIAL_RESTORE_BACKUP_CLEANUP",errorText(cleanupError)+" | "+temporary);
            }
        }
    }
    // v0.9.3.7: One restore action for a user-selected list. Every target is
    // preflighted and backed up BEFORE the first native DUF load. In the event
    // of an error, restore ALL attempted targets in reverse order. Native DUF
    // loads may not participate fully in the DAZ Undo stack; never promise it.
    // v0.9.10.15: a full native material preset may carry stale enum indexes
    // after DAZ rebuilds donor-graft surfaces. The saved UV-name must be
    // explicitly re-selected, but ONLY for the registered GeoShell itself.
    // Never substitute a different UV, trust an invalid stored name, or
    // permit unrelated material changes: the caller performs a full strict
    // comparison immediately afterward.
    function geoRebindSavedShellUVs(item,inf,record,stage){
        if(!item||!inf||!record||!Array.isArray(record.parts))
            throw problem("GEO_SET_UV_RECORD","A valid material record is required.");
        var count=0;
        for(var pi=0;pi<record.parts.length;pi++){
            var partRecord=record.parts[pi],node=inf.parts[partRecord.partID];
            if(!node)throw problem("GEO_SET_UV_PART",item.name+" / "+partRecord.partID);
            if(typeof node.inherits!=="function"||!node.inherits("DzGeometryShellNode"))continue;
            var object=node.getObject(),shape=object?object.getCurrentShape():null;
            if(!shape)throw problem("GEO_SET_UV_SHAPE",item.name+" / "+String(node.getLabel()));
            var source=partRecord.snapshot;
            if(!source||!Array.isArray(source.surfaces))throw problem("GEO_SET_UV_RECORD",item.name);
            for(var si=0;si<source.surfaces.length;si++){
                var expected=source.surfaces[si],mat=shape.findMaterial(expected.name);
                // A currently absent donor surface cannot be manufactured by
                // a material preset; the strict caller validates topology.
                if(!mat)continue;
                var uv=mat.getUVSetControl();
                if(!uv)throw problem("GEO_SET_UV_CONTROL",item.name+" / "+expected.name);
                var wanted=String(expected.uv),current=String(uv.getStringValue()),
                    numericExpected=expected.values&&expected.values["UV Set"],
                    numericCurrent=typeof uv.getValue==="function"?Number(uv.getValue()):null;
                var numericMismatch=typeof numericExpected==="number"&&
                    (numericCurrent===null||!closeNumbers(numericExpected,numericCurrent));
                var namedDAZ4= /^4\.24(?:\.|$)/.test(String(App.versionString)) &&
                    (stage==="SET_RESTORE"||stage==="MANUAL_RESTORE") &&
                    typeof node.getTarget==="function" && !!node.getTarget();
                if(current===wanted){
                    if(!numericMismatch)continue;
                    if(namedDAZ4 && numericCurrent!==null && isFinite(numericCurrent)){
                        log("INFO","GEO_SET_UV_ORDINAL_COMPAT",item.name+" / "+expected.name+
                            " | uv="+wanted+" | savedOrdinal="+numericExpected+
                            " | daz424Ordinal="+numericCurrent+" | stage="+stage+
                            " | native UV name already correct; no setter called");
                        continue;
                    }
                }
                if(!wanted||typeof uv.setValueFromString!=="function")
                    throw problem("GEO_SET_UV_UNAVAILABLE",item.name+" / "+expected.name+
                        " | saved="+wanted+" | actual="+current+" | stage="+stage);
                uv.setValueFromString(wanted);
                var actual=String(uv.getStringValue()),
                    numericAfter=typeof uv.getValue==="function"?Number(uv.getValue()):null;
                if(actual!==wanted || (typeof numericExpected==="number" &&
                    (numericAfter===null||!isFinite(numericAfter)||
                     (!namedDAZ4&&!closeNumbers(numericExpected,numericAfter)))))
                    throw problem("GEO_SET_UV_REBIND_FAILED",item.name+" / "+expected.name+
                        " | requested="+wanted+" ("+String(numericExpected)+")"+
                        " | actual="+actual+" ("+String(numericAfter)+") | stage="+stage);
                count++;
                if(namedDAZ4 && numericMismatch && !closeNumbers(numericExpected,numericAfter))
                    log("INFO","GEO_SET_UV_ORDINAL_COMPAT",item.name+" / "+expected.name+
                        " | uv="+wanted+" | savedOrdinal="+numericExpected+
                        " | daz424Ordinal="+numericAfter+" | stage="+stage+
                        " | named UV successfully rebound");
                log("PASS","GEO_SET_UV_REBOUND",item.name+" / "+expected.name+
                    " | from="+current+" | to="+wanted+" | stage="+stage);
            }
        }
        if(count)try{Scene.update();}catch(ignoreUVUpdate){}
        return count;
    }
    // Only the ordinary DzMaterialAssetFilter has a flat material_library.
    // Check it for registered single-node shells. Hierarchical presets and
    // non-shell items keep their existing verification path.
    function geoVerifySetShellPresetCoverage(item,inf,record,relative,stage){
        if(!item||!inf||!record||!Array.isArray(record.parts)||item.parts.length!==1)return;
        var node=inf.parts[item.parts[0].id];
        if(!node||typeof node.inherits!=="function"||!node.inherits("DzGeometryShellNode"))return;
        var source=record.parts[0]&&record.parts[0].snapshot;
        if(!source||!Array.isArray(source.surfaces))
            throw problem("GEO_SET_PRESET_RECORD","Missing registered GeoShell materials.");
        var path=inLibrary(validateNativeMaterialPresetRelative(relative));
        if(!readable(path))throw problem("GEO_SET_PRESET_MISSING",relative);
        var parsed=null;
        try{parsed=JSON.parse(readText(path).replace(/^\uFEFF/,""));}
        catch(parseError){throw problem("GEO_SET_PRESET_DSON",item.name+" | "+errorText(parseError));}
        if(!parsed||!Array.isArray(parsed.material_library))
            throw problem("GEO_SET_PRESET_DSON",item.name+" | missing material_library | "+relative);
        var wanted={},got={},i,name;
        for(i=0;i<source.surfaces.length;i++){
            name=String(source.surfaces[i].name);if(own(wanted,"$"+name))
                throw problem("GEO_SET_PRESET_DUPLICATE",item.name+" / "+name);
            wanted["$"+name]=true;
        }
        for(i=0;i<parsed.material_library.length;i++){
            if(!parsed.material_library[i]||typeof parsed.material_library[i].id!=="string")
                throw problem("GEO_SET_PRESET_DSON",item.name+" | invalid material entry");
            name=parsed.material_library[i].id;
            if(own(got,"$"+name))throw problem("GEO_SET_PRESET_DUPLICATE",item.name+" / "+name);
            got["$"+name]=true;
        }
        var missing=[],unexpected=[],expectedKeys=Object.keys(wanted),actualKeys=Object.keys(got);
        for(i=0;i<expectedKeys.length;i++)if(!own(got,expectedKeys[i]))missing.push(expectedKeys[i].slice(1));
        for(i=0;i<actualKeys.length;i++)if(!own(wanted,actualKeys[i]))unexpected.push(actualKeys[i].slice(1));
        if(missing.length||unexpected.length){
            log("FAIL","GEO_SET_PRESET_COVERAGE",item.name+" | stage="+stage+
                " | missing="+missing.join(", ")+" | unexpected="+unexpected.join(", ")+
                " | preset="+relative);
            throw problem("GEO_SET_PRESET_COVERAGE",item.name+" | preset and JSON surface lists differ. "+
                "Wear the GeoGraft, then edit/save the Set with Save Materials to capture a consistent new native preset. "+
                "Missing: "+missing.join(", ")+"; unexpected: "+unexpected.join(", "));
        }
        log("PASS","GEO_SET_PRESET_COVERAGE",item.name+" | "+stage+
            " | surfaces="+expectedKeys.length+" | preset="+relative);
    }
    function restoreSelectedItemMaterials(st,fig,itemIDs,mode){
        var automatic=mode==="full_apply";
        requireUnscoped(automatic?"auto_restore_set_materials":"restore_selected_materials");
        if(!itemIDs||!itemIDs.length)throw problem("MATERIAL_RESTORE_SELECTION","Select at least one item.");
        if(!automatic)assertNoPending(fig);
        var inv=inventory(fig,app.db),snapshots=setMaterialSnapshots(st),nodes=sceneNodes(),seen={},tasks=[];
        for(var i=0;i<itemIDs.length;i++){
            var id=String(itemIDs[i]);
            if(seen["$"+id])throw problem("MATERIAL_RESTORE_SELECTION","Duplicate item in selection: "+id);
            seen["$"+id]=true;
            var item=app.db.items[id],saved=snapshots[id],inf=inv[id];
            if(st.items.indexOf(id)<0||!item||!saved||!saved.nativePreset)
                throw problem("MATERIAL_RESTORE_SELECTION","No saved native preset for "+id);
            validateNativeMaterialPresetRelative(saved.nativePreset);
            if(!readable(inLibrary(saved.nativePreset)))throw problem("MATERIAL_RESTORE_PRESET_MISSING",item.name);
            if(!inf||inf.where!=="active")throw problem("MATERIAL_RESTORE_NOT_WORN",item.name+" must be worn.");
            // Validate the labels the native content loader will use, before
            // applying even one of the selected materials.
            var names={};
            for(var partIndex=0;partIndex<item.parts.length;partIndex++){
                var part=inf.parts[item.parts[partIndex].id];
                if(!part)throw problem("MATERIAL_RESTORE_PART",item.name+" / "+item.parts[partIndex].id);
                var partLabel=String(part.getLabel());
                if(names["$"+partLabel])throw problem("MATERIAL_RESTORE_LABEL","Repeated item part label: "+partLabel);
                names["$"+partLabel]=true;
                var matches=0;
                for(var ni=0;ni<nodes.length;ni++)if(String(nodes[ni].getLabel())===partLabel)matches++;
                if(matches!==1)throw problem("MATERIAL_RESTORE_LABEL",item.name+": part label is not unique: "+partLabel);
            }
            geoVerifySetShellPresetCoverage(item,inf,saved,saved.nativePreset,"RESTORE_PREFLIGHT");
            var audit=nativeMaterialTextureAudit(saved.nativePreset,saved,item.name);
            if(audit&&audit.missing.length)throw problem("MATERIAL_PRESET_INCOMPLETE",item.name+
                ": unconfirmed texture references: "+audit.missing.join(", ")+". Re-save this set's materials.");
            tasks.push({id:id,item:item,saved:saved,inf:inf,before:null,backup:"",attempted:false});
        }
        log("INFO","MATERIAL_RESTORE_BATCH_PREFLIGHT",tasks.length+" selected item(s); all worn, presets readable, native target labels unique.");
        var failure=null,rollbackErrors=[];
        try{
            // Native backup creation can fail. No scene materials have been
            // changed while this entire loop completes.
            for(i=0;i<tasks.length;i++){
                var t=tasks[i];
                t.before=captureItemMaterials(t.item,t.inf).record;
                t.backup=saveNativeMaterialPreset(t.item,t.inf,t.before);
                log("PASS","MATERIAL_RESTORE_BATCH_BACKUP",t.item.name+" | "+t.backup);
            }
            for(i=0;i<tasks.length;i++){
                t=tasks[i];t.attempted=true;
                nativeMaterialRestoreToItem(t.item,t.inf,t.saved.nativePreset);
                try{Scene.update();}catch(ignoreUpdate){}
                var current=inventory(fig,app.db)[t.id];
                if(!current||current.where!=="active")throw problem("MATERIAL_RESTORE_ITEM_CHANGED",t.item.name);
                geoRebindSavedShellUVs(t.item,current,t.saved,"SET_RESTORE");
                var useNamedSetCompatibility=automatic||geoSetRestoreNativeShell(t.item,current,fig);
                var check=useNamedSetCompatibility?autoSetMaterialStatus(t.item,current,t.saved,fig,true):
                    setMaterialsMatchSnapshot(t.item,current,t.saved,fig);
                if(check.compatible)log("WARN","SET_MATERIAL_DAZ_COMPAT",t.item.name+
                    " | accepted only independently verified named runtime-neutral zero/unmapped properties; " +
                    "all remaining comparable fields match; unreadable shader channels/rendering equivalence not verified.");
                if(check.topologyMissing&&check.topologyMissing.length)log("WARN","MATERIAL_RESTORE_GEOSHELL_TOPOLOGY",
                    t.item.name+" | absent donor-only surfaces="+check.topologyMissing.join(", ")+" | no native material comparison for these surfaces.");
                if(check.changed.length){
                    log("FAIL","MATERIAL_RESTORE_DIFF",t.item.name+" | "+check.changed.join("; "));
                    throw problem("MATERIAL_RESTORE_VERIFICATION",t.item.name+": "+check.changed.join("; "));
                }
                if(check.incomplete.length)log("WARN","MATERIAL_RESTORE_INCOMPLETE",check.incomplete.join("; "));
                if(check.equivalentPaths.length)log("PASS","MATERIAL_RESTORE_PATH_EQUIVALENT",check.equivalentPaths.join("; "));
                log("PASS","MATERIAL_RESTORED",t.item.name+" | set="+st.name);
            }
            if(!automatic)ctx.outcome="Restored saved materials for "+tasks.length+" selected item(s) from "+st.name+".";
        }catch(e){
            failure=e;
            // Once a native load was attempted, the previously successful
            // items must also be reverted, not only the item that failed.
            for(var ri=tasks.length-1;ri>=0;ri--){
                var r=tasks[ri];if(!r.attempted)continue;
                try{
                    nativeMaterialRestoreToItem(r.item,r.inf,r.backup);
                    try{Scene.update();}catch(ignoreRollbackUpdate){}
                    var currentRollback=inventory(fig,app.db)[r.id];
                    if(!currentRollback||currentRollback.where!=="active")throw problem("MATERIAL_ROLLBACK_ITEM_CHANGED",r.item.name);
                    geoRebindSavedShellUVs(r.item,currentRollback,r.before,"SET_ROLLBACK");
                    var reversed=setMaterialsMatchSnapshot(r.item,currentRollback,r.before);
                    if(reversed.changed.length)throw problem("MATERIAL_ROLLBACK_VERIFICATION",reversed.changed.join("; "));
                    log("PASS","MATERIAL_RESTORE_BATCH_ROLLBACK",r.item.name+" restored to pre-action materials.");
                }catch(re){
                    rollbackErrors.push(r.item.name+": "+errorText(re)+"; backup: "+inLibrary(r.backup));
                    log("FAIL","MATERIAL_RESTORE_BATCH_ROLLBACK",rollbackErrors[rollbackErrors.length-1]);
                    r.backup=""; // Leave the failed rollback's file on disk.
                }
            }
        }finally{
            for(i=0;i<tasks.length;i++)if(tasks[i].backup)try{
                cleanupTemporaryMaterialPreset(tasks[i].backup);
            }catch(cleanError){log("WARN","MATERIAL_RESTORE_BACKUP_CLEANUP",errorText(cleanError)+" | "+tasks[i].backup);}
        }
        if(rollbackErrors.length)throw problem("MATERIAL_RESTORE_INCOMPLETE",errorText(failure)+
            ". Rollback of one or more items FAILED. Reopen the saved test scene. Backups retained: "+rollbackErrors.join(" | "));
        if(failure)throw failure;
    }
    // v0.9.4: A full Set may have a different material even when every
    // registered item is already worn. Compare live shader state before
    // changing it; the old structural fast-noop cannot make this decision.
    // DAZ 4.24 can omit two zero-valued, unmapped Iray fields. Only the
    // native import compatibility policy may accept those exact omissions.
    // Manual and automatic saved styles share the narrow GeoShell topology
    // allowance; same-scene native rollback verification remains fully strict.
    // The old manual Material Restore path was strict for ordinary wearables.
    // Preserve that behavior: only a single-part, natively targeted GeoShell
    // can use the Set-only post-native DAZ4 compatibility proof. Full Apply
    // retains its existing automatic material-compatibility path.
    function geoSetRestoreNativeShell(item,inf,fig){
        if(!item||!inf||!fig||!Array.isArray(item.parts)||item.parts.length!==1||!inf.parts)return false;
        var node=inf.parts[item.parts[0].id];
        if(!node||typeof node.inherits!=="function"||!node.inherits("DzGeometryShellNode")||
           typeof node.getTarget!=="function")return false;
        try{return same(node.getTarget(),fig);}catch(ignoreTarget){return false;}
    }
    // DAZ 4.24 native-material proof. Originally Set-only after native
    // restore; v023 also reuses the read-only primitive during native import,
    // with a separate strict wrapper and fresh observed-state certification.
    // Import proof never substitutes for the post-restoration check.
    //
    // DrawStyleOverride=0 with no map is a neutral viewport override which
    // DAZ 4.24 does not expose on some legitimate shell surface classes.
    // The earlier Iray-only policy is intentionally NOT widened globally.
    // For Saved Sets (and independently guarded native-import verification),
    // prove EACH omission using a fresh native property list of a real
    // material on a shell currently targeting this figure.
    // Displacement Adaptive Quality stays Iray-only with its displacement
    // dependencies checked, and all other properties remain strict.
    function geoDaz424SetRestoreNamedProof(item,inf,saved,fig,emitLog){
        var rejected=[],allowed=0,topologyCount=0,mapPaths=[],partCount=0;
        function refuse(why){if(rejected.length<12)rejected.push(why);}
        var result={passed:false,reasons:rejected,topologyCount:0,acceptedCount:0,
            equivalentPaths:mapPaths};
        if(!item||!inf||!saved||!fig||!Array.isArray(saved.parts)||!saved.parts.length||
           !/^4\.24(?:\.|$)/.test(String(App.versionString)))return result;
        for(var ri=0;ri<saved.parts.length;ri++){
            var rec=saved.parts[ri],node=inf.parts&&inf.parts[rec.partID];
            if(!node||typeof node.inherits!=="function"||!node.inherits("DzGeometryShellNode")||
               typeof node.getTarget!=="function"||!same(node.getTarget(),fig)){
                refuse("part is not a natively targeted GeoShell: "+String(rec.partID));break;
            }
            var expected=rec.snapshot,current=materials(node);
            if(!expected||!Array.isArray(expected.surfaces)||!Array.isArray(current.surfaces)||
               typeof expected.skipped!=="number"||typeof current.skipped!=="number"){
                refuse("invalid material snapshot schema");break;
            }
            var shape=null;
            try{var object=node.getObject();shape=object?object.getCurrentShape():null;}
            catch(shapeError){refuse("native shape unavailable: "+errorText(shapeError));break;}
            if(!shape||typeof shape.findMaterial!=="function"||typeof shape.getAllMaterials!=="function"){
                refuse("native material lookup unavailable");break;
            }
            var uniqueNative={},nativeMats=shape.getAllMaterials(),nativeOK=true;
            for(var mi=0;mi<nativeMats.length;mi++){
                var mat=nativeMats[mi],mn=mat&&String(mat.name);
                if(!mat||!mn||own(uniqueNative,"$"+mn)){nativeOK=false;break;}
                uniqueNative["$"+mn]=mat;
            }
            if(!nativeOK||!nativeMats.length){refuse("native material names duplicate/missing");break;}
            var normalized=geoProjectSetShellUVOrdinals(node,fig,expected,current,false),
                topology=geoDonorOnlyShellSurfaces(node,fig,expected,current),exclude={};
            for(var dn=0;dn<topology.names.length;dn++)exclude["$"+topology.names[dn]]=true;
            var source=clonePlain(normalized.surfaces),survivors=[],actualIndex={},badShape=false;
            for(var ai=0;ai<current.surfaces.length;ai++){
                var ar=current.surfaces[ai];
                if(!ar||typeof ar.name!=="string"||own(actualIndex,"$"+ar.name)){badShape=true;break;}
                actualIndex["$"+ar.name]=ar;
            }
            if(badShape){refuse("actual surface names duplicate/missing");break;}
            for(var si=0;si<source.length;si++){
                var er=source[si];
                if(own(exclude,"$"+er.name)){
                    if(own(actualIndex,"$"+er.name))badShape=true;
                    continue;
                }
                var live=actualIndex["$"+er.name],nm=uniqueNative["$"+er.name];
                if(!live||!nm||!er.values||!live.values){badShape=true;break;}
                if(typeof nm.getPropertyList!=="function"||typeof nm.className!=="function"){
                    refuse("native material property/class evidence unavailable for "+er.name);badShape=true;break;
                }
                var props=nm.getPropertyList(),nativeProps={},propertyOK=!!props&&props.length>0;
                if(propertyOK)for(var pi=0;pi<props.length;pi++){
                    var pn=props[pi]&&String(props[pi].name);
                    if(!pn||own(nativeProps,"$"+pn)){propertyOK=false;break;}
                    nativeProps["$"+pn]=true;
                }
                if(!propertyOK){refuse("native property list ambiguous for "+er.name);badShape=true;break;}
                var pairs=["DrawStyleOverride","Displacement Adaptive Quality"];
                for(var p=0;p<pairs.length;p++){
                    var field=pairs[p],mapField=field+"|map",ev=er.values,av=live.values;
                    if(!own(ev,field)||!own(ev,mapField)||own(av,field)||own(av,mapField))continue;
                    // One missing value with a surviving map is not a harmless
                    // legacy omission; require BOTH absent, exactly neutral.
                    if(ev[field]!==0||ev[mapField]!==""||own(nativeProps,"$"+field)||
                       own(nativeProps,"$"+mapField))continue;
                    if(field==="Displacement Adaptive Quality"){
                        if(String(nm.className())!=="DzUberIrayMaterial"||
                           typeof nm.getMaterialName!=="function"||String(nm.getMaterialName())!=="Iray Uber"||
                           !closeNumbers(ev["Displacement Strength"],av["Displacement Strength"])||
                           !closeNumbers(ev["Displacement Strength|map"],av["Displacement Strength|map"]))continue;
                    }else{
                        // A zero/unmapped viewport override is not shader
                        // material data. Require an actual native material,
                        // stable identity and a nonempty class name; never
                        // synthesize a property or accept an unknown surface.
                        var materialClass=String(nm.className());
                        if(!materialClass||materialClass==="undefined"||materialClass==="null")continue;
                    }
                    delete ev[field];delete ev[mapField];allowed+=2;
                }
                survivors.push(er);
            }
            if(badShape){if(!rejected.length)refuse("missing expected/native surface after topology filtering");break;}
            var remaining=materialDifferences(survivors,current.surfaces),blocking=[];
            for(var d=0;d<remaining.length;d++){
                var diff=remaining[d];
                if(diff.category==="texture_path"&&diff.expectedPresent&&diff.actualPresent&&
                   typeof diff.expected==="string"&&typeof diff.actual==="string"){
                    var fileCheck=materialMapSameExistingFile(diff.expected,diff.actual);
                    if(fileCheck.match){mapPaths.push(String(node.getLabel())+" / "+diff.surface+
                        " / "+diff.field+" | canonical="+fileCheck.left.path);continue;}
                }
                blocking.push(diff.surface+" / "+diff.field+" ("+diff.category+")");
            }
            if(blocking.length){
                for(var bi=0;bi<Math.min(8,blocking.length);bi++)refuse(blocking[bi]);
                break;
            }
            topologyCount+=topology.names.length;partCount++;
        }
        result.passed=rejected.length===0 && partCount===saved.parts.length && allowed>0;
        result.acceptedCount=allowed;result.topologyCount=topologyCount;
        if(emitLog===true){
            var severity=result.passed?"WARN":"INFO";
            log(severity,result.passed?"GEO_SET_DAZ424_NEUTRAL_COMPAT":"GEO_SET_DAZ424_NEUTRAL_REJECT",
                item.name+" | surfaces="+partCount+" | missingNeutralFields="+allowed+
                " | absentDonorSurfaces="+topologyCount+
                " | skippedShaderFieldsRemainUnverified=true"+
                (rejected.length?" | reasons="+rejected.join("; "):""));
        }
        return result;
    }
    // DAZ 6.25 Saved Set material restore: older saved JSON can lack two
    // neutral properties which the current Iray material exposes after a
    // native DzContentMgr.openFile(). Initial item-import compatibility and
    // Saved Set restoration are different paths. This read-only compatibility
    // proof is used only when a Set applies to an already natively attached
    // GeoGraft (including its registered children such as parented Pubic Hair).
    //
    // Every accepted field is freshly read from the real native material and
    // is EXACTLY number 0 with no map; every remaining compared field must
    // match the immutable Set snapshot. Read-only: no setters, no catalog
    // changes. Unreadable shader fields remain unverified; strict rollback
    // comparisons do NOT use this compatibility proof.
    function geoDaz625GraftSetExtraProof(item,inf,saved,fig,emitLog){
        var rejected=[],accepted=0,partsChecked=0,unreadableSaved=0,unreadableCurrent=0;
        function refuse(reason){if(rejected.length<12)rejected.push(String(reason));}
        var result={passed:false,acceptedCount:0,partsChecked:0,reasons:rejected,
            skippedSaved:0,skippedCurrent:0};
        if(!item||!inf||!inf.root||!saved||!fig||!Array.isArray(item.parts)||
           !Array.isArray(saved.parts)||!saved.parts.length||
           !/^6\.25(?:\.|$)/.test(String(App.versionString))||
           !geoTransferIsAttached(fig,inf.root))return result;
        var expectedParts={};
        for(var idp=0;idp<item.parts.length;idp++){
            if(!item.parts[idp]||typeof item.parts[idp].id!=="string"||
               own(expectedParts,"$"+item.parts[idp].id)){
                refuse("invalid or duplicated registered PartID");break;
            }
            expectedParts["$"+item.parts[idp].id]=true;
        }
        if(rejected.length||item.parts.length!==saved.parts.length){
            refuse("saved and registered part lists differ");return result;
        }
        var visitedParts={};
        for(var pi=0;pi<saved.parts.length;pi++){
            var rec=saved.parts[pi];
            if(!rec||!own(expectedParts,"$"+rec.partID)||own(visitedParts,"$"+rec.partID)){
                refuse("unregistered or repeated saved PartID");break;
            }
            visitedParts["$"+rec.partID]=true;
            var node=inf.parts&&inf.parts[rec.partID],expected=rec.snapshot;
            if(!node||!expected||!Array.isArray(expected.surfaces)||
               typeof expected.skipped!=="number"){
                refuse("missing registered part or invalid saved material snapshot");break;
            }
            var actual=materials(node);
            if(!actual||!Array.isArray(actual.surfaces)||typeof actual.skipped!=="number"){
                refuse("native material snapshot is unavailable");break;
            }
            unreadableSaved+=expected.skipped;
            unreadableCurrent+=actual.skipped;
            var object=node.getObject&&node.getObject(),shape=object&&object.getCurrentShape&&object.getCurrentShape(),
                nativeMaterials=shape&&shape.getAllMaterials&&shape.getAllMaterials();
            if(!nativeMaterials||!nativeMaterials.length){refuse("native material shape unavailable");break;}
            var nativeByName={},side,li,entry,sk;
            for(li=0;li<nativeMaterials.length;li++){
                entry=nativeMaterials[li];sk=entry&&"$"+String(entry.name);
                if(!entry||own(nativeByName,sk)){refuse("duplicate or invalid native surface");break;}
                nativeByName[sk]=entry;
            }
            if(rejected.length)break;
            // Check duplicate surface names on BOTH sides; do not permit a
            // weak dictionary lookup to mask an overwritten entry.
            for(side=0;side<2;side++){
                var list=side===0?expected.surfaces:actual.surfaces;
                var found={};
                for(li=0;li<list.length;li++){
                    entry=list[li];sk=entry&&"$"+String(entry.name);
                    if(!entry||typeof entry.name!=="string"||own(found,sk)){
                        refuse("invalid or duplicate material snapshot surface");break;
                    }
                    found[sk]=true;
                }
                if(rejected.length)break;
            }
            if(rejected.length)break;
            var deltas=materialDifferences(expected.surfaces,actual.surfaces);
            // No other differences are accepted: not colors, UV, maps,
            // missing surfaces, shader values or extra unrelated controls.
            var wanted={};
            for(var di=0;di<deltas.length;di++){
                var diff=deltas[di],field=String(diff.field).replace(/\|map$/,"");
                if(diff.category!=="extra_property"||
                   (field!=="DrawStyleOverride"&&field!=="Displacement Adaptive Quality")){
                    refuse("unrelated material difference: "+diff.surface+" / "+diff.field+
                        " ("+diff.category+")");break;
                }
                if(!own(wanted,"$"+diff.surface))wanted["$"+diff.surface]={};
                wanted["$"+diff.surface]["$"+field]=true;
            }
            if(rejected.length)break;
            var projected=clonePlain(actual.surfaces),projectedIndex={},expectedIndex={};
            for(li=0;li<projected.length;li++)projectedIndex["$"+projected[li].name]=projected[li];
            for(li=0;li<expected.surfaces.length;li++)expectedIndex["$"+expected.surfaces[li].name]=expected.surfaces[li];
            var surfaceKeys=Object.keys(wanted);
            for(var wi=0;wi<surfaceKeys.length;wi++){
                var surfaceKey=surfaceKeys[wi],nativeMat=nativeByName[surfaceKey],ex=expectedIndex[surfaceKey],
                    live=projectedIndex[surfaceKey];
                if(!nativeMat||!ex||!live||!ex.values||!live.values||
                   typeof nativeMat.getPropertyList!=="function"||
                   typeof nativeMat.className!=="function"||
                   typeof nativeMat.getMaterialName!=="function"){
                    refuse("missing native Iray material proof for "+surfaceKey.slice(1));break;
                }
                var className=String(nativeMat.className()),shader=String(nativeMat.getMaterialName());
                if(className!=="DzUberIrayMaterial"||shader!=="Iray Uber"){
                    refuse("unexpected material class/shader for "+surfaceKey.slice(1));break;
                }
                var nativeProps=nativeMat.getPropertyList(),props={};
                if(!nativeProps||!nativeProps.length){refuse("native property list unavailable");break;}
                for(var ni=0;ni<nativeProps.length;ni++){
                    var property=nativeProps[ni],propName=property&&String(property.name);
                    if(!property||!propName||own(props,"$"+propName)){
                        refuse("native material properties are ambiguous");break;
                    }
                    props["$"+propName]=property;
                }
                if(rejected.length)break;
                var names=Object.keys(wanted[surfaceKey]);
                for(var wi2=0;wi2<names.length;wi2++){
                    var neutralName=names[wi2].slice(1),mapName=neutralName+"|map",nativeProp=props["$"+neutralName];
                    // The pair must be entirely absent in SAVED JSON,
                    // present in CURRENT JSON, exactly 0 and unmapped.
                    if(own(ex.values,neutralName)||own(ex.values,mapName)||
                       !own(live.values,neutralName)||!own(live.values,mapName)||
                       live.values[neutralName]!==0||live.values[mapName]!==""||
                       !nativeProp||own(props,"$"+mapName)||
                       typeof nativeProp.getValue!=="function"||
                       typeof nativeProp.getMapValue!=="function"){
                        refuse("extra property is not an intact neutral pair: "+surfaceKey.slice(1)+" / "+neutralName);break;
                    }
                    var value=nativeProp.getValue(),mapped=nativeProp.getMapValue();
                    if(typeof value!=="number"||value!==0||mapped){
                        refuse("fresh native value/map differs from neutral snapshot: "+surfaceKey.slice(1)+" / "+neutralName);break;
                    }
                    if(neutralName==="Displacement Adaptive Quality"){
                        // Adaptive quality must not mask a changed displacement
                        // control in the real Iray material.
                        if(!own(ex.values,"Displacement Strength")||
                           !own(live.values,"Displacement Strength")||
                           !closeNumbers(ex.values["Displacement Strength"],live.values["Displacement Strength"])||
                           !closeNumbers(ex.values["Displacement Strength|map"],live.values["Displacement Strength|map"])){
                            refuse("displacement strength/map not independently matched");break;
                        }
                    }
                    delete live.values[neutralName];delete live.values[mapName];
                    accepted+=2;
                }
                if(rejected.length)break;
            }
            if(rejected.length)break;
            var remaining=materialDifferences(expected.surfaces,projected);
            if(remaining.length){
                for(var ri=0;ri<Math.min(8,remaining.length);ri++)
                    refuse("remaining material difference: "+remaining[ri].surface+" / "+remaining[ri].field);
                break;
            }
            partsChecked++;
        }
        result.passed=!rejected.length&&partsChecked===saved.parts.length&&accepted>0;
        result.acceptedCount=accepted;result.partsChecked=partsChecked;
        result.skippedSaved=unreadableSaved;result.skippedCurrent=unreadableCurrent;
        if(emitLog===true){
            log(result.passed?"WARN":"INFO",
                result.passed?"GEO_SET_DAZ625_EXTRA_NEUTRAL_COMPAT":"GEO_SET_DAZ625_EXTRA_NEUTRAL_REJECT",
                item.name+" | parts="+partsChecked+" | extraNeutralFields="+accepted+
                " | skippedSaved="+unreadableSaved+" | skippedCurrent="+unreadableCurrent+
                " | named native material proof; skipped shader fields not verified; no catalog changes"+
                (rejected.length?" | reasons="+rejected.join("; "):""));
        }
        return result;
    }
    // v0.9.10.31: DAZ Studio 6.25 can add a neutral DrawStyleOverride
    // property when reloading a Saved Set material preset onto a GeoShell.
    // The original Set JSON can omit this field. It is NOT a material-map or
    // visibility difference and must not be handled by the graft-only proof.
    //
    // Independently prove (a) the native Shell Node still targets this figure,
    // (b) UV names and native UV controls agree even if enum ordinals differ,
    // (c) all missing surfaces form a complete absent-donor GeoGraft group,
    // (d) the only remaining differences are exact zero/unmapped pairs for
    // DrawStyleOverride or Iray Displacement Adaptive Quality, backed by fresh
    // native DzProperty reads and unchanged displacement strength. Otherwise
    // reject. This proof is deliberately NEVER used for transaction rollback
    // or regular clothing. Read-only, no catalog modifications or setters.
    function geoDaz625ShellSetNeutralProof(item,inf,saved,fig,emitLog){
        var rejected=[],accepted=0,correctedUV=0,missingDonor=0,skippedSaved=0,skippedCurrent=0;
        function refuse(why){if(rejected.length<12)rejected.push(String(why));}
        var result={passed:false,acceptedCount:0,correctedUV:0,missingDonor:0,reasons:rejected,
            skippedSaved:0,skippedCurrent:0};
        if(!/^6\.25(?:\.|$)/.test(String(App.versionString))||
           !geoSetRestoreNativeShell(item,inf,fig)||!saved||!Array.isArray(saved.parts)||
           saved.parts.length!==1||item.parts.length!==1)return result;
        var rec=saved.parts[0],partSpec=item.parts[0];
        if(!rec||!partSpec||rec.partID!==partSpec.id){refuse("saved/registered shell PartID mismatch");return result;}
        var node=inf.parts[rec.partID],expected=rec.snapshot,actual=materials(node);
        if(!expected||!actual||!Array.isArray(expected.surfaces)||!Array.isArray(actual.surfaces)||
           !actual.surfaces.length||typeof expected.skipped!=="number"||
           typeof actual.skipped!=="number"){
            refuse("invalid shell material snapshot schema");return result;
        }
        skippedSaved=expected.skipped;skippedCurrent=actual.skipped;
        var object=node.getObject&&node.getObject(),shape=object&&object.getCurrentShape&&object.getCurrentShape();
        if(!shape||typeof shape.getAllMaterials!=="function"||typeof shape.findMaterial!=="function"){
            refuse("native shell material shape unavailable");return result;
        }
        var nativeList=shape.getAllMaterials(),nativeByName={},i,entry,key;
        if(!nativeList||!nativeList.length){refuse("native shell material list unavailable");return result;}
        for(i=0;i<nativeList.length;i++){
            entry=nativeList[i];key=entry&&"$"+String(entry.name);
            if(!entry||typeof entry.name!=="string"||!entry.name||own(nativeByName,key)){
                refuse("duplicate or invalid native shell material name");return result;
            }
            nativeByName[key]=entry;
        }
        // The same native getAllMaterials() list underlies materials(node).
        // Confirm full native coverage, including surfaces whose absence the
        // topology checker would otherwise classify as donor-only.
        if(nativeList.length!==actual.surfaces.length){
            refuse("native and observed shell material counts differ");return result;
        }
        for(i=0;i<actual.surfaces.length;i++){
            if(!actual.surfaces[i]||!own(nativeByName,"$"+actual.surfaces[i].name)){
                refuse("native shell material missing from observation");return result;
            }
        }
        // Never use a lossy dictionary if either recorded side has duplicate
        // or invalid surface names. Every remaining compared field is strict.
        for(var side=0;side<2;side++){
            var list=side===0?expected.surfaces:actual.surfaces,unique={};
            for(i=0;i<list.length;i++){
                entry=list[i];key=entry&&"$"+String(entry.name);
                if(!entry||typeof entry.name!=="string"||!entry.name||own(unique,key)){
                    refuse("duplicate or invalid shell snapshot surface");return result;
                }
                unique[key]=true;
            }
        }
        var projected=geoProjectSetShellUVOrdinals(node,fig,expected,actual,false,true);
        if(!projected||!Array.isArray(projected.surfaces)){
            refuse("native UV projection unavailable");return result;
        }
        for(i=0;i<expected.surfaces.length;i++){
            if(!closeNumbers(expected.surfaces[i].values["UV Set"],projected.surfaces[i].values["UV Set"]))
                correctedUV++;
        }
        var topology=geoDonorOnlyShellSurfaces(node,fig,expected,actual),omit={};
        for(i=0;i<topology.names.length;i++)omit["$"+topology.names[i]]=true;
        missingDonor=topology.names.length;
        var expectedSurfaces=[],runtime=clonePlain(actual.surfaces),runtimeByName={},fixedByName={};
        for(i=0;i<projected.surfaces.length;i++){
            entry=projected.surfaces[i];
            if(!own(omit,"$"+entry.name)){
                expectedSurfaces.push(entry);fixedByName["$"+entry.name]=entry;
            }
        }
        for(i=0;i<runtime.length;i++)runtimeByName["$"+runtime[i].name]=runtime[i];
        var diffs=materialDifferences(expectedSurfaces,runtime),wanted={};
        for(i=0;i<diffs.length;i++){
            var delta=diffs[i],field=String(delta.field).replace(/\|map$/,"");
            if(delta.category!=="extra_property"||
               (field!=="DrawStyleOverride"&&field!=="Displacement Adaptive Quality")){
                refuse("unrelated material difference: "+delta.surface+" / "+delta.field+
                    " ("+delta.category+")");break;
            }
            if(!own(wanted,"$"+delta.surface))wanted["$"+delta.surface]={};
            wanted["$"+delta.surface]["$"+field]=true;
        }
        if(!rejected.length){
            var extraSurfaces=Object.keys(wanted);
            for(var wi=0;wi<extraSurfaces.length;wi++){
                var surfaceKey=extraSurfaces[wi],surfaceName=surfaceKey.slice(1),
                    savedSurface=fixedByName[surfaceKey],live=runtimeByName[surfaceKey],
                    nativeMat=nativeByName[surfaceKey];
                if(!savedSurface||!live||!nativeMat||!savedSurface.values||!live.values||
                   typeof nativeMat.getPropertyList!=="function"||
                   typeof nativeMat.className!=="function"){
                    refuse("native shell property proof unavailable for "+surfaceName);break;
                }
                var materialClass=String(nativeMat.className());
                if(!materialClass||materialClass==="undefined"||materialClass==="null"){
                    refuse("native shell material class unavailable for "+surfaceName);break;
                }
                var props=nativeMat.getPropertyList(),nativeProps={};
                if(!props||!props.length){refuse("empty native shell property list for "+surfaceName);break;}
                for(var ni=0;ni<props.length;ni++){
                    var property=props[ni],propName=property&&String(property.name);
                    if(!property||!propName||own(nativeProps,"$"+propName)){
                        refuse("ambiguous native shell property list for "+surfaceName);break;
                    }
                    nativeProps["$"+propName]=property;
                }
                if(rejected.length)break;
                var fields=Object.keys(wanted[surfaceKey]);
                for(var fi=0;fi<fields.length;fi++){
                    var field=fields[fi].slice(1),mapField=field+"|map",nativeProp=nativeProps["$"+field];
                    // Exact zero/unmapped pair must be absent in SAVED JSON,
                    // present in LIVE JSON, and verified through DzProperty.
                    // A partially missing pair never qualifies.
                    if(own(savedSurface.values,field)||own(savedSurface.values,mapField)||
                       !own(live.values,field)||!own(live.values,mapField)||
                       live.values[field]!==0||live.values[mapField]!==""||
                       !nativeProp||own(nativeProps,"$"+mapField)||
                       typeof nativeProp.getValue!=="function"||
                       typeof nativeProp.getMapValue!=="function"||
                       nativeProp.getValue()!==0||nativeProp.getMapValue()){
                        refuse("non-neutral or unconfirmed "+field+" for "+surfaceName);break;
                    }
                    if(field==="Displacement Adaptive Quality"){
                        // Unlike a viewport override, adaptive displacement is
                        // shader-dependent: require real Iray Uber and strict
                        // saved/live displacement strength AND map equivalence.
                        if(materialClass!=="DzUberIrayMaterial"||
                           typeof nativeMat.getMaterialName!=="function"||
                           String(nativeMat.getMaterialName())!=="Iray Uber"||
                           !own(savedSurface.values,"Displacement Strength")||
                           !own(savedSurface.values,"Displacement Strength|map")||
                           !own(live.values,"Displacement Strength")||
                           !own(live.values,"Displacement Strength|map")||
                           !closeNumbers(savedSurface.values["Displacement Strength"],live.values["Displacement Strength"])||
                           !closeNumbers(savedSurface.values["Displacement Strength|map"],live.values["Displacement Strength|map"])){
                            refuse("Iray shader or displacement strength/map not independently matched for "+surfaceName);break;
                        }
                    }
                    delete live.values[field];delete live.values[mapField];accepted+=2;
                }
                if(rejected.length)break;
            }
        }
        if(!rejected.length){
            var remaining=materialDifferences(expectedSurfaces,runtime);
            for(i=0;i<Math.min(8,remaining.length);i++)
                refuse("unmatched shell material: "+remaining[i].surface+" / "+remaining[i].field+
                    " ("+remaining[i].category+")");
        }
        result.passed=!rejected.length&&(accepted>0||correctedUV>0||missingDonor>0);
        result.acceptedCount=accepted;result.correctedUV=correctedUV;
        result.missingDonor=missingDonor;result.skippedSaved=skippedSaved;result.skippedCurrent=skippedCurrent;
        // Log successful acceptance even during the initial read-only Set
        // material planning pass, otherwise a skipped native reload leaves no
        // evidence in Last Report explaining why it was safe to skip.
        if(emitLog===true||result.passed){
            log(result.passed?"WARN":"INFO",
                result.passed?"GEO_SET_DAZ625_SHELL_NEUTRAL_COMPAT":"GEO_SET_DAZ625_SHELL_NEUTRAL_REJECT",
                item.name+" | zeroUnmappedFields="+accepted+" | nativeUVOrdinals="+correctedUV+
                " | absentDonorSurfaces="+missingDonor+" | skippedShaderSaved="+skippedSaved+
                " | skippedShaderCurrent="+skippedCurrent+
                " | native name/value proof; unchanged other materials; unreadable shader fields not verified"+
                (rejected.length?" | reasons="+rejected.join("; "):""));
        }
        return result;
    }
    // DAZ4 composite Saved Set material restore compatibility. Import and
    // saved-style restoration are different checkpoints. The former already
    // has an independently certified native omitted-zero check for the graft
    // and a nested DzFigure child. Reuse those SAME primitives here, with
    // FRESH saved-style snapshots and strict PartID/native attachment proofs.
    //
    // No global comparator change, no material setters, no tolerance for
    // changed colors/UV/texture/maps, no catalog writes and no rollback waiver.
    function geoDaz424CompositeSetNeutralProof(item,inf,saved,fig,emitLog){
        var rejected=[],accepted=0,checked=0,childWithOmissions=0,nestedChildren=0;
        function refuse(reason){if(rejected.length<10)rejected.push(String(reason));}
        var result={passed:false,acceptedCount:0,partsChecked:0,childWithOmissions:0,reasons:rejected};
        if(!item||!inf||!inf.root||!inf.parts||!saved||!fig||
           !Array.isArray(item.parts)||item.parts.length<2||
           !Array.isArray(saved.parts)||saved.parts.length!==item.parts.length||
           !/^4\.24(?:\.|$)/.test(String(App.versionString))||
           !geoTransferIsAttached(fig,inf.root))return result;
        var specs={},savedParts={},roots=0,si;
        for(si=0;si<item.parts.length;si++){
            var spec=item.parts[si];
            if(!spec||typeof spec.id!=="string"||!spec.id||own(specs,"$"+spec.id)){
                refuse("invalid or duplicated registered PartID");break;
            }
            specs["$"+spec.id]=spec;
            if(spec.root){roots++;if(!same(inf.parts[spec.id],inf.root))refuse("registered root does not match attached graft");}
        }
        if(roots!==1)refuse("composite must have exactly one registered graft root");
        if(rejected.length)return result;
        for(si=0;si<saved.parts.length;si++){
            var row=saved.parts[si],part=row&&specs["$"+row.partID],node=row&&inf.parts[row.partID];
            if(!row||!part||own(savedParts,"$"+row.partID)||!node){
                refuse("missing, foreign or repeated Saved Set PartID");break;
            }
            savedParts["$"+row.partID]=true;
            // Every child belongs to this one *currently attached* graft.
            // Do not certify a foreign part by matching just its label/name.
            if(!part.root){
                if(typeof node.getNodeParent!=="function"){
                    refuse("child parent hierarchy unavailable");break;
                }
                var parent=node.getNodeParent(),nested=false;
                for(var depth=0;parent&&depth<128;depth++){
                    if(same(parent,inf.root)){nested=true;break;}
                    if(typeof parent.getNodeParent!=="function")break;
                    parent=parent.getNodeParent();
                }
                if(!nested){refuse("child no longer nested under attached graft");break;}
                nestedChildren++;
            }
            var expected=row.snapshot;
            if(!expected||!Array.isArray(expected.surfaces)||
               typeof expected.skipped!=="number"||!isFinite(expected.skipped)||
               expected.skipped<0||Math.floor(expected.skipped)!==expected.skipped){
                refuse("invalid Saved Set material snapshot");break;
            }
            var actual=materials(node);
            if(!actual||!Array.isArray(actual.surfaces)||
               typeof actual.skipped!=="number"||!isFinite(actual.skipped)||
               actual.skipped<0||Math.floor(actual.skipped)!==actual.skipped){
                refuse("fresh native material snapshot unavailable");break;
            }
            var differences=materialDifferences(expected.surfaces,actual.surfaces);
            if(differences.length){
                // Set proof never accepts missing surfaces, extra controls,
                // changed maps or other material differences, even if another
                // import-only policy could accept them.
                for(var di=0;di<differences.length;di++){
                    var diff=differences[di],base=String(diff.field).replace(/\|map$/,""),
                        known=base==="DrawStyleOverride"||base==="Displacement Adaptive Quality";
                    if(diff.category!=="missing_property"||!known){
                        refuse("unrelated material difference: "+diff.surface+" / "+diff.field+
                            " ("+diff.category+")");break;
                    }
                }
                if(rejected.length)break;
                var api=materialAPIDetails(node,differences);
                if(!api||api.shapeAvailable!==true||!Array.isArray(api.issues)||
                   api.issues.length||!Array.isArray(api.surfaces)){
                    refuse("native material capability evidence unavailable");break;
                }
                var decision=classifyMaterialImport(expected,actual,api,String(App.versionString),false);
                if(!decision.passed&&!part.root){
                    // The child-specific native proof also certifies the
                    // absence of zero/unmapped controls on non-Iray shaders.
                    // Suppress its import-only log label during Set restore.
                    decision=geoDaz424CompositeChildNeutralProof(item,part,inf.parts,fig,
                        expected,actual,api,decision,true);
                }
                if(!decision.passed||!Array.isArray(decision.acceptedDifferences)||
                   decision.acceptedDifferences.length!==differences.length){
                    refuse("native named-zero proof rejected part: "+part.name);break;
                }
                // Certify the live native state still matches the one proved
                // by the individual legacy/child capability checker.
                if(!closeNumbers(materials(node),actual)){
                    refuse("native materials changed during proof: "+part.name);break;
                }
                accepted+=decision.acceptedDifferences.length;
                if(!part.root)childWithOmissions++;
            }
            checked++;
        }
        result.passed=!rejected.length&&checked===saved.parts.length&&
            accepted>0&&nestedChildren>0;
        result.acceptedCount=accepted;result.partsChecked=checked;
        result.childWithOmissions=childWithOmissions;
        if(emitLog===true||result.passed)log(result.passed?"WARN":"INFO",
            result.passed?"GEO_SET_DAZ424_COMPOSITE_COMPAT":"GEO_SET_DAZ424_COMPOSITE_REJECT",
            item.name+" | parts="+checked+" | neutralOmissions="+accepted+
            " | childParts="+childWithOmissions+
            " | immutable Saved Set snapshot; native properties verified; " +
            "unreadable shader data/render equivalence not proven"+
            (rejected.length?" | reasons="+rejected.join("; "):""));
        return result;
    }
    function autoSetMaterialStatus(item,inf,saved,fig,emitProof){
        var exact=setMaterialsMatchSnapshot(item,inf,saved,fig);
        exact.compatible=false;
        if(!exact.changed.length)return exact;
        if(!Array.isArray(saved.parts)||!saved.parts.length)return exact;
        if(/^6\.25(?:\.|$)/.test(String(App.versionString))){
            var added=null;
            try{added=geoDaz625GraftSetExtraProof(item,inf,saved,fig,emitProof===true);}
            catch(nativeAddedError){
                if(emitProof===true)log("INFO","GEO_SET_DAZ625_EXTRA_NEUTRAL_REJECT",
                    item.name+" | native property proof unavailable: "+errorText(nativeAddedError));
            }
            if(added&&added.passed)return {changed:[],incomplete:exact.incomplete,
                equivalentPaths:exact.equivalentPaths,topologyMissing:exact.topologyMissing,compatible:true};
            // A registered GeoShell is not a graft root. It needs its own
            // native, target-scoped proof for the same zero viewport control.
            // This also validates genuine UV-name equivalence and complete
            // absent-donor surface groups before accepting a Saved Set.
            var shellProof=null;
            if(geoSetRestoreNativeShell(item,inf,fig)){
                try{shellProof=geoDaz625ShellSetNeutralProof(item,inf,saved,fig,emitProof===true);}
                catch(nativeShellError){
                    if(emitProof===true)log("INFO","GEO_SET_DAZ625_SHELL_NEUTRAL_REJECT",
                        item.name+" | native shell proof unavailable: "+errorText(nativeShellError));
                }
            }
            if(shellProof&&shellProof.passed)return {changed:[],incomplete:exact.incomplete,
                equivalentPaths:exact.equivalentPaths,topologyMissing:exact.topologyMissing,compatible:true};
            return exact;
        }
        if(!/^4\.24(?:\.|$)/.test(String(App.versionString)))return exact;
        // Legacy native import proof is the first, stronger compatibility
        // method. The Set-only viewport proof below is a tightly scoped
        // fallback for material classes that omit the zero-valued control.
        var legacyOK=true;
        try{
            for(var i=0;i<saved.parts.length;i++){
                var spec=saved.parts[i],part=inf.parts[spec.partID];
                if(!part){legacyOK=false;break;}
                var current=materials(part),projected=geoProjectSetShellUVOrdinals(part,fig,spec.snapshot,current,false);
                var difference=materialDifferences(projected.surfaces,current.surfaces);
                var decision=classifyGeoShellLoadedMaterials(part,fig,projected,current,materialAPIDetails(part,difference),String(App.versionString));
                if(!decision.passed){legacyOK=false;break;}
            }
        }catch(ignoreLegacy){legacyOK=false;}
        if(legacyOK)return {changed:[],incomplete:exact.incomplete,equivalentPaths:exact.equivalentPaths,
            topologyMissing:exact.topologyMissing,compatible:true};
        // A composite attached GeoGraft is NOT a GeoShell. Native import has
        // already proved DAZ4's omitted neutral fields per child, but applying
        // Saved Set materials rereads a different immutable JSON snapshot.
        // Reconfirm it independently before trying the Shell-only fallback.
        if(item.parts.length>1&&inf.root&&geoTransferIsAttached(fig,inf.root)){
            var compositeProof=null;
            try{compositeProof=geoDaz424CompositeSetNeutralProof(item,inf,saved,fig,emitProof===true);}
            catch(compositeError){if(emitProof===true)log("INFO","GEO_SET_DAZ424_COMPOSITE_REJECT",
                item.name+" | native Saved Set proof unavailable: "+errorText(compositeError));}
            if(compositeProof&&compositeProof.passed)return {changed:[],incomplete:exact.incomplete,
                equivalentPaths:exact.equivalentPaths,topologyMissing:exact.topologyMissing,compatible:true};
        }
        var fallback=null;
        try{fallback=geoDaz424SetRestoreNamedProof(item,inf,saved,fig,emitProof===true);}
        catch(nativeError){
            if(emitProof===true)log("INFO","GEO_SET_DAZ424_NEUTRAL_REJECT",item.name+
                " | native property proof unavailable: "+errorText(nativeError));
        }
        if(fallback&&fallback.passed)return {changed:[],incomplete:exact.incomplete,
            equivalentPaths:exact.equivalentPaths.concat(fallback.equivalentPaths),
            topologyMissing:exact.topologyMissing,compatible:true};
        return exact;
    }
    function applySavedSetMaterials(st,fig){
        // A partial selection is never silently upgraded to a full style.
        if(!ctx||ctx.action!=="apply"||!hasSetMaterialSnapshots(st))return;
        requireUnscoped("auto_restore_set_materials");
        var inv=inventory(fig,app.db),saved=setMaterialSnapshots(st),changed=[],ok=0,compatible=0,missing=0;
        for(var i=0;i<st.items.length;i++){
            var id=st.items[i],record=saved[id];
            if(!record)continue;
            var item=app.db.items[id],inf=inv[id];
            if(!item||!inf||inf.where!=="active")throw problem("AUTO_MATERIAL_ITEM",String(id)+": not worn after Apply.");
            var status=autoSetMaterialStatus(item,inf,record,fig);
            if(!status.changed.length){
                ok++;if(status.compatible)compatible++;
                if(status.topologyMissing&&status.topologyMissing.length)log("WARN","AUTO_MATERIAL_GEOSHELL_TOPOLOGY",
                    item.name+" | absent donor-only surfaces="+status.topologyMissing.join(", ")+
                    " | existing materials match; native material preset not reapplied.");
                continue;
            }
            if(!record.nativePreset){
                missing++;
                log("WARN","AUTO_MATERIAL_NO_PRESET",item.name+" | material differs from saved JSON but no verified native preset was attached. Materials not changed.");
                continue;
            }
            // Do not silently ignore a deleted or unreadable preset; it was
            // explicitly attached to the catalog and must be accounted for.
            validateNativeMaterialPresetRelative(record.nativePreset);
            if(!readable(inLibrary(record.nativePreset)))throw problem("AUTO_MATERIAL_PRESET_MISSING",item.name+" | "+record.nativePreset);
            changed.push(id);
        }
        ctx.diag.autoMaterials={setID:st.id,restoreItems:changed.slice(0),alreadyMatching:ok,
            legacyCompatible:compatible,missingNativePresets:missing,partialExcluded:true};
        log("INFO","AUTO_MATERIAL_PLAN","set="+st.name+" | restore="+describeIDs(changed)+
            " | unchanged="+ok+" | legacyCompatible="+compatible+" | noNativePreset="+missing);
        if(!changed.length)return;
        // Uses one native batch transaction: all backups are created before
        // the first material import. Any failure rolls back ALL attempted
        // items; failure then bubbles into the normal wardrobe rollback.
        restoreSelectedItemMaterials(st,fig,changed,"full_apply");
        ctx.autoMaterialsRestored=changed.length;
        log("PASS","AUTO_MATERIAL_RESTORED",changed.length+" item(s) | set="+st.name);
    }
    function geoRestorePartialGraftMaterials(st,fig){
        if(!ctx||ctx.action!=="partial_apply"||!st.materialSnapshots)return;
        var inv=inventory(fig,app.db),ids=Object.keys(st.materialSnapshots),changed=[];
        for(var i=0;i<ids.length;i++){
            var id=ids[i],item=app.db.items[id],rec=st.materialSnapshots[id],inf=inv[id];
            if(!item||!inf||inf.where!=="active"||!geoIsGraft(fig,id,inf,st))continue;
            if(!rec||!rec.nativePreset)throw problem("GEO_PARTIAL_MATERIALS","Saved GeoGraft material preset missing: "+item.name);
            if(autoSetMaterialStatus(item,inf,rec,fig).changed.length)changed.push(id);
        }
        if(changed.length){
            restoreSelectedItemMaterials(st,fig,changed,"full_apply");
            log("PASS","GEO_PARTIAL_GRAFT_MATERIALS","Restored own materials of "+changed.length+" selected GeoGraft(s).");
        }
    }
    function materialRestorePicker(st,fig){
        var inv=inventory(fig,app.db),snapshots=setMaterialSnapshots(st),ids=st.items.slice(0);
        var dlg=newGeorgiaDialog(true);dlg.caption=TITLE+" - Restore Materials: "+st.name;
        var layout=new DzVBoxLayout(dlg);layout.margin=10;layout.spacing=10;
        var scroll=new DzScrollArea(dlg);scroll.widgetResizable=true;
        scroll.setHorizontalScrollbarDisplay(false);
        var listHeight=Math.max(42,Math.min(350,ids.length*42+14));
        scroll.setFixedSize(650,listHeight);scroll.setVerticalScrollbarDisplay(ids.length*42+14>350);layout.addWidget(scroll);
        var content=new DzWidget(scroll),contentLayout=new DzVBoxLayout(content);
        contentLayout.margin=10;contentLayout.spacing=10;
        content.setFixedHeight(Math.max(20,ids.length*42+10));scroll.setWidget(content);
        var checks=[],eligible=0;
        for(var i=0;i<ids.length;i++)(function(id){
            var item=app.db.items[id],record=snapshots[id],info=inv[id],cb=new DzPushButton(content);
            var ready=!!(record&&record.nativePreset&&readable(inLibrary(record.nativePreset))&&info&&info.where==="active");
            cb.text=(item?item.name:id)+(ready?"":"  - Not available (not worn or preset missing)");
            cb.setFixedHeight(32);cb.checkable=true;cb.autoDefault=false;cb.checked=false;cb.enabled=ready;
            contentLayout.addWidget(cb);wardrobeTransitionStyle(cb,false,ready);
            connect(cb,"clicked()",function(){wardrobeTransitionStyle(cb,!!cb.checked,ready);});
            cb.toolTip=ready?"Restore this item's saved material preset.":"Wear the item and save a native Material Preset first.";
            if(ready)eligible++;
            checks.push({id:id,check:cb,ready:ready});
        })(ids[i]);
        var unavailable=null;
        if(!eligible){unavailable=label(dlg,"No native material presets available for currently worn items.");unavailable.setFixedHeight(32);layout.addWidget(unavailable);}
        var footer=new DzWidget(dlg),footerLayout=new DzHBoxLayout(footer);
        footerLayout.margin=0;footerLayout.spacing=10;footer.setFixedHeight(34);layout.addWidget(footer);
        var all=new DzPushButton(footer),none=new DzPushButton(footer),restore=new DzPushButton(footer),close=new DzPushButton(footer);
        all.text="Select All";none.text="Unselect All";restore.text="Restore Materials Selected";close.text="Cancel";
        all.setFixedSize(110,34);none.setFixedSize(110,34);restore.setFixedSize(210,34);close.setFixedSize(100,34);
        footerLayout.addStretch(1);footerLayout.addWidget(all);footerLayout.addWidget(none);footerLayout.addWidget(restore);footerLayout.addWidget(close);footerLayout.addStretch(1);
        all.autoDefault=false;none.autoDefault=false;restore.autoDefault=false;close.autoDefault=false;
        all.enabled=eligible>0;none.enabled=eligible>0;restore.enabled=eligible>0;
        function selectItems(selected){for(var c=0;c<checks.length;c++){var row=checks[c];row.check.checked=selected&&row.ready;wardrobeTransitionStyle(row.check,!!row.check.checked,row.ready);}}
        connect(all,"clicked()",function(){selectItems(true);});connect(none,"clicked()",function(){selectItems(false);});
        var chosen=null;
        connect(restore,"clicked()",function(){
            var selected=[];for(var c=0;c<checks.length;c++)if(checks[c].ready&&checks[c].check.checked)selected.push(checks[c].id);
            if(!selected.length){MessageBox.information("Select at least one item.",TITLE,"&OK");return;}
            chosen=selected;dlg.close();
        });
        connect(close,"clicked()",function(){dlg.close();});
        var details=new DzPushButton(dlg);details.text="View Material Diagnostics...";details.setFixedHeight(30);
        layout.addWidget(details);details.autoDefault=false;connect(details,"clicked()",function(){
            try{var d=diagnoseSetMaterials(st,fig);MessageBox.information(materialDiagnosticText(st,d),TITLE+" - Material Diagnostics","&OK");}
            catch(e){MessageBox.warning(userErrorText(e),TITLE,"&OK");}
        });
        var note=label(dlg,"Material presets are backed up and verified before and after restoration.");
        note.wordWrap=true;note.setFixedHeight(32);layout.addWidget(note);
        dlg.setFixedSize(670,listHeight+146+(unavailable?42:0));
        try{dlg.exec();}finally{dlg.deleteLater();}
        return chosen;
    }
    function materialOptionalScalar(object, method) {
        if (!object || typeof object[method] !== "function") return {available:false, reason:"getter unavailable"};
        try {
            var v = object[method]();
            if (v === null || typeof v === "number" || typeof v === "boolean" || typeof v === "string")
                return {available:true, type:materialType(v,true), value:materialReportValue(v)};
            return {available:false, reason:"non-scalar getter result", type:typeof v};
        } catch (e) { return {available:false, reason:errorText(e)}; }
    }
    function materialAPIDetails(node, differences) {
        var out = {sampleTiming:"Read after the value snapshot. Exact equality uses values only; legacy compatibility additionally requires these capability checks.",surfaces:[],issues:[]};
        try {
            var object = node.getObject(), shape = object ? object.getCurrentShape() : null;
            if (!shape) { out.shapeAvailable=false; return out; }
            out.shapeAvailable=true;
            var mats = shape.getAllMaterials();
            for (var i = 0; i < mats.length; i++) {
                var mat = mats[i], name = String(mat.name), relevant = {}, inspectAll = false, needed = false;
                for (var d = 0; d < differences.length; d++) if (differences[d].surface === name || differences[d].surface === "<snapshot>") {
                    needed=true; relevant["$"+differences[d].field.replace(/\|map$/,"")]=true;
                    if (differences[d].field === "surface" || differences[d].surface === "<snapshot>") inspectAll=true;
                }
                if (!needed) continue;
                var ms = {name:name,classInfo:materialOptionalScalar(mat,"className"),
                    shaderType:materialOptionalScalar(mat,"getMaterialName"),properties:[],propertyNames:[]};
                out.surfaces.push(ms);
                var props = mat.getPropertyList(), uv = mat.getUVSetControl();
                ms.uv = {controlName:uv ? String(uv.name) : "", value:materialOptionalScalar(uv,"getValue"),
                    stringValue:materialOptionalScalar(uv,"getStringValue")};
                for (var p = 0; p < props.length; p++) {
                    var pr = props[p], pn = String(pr.name); ms.propertyNames.push(pn);
                    if (!inspectAll && !own(relevant,"$"+pn) && !(uv && pr === uv)) continue;
                    var pd = {name:pn, classInfo:materialOptionalScalar(pr,"className"),label:materialOptionalScalar(pr,"getLabel"),
                        value:materialOptionalScalar(pr,"getValue"), stringValue:materialOptionalScalar(pr,"getStringValue"),
                        rawValue:materialOptionalScalar(pr,"getRawValue")};
                    if (typeof pr.getMapValue === "function") {
                        try {
                            var map = pr.getMapValue();
                            pd.map = {present:!!map, filename:materialOptionalScalar(map,"getFilename"),classInfo:materialOptionalScalar(map,"className")};
                        } catch(e2) { pd.map={available:false,reason:errorText(e2)}; }
                    }
                    ms.properties.push(pd);
                }
            }
        } catch(e) { out.issues.push(errorText(e)); }
        return out;
    }
    function captureLoadedMaterialSnapshots(it, parts) {
        var out = {};
        for (var i = 0; i < it.parts.length; i++) {
            var p = it.parts[i]; if (!parts[p.id]) throw problem("MATERIAL_PART_MISSING", p.name);
            out[p.id] = materials(parts[p.id]);
        }
        return out;
    }
    function classifyLegacyMaterialImport(expected, actual, api, runtimeVersion, verifiedTargetShellPartialReads) {
        // Evidence: DAZ 4.24 native reports have these two absent controls
        // (numeric 0, empty maps) on Iray Uber surfaces. Some surfaces (e.g.
        // hair ties) lack the separate Displacement Strength channel as well.
        // Daz's v6 changelog documents the DrawStyle Override addition:
        // https://docs.daz3d.com/public/software/dazstudio/6/change_log
        // No general "missing means zero", no guessing aliases, and no filtering
        // in materials(), measured(), compareMeasured(), or the on-disk catalog.
        var diffs=materialDifferences(expected.surfaces,actual.surfaces);
        var result={exactMatch:closeNumbers(expected.surfaces,actual.surfaces),passed:false,
            policy:"daz424_iray_zero_unsupported_v2",differences:diffs,
            acceptedDifferences:[],blockingDifferences:diffs.slice(0),rules:[]};
        result.passed=result.exactMatch;
        if(result.exactMatch)return result;
        // Deliberately limited to the tested legacy version family, not every
        // future/older host with an unknown shader implementation.
        if(!/^4\.24(?:\.|$)/.test(String(runtimeVersion)))return result;
        // A Geometry Shell can have unrelated shader controls that are
        // not readable by scalarProperties() on either DAZ version. Never
        // assume skipped values are zero or equal. DAZ4 named omissions may
        // be accepted ONLY after their own missing-property native API proof,
        // and ONLY on a Geometry Shell targeting this selected figure.
        // Every other comparable value remains covered by the full comparator.
        if((expected.skipped!==0||actual.skipped!==0)&&verifiedTargetShellPartialReads!==true)return result;
        if(!api||api.shapeAvailable!==true||
            !Array.isArray(api.issues)||api.issues.length||!Array.isArray(api.surfaces)||
            !Array.isArray(expected.surfaces)||!Array.isArray(actual.surfaces)||
            typeof expected.skipped!=="number"||!isFinite(expected.skipped)||expected.skipped<0||
            Math.floor(expected.skipped)!==expected.skipped||
            typeof actual.skipped!=="number"||!isFinite(actual.skipped)||actual.skipped<0||
            Math.floor(actual.skipped)!==actual.skipped)return result;
        function indexUnique(list){
            var out={};
            for(var i=0;i<list.length;i++){
                var row=list[i];
                if(!row||typeof row.name!=="string"||own(out,"$"+row.name))return null;
                out["$"+row.name]=row;
            }
            return out;
        }
        var em=indexUnique(expected.surfaces),am=indexUnique(actual.surfaces),dm=indexUnique(api.surfaces);
        if(!em||!am||!dm)return result;
        var projected=clonePlain(expected.surfaces),pm=indexUnique(projected),acceptedKeys={};
        var names=Object.keys(em),controls=["DrawStyleOverride","Displacement Adaptive Quality"];
        for(var n=0;n<names.length;n++){
            var sk=names[n],e=em[sk],a=am[sk],cap=dm[sk];
            if(!a||!cap||!cap.classInfo||cap.classInfo.available!==true||
                cap.classInfo.value!=="DzUberIrayMaterial"||!cap.shaderType||
                cap.shaderType.available!==true||cap.shaderType.value!=="Iray Uber"||
                !Array.isArray(cap.propertyNames))continue;
            var ev=e.values,av=a.values;
            if(!ev||!av||typeof ev!=="object"||typeof av!=="object"||Array.isArray(ev)||Array.isArray(av))continue;
            var validNames=true,seenNames={};
            for(var pn=0;pn<cap.propertyNames.length;pn++){
                var propName=cap.propertyNames[pn];
                if(typeof propName!=="string"||own(seenNames,"$"+propName)){validNames=false;break;}
                seenNames["$"+propName]=true;
            }
            if(!validNames||!cap.propertyNames.length)continue;
            for(var c=0;c<controls.length;c++){
                var field=controls[c],mapField=field+"|map";
                // Both entries must exist in the catalog with EXACT neutral
                // values, and both must be absent in the runtime snapshot/API.
                if(!own(ev,field)||typeof ev[field]!=="number"||ev[field]!==0||
                    !own(ev,mapField)||ev[mapField]!==""||own(av,field)||own(av,mapField)||
                    own(seenNames,"$"+field)||own(seenNames,"$"+mapField))continue;
                // This DAZ4-only absent quality control has saved value 0 and
                // no map. It may also be missing on surfaces without a separate
                // Displacement Strength channel. Compare that channel and its
                // map when present; do not invent defaults or waive an actual
                // strength/map change. The final projected full-snapshot
                // comparison still enforces every OTHER property, map and UV.
                if(field==="Displacement Adaptive Quality"&&
                    (!closeNumbers(ev["Displacement Strength"],av["Displacement Strength"])||
                     !closeNumbers(ev["Displacement Strength|map"],av["Displacement Strength|map"])))continue;
                delete pm[sk].values[field];delete pm[sk].values[mapField];
                acceptedKeys[JSON.stringify([e.name,field])]=true;
                acceptedKeys[JSON.stringify([e.name,mapField])]=true;
                result.rules.push({surface:e.name,property:field,catalogValue:0,catalogMap:"",
                    runtimePropertyPresent:false,materialClass:cap.classInfo.value,shader:cap.shaderType.value,
                    reason:field==="DrawStyleOverride"?"Absent legacy viewport override, saved zero and unmapped":
                    "Absent legacy adaptive-quality control, saved zero/unmapped; any exposed displacement inputs unchanged",
                    guarantee:"Limited import compatibility only; identical rendering is not asserted"});
            }
        }
        for(var d=0;d<diffs.length;d++){
            var diff=diffs[d];
            if(diff.category==="missing_property"&&own(acceptedKeys,JSON.stringify([diff.surface,diff.field])))
                result.acceptedDifferences.push(clonePlain(diff));
        }
        // A disposable comparison projection is the ONLY modified value here.
        // Re-run the full existing comparator to catch even array-layout/schema
        // differences that might otherwise be hidden behind named omissions.
        result.blockingDifferences=materialDifferences(projected,actual.surfaces);
        result.passed=closeNumbers(projected,actual.surfaces);
        if(result.passed && result.acceptedDifferences.length &&
            (expected.skipped>0 || actual.skipped>0)){
            // This is evidence for named neutral omissions, not a waiver for
            // unreadable shader values. Preserve source/runtime skip counts
            // and make the partial coverage visible in diagnostics.json.
            result.rules.push({kind:"daz424_target_geoshell_partial_snapshot",
                expectedSkipped:expected.skipped,actualSkipped:actual.skipped,
                scope:"Native import only; independent fresh evidence for every accepted missing property",
                guarantee:"Skipped/unreadable shader controls remain unverified; no rendering equivalence claimed"});
        }
        return result;
    }
    function materialImportPolicyID(runtimeVersion) {
        if (/^4\.24(?:\.|$)/.test(String(runtimeVersion))) return "daz424_iray_zero_unsupported_v2";
        if (/^6\.25(?:\.|$)/.test(String(runtimeVersion))) return "daz625_iray_zero_added_v1";
        return "exact_import_only";
    }
    function classifyMaterialImport(expected, actual, api, runtimeVersion, verifiedTargetShellPartialReads) {
        // Preserve the old DAZ4 rule in its own unchanged function. This
        // dispatcher is used ONLY for native import, never scene comparisons.
        var r = /^6\.25(?:\.|$)/.test(String(runtimeVersion)) ?
            classifyAddedMaterialImport(expected, actual, api) :
            classifyLegacyMaterialImport(expected, actual, api, runtimeVersion, verifiedTargetShellPartialReads);
        r.policy = materialImportPolicyID(runtimeVersion) +
            (r.passed && r.rules.some(function(rule){return rule.kind==="daz424_target_geoshell_partial_snapshot";}) ?
                "+target_geoshell_partial_native_proof_v1" : "");
        r.acceptedOmissionCount = 0; r.acceptedAdditionCount = 0;
        for (var i = 0; i < r.acceptedDifferences.length; i++) {
            if (r.acceptedDifferences[i].category === "missing_property") r.acceptedOmissionCount++;
            if (r.acceptedDifferences[i].category === "extra_property") r.acceptedAdditionCount++;
        }
        return r;
    }
    function classifyAddedMaterialImport(expected, actual, api) {
        // Native report 2026-10-05: DAZ6.25 exposed these two additional controls
        // as number 0 + empty map on four Bustier surfaces. This is NOT proof of
        // source DAZ version (legacy catalog does not record it), nor proof of
        // render equivalence. API checks below are additional requirements.
        var diffs = materialDifferences(expected.surfaces, actual.surfaces);
        var r = {exactMatch:closeNumbers(expected.surfaces, actual.surfaces),passed:false,
            policy:"daz625_iray_zero_added_v1",differences:diffs,acceptedDifferences:[],
            blockingDifferences:diffs.slice(0),rules:[],rejections:[]};
        r.passed = r.exactMatch;
        if (r.exactMatch) return r;
        function reject(surface, property, reason) {
            r.rejections.push({surface:surface,property:property,reason:reason});
        }
        if (expected.skipped !== 0 || actual.skipped !== 0 || !api || api.shapeAvailable !== true ||
            !Array.isArray(api.issues) || api.issues.length || !Array.isArray(api.surfaces) ||
            !Array.isArray(expected.surfaces) || !Array.isArray(actual.surfaces)) {
            reject("<snapshot>","<all>","INCOMPLETE_SNAPSHOT_OR_API_COVERAGE"); return r;
        }
        function indexUnique(list) {
            var out = {};
            for (var i = 0; i < list.length; i++) {
                var row = list[i];
                if (!row || typeof row.name !== "string" || own(out,"$"+row.name)) return null;
                out["$"+row.name] = row;
            }
            return out;
        }
        function inactiveDisplacement(v) {
            return own(v,"Displacement Strength") && typeof v["Displacement Strength"] === "number" &&
                v["Displacement Strength"] === 0 && own(v,"Displacement Strength|map") && v["Displacement Strength|map"] === "";
        }
        var em=indexUnique(expected.surfaces), am=indexUnique(actual.surfaces), dm=indexUnique(api.surfaces);
        if (!em || !am || !dm) { reject("<snapshot>","<all>","DUPLICATE_OR_INVALID_SURFACE_NAME"); return r; }
        // Only a disposable runtime projection is changed. The saved snapshot
        // and native material retain EVERY property, including accepted extras.
        var projected=clonePlain(actual.surfaces), pm=indexUnique(projected), accepted={};
        var names=Object.keys(em), fields=["DrawStyleOverride","Displacement Adaptive Quality"];
        for (var i=0;i<names.length;i++) {
            var sk=names[i], e=em[sk], a=am[sk], cap=dm[sk];
            if (!a) continue;
            var ev=e.values, av=a.values;
            if (!ev || !av || typeof ev!=="object" || typeof av!=="object" || Array.isArray(ev) || Array.isArray(av)) continue;
            var relevant=false;
            for (var p=0;p<fields.length;p++) if (!own(ev,fields[p]) && own(av,fields[p])) relevant=true;
            if (!relevant) continue;
            if (!cap || !cap.classInfo || cap.classInfo.available!==true || cap.classInfo.value!=="DzUberIrayMaterial" ||
                !cap.shaderType || cap.shaderType.available!==true || cap.shaderType.value!=="Iray Uber" ||
                !Array.isArray(cap.propertyNames) || !Array.isArray(cap.properties)) {
                reject(e.name,"<all>","IRAY_MATERIAL_CAPABILITIES_NOT_CONFIRMED"); continue;
            }
            var seen={}, valid=cap.propertyNames.length>0;
            for (var pn=0;pn<cap.propertyNames.length;pn++) {
                var name=cap.propertyNames[pn];
                if (typeof name!=="string" || own(seen,"$"+name)) {valid=false;break;}
                seen["$"+name]=true;
            }
            var details=indexUnique(cap.properties);
            if (!valid || !details) { reject(e.name,"<all>","PROPERTY_LIST_AMBIGUOUS"); continue; }
            for (var f=0;f<fields.length;f++) {
                var field=fields[f], mapField=field+"|map";
                if (own(ev,field) || own(ev,mapField)) continue; // never forgive a value change
                if (!own(av,field) && !own(av,mapField)) continue;
                if (!own(av,field) || typeof av[field]!=="number" || av[field]!==0 ||
                    !own(av,mapField) || av[mapField]!=="") {
                    reject(e.name,field,"EXTRA_PAIR_MUST_BE_EXACT_NUMERIC_ZERO_AND_EMPTY_MAP"); continue;
                }
                var pd=details["$"+field];
                if (!own(seen,"$"+field) || own(seen,"$"+mapField) || !pd ||
                    !pd.value || pd.value.available!==true || pd.value.type!=="number" || pd.value.value!==0 ||
                    !pd.map || pd.map.available===false || pd.map.present!==false) {
                    reject(e.name,field,"FRESH_API_VALUE_OR_UNMAPPED_STATE_NOT_CONFIRMED"); continue;
                }
                delete pm[sk].values[field]; delete pm[sk].values[mapField];
                accepted[JSON.stringify([e.name,field])]=true;
                accepted[JSON.stringify([e.name,mapField])]=true;
                r.rules.push({surface:e.name,property:field,catalogPropertyPresent:false,runtimePropertyPresent:true,
                    runtimeValue:0,runtimeMap:"",materialClass:cap.classInfo.value,shader:cap.shaderType.value,
                    reason:field==="DrawStyleOverride"?"Additional DAZ6.25 zero/unmapped viewport override":
                        "Additional DAZ6.25 zero/unmapped adaptive-quality control; 0 requests no additional adaptive subdivision",
                    guarantee:"Named import compatibility only. Not exact equality or identical rendering."});
            }
        }
        for (var d=0;d<diffs.length;d++) if (diffs[d].category==="extra_property" && own(accepted,JSON.stringify([diffs[d].surface,diffs[d].field])))
            r.acceptedDifferences.push(clonePlain(diffs[d]));
        r.blockingDifferences=materialDifferences(expected.surfaces,projected);
        r.passed=closeNumbers(expected.surfaces,projected);
        return r;
    }

    // On the original catalog, preserve EVERY difference. Only compare a
    // temporary projection without donor-only graft surfaces; do not alter the
    // saved item definition, set snapshot, native DUF, or real Geometry Shell.
    function classifyGeoShellLoadedMaterials(node,fig,expected,actual,api,runtime) {
        // Only a natively targeted Geometry Shell may take the DAZ4
        // named-zero compatibility path with incomplete snapshot coverage.
        // Ordinary clothing, detached shells, and graft nodes retain the
        // former strict skipped-read gate. Do not cache node/target identity.
        var partialShellProof=false;
        if(expected && actual && (expected.skipped>0 || actual.skipped>0))try{
            partialShellProof=!!(node&&fig&&typeof node.inherits==="function"&&
                node.inherits("DzGeometryShellNode")&&typeof node.getTarget==="function"&&
                same(node.getTarget(),fig));
        }catch(ignoreTarget){partialShellProof=false;}
        var original=classifyMaterialImport(expected,actual,api,runtime,partialShellProof);
        if(original.passed)return original;
        var topology=geoDonorOnlyShellSurfaces(node,fig,expected,actual);
        if(!topology.names.length)return original;
        var omit={};for(var i=0;i<topology.names.length;i++)omit["$"+topology.names[i]]=true;
        var projected={skipped:expected.skipped,surfaces:[]};
        for(i=0;i<expected.surfaces.length;i++)if(!own(omit,"$"+expected.surfaces[i].name))
            projected.surfaces.push(expected.surfaces[i]);
        var remainder=classifyMaterialImport(projected,actual,api,runtime,partialShellProof);
        if(!remainder.passed)return original;
        var accepted=[];
        for(i=0;i<original.differences.length;i++)if(original.differences[i].category==="missing_surface"&&
            own(omit,"$"+original.differences[i].surface))accepted.push(clonePlain(original.differences[i]));
        original.passed=true;original.acceptedDifferences=accepted.concat(remainder.acceptedDifferences);
        original.blockingDifferences=remainder.blockingDifferences;
        original.rules=[{kind:"native_shell_graft_topology",acceptedAbsentSurfaces:topology.names.slice(0),
            donorGroupPrefixes:topology.prefixes.slice(0),
            reason:"Captured donor GeoGraft surface groups absent from this native shell target; all remaining comparable materials verified",
            guarantee:"NOT exact material equivalence; unexposed shader channels and absent donor surfaces are NOT verified"}]
            .concat(remainder.rules);
        original.policy="geoshell_donor_only_surface_groups_v1 + "+remainder.policy;
        original.acceptedTopologySurfaceCount=accepted.length;
        original.topologyMissing=topology.names.slice(0);
        original.topologyPrefixes=topology.prefixes.slice(0);
        original.rejections=remainder.rejections||[];
        return original;
    }

    // Import-only DAZ 4.24 GeoShell proof. The previously accepted Set
    // material path works with three independent, *named* native facts; the
    // legacy import policy on its own cannot prove their combination.
    // This wrapper is called ONLY during loadItem() material verification,
    // after the imported logical parts and portable references are validated.
    // It never repairs materials and cannot change the saved definition.
    function geoDaz424ImportedShellMaterialProof(it,spec,node,fig,expected,actual,prior){
        if(!it||!spec||!node||!fig||!prior||prior.passed||
           !/^4\.24(?:\.|$)/.test(String(App.versionString))||
           typeof node.inherits!=="function"||!node.inherits("DzGeometryShellNode"))return prior;
        var matched=false;
        try{matched=typeof node.getTarget==="function"&&same(node.getTarget(),fig);}
        catch(ignoreTarget){matched=false;}
        if(!matched){
            log("INFO","GEO_IMPORT_DAZ424_NATIVE_PROOF_REJECT",it.name+" / "+spec.name+
                " | imported GeoShell is not natively targeted at the selected figure");
            return prior;
        }
        // An inconsistent fresh read cannot be converted into compatibility.
        // The first comparison must refer to the same observed material state.
        var reread=materials(node);
        if(!closeNumbers(actual,reread)){
            log("INFO","GEO_IMPORT_DAZ424_NATIVE_PROOF_REJECT",it.name+" / "+spec.name+
                " | material snapshot changed across fresh native observations");
            return prior;
        }
        var partMap={};partMap[spec.id]=node;
        var record={parts:[{partID:spec.id,snapshot:expected}]};
        var proof=geoDaz424SetRestoreNamedProof(it,{parts:partMap},record,fig,false);
        if(!proof.passed){
            log("INFO","GEO_IMPORT_DAZ424_NATIVE_PROOF_REJECT",it.name+" / "+spec.name+
                " | remaining material fields not proved identical | reasons="+
                (proof.reasons&&proof.reasons.length?proof.reasons.join("; "):"native proof incomplete"));
            return prior;
        }
        var topology=geoDonorOnlyShellSurfaces(node,fig,expected,actual),missing={},allowed=[],
            neutral=0,uvOrdinal=0,absentDonor=0,equivalentPaths=0,unknown=[];
        for(var g=0;g<topology.names.length;g++)missing["$"+topology.names[g]]=true;
        var projected=geoProjectSetShellUVOrdinals(node,fig,expected,actual,false),byName={};
        for(var p=0;p<projected.surfaces.length;p++){
            var row=projected.surfaces[p];
            if(!row||typeof row.name!=="string"||own(byName,"$"+row.name))return prior;
            byName["$"+row.name]=row;
        }
        for(var d=0;d<prior.differences.length;d++){
            var diff=prior.differences[d],accepted=false,saved=byName["$"+diff.surface];
            if(diff.category==="missing_surface" && own(missing,"$"+diff.surface)){
                absentDonor++;accepted=true;
            }else if(diff.category==="missing_property" &&
                     /^(DrawStyleOverride|Displacement Adaptive Quality)(\|map)?$/.test(diff.field)){
                // geoDaz424SetRestoreNamedProof individually validated both
                // absent properties, zero/unmapped saved values and the real
                // native material/property class on EVERY surviving surface.
                neutral++;accepted=true;
            }else if(diff.category==="value" && diff.field==="UV Set" && saved &&
                     saved.values && closeNumbers(saved.values["UV Set"],diff.actual)){
                // geoProjectSetShellUVOrdinals changes this disposable value
                // only after a fresh native name/ordinal confirmation.
                uvOrdinal++;accepted=true;
            }else if(diff.category==="texture_path"&&diff.expectedPresent&&diff.actualPresent&&
                     typeof diff.expected==="string"&&typeof diff.actual==="string"&&
                     materialMapSameExistingFile(diff.expected,diff.actual).match){
                equivalentPaths++;accepted=true;
            }
            if(accepted)allowed.push(clonePlain(diff));
            else if(unknown.length<6)unknown.push(diff.surface+" / "+diff.field+" ("+diff.category+")");
        }
        if(unknown.length || neutral!==proof.acceptedCount || absentDonor!==proof.topologyCount ||
           allowed.length!==prior.differences.length){
            log("INFO","GEO_IMPORT_DAZ424_NATIVE_PROOF_REJECT",it.name+" / "+spec.name+
                " | accepted="+allowed.length+" of "+prior.differences.length+
                " | missingNeutral="+neutral+" / "+proof.acceptedCount+
                " | donorSurfaces="+absentDonor+" / "+proof.topologyCount+
                " | unknown="+unknown.join("; "));
            return prior;
        }
        prior.passed=true;
        prior.acceptedDifferences=allowed;
        prior.blockingDifferences=[];
        prior.acceptedOmissionCount=neutral;
        prior.acceptedAdditionCount=0;
        prior.acceptedTopologySurfaceCount=absentDonor;
        prior.topologyMissing=topology.names.slice(0);
        prior.topologyPrefixes=topology.prefixes.slice(0);
        prior.policy="daz424_geo_shell_import_full_native_proof_v1";
        prior.rules=[{kind:"daz424_import_shell_native_named_proof",
            neutralOmissions:neutral,uvOrdinalDifferences:uvOrdinal,
            missingDonorSurfaces:topology.names.slice(0),equivalentCanonicalTexturePaths:equivalentPaths,
            reason:"Fresh native proof for every tolerated difference; all remaining comparable fields match",
            guarantee:"Only exposed materials verified; unreadable shader fields/render equivalence not proven"}];
        log("WARN","GEO_IMPORT_DAZ424_NATIVE_PROOF",it.name+" / "+spec.name+
            " | neutralMissing="+neutral+" | nativeUVOrdinals="+uvOrdinal+
            " | donorAbsent="+absentDonor+" | equivalentTexturePaths="+equivalentPaths+
            " | accepted="+allowed.length+" / "+prior.differences.length+
            " | saved catalog/materials unchanged; native read-only acceptance");
        return prior;
    }
    // Import-only DAZ 6.25 proof for a native Geometry Shell on the recipient.
    // UV controls are enum ordinals and may shift per figure even in one DAZ
    // runtime; only exact UV *names* with a fresh native control read qualify.
    // A separate native topology check must independently prove a FULL absent
    // donor GeoGraft group. All remaining exposed shader values and maps must
    // compare exactly; original catalog and native scene stay untouched.
    function geoDaz625ImportedShellUVTopologyProof(it,spec,node,fig,expected,actual,prior){
        if(!it||!spec||!node||!fig||!prior||prior.passed||
            !/^6\.25(?:\.|$)/.test(String(App.versionString)) ||
            typeof node.inherits!=="function"||!node.inherits("DzGeometryShellNode")||
            typeof node.getTarget!=="function"||!same(node.getTarget(),fig) ||
            !expected||!actual||!Array.isArray(expected.surfaces)||!Array.isArray(actual.surfaces) ||
            !Array.isArray(prior.differences)||!prior.differences.length)return prior;
        var differences=prior.differences,unknown=[];
        for(var i=0;i<differences.length;i++){
            var d=differences[i];
            if(!(d.category==="missing_surface" ||
                 (d.category==="value"&&d.field==="UV Set"))) {
                if(unknown.length<6)unknown.push(d.surface+" / "+d.field+" ("+d.category+")");
            }
        }
        if(unknown.length){
            log("INFO","GEO_IMPORT_DAZ625_UV_TOPOLOGY_REJECT",it.name+" / "+spec.name+
                " | additional material differences: "+unknown.join("; "));
            return prior;
        }
        var reread=materials(node);
        if(!closeNumbers(reread,actual)){
            log("INFO","GEO_IMPORT_DAZ625_UV_TOPOLOGY_REJECT",it.name+" / "+spec.name+
                " | native material snapshot changed across fresh reads");
            return prior;
        }
        var topology=geoDonorOnlyShellSurfaces(node,fig,expected,actual),excluded={},accepted=[],uvCount=0,donorCount=0;
        for(i=0;i<topology.names.length;i++)excluded["$"+topology.names[i]]=true;
        var normalized=geoProjectSetShellUVOrdinals(node,fig,expected,actual,false,true),survivors=[];
        for(i=0;i<normalized.surfaces.length;i++){
            var row=normalized.surfaces[i];
            if(!own(excluded,"$"+row.name))survivors.push(row);
        }
        // Compare *every* remaining exposed field and ensure no additional or
        // missing materials. No tolerance for shader, texture or numeric drift.
        if(materialDifferences(survivors,actual.surfaces).length){
            log("INFO","GEO_IMPORT_DAZ625_UV_TOPOLOGY_REJECT",it.name+" / "+spec.name+
                " | native UV/topology projection still differs in other fields");
            return prior;
        }
        for(i=0;i<differences.length;i++){
            var diff=differences[i];
            if(diff.category==="missing_surface"){
                if(!own(excluded,"$"+diff.surface))return prior;
                donorCount++;
            }else{
                var after=null;
                for(var j=0;j<normalized.surfaces.length;j++){
                    if(normalized.surfaces[j].name===diff.surface){after=normalized.surfaces[j];break;}
                }
                if(!after || !after.values || !closeNumbers(after.values["UV Set"],diff.actual))return prior;
                uvCount++;
            }
            accepted.push(clonePlain(diff));
        }
        if(!uvCount&&!donorCount)return prior;
        prior.passed=true;
        prior.acceptedDifferences=accepted;
        prior.blockingDifferences=[];
        prior.acceptedOmissionCount=0;
        prior.acceptedAdditionCount=0;
        prior.acceptedTopologySurfaceCount=donorCount;
        prior.topologyMissing=topology.names.slice(0);
        prior.topologyPrefixes=topology.prefixes.slice(0);
        prior.policy="daz625_geo_shell_import_native_uv_and_donor_topology_v1";
        prior.rejections=[];
        prior.rules=[{kind:"native_shell_uv_name_and_donor_topology",
            acceptedUVOrdinals:uvCount,absentDonorSurfaces:topology.names.slice(0),
            reason:"Identical fresh native UV Set names and complete absent donor group; all other exposed material values unchanged",
            guarantee:"Skipped/unreadable shader data and visual render equivalence are not asserted."}];
        log("WARN","GEO_IMPORT_DAZ625_UV_TOPOLOGY_PROOF",it.name+" / "+spec.name+
            " | uvOrdinals="+uvCount+" | absentDonorSurfaces="+donorCount+
            " | exactRemainingMaterials=true | original catalog and native materials unchanged");
        return prior;
    }
    // v0.9.10.35: DAZ 4.24 may omit neutral shader controls on the
    // registered DzFigure children of a natively attached composite GeoGraft,
    // even when the graft root itself passes daz424_iray_zero_unsupported_v2.
    // This is a deliberately NARROW import-only proof. Different child shader
    // classes are allowed ONLY when the complete native property list proves
    // both controls absent and every other saved material field still matches.
    // No changes to the catalog, native materials, raw material comparator,
    // Set restore verification, or rollback verification.
    function geoDaz424CompositeChildNeutralProof(item,spec,parts,fig,expected,actual,api,prior,suppressImportLog){
        if(!item||!spec||spec.root||!parts||!fig||!prior||prior.passed||
           !/^4\.24(?:\.|$)/.test(String(App.versionString))||
           !Array.isArray(item.parts)||item.parts.length<2||
           !expected||!actual||
           typeof expected.skipped!=="number"||!isFinite(expected.skipped)||
           expected.skipped<0||Math.floor(expected.skipped)!==expected.skipped||
           typeof actual.skipped!=="number"||!isFinite(actual.skipped)||
           actual.skipped!==expected.skipped||
           !Array.isArray(expected.surfaces)||!Array.isArray(actual.surfaces)||
           !Array.isArray(prior.differences)||!prior.differences.length||
           !api||api.shapeAvailable!==true||!Array.isArray(api.issues)||api.issues.length||
           !Array.isArray(api.surfaces))return prior;
        var root=null,rootCount=0;
        for(var i=0;i<item.parts.length;i++)if(item.parts[i].root){
            root=parts[item.parts[i].id];rootCount++;
        }
        var child=parts[spec.id];
        if(rootCount!==1||!root||!child||typeof root.inherits!=="function"||
           !root.inherits("DzFigure")||typeof child.inherits!=="function"||
           !child.inherits("DzFigure")||child.inherits("DzGeometryShellNode")||
           !geoTransferIsAttached(fig,root))return prior;
        var ancestor=child.getNodeParent(),nested=false;
        for(i=0;ancestor&&i<128;i++){
            if(same(ancestor,root)){nested=true;break;}
            ancestor=ancestor.getNodeParent();
        }
        if(!nested)return prior;
        function indexUnique(rows){
            var result={};
            for(var j=0;j<rows.length;j++){
                var row=rows[j];
                if(!row||typeof row.name!=="string"||own(result,"$"+row.name))return null;
                result["$"+row.name]=row;
            }
            return result;
        }
        var expectedMap=indexUnique(expected.surfaces),currentMap=indexUnique(actual.surfaces),
            nativeMap=indexUnique(api.surfaces),projected=clonePlain(expected.surfaces),
            projectedMap=indexUnique(projected);
        if(!expectedMap||!currentMap||!nativeMap||!projectedMap)return prior;
        var proposed={},diffs=prior.differences;
        for(i=0;i<diffs.length;i++){
            var diff=diffs[i],base=String(diff.field).replace(/\|map$/,""),
                k=JSON.stringify([diff.surface,base]);
            if(diff.category!=="missing_property"||
               (base!=="DrawStyleOverride"&&base!=="Displacement Adaptive Quality")||
               !own(expectedMap,"$"+diff.surface)||!own(currentMap,"$"+diff.surface)||
               !own(nativeMap,"$"+diff.surface))return prior;
            proposed[k]={surface:diff.surface,field:base};
        }
        var keys=Object.keys(proposed),accepted={};
        if(!keys.length)return prior;
        for(i=0;i<keys.length;i++){
            var target=proposed[keys[i]],sk="$"+target.surface,field=target.field,
                mapField=field+"|map",sv=expectedMap[sk].values,
                cv=currentMap[sk].values,cap=nativeMap[sk];
            if(!sv||!cv||typeof sv!=="object"||typeof cv!=="object"||
               Array.isArray(sv)||Array.isArray(cv)||
               !own(sv,field)||typeof sv[field]!=="number"||sv[field]!==0||
               !own(sv,mapField)||sv[mapField]!==""||
               own(cv,field)||own(cv,mapField)||
               !cap.classInfo||cap.classInfo.available!==true||
               typeof cap.classInfo.value!=="string"||!cap.classInfo.value||
               !Array.isArray(cap.propertyNames)||!cap.propertyNames.length)return prior;
            // Both property name aliases and exact native names count as
            // present. Never interpret an exposed native control as absent.
            var names={};
            for(var p=0;p<cap.propertyNames.length;p++){
                var nativeName=cap.propertyNames[p];
                if(typeof nativeName!=="string"||own(names,"$"+nativeName))return prior;
                names["$"+nativeName]=true;
                var normalized=nativeName.toLowerCase().replace(/[^a-z0-9]/g,"");
                if(normalized===field.toLowerCase().replace(/[^a-z0-9]/g,""))return prior;
            }
            if(field==="Displacement Adaptive Quality" &&
               (!closeNumbers(sv["Displacement Strength"],cv["Displacement Strength"])||
                !closeNumbers(sv["Displacement Strength|map"],cv["Displacement Strength|map"])))return prior;
            delete projectedMap[sk].values[field];
            delete projectedMap[sk].values[mapField];
            accepted[JSON.stringify([target.surface,field])]=true;
            accepted[JSON.stringify([target.surface,mapField])]=true;
        }
        // An additional fresh read ensures this native-property evidence
        // belongs to the material state that is being accepted.
        if(!closeNumbers(materials(child),actual))return prior;
        var remaining=materialDifferences(projected,actual.surfaces);
        if(remaining.length||!closeNumbers(projected,actual.surfaces))return prior;
        var acceptedRows=[];
        for(i=0;i<diffs.length;i++){
            if(!own(accepted,JSON.stringify([diffs[i].surface,diffs[i].field])))return prior;
            acceptedRows.push(clonePlain(diffs[i]));
        }
        prior.passed=true;prior.acceptedDifferences=acceptedRows;
        prior.blockingDifferences=[];prior.acceptedOmissionCount=acceptedRows.length;
        prior.acceptedAdditionCount=0;
        prior.policy="daz424_composite_graft_child_neutral_native_proof_v1";
        prior.rules=[{kind:"daz424_composite_graft_child_neutral_native_proof",
            partID:spec.id,child:spec.name,acceptedOmissions:acceptedRows.length,
            unreadableShaderFields:actual.skipped,
            scope:"Native import of registered DzFigure child nested under an attached GeoGraft only",
            guarantee:"Neutral zero/unmapped omitted controls proved absent by native API; all other exposed materials match. Unreadable shader fields and render equivalence not verified."}];
        if(suppressImportLog!==true)log("WARN","GEO_IMPORT_DAZ424_COMPOSITE_CHILD_COMPAT",item.name+" / "+spec.name+
            " | nativeNeutralOmissions="+acceptedRows.length+
            " | surfaces="+keys.length+
            " | matchedUnreadableFieldCounts="+actual.skipped+
            " | otherExposedMaterialsExact=true | saved catalog and presets unchanged");
        return prior;
    }

    function materialPhase(it, parts, snapshots, name, fig) {
        var out={name:name,passed:true,exactMatch:true,parts:[],differenceCount:0,
            acceptedOmissionCount:0,acceptedAdditionCount:0,acceptedDifferenceCount:0,acceptedTopologySurfaceCount:0,blockingDifferenceCount:0};
        for(var i=0;i<it.parts.length;i++){
            var p=it.parts[i],actual=snapshots[p.id],expected=p.materials;
            var equal=closeNumbers(expected.surfaces,actual.surfaces);
            var diffs=equal?[]:materialDifferences(expected.surfaces,actual.surfaces);
            var api=equal?null:materialAPIDetails(parts[p.id],diffs);
            var decision=classifyGeoShellLoadedMaterials(parts[p.id],fig,expected,actual,api,String(App.versionString));
            if(!decision.passed)
                decision=geoDaz424CompositeChildNeutralProof(it,p,parts,fig,expected,actual,api,decision);
            if(!decision.passed)
                decision=geoDaz424ImportedShellMaterialProof(it,p,parts[p.id],fig,expected,actual,decision);
            if(!decision.passed)
                decision=geoDaz625ImportedShellUVTopologyProof(it,p,parts[p.id],fig,expected,actual,decision);
            if(!decision.passed&&!p.root&&/^4\.24(?:\.|$)/.test(String(App.versionString))&&
               parts[p.id]&&parts[p.id].inherits("DzFigure")){
                // One concise diagnostic in Last Report if a future DAZ4 hair
                // shader exposes different capabilities than the tested case.
                var nativeShaders=[];
                if(api&&Array.isArray(api.surfaces))for(var ci=0;ci<api.surfaces.length;ci++){
                    var capRow=api.surfaces[ci];nativeShaders.push(String(capRow.name)+":"+
                        (capRow.classInfo&&capRow.classInfo.available?String(capRow.classInfo.value):"unknown")+
                        "/"+(capRow.shaderType&&capRow.shaderType.available?String(capRow.shaderType.value):"unknown"));
                }
                log("INFO","GEO_IMPORT_DAZ424_COMPOSITE_CHILD_REJECT",it.name+" / "+p.name+
                    " | savedSkipped="+expected.skipped+" | loadedSkipped="+actual.skipped+
                    " | nativeShaders="+nativeShaders.join(", ")+
                    " | blocking="+decision.blockingDifferences.length);
            }
            var record={partID:p.id,partName:p.name,passed:decision.passed,exactMatch:decision.exactMatch,
                expected:materialReportValue(expected),actual:materialReportValue(actual),differences:decision.differences,
                acceptedDifferences:decision.acceptedDifferences,blockingDifferences:decision.blockingDifferences,
                compatibilityPolicy:decision.policy,compatibilityRules:decision.rules,
                compatibilityRejections:decision.rejections || [],
                topologyMissing:decision.topologyMissing || [],topologyPrefixes:decision.topologyPrefixes || [],
                acceptedTopologySurfaceCount:decision.acceptedTopologySurfaceCount||0,
                acceptedOmissionCount:decision.acceptedOmissionCount,acceptedAdditionCount:decision.acceptedAdditionCount};
            if(api)record.actualAPI=api;
            out.parts.push(record);out.differenceCount+=decision.differences.length;
            out.acceptedTopologySurfaceCount+=decision.acceptedTopologySurfaceCount||0;
            out.acceptedOmissionCount+=decision.acceptedOmissionCount;
            out.acceptedAdditionCount+=decision.acceptedAdditionCount;
            out.acceptedDifferenceCount+=decision.acceptedDifferences.length;
            out.blockingDifferenceCount+=decision.blockingDifferences.length;
            out.exactMatch=out.exactMatch&&decision.exactMatch;out.passed=out.passed&&decision.passed;
            if(expected.skipped||actual.skipped)warnOnce("MATERIAL_COVERAGE",
                "Only exposed comparable values are checked. On DAZ 4.24, named neutral-property omissions in a targeted GeoShell or an attached composite GeoGraft child require independent native API proof; skipped shader fields remain UNVERIFIED.");
        }
        return out;
    }
    function logMaterialPhase(it,phase){
        log("INFO","MATERIAL_COMPARE_"+phase.name,it.name+" | passed="+phase.passed+" | exactMatch="+phase.exactMatch+
            " | differences="+phase.differenceCount+" | compatibilityOmissions="+phase.acceptedOmissionCount+
            " | compatibilityAdditions="+phase.acceptedAdditionCount+
            " | absentDonorGraftSurfaces="+phase.acceptedTopologySurfaceCount+
            " | blocking="+phase.blockingDifferenceCount+" | fixed catalog; named DAZ import policies and guarded GeoShell graft topology only.");
        var count=0,limit=40;
        for(var i=0;i<phase.parts.length;i++){
            var p=phase.parts[i],accepted={};
            for(var x=0;x<p.acceptedDifferences.length;x++){
                var ad=p.acceptedDifferences[x];accepted[JSON.stringify([ad.surface,ad.field])]=true;
            }
            for(var j=0;j<p.differences.length;j++){
                var d=p.differences[j];if(count++>=limit)continue;
                var status=own(accepted,JSON.stringify([d.surface,d.field]))?
                    (d.category==="missing_surface"?"absent_donor_graft_surface":
                    d.category==="extra_property"?"compatibility_addition":
                    (d.field==="UV Set"&&d.category==="value")?"compatible_native_uv_ordinal":
                    "compatibility_omission"):"blocking";
                log("INFO","MATERIAL_DIFF_"+phase.name,it.name+" / "+p.partName+" | surface="+JSON.stringify(d.surface)+
                    " | property="+JSON.stringify(d.field)+" | kind="+d.category+" | disposition="+status+
                    " | expected("+d.expectedType+")="+(d.expectedPresent?JSON.stringify(d.expected):"<absent>")+
                    " | actual("+d.actualType+")="+(d.actualPresent?JSON.stringify(d.actual):"<absent>"));
            }
            if(p.compatibilityRejections && p.compatibilityRejections.length) {
                for(var rj=0;rj<p.compatibilityRejections.length && rj<8;rj++)
                    log("INFO","MATERIAL_RULE_REJECT_"+phase.name,it.name+" / "+p.partName+" | "+JSON.stringify(p.compatibilityRejections[rj]));
            }
            // Projection/layout problems are not necessarily named in the raw
            // diff list. Preserve and print these blocking findings separately.
            for(var b=0;b<p.blockingDifferences.length&&b<12;b++){
                var bd=p.blockingDifferences[b];
                if(bd.category==="snapshot_layout"||bd.category==="snapshot_schema"||bd.category==="surface_schema")
                    log("INFO","MATERIAL_BLOCKER_"+phase.name,it.name+" / "+p.partName+" | "+JSON.stringify(bd));
            }
        }
        if(count>limit)log("INFO","MATERIAL_DIFF_MORE",(count-limit)+" additional exact differences are in material_load_diagnostics.json.");
    }
    function flushMaterialDiagnostics() {
        if (!ctx || !ctx.directory || !ctx.diag.materialLoads) return;
        try {
            writeText(ctx.directory+"/material_load_diagnostics.json",jsonText({schemaVersion:1,prototypeVersion:VERSION,
                dazVersion:String(App.versionString),libraryID:app.db.libraryID,catalogRevision:app.db.revision,
                operationID:ctx.id,materialLoads:ctx.diag.materialLoads}),false);
        } catch(e) {
            warnOnce("MATERIAL_DIAGNOSTICS_WRITE",errorText(e)+". Evidence is also retained in diagnostics.json where possible.");
        }
    }
    function verifyLoadedMaterials(it, parts, fig) {
        var token = profileBegin("loaded_material_check");
        try { return verifyLoadedMaterialsImpl(it, parts, fig); }
        finally { profileEnd(token); }
    }
    function verifyLoadedMaterialsImpl(it, parts, fig) {
        if (!ctx.diag.materialLoads) ctx.diag.materialLoads=[];
        var entry = {itemID:it.id,itemName:it.name,variantID:it.variantID,preset:it.preset,
            runtimeVersion:String(App.versionString),baselineOrigin:"Existing catalog snapshot; creator DAZ version is not recorded by the legacy schema.",
            expectedNeverReplaced:true,materialWrites:0,phases:[],observationAttempted:false,passed:false,
            compatibilityPolicy:materialImportPolicyID(String(App.versionString)),exactMatch:false,
            acceptedOmissionCount:0,acceptedAdditionCount:0,acceptedDifferenceCount:0,acceptedTopologySurfaceCount:0};
        ctx.diag.materialLoads.push(entry);
        var snapshots = captureLoadedMaterialSnapshots(it, parts), first = materialPhase(it,parts,snapshots,"IMMEDIATE",fig);
        entry.phases.push(first);
        var finalPhase = first;
        if (!first.exactMatch) {
            // Even an eligible addition/omission is reread after a material-inclusive quiet window.
            logMaterialPhase(it,first); flushMaterialDiagnostics();
            log("INFO","MATERIAL_RECHECK",it.name+": preserve the initial mismatch and reread after a bounded quiet window. The catalog remains the fixed expected state; no material setters are called.");
            entry.observationAttempted=true;
            try {
                var keys = [key(fig)];
                for (var i = 0; i < it.parts.length; i++) keys.push(key(parts[it.parts[i].id]));
                // An extra read-only snapshot makes MATERIAL state, as well as
                // transforms and build status, participate in the quiet window.
                observe(keys,"MATERIAL_RECHECK_"+it.id,false,function(){
                    snapshots=captureLoadedMaterialSnapshots(it,parts); return snapshots;
                });
                // Use the exact final observed snapshot, NOT a fresh unobserved one.
                finalPhase=materialPhase(it,parts,snapshots,"AFTER_OBSERVATION",fig);
                entry.phases.push(finalPhase); logMaterialPhase(it,finalPhase);
            } catch(e) {
                entry.observationFailure=errorText(e);
                // Retain the last successful capture even when observation times out.
                var failedPhase=materialPhase(it,parts,snapshots,"LAST_CAPTURE_BEFORE_ABORT",fig);
                entry.phases.push(failedPhase); logMaterialPhase(it,failedPhase); flushMaterialDiagnostics(); throw e;
            }
        }
        entry.passed=finalPhase.passed;
        entry.exactMatch=finalPhase.exactMatch;
        entry.acceptedOmissionCount=finalPhase.acceptedOmissionCount;
        entry.acceptedAdditionCount=finalPhase.acceptedAdditionCount;
        entry.acceptedTopologySurfaceCount=finalPhase.acceptedTopologySurfaceCount;
        entry.acceptedDifferenceCount=finalPhase.acceptedDifferenceCount;
        entry.blockingDifferenceCount=finalPhase.blockingDifferenceCount;
        if (entry.observationAttempted) {
            flushMaterialDiagnostics();
            log("INFO","MATERIAL_DIAGNOSTICS",ctx.directory+"/material_load_diagnostics.json (also embedded in diagnostics.json)");
        }
        var failed=[];
        // Report every part before raising the one failure that triggers rollback.
        for (var q = 0; q < finalPhase.parts.length; q++) {
            var pr=finalPhase.parts[q];
            if (pr.passed && !pr.exactMatch) {
                // Every accepted donor-only surface is named separately from
                // zero-value property compatibility. Never call this exact.
                if(pr.acceptedTopologySurfaceCount)log("WARN","LOADED_GEOSHELL_TOPOLOGY",it.name+" / "+pr.partName+
                    " | absentDonorSurfaces="+pr.topologyMissing.join(", ")+
                    " | groupPrefixes="+pr.topologyPrefixes.join(", ")+
                    " | remaining native material surfaces verified; catalog/presets unchanged; NOT exact equality.");
                if(pr.acceptedOmissionCount||pr.acceptedAdditionCount)log("WARN","LOADED_MATERIALS_COMPAT",it.name+" / "+pr.partName+
                    " | "+(pr.acceptedOmissionCount+pr.acceptedAdditionCount)+" named value/map entries accepted by "+pr.compatibilityPolicy+
                    " | absentInRuntime="+pr.acceptedOmissionCount+" | extraInRuntime="+pr.acceptedAdditionCount+
                    " | remaining compared entries match; render equivalence NOT tested.");
                ctx.materialCompatibilityOmissions=(ctx.materialCompatibilityOmissions||0)+pr.acceptedOmissionCount;
                ctx.materialCompatibilityAdditions=(ctx.materialCompatibilityAdditions||0)+pr.acceptedAdditionCount;
            } else {
                log(pr.passed?"PASS":"FAIL","LOADED_MATERIALS",it.name+" / "+pr.partName+
                    (pr.passed ? (entry.observationAttempted ? " | matches fixed catalog after observation" : " | matches fixed catalog") :
                     " | "+pr.blockingDifferences.length+" blocking differences ("+pr.differences.length+
                     " exact differences); see MATERIAL_DIFF and material_load_diagnostics.json"));
            }
            if (!pr.passed) failed.push(pr.partName);
        }
        if (failed.length) {
            var err=problem("LOADED_MATERIALS",it.name+" / "+failed.join(", ")+". Blocking material differences persisted. Only guarded named zero-valued import additions/omissions are eligible; no materials repaired.");
            err.recorded=true; throw err;
        }
        return entry.observationAttempted;
    }

    function durableRecord(it, inf, fig) {
        var token = profileBegin("recovery_capture");
        try { return withReadScope(function () { return durableRecordImpl(it, inf, fig); }, true); }
        finally { profileEnd(token); }
    }
    function durableRecordImpl(it, inf, fig) {
        var rec = {schemaVersion: 1, libraryID: app.db.libraryID, itemID: it.id, variantID: it.variantID,
            instanceID: inf.instanceID, rootID: inf.rootID, ownerFigureID: figureIdentity(fig, true), parts: [], hierarchy: []};
        for (var i = 0; i < it.parts.length; i++) {
            var spec = it.parts[i], n = inf.parts[spec.id], refs = nodeReferences(n), links = {};
            for (var r = 0; r < REF_FIELDS.length; r++) links[REF_FIELDS[r]] = refs[REF_FIELDS[r]] ? uniqueNodeID(refs[REF_FIELDS[r]], true) : "";
            rec.parts.push({partID: spec.id, nodeID: uniqueNodeID(n, true), refs: links});
        }
        // Store internal hierarchy using persistent IDs, including referenced
        // bones. No live elementID, label or world transform is a restore key.
        for (var k = 0; k < inf.allKeys.length; k++) {
            var node = live(inf.allKeys[k]);
            rec.hierarchy.push({nodeID: uniqueNodeID(node, true), parentID: node.getNodeParent() ? uniqueNodeID(node.getNodeParent(), true) : "", className: String(node.className())});
        }
        return rec;
    }
    function validateRecovery(it, inf, fig, record, requireStored) {
        var token = profileBegin("recovery_validation");
        try { return withReadScope(function () { return validateRecoveryImpl(it, inf, fig, record, requireStored); }, false); }
        finally { profileEnd(token); }
    }
    function validateRecoveryImpl(it, inf, fig, record, requireStored) {
        var rec = record;
        if (!rec) {
            var text = value(inf.root, "Recovery");
            if (!text) throw problem("RECOVERY_MISSING", it.name);
            try { rec = JSON.parse(text); } catch (e) { throw problem("RECOVERY_JSON", it.name); }
        }
        if (rec.schemaVersion !== 1 || rec.libraryID !== app.db.libraryID || rec.itemID !== it.id || rec.variantID !== it.variantID ||
            rec.rootID !== inf.rootID || rec.instanceID !== inf.instanceID || rec.ownerFigureID !== figureIdentity(fig, false)) throw problem("RECOVERY_IDENTITY", it.name);
        expectList(rec.parts, "Recovery parts"); expectList(rec.hierarchy, "Recovery hierarchy");
        if (rec.parts.length !== it.parts.length || rec.hierarchy.length !== inf.allKeys.length) throw problem("RECOVERY_STRUCTURE", it.name);
        var liveSet = {}, seen = {}, pids = {};
        for (var a = 0; a < inf.allKeys.length; a++) liveSet[value(live(inf.allKeys[a]), "NodeID")] = true;
        for (var h = 0; h < rec.hierarchy.length; h++) {
            var hh = rec.hierarchy[h], hn = nodeByID(hh.nodeID, "Recovery hierarchy");
            if (own(seen, hh.nodeID) || !own(liveSet, hh.nodeID) || hn.className() !== hh.className) throw problem("RECOVERY_HIERARCHY", it.name);
            seen[hh.nodeID] = true;
            var hp = nodeByID(hh.parentID, "Recovery parent");
            if (hh.nodeID !== rec.rootID && !same(hn.getNodeParent(), hp)) throw problem("RECOVERY_CHILD_PARENT", hn.getLabel());
        }
        for (var i = 0; i < rec.parts.length; i++) {
            var saved = rec.parts[i], n = nodeByID(saved.nodeID, "Recovery part");
            if (own(pids, saved.partID) || !own(inf.parts, saved.partID) || !same(n, inf.parts[saved.partID])) throw problem("RECOVERY_PART", it.name);
            pids[saved.partID] = true;
            var definition = null;
            for (var di = 0; di < it.parts.length; di++) if (it.parts[di].id === saved.partID) definition = it.parts[di];
            expectObject(saved.refs, "Recovery refs");
            for (var j = 0; j < REF_FIELDS.length; j++) {
                var field = REF_FIELDS[j], resolved = nodeByID(saved.refs[field], "Recovery " + field);
                if (!portableLinkMatches(definition,field,resolved,fig,inf.parts,nodeByID(saved.refs.follow,"Recovery follow")))
                    throw problem("RECOVERY_REFERENCE_CONFLICT", it.name + " / " + field);
            }
            var parent = nodeByID(saved.refs.parent, "Saved parent");
            if (saved.nodeID === rec.rootID && parent && !same(parent, fig) && !same(boneOwner(parent), fig)) throw problem("RECOVERY_OWNER", it.name);
            if (requireStored) {
                if (follow(n)) throw problem("STORED_STILL_FITTED", n.getLabel());
                if (!same(linked(n, "Shell Node"), nodeByID(saved.refs.shell, "Shell target"))) throw problem("SHELL_CHANGED", n.getLabel());
                if (!same(nodeReferences(n).rigidFollow, nodeByID(saved.refs.rigidFollow, "Rigid target"))) throw problem("RIGID_CHANGED", n.getLabel());
            }
        }
        if (requireStored && inf.where !== "stored") throw problem("NOT_STORED", it.name);
        return rec;
    }
    function setParent(it, root, target) {
        requireUnscoped("setParent");
        if (same(root.getNodeParent(), target)) return;
        audit("PARENT", it.id, root, target ? value(target, "NodeID") : "<none>");
        if (target) target.addNodeChild(root, false); else if (root.getNodeParent()) root.getNodeParent().removeNodeChild(root);
        if (!same(root.getNodeParent(), target)) throw problem("PARENT_WRITE", it.name);
    }
    function setFit(it, n, target) {
        requireUnscoped("setFit");
        if (!n.inherits("DzSkeleton") || same(follow(n), target)) return;
        audit("FIT_TO", it.id, n, key(target)); n.setFollowTarget(target);
        if (!same(follow(n), target)) throw problem("FIT_WRITE", it.name);
    }
    function setCollision(it, n, target) {
        requireUnscoped("setCollision");
        var p = prop(n, "Collision Item");
        if (!p) { if (target) throw problem("COLLISION_PROPERTY", it.name); return; }
        if (same(p.getValue(), target)) return;
        audit("COLLISION", it.id, n, key(target)); p.setValue(target);
        if (!same(p.getValue(), target)) throw problem("COLLISION_WRITE", it.name);
    }
    function applyRecord(it, inf, rec) {
        var token = profileBegin("native_restore_record");
        try { return applyRecordImpl(it, inf, rec); }
        finally { profileEnd(token); }
    }
    function applyRecordImpl(it, inf, rec) {
        requireUnscoped("applyRecordImpl");
        var rootSpec = null, i;
        for (i = 0; i < rec.parts.length; i++) if (rec.parts[i].nodeID === rec.rootID) rootSpec = rec.parts[i];
        if (!rootSpec) throw problem("RECOVERY_ROOT", it.name);
        setParent(it, inf.root, nodeByID(rootSpec.refs.parent, "Root parent"));
        for (i = 0; i < rec.parts.length; i++) {
            var ps = rec.parts[i], fitted=resolveRestorePair(ps.nodeID,ps.refs.follow,"Fit To");
            setFit(it,fitted.node,fitted.target);
        }
        processEvents(); Scene.update(); processEvents();
        for (i = 0; i < rec.parts.length; i++) {
            var cs = rec.parts[i], collider=resolveRestorePair(cs.nodeID,cs.refs.collision,"Collision");
            setCollision(it,collider.node,collider.target);
        }
    }
    function storeItem(it, inf, fig) {
        var token = profileBegin("store_item");
        try { return storeItemImpl(it, inf, fig); }
        finally { profileEnd(token); }
    }
    function storeItemImpl(it, inf, fig) {
        requireUnscoped("storeItemImpl");
        foreignDataGuard(inf.root, false);
        var rec = durableRecord(it, inf, fig);
        // Both records travel with the scene instance through Wardrobe Storage.
        // This material pointer was PREPARED before any graft changed topology.
        var draft=ctx.geoWardrobeTxn&&ctx.geoWardrobeTxn.drafts[it.id];
        if(draft){
            if(!geoIsGraft(fig,it.id,inf,null))throw problem("GEO_WARDROBE_DRAFT_TARGET",it.name);
            txData(inf.root,{GeoWardrobeSnapshot:draft});
            ctx.geoWardrobeTxn.stored++;
        }
        txData(inf.root, {Recovery: jsonText(rec)});
        var group = storageGroup(fig, true);
        for (var i = 0; i < it.parts.length; i++) setFit(it, inf.parts[it.parts[i].id], null);
        setParent(it, inf.root, group);
        log("PASS", "STORED", it.name + " | " + inf.instanceID); return rec;
    }
    function restoreItem(it, inf, fig) {
        var token = profileBegin("restore_item");
        try { return restoreItemImpl(it, inf, fig); }
        finally { profileEnd(token); }
    }
    function restoreItemImpl(it, inf, fig) {
        requireUnscoped("restoreItemImpl");
        foreignDataGuard(inf.root, false);
        var rec = validateRecovery(it, inf, fig, null, true);
        applyRecord(it, inf, rec); log("INFO", "RESTORE_LINKS", it.name + " | instance=" + inf.instanceID + " | rootNode=" + rec.rootID + " | owner=" + rec.ownerFigureID + " | resolved exclusively from durable NodeID references.");
        return rec;
    }

    function unsetData(n, field) {
        var k = key(n); if (!own(ctx.metaBefore, k)) ctx.metaBefore[k] = dataObject(n);
        var o = dataObject(n); if (o && own(o, field)) { delete o[field]; putData(n, o); }
    }
    function assertNoPending(fig) {
        if (value(fig, "Pending")) throw problem("PENDING_OPERATION", "An interrupted wardrobe operation is recorded on this figure. Do not retry blindly. Reopen your saved pre-operation test scene and keep the current report. No recovery record was discarded.");
    }
    function preflight(st, fig, override) {
        var token = profileBegin("preflight");
        try { return withReadScope(function () { return preflightImpl(st, fig, override); }, false); }
        finally { profileEnd(token); }
    }
    function validateTransitionRecovery(st,it,inf,fig) {
        // An unrelated stored item is not a restore source for this transition.
        // Keep it untouched; never manufacture missing durable references.
        if(st.items.indexOf(it.id)<0&&!value(inf.root,"Recovery")) {
            log("WARN","UNRELATED_RECOVERY_MISSING",it.name+" remains in storage unchanged; its return requires the original recovery data.");
            return;
        }
        validateRecovery(it,inf,fig,null,true);
    }
    function preflightImpl(st, fig, override) {
        frameGuard(); assertNoPending(fig);
        var why = scopeProblem(st, fig); if (why) throw problem("SCOPE", why);
        var inv = inventory(fig, app.db), ids = Object.keys(inv), active = [], sig = [];
        for (var i = 0; i < ids.length; i++) {
            var id = ids[i], inf = inv[id], it = app.db.items[id];
            if (inf.where === "active") { nativeLinkCheck(it, inf, fig); active.push(id); }
            else if (inf.where === "stored") validateTransitionRecovery(st,it,inf,fig);
            else throw problem("INVENTORY_LOCATION", it.name);
            sig.push(id + ":" + inf.where + ":" + inf.rootID + ":" + inf.instanceID);
        }
        var plan = calculatePlan(active, st.items, inv, app.db.items);
        for (var j = 0; j < plan.load.length; j++) validatePreset(app.db.items[plan.load[j]], override && override[plan.load[j]]);
        plan.signature = sig.sort().join("|"); return {plan: plan, inventory: inv};
    }
    function describeIDs(ids) { return ids.map(function (id) { return app.db.items[id] ? app.db.items[id].name : id; }).join(", ") || "-"; }
    function actualReferencesMatch(rec, code) {
        var token = profileBegin("durable_links");
        try { return withReadScope(function () { return actualReferencesMatchImpl(rec, code); }, false); }
        finally { profileEnd(token); }
    }
    function actualReferencesMatchImpl(rec, code) {
        var bad = [];
        for (var i = 0; i < rec.parts.length; i++) {
            var ps = rec.parts[i], n = nodeByID(ps.nodeID, "Verify restored part"), actual = nodeReferences(n);
            for (var r = 0; r < REF_FIELDS.length; r++) {
                var field = REF_FIELDS[r];
                if (!same(actual[field], nodeByID(ps.refs[field], "Verify " + field))) bad.push(n.getLabel() + " / " + field);
            }
        }
        must(!bad.length, code, bad.length ? bad.join("; ") : "All durable parent/Fit To/Collision/Shell/Rigid Follow links resolved to the intended nodes.");
    }
    function verifyDesired(st, fig) {
        var token = profileBegin("desired_state");
        try { return withReadScope(function () { return verifyDesiredImpl(st, fig); }, false); }
        finally { profileEnd(token); }
    }
    function verifyDesiredImpl(st, fig) {
        var inv = inventory(fig, app.db), ids = Object.keys(inv), active = [];
        for (var i = 0; i < ids.length; i++) {
            var it = app.db.items[ids[i]], inf = inv[ids[i]];
            if (inf.where === "active") { active.push(it.id); nativeLinkCheck(it, inf, fig); }
            else validateTransitionRecovery(st,it,inf,fig);
        }
        must(active.sort().join("|") === st.items.slice(0).sort().join("|"),
            ctx.action === "undress_all" ? "WARDROBE_EMPTY" : "SET_STATE",
            ctx.action === "undress_all" ? "No registered items remain worn by the selected figure." : "Registered active items must exactly match: " + st.name);
        if (ctx.action === "undress_all") verifyUndressInventory(inv);
        return inv;
    }
    function cleanupNewNodes() {
        requireUnscoped("cleanupNewNodes");
        var wanted = Object.keys(ctx.created), allowed = {}, map = sceneIndex(), i;
        for (i = 0; i < wanted.length; i++) {
            if (own(ctx.originalNodes, wanted[i])) throw problem("CLEANUP_ORIGINAL", wanted[i]);
            allowed[wanted[i]] = true;
        }
        // Never delete a newly created group if it contains an original item.
        for (i = 0; i < wanted.length; i++) if (map[wanted[i]]) {
            var kids = map[wanted[i]].getNodeChildren(true);
            for (var j = 0; j < kids.length; j++) if (!own(allowed, key(kids[j]))) throw problem("CLEANUP_FOREIGN_CHILD", kids[j].getLabel());
        }
        for (i = 0; i < wanted.length; i++) {
            var n = live(wanted[i]);
            if (n && (!n.getNodeParent() || !own(allowed, key(n.getNodeParent())))) Scene.removeNode(n);
        }
        for (i = 0; i < wanted.length; i++) { var left = live(wanted[i]); if (left) Scene.removeNode(left); }
        for (i = 0; i < wanted.length; i++) if (live(wanted[i])) throw problem("CLEANUP_REMAINS", wanted[i]);
    }
    function restoreMetadata() {
        var keys = Object.keys(ctx.metaBefore), errors = [];
        for (var i = 0; i < keys.length; i++) {
            if (own(ctx.created, keys[i])) continue;
            try { var n = live(keys[i]); if (!n) throw new Error("Original metadata owner disappeared"); putData(n, ctx.metaBefore[keys[i]]); }
            catch (e) { errors.push(keys[i] + " / " + errorText(e)); }
        }
        if (errors.length) throw problem("METADATA_ROLLBACK", errors.join("\n"));
    }
    function rollbackRegisteredMaintenanceAction() {
        var tx=ctx.registeredMaintenanceTxn,errors=[];
        if(!tx)return false;
        try { restoreMetadata(); } catch(e) { errors.push(errorText(e)); }
        if(!errors.length) {
            try {
                var it=app.db.items[tx.itemID],root=nodeByID(tx.locationRecord.rootID,"Registered-item rollback root"),inf=inspectInstance(it,root);
                applyRecord(it,inf,tx.locationRecord);actualReferencesMatch(tx.locationRecord,"REGISTERED_ITEM_ROLLBACK_LINKS");
            } catch(e2) { errors.push(errorText(e2)); }
        }
        if(ctx.geoMaterialTxn)geoRollbackMaterialBackups(errors);
        if(!errors.length && ctx.rollbackMeasurements) {
            try {
                var keys=Object.keys(ctx.rollbackMeasurements);
                if(keys.length){observe(keys,"ROLLBACK_REGISTERED_ITEM",false);compareMeasured(ctx.rollbackMeasurements,keys,"ROLLBACK_REGISTERED_ITEM_STATE");}
            } catch(e3) { errors.push(errorText(e3)); }
        }
        if(figurePoseAuditEnabled()&&!errors.length&&ctx.rollbackPose&&!closeNumbers(ctx.rollbackPose,poseRecord(ctx.target)))
            errors.push("The figure pose/root scalar values differ from the registered-item pre-action baseline.");
        if(errors.length){
            try { if(ctx.target&&live(key(ctx.target)))updateData(ctx.target,{Pending:jsonText(ctx.pending||{operationID:ctx.id,libraryID:app.db.libraryID,action:ctx.action,recovery:"Reopen saved pre-operation scene"})}); } catch(ignore){}
            log("FAIL","ROLLBACK_INCOMPLETE",errors.join("\n")+"\nRegistered-item maintenance rollback was incomplete. Reopen the saved pre-operation scene.");
            return false;
        }
        log("PASS","ROLLBACK","Registered-item metadata and original active/stored links restored.");
        return true;
    }
    function rollbackAction() {
        if (ctx && ctx.registeredMaintenanceTxn) return rollbackRegisteredMaintenanceAction();
        if (ctx && ctx.transferTxn) return rollbackTransferAction();
        // Best effort only. Never use cancelUndo as a claimed native-import
        // transaction, never force transforms/materials to hide a discrepancy.
        var errors = [], records = ctx.rollbackRecords, ids = Object.keys(records);
        for (var i = 0; i < ids.length; i++) {
            try {
                var rec = records[ids[i]], root = nodeByID(rec.rootID, "Rollback root"), inf = inspectInstance(app.db.items[ids[i]], root);
                applyRecord(app.db.items[ids[i]], inf, rec); actualReferencesMatch(rec, "ROLLBACK_LINKS");
            } catch (e) { errors.push(errorText(e)); }
        }
        rollbackPropertyWrites(errors);
        rollbackPartStateWrites(errors);
        if (!errors.length) {
            try { cleanupNewNodes(); restoreMetadata(); }
            catch (e2) { errors.push(errorText(e2)); }
        }
        // Rollback material topology only AFTER failed incoming graft imports
        // are removed. Otherwise a before-state shell has incompatible extra
        // graft surfaces while DAZ is still holding the failed incoming graft.
        if(ctx.geoMaterialTxn)geoRollbackMaterialBackups(errors);
        if (!errors.length && ctx.rollbackMeasurements) {
            try {
                var keys = Object.keys(ctx.rollbackMeasurements);
                if (keys.length) { observe(keys, "ROLLBACK", false); compareMeasured(ctx.rollbackMeasurements, keys, "ROLLBACK_MEASURED_STATE"); }
            } catch (e3) { errors.push(errorText(e3)); }
        }
        if (figurePoseAuditEnabled() && !errors.length && ctx.rollbackPose && !closeNumbers(ctx.rollbackPose, poseRecord(ctx.target)))
            errors.push("The figure pose/root scalar values differ from the pre-action baseline. No pose compensation was attempted.");
        if (errors.length) {
            // Keep a durable marker even if metadata restoration partly ran.
            try { if (ctx.target && live(key(ctx.target))) updateData(ctx.target, {Pending: jsonText(ctx.pending || {operationID:ctx.id, libraryID:app.db.libraryID, action:ctx.action, recovery:"Reopen saved pre-operation scene"})}); }
            catch (ignore) {}
            log("FAIL", "ROLLBACK_INCOMPLETE", errors.join("\n") + "\nRecovery records were retained where possible. Reopen your saved test scene; do not overwrite it.");
            return false;
        }
        log("PASS", "ROLLBACK", "New imports removed and recorded original links/own metadata restored; this is not a general native Undo guarantee.");
        return true;
    }
    // Session-only baselines. Never write these to figure metadata or preferences.
    var handPoseSession={},handPoseUndoState=null;
    function syncHandPoseSession(){
        if(handPoseUndoState)handPoseSession=JSON.parse(String(handPoseUndoState.getValue())||"{}");
    }
    function commitHandPoseSession(){
        if(!handPoseUndoState){handPoseUndoState=new DzStringProperty("Wearable Manager Hand Session",false);}
        handPoseUndoState.setValue(JSON.stringify(handPoseSession));
    }
    function handChannelKey(r){return JSON.stringify([r.propertyNodePath,r.propertyGroupPath,r.propertyOwnerName,r.propertyName]);}
    function validateHandPoses(value){
        if(value===undefined)return {};
        expectObject(value,"Hand poses");var out={},sides=Object.keys(value);
        for(var s=0;s<sides.length;s++){
            var side=sides[s];if(side!=="right"&&side!=="left")throw problem("HAND_POSE_SCHEMA","Unknown hand side.");
            var pose=value[side];expectObject(pose,"Hand pose");
            if(pose.schemaVersion!==1||!Array.isArray(pose.channels)||!pose.channels.length||pose.channels.length>4096)
                throw problem("HAND_POSE_SCHEMA","Invalid hand channels.");
            var seen={};
            for(var i=0;i<pose.channels.length;i++){
                var r=pose.channels[i];expectObject(r,"Hand channel");propertyLocatorFields(r);
                if(!Array.isArray(r.propertyNodePath)||typeof r.propertyGroupPath!=="string"||typeof r.propertyOwnerName!=="string"||
                    typeof r.propertyName!=="string"||!r.propertyName||typeof r.rawValue!=="number"||!isFinite(r.rawValue))
                    throw problem("HAND_POSE_SCHEMA","Invalid hand channel value or locator.");
                var k=handChannelKey(r);if(own(seen,k))throw problem("HAND_POSE_SCHEMA","Duplicate hand channel.");seen[k]=true;
            }
            out[side]=clonePlain(pose);
        }
        return out;
    }
    function handNativeChannels(fig,side){
        var bones=figurePoseNodesLinear(fig),hand=null,wanted=side==="right"?["rhand","righthand","handr"]:["lhand","lefthand","handl"];
        for(var b=1;b<bones.length;b++)if(wanted.indexOf(String(bones[b].getName()).toLowerCase().replace(/[^a-z]/g,""))>=0){
            if(hand)throw problem("HAND_POSE_BONE","Ambiguous "+side+" hand.");hand=bones[b];
        }
        if(!hand)throw problem("HAND_POSE_BONE","Cannot find the "+side+" hand on "+fig.getLabel()+".");
        var nodes=[hand],stack=[hand],seen={},out=[],helper=new DzSceneHelper();
        while(stack.length){var children=stack.pop().getNodeChildren(false);for(var c=0;c<children.length;c++)if(children[c].inherits("DzBone")){nodes.push(children[c]);stack.push(children[c]);}}
        function add(node,p){
            if(!p||!p.inherits("DzNumericProperty")||typeof p.getRawValue!=="function"||typeof p.setValue!=="function")return;
            var rec={propertyNodePath:overrideRelativeNodePath(fig,node),propertyGroupPath:overridePropertyGroupPath(p),
                propertyOwnerName:overridePropertyOwnerName(p),propertyName:propertyInternalName(p),rawValue:Number(p.getRawValue())};
            if(!isFinite(rec.rawValue))throw problem("HAND_POSE_VALUE",rec.propertyName);
            var k=handChannelKey(rec);if(own(seen,k))return;seen[k]=true;out.push({record:rec,property:p});
        }
        var methods=["getXPosControl","getYPosControl","getZPosControl","getXRotControl","getYRotControl","getZRotControl","getScaleControl","getXScaleControl","getYScaleControl","getZScaleControl"];
        try{
            // Controls first, then authored bone transforms. Raw values avoid double ERC.
            var owners=[fig].concat(nodes);
            for(var n=0;n<owners.length;n++){
                var props=helper.getPropertiesOnNode(owners[n],true)||[];
                for(var p=0;p<props.length;p++){
                    var path=overridePropertyGroupPath(props[p]).toLowerCase();
                    if(path.indexOf("pose controls")<0)continue;
                    if(n===0&&(!/(hand|finger|thumb)/.test(path)||path.indexOf(side)<0))continue;
                    add(owners[n],props[p]);
                }
            }
            for(n=0;n<nodes.length;n++)for(var m=0;m<methods.length;m++)if(typeof nodes[n][methods[m]]==="function")add(nodes[n],nodes[n][methods[m]]());
        }finally{helper.deleteLater();}
        return out;
    }
    function captureHandPose(fig,side){
        var native=handNativeChannels(fig,side),rows=[];
        for(var i=0;i<native.length;i++)rows.push(native[i].record);
        return {schemaVersion:1,channels:rows};
    }
    function resolveHandPose(fig,side,pose){
        var native=handNativeChannels(fig,side),index={},writes=[];
        for(var i=0;i<native.length;i++)index[handChannelKey(native[i].record)]=native[i];
        for(i=0;i<pose.channels.length;i++){
            var r=pose.channels[i],found=index[handChannelKey(r)];
            if(!found)throw problem("HAND_POSE_CHANNEL","Missing or changed "+side+" hand control: "+r.propertyName);
            var p=found.property,want=r.rawValue;
            if(typeof p.isLocked==="function"&&p.isLocked()&&!closeNumbers(Number(p.getRawValue()),want))throw problem("HAND_POSE_LOCKED",r.propertyName);
            // These are authored RAW channel values, not evaluated rotations.
            // ERC/Pose Controls can offset a raw value outside the displayed
            // min/max while the evaluated joint remains within its limits.
            // Keep locks, finite schema checks and exact native raw readback;
            // never clamp this value or change the property's limit settings.
            writes.push({property:p,value:want,name:r.propertyName});
        }
        return writes;
    }
    function writeHandPose(fig,side,pose){
        var writes=resolveHandPose(fig,side,pose);
        for(var i=0;i<writes.length;i++){
            var w=writes[i],p=w.property;if(closeNumbers(Number(p.getRawValue()),w.value))continue;
            if(typeof p.setRawValue==="function")p.setRawValue(w.value);else p.setValue(w.value);
        }
        for(i=0;i<writes.length;i++)if(!closeNumbers(Number(writes[i].property.getRawValue()),writes[i].value))
            throw problem("HAND_POSE_WRITE","Control did not accept its saved raw value: "+writes[i].name);
    }
    function prepareHandTransition(st,fig,activeAfter){
        syncHandPoseSession();
        var desired=validateHandPoses(st?st.handPoses:undefined),sessionKey=key(fig)+"@"+String(Scene.getFrame()),
            previous=handPoseSession[sessionKey]||{},next=clonePlain(previous),plans=[],sides=["right","left"];
        for(var i=0;i<sides.length;i++){
            var side=sides[i];if(!desired[side]&&!previous[side])continue;
            // A different group can leave the source outfit fully worn.
            var sourceItems=previous[side]&&previous[side].sourceItems||[];
            if(!desired[side]&&activeAfter&&sourceItems.length&&sourceItems.every(function(id){return activeAfter.indexOf(id)>=0;}))continue;
            var before=captureHandPose(fig,side),target=desired[side]||{schemaVersion:1,channels:previous[side].channels};
            resolveHandPose(fig,side,target);
            if(desired[side]){
                if(!next[side])next[side]=clonePlain(before);
                next[side].sourceSetID=st.id||"";
                next[side].sourceItems=(st.items||[]).slice(0);
            }
            else delete next[side];
            plans.push({side:side,before:before,target:target});
        }
        return {key:sessionKey,previous:previous,next:next,plans:plans,touched:false};
    }
    function hasSavedHandPoses(st) {
        var poses=st&&st.handPoses||{};
        return !!((poses.right&&poses.right.channels&&poses.right.channels.length)||
            (poses.left&&poses.left.channels&&poses.left.channels.length));
    }
    function prepareSavedHandRestore(st,fig) {
        var desired=validateHandPoses(st.handPoses);syncHandPoseSession();
        var sessionKey=key(fig)+"@"+String(Scene.getFrame()),previous=handPoseSession[sessionKey]||{},
            next=clonePlain(previous),plans=[],sides=["right","left"];
        for(var i=0;i<sides.length;i++){
            var side=sides[i];if(!desired[side]||!desired[side].channels.length)continue;
            var before=captureHandPose(fig,side);resolveHandPose(fig,side,desired[side]);
            if(!next[side])next[side]=clonePlain(before);
            next[side].sourceSetID=st.id;next[side].sourceItems=(st.items||[]).slice(0);
            plans.push({side:side,before:before,target:desired[side]});
        }
        if(!plans.length)throw problem("HAND_POSE_EMPTY","This set has no saved hand poses.");
        return {key:sessionKey,previous:previous,next:next,plans:plans,touched:false};
    }
    function prepareHandRemoval(fig,removedIDs,setID){
        syncHandPoseSession();
        var sessionKey=key(fig)+"@"+String(Scene.getFrame()),previous=handPoseSession[sessionKey]||{},
            next=clonePlain(previous),plans=[],sides=["right","left"];
        for(var i=0;i<sides.length;i++){
            var side=sides[i],baseline=previous[side];if(!baseline)continue;
            var items=baseline.sourceItems||[],removed=!!setID&&baseline.sourceSetID===setID;
            for(var j=0;j<items.length;j++)if(removedIDs.indexOf(items[j])>=0)removed=true;
            if(!removed)continue;
            resolveHandPose(fig,side,baseline);
            plans.push({side:side,before:captureHandPose(fig,side),target:{schemaVersion:1,channels:baseline.channels}});delete next[side];
        }
        return {key:sessionKey,previous:previous,next:next,plans:plans,touched:false};
    }
    function restoreRemovedHandSessions(){
        syncHandPoseSession();var sessionKeys=Object.keys(handPoseSession);
        ctx.additionalHandTransitions=[];
        for(var i=0;i<sessionKeys.length;i++){
            var split=sessionKeys[i].lastIndexOf("@"),frame=sessionKeys[i].slice(split+1);
            if(frame!==String(Scene.getFrame()))continue;
            var fig=live(sessionKeys[i].slice(0,split));if(!fig)continue;
            var inv=inventory(fig,app.db),state=handPoseSession[sessionKeys[i]],removed=[],sides=["right","left"];
            for(var j=0;j<sides.length;j++){
                var baseline=state[sides[j]],items=baseline&&baseline.sourceItems||[];
                for(var k=0;k<items.length;k++)if(!inv[items[k]]||inv[items[k]].where!=="active")removed.push(items[k]);
            }
            if(!removed.length)continue;
            var tx=prepareHandRemoval(fig,removed,"");ctx.additionalHandTransitions.push({figure:fig,transition:tx});
            applyHandTransition(tx,fig);
        }
    }
    function applyHandTransition(tx,fig){
        if(!tx)return;tx.touched=true;
        for(var i=0;i<tx.plans.length;i++)writeHandPose(fig,tx.plans[i].side,tx.plans[i].target);
        if(Object.keys(tx.next).length)handPoseSession[tx.key]=tx.next;else delete handPoseSession[tx.key];
        commitHandPoseSession();
        if(tx.plans.length)log("PASS","HAND_POSE","Applied/restored "+tx.plans.length+" hand pose(s); baseline retained only in this script session.");
    }
    function rollbackHandTransition(tx,fig){
        if(!tx||!tx.touched)return;
        var errors=[];for(var i=0;i<tx.plans.length;i++)try{writeHandPose(fig,tx.plans[i].side,tx.plans[i].before);}catch(e){errors.push(errorText(e));}
        if(Object.keys(tx.previous).length)handPoseSession[tx.key]=tx.previous;else delete handPoseSession[tx.key];
        commitHandPoseSession();
        if(errors.length)throw problem("HAND_POSE_ROLLBACK",errors.join("; "));
    }
    function setPropertyOverrides(st) {
        return st && Array.isArray(st.properties) ? st.properties : [];
    }
    function readAppliedPropertyState(fig) {
        var text = value(fig,"PropertyState");
        if (!text) return {schemaVersion:1,setID:"",entries:[]};
        var state;
        try { state = JSON.parse(String(text)); }
        catch(e) { throw problem("PROPERTY_STATE","Invalid saved property state on "+fig.getLabel()+"."); }
        if (!state || state.schemaVersion !== 1 || typeof state.setID !== "string" || !Array.isArray(state.entries))
            throw problem("PROPERTY_STATE","Unsupported saved property state on "+fig.getLabel()+".");
        var seen={};
        for(var i=0;i<state.entries.length;i++){
            var r=state.entries[i];
            if(!r||typeof r!=="object"||(r.targetKind!=="figure"&&r.targetKind!=="item")||typeof r.propertyName!=="string"||!r.propertyName||
                typeof r.applyValue!=="number"||!isFinite(r.applyValue)||typeof r.resetValue!=="number"||!isFinite(r.resetValue))
                throw problem("PROPERTY_STATE","Invalid property state entry on "+fig.getLabel()+".");
            if(r.targetKind==="item"&&(!r.itemID||!r.partID))throw problem("PROPERTY_STATE","Invalid item property state target on "+fig.getLabel()+".");
            propertyLocatorFields(r);
            var k=propertyOverrideKey(r);if(!k||own(seen,k))throw problem("PROPERTY_STATE","Repeated property state target on "+fig.getLabel()+".");seen[k]=true;
        }
        return state;
    }
    function propertyTransitionNeeded(st,fig) {
        var desired=setPropertyOverrides(st),text=value(fig,"PropertyState");
        if(!text)return desired.length>0;
        var state;try{state=readAppliedPropertyState(fig);}catch(e){return true;}
        if(String(state.setID||"")!==String(st.id||"")||!closeNumbers(state.entries,desired))return true;
        try{
            var inv=inventory(fig,app.db);
            for(var i=0;i<desired.length;i++){
                var rec=desired[i],node=propertyTargetNode(rec,fig,inv),p=propertyHandleForOverride(node,rec),v=Number(p.getValue());
                if(!isFinite(v)||!closeNumbers(v,Number(rec.applyValue)))return true;
            }
            return false;
        }catch(ignore){return true;}
    }
    function propertyTargetNode(rec,fig,inv) {
        if (rec.targetKind === "figure") return fig;
        if (rec.targetKind !== "item") throw problem("PROPERTY_TARGET","Unsupported property target.");
        var inf = inv[rec.itemID];
        if (!inf) throw problem("PROPERTY_TARGET_MISSING","Property target item is unavailable: "+String(rec.itemID));
        var n = inf.parts[rec.partID];
        if (!n) throw problem("PROPERTY_TARGET_PART","Property target part is unavailable: "+String(rec.partID));
        return n;
    }
    function overridePropertyOwnerName(p) {
        try{
            var owner=p.getOwner();
            if(owner){if(typeof owner.getName==="function")return String(owner.getName());
                if(owner.name!==undefined)return String(owner.name);}
        }catch(ignore){}
        return "";
    }
    function overridePropertyGroupPath(p){
        try{return typeof p.getPath==="function"?String(p.getPath()):"";}catch(ignore){}
        return "";
    }
    function overrideRelativeNodePath(base,associated){
        if(!associated)throw problem("PROPERTY_LOCATOR","DAZ did not identify the selected property's associated node.");
        var names=[],n=associated,guard=0;
        while(n&&!same(n,base)&&guard++<64){
            if(typeof n.getNodeParent!=="function")break;
            names.unshift(String(n.name));n=n.getNodeParent();
        }
        if(!n||!same(n,base))throw problem("PROPERTY_TARGET",
            "This property belongs to another scene node. Choose it under that item instead of the figure.");
        if(base.inherits("DzFigure")&&names.length){
            var check=associated;
            while(check&&!same(check,base)){
                if(!check.inherits("DzBone"))throw problem("PROPERTY_TARGET",
                    "Figure overrides may target the figure or its bones, not another wearable.");
                check=check.getNodeParent();
            }
        }
        return names;
    }
    function overrideNodeByPath(base,path){
        if(!path||!path.length)return base;
        var n=base;
        for(var i=0;i<path.length;i++){
            var children=n.getNodeChildren(false),found=null,count=0;
            for(var j=0;j<children.length;j++)if(String(children[j].name)===path[i]){found=children[j];count++;}
            if(count!==1)throw problem("PROPERTY_OWNER_NODE", "Missing/ambiguous property owner node: "+path.join(" / "));
            n=found;
        }
        return n;
    }
    function overrideNativeCandidates(node,name){
        // Unlike findPropertyByInternalName on the root, this includes modifier
        // properties attached to the exact associated bone/item node.
        var helper=sharedPropertyHelper||new DzSceneHelper(),all=[];
        try{all=helper.getPropertiesOnNode(node,true)||[];}catch(ignoreNodeList){}
        if(!all.length){
            try{var tree=node.getPropertyGroups();if(tree)all=tree.getAllProperties()||[];}catch(ignoreTree){}
        }
        var found=[];
        for(var i=0;i<all.length;i++)if(all[i]&&propertyInternalName(all[i])===name)found.push(all[i]);
        if(!found.length){
            try{var groupTree=node.getPropertyGroups(),groupList=groupTree?groupTree.getAllProperties():[];
                for(var t=0;t<groupList.length;t++)if(groupList[t]&&propertyInternalName(groupList[t])===name)found.push(groupList[t]);
            }catch(ignoreGroupFallback){}
        }
        return found;
    }
    function propertyHandleForOverride(node,rec) {
        propertyLocatorFields(rec);
        var legacyRecord=rec.propertyNodePath===undefined&&rec.propertyGroupPath===undefined&&rec.propertyOwnerName===undefined;
        // Preserve the already-tested v0.7.3 resolver for older saved sets.
        if(legacyRecord){
            var legacy=prop(node,rec.propertyName);
            if(legacy){
                if(!(legacy.inherits("DzNumericProperty")||legacy.inherits("DzBoolProperty"))||typeof legacy.setValue!=="function")
                    throw problem("PROPERTY_TYPE",String(rec.propertyLabel||rec.propertyName)+" is not writable.");
                return legacy;
            }
        }
        var owner=overrideNodeByPath(node,rec.propertyNodePath||[]),selected=[],candidates=overrideNativeCandidates(owner,String(rec.propertyName));
        for(var i=0;i<candidates.length;i++){
            var p=candidates[i];
            if(rec.propertyGroupPath!==undefined&&overridePropertyGroupPath(p)!==rec.propertyGroupPath)continue;
            if(rec.propertyOwnerName!==undefined&&overridePropertyOwnerName(p)!==rec.propertyOwnerName)continue;
            selected.push(p);
        }
        if(!selected.length)throw problem("PROPERTY_MISSING",String(rec.propertyLabel||rec.propertyName)+
            " is unavailable on "+owner.getLabel()+". Property owner/path may have changed.");
        if(selected.length!==1)throw problem("PROPERTY_AMBIGUOUS",String(rec.propertyLabel||rec.propertyName)+
            " resolves to "+selected.length+" native properties; choose a unique control.");
        var result=selected[0];
        if (!(result.inherits("DzNumericProperty") || result.inherits("DzBoolProperty")) || typeof result.setValue!=="function")
            throw problem("PROPERTY_TYPE",String(rec.propertyLabel||rec.propertyName)+" is not a writable numeric property.");
        return result;
    }
    function overrideLocatorForSelected(base,p){
        var helper=sharedPropertyHelper||new DzSceneHelper(),associated=null;
        try{associated=helper.getNode(p);}catch(ignoreGetNode){}
        if(!associated)try{associated=helper.getDisplayNode(p);}catch(ignoreDisplayNode){}
        var fields={propertyNodePath:overrideRelativeNodePath(base,associated),
            propertyGroupPath:overridePropertyGroupPath(p),propertyOwnerName:overridePropertyOwnerName(p)};
        return fields;
    }
    function rememberPropertyRollback(node,rec,p) {
        if (!ctx.propertyRollback) ctx.propertyRollback=[];
        var k=key(node)+"|"+propertyOverrideKey(rec);
        for(var i=0;i<ctx.propertyRollback.length;i++)if(ctx.propertyRollback[i].key===k)return;
        var v=Number(p.getValue());if(!isFinite(v))throw problem("PROPERTY_VALUE","Non-finite current value for "+rec.propertyName);
        ctx.propertyRollback.push({key:k,nodeKey:key(node),propertyName:String(rec.propertyName),locator:clonePlain(rec),value:v});
    }
    function initialOverrideApplyValue(p,propertyLabel) {
        // If an artist has already adjusted a control, respect that exact live
        // native value. Only an untouched/default control starts at its max.
        var actual=Number(p.getValue()),defaultValue=overrideNativeDefaultValue(p,propertyLabel);
        if(!isFinite(actual))throw problem("PROPERTY_VALUE",String(propertyLabel||"Property")+" has a non-finite current value.");
        if(!closeNumbers(actual,defaultValue))return actual;
        var bounds=propertyValueBounds(p);
        if(bounds.max===null)throw problem("PROPERTY_LIMITS",String(propertyLabel||"Property")+
            " is at its default, but DAZ does not expose a finite maximum for an automatic Apply value.");
        return bounds.max;
    }
    function propertyValueBounds(p) {
        var b={min:null,max:null,clamped:false,displayPercent:false};
        try{if(typeof p.getMin==="function"){var v=Number(p.getMin());if(isFinite(v))b.min=v;}}catch(ignoreMin){}
        try{if(typeof p.getMax==="function"){var w=Number(p.getMax());if(isFinite(w))b.max=w;}}catch(ignoreMax){}
        try{if(typeof p.isClamped==="function")b.clamped=p.isClamped()===true;}catch(ignoreClamp){}
        try{if(typeof p.getDisplayAsPercent==="function")b.displayPercent=p.getDisplayAsPercent()===true;}catch(ignorePercent){}
        return b;
    }
    function checkPropertyOverrideValue(p,rec,want,phase) {
        if(typeof want!=="number"||!isFinite(want))throw problem("PROPERTY_VALUE","Non-finite override for "+rec.propertyName);
        var b=propertyValueBounds(p);
        if(b.min!==null&&b.max!==null&&b.min>b.max)throw problem("PROPERTY_RANGE","Invalid native limits for "+rec.propertyName);
        // DAZ represents a percent-display morph as a native scalar (usually
        // 100% == 1). Never reinterpret a SAVED native value implicitly.
        if(b.clamped && ((b.min!==null&&want<b.min-1e-7)||(b.max!==null&&want>b.max+1e-7))) {
            var msg=String(rec.propertyLabel||rec.propertyName)+" requests native "+want+" during "+phase+
                ", but the current property limits are "+b.min+" .. "+b.max+".";
            if(b.displayPercent)msg+=" This control displays percentages: enter 100% (native 1), not raw 100, in Properties...";
            throw problem("PROPERTY_RANGE",msg);
        }
        return b;
    }
    function unavailableOverrideError(e) {
        // Missing/renamed/ambiguous scene controls are user-fixable advisory
        // conditions. Do not hide invalid saved data, invalid values, native
        // setValue errors, or broken scene/ownership invariants.
        return !!e && ["PROPERTY_MISSING","PROPERTY_AMBIGUOUS","PROPERTY_OWNER_NODE",
            "PROPERTY_TARGET_MISSING","PROPERTY_TARGET_PART"].indexOf(String(e.code||""))>=0;
    }
    function warnUnavailableOverride(rec,phase,e) {
        if(!ctx)return;
        if(!ctx.diag.unavailableProperties)ctx.diag.unavailableProperties=[];
        if(!ctx.unavailablePropertyKeys)ctx.unavailablePropertyKeys={};
        var tag=String(phase)+"|"+propertyOverrideKey(rec);
        if(own(ctx.unavailablePropertyKeys,tag))return;
        ctx.unavailablePropertyKeys[tag]=true;
        var record={phase:String(phase),target:overrideTargetDescription(rec),
            name:String(rec.propertyLabel||rec.propertyName),propertyName:String(rec.propertyName),reason:String(e)};
        ctx.diag.unavailableProperties.push(record);
        log("WARN","PROPERTY_UNAVAILABLE",record.target+" / "+record.name+" | "+record.reason+
            " | "+phase+" skipped; registered clothing operation continues.");
    }
    function optionalPropertyAccess(rec,phase,work) {
        try{return work();}catch(e){
            if(!unavailableOverrideError(e))throw e;
            warnUnavailableOverride(rec,phase,e);
            return null;
        }
    }
    function preflightSetPropertyOverrides(st,fig) {
        if(!ctx||(ctx.action!=="apply"&&ctx.action!=="restore_properties"&&ctx.action!=="partial_apply"))return;
        var wanted=setPropertyOverrides(st),text=value(fig,"PropertyState");
        if(!wanted.length&&!text)return;
        var previous=readAppliedPropertyState(fig),incoming={},oldMap={},inv=inventory(fig,app.db),i;
        for(i=0;i<wanted.length;i++)incoming[propertyOverrideKey(wanted[i])]=true;
        for(i=0;i<previous.entries.length;i++)oldMap[propertyOverrideKey(previous.entries[i])]=previous.entries[i];
        var ids=Object.keys(oldMap);
        if(ctx.action==="apply"||(ctx.action==="partial_apply"&&
            (ctx.partialChoice.removeCurrent||ctx.partialChoice.mode==="follow_rules")))
            for(i=0;i<ids.length;i++)if(!own(incoming,ids[i])) {
            var prev=oldMap[ids[i]];
            if(transitionPropertyShouldRemain(prev))continue;
            if(ctx.action==="partial_apply"&&!ctx.partialChoice.removeCurrent&&
                !(prev.targetKind==="item"&&(ctx.partialChoice.removedIDs||[]).indexOf(prev.itemID)>=0))continue;
            optionalPropertyAccess(prev,"reset",function(){
                var oldNode=propertyTargetNode(prev,fig,inv);
                checkPropertyOverrideValue(propertyHandleForOverride(oldNode,prev),prev,Number(prev.resetValue),"reset preflight");
                return true;
            });
        }
        for(i=0;i<wanted.length;i++){
            var rec=wanted[i];
            // Missing items must first be imported by the normal preflight/loader.
            // They are checked again immediately before their native write.
            if(rec.targetKind==="item"&&!own(inv,rec.itemID)){
                if(ctx.action==="restore_properties")throw problem("PROPERTY_TARGET_MISSING","Cannot restore unloaded property target: "+rec.itemID);
                continue;
            }
            optionalPropertyAccess(rec,"apply",function(){
                var node=propertyTargetNode(rec,fig,inv);
                checkPropertyOverrideValue(propertyHandleForOverride(node,rec),rec,Number(rec.applyValue),"apply preflight");
                return true;
            });
        }
    }
    function setPropertyOverrideNativeValue(p,want) {
        // Overrides store evaluated native values (getValue), not raw values.
        // Fitted scale multiplies the raw value by the figure's scale; setValue
        // alone does not compensate for that native transform contribution.
        if(typeof DzFloatProperty!=="undefined" && typeof p.getTransformType==="function" &&
                p.getTransformType()===DzFloatProperty.SCALE &&
                typeof p.adjustValue==="function") {
            var raw=Number(p.adjustValue(want));
            if(!isFinite(raw))throw problem("PROPERTY_VALUE","Non-finite adjusted scale value.");
            // DAZ 6 omits setRawValue; its scale setValue accepts the raw
            // transform value as well. Verify the evaluated result at caller.
            if(typeof p.setRawValue==="function")p.setRawValue(raw);
            else p.setValue(raw);
        } else p.setValue(want);
    }
    function writePropertyOverride(node,rec,valueToSet,phase) {
        var p=propertyHandleForOverride(node,rec),want=Number(valueToSet),before=Number(p.getValue());
        if(!isFinite(want)||!isFinite(before))throw problem("PROPERTY_VALUE","Non-finite property value for "+rec.propertyName);
        var bounds=checkPropertyOverrideValue(p,rec,want,phase);
        if(closeNumbers(before,want))return false;
        rememberPropertyRollback(node,rec,p);
        setPropertyOverrideNativeValue(p,want);
        var after=Number(p.getValue());
        if(!isFinite(after)||!closeNumbers(after,want)) {
            var hint=bounds.displayPercent?" Check that this is a native scalar (100% = 1.0), and that the property is not driven/locked.":" Check property limits, locks and controllers.";
            throw problem("PROPERTY_WRITE",String(rec.propertyLabel||rec.propertyName)+" on "+node.getLabel()+
                " did not accept native "+want+" during "+phase+"; read back "+after+"."+hint);
        }
        log("INFO","PROPERTY_"+phase.toUpperCase(),String(rec.propertyLabel||rec.propertyName)+" | target="+node.getLabel()+" | from="+before+" | to="+after);
        return true;
    }
    function rollbackPropertyWrites(errors) {
        if(!ctx || !ctx.propertyRollback || !ctx.propertyRollback.length)return true;
        var ok=true;
        for(var i=ctx.propertyRollback.length-1;i>=0;i--){
            var r=ctx.propertyRollback[i];
            try{
                var n=live(r.nodeKey);if(!n)throw problem("PROPERTY_ROLLBACK_NODE",r.nodeKey);
                var p=propertyHandleForOverride(n,r.locator||{propertyName:r.propertyName});
                if(!p||typeof p.setValue!=="function")throw problem("PROPERTY_ROLLBACK_PROPERTY",r.propertyName);
                setPropertyOverrideNativeValue(p,Number(r.value));
                var got=Number(p.getValue());if(!isFinite(got)||!closeNumbers(got,Number(r.value)))throw problem("PROPERTY_ROLLBACK_VALUE",r.propertyName);
            }catch(e){ok=false;if(errors)errors.push(errorText(e));}
        }
        if(ok)log("PASS","PROPERTY_ROLLBACK",ctx.propertyRollback.length+" property value(s) restored.");
        return ok;
    }
    function applySetPropertyOverrides(st,fig) {
        if(!ctx || (ctx.action!=="apply" && ctx.action!=="undress_all" && ctx.action!=="partial_apply"))return;
        requireUnscoped("applySetPropertyOverrides");
        if(ctx.action==="partial_apply")return applyPartialPropertyOverrides(st,fig);
        var desired=setPropertyOverrides(st),previous=readAppliedPropertyState(fig),inv=inventory(fig,app.db),oldMap={},newMap={},i;
        for(i=0;i<previous.entries.length;i++)oldMap[propertyOverrideKey(previous.entries[i])]=previous.entries[i];
        for(i=0;i<desired.length;i++)newMap[propertyOverrideKey(desired[i])]=desired[i];
        var retainedEntries=[];
        for(i=0;i<previous.entries.length;i++){
            var old=previous.entries[i],oldKey=propertyOverrideKey(old);
            if(!own(newMap,oldKey)&&transitionPropertyShouldRemain(old)){
                newMap[oldKey]=clonePlain(old);retainedEntries.push(clonePlain(old));
            }
        }
        var ownPending=false;
        if(!value(fig,"Pending")){
            ctx.pending={schemaVersion:1,operationID:ctx.id,libraryID:app.db.libraryID,action:"ApplySetProperties",setID:st.id||"",ownerFigureID:figureIdentity(fig,true)};
            txData(fig,{Pending:jsonText(ctx.pending)});ownPending=true;
        }
        var resetCount=0,applyCount=0,keys=Object.keys(oldMap);
        for(i=0;i<keys.length;i++){
            var k=keys[i];if(own(newMap,k))continue;
            var oldRec=oldMap[k];
            if(optionalPropertyAccess(oldRec,"reset",function(){
                var oldNode=propertyTargetNode(oldRec,fig,inv);
                return writePropertyOverride(oldNode,oldRec,oldRec.resetValue,"reset");
            }))resetCount++;
        }
        keys=Object.keys(newMap);
        for(i=0;i<keys.length;i++){
            if(own(newMap,keys[i])&&retainedEntries.length){
                var carried=false;
                for(var ce=0;ce<retainedEntries.length;ce++)if(propertyOverrideKey(retainedEntries[ce])===keys[i]){carried=true;break;}
                if(carried)continue;
            }
            var newRec=newMap[keys[i]];
            if(optionalPropertyAccess(newRec,"apply",function(){
                var newNode=propertyTargetNode(newRec,fig,inv);
                return writePropertyOverride(newNode,newRec,newRec.applyValue,"apply");
            }))applyCount++;
        }
        if(resetCount||applyCount){try{Scene.update();processEvents();}catch(ignorePropertyUpdate){}}
        var recorded=desired.concat(retainedEntries);
        if(recorded.length)txData(fig,{PropertyState:jsonText({schemaVersion:1,setID:String(st.id||""),entries:clonePlain(recorded)})});
        else unsetData(fig,"PropertyState");
        if(ownPending)unsetData(fig,"Pending");
        ctx.diag.propertyOverrides={previousSetID:String(previous.setID||""),targetSetID:String(st.id||""),resetCount:resetCount,applyCount:applyCount,retained:retainedEntries.length,entries:clonePlain(recorded)};
        log("PASS","SET_PROPERTIES",String(st.name||"<no set>")+" | reset="+resetCount+" | applied="+applyCount+" | managed="+desired.length);
    }

    function applyPartialPropertyOverrides(st,fig) {
        // The saved set is NOT mutated. This state is a composition of the
        // currently managed properties plus explicitly chosen ones.
        requireUnscoped("applyPartialPropertyOverrides");
        var choice=ctx.partialChoice,selected=setPropertyOverrides(st),previous=readAppliedPropertyState(fig),inv=inventory(fig,app.db),i;
        var prior={},incoming={},merged={},k,oldKeys,chosenKeys;
        var removedMap={};
        for(i=0;i<(choice.removedIDs||[]).length;i++)removedMap[choice.removedIDs[i]]=true;
        for(i=0;i<previous.entries.length;i++){
            var beforeRec=previous.entries[i];
            k=propertyOverrideKey(beforeRec);prior[k]=beforeRec;
            if(!choice.removeCurrent && !(beforeRec.targetKind==="item"&&own(removedMap,beforeRec.itemID)))
                merged[k]=clonePlain(beforeRec);
        }
        for(i=0;i<selected.length;i++){
            k=propertyOverrideKey(selected[i]);incoming[k]=selected[i];
            merged[k]=clonePlain(selected[i]);
        }
        var ownPending=false;
        if(!value(fig,"Pending")){
            ctx.pending={schemaVersion:1,operationID:ctx.id,libraryID:app.db.libraryID,
                action:"PartialApplyProperties",setID:String(choice.sourceID),ownerFigureID:figureIdentity(fig,true)};
            txData(fig,{Pending:jsonText(ctx.pending)});ownPending=true;
        }
        var resetCount=0,applyCount=0;
        oldKeys=Object.keys(prior);
        if(choice.removeCurrent||choice.mode==="follow_rules")for(i=0;i<oldKeys.length;i++){
            k=oldKeys[i];if(own(incoming,k))continue;
            if(!choice.removeCurrent && !(prior[k].targetKind==="item"&&own(removedMap,prior[k].itemID)))continue;
            (function(rec){if(optionalPropertyAccess(rec,"partial reset",function(){
                return writePropertyOverride(propertyTargetNode(rec,fig,inv),rec,rec.resetValue,"reset");
            }))resetCount++;})(prior[k]);
        }
        chosenKeys=Object.keys(incoming);
        for(i=0;i<chosenKeys.length;i++){
            var rec=incoming[chosenKeys[i]];
            // A property selected by itself must not cause the clothing item
            // to be loaded. Only properties of already ACTIVE items are writable.
            if(rec.targetKind==="item"&&(!own(inv,rec.itemID)||inv[rec.itemID].where!=="active")){
                warnUnavailableOverride(rec,"partial apply",problem("PROPERTY_TARGET_MISSING",
                    "Select the item as well, or wear it first: "+String(rec.propertyLabel||rec.propertyName)));
                continue;
            }
            (function(entry){if(optionalPropertyAccess(entry,"partial apply",function(){
                return writePropertyOverride(propertyTargetNode(entry,fig,inv),entry,entry.applyValue,"apply");
            }))applyCount++;})(rec);
        }
        if(resetCount||applyCount)try{Scene.update();processEvents();}catch(ignorePropertyUpdate){}
        var result=[],mergedKeys=Object.keys(merged);
        for(i=0;i<mergedKeys.length;i++)result.push(merged[mergedKeys[i]]);
        if(result.length)txData(fig,{PropertyState:jsonText({schemaVersion:1,setID:"",entries:result})});
        else unsetData(fig,"PropertyState");
        if(ownPending)unsetData(fig,"Pending");
        ctx.diag.partialProperties={sourceSetID:choice.sourceID,selected:selected.length,
            previous:previous.entries.length,retained:result.length,resetCount:resetCount,applyCount:applyCount};
        log("PASS","PARTIAL_PROPERTIES","selected="+selected.length+" | applied="+applyCount+
            " | reset="+resetCount+" | retained="+result.length+" | removeCurrent="+choice.removeCurrent);
    }

    function restoreOnlySetApplyValues(st,fig) {
        // Reuse the proven write/rollback helpers but do NOT reset properties
        // from the preceding set. Preserve their state records so a later
        // ordinary Apply or Take Off All can reset them as usual.
        requireUnscoped("restoreOnlySetApplyValues");
        var desired=setPropertyOverrides(st),previous=readAppliedPropertyState(fig),inv=inventory(fig,app.db);
        var merged=clonePlain(previous.entries),positions={};
        for(var i=0;i<merged.length;i++)positions[propertyOverrideKey(merged[i])]=i;
        for(i=0;i<desired.length;i++){
            var rec=desired[i],k=propertyOverrideKey(rec);
            if(own(positions,k))merged[positions[k]]=clonePlain(rec);
            else{positions[k]=merged.length;merged.push(clonePlain(rec));}
        }
        var ownPending=false;
        if(!value(fig,"Pending")){
            ctx.pending={schemaVersion:1,operationID:ctx.id,libraryID:app.db.libraryID,
                action:"RestoreSetApplyValues",setID:String(st.id),ownerFigureID:figureIdentity(fig,true)};
            txData(fig,{Pending:jsonText(ctx.pending)});ownPending=true;
        }
        var changed=0;
        for(i=0;i<desired.length;i++){
            var target=propertyTargetNode(desired[i],fig,inv);
            if(writePropertyOverride(target,desired[i],desired[i].applyValue,"restore_apply"))changed++;
        }
        if(changed){try{Scene.update();processEvents();}catch(ignoreUpdate){}}
        txData(fig,{PropertyState:jsonText({schemaVersion:1,setID:String(st.id),entries:merged})});
        if(ownPending)unsetData(fig,"Pending");
        ctx.diag.propertyOverrides={mode:"restore_apply_only",previousSetID:String(previous.setID||""),
            targetSetID:String(st.id),resetCount:0,applyCount:changed,entries:clonePlain(desired),
            carriedForwardRecords:merged.length-desired.length};
        log("PASS","RESTORE_APPLY_VALUES","set="+st.name+" | changed="+changed+
            " | reset=0 | carried forward="+(merged.length-desired.length));
    }

    function restoreOutfitProperties(st,fig) {
        // Deliberately does NOT call applySet(), import any DUF, change Fit To,
        // move an item into/out of storage, or alter garment ownership.
        requireUnscoped("restoreOutfitProperties");
        var scopeError=scopeProblem(st,fig);
        if(scopeError)throw problem("SCOPE",scopeError);
        var before=readOutfitSummary(fig);
        if(!before.valid)throw problem("PROPERTY_RESTORE_STATUS",before.message);
        if(!outfitMatches(st,before))throw problem("PROPERTY_RESTORE_OUTFIT",
            "Registered clothing no longer exactly matches "+st.name+". Reopen the wardrobe and apply the full set first.");
        var check=withReadScope(function(){return diagnoseOutfitProperties(st,fig,before,inventory(fig,app.db));},false);
        if(check.missing.length)throw problem("PROPERTY_RESTORE_MISSING",
            "Resolve the unavailable properties before restoring any values.\n"+outfitPropertyDiagnosticText(st,check));
        // Unlike full Apply, Restore never resets a property that is not
        // explicitly listed by the selected set.
        preflightSetPropertyOverrides(st,fig);
        frameGuard();
        restoreOnlySetApplyValues(st,fig);
        applySavedSetPartStates(st,fig);
        frameGuard();
        var after=readOutfitSummary(fig);
        if(!after.valid||!outfitMatches(st,after))throw problem("PROPERTY_RESTORE_OUTFIT_CHANGED",
            "The complete registered outfit changed during property restore. Changes will be rolled back.");
        var verified=withReadScope(function(){return diagnoseOutfitProperties(st,fig,after,inventory(fig,app.db));},false);
        if(verified.status!=="worn")throw problem("PROPERTY_RESTORE_VERIFY",
            "One or more property values did not remain at their Apply values after updating the scene.\n"+
            outfitPropertyDiagnosticText(st,verified));
        ctx.diag.propertyRestore={setID:st.id,setName:st.name,changedBefore:check.changed.length,
            unavailableBefore:check.missing.length,verified:verified.total,clothingUnchanged:true};
        log("PASS","PROPERTY_RESTORE",st.name+" | properties="+verified.total+
            " | changed before="+check.changed.length+" | registered items unchanged");
        ctx.outcome="Restored Apply values for "+st.name+". Registered clothing was not changed. Save your scene to retain these values.";
    }

    function resetAppliedPropertyStateForFigure(fig,reason) {
        var text=value(fig,"PropertyState");if(!text)return 0;
        var state=readAppliedPropertyState(fig),inv=inventory(fig,app.db),count=0;
        for(var i=0;i<state.entries.length;i++){
            var rec=state.entries[i];
            if(optionalPropertyAccess(rec,"reset",function(){
                var node=propertyTargetNode(rec,fig,inv);
                return writePropertyOverride(node,rec,rec.resetValue,"reset");
            }))count++;
        }
        unsetData(fig,"PropertyState");
        if(count){try{Scene.update();processEvents();}catch(ignoreResetUpdate){}}
        log("INFO","PROPERTY_STATE_CLEARED",fig.getLabel()+" | previousSet="+String(state.setID||"")+" | reset="+count+" | reason="+String(reason||""));
        return count;
    }

    function setSelectionSnapshot(st, buttonText) {
        return {id:String(st.id), name:String(st.name), buttonText:String(buttonText),
            itemIDs:st.items.slice(0), figureType:String(st.figureType), scope:clonePlain(st.scope), properties:clonePlain(setPropertyOverrides(st)),partStates:clonePlain(setPartStates(st)),
            handPoses:clonePlain(st.handPoses||{}),libraryID:app.db.libraryID, commitID:app.db.commitID};
    }
    function validateSetSelection(st, payload, fig) {
        var selected = payload.selection || null;
        ctx.diag.requestedSet = {payloadID:payload.id, selected:selected ? clonePlain(selected) : null,
            resolvedID:st.id, resolvedName:st.name, itemIDs:st.items.slice(0), figureLabel:String(fig.getLabel()),
            libraryID:app.db.libraryID, commitID:app.db.commitID};
        log("INFO", "REQUEST_SET", "button=" + JSON.stringify(selected ? selected.buttonText : "<direct action>") +
            " | selectedName=" + JSON.stringify(selected ? selected.name : "<not captured>") +
            " | requestedID=" + payload.id + " | resolvedName=" + JSON.stringify(st.name) +
            " | resolvedID=" + st.id + " | members=" + describeIDs(st.items) + " | figure=" + fig.getLabel());
        if (payload.id !== st.id) throw problem("SET_REQUEST_MISMATCH", "Requested ID does not match the resolved set. Nothing was applied.");
        if (selected) {
            if (selected.id !== st.id || selected.name !== st.name || selected.figureType !== st.figureType ||
                !closeNumbers(selected.itemIDs, st.items) || !closeNumbers(selected.scope, st.scope) || !closeNumbers(selected.properties||[], setPropertyOverrides(st)) || !closeNumbers(selected.partStates||{},setPartStates(st)) ||
                !closeNumbers(selected.handPoses||{},st.handPoses||{}) || selected.libraryID !== app.db.libraryID || selected.commitID !== app.db.commitID ||
                selected.buttonText !== (ctx.action==="restore_properties"?"Restore Properties: ":"Apply: ")+selected.name)
                throw problem("SET_SELECTION_CHANGED", "The selected row/catalog no longer matches this action. Reopen the wardrobe window. Nothing was applied.");
        }
    }
    function tryOperationalNoop(st, fig, pf) {
        if(ctx && ctx.action==="partial_apply")return false; // partial property merge must always execute
        if(ctx && ctx.action==="apply" && hasSetMaterialSnapshots(st))return false; // full Set style must be verified
        // A pending shell may have been returned since the last Apply. Native
        // material restoration must not be bypassed by the structural fast-noop.
        if(ctx&&app.experimentalGeoShellRecovery&&
            geoWardrobeRestoreCandidates(st,pf.plan,fig).length)return false;
        if (!operationalVerification() || !pf.plan.noop || propertyTransitionNeeded(st,fig) || partStateTransitionNeeded(st,fig)) return false;
        requireUnscoped("operational_noop");
        var token = profileBegin("operational_noop"), started = new Date().getTime();
        var detail = {policy:"operational_structural_noop_v0310",attempted:true,passed:false,
            settlingObserved:false,poseCompared:false,materialsCompared:false,channelValuesRead:false,
            setID:st.id,setName:st.name,preflightSignature:pf.plan.signature};
        ctx.diag.fastNoop = detail;
        try {
            frameGuard();
            // preflight just validated scope, unique IDs, complete hierarchies,
            // ownership, active portable links and every stored Recovery record.
            // Read them afresh via the existing final-state validator; neither
            // this path nor its callees invokes sleep/update/processEvents/setters.
            var inv = verifyDesired(st, fig), ids = Object.keys(inv), sig = [];
            for (var i = 0; i < ids.length; i++) {
                var id = ids[i], inf = inv[id];
                sig.push(id + ":" + inf.where + ":" + inf.rootID + ":" + inf.instanceID);
            }
            var confirmedSignature = sig.sort().join("|");
            detail.confirmedSignature = confirmedSignature;
            if (confirmedSignature !== pf.plan.signature)
                throw problem("INVENTORY_CHANGED", "Inventory identity/location changed during read-only no-op validation.");
            assertNoPending(fig);
            var why = scopeProblem(st, fig);
            if (why) throw problem("SCOPE", why);
            frameGuard();
            var clean = ctx.loadCalls === 0 && ctx.operations.length === 0 &&
                !Object.keys(ctx.metaBefore).length && !Object.keys(ctx.created).length &&
                !Object.keys(ctx.rollbackRecords).length && !ctx.pending && !ctx.catalogCommitted &&
                ctx.diag.observations.length === 0;
            must(clean, "NOOP", "No imports, wardrobe metadata writes, parenting, Fit To or observation loops.");
            ctx.diag.plan = clonePlain(pf.plan);
            log("INFO", "PLAN", "set=" + st.name + " | setID=" + st.id + " | members=" + describeIDs(st.items) +
                " | keep=" + describeIDs(pf.plan.keep) + " | store=- | restore=- | load=- | noop=true");
            log("INFO", "NOOP_SCOPE", "Fresh registered inventory, unique identity/owner/hierarchy, active native links and stored Recovery validated. No geometry/pose/material stability claim; no observation or channel-reader certification requested.");
            detail.passed = true; ctx.fastNoop = true;
            ctx.diag.verificationPolicy = verificationPolicy();
            log("PASS", "FAST_NOOP", ctx.action === "undress_all" ?
                "No registered items worn. Actual inventory and stored Recovery validated; no observation or wardrobe writes." :
                st.name + " is already applied. Validated actual scene structure, not the last clicked button.");
            ctx.outcome = "Already applied: " + st.name + ". No wardrobe changes. Structural check only; no pose/material/settling audit.";
            return true;
        } finally {
            detail.elapsedMs = Math.max(0, new Date().getTime() - started);
            profileEnd(token);
        }
    }

    function undressInventorySnapshot(inv) {
        var ids = Object.keys(inv).sort(), records = {};
        for (var i = 0; i < ids.length; i++) {
            var inf = inv[ids[i]];
            records[ids[i]] = {where:inf.where, rootID:inf.rootID, instanceID:inf.instanceID,
                rootKey:key(inf.root), partKeys:inf.partKeys.slice(0).sort(), allKeys:inf.allKeys.slice(0).sort()};
        }
        return records;
    }
    function verifyUndressInventory(inv) {
        var detail = ctx && ctx.diag.undressAll;
        if (!detail || !detail.before) throw problem("UNDRESS_BASELINE", "Missing current-operation wardrobe identities.");
        var before = detail.before, ids = Object.keys(before).sort(), actual = Object.keys(inv).sort();
        if (ids.join("|") !== actual.join("|"))
            throw problem("UNDRESS_INVENTORY_CHANGED", "A registered item appeared or disappeared during Take Off All.");
        for (var i = 0; i < ids.length; i++) {
            var id = ids[i], old = before[id], now = inv[id];
            if (now.where !== "stored" || now.rootID !== old.rootID || now.instanceID !== old.instanceID ||
                    key(now.root) !== old.rootKey || !closeNumbers(now.partKeys.slice(0).sort(), old.partKeys) ||
                    !closeNumbers(now.allKeys.slice(0).sort(), old.allKeys))
                throw problem("UNDRESS_INSTANCE_CHANGED", app.db.items[id].name + ": original complete instance must remain in its own wardrobe storage.");
            if (old.where === "stored" && ctx.operations.some(function(op){return op.itemID === id;}))
                throw problem("UNDRESS_STORED_TOUCHED", app.db.items[id].name + ": an already stored item was targeted by a mutation.");
        }
        detail.verifiedCount = ids.length;
        detail.identityCheckPassed = true;
        log("PASS", "ALL_REGISTERED_STORED", ids.length + " original registered instances remain in this figure's storage; no items lost/replaced, none active.");
    }
    function undressAllRegistered(fig) {
        if (!ctx || ctx.action !== "undress_all" || !same(ctx.target, fig))
            throw problem("UNDRESS_CONTEXT", "Take Off All requires its own action and selected figure.");
        var token = profileBegin("undress_all");
        // Empty membership is a TRANSIENT command target, never a catalog set.
        // The existing planner therefore stores every active registered item,
        // and neither restores nor imports anything. No matching by labels.
        var target = {id:"", name:"All registered items off", figureType:String(fig.objectName),
            scope:{kind:"type"}, items:[]};
        ctx.diag.undressAll = {policy:"selected_owner_registered_only_v044", libraryID:app.db.libraryID,
            figureKey:key(fig), targetIsSavedSet:false, before:null, removedCount:0, identityCheckPassed:false,
            unmanagedRootsPolicy:"unchanged", otherOwnersPolicy:"unchanged", catalogWrites:0};
        log("INFO", "UNDRESS_SCOPE", "Take off all ACTIVE registered items of the selected figure in this library. Reuse its storage; keep already stored items. No preset imports, deletion, adoption or empty catalog set.");
        try {
            applySet(target, fig);
            var plan = ctx.diag.plan;
            if (!plan || plan.keep.length || plan.restore.length || plan.load.length || ctx.loadCalls || ctx.catalogCommitted ||
                    !ctx.diag.undressAll.identityCheckPassed)
                throw problem("UNDRESS_RESULT", "Unexpected Take Off All plan or unverified result.");
            ctx.undressedCount = plan.store.length;
            ctx.diag.undressAll.removedCount = ctx.undressedCount;
            ctx.diag.undressAll.noop = plan.noop;
            log("PASS", "UNDRESS_ALL", "Taken off " + ctx.undressedCount + " registered item(s); imports=0; existing item identities and wardrobe definitions retained.");
            ctx.outcome = ctx.undressedCount ?
                "Taken off " + ctx.undressedCount + " registered item(s) from " + fig.getLabel() + ". They remain in this figure's wardrobe storage. Apply any compatible saved set to dress it again." :
                "No registered items are currently worn by " + fig.getLabel() + ". Nothing was taken off.";
            ctx.outcome += " Unregistered items and other figures were not targeted. Save the scene to retain changed wardrobe state.";
        } finally {profileEnd(token);}
    }

    // v0.5.0: explicit, same-Genesis-type transfers. The ordinary Apply engine
    // remains unchanged. No source is selected by label, mesh or asset name.
    function transferInventory(fig, allowOwnPending) {
        if (!fig || !isFigure(fig) || !live(key(fig))) throw problem("TRANSFER_FIGURE", "A participating figure is no longer available.");
        if (allowOwnPending) transferCheckPending(fig); else assertNoPending(fig);
        var inv = inventory(fig, app.db), ids = Object.keys(inv);
        for (var i = 0; i < ids.length; i++) {
            var inf = inv[ids[i]], it = app.db.items[ids[i]];
            if (inf.where === "active") nativeLinkCheck(it, inf, fig);
            else validateRecovery(it, inf, fig, null, true);
        }
        return inv;
    }
    function transferItemFingerprint(inf) {
        // Capture only structural evidence for a UI choice; all values/materials
        // are read anew at execution. Runtime keys are never persisted identity.
        var parts = {}, pids = Object.keys(inf.parts).sort();
        for (var i = 0; i < pids.length; i++) {
            var n = inf.parts[pids[i]], refs = nodeReferences(n), rk = {};
            for (var r = 0; r < REF_FIELDS.length; r++) rk[REF_FIELDS[r]] = key(refs[REF_FIELDS[r]]);
            parts[pids[i]] = {nodeID:value(n,"NodeID"), runtimeKey:key(n), refs:rk,
                owner:value(n,"OwnerFigureID")};
        }
        var tree = inf.allKeys.slice(0).sort().map(function(k){
            var node = live(k); if (!node) throw problem("TRANSFER_NODE_MISSING", k);
            return {key:k,parent:key(node.getNodeParent()),className:String(node.className())};
        });
        return jsonText({rootID:inf.rootID,instanceID:inf.instanceID,where:inf.where,
            parts:parts,tree:tree,recovery:value(inf.root,"Recovery")});
    }
    function transferLocalPlan(st, fig) {
        frameGuard();
        var why = scopeProblem(st, fig); if (why) throw problem("SCOPE", why);
        var inv = transferInventory(fig, false), ids = Object.keys(inv).sort(), active = [], sig = [];
        for (var i = 0; i < ids.length; i++) {
            if (inv[ids[i]].where === "active") active.push(ids[i]);
            sig.push([ids[i],transferItemFingerprint(inv[ids[i]])]);
        }
        return {inventory:inv,plan:calculatePlan(active,st.items,inv,app.db.items),signature:jsonText(sig)};
    }
    function transferFigureByID(id, expectedKey) {
        checkedID(id, "Transfer owner");
        var matches = findData("FigureID", id);
        if (matches.length !== 1 || !isFigure(matches[0]) || (expectedKey && key(matches[0]) !== expectedKey))
            throw problem("TRANSFER_OWNER", "Missing, duplicated or replaced source figure: " + id);
        if (figureIdentity(matches[0], false) !== id) throw problem("TRANSFER_OWNER", id);
        return matches[0];
    }
    // A shell may change its native Shell Node control only as part of a
    // same-owner, same-Set GeoGraft transfer. Never relax arbitrary external
    // shell/rigid-follow references or infer identity from labels.
    function geoShellTransferEligible(st,it,source,selections){
        if(!app.experimentalGeoShellRecovery||!st||!it||!source||!Array.isArray(st.geoShellSnapshots))return false;
        for(var i=0;i<st.geoShellSnapshots.length;i++){
            var rec=st.geoShellSnapshots[i];
            if(rec.mode!=="registered_full"||rec.shellItemID!==it.id||st.items.indexOf(rec.graftItemID)<0)continue;
            if(selections){
                var picked=false,ownerID=figureIdentity(source,false);
                for(var z=0;z<selections.length;z++)if(selections[z].itemID===rec.graftItemID&&selections[z].ownerID===ownerID)picked=true;
                if(!picked)continue;
            }
            var inv=transferInventory(source,false),graft=inv[rec.graftItemID];
            if(graft&&graft.root){
                var attached=geoTransferIsAttached(source,graft.root);
                // Both choices have a validated inventory. An item in Wardrobe
                // must NOT remain attached; it can be transferred directly to
                // the recipient without temporarily mutating its source.
                if((graft.where==="active"&&attached)||
                   (graft.where==="stored"&&!attached))return true;
            }
        }
        return false;
    }
    function geoRetargetTransferredShell(shell,source,target){
        if(!shell||!shell.inherits("DzGeometryShellNode"))
            throw problem("GEO_SHELL_TARGET_TYPE","Expected a live DzGeometryShellNode.");
        // Some versions of DAZ update the native Shell Node implicitly when
        // Fit To is changed. Treat an already-correct target as success.
        if(same(shell.getTarget(),target))return;
        if(!same(shell.getTarget(),source))
            throw problem("GEO_SHELL_SOURCE_CHANGED","A transferred GeoShell no longer targets the expected original figure.");
        var control=typeof shell.getShellNodeControl==="function"?shell.getShellNodeControl():null;
        if(!control||typeof control.setValue!=="function")
            throw problem("GEO_SHELL_TARGET_CONTROL","DAZ does not expose the native Shell Node control.");
        control.setValue(target);
        if(!same(shell.getTarget(),target))throw problem("GEO_SHELL_TARGET_FAILED",String(shell.getLabel()));
        log("PASS","GEO_TRANSFER_SHELL_TARGET",String(shell.getLabel())+" | "+source.getLabel()+" -> "+target.getLabel());
    }
    function transferCompatibility(it, inf, source, target, allowShellRetarget) {
        if (same(source,target) || String(source.objectName) !== it.figureType || String(target.objectName) !== it.figureType)
            throw problem("TRANSFER_TYPE", it.name + ": transfer requires two distinct figures of the saved Genesis type.");
        foreignDataGuard(inf.root, false);
        // The existing restore engine writes root parent, Fit To and collision.
        // Internal shell/rigid links remain unchanged. An external retarget of
        // either is deliberately excluded from this first transfer release.
        for (var p = 0; p < it.parts.length; p++) {
            var spec = it.parts[p], n = inf.parts[spec.id], actual = nodeReferences(n);
            for (var r = 0; r < REF_FIELDS.length; r++) {
                var field = REF_FIELDS[r], to = resolvePortable(spec.refs[field], target, inf.parts);
                if (field === "shell" || field === "rigidFollow") {
                    if (!same(actual[field], to)) {
                        var nativeShell=field==="shell"&&allowShellRetarget===true&&spec.root&&
                            n.inherits("DzGeometryShellNode")&&same(actual.shell,source)&&same(to,target)&&
                            same(n.getTarget(),source)&&typeof n.getShellNodeControl==="function"&&
                            !!n.getShellNodeControl()&&typeof n.getShellNodeControl().setValue==="function";
                        if(!nativeShell)throw problem("TRANSFER_EXTERNAL_FOLLOW",
                            it.name+" / "+field+": unsupported external follow retarget.");
                    }
                }
                if (field === "parent" && !spec.root && !same(actual.parent,to))
                    throw problem("TRANSFER_INTERNAL_PARENT", it.name + ": non-root parent would change.");
                if (field === "collision" && to) {
                    var cp = prop(n,"Collision Item");
                    if (!cp || typeof cp.setValue !== "function") throw problem("TRANSFER_COLLISION", it.name);
                }
                if (field === "follow" && to && (!n.inherits("DzSkeleton") || typeof n.setFollowTarget !== "function"))
                    throw problem("TRANSFER_FIT_API", it.name);
            }
        }
    }
    function transferSourceDescriptor(it, inf, source) {
        return {itemID:it.id,ownerID:figureIdentity(source,false),figureKey:key(source),
            ownerLabel:String(source.getLabel()),rootID:inf.rootID,instanceID:inf.instanceID,
            rootLabel:String(inf.root.getLabel()),where:inf.where,fingerprint:transferItemFingerprint(inf)};
    }
    function discoverOutfitSources(st, fig) {
        return withReadScope(function(){
            var why=scopeProblem(st,fig);if(why)throw problem("SCOPE",why);
            assertNoPending(fig);
            var quick=inventory(fig,app.db);
            if(st.items.every(function(id){return own(quick,id);}))return null;
            var local = transferLocalPlan(st, fig), rows = [], wanted = {}, byOwner = {}, anyOther = false;
            for (var i = 0; i < local.plan.load.length; i++) {
                var id = local.plan.load[i];
                wanted[id] = {itemID:id,itemName:app.db.items[id].name,iconNodeKey:"",options:[],blocked:[]};rows.push(wanted[id]);
            }
            if (!rows.length) return null;
            var nodes = sceneNodes(), targetOwner = figureIdentity(fig,false);
            for (var k = 0; k < nodes.length; k++) {
                var n = nodes[k], d = dataObject(n);
                if (!d || d.LibraryID !== app.db.libraryID || d.Role !== "ItemRoot" || !own(wanted,d.ItemID) || d.OwnerFigureID === targetOwner) continue;
                var row = wanted[d.ItemID]; anyOther = true;
                try {
                    var source = transferFigureByID(d.OwnerFigureID, ""), sk = key(source);
                    if (!own(byOwner,sk)) byOwner[sk] = transferInventory(source,false);
                    var inf = byOwner[sk][d.ItemID];
                    if (!inf || !same(inf.root,n)) throw problem("TRANSFER_SOURCE", "Source does not match its validated inventory.");
                    transferCompatibility(app.db.items[d.ItemID],inf,source,fig,geoShellTransferEligible(st,app.db.items[d.ItemID],source));
                    row.options.push(transferSourceDescriptor(app.db.items[d.ItemID],inf,source));
                    // Choose Sources needs the actual wearable DzNode for WM2 icon rules.
                    // Store only a transient scene key in the UI model, never in transfer decisions.
                    if(!row.iconNodeKey)row.iconNodeKey=key(inf.root);
                } catch(e) {row.blocked.push({label:String(n.getLabel()),reason:errorText(e)});}
            }
            for (var j = 0; j < rows.length; j++) rows[j].options.sort(function(a,b){
                return (a.ownerLabel+"|"+a.ownerID+"|"+a.instanceID).localeCompare(b.ownerLabel+"|"+b.ownerID+"|"+b.instanceID);
            });
            // Invalid/blocked external candidates are not actionable choices.
            // Never show an all-copy-only source picker; direct Apply does the
            // same file imports without asking a meaningless question.
            var transferable=false;
            for(var r=0;r<rows.length;r++)if(rows[r].options.length){transferable=true;break;}
            if (!transferable) return null;
            return {schemaVersion:1,libraryID:app.db.libraryID,commitID:app.db.commitID,setID:st.id,
                targetKey:key(fig),targetFigureID:targetOwner,targetLabel:String(fig.getLabel()),
                frame:Number(Scene.getFrame()),targetSignature:local.signature,missingIDs:local.plan.load.slice(0),rows:rows};
        },false);
    }
    function transferSourceLocationText(source) {
        // Display only. Source identity and location are validated separately.
        // Never infer storage from a group name, visibility or the owner's label.
        var owner = source && typeof source.ownerLabel === "string" ? source.ownerLabel : "<unknown owner>";
        if (source && source.where === "stored") return owner + "'s wardrobe";
        if (source && source.where === "active") return owner;
        return owner + " (source location unknown)";
    }
    function transferSourceEffectText(source, targetLabel) {
        if (!source) return "Load a separate instance from the saved preset. This choice does not take an item from another figure.";
        var owner = String(source.ownerLabel), target = String(targetLabel);
        if (source.where === "active") return "Take this item off " + owner + " and transfer it to " + target + ".";
        if (source.where === "stored") return "Retrieve this item from " + transferSourceLocationText(source) +
            " and transfer it to " + target + ". This choice does not remove anything currently worn by " + owner + ".";
        return "Source location is unknown. The source must pass validation before a transfer can run.";
    }
    function outfitSourceChoicesDialog(model) {
        var dlg=newGeorgiaDialog();dlg.caption=TITLE+" - Choose Sources";
        // Use a custom footer and explicit mutually exclusive choice buttons.
        // Native DAZ radio buttons do not match the Partial Sets action style.
        dlg.showHelpButton(false);dlg.showAcceptButton(false);dlg.showCancelButton(false);
        var box=new DzVGroupBox(dlg);

        var heading=label(box,"Choose a source for each item missing from "+model.targetLabel+"."),headingFont=newGeorgiaFont();
        headingFont.pixelSize=20;headingFont.bold=true;heading.font=headingFont;heading.alignment=0x84;
        try{heading.getWidget().setStyleSheet("QLabel { color: #87CEEB; font-weight: bold; }");}catch(ignoreHeadingStyle){}
        heading.setFixedHeight(34);

        var area=new DzScrollArea(box);area.widgetResizable=true;area.setHorizontalScrollbarDisplay(false);
        var body=new DzVGroupBox(area);flattenGroupBox(body);area.setWidget(body);
        var controls=[],notice=label(box,""),titleFont=newGeorgiaFont();titleFont.pixelSize=14;

        function sourceLabel(o){
            if(!o)return "";
            if(o.where==="stored")return "Transfer from "+String(o.ownerLabel)+"'s Wardrobe";
            return "Transfer from "+String(o.ownerLabel);
        }
        function selectedOption(c){
            if(!c.transfer.checked)return null;
            if(!c.row.options.length)return null;
            if(c.sourceCombo)return c.row.options[c.sourceCombo.currentItem];
            return c.row.options[0];
        }
        function styleChoice(button,active,available){
            var border=active?"#69B58A":"#696A70",back=active?"#33483D":"#37383C";
            if(!available){border="#4F5054";back="#28292C";}
            button.sizedFromIcon=false;
            try{button.getWidget().setStyleSheet(
                'QPushButton { color: '+(available?'#F1F1F1':'#919296')+'; font-weight: '+(active?'bold':'normal')+'; '+
                'background-color: '+back+'; border: 1px solid '+border+'; border-radius: 4px; '+
                'padding: 3px 10px; text-align: left; }'+
                'QPushButton:hover { border: 2px solid '+border+'; }'+
                'QPushButton:pressed { background-color: #54565A; }');}
            catch(ignoreChoiceStyle){}
        }
        function refresh(){
            var transfers=0,stored=0,worn=0;
            for(var j=0;j<controls.length;j++){
                var c=controls[j],o=selectedOption(c);
                if(c.sourceCombo){if(c.transfer.checked)c.sourceCombo.show();else c.sourceCombo.hide();}
                styleChoice(c.copy,c.copy.checked,true);
                styleChoice(c.transfer,c.transfer.checked,c.row.options.length>0);
                if(o){transfers++;if(o.where==="stored")stored++;else if(o.where==="active")worn++;}
            }
            notice.text="Selected: "+transfers+" transfer(s), "+(controls.length-transfers)+" separate copy/copies"+
                (transfers?" | from wardrobe: "+stored+" | currently worn sources: "+worn:"");
        }

        var listContentHeight=8;
        for(var i=0;i<model.rows.length;i++)(function(row){
            var lineHeight=row.options.length>1?145:110;
            var line=new DzHGroupBox(body);flattenGroupBox(line);line.setFixedHeight(lineHeight);
            listContentHeight+=lineHeight;
            var icon=new DzPushButton(line);icon.setFixedSize(91,91);icon.toolTip=row.itemName;
            setWardrobeEditorItemIcon(icon,{name:row.itemName,itemID:row.itemID,nodeKey:row.iconNodeKey||""});

            var choices=new DzVGroupBox(line);flattenGroupBox(choices);choices.setFixedHeight(lineHeight-6);choices.minWidth=650;
            var title=label(choices,row.itemName);title.font=titleFont;title.setFixedHeight(24);title.alignment=0x81;
            var copy=new DzPushButton(choices);copy.text="Load Separate Copy";
            copy.autoDefault=false;copy.checkable=true;copy.checked=true;copy.setFixedSize(470,30);
            var transfer=new DzPushButton(choices),combo=null;
            transfer.autoDefault=false;transfer.checkable=true;transfer.checked=false;transfer.setFixedSize(470,30);

            if(row.options.length===1){
                transfer.text=sourceLabel(row.options[0]);
            }else if(row.options.length>1){
                transfer.text="Transfer Existing";
                combo=new DzComboBox(choices);combo.minWidth=520;
                for(var j=0;j<row.options.length;j++)combo.addItem(sourceLabel(row.options[j])+" - instance "+row.options[j].instanceID);
                combo.currentItem=0;combo.hide();
                connect(combo,"activated(int)",refresh);
            }else{
                transfer.text="Transfer unavailable";transfer.enabled=false;
                if(row.blocked.length)transfer.toolTip=row.blocked.map(function(b){return b.label+": "+b.reason;}).join("\n");
            }
            connect(copy,"clicked()",function(){copy.checked=true;transfer.checked=false;refresh();});
            connect(transfer,"clicked()",function(){
                if(!row.options.length){copy.checked=true;transfer.checked=false;}
                else {copy.checked=false;transfer.checked=true;}
                refresh();
            });
            controls.push({row:row,copy:copy,transfer:transfer,sourceCombo:combo});
        })(model.rows[i]);

        var listHeight=Math.max(112,Math.min(440,listContentHeight));area.setFixedHeight(listHeight);

        var bar=new DzHGroupBox(box);flattenGroupBox(bar);bar.setFixedHeight(72);
        var barLayout=new DzBoxLayout(bar);
        // Native text+icon button: keep icon INSIDE the button and explicitly
        // size from icon (requested by user). Do not split into icon/text pair.
        function sourceBulkControl(text,resource,width,handler){
            var button=new DzPushButton(bar);
            button.text = text; button.sizedFromIcon = true;
            button.setFixedSize(width,64);
            if(!setSourcePickerTextIcon(button,resource,width,64)){
                button.text=text;button.sizedFromIcon=true;
            }
            
            connect(button,"clicked()",handler);
            barLayout.addWidget(button);
            return button;
        }
        barLayout.addStretch(1);
        var copies=sourceBulkControl("                Load Copies for All","Wearable Manager Load All.png",220,function(){
            for(var i=0;i<controls.length;i++){controls[i].copy.checked=true;controls[i].transfer.checked=false;}
            refresh();
        });
        barLayout.addSpacing(12);
        var uniqueSources=sourceBulkControl("                 Transfer When Unambiguous","Wearable Manager Transfer.png",220,function(){
            for(var i=0;i<controls.length;i++){
                var c=controls[i],can=c.row.options.length===1;c.transfer.checked=can;c.copy.checked=!can;
            }
            refresh();
        });
        barLayout.addStretch(1);
        
        notice.setFixedHeight(22);
        var footerGap=new DzLabel(box);footerGap.text="";footerGap.setFixedHeight(10);
        var footer=new DzHGroupBox(box);flattenGroupBox(footer);
        footer.insideMargin=0;footer.insideSpacing=10;footer.setFixedHeight(56);
        var gap=new DzLabel(footer),proceed=new DzPushButton(footer),cancel=new DzPushButton(footer);
        gap.text="";gap.minWidth=540;
        function footerStyle(button,caption,width,border,background){
            button.text=caption;button.autoDefault=false;button.sizedFromIcon=false;
            button.setFixedSize(width,36);
            try{button.getWidget().setStyleSheet('QPushButton { color: #F0F0F0; font-weight: bold; '+
                'background-color: '+background+'; border: 1px solid '+border+'; '+
                'border-radius: 4px; padding: 3px 9px; }'+
                'QPushButton:hover { border: 2px solid '+border+'; }'+
                'QPushButton:pressed { background-color: #55565A; }');}
            catch(ignoreFooterStyle){}
        }
        footerStyle(proceed,"Continue",135,"#69B58A","#33483D");
        footerStyle(cancel,"Cancel",115,"#B87B7B","#453737");
        var rightPadding=new DzLabel(footer);rightPadding.text="";rightPadding.setFixedWidth(10);
        var accepted=false;
        connect(proceed,"clicked()",function(){accepted=true;dlg.close();});
        connect(cancel,"clicked()",function(){accepted=false;dlg.close();});
        refresh();dlg.addWidget(box);
        // Separate Continue/Cancel from bulk actions by another explicit 10px;
        // trim surplus bottom space while retaining 10px footer padding.
        var dialogHeight=Math.min(695,listHeight+172);
        dlg.setFixedSize(860,dialogHeight);var result=null;
        try{
            dlg.exec();
            if(accepted){
                result=clonePlain(model);delete result.rows;result.decisions=[];
                for(var c=0;c<controls.length;c++){
                    var cr=controls[c],o=selectedOption(cr);
                    if(cr.transfer.checked&&!o)throw problem("TRANSFER_CHOICE","Transfer source is unavailable.");
                    result.decisions.push({itemID:cr.row.itemID,kind:o?"transfer":"copy",source:o?clonePlain(o):null});
                }
            }
        }finally{dlg.deleteLater();}
        return result;
    }
    function numberedLabelBase(text) {
        return trim(String(text || "")).replace(/\s*\(\d+\)\s*$/, "").toLowerCase();
    }
    function hasTrailingNumberedLabel(text) {
        return /\s*\(\d+\)\s*$/.test(String(text || ""));
    }
    function possibleUnregisteredLabelMatches(st, fig) {
        // Advisory ONLY. The actual wardrobe engine continues to use persistent
        // Item/Part/Instance/Node identities. This helper never adopts, removes,
        // reuses or suppresses an item based on its label.
        return withReadScope(function () {
            var inv = inventory(fig, app.db), ids = Object.keys(inv), active = [], managedRoots = {}, i;
            for (i = 0; i < ids.length; i++) {
                if (inv[ids[i]].where === "active") active.push(ids[i]);
                managedRoots["$" + key(inv[ids[i]].root)] = true;
            }
            var plan = calculatePlan(active, st.items, inv, app.db.items), incoming = {}, order = plan.restore.concat(plan.load);
            for (i = 0; i < order.length; i++) incoming[order[i]] = true;
            if (!order.length) return [];
            var roots = candidates(fig), matches = [];
            for (var c = 0; c < roots.length; c++) {
                var n = roots[c], rk = key(n);
                if (own(managedRoots, "$" + rk)) continue;
                // Only completely unregistered Wardrobe Sets candidates qualify
                // for this friendly warning. Wrong-library/corrupt own metadata
                // remains the responsibility of the normal identity validators.
                if (dataObject(n)) continue;
                var actualLabel = String(n.getLabel()), actualBase = numberedLabelBase(actualLabel);
                if (!actualBase) continue;
                for (var j = 0; j < order.length; j++) {
                    var id = order[j], item = app.db.items[id];
                    if (!item) continue;
                    var expectedLabel = String(item.name), expectedBase = numberedLabelBase(expectedLabel);
                    if (actualBase !== expectedBase) continue;
                    // Keep the heuristic deliberately narrow: exact display label
                    // or a DAZ-style final numeric suffix such as (2)/(3).
                    if (actualLabel !== expectedLabel && !hasTrailingNumberedLabel(actualLabel) && !hasTrailingNumberedLabel(expectedLabel)) continue;
                    matches.push({itemID:id,itemName:item.name,candidateLabel:actualLabel,runtimeKey:rk,
                        referenceManagerData:!!n.findDataItem("MatewWearables"),advisoryOnly:true});
                }
            }
            return matches;
        }, false);
    }
    function confirmPossibleUnregisteredLabelMatches(st, fig) {
        var matches = possibleUnregisteredLabelMatches(st, fig);
        if (!matches.length) return {accepted:true,matches:[]};
        var lines = ["Possible matching unregistered item(s) are already attached to " + fig.getLabel() + ":", ""];
        var max = Math.min(matches.length, 12);
        for (var i = 0; i < max; i++) lines.push("- " + matches[i].candidateLabel + "  <->  " + matches[i].itemName +
            (matches[i].referenceManagerData ? "  [Wearables Manager data detected]" : ""));
        if (matches.length > max) lines.push("- ... and " + (matches.length - max) + " more");
        lines.push("", "The label similarity does NOT prove these are the same item. Wardrobe Sets will not remove, register, reuse, or skip any unregistered item because of its label.",
            "Continuing may place the registered outfit item alongside the existing unregistered item.");
        var answer = MessageBox.warning(lines.join("\n"), TITLE + " - Possible Matching Item", "&Continue", "&Cancel");
        return {accepted:answer === 0,matches:matches};
    }

    function chooseOutfitSources(st, fig) {
        requireUnscoped("chooseOutfitSources");
        var model=discoverOutfitSources(st,fig);
        return model ? outfitSourceChoicesDialog(model) : {legacy:true};
    }
    function validateOutfitSourceChoices(st, fig, choice) {
        if (!choice || choice.legacy===true) return null;
        if(choice.schemaVersion!==1||choice.libraryID!==app.db.libraryID||choice.commitID!==app.db.commitID||
            choice.setID!==st.id||choice.targetKey!==key(fig)||choice.targetFigureID!==figureIdentity(fig,false)||
            choice.frame!==Number(Scene.getFrame()))throw problem("TRANSFER_CHOICE_STALE","Figure, frame or catalog changed after choosing sources. Reopen Apply.");
        var local=transferLocalPlan(st,fig);
        if(local.signature!==choice.targetSignature||!closeNumbers(local.plan.load,choice.missingIDs))
            throw problem("TRANSFER_CHOICE_STALE","The recipient's wardrobe changed after choosing sources.");
        expectList(choice.decisions,"Source choices");
        if(choice.decisions.length!==local.plan.load.length)throw problem("TRANSFER_CHOICE","Incomplete choices.");
        var seen={},transfers=[];
        for(var i=0;i<choice.decisions.length;i++){
            var d=choice.decisions[i];expectObject(d,"Source choice");
            if(own(seen,d.itemID)||local.plan.load.indexOf(d.itemID)<0)throw problem("TRANSFER_CHOICE","Unexpected or repeated item.");seen[d.itemID]=true;
            if(d.kind==="transfer"){
                expectObject(d.source,"Transfer instance");
                if(d.source.itemID!==d.itemID)throw problem("TRANSFER_CHOICE","Source item mismatch.");transfers.push(clonePlain(d.source));
            }else if(d.kind!=="copy"||d.source!==null)throw problem("TRANSFER_CHOICE","Unknown source mode.");
        }
        return {local:local,transfers:transfers};
    }
    function transferPreflight(st, target, selections) {
        return withReadScope(function(){
            var local=transferLocalPlan(st,target), plan=local.plan, participants={}, sources=[], seen={}, token=[];
            participants[key(target)]={figure:target,inv:local.inventory};
            for(var i=0;i<selections.length;i++){
                var d=selections[i], it=app.db.items[d.itemID];
                if(!it||own(seen,d.itemID)||plan.load.indexOf(d.itemID)<0)throw problem("TRANSFER_SOURCE_CHANGED","A transferred item is no longer missing on the target.");
                seen[d.itemID]=true;
                var source=transferFigureByID(d.ownerID,d.figureKey), sk=key(source);
                if(!own(participants,sk))participants[sk]={figure:source,inv:transferInventory(source,false)};
                var inf=participants[sk].inv[d.itemID];
                if(!inf||inf.rootID!==d.rootID||inf.instanceID!==d.instanceID||inf.where!==d.where||transferItemFingerprint(inf)!==d.fingerprint)
                    throw problem("TRANSFER_SOURCE_CHANGED",it.name+": chosen source instance changed; no replacement selected.");
                transferCompatibility(it,inf,source,target,geoShellTransferEligible(st,it,source,selections));
                sources.push({itemID:it.id,sourceKey:sk,inf:inf,descriptor:clonePlain(d)});
            }
            plan.transfer=sources.map(function(s){return s.itemID;});
            plan.load=plan.load.filter(function(id){return !own(seen,id);});
            plan.noop=false;
            for(var j=0;j<plan.load.length;j++)validatePreset(app.db.items[plan.load[j]]);
            var keys=Object.keys(participants).sort();
            for(var k=0;k<keys.length;k++){
                var part=participants[keys[k]],ids=Object.keys(part.inv).sort(),records=[];
                for(var x=0;x<ids.length;x++)records.push([ids[x],transferItemFingerprint(part.inv[ids[x]])]);
                token.push([keys[k],figureIdentity(part.figure,false),records]);
            }
            return {local:local,plan:plan,participants:participants,sources:sources,signature:jsonText(token)};
        },false);
    }
    function transferCheckPending(fig) {
        var tx=ctx&&ctx.transferTxn,text=value(fig,"Pending"),k=key(fig);
        if(tx&&tx.pendingText&&text===tx.pendingText)return;
        if(tx&&own(tx.marked,k))throw problem("TRANSFER_PENDING_CHANGED","A participating figure's pending marker changed.");
        else if(text)throw problem("PENDING_OPERATION","A participating figure has another unfinished wardrobe action.");
    }
    function transferCurrentInventories(tx) {
        return withReadScope(function(){
            var out={},keys=tx.participantKeys;
            for(var i=0;i<keys.length;i++){
                var fig=live(keys[i]);
                if(!fig||figureIdentity(fig,false)!==tx.ownerIDs[keys[i]])throw problem("TRANSFER_FIGURE_CHANGED",keys[i]);
                out[keys[i]]={figure:fig,inv:transferInventory(fig,true)};
            }
            return out;
        },false);
    }
    function transferAssertInventories(tx) {
        var current=transferCurrentInventories(tx);
        for(var i=0;i<tx.participantKeys.length;i++){
            var k=tx.participantKeys[i];
            if(!closeNumbers(undressInventorySnapshot(current[k].inv),tx.expected[k]))
                throw problem("TRANSFER_INVENTORY_CHANGED","Unexpected item/instance/hierarchy/location change on "+current[k].figure.getLabel());
        }
        return current;
    }
    function transferResetSourceProperties(tx,sourceKey,current) {
        var participant=current[sourceKey],ids=Object.keys(tx.snapshots[sourceKey]);
        // Prove the original state before the intentional property writes.
        for(var i=0;i<ids.length;i++)compareMeasured(tx.snapshots[sourceKey][ids[i]],participant.inv[ids[i]].partKeys,"TRANSFER_BEFORE_PROPERTY_RESET_"+ids[i]);
        if(!resetAppliedPropertyStateForFigure(participant.figure,"transfer source item leaves figure"))return;
        current=transferAssertInventories(tx);participant=current[sourceKey];
        var updated={};
        for(i=0;i<ids.length;i++){
            var id=ids[i],after=measured(participant.inv[id].partKeys,true);
            var beforeStructure=clonePlain(tx.snapshots[sourceKey][id]),afterStructure=clonePlain(after),keys=Object.keys(beforeStructure);
            // Property resets may also drive evaluated channels/world transforms
            // on other source items. References, identities and materials may not change.
            for(var k=0;k<keys.length;k++){
                var a=beforeStructure[keys[k]],b=afterStructure[keys[k]];
                if(!b)throw problem("TRANSFER_PROPERTY_RESET_STRUCTURE",id);
                delete a.channels;delete a.world;delete a.controls;
                delete b.channels;delete b.world;delete b.controls;
            }
            must(closeNumbers(beforeStructure,afterStructure),"TRANSFER_PROPERTY_RESET_STRUCTURE",id+": references, identities and materials unchanged by property reset.");
            updated[id]=after;
        }
        // Replace only the forward-verification baseline. The initial rollback
        // measurements and poses remain immutable, including the original Scale.
        tx.snapshots[sourceKey]=updated;
        if(figurePoseAuditEnabled()){
            if(!tx.verificationPoses)tx.verificationPoses={};
            tx.verificationPoses[sourceKey]=poseRecord(participant.figure);
        }
        log("INFO","TRANSFER_PROPERTY_RESET_BASELINE",participant.figure.getLabel()+": forward checks use post-reset state; original rollback snapshots retained.");
    }
    function transferWatchParticipants(participants) {
        var keys=Object.keys(participants),out=[],seen={};
        for(var i=0;i<keys.length;i++){
            var part=participants[keys[i]],watched=watchKeys(part.inv,part.figure);
            for(var j=0;j<watched.length;j++)if(!own(seen,watched[j])){seen[watched[j]]=true;out.push(watched[j]);}
        }
        return out;
    }
    function transferTargetRecord(it, inf, original, target) {
        return withReadScope(function(){
            var rec=clonePlain(original);rec.ownerFigureID=figureIdentity(target,true);
            var rootParent="";
            for(var i=0;i<rec.parts.length;i++){
                var row=rec.parts[i],spec=null;
                for(var s=0;s<it.parts.length;s++)if(it.parts[s].id===row.partID)spec=it.parts[s];
                if(!spec)throw problem("TRANSFER_PART",it.name);
                for(var r=0;r<REF_FIELDS.length;r++){
                    var f=REF_FIELDS[r],to=resolvePortable(spec.refs[f],target,inf.parts);
                    row.refs[f]=to?uniqueNodeID(to,true):"";
                }
                if(row.nodeID===rec.rootID)rootParent=row.refs.parent;
            }
            for(var h=0;h<rec.hierarchy.length;h++)if(rec.hierarchy[h].nodeID===rec.rootID)rec.hierarchy[h].parentID=rootParent;
            return rec;
        },true);
    }
    function transferRecordRow(it, inf, fig) {
        var rec=durableRecord(it,inf,fig);
        return {itemID:it.id,ownerKey:key(fig),record:rec,facts:undressInventorySnapshot((function(){var x={};x[it.id]=inf;return x;})())[it.id],touched:false};
    }
    function transferRollbackInfo(row) {
        // Ownership may have been changed on only some parts when a metadata
        // write failed. Prove every original identity before restoring links;
        // never replace a missing source with another matching item.
        var it=app.db.items[row.itemID],rec=row.record,root=nodeByID(rec.rootID,"Transfer rollback root"),parts={},all=[root].concat(root.getNodeChildren(true));
        if(key(root)!==row.facts.rootKey||!closeNumbers(all.map(key).sort(),row.facts.allKeys))throw problem("TRANSFER_ROLLBACK_HIERARCHY",it.name);
        for(var h=0;h<rec.hierarchy.length;h++){
            var hr=rec.hierarchy[h],hn=nodeByID(hr.nodeID,"Transfer rollback hierarchy");
            if(hn.className()!==hr.className||(hr.nodeID!==rec.rootID&&!same(hn.getNodeParent(),nodeByID(hr.parentID,"Internal parent"))))
                throw problem("TRANSFER_ROLLBACK_HIERARCHY",it.name);
        }
        for(var p=0;p<rec.parts.length;p++){
            var rp=rec.parts[p],n=nodeByID(rp.nodeID,"Transfer rollback part"),d=dataObject(n);
            if(!d||d.LibraryID!==rec.libraryID||d.ItemID!==rec.itemID||d.VariantID!==rec.variantID||d.PartID!==rp.partID||d.InstanceID!==rec.instanceID||
                (d.OwnerFigureID!==rec.ownerFigureID&&d.OwnerFigureID!==ctx.transferTxn.ownerIDs[key(ctx.target)]))throw problem("TRANSFER_ROLLBACK_IDENTITY",it.name);
            parts[rp.partID]=n;
        }
        var peers=findData("InstanceID",rec.instanceID);
        if(peers.length!==rec.parts.length||peers.some(function(n){return row.facts.partKeys.indexOf(key(n))<0;}))throw problem("TRANSFER_ROLLBACK_DUPLICATE",it.name);
        return {root:root,rootID:rec.rootID,instanceID:rec.instanceID,parts:parts,partKeys:row.facts.partKeys.slice(0),allKeys:row.facts.allKeys.slice(0)};
    }
    function rollbackTransferAction() {
        var tx=ctx.transferTxn,errors=[],ids=Object.keys(tx.records),i;
        // Do not erase a Pending marker installed by somebody else while native
        // events ran. Leave evidence instead of claiming a complete rollback.
        for(i=0;i<tx.participantKeys.length;i++)try{
            var f=live(tx.participantKeys[i]);if(!f)throw problem("TRANSFER_FIGURE_MISSING",tx.participantKeys[i]);
            transferCheckPending(f);
        }catch(pe){errors.push(errorText(pe));}
        if(tx.geoTransfer){
            // Restore the graft first, then the shells, so their dependent
            // surfaces are available again before native material rollback.
            ids.sort(function(a,b){return a===tx.geoTransfer.graftItemID?1:(b===tx.geoTransfer.graftItemID?-1:0);});
        }
        for(i=ids.length-1;i>=0;i--){
            var row=tx.records[ids[i]];if(!row.touched)continue;
            try{
                var inf=withReadScope(function(){return transferRollbackInfo(row);},false);
                // Clear current follow links before reparenting to the old owner.
                for(var p=0;p<row.record.parts.length;p++)setFit(app.db.items[row.itemID],inf.parts[row.record.parts[p].partID],null);
                applyRecord(app.db.items[row.itemID],inf,row.record);
                if(tx.geoTransfer&&tx.geoTransfer.shellItemIDs.indexOf(row.itemID)>=0){
                    var savedShellNode=null;
                    for(var sh=0;sh<row.record.parts.length;sh++)if(row.record.parts[sh].nodeID===row.record.rootID){
                        savedShellNode=nodeByID(row.record.parts[sh].refs.shell,"Rollback native Shell Node");break;
                    }
                    if(!savedShellNode)throw problem("GEO_SHELL_ROLLBACK_TARGET","Original shell target missing.");
                    if(!same(inf.root.getTarget(),savedShellNode))geoRetargetTransferredShell(inf.root,inf.root.getTarget(),savedShellNode);
                }
                actualReferencesMatch(row.record,"TRANSFER_ROLLBACK_LINKS");
            }catch(re){errors.push(errorText(re));}
        }
        rollbackPropertyWrites(errors);
        rollbackPartStateWrites(errors);
        if(!errors.length)try{cleanupNewNodes();restoreMetadata();}catch(me){errors.push(errorText(me));}
        if(ctx.geoMaterialTxn)geoRollbackMaterialBackups(errors);
        if(!errors.length&&ctx.rollbackMeasurements)try{
            var ks=Object.keys(ctx.rollbackMeasurements);
            if(ks.length){observe(ks,"ROLLBACK",false);compareMeasured(ctx.rollbackMeasurements,ks,"TRANSFER_ROLLBACK_STATE");}
        }catch(se){errors.push(errorText(se));}
        if(!errors.length)try{
            for(i=0;i<tx.participantKeys.length;i++){
                var k=tx.participantKeys[i],fig=live(k),inv=transferInventory(fig,false);
                if(!closeNumbers(undressInventorySnapshot(inv),tx.before[k]))throw problem("TRANSFER_ROLLBACK_INVENTORY",fig.getLabel());
                if(figurePoseAuditEnabled()&&tx.poses[k]&&!closeNumbers(tx.poses[k],poseRecord(fig)))throw problem("TRANSFER_ROLLBACK_POSE",fig.getLabel());
            }
        }catch(ve){errors.push(errorText(ve));}
        if(errors.length){
            for(i=0;i<tx.participantKeys.length;i++)try{
                var node=live(tx.participantKeys[i]),existing=node?value(node,"Pending"):"";
                if(node&&(!existing||existing===tx.pendingText))updateData(node,{Pending:tx.pendingText||jsonText({action:"TransferRollbackIncomplete",operationID:ctx.id,libraryID:app.db.libraryID})});
            }catch(ignore){}
            ctx.diag.transfer.rollback={complete:false,errors:errors};
            log("FAIL","ROLLBACK_INCOMPLETE",errors.join("\n")+". Multi-owner recovery remains incomplete. Reopen the saved pre-operation scene; do not overwrite it.");return false;
        }
        ctx.diag.transfer.rollback={complete:true};
        log("PASS","ROLLBACK","Transferred instances and recipient items returned to their original owners/locations; own metadata restored. Best-effort recovery, not a native Undo guarantee.");return true;
    }
    function applySetWithTransfers(st, target, selections) {
        var timing=profileBegin("apply_with_transfers");
        try {
            var pf=transferPreflight(st,target,selections),watched=transferWatchParticipants(pf.participants);
            observe(watched,"APPLY_PRE",true);
            var again=transferPreflight(st,target,selections);
            if(again.signature!==pf.signature)throw problem("TRANSFER_SOURCE_CHANGED","A participating wardrobe changed during initial observation.");pf=again;
            var plan=pf.plan,pk=Object.keys(pf.participants).sort(),tk=key(target);
            // Ordinary external clothing may be transferred while local target
            // graft(s) go into Wardrobe: the same native shell backups and
            // pre-detach material snapshot path now protect this operation.
            // Incoming graft + one outgoing local worn graft is admitted only
            // if geoTransferPreflight confirms local Store and valid attachment.
            // Mixing incoming grafts with local graft Restore/Load remains blocked.
            var localGeoChanges=geoImpactedPlan(st,target,plan,pf.local.inventory);
            if(localGeoChanges.length&&geoShellsOnFigure(target,true).length&&
                !app.experimentalGeoShellRecovery)
                throw problem("GEO_SHELL_SAFETY","Enable GeoShell Material Recovery in Settings before removing this GeoGraft.");
            // Prepare a tightly scoped one-GeoGraft cross-figure experiment.
            // Unsupported mixtures fail BEFORE pending metadata or scene changes.
            var geoTransfer=geoTransferPreflight(st,target,pf);
            var tx={participantKeys:pk,ownerIDs:{},before:{},expected:{},records:{},marked:{},pendingText:"",poses:{},snapshots:{},targets:{}};
            ctx.transferTxn=tx;tx.geoTransfer=geoTransfer;ctx.diag.plan=clonePlain(plan);
            ctx.diag.transfer={policy:"explicit_same_type_sources_v050",selections:clonePlain(selections),participantKeys:pk.slice(0),
                originalInstancesPreserved:true,catalogWrites:0,manualPoseWrites:0,externalShellRigidRetarget:false,committed:false};
            ctx.rollbackMeasurements={};
            withMetadataBatch("transfer_baselines",function(){
                for(var k=0;k<pk.length;k++){
                    var f=pf.participants[pk[k]].figure,inv=pf.participants[pk[k]].inv,ids=Object.keys(inv);
                    tx.before[pk[k]]=undressInventorySnapshot(inv);tx.expected[pk[k]]=clonePlain(tx.before[pk[k]]);tx.snapshots[pk[k]]={};
                    if(figurePoseAuditEnabled())tx.poses[pk[k]]=poseRecord(f);
                    for(var i=0;i<ids.length;i++){
                        var m=measured(inv[ids[i]].partKeys,true);tx.snapshots[pk[k]][ids[i]]=m;
                        var mk=Object.keys(m);for(var x=0;x<mk.length;x++)ctx.rollbackMeasurements[mk[x]]=m[mk[x]];
                    }
                }
            },false);
            withMetadataBatch("transfer_recovery_preparation",function(){
                for(var i=0;i<pk.length;i++){
                    var fig=pf.participants[pk[i]].figure;
                    if(!own(ctx.metaBefore,pk[i]))ctx.metaBefore[pk[i]]=dataObject(fig);
                    tx.ownerIDs[pk[i]]=figureIdentity(fig,true);
                }
                var affected=plan.store.concat(plan.restore);
                for(var a=0;a<affected.length;a++){
                    var id=affected[a];tx.records[id]=transferRecordRow(app.db.items[id],pf.local.inventory[id],target);ctx.rollbackRecords[id]=tx.records[id].record;
                }
                for(var s=0;s<pf.sources.length;s++){
                    var src=pf.sources[s],it=app.db.items[src.itemID],source=pf.participants[src.sourceKey].figure;
                    tx.records[it.id]=transferRecordRow(it,src.inf,source);ctx.rollbackRecords[it.id]=tx.records[it.id].record;
                    for(var p=0;p<src.inf.partKeys.length;p++){
                        var keyPart=src.inf.partKeys[p];if(!own(ctx.metaBefore,keyPart))ctx.metaBefore[keyPart]=dataObject(live(keyPart));
                    }
                    tx.targets[it.id]=transferTargetRecord(it,src.inf,tx.records[it.id].record,target);
                }
                ctx.pending={schemaVersion:1,operationID:ctx.id,libraryID:app.db.libraryID,action:"ApplySetWithTransfers",setID:st.id,
                    ownerFigureID:tx.ownerIDs[tk],participants:clonePlain(tx.ownerIDs),beforeRecords:clonePlain(ctx.rollbackRecords),
                    beforeMetadata:clonePlain(ctx.metaBefore),selectedSources:clonePlain(selections)};
                tx.pendingText=jsonText(ctx.pending);
            },true);
            log("INFO","TRANSFER_PLAN","set="+st.name+" | transfer="+describeIDs(plan.transfer)+" | load="+describeIDs(plan.load)+" | store="+describeIDs(plan.store)+" | restore="+describeIDs(plan.restore)+" | sourceOwners="+(pk.length-1));
            // Protect locally changing graft topology even if all transferred
            // items are ordinary garments. Capture source shell materials before
            // imported clothes or other actions can alter their surfaces.
            var existingWardrobePointer=false,localIDs=Object.keys(pf.local.inventory);
            for(var lwp=0;lwp<localIDs.length;lwp++){
                var li=pf.local.inventory[localIDs[lwp]];
                if(li.where==="active"&&value(li.root,"GeoWardrobeSnapshot"))existingWardrobePointer=true;
                if(plan.restore.indexOf(localIDs[lwp])>=0&&value(li.root,"GeoWardrobeSnapshot"))existingWardrobePointer=true;
            }
            if((localGeoChanges.length||existingWardrobePointer)&&geoShellsOnFigure(target,true).length)
                geoPrepareShellBackups(target,true);
            geoWardrobePrepareStores(target,plan,pf.local.inventory);
            if(geoTransfer&&geoTransfer.needsRecovery){
                // Both figures must be protected BEFORE either source loses
                // its graft or the target gains new shell surfaces.
                geoPrepareShellBackups(geoTransfer.source,true);
                geoPrepareShellBackups(target,true);
                geoTransferCaptureSourceSurfaceAllowances(tx);
                log("WARN","GEO_TRANSFER_SHELL_TOPOLOGY",
                    "Dual-owner native backups complete; source="+geoTransfer.source.getLabel()+
                    " | target="+target.getLabel()+" | GeoGraft="+app.db.items[geoTransfer.graftItemID].name+
                    " | use a saved scene copy.");
            }
            for(var mark=0;mark<pk.length;mark++){
                var figMark=live(pk[mark]);assertNoPending(figMark);txData(figMark,{Pending:tx.pendingText});tx.marked[pk[mark]]=true;
            }
            // All disk imports succeed before ANY existing wardrobe is changed.
            for(var l=0;l<plan.load.length;l++){
                var loadID=plan.load[l],loaded=loadItem(app.db.items[loadID],target),one={};one[loadID]=loaded;
                tx.expected[tk][loadID]=undressInventorySnapshot(one)[loadID];
            }
            var current=transferAssertInventories(tx);
            if(plan.load.length){
                observe(transferWatchParticipants(current),"INCOMING_READY",false);
                current=transferAssertInventories(tx);
                for(var op=0;op<pk.length;op++){
                    var initialIDs=Object.keys(tx.snapshots[pk[op]]);
                    for(var oi=0;oi<initialIDs.length;oi++)compareMeasured(tx.snapshots[pk[op]][initialIDs[oi]],current[pk[op]].inv[initialIDs[oi]].partKeys,"TRANSFER_PRELOAD_UNCHANGED_"+initialIDs[oi]);
                }
            }
            // A source figure stops wearing its complete set when an item is transferred away.
            // Reset its active set properties before moving the instance; rollback restores both
            // native property values and scene metadata if the transfer later fails.
            var sourcePropertyResetSeen={};
            for(var ps=0;ps<pf.sources.length;ps++){
                var sourceKey=pf.sources[ps].sourceKey;if(sourceKey===tk||own(sourcePropertyResetSeen,sourceKey))continue;
                sourcePropertyResetSeen[sourceKey]=true;transferResetSourceProperties(tx,sourceKey,current);
            }
            current=transferAssertInventories(tx);
            // Target metadata/IDs are now prepared. Native mutation boundaries
            // re-read both owners' inventories; no read cache spans a setter.
            var preRestore={},restored={},transferred={};
            var transferSteps=pf.sources.slice(0);
            if(geoTransfer)transferSteps.sort(function(a,b){return a.itemID===geoTransfer.graftItemID?-1:(b.itemID===geoTransfer.graftItemID?1:0);});
            withViewportRedrawLock("STORE_RESTORE_WITH_TRANSFER",function(){
                for(var s=0;s<plan.store.length;s++){
                    var sid=plan.store[s];current=transferAssertInventories(tx);tx.records[sid].touched=true;
                    storeItem(app.db.items[sid],current[tk].inv[sid],target);tx.expected[tk][sid].where="stored";
                }
                for(var r=0;r<plan.restore.length;r++){
                    var rid=plan.restore[r];current=transferAssertInventories(tx);preRestore[rid]=measured(current[tk].inv[rid].partKeys,true);tx.records[rid].touched=true;
                    restored[rid]=restoreItem(app.db.items[rid],current[tk].inv[rid],target);tx.expected[tk][rid].where="active";
                }
                for(var t=0;t<transferSteps.length;t++){
                    var src=transferSteps[t],id=src.itemID,it=app.db.items[id];current=transferAssertInventories(tx);
                    var inf=current[src.sourceKey].inv[id];
                    if(!inf)throw problem("TRANSFER_SOURCE_CHANGED",it.name);
                    compareMeasured(tx.snapshots[src.sourceKey][id],inf.partKeys,"TRANSFER_SOURCE_UNCHANGED_"+id);
                    transferCompatibility(it,inf,current[src.sourceKey].figure,target,!!(geoTransfer&&geoTransfer.shellItemIDs.indexOf(id)>=0));
                    tx.records[id].touched=true;
                    for(var p=0;p<it.parts.length;p++)setFit(it,inf.parts[it.parts[p].id],null);
                    // Owner changes are durable, but logical/node/instance IDs
                    // and actual part objects remain exactly the same.
                    for(var q=0;q<it.parts.length;q++)txData(inf.parts[it.parts[q].id],{OwnerFigureID:tx.ownerIDs[tk]});
                    applyRecord(it,inf,tx.targets[id]);
                    if(geoTransfer&&geoTransfer.shellItemIDs.indexOf(id)>=0)
                        geoRetargetTransferredShell(inf.root,current[src.sourceKey].figure,target);
                    var fact=clonePlain(tx.expected[src.sourceKey][id]);delete tx.expected[src.sourceKey][id];fact.where="active";tx.expected[tk][id]=fact;
                    transferred[id]=src.sourceKey;
                    log("PASS","TRANSFERRED_ITEM",it.name+" | from="+src.descriptor.ownerLabel+
                        " | sourceState="+src.descriptor.where+" | sourceLocation="+JSON.stringify(transferSourceLocationText(src.descriptor))+
                        " | to="+target.getLabel()+" | instance="+inf.instanceID+" | node="+inf.rootID+" | same live instance; no import");
                }
            });
            current=transferAssertInventories(tx);observe(transferWatchParticipants(current),"APPLY_AFTER",false);current=transferAssertInventories(tx);
            geoWardrobeRestoreActive(target,geoWardrobeRestoreCandidates(st,plan,target));
            if(geoTransfer){
                // Before allowing Set styling/commit, assert that a recipient's
                // displaced graft really is detached and its just-captured
                // material snapshot is still linked to the same instance.
                geoTransferVerifyLocalGraftStores(geoTransfer,target);
                // Check attachment even when neither figure owns a GeoShell;
                // correctness of graft transfer cannot depend on shell count.
                geoTransferVerifyGraftAttachment(geoTransfer,target);
                if(geoTransfer.needsRecovery){
                    geoRestoreSavedSet(st,target);
                    geoTransferVerifySourceShellMaterials(tx);
                }
            }
            withMetadataBatch("transfer_final_verification",function(){
                for(var i=0;i<plan.keep.length;i++){
                    var keep=plan.keep[i];compareMeasured(tx.snapshots[tk][keep],current[tk].inv[keep].partKeys,"SHARED_UNCHANGED_"+keep);
                    must(!ctx.operations.some(function(o){return o.itemID===keep;}),"SHARED_NOT_TOUCHED",app.db.items[keep].name);
                }
                for(var r=0;r<plan.restore.length;r++){
                    var ri=plan.restore[r];actualReferencesMatch(restored[ri],"RESTORED_DURABLE_LINKS");compareMeasured(preRestore[ri],current[tk].inv[ri].partKeys,"RESTORED_LOCAL_STATE_"+ri,"restore");
                }
                for(var t=0;t<plan.transfer.length;t++){
                    var ti=plan.transfer[t];actualReferencesMatch(tx.targets[ti],"TRANSFER_TARGET_LINKS");
                    compareMeasured(tx.snapshots[transferred[ti]][ti],current[tk].inv[ti].partKeys,"TRANSFER_LOCAL_STATE_"+ti,"restore");
                }
                for(var o=0;o<pk.length;o++){
                    var owner=pk[o],left=Object.keys(current[owner].inv);
                    for(var j=0;j<left.length;j++){
                        var item=left[j];
                        if(owner===tk) {if(!own(tx.before[owner],item)||tx.before[owner][item].where!=="stored"||plan.restore.indexOf(item)>=0)continue;}
                        compareMeasured(tx.snapshots[owner][item],current[owner].inv[item].partKeys,"TRANSFER_UNAFFECTED_"+owner+"_"+item);
                    }
                    if(figurePoseAuditEnabled())must(closeNumbers(tx.verificationPoses&&own(tx.verificationPoses,owner)?tx.verificationPoses[owner]:tx.poses[owner],poseRecord(current[owner].figure)),"TRANSFER_FIGURE_POSE","Participating figure pose matched after intentional property resets: "+current[owner].figure.getLabel());
                }
                verifyDesired(st,target);
            },false);
            applySetPropertyOverrides(st,target);
            applySavedSetMaterials(st,target);
            applySavedSetPartStates(st,target);
            // Existing destination materials not addressed by the incoming
            // Set (e.g. Breast Utilities 2 / Body) must remain unchanged.
            // Failure triggers the verified dual-owner rollback, not commit.
            geoVerifyUnexportableBackupSurfaces("TRANSFER_BEFORE_COMMIT");
            var clear=plan.restore.concat(plan.transfer);for(var c=0;c<clear.length;c++)unsetData(current[tk].inv[clear[c]].root,"Recovery");
            for(var end=0;end<pk.length;end++){transferCheckPending(current[pk[end]].figure);unsetData(current[pk[end]].figure,"Pending");delete tx.marked[pk[end]];}
            ctx.diag.transfer.committed=true;ctx.diag.transfer.transferred=plan.transfer.length;ctx.diag.transfer.loaded=ctx.loadCalls;
            log("PASS","TRANSFERS_COMMITTED",plan.transfer.length+" same-instance transfers committed; source/target inventories and remaining items checked; catalog unchanged.");
            log("PASS","SET_APPLIED",st.name+" | imports="+ctx.loadCalls+" | stored="+plan.store.length+" | restored="+plan.restore.length+" | transferred="+plan.transfer.length);
            ctx.outcome=st.name+" applied to "+target.getLabel()+". Transferred "+plan.transfer.length+", loaded "+ctx.loadCalls+", restored "+plan.restore.length+", stored "+plan.store.length+". Source figures no longer own transferred items. Save the scene to retain these changes.";
        } finally {profileEnd(timing);}
    }
    function applyWithSourceChoices(st, fig, choice, effective) {
        var checked=withReadScope(function(){return validateOutfitSourceChoices(st,fig,choice);},false);
        if(choice&&!choice.legacy)ctx.diag.sourceChoices=clonePlain(choice);
        if(!effective)effective=effectiveSetForTransition(st,fig,"follow_rules");
        ctx.transitionRetainedIDs=effective.retained;
        ctx.diag.transition={sourceSet:st.id,mode:"follow_rules",originalMembers:st.items.slice(0),
            effectiveMembers:effective.set.items.slice(0),retainedIDs:Object.keys(effective.retained)};
        if(checked&&checked.transfers.length)applySetWithTransfers(effective.set,fig,checked.transfers);
        else applySet(effective.set,fig);
    }

    function applySet(st, fig) {
        var token = profileBegin("apply_set");
        try { return applySetImpl(st, fig); }
        finally { profileEnd(token); }
    }
    function applySetImpl(st, fig) {
        var pf = preflight(st, fig), plan = pf.plan;
        // Only outfit transitions that actually move garments need durable
        // recovery parent IDs. A plain status check/no-op never edits storage.
        if (plan.store.length || plan.restore.length) {
            if (repairEmptyStorageCopiesForTransition(fig)) {
                pf = preflight(st, fig); plan = pf.plan;
            }
        }
        if (ctx.action === "undress_all") {
            if (!ctx.diag.undressAll || st.id !== "" || st.items.length)
                throw problem("UNDRESS_TARGET", "Invalid transient empty wardrobe target.");
            ctx.diag.undressAll.before = undressInventorySnapshot(pf.inventory);
        }
        if (plan.load.length) logWardrobeCoverage(fig, pf.inventory, "BEFORE_IMPORT");
        geoCheckTransition(st,fig,plan,pf.inventory);
        if (tryOperationalNoop(st, fig, pf)) return;
        observe(watchKeys(pf.inventory, fig), "APPLY_PRE", true);
        var again = preflight(st, fig);
        if (again.plan.signature !== plan.signature) throw problem("INVENTORY_CHANGED", "The inventory changed during observation; no stale plan executed.");
        pf = again; plan = pf.plan; var inv = pf.inventory, ids = Object.keys(inv), snapshots = {}, i;
        geoCheckTransition(st,fig,plan,inv);
        var wardrobePending=false,wardrobeIDs=Object.keys(inv);
        for(var wp=0;wp<wardrobeIDs.length;wp++)if(inv[wardrobeIDs[wp]].where==="active"&&
            value(inv[wardrobeIDs[wp]].root,"GeoWardrobeSnapshot"))wardrobePending=true;
        if(app.experimentalGeoShellRecovery&&
           (geoImpactedPlan(st,fig,plan,inv).length||(st.geoShellSnapshots&&st.geoShellSnapshots.length)||wardrobePending))
            geoPrepareShellBackups(fig,true);
        geoWardrobePrepareStores(fig,plan,inv);
        withMetadataBatch("baseline_item_snapshots", function () {
            for (i = 0; i < ids.length; i++) snapshots[ids[i]] = measured(inv[ids[i]].partKeys, true);
        }, false);
        var pose = figurePoseAuditEnabled() ? poseRecord(fig) : null, opsStart = ctx.operations.length;
        ctx.rollbackPose = pose; // null in Operational: no hidden rollback pose read.
        ctx.diag.plan = clonePlain(plan);
        log("INFO", "PLAN", "set=" + st.name + " | setID=" + st.id + " | members=" + describeIDs(st.items) + " | keep=" + describeIDs(plan.keep) + " | store=" + describeIDs(plan.store) + " | restore=" + describeIDs(plan.restore) + " | load=" + describeIDs(plan.load) + " | noop=" + plan.noop);
        if (plan.noop) {
            observe(watchKeys(inv, fig), "NOOP", false);
            for (i = 0; i < ids.length; i++) compareMeasured(snapshots[ids[i]], inv[ids[i]].partKeys, "NOOP_" + app.db.items[ids[i]].name);
            verifyDesired(st, fig);
            must(ctx.loadCalls === 0 && ctx.operations.length === opsStart && !Object.keys(ctx.metaBefore).length, "NOOP", "No imports, scene metadata writes, parenting or Fit To operations before property overrides.");
            applySetPropertyOverrides(st,fig);
            geoWardrobeRestoreActive(fig,geoWardrobeRestoreCandidates(st,plan,fig));
            geoRestoreSavedSet(st,fig);
            applySavedSetMaterials(st,fig);
            geoRestorePartialGraftMaterials(st,fig);
            applySavedSetPartStates(st,fig);
            ctx.outcome = "Already dressed as " + st.name + ". Property overrides were synchronized."; return;
        }
        // Capture fixed *current-action* measurements for a best-effort abort.
        ctx.rollbackMeasurements = {};
        for (i = 0; i < ids.length; i++) {
            var sk = Object.keys(snapshots[ids[i]]);
            for (var q = 0; q < sk.length; q++) ctx.rollbackMeasurements[sk[q]] = snapshots[ids[i]][sk[q]];
        }
        // These records include the actual pre-action storage parent for items
        // already stored. Their normal Recovery field still targets the figure.
        var affected = plan.store.concat(plan.restore);
        withMetadataBatch("rollback_record_preparation", function () {
            figureIdentity(fig, true);
            for (i = 0; i < affected.length; i++) ctx.rollbackRecords[affected[i]] = durableRecord(app.db.items[affected[i]], inv[affected[i]], fig);
            ctx.pending = {schemaVersion:1, operationID:ctx.id, libraryID:app.db.libraryID, action:ctx.action === "undress_all" ? "UndressAllRegistered" : "ApplySet", setID:st.id,
                ownerFigureID:figureIdentity(fig,false), beforeRecords:ctx.rollbackRecords};
        }, true); // own-ID writes retain the existing COMPLETE invalidation

        txData(fig, {Pending:jsonText(ctx.pending)});
        // Validate/load ALL missing incoming garments BEFORE removing old ones.
        for (i = 0; i < plan.load.length; i++) loadItem(app.db.items[plan.load[i]], fig);
        if (plan.load.length) {
            var ready = inventory(fig, app.db); observe(watchKeys(ready, fig), "INCOMING_READY", false);
            withMetadataBatch("preload_comparisons", function () {
                for (i = 0; i < ids.length; i++) compareMeasured(snapshots[ids[i]], inv[ids[i]].partKeys, "PRELOAD_UNCHANGED_" + app.db.items[ids[i]].name);
                if (figurePoseAuditEnabled()) must(closeNumbers(pose, poseRecord(fig)), "PRELOAD_POSE", "The selected figure pose remains unchanged.");
            }, false);
        }
        var restored = {}, preRestore = {};
        withMetadataBatch("incoming_link_validation", function () {
            inv = inventory(fig, app.db);
            for (i = 0; i < plan.restore.length; i++) validateRecovery(app.db.items[plan.restore[i]], inv[plan.restore[i]], fig, null, true);
            for (i = 0; i < plan.store.length; i++) nativeLinkCheck(app.db.items[plan.store[i]], inv[plan.store[i]], fig);
            for (i = 0; i < plan.restore.length; i++) preRestore[plan.restore[i]] = measured(inv[plan.restore[i]].partKeys, true);
        }, false);
        if(plan.store.length || plan.restore.length) withViewportRedrawLock("STORE_RESTORE",function(){
            for (i = 0; i < plan.store.length; i++) storeItem(app.db.items[plan.store[i]], inv[plan.store[i]], fig);
            for (i = 0; i < plan.restore.length; i++) restored[plan.restore[i]] = restoreItem(app.db.items[plan.restore[i]], inv[plan.restore[i]], fig);
        });
        var afterInv = inventory(fig, app.db); observe(watchKeys(afterInv, fig), "APPLY_AFTER", false);
        geoWardrobeRestoreActive(fig,geoWardrobeRestoreCandidates(st,plan,fig));
        geoRestoreSavedSet(st,fig);
        withMetadataBatch("final_item_verification", function () {
            for (i = 0; i < plan.keep.length; i++) {
                var keep = plan.keep[i]; compareMeasured(snapshots[keep], afterInv[keep].partKeys, "SHARED_UNCHANGED_" + app.db.items[keep].name);
                must(!ctx.operations.slice(opsStart).some(function(op){return op.itemID===keep;}), "SHARED_NOT_TOUCHED", app.db.items[keep].name + ": no mutation targeted this item.");
            }
            for (i = 0; i < plan.restore.length; i++) {
                var id = plan.restore[i]; actualReferencesMatch(restored[id], "RESTORED_DURABLE_LINKS");
                compareMeasured(preRestore[id], afterInv[id].partKeys, "RESTORED_LOCAL_STATE_" + app.db.items[id].name, "restore");
            }
            verifyDesired(st, fig);
            if (figurePoseAuditEnabled()) must(closeNumbers(pose, poseRecord(fig)), "TARGET_POSE", "No figure pose/root scalar change during this action.");
        }, false);
        applySetPropertyOverrides(st,fig);
        // Manual bulk removals and explicit per-card Take Off bypass outfit
        // transition policies. Reset tracked Apply values while this action's
        // Pending marker still protects its rollback; never fake a catalog Set.
        if(ctx.action==="remove_set" ||
           (ctx.action==="bulk_move"&&ctx.diag.bulkMove&&ctx.diag.bulkMove.storeIDs.length)){
            var resetReason=ctx.action==="remove_set"?"Take Off Set": "Wardrobe Move Selected";
            var resetCount=resetAppliedPropertyStateForFigure(fig,resetReason);
            if(ctx.action==="remove_set")ctx.diag.removeSet.propertyResets=resetCount;
            else ctx.diag.bulkMove.propertyResets=resetCount;
        }
        for (i = 0; i < plan.restore.length; i++) unsetData(afterInv[plan.restore[i]].root, "Recovery"); // Native state property restores it on Undo.
        applySavedSetMaterials(st,fig);
        geoRestorePartialGraftMaterials(st,fig);
        applySavedSetPartStates(st,fig);
        geoVerifyUnexportableBackupSurfaces("APPLY_BEFORE_COMMIT");
        unsetData(fig, "Pending");
        log("PASS", "SET_APPLIED", st.name + " | imports=" + ctx.loadCalls + " | stored=" + plan.store.length + " | restored=" + plan.restore.length);
        ctx.outcome = st.name + " applied. Loaded " + ctx.loadCalls + ", restored " + plan.restore.length + ", stored " + plan.store.length + ". Save the scene to retain this wardrobe state.";
    }
    function importIcon(path) {
        if (!path) return "";
        if (!readable(path)) throw problem("ICON_READ", path);
        var ext = /\.([a-zA-Z0-9]+)$/.exec(path), allowed = ["png","jpg","jpeg","bmp"];
        if (!ext || allowed.indexOf(ext[1].toLowerCase()) < 0) throw problem("ICON_FORMAT", "Use PNG, JPG or BMP.");
        var pix = new Pixmap(path); if (!pix || pix.isNull()) throw problem("ICON_IMAGE", "Cannot read this image.");
        // Reuse an image already owned by this library (including FigureIcons).
        // Canonical paths prevent sibling-prefix and junction escapes.
        var source=materialCanonicalMapPath(path),
            root=canonicalDirectory(app.libraryPath,false).replace(/\\/g,"/").replace(/\/$/,"")+"/";
        if(source.resolved){
            var sourcePath=source.path,insensitive=/^[A-Za-z]:/.test(root),
                left=insensitive?sourcePath.toLowerCase():sourcePath,
                right=insensitive?root.toLowerCase():root;
            if(left.indexOf(right)===0){
                var existing=sourcePath.slice(root.length);
                safeRelative(existing);return existing;
            }
        }
        var rel = "Icons/" + unique("icon") + "." + ext[1].toLowerCase(), f = new DzFile(path);
        try { if (!f.copy(inLibrary(rel))) throw problem("ICON_COPY", path); }
        finally { f.deleteLater(); }
        if (!readable(inLibrary(rel))) throw problem("ICON_VERIFY", rel); return rel;
    }
    function normalizeEditorPropertyOverrides(list,fig,db,memberIDs,nodeItemMap) {
        if(!Array.isArray(list))return [];
        var out=[],seen={};
        for(var i=0;i<list.length;i++){
            var r=list[i];if(!r||typeof r!=="object")throw problem("PROPERTY_EDITOR","Invalid property override.");
            var rec={targetKind:String(r.targetKind||""),propertyName:String(r.propertyName||""),propertyLabel:String(r.propertyLabel||r.propertyName||""),
                applyValue:Number(r.applyValue),resetValue:Number(r.resetValue)};
            // Keep the exact native picker locator through Set Editor -> Save Set.
            // Dropping these fields made v0.7.4 enumerate all similarly-named
            // morph/provider properties at save time (PROPERTY_AMBIGUOUS).
            // Do not synthesize locators for legacy entries: their original
            // first-party resolution policy remains unchanged.
            if(r.propertyNodePath!==undefined)rec.propertyNodePath=clonePlain(r.propertyNodePath);
            if(r.propertyGroupPath!==undefined)rec.propertyGroupPath=r.propertyGroupPath;
            if(r.propertyOwnerName!==undefined)rec.propertyOwnerName=r.propertyOwnerName;
            propertyLocatorFields(rec);
            if((rec.targetKind!=="figure"&&rec.targetKind!=="item")||!rec.propertyName||!isFinite(rec.applyValue)||!isFinite(rec.resetValue))
                throw problem("PROPERTY_EDITOR","Invalid property target or Apply/Reset value.");
            if(rec.targetKind==="item"){
                var itemID=String(r.itemID||"");
                if(!itemID&&r.nodeKey&&own(nodeItemMap,String(r.nodeKey)))itemID=nodeItemMap[String(r.nodeKey)];
                if(!itemID||!own(db.items,itemID)||memberIDs.indexOf(itemID)<0)throw problem("PROPERTY_ITEM_TARGET","A property target item is not part of this set.");
                var it=db.items[itemID],partID=String(r.partID||it.parts[0].id),found=false;
                for(var p=0;p<it.parts.length;p++)if(it.parts[p].id===partID){found=true;break;}
                if(!found)throw problem("PROPERTY_ITEM_PART","A property target part is unavailable.");
                rec.itemID=itemID;rec.partID=partID;
            }
            var targetNode=rec.targetKind==="figure"?fig:(r.nodeKey?live(String(r.nodeKey)):null);
            if(rec.targetKind==="item" && rec.itemID){
                // A Set editor row may still point at the item root while the
                // explicitly chosen override belongs to a child PartID.
                try{var currentItems=inventory(fig,db),matched=currentItems[rec.itemID];
                    if(matched&&matched.parts&&matched.parts[rec.partID])targetNode=matched.parts[rec.partID];}
                catch(ignoreEditorNativeTarget){}
            }
            if(targetNode)try{
                // This check is advisory for unavailable saved controls: keep
                // their locators so a future product/morph load can restore them.
                var nativeProp=propertyHandleForOverride(targetNode,rec),nativeValue=Number(nativeProp.getValue());
                if(!isFinite(nativeValue))throw problem("PROPERTY_VALUE","Property is not currently readable: "+rec.propertyLabel);
            }catch(nativeError){if(!unavailableOverrideError(nativeError))throw nativeError;}
            var k=propertyOverrideKey(rec);if(own(seen,k))throw problem("PROPERTY_DUPLICATE","The same target property is listed more than once.");seen[k]=true;out.push(rec);
        }
        return out;
    }
    // The target may need to take off its ALREADY-WORN GeoGraft while an
    // unrelated incoming GeoGraft is transferred from another figure. All
    // native shell backups and wardrobe capture happen before the first
    // setter. Do not reinterpret a local Restore/Load as equivalent to Store:
    // it would introduce another changing graft topology without the tested
    // dual-owner restore ordering and source ownership proof.
    function geoTransferLocalStoreGrafts(st,target,plan,inv){
        var changing=geoImpactedPlan(st,target,plan,inv),out=[];
        for(var i=0;i<changing.length;i++){
            var id=changing[i],item=app.db.items[id],info=inv[id];
            if(plan.store.indexOf(id)<0)
                throw problem("GEO_TRANSFER_LOCAL_TOPOLOGY",
                    "Incoming GeoGraft transfer may only Store a local attached GeoGraft, not Restore/Load one: "+
                    (item?item.name:id)+". Perform that other transition separately.");
            if(!info||info.where!=="active"||!info.root||!info.root.inherits("DzFigure")||
               !geoTransferIsAttached(target,info.root))
                throw problem("GEO_TRANSFER_LOCAL_GRAFT_NOT_ATTACHED",
                    "Recipient's outgoing GeoGraft must be worn and natively attached before capturing its shell materials: "+
                    (item?item.name:id));
            out.push(id);
        }
        if(out.length>1)throw problem("GEO_TRANSFER_LOCAL_TOPOLOGY",
            "Moving more than one locally attached GeoGraft into Wardrobe during an external GeoGraft transfer " +
            "is not yet supported; perform the local wardrobe transition first.");
        return out;
    }
    function geoTransferVerifyLocalGraftStores(info,target){
        var local=info&&info.locallyStoredGraftItemIDs||[];
        if(!local.length)return;
        var inv=transferInventory(target,true);
        for(var i=0;i<local.length;i++){
            var id=local[i],item=app.db.items[id],row=inv[id],draft=ctx.geoWardrobeTxn&&ctx.geoWardrobeTxn.drafts[id];
            if(!row||row.where!=="stored"||!row.root||geoTransferIsAttached(target,row.root))
                throw problem("GEO_TRANSFER_LOCAL_STORE_STATE",
                    "Recipient GeoGraft did not end detached in its own Wardrobe: "+(item?item.name:id));
            if(!draft||value(row.root,"GeoWardrobeSnapshot")!==draft)
                throw problem("GEO_TRANSFER_LOCAL_STORE_SNAPSHOT",
                    "Recipient GeoGraft lost its original pending material snapshot pointer: "+(item?item.name:id));
            var pointer=geoWardrobePointer(row.root),doc=geoWardrobeRead(item,row,pointer);
            if(!doc)throw problem("GEO_TRANSFER_LOCAL_STORE_SNAPSHOT",(item?item.name:id));
            log("PASS","GEO_TRANSFER_TARGET_STORED_GRAFT",item.name+
                " | figure="+target.getLabel()+" | storedDetached=true | snapshotGroups="+doc.shells.length+
                " | manifest="+pointer.path+" | snapshotPointerIntact=true");
        }
    }
    // GeoGraft transfer: exactly one registered graft and optional
    // registered GeoShells from the SAME source owner. Graft may be worn and
    // natively attached, OR stored with validated Recovery and detached.
    // Shells may likewise be worn or stored, but must still reference source.
    // All choices are explicit: never auto-adopt or create new shells.
    function geoTransferPreflight(st,target,pf){
        var plan=pf.plan,sources=pf.sources,grafts=[],shells=[],owners={};
        for(var i=0;i<sources.length;i++){
            var src=sources[i],owner=pf.participants[src.sourceKey].figure;
            owners[src.sourceKey]=true;
            if(geoIsGraft(owner,src.itemID,src.inf,st))grafts.push({row:src,source:owner});
            else if(src.inf.root&&src.inf.root.inherits("DzGeometryShellNode"))shells.push(src);
        }
        if(!grafts.length)return null;
        if(sources.length!==grafts.length+shells.length)
            throw problem("GEO_TRANSFER_SCOPE","A GeoGraft transfer cannot include unrelated ordinary items.");
        // Unlike Restore/Load, Store has a well-defined, pre-mutation
        // Wardrobe material snapshot and rollback record. Allow that narrow
        // case so an incoming Nipples graft can replace a worn New Gen graft.
        var locallyStoredGraftItemIDs=geoTransferLocalStoreGrafts(st,target,plan,pf.local.inventory);
        if(grafts.length!==1||Object.keys(owners).length!==1||Object.keys(pf.participants).length!==2)
            throw problem("GEO_TRANSFER_SCOPE","Use one registered GeoGraft and optional GeoShells from the same source figure.");
        var one=grafts[0],inf=one.row.inf,source=one.source,root=inf.root,
            wasAttached=geoTransferIsAttached(source,root),wasStored=inf.where==="stored";
        log("INFO","GEO_TRANSFER_SOURCE_STATE",app.db.items[one.row.itemID].name+
            " | figure="+source.getLabel()+" | wardrobeLocation="+inf.where+
            " | nativeAttachedToSource="+wasAttached+
            " | sourceNativeGraftCount="+(typeof source.getNumGraftFigures==="function"?String(source.getNumGraftFigures()):"unavailable"));
        if(inf.where==="active"&&!wasAttached)
            throw problem("GEO_TRANSFER_NOT_ATTACHED","Source GeoGraft is marked active but DAZ does not report it as attached to "+
                source.getLabel()+". Verify Fit To and graft attachment on the source; no changes made.");
        if(wasStored&&wasAttached)
            throw problem("GEO_TRANSFER_STORAGE_CONFLICT","Source GeoGraft is stored in Wardrobe yet remains natively attached to "+
                source.getLabel()+". Refusing to guess its actual topology.");
        if(!wasStored&&inf.where!=="active")
            throw problem("GEO_TRANSFER_SOURCE_LOCATION","Source GeoGraft location is neither active nor stored.");
        // Stored sources were validated against exact Recovery links by
        // transferInventory. Do not put them on their source figure merely to
        // create another snapshot: that would mutate source topology first.
        var shellIDs=[],shellKeys={},graftID=one.row.itemID;
        for(var j=0;j<shells.length;j++){
            var row=shells[j],node=row.inf.root,verified=false;
            if(row.sourceKey!==one.row.sourceKey||
                (row.inf.where!=="active"&&row.inf.where!=="stored")||!same(node.getTarget(),source))
                throw problem("GEO_TRANSFER_SHELL_SCOPE","A transferred GeoShell must be a registered active/stored item whose native Shell Node still targets the source figure.");
            for(var r=0;r<(st.geoShellSnapshots||[]).length;r++){
                var rec=st.geoShellSnapshots[r];
                if(rec.graftItemID===graftID&&rec.shellItemID===row.itemID&&rec.mode==="registered_full")verified=true;
            }
            if(!verified||!geoShellTransferEligible(st,app.db.items[row.itemID],source))
                throw problem("GEO_TRANSFER_SHELL_SCOPE","This GeoShell has no saved full material baseline tied to the GeoGraft.");
            shellIDs.push(row.itemID);shellKeys[key(node)]=true;
        }
        // Only graft + its recorded registered shells. No silently imported
        // shell from an unrelated owner and no ordinary transfer mixed in.
        if(sources.length!==1+shellIDs.length)
            throw problem("GEO_TRANSFER_SCOPE","Move the GeoGraft and its registered GeoShells only.");
        for(j=0;j<plan.load.length;j++){
            var it=app.db.items[plan.load[j]];
            if(it&&it.parts&&it.parts[0]&&it.parts[0].className==="DzGeometryShellNode")
                throw problem("GEO_TRANSFER_SHELL_LOAD","Use explicit Transfer for every missing registered GeoShell; native load is excluded in this test.");
        }
        // The recipient may own a registered GeoShell in its Wardrobe Storage.
        // It is already identified and validated by transferPreflight() and
        // belongs to plan.restore, not plan.load or the external transfer list.
        // applySetWithTransfers() restores it before moving the GeoGraft.
        // Do not demand a redundant transfer or silently create a new shell.
        var restoredLocalShellIDs=[];
        for(j=0;j<st.items.length;j++){
            var itID=st.items[j],it=app.db.items[itID];
            if(!it||!it.parts||!it.parts[0]||it.parts[0].className!=="DzGeometryShellNode")continue;
            if(shellIDs.indexOf(itID)>=0)continue;
            var localShell=pf.local.inventory[itID];
            if(localShell&&localShell.where==="active")continue;
            if(localShell&&localShell.where==="stored"&&plan.restore.indexOf(itID)>=0){
                if(!localShell.root||!localShell.root.inherits("DzGeometryShellNode")||
                    !same(localShell.root.getTarget(),target))
                    throw problem("GEO_TRANSFER_LOCAL_SHELL_TARGET","A stored recipient GeoShell has lost its native Shell Node target: "+it.name);
                restoredLocalShellIDs.push(itID);
                continue;
            }
            throw problem("GEO_TRANSFER_SHELL_SCOPE","A saved GeoShell must already be worn, be queued for local Wardrobe Restore, or be explicitly transferred with the GeoGraft: "+it.name);
        }
        // Destination must not already contain a second matching shell that
        // would become ambiguous after transfer.
        var recs=st.geoShellSnapshots||[];
        for(j=0;j<recs.length;j++)if(recs[j].graftItemID===graftID){
            var existing=geoFindTargetShell(target,recs[j]);
            if(existing&&recs[j].shellItemID&&shellIDs.indexOf(recs[j].shellItemID)>=0)
                throw problem("GEO_TRANSFER_DUPLICATE_SHELL","Target already has a shell matching an incoming one: "+recs[j].shellName);
        }
        var sc=geoShellsOnFigure(source,true).length,tc=geoShellsOnFigure(target,true).length;
        if((sc||tc||shellIDs.length)&&!app.experimentalGeoShellRecovery)
            throw problem("GEO_SHELL_SAFETY","Enable GeoShell Material Recovery in Settings and use a saved scene copy.");
        if(locallyStoredGraftItemIDs.length)log("WARN","GEO_TRANSFER_TARGET_LOCAL_GRAFT_STORE",
            "recipient="+target.getLabel()+" | localStore="+describeIDs(locallyStoredGraftItemIDs)+
            " | incoming="+app.db.items[graftID].name+
            " | both owners' GeoShell backups and the local graft's Wardrobe snapshots required before any native mutation");
        if(restoredLocalShellIDs.length)log("INFO","GEO_TRANSFER_LOCAL_SHELL_RESTORE",
            "Validated "+restoredLocalShellIDs.length+" GeoShell(s) already stored in the recipient's Wardrobe; they will be restored locally before GeoGraft transfer: "+describeIDs(restoredLocalShellIDs));
        log("INFO","GEO_TRANSFER_PREFLIGHT","graft="+app.db.items[graftID].name+
            " | movedShells="+shellIDs.length+" | locallyRestoredShells="+restoredLocalShellIDs.length+
            " | sourceShellsIncludingStorage="+sc+" | targetShellsIncludingStorage="+tc+
            " | sourceGraftState="+(wasStored?"stored_detached":"active_attached")+
            " | mode="+(sc||tc||shellIDs.length?"geoshell_recovery":"no_shells"));
        return {graftItemID:graftID,source:source,sourceKey:one.row.sourceKey,
            graftKey:key(root),shellItemIDs:shellIDs,movedShellKeys:shellKeys,
            initiallyStored:wasStored,initiallyAttached:wasAttached,
            locallyStoredGraftItemIDs:locallyStoredGraftItemIDs,
            locallyRestoredShellItemIDs:restoredLocalShellIDs,needsRecovery:!!(sc||tc||shellIDs.length)};
    }
    function geoTransferIsAttached(fig,node){
        if(!fig||!node||typeof fig.getNumGraftFigures!=="function"||typeof fig.getGraftFigure!=="function")return false;
        var count=Number(fig.getNumGraftFigures());
        if(!isFinite(count)||count<0||count>128)return false;
        for(var i=0;i<count;i++)if(same(fig.getGraftFigure(i),node))return true;
        return false;
    }
    function geoTransferCaptureSourceSurfaceAllowances(tx){
        var info=tx.geoTransfer;if(!info||!info.needsRecovery)return;
        // A stored graft is already natively detached. No graft-dependent
        // surfaces may disappear on its source due to this transfer. Require
        // exact source-shell preservation, not a wildcard allowance.
        if(info.initiallyStored){
            var original=live(info.graftKey);
            if(!original||geoTransferIsAttached(info.source,original))
                throw problem("GEO_TRANSFER_STORED_CHANGED","Stored source GeoGraft became attached before transfer started.");
            info.allowedSurfaces={};
            for(var si=0;si<ctx.geoMaterialTxn.records.length;si++){
                var storedRow=ctx.geoMaterialTxn.records[si];
                if(storedRow.figureKey!==info.sourceKey)continue;
                if(!live(storedRow.nodeKey))throw problem("GEO_TRANSFER_SHELL_GONE",storedRow.nodeKey);
                info.allowedSurfaces[storedRow.nodeKey]=[];
            }
            log("INFO","GEO_TRANSFER_STORED_SOURCE_BASELINE",
                "Stored GeoGraft will be fitted directly to target; source shell material snapshots must match exactly.");
            return;
        }
        var source=info.source,grafts=[],parentNames={},base=materials(source).surfaces;
        for(var p=0;p<base.length;p++)parentNames["$"+String(base[p].name).toLowerCase()]=true;
        var n=Number(source.getNumGraftFigures());
        if(!isFinite(n)||n<1||n>128)throw problem("GEO_TRANSFER_GRAFT_LIST","Invalid source GeoGraft list.");
        var present=false;
        for(var g=0;g<n;g++){
            var node=source.getGraftFigure(g);
            if(!node)throw problem("GEO_TRANSFER_GRAFT_LIST","DAZ returned a missing source graft node.");
            var id=same(node,live(info.graftKey))?info.graftItemID:"other_graft_"+g;
            if(id===info.graftItemID)present=true;
            grafts.push({id:id,node:node,names:materials(node).surfaces.map(function(s){return s.name;})});
        }
        if(!present)throw problem("GEO_TRANSFER_GRAFT_CHANGED","The source GeoGraft was detached before backups completed.");
        info.allowedSurfaces={};
        for(var i=0;i<ctx.geoMaterialTxn.records.length;i++){
            var rec=ctx.geoMaterialTxn.records[i];if(rec.figureKey!==info.sourceKey)continue;
            var shell=live(rec.nodeKey);if(!shell)throw problem("GEO_TRANSFER_SHELL_GONE",rec.nodeKey);
            var picked=geoSetSurfaceSelection(shell,source,grafts,parentNames);
            if(picked.ambiguous.length)throw problem("GEO_TRANSFER_SURFACE_AMBIGUOUS",
                "Cannot identify owner of source GeoShell surface(s): "+picked.ambiguous.join(", "));
            info.allowedSurfaces[rec.nodeKey]=picked.byGraft[info.graftItemID]||[];
            log("INFO","GEO_TRANSFER_SOURCE_BASELINE",String(shell.getLabel())+
                " | graftDependent="+info.allowedSurfaces[rec.nodeKey].join(", "));
        }
    }
    function geoTransferVerifyGraftAttachment(info,target){
        var root=live(info.graftKey);
        if(!root||!geoTransferIsAttached(target,root)||geoTransferIsAttached(info.source,root))
            throw problem("GEO_TRANSFER_GRAFT_ATTACHMENT","DAZ did not attach the original GeoGraft to the new figure and detach it from the old one.");
        log("PASS","GEO_TRANSFER_GRAFT_ATTACHED",app.db.items[info.graftItemID].name+
            " | source="+info.source.getLabel()+" | target="+target.getLabel());
    }
    function geoTransferVerifySourceShellMaterials(tx){
        var info=tx.geoTransfer;if(!info||!info.needsRecovery)return;
        var records=ctx.geoMaterialTxn.records,total=0;
        for(var i=0;i<records.length;i++){
            var rec=records[i];if(rec.figureKey!==info.sourceKey)continue;
            var shell=live(rec.nodeKey);if(!shell)throw problem("GEO_TRANSFER_SOURCE_SHELL_MISSING",rec.nodeKey);
            if(info.movedShellKeys&&info.movedShellKeys[rec.nodeKey]){
                if(!same(shell.getTarget(),ctx.target))throw problem("GEO_TRANSFER_SHELL_TARGET",String(shell.getLabel()));
                log("PASS","GEO_TRANSFER_SOURCE_SHELL_MOVED",String(shell.getLabel())+" | now owned by recipient; source-only material check not applicable.");
                continue;
            }
            var before=rec.before.surfaces,after=materials(shell).surfaces,
                ignore=info.allowedSurfaces[rec.nodeKey]||[],saved=[],actual=[];
            for(var b=0;b<before.length;b++)if(ignore.indexOf(before[b].name)<0)saved.push(before[b]);
            for(var a=0;a<after.length;a++)if(ignore.indexOf(after[a].name)<0)actual.push(after[a]);
            saved.sort(function(a,b){return a.name<b.name?-1:(a.name>b.name?1:0);});
            actual.sort(function(a,b){return a.name<b.name?-1:(a.name>b.name?1:0);});
            if(!closeNumbers(saved,actual))throw problem("GEO_TRANSFER_SOURCE_MATERIALS",
                String(shell.getLabel())+": surfaces unrelated to the removed GeoGraft changed.");
            log("PASS","GEO_TRANSFER_SOURCE_SHELL_CHECK",String(shell.getLabel())+
                " | preservedSurfaces="+saved.length+" | graftDependentExcluded="+ignore.length);
            total++;
        }
        log("INFO","GEO_TRANSFER_SOURCE_SUMMARY","verifiedShells="+total+
            " | unreadable shader values not certified. Source material backups retained until successful commit.");
    }
    function geoSetShellIdentity(shell){
        var name="",asset="";
        try{name=String(shell.getName?shell.getName():shell.name||"");}catch(e){}
        try{asset=String(shell.assetId||"");}catch(e2){}
        if(!asset)try{var uri=shell.assetUri;if(uri&&typeof uri.filePath==="string")asset=String(uri.filePath);}catch(e3){}
        return {name:name||String(shell.getLabel()),assetId:asset};
    }
    function geoSetGraftInfo(fig,newInv,memberIDs){
        var records=[],found={};
        if(typeof fig.getNumGraftFigures==="function"&&typeof fig.getGraftFigure==="function"){
            var count=Number(fig.getNumGraftFigures());
            if(!isFinite(count)||count<0||count>128)throw problem("GEO_SET_GRAFT_LIST","Invalid live GeoGraft count.");
            for(var g=0;g<count;g++){
                var node=fig.getGraftFigure(g);if(!node)continue;
                for(var i=0;i<memberIDs.length;i++){
                    var id=memberIDs[i],inf=newInv[id];
                    if(inf&&inf.root&&same(node,inf.root)&&inf.where==="active"&&!found[id]){
                        records.push({id:id,node:node,names:materials(node).surfaces.map(function(s){return String(s.name);})});found[id]=true;
                    }
                }
            }
        }
        return records;
    }
    function geoSetSurfaceSelection(shell,fig,grafts,parentNames){
        var snap=materials(shell),out={},ambiguous=[];
        for(var i=0;i<grafts.length;i++)out[grafts[i].id]=[];
        for(var s=0;s<snap.surfaces.length;s++){
            var surface=String(snap.surfaces[s].name),lower=surface.toLowerCase();
            if(parentNames["$"+lower])continue;
            var owners=[];
            for(var g=0;g<grafts.length;g++){
                var names=grafts[g].names,hit=false;
                for(var n=0;n<names.length;n++){
                    var suffix=String(names[n]).toLowerCase();
                    if(lower===suffix || (lower.length>suffix.length+1 && lower.slice(-(suffix.length+1))==="_"+suffix)){
                        hit=true;break;
                    }
                }
                if(hit)owners.push(grafts[g].id);
            }
            if(owners.length===1)out[owners[0]].push(surface);
            else if(owners.length>1)ambiguous.push(surface);
        }
        for(var k=0;k<grafts.length;k++)out[grafts[k].id].sort();
        return {byGraft:out,ambiguous:ambiguous};
    }
    function captureGeoShellSetBaselines(fig,memberIDs,newInv,old,materialSnapshots){
        var grafts=geoSetGraftInfo(fig,newInv,memberIDs),preserved=[],ids={},gi;
        for(gi=0;gi<memberIDs.length;gi++)ids[memberIDs[gi]]=true;
        var previous=old&&Array.isArray(old.geoShellSnapshots)?old.geoShellSnapshots:[];
        var activeGrafts={},oldGrafts={};
        for(gi=0;gi<grafts.length;gi++)activeGrafts[grafts[gi].id]=true;
        for(gi=0;gi<previous.length;gi++)if(ids[previous[gi].graftItemID]){
            var prior=previous[gi],currentlyWorn=!!activeGrafts[prior.graftItemID],
                matchingShell=currentlyWorn?geoFindTargetShell(fig,prior):null;
            if(currentlyWorn&&matchingShell){
                // The current Set is being saved with this graft attached.
                // Rebuild this saved donor-surface baseline instead of
                // silently reusing a stale preset after another graft changed
                // the shell's topology (e.g. HD Nipples 2.0).
                log("INFO","GEO_SET_BASELINE_RECAPTURE",prior.shellName+
                    " | donor="+prior.graftItemID+" | previously="+prior.nativePreset);
            }else{
                preserved.push(clonePlain(prior));
                if(!currentlyWorn)oldGrafts[prior.graftItemID]=true;
                else log("WARN","GEO_SET_BASELINE_SHELL_ABSENT",prior.shellName+
                    " | donor attached but this saved shell is not worn; preserving its previous baseline.");
            }
        }
        var capture=[];for(gi=0;gi<grafts.length;gi++)capture.push(grafts[gi]);
        // A recognised stored graft cannot supply the graft-added shell
        // surfaces at Set creation. Do not invent an incomplete baseline.
        var memberShellPresent=false,sceneForGuard=sceneNodes();
        for(var sg=0;sg<sceneForGuard.length;sg++)if(sceneForGuard[sg].inherits("DzGeometryShellNode")){
            var owning=null;try{owning=sceneForGuard[sg].getTarget();}catch(ignoreShellTarget){}
            if(owning&&same(owning,fig)){memberShellPresent=true;break;}
        }
        if(memberShellPresent)for(var sm=0;sm<memberIDs.length;sm++){
            var sid=memberIDs[sm],info=newInv[sid],node=info&&info.root;
            if(!node||typeof node.inherits!=="function"||!node.inherits("DzFigure")||oldGrafts[sid])continue;
            var alreadyActive=false;for(var ag=0;ag<grafts.length;ag++)if(grafts[ag].id===sid)alreadyActive=true;
            if(alreadyActive)continue;
            var weld=0;try{if(typeof node.getNumWeldPoints==="function")weld=Number(node.getNumWeldPoints());}catch(ignoreWeld){}
            if(weld>0)throw problem("GEO_SET_GRAFT_NOT_ATTACHED","The GeoGraft "+String(node.getLabel())+
                " is stored. Put it on the figure before first saving this Set so dependent GeoShell surfaces can be captured.");
        }
        if(!capture.length){if(preserved.length)log("INFO","GEO_SET_EXISTING_BASELINE","Preserved "+preserved.length+" immutable GeoShell material reference(s).");return preserved;}
        var parentNames={},base=materials(fig).surfaces;
        for(var p=0;p<base.length;p++)parentNames["$"+String(base[p].name).toLowerCase()]=true;
        // Surface ownership must be compared against ALL attached grafts,
        // including unregistered ones and grafts not selected in this Set.
        // Otherwise a shared suffix could be misassigned to the one selected
        // graft and later overwrite another graft's material.
        var comparisonGrafts=capture.slice(0),nAll=Number(fig.getNumGraftFigures());
        for(var cg=0;cg<nAll;cg++){
            var cgNode=fig.getGraftFigure(cg),seenNode=false;if(!cgNode)continue;
            for(var cx=0;cx<comparisonGrafts.length;cx++)if(same(comparisonGrafts[cx].node,cgNode))seenNode=true;
            if(!seenNode)comparisonGrafts.push({id:"unselected_graft_"+String(cg),node:cgNode,
                names:materials(cgNode).surfaces.map(function(r){return String(r.name);})});
        }
        var all=sceneNodes(),counter=0;
        for(var si=0;si<all.length;si++){
            var shell=all[si];if(!shell||typeof shell.inherits!=="function"||!shell.inherits("DzGeometryShellNode"))continue;
            var target=null;try{target=typeof shell.getTarget==="function"?shell.getTarget():null;}catch(e){}
            if(!target||!same(target,fig))continue;
            var picked=geoSetSurfaceSelection(shell,fig,comparisonGrafts,parentNames);
            if(picked.ambiguous.length)log("WARN","GEO_SET_AMBIGUOUS_SURFACES",String(shell.getLabel())+
                " | no ownership assigned: "+picked.ambiguous.join(", "));
            var identity=geoSetShellIdentity(shell),shellItemID="";
            for(var mi=0;mi<memberIDs.length;mi++){
                var mid=memberIDs[mi],inf=newInv[mid];
                if(inf&&inf.root&&same(inf.root,shell)){shellItemID=mid;break;}
            }
            for(gi=0;gi<capture.length;gi++){
                var graft=capture[gi],names=picked.byGraft[graft.id];if(!names||!names.length)continue;
                var nativeRel="",mode="partial";
                if(shellItemID){
                    if(!materialSnapshots[shellItemID]||!materialSnapshots[shellItemID].nativePreset)
                        throw problem("GEO_SET_SHELL_MATERIALS","GeoShell is a member of this Set, but its full native material preset could not be verified: "+identity.name);
                    // An old full shell preset must not be reused for a newly
                    // attached different donor graft while a previous donor
                    // is still stored. That would link the new donor's
                    // surface selection to a native file captured under an
                    // incompatible surface topology.
                    var fullRecord=materialSnapshots[shellItemID],shellInfo=newInv[shellItemID],fullPart=null;
                    for(var sr=0;sr<fullRecord.parts.length;sr++){
                        var candidate=fullRecord.parts[sr];
                        if(shellInfo.parts[candidate.partID]&&same(shellInfo.parts[candidate.partID],shell)){
                            fullPart=candidate;break;
                        }
                    }
                    if(!fullPart||!closeNumbers(fullPart.snapshot.surfaces,materials(shell).surfaces))
                        throw problem("GEO_SET_SHELL_PRESET_STALE",identity.name+
                            ": the registered full Material Preset belongs to different GeoShell topology. " +
                            "Wear all donor GeoGrafts referenced by this Set, then edit/save it to refresh materials.");
                    nativeRel=fullRecord.nativePreset;mode="registered_full";
                }else{
                    nativeRel="Materials/"+unique("geo_set_material")+".duf";
                    exportProbeGeoShellMaterials(shell,names,"set_"+String(counter++),nativeRel);
                }
                var entry={schemaVersion:1,graftItemID:graft.id,shellName:identity.name,shellAssetId:identity.assetId,
                    surfaceNames:names,nativePreset:nativeRel,mode:mode,captured:String(new Date())};
                var snap=materials(shell),uvs={};
                for(var su=0;su<snap.surfaces.length;su++)if(names.indexOf(snap.surfaces[su].name)>=0)uvs[snap.surfaces[su].name]=snap.surfaces[su].uv;
                entry.surfaceUVs=uvs;
                if(shellItemID&&mode==="registered_full")entry.shellItemID=shellItemID;
                preserved.push(entry);
                log("PASS","GEO_SET_CAPTURED","graft="+String(graft.node.getLabel())+
                    " | shellName="+identity.name+" | shellAssetId="+identity.assetId+
                    " | selected="+names.join(", ")+" | mode="+mode+" | preset="+nativeRel);
            }
        }
        log("INFO","GEO_SET_CAPTURE_SUMMARY","activeGrafts="+capture.length+
            " | totalReferences="+preserved.length+" | per-Set immutable; no scene material changes; GeoShell Material Recovery must be enabled.");
        return preserved;
    }

    // v0.9.10.7: GeoGraft/GeoShell protected transaction.
    // Only the native DAZ material importer writes shader values. Permanent
    // snapshots remain immutable; these temporary backups are for rollback.
    function geoShellsOnFigure(fig,includeStored){
        var all=sceneNodes(),found=[],storage=existingStorageGroup(fig);
        for(var i=0;i<all.length;i++){
            var n=all[i];if(!n||!n.inherits("DzGeometryShellNode"))continue;
            var target=null;try{target=n.getTarget();}catch(e){}
            if(!target||!same(target,fig))continue;
            if(!includeStored&&storage){
                var ancestor=n.getNodeParent(),inStorage=false,guard=0;
                while(ancestor&&guard++<64){
                    if(same(ancestor,storage)){inStorage=true;break;}
                    ancestor=ancestor.getNodeParent();
                }
                if(inStorage)continue;
            }
            found.push(n);
        }
        return found;
    }
    function geoIsGraft(fig,itemID,inf,st){
        if(st&&Array.isArray(st.geoShellSnapshots))for(var i=0;i<st.geoShellSnapshots.length;i++)
            if(st.geoShellSnapshots[i].graftItemID===itemID)return true;
        var node=inf&&inf.root;if(!node||!node.inherits("DzFigure"))return false;
        try{if(typeof node.getNumWeldPoints==="function"&&Number(node.getNumWeldPoints())>0)return true;}catch(ignoreWeld){}
        try{if(typeof fig.getNumGraftFigures==="function")for(var g=0;g<fig.getNumGraftFigures();g++)
            if(same(fig.getGraftFigure(g),node))return true;}catch(ignoreGraft){}
        return false;
    }
    function geoImpactedPlan(st,fig,plan,inv){
        var moved=plan.store.concat(plan.restore,plan.load),ids=[];
        for(var i=0;i<moved.length;i++)if(geoIsGraft(fig,moved[i],inv[moved[i]],st))ids.push(moved[i]);
        return ids;
    }
    // v0.9.10.11: Wardrobe-specific material persistence. This is NOT a saved
    // outfit style and never uses the outfit catalog's immutable baselines.
    // A single manifest is written before mutation, with one strictly selective
    // native material DUF for each source graft / shell pairing. Both manifest
    // and DUFs are immutable library-relative files. Only the scene instance's
    // metadata pointer is updated transactionally; previous files are retained
    // because previously saved scenes may still refer to them.
    function geoWardrobeManifestPath(path){
        if(typeof path!=="string"||!/^Materials\/matew_geo_wardrobe_[a-zA-Z0-9_]+\.json$/.test(path))
            throw problem("GEO_WARDROBE_PATH","Invalid GeoGraft wardrobe snapshot path: "+String(path));
        return safeRelative(path);
    }
    function geoWardrobePointer(root){
        var text=value(root,"GeoWardrobeSnapshot");if(!text)return null;
        var row;try{row=JSON.parse(text);}catch(e){throw problem("GEO_WARDROBE_POINTER","Corrupt GeoGraft wardrobe snapshot pointer on "+root.getLabel());}
        if(!row||row.schemaVersion!==1||typeof row.path!=="string"||!Array.isArray(row.pending))
            throw problem("GEO_WARDROBE_POINTER","Invalid GeoGraft wardrobe pointer on "+root.getLabel());
        geoWardrobeManifestPath(row.path);
        var seen={};for(var i=0;i<row.pending.length;i++){
            var idx=row.pending[i];if(typeof idx!=="number"||!isFinite(idx)||idx<0||Math.floor(idx)!==idx||seen["$"+idx])
                throw problem("GEO_WARDROBE_POINTER","Invalid or repeated pending surface group.");
            seen["$"+idx]=true;
        }
        return row;
    }
    function geoWardrobeRead(it,inf,pointer){
        if(!pointer)return null;
        var path=inLibrary(geoWardrobeManifestPath(pointer.path));
        if(!readable(path))throw problem("GEO_WARDROBE_MANIFEST_MISSING",it.name+" | "+pointer.path);
        var doc=readJSON(path);
        if(!doc||doc.schemaVersion!==1||doc.libraryID!==app.db.libraryID||
            doc.itemID!==it.id||doc.instanceID!==inf.instanceID||!Array.isArray(doc.shells)||doc.shells.length>128)
            throw problem("GEO_WARDROBE_MANIFEST","Wardrobe snapshot does not belong to this exact GeoGraft instance: "+it.name);
        for(var i=0;i<pointer.pending.length;i++){
            var index=pointer.pending[i],entry=doc.shells[index];
            if(!entry||typeof entry.shellName!=="string"||!entry.shellName||
                typeof entry.shellAssetId!=="string"||typeof entry.sourceNodeID!=="string"||
                !Array.isArray(entry.surfaceNames)||!Array.isArray(entry.surfaces)||
                !entry.surfaceNames.length||entry.surfaceNames.length!==entry.surfaces.length)
                throw problem("GEO_WARDROBE_MANIFEST","Invalid pending shell material group on "+it.name);
            validateNativeMaterialPresetRelative(entry.nativePreset);
            if(!readable(inLibrary(entry.nativePreset)))throw problem("GEO_WARDROBE_PRESET_MISSING",entry.nativePreset);
            var names={};for(var n=0;n<entry.surfaceNames.length;n++){
                var nm=entry.surfaceNames[n],mat=entry.surfaces[n];
                if(typeof nm!=="string"||!nm||names["$"+nm]||!mat||mat.name!==nm||
                    typeof mat.uv!=="string"||!mat.values||typeof mat.values!=="object"||Array.isArray(mat.values))
                    throw problem("GEO_WARDROBE_MANIFEST","Invalid or repeated saved surface on "+it.name);
                names["$"+nm]=true;
            }
        }
        return doc;
    }
    function geoWardrobeGroupKey(entry){
        return String(entry.shellName)+"\n"+String(entry.shellAssetId)+"\n"+String(entry.sourceNodeID||"");
    }
    function geoWardrobeGrafts(fig){
        if(typeof fig.getNumGraftFigures!=="function"||typeof fig.getGraftFigure!=="function")
            throw problem("GEO_WARDROBE_GRAFT_API","DAZ cannot enumerate attached GeoGrafts on "+fig.getLabel());
        var count=Number(fig.getNumGraftFigures());
        if(!isFinite(count)||count<0||count>128||Math.floor(count)!==count)
            throw problem("GEO_WARDROBE_GRAFT_API","Invalid native GeoGraft count.");
        var found=[];
        for(var i=0;i<count;i++){
            var node=fig.getGraftFigure(i);
            if(!node)throw problem("GEO_WARDROBE_GRAFT_API","A native graft node disappeared.");
            var id=value(node,"ItemID")||"unregistered_"+i;
            found.push({id:id,node:node,names:materials(node).surfaces.map(function(s){return String(s.name);})});
        }
        return found;
    }
    function geoWardrobePrepareStores(fig,plan,inv){
        if(!plan||!plan.store||!plan.store.length)return;
        var wanted=[],i,j;
        for(i=0;i<plan.store.length;i++){
            var id=plan.store[i],inf=inv[id];
            if(geoIsGraft(fig,id,inf,null))wanted.push(id);
        }
        if(!wanted.length)return;
        var grafts=geoWardrobeGrafts(fig),graftIDs={};
        for(i=0;i<grafts.length;i++)graftIDs[grafts[i].id]=grafts[i];
        for(i=0;i<wanted.length;i++){
            var id=wanted[i],inf=inv[id];
            if(!inf||inf.where!=="active"||!graftIDs[id]||!same(inf.root,graftIDs[id].node))
                throw problem("GEO_WARDROBE_GRAFT_DETACHED",app.db.items[id].name+" must be natively attached before its material snapshot can be made.");
        }
        if(!ctx.geoWardrobeTxn)ctx.geoWardrobeTxn={drafts:{},created:[],restored:0,stored:0};
        var sourceFigure=figureIdentity(fig,false),parentNames={},base=materials(fig).surfaces;
        for(i=0;i<base.length;i++)parentNames["$"+String(base[i].name).toLowerCase()]=true;
        var selected={},shells=geoShellsOnFigure(fig,true);
        for(i=0;i<wanted.length;i++)selected[wanted[i]]=[];
        for(i=0;i<shells.length;i++){
            var shell=shells[i],picked=geoSetSurfaceSelection(shell,fig,grafts,parentNames);
            if(picked.ambiguous.length)throw problem("GEO_WARDROBE_AMBIGUOUS_SURFACES",
                shell.getLabel()+" has surfaces matching multiple grafts: "+picked.ambiguous.join(", ")+
                ". No wardrobe materials were captured or detached.");
            var identity=geoSetShellIdentity(shell),snap=materials(shell);
            for(j=0;j<wanted.length;j++){
                var graftID=wanted[j],names=picked.byGraft[graftID]||[];
                if(!names.length)continue;
                var byName={},parts=[],seen={};
                for(var p=0;p<snap.surfaces.length;p++)byName["$"+snap.surfaces[p].name]=snap.surfaces[p];
                names.sort();for(var n=0;n<names.length;n++){
                    var nm=names[n];if(seen["$"+nm]||!own(byName,"$"+nm))
                        throw problem("GEO_WARDROBE_CAPTURE_SURFACE",String(shell.getLabel())+" / "+nm);
                    seen["$"+nm]=true;parts.push(clonePlain(byName["$"+nm]));
                }
                var rel="Materials/"+unique("geo_wardrobe")+".duf";
                // Native selective-export verifies DSON material_library names;
                // do not permit an exporter to silently include base surfaces.
                exportProbeGeoShellMaterials(shell,names,"wardrobe_"+graftID,rel);
                ctx.geoWardrobeTxn.created.push(rel);
                selected[graftID].push({shellName:identity.name,shellAssetId:identity.assetId,
                    sourceNodeID:value(shell,"NodeID")||"",surfaceNames:names.slice(0),
                    surfaces:parts,nativePreset:rel,skipped:snap.skipped});
                log("PASS","GEO_WARDROBE_CAPTURE_GROUP",app.db.items[graftID].name+" / "+shell.getLabel()+
                    " | surfaces="+names.join(", ")+" | native="+rel);
            }
        }
        for(i=0;i<wanted.length;i++){
            var itemID=wanted[i],item=app.db.items[itemID],info=inv[itemID],entries=selected[itemID];
            // Unconsumed groups from an earlier return must not be discarded
            // merely because their shell was absent during this new capture.
            var earlier=geoWardrobePointer(info.root),oldPending=[];
            if(earlier){
                var old=geoWardrobeRead(item,info,earlier);
                for(j=0;j<earlier.pending.length;j++){
                    var prior=old.shells[earlier.pending[j]],oldKey=geoWardrobeGroupKey(prior),replaced=false;
                    for(var e=entries.length-1;e>=0;e--)if(geoWardrobeGroupKey(entries[e])===oldKey){
                        var freshNames={},priorNames={},np,shared=0,fullNew=true,fullOld=true;
                        for(np=0;np<entries[e].surfaceNames.length;np++)freshNames["$"+entries[e].surfaceNames[np]]=true;
                        for(np=0;np<prior.surfaceNames.length;np++){
                            var previousName=prior.surfaceNames[np];priorNames["$"+previousName]=true;
                            if(!freshNames["$"+previousName])fullNew=false;
                            else shared++;
                        }
                        for(np=0;np<entries[e].surfaceNames.length;np++)if(!priorNames["$"+entries[e].surfaceNames[np]])fullOld=false;
                        if(fullNew){replaced=true;break;} // New native DUF covers every pending older surface.
                        if(fullOld){ // Existing immutable native DUF is the only complete reference.
                            entries.splice(e,1);
                            continue;
                        }
                        if(shared)throw problem("GEO_WARDROBE_PENDING_OVERLAP",
                            item.name+" / "+prior.shellName+": the new shell surfaces only partly overlap a pending older snapshot. Return the shell and restore its material state before storing this GeoGraft again.");
                        // Disjoint groups can each have an independent native preset.
                    }
                    if(!replaced)oldPending.push(clonePlain(prior));
                }
            }
            entries=entries.concat(oldPending);
            if(!entries.length&&shells.length)log("WARN","GEO_WARDROBE_NO_MATCHED_SURFACES",
                item.name+" | "+shells.length+" GeoShell node(s) exist, but no unambiguously graft-owned dependent surfaces could be captured. The wardrobe cannot reconstruct unrecognized materials later; inspect the shell surface names before relying on this snapshot.");
            var manifest="Materials/"+unique("geo_wardrobe")+".json";
            geoWardrobeManifestPath(manifest);
            var doc={schemaVersion:1,libraryID:app.db.libraryID,itemID:itemID,
                instanceID:info.instanceID,sourceFigureID:sourceFigure,captured:String(new Date()),shells:entries};
            writeNewJSON(inLibrary(manifest),doc);
            ctx.geoWardrobeTxn.created.push(manifest);
            var pending=[];for(j=0;j<entries.length;j++)pending.push(j);
            ctx.geoWardrobeTxn.drafts[itemID]=jsonText({schemaVersion:1,path:manifest,pending:pending});
            log("PASS","GEO_WARDROBE_SNAPSHOT",item.name+" | groups="+entries.length+
                " | preservedPending="+oldPending.length+" | manifest="+manifest+
                " | no Set style was used; prepared before topology changed.");
        }
    }
    function geoWardrobeShellFor(fig,entry){
        var shells=geoShellsOnFigure(fig,false),hits=[],original=null;
        for(var i=0;i<shells.length;i++){
            var shell=shells[i],identity=geoSetShellIdentity(shell),nodeID=value(shell,"NodeID")||"";
            if(entry.sourceNodeID&&nodeID===entry.sourceNodeID){
                if(original)throw problem("GEO_WARDROBE_SHELL_DUPLICATE","Repeated persistent GeoShell node identity.");
                original=shell;continue;
            }
            if(identity.name!==entry.shellName)continue;
            // A saved, known asset identity must not match a different or
            // unknown target asset by name alone.
            if(entry.shellAssetId&&identity.assetId!==entry.shellAssetId)continue;
            hits.push(shell);
        }
        if(original){
            var ownIdentity=geoSetShellIdentity(original);
            if(ownIdentity.name!==entry.shellName||
                (entry.shellAssetId&&ownIdentity.assetId!==entry.shellAssetId))
                throw problem("GEO_WARDROBE_SHELL_IDENTITY","The original GeoShell changed its native identity.");
            return original;
        }
        if(hits.length>1)throw problem("GEO_WARDROBE_SHELL_AMBIGUOUS",
            "Multiple compatible shells named "+entry.shellName+" are active; no materials applied.");
        return hits.length?hits[0]:null;
    }
    function geoWardrobeCheckRestored(expected,actual,label){
        var diffs=materialDifferences(expected,actual),changed=[];
        for(var i=0;i<diffs.length;i++){
            var d=diffs[i];if(d.category==="texture_path"&&d.expectedPresent&&d.actualPresent&&
                typeof d.expected==="string"&&typeof d.actual==="string"&&
                materialMapSameExistingFile(d.expected,d.actual).match)continue;
            if(changed.length<12)changed.push(d.surface+" / "+d.field+" ("+d.category+")");
        }
        return changed;
    }
    function geoWardrobeRestoreCandidates(st,plan,fig){
        var desired={},ids=[],i,inv=inventory(fig,app.db),selected=[];
        if(ctx.action==="apply"&&ctx.diag.transition&&ctx.diag.transition.originalMembers)
            selected=ctx.diag.transition.originalMembers;
        else if(ctx.action==="partial_apply"&&ctx.diag.partial)
            selected=ctx.diag.partial.chosenItems||[];
        else if(ctx.action==="apply"&&st&&st.items)selected=st.items;
        // Store Registered Item and Undress All must never consume an
        // unrelated graft's pending material snapshot just because that
        // graft happens to remain active.
        for(i=0;i<selected.length;i++)desired[selected[i]]=true;
        for(i=0;i<(plan&&plan.restore||[]).length;i++)desired[plan.restore[i]]=true;
        var shellReturned=false,changed=(plan?plan.restore.concat(plan.load||[],plan.transfer||[]):[]);
        for(i=0;i<changed.length;i++){
            var item=app.db.items[changed[i]];
            if(item&&item.parts&&item.parts[0]&&item.parts[0].className==="DzGeometryShellNode")shellReturned=true;
        }
        var keys=Object.keys(inv);
        for(i=0;i<keys.length;i++){
            var id=keys[i],inf=inv[id];
            if(inf.where==="active"&&value(inf.root,"GeoWardrobeSnapshot")&&
                (desired[id]||shellReturned))ids.push(id);
        }
        return ids;
    }
    function geoWardrobeRestoreActive(fig,allowedIDs){
        if(!allowedIDs||!allowedIDs.length)return;
        var inv=inventory(fig,app.db),ids=allowedIDs,count=0,waiting=0;
        // Do not silently discard a previously captured snapshot when a user
        // has since switched off GeoShell Material Recovery.
        if(!app.experimentalGeoShellRecovery){
            for(var rg=0;rg<ids.length;rg++)if(inv[ids[rg]]&&inv[ids[rg]].where==="active"&&
                value(inv[ids[rg]].root,"GeoWardrobeSnapshot"))
                throw problem("GEO_SHELL_SAFETY","A saved GeoGraft has pending Wardrobe material snapshots. Enable GeoShell Material Recovery in Settings before returning it.");
            return;
        }
        for(var i=0;i<ids.length;i++){
            var id=ids[i],inf=inv[id],it=app.db.items[id];
            if(!inf||inf.where!=="active"||!value(inf.root,"GeoWardrobeSnapshot"))continue;
            var ptr=geoWardrobePointer(inf.root),doc=geoWardrobeRead(it,inf,ptr);
            if(!geoIsGraft(fig,id,inf,null)||!geoTransferIsAttached(fig,inf.root))
                throw problem("GEO_WARDROBE_NOT_ATTACHED",it.name+" has a pending material snapshot, but is not an attached GeoGraft.");
            if(!ctx.geoMaterialTxn)geoPrepareShellBackups(fig,true);
            var remaining=[],used={},restored=[],claimed={};
            for(var ck=0;ck<ptr.pending.length;ck++){
                var checkEntry=doc.shells[ptr.pending[ck]],checkShell=geoWardrobeShellFor(fig,checkEntry);
                if(!checkShell)continue;
                for(var cn=0;cn<checkEntry.surfaceNames.length;cn++){
                    var claim=key(checkShell)+"|"+checkEntry.surfaceNames[cn];
                    if(claimed[claim])throw problem("GEO_WARDROBE_OVERLAPPING_GROUPS",
                        "Two pending snapshots claim "+checkShell.getLabel()+" / "+checkEntry.surfaceNames[cn]);
                    claimed[claim]=true;
                }
            }
            for(var j=0;j<ptr.pending.length;j++){
                var index=ptr.pending[j],entry=doc.shells[index],shell=geoWardrobeShellFor(fig,entry);
                if(!shell){remaining.push(index);waiting++;log("WARN","GEO_WARDROBE_DEFERRED",
                    it.name+" / "+entry.shellName+" | corresponding compatible GeoShell is not worn; saved native materials retained.");continue;}
                var uniqueGroup=key(shell)+"|"+entry.surfaceNames.join("\n");
                if(own(used,uniqueGroup))throw problem("GEO_WARDROBE_REPEAT_GROUP","Overlapping snapshot groups for "+shell.getLabel());
                used[uniqueGroup]=true;
                var before=materials(shell),all={},picked={},beforeOther=[],b;
                for(b=0;b<before.surfaces.length;b++)all["$"+before.surfaces[b].name]=before.surfaces[b];
                for(b=0;b<entry.surfaceNames.length;b++){
                    var name=entry.surfaceNames[b];
                    if(!own(all,"$"+name))throw problem("GEO_WARDROBE_SURFACE_MISSING",
                        it.name+" / "+shell.getLabel()+" / "+name+
                        ": target shell has not recreated this GeoGraft surface. No partial load attempted.");
                    picked["$"+name]=true;
                }
                for(b=0;b<before.surfaces.length;b++)if(!picked["$"+before.surfaces[b].name])beforeOther.push(before.surfaces[b]);
                ctx.geoMaterialTxn.attempted=true;
                geoImportToShell(shell,entry.nativePreset);
                var shape=shell.getObject()?shell.getObject().getCurrentShape():null;
                if(!shape)throw problem("GEO_WARDROBE_SHELL_SHAPE",shell.getLabel());
                for(b=0;b<entry.surfaces.length;b++){
                    var saved=entry.surfaces[b],mat=shape.findMaterial(saved.name),uv=mat?mat.getUVSetControl():null;
                    if(!uv)throw problem("GEO_WARDROBE_UV_CONTROL",shell.getLabel()+" / "+saved.name);
                    if(String(uv.getStringValue())!==saved.uv){
                        uv.setValueFromString(saved.uv);
                        if(String(uv.getStringValue())!==saved.uv)
                            throw problem("GEO_WARDROBE_UV_WRITE",shell.getLabel()+" / "+saved.name);
                    }
                }
                var after=materials(shell),afterMap={},afterPicked=[],afterOther=[];
                for(b=0;b<after.surfaces.length;b++){
                    var surface=after.surfaces[b];afterMap["$"+surface.name]=surface;
                    if(!picked["$"+surface.name])afterOther.push(surface);
                }
                if(!closeNumbers(beforeOther,afterOther))
                    throw problem("GEO_WARDROBE_UNRELATED_MATERIALS",shell.getLabel()+": native restore affected unrelated surfaces.");
                for(b=0;b<entry.surfaceNames.length;b++){
                    var selectedSurface=entry.surfaceNames[b];
                    if(!own(afterMap,"$"+selectedSurface))throw problem("GEO_WARDROBE_SURFACE_LOST",selectedSurface);
                    afterPicked.push(afterMap["$"+selectedSurface]);
                }
                var differences=geoWardrobeCheckRestored(entry.surfaces,afterPicked,entry.shellName);
                if(differences.length)throw problem("GEO_WARDROBE_MATERIAL_MISMATCH",
                    it.name+" / "+entry.shellName+": "+differences.join("; "));
                log("PASS","GEO_WARDROBE_RESTORED",it.name+" / "+entry.shellName+
                    " | surfaces="+entry.surfaceNames.join(", ")+" | native="+entry.nativePreset+
                    " | skippedShaderFieldsAtCapture="+entry.skipped);
                restored.push(index);count++;
            }
            // A deferred group remains linked to the exact stored manifest.
            // Consumed groups no longer reapply and cannot override later edits.
            if(remaining.length){
                if(remaining.length!==ptr.pending.length)
                    txData(inf.root,{GeoWardrobeSnapshot:jsonText({schemaVersion:1,path:ptr.path,pending:remaining})});
            }else unsetData(inf.root,"GeoWardrobeSnapshot");
        }
        if(!ctx.geoWardrobeTxn)ctx.geoWardrobeTxn={drafts:{},created:[],restored:0,stored:0};
        ctx.geoWardrobeTxn.restored+=count;
        log("INFO","GEO_WARDROBE_RESTORE_SUMMARY","restoredGroups="+count+" | deferredGroups="+waiting+
            " | Set material presets, where present, are applied afterward and take precedence.");
    }
    function geoCheckTransition(st,fig,plan,inv){
        if(["apply","partial_apply","undress_all","store_registered","bulk_move","remove_set"].indexOf(ctx.action)<0)return;
        var moved=geoImpactedPlan(st,fig,plan,inv),shells=geoShellsOnFigure(fig,true);
        if(!moved.length||!shells.length)return;
        if(!app.experimentalGeoShellRecovery)throw problem("GEO_SHELL_SAFETY",
            "Changing a GeoGraft can affect GeoShell materials. Enable GeoShell Material Recovery in Settings and use a saved scene copy.");
        log("WARN","GEO_SHELL_TOPOLOGY","Moving graft item(s): "+moved.join(", ")+
            " | GeoShells="+shells.length+" | native material backups required; scene COPY only.");
    }
    // v0.9.10.12: A DAZ material filter can drop an explicitly selected surface
    // from its DSON material_library. Never accept that omission as a complete
    // rollback preset. The first DUF is usable as a partial backup ONLY if every
    // emitted ID is unique and belongs to the requested shell material list.
    // Retry each missing native surface in its own preset; all segments must
    // pass exportProbeGeoShellMaterials' unchanged EXACT native coverage check.
    // This recovery is restricted to temporary transaction backups: immutable
    // Saved Set/Wardrobe references continue to require their own exact export.
    function geoNativeBackupCoverage(relative, requested) {
        validateNativeMaterialPresetRelative(relative);
        var path=inLibrary(relative);
        if(!readable(path))throw problem("GEO_BACKUP_READ", "Native backup file unreadable: "+path);
        var json;
        try{json=JSON.parse(readText(path).replace(/^\uFEFF/,""));}
        catch(parseError){throw problem("GEO_BACKUP_JSON", "Invalid native material backup: "+path+" | "+String(parseError));}
        if(!json.asset_info||!/material/i.test(String(json.asset_info.type))||!Array.isArray(json.material_library))
            throw problem("GEO_BACKUP_TYPE","Native backup has no material_library: "+path);
        var wanted={},got={},extra=[],repeated=[],absent=[],present=[];
        for(var i=0;i<requested.length;i++){
            var rn=String(requested[i]);
            if(!rn||own(wanted,"$"+rn))throw problem("GEO_BACKUP_DUPLICATE_REQUEST", "Non-unique surface name: "+rn);
            wanted["$"+rn]=true;
        }
        for(var j=0;j<json.material_library.length;j++){
            var row=json.material_library[j],name=row&&typeof row.id==="string"?row.id:"";
            if(!name)throw problem("GEO_BACKUP_ENTRY","Invalid native material_library entry in "+path);
            if(own(got,"$"+name))repeated.push(name);
            else {got["$"+name]=true;present.push(name);}
            if(!own(wanted,"$"+name))extra.push(name);
        }
        for(i=0;i<requested.length;i++)if(!own(got,"$"+requested[i]))absent.push(requested[i]);
        return {present:present,missing:absent,extra:extra,duplicate:repeated};
    }
    // v0.9.10.14: A DzMaterialAssetFilter DUF can exclude a surface which
    // still has genuine shader properties (Body on Breast Utilities 2 Shell).
    // DAZ's property-settings API is a second NATIVE serializer for temporary
    // transaction-only recovery. It records all exposed properties, including
    // images, rather than guessing individual shader setters/map APIs.
    function geoCapturePropertyBackup(shell,surfaceName,beforeSnapshot){
        var obj=shell.getObject(),shape=obj?obj.getCurrentShape():null,
            mat=shape?shape.findMaterial(surfaceName):null;
        if(!mat)throw problem("GEO_BACKUP_PROPERTY_MISSING",shell.getLabel()+" / "+surfaceName);
        var current=materials(shell),expected=null,currentRow=null;
        for(var i=0;i<beforeSnapshot.surfaces.length;i++)if(beforeSnapshot.surfaces[i].name===surfaceName)
            expected=beforeSnapshot.surfaces[i];
        for(i=0;i<current.surfaces.length;i++)if(current.surfaces[i].name===surfaceName)
            currentRow=current.surfaces[i];
        if(!expected||!currentRow||!closeNumbers(expected,currentRow))
            throw problem("GEO_BACKUP_PROPERTY_DRIFT",shell.getLabel()+" / "+surfaceName+
                ": material changed while preparing backup; no transfer performed.");
        // IncludeDefault is essential: a default valued property must still
        // be restorable if DAZ changes it when graft geometry is reattached.
        if(typeof DzProperty==="undefined"||typeof DzProperty.IncludeDefault!=="number"||
            typeof DzSettings!=="function")
            throw problem("GEO_BACKUP_PROPERTY_API","Native DzProperty/DzSettings full-value serializer is unavailable.");
        var flags=Number(DzProperty.IncludeDefault);
        if(typeof DzProperty.CurrentValue==="number")flags|=Number(DzProperty.CurrentValue);
        var native=mat.getPropertyList();
        if(!native||!native.length||native.length>512)
            throw problem("GEO_BACKUP_PROPERTY_LIST",shell.getLabel()+" / "+surfaceName+": invalid native property count.");
        var seen={},rows=[];
        for(var p=0;p<native.length;p++){
            var prop=native[p],propName=prop?String(prop.name||""):"";
            if(!prop||!propName||own(seen,"$"+propName)||
                typeof prop.addValueToSettings!=="function"||typeof prop.setValueFromSettings!=="function")
                throw problem("GEO_BACKUP_PROPERTY_UNSUPPORTED",shell.getLabel()+" / "+surfaceName+
                    ": non-unique or nonserializable property at index "+p+".");
            seen["$"+propName]=true;
            var saved=new DzSettings();
            try{prop.addValueToSettings(saved,flags);}catch(serializeError){
                throw problem("GEO_BACKUP_PROPERTY_SERIALIZE",surfaceName+" / "+propName+" | "+errorText(serializeError));
            }
            if(!saved.getNumValues())
                throw problem("GEO_BACKUP_PROPERTY_EMPTY",surfaceName+" / "+propName+
                    " | DAZ returned no native value; fallback backup is not complete.");
            rows.push({name:propName,settings:saved});
        }
        var finalRead=materials(shell),finalRow=null;
        for(i=0;i<finalRead.surfaces.length;i++)if(finalRead.surfaces[i].name===surfaceName)
            finalRow=finalRead.surfaces[i];
        if(!finalRow||!closeNumbers(expected,finalRow))
            throw problem("GEO_BACKUP_PROPERTY_DRIFT",shell.getLabel()+" / "+surfaceName+
                ": native property serializer changed visible values.");
        var classID=typeof mat.className==="function"?String(mat.className()):"";
        if(!classID)throw problem("GEO_BACKUP_PROPERTY_SHADER_UNKNOWN",shell.getLabel()+
            " / "+surfaceName+": DAZ shader class is not readable.");
        log("WARN","GEO_BACKUP_PROPERTY_CAPTURE",String(shell.getLabel())+
            " | surface="+surfaceName+" | nativeProperties="+rows.length+
            " | method=DzProperty settings | no lossy manual shader values");
        return {surface:surfaceName,expected:clonePlain(expected),shaderClass:classID,
            properties:rows,flags:flags};
    }
    function geoVerifyPropertyBackup(shell,part,phase){
        var obj=shell.getObject(),shape=obj?obj.getCurrentShape():null,
            mat=shape?shape.findMaterial(part.surface):null;
        if(!mat)throw problem("GEO_BACKUP_PROPERTY_MISSING",shell.getLabel()+" / "+part.surface+" at "+phase);
        var cls=typeof mat.className==="function"?String(mat.className()):"";
        if(cls!==part.shaderClass)throw problem("GEO_BACKUP_PROPERTY_SHADER_CHANGED",
            shell.getLabel()+" / "+part.surface+" | "+phase);
        var actual=null,now=materials(shell).surfaces;
        for(var i=0;i<now.length;i++)if(now[i].name===part.surface)actual=now[i];
        if(!actual||!closeNumbers(part.expected,actual))
            throw problem("GEO_BACKUP_PROPERTY_MISMATCH",shell.getLabel()+" / "+part.surface+
                " | "+phase+" | exposed material values/UV no longer match original.");
    }
    function geoRestorePropertyBackup(shell,part){
        // Import the native .duf segments first. Only use the fallback if the
        // previously-unexportable material changed in that transaction.
        try{geoVerifyPropertyBackup(shell,part,"ROLLBACK_UNCHANGED");return false;}
        catch(diff){if(diff.code!=="GEO_BACKUP_PROPERTY_MISMATCH")throw diff;}
        var obj=shell.getObject(),shape=obj?obj.getCurrentShape():null,
            mat=shape?shape.findMaterial(part.surface):null;
        if(!mat)throw problem("GEO_BACKUP_PROPERTY_MISSING",shell.getLabel()+" / "+part.surface);
        var cls=typeof mat.className==="function"?String(mat.className()):"";
        if(cls!==part.shaderClass)throw problem("GEO_BACKUP_PROPERTY_SHADER_CHANGED",
            shell.getLabel()+" / "+part.surface+"; cannot safely restore a different shader.");
        var props=mat.getPropertyList(),lookup={},i,serial;
        if(!props||props.length!==part.properties.length)
            throw problem("GEO_BACKUP_PROPERTY_STRUCTURE",shell.getLabel()+" / "+part.surface+
                ": native property count changed; refusing a partial property recovery.");
        for(i=0;i<props.length;i++){
            var pn=String(props[i].name||"");
            if(!pn||own(lookup,"$"+pn))throw problem("GEO_BACKUP_PROPERTY_STRUCTURE",part.surface);
            lookup["$"+pn]=props[i];
        }
        for(i=0;i<part.properties.length;i++){
            serial=part.properties[i];
            if(!own(lookup,"$"+serial.name))throw problem("GEO_BACKUP_PROPERTY_STRUCTURE",
                part.surface+" / "+serial.name+": property missing during rollback.");
        }
        // Restore only the missing native-preset surface. All other surfaces
        // are handled by their disjoint full native DUF segments.
        for(i=0;i<part.properties.length;i++){
            serial=part.properties[i];
            try{lookup["$"+serial.name].setValueFromSettings(serial.settings,part.flags);}
            catch(e){throw problem("GEO_BACKUP_PROPERTY_RESTORE",part.surface+" / "+serial.name+" | "+errorText(e));}
        }
        var uv=mat.getUVSetControl();
        if(!uv)throw problem("GEO_BACKUP_PROPERTY_UV",shell.getLabel()+" / "+part.surface);
        if(String(uv.getStringValue())!==part.expected.uv){
            if(uv.setValueFromString(part.expected.uv)===false)
                throw problem("GEO_BACKUP_PROPERTY_UV",shell.getLabel()+" / "+part.surface);
        }
        geoVerifyPropertyBackup(shell,part,"ROLLBACK_RESTORED");
        log("PASS","GEO_BACKUP_PROPERTY_RESTORED",shell.getLabel()+" / "+part.surface+
            " | restored="+part.properties.length+" native DzProperty values after rollback.");
        return true;
    }
    function geoVerifyUnexportableBackupSurfaces(phase){
        if(!ctx.geoMaterialTxn)return;
        var entries=ctx.geoMaterialTxn.records;
        for(var i=0;i<entries.length;i++){
            var rec=entries[i],parts=rec.propertyFallbacks||[];
            if(!parts.length)continue;
            var shell=live(rec.nodeKey);
            if(!shell)throw problem("GEO_BACKUP_PROPERTY_SHELL_GONE",rec.nodeKey);
            for(var j=0;j<parts.length;j++){
                geoVerifyPropertyBackup(shell,parts[j],phase);
                log("PASS","GEO_BACKUP_PROPERTY_UNCHANGED",shell.getLabel()+" / "+parts[j].surface+
                    " | phase="+phase+" | unrelated existing shader state protected.");
            }
        }
    }
    function geoExportCompleteShellBackup(shell,names,serial,beforeSnapshot) {
        var primary="Materials/"+unique("geo_before")+".duf",presets=[primary],coverage=null,firstError=null;
        try{
            exportProbeGeoShellMaterials(shell,names,"before_"+serial,primary,true);
            var complete=geoNativeBackupCoverage(primary,names);
            if(complete.missing.length||complete.extra.length||complete.duplicate.length)
                throw problem("GEO_BACKUP_UNSAFE_CONTENT",String(shell.getLabel())+
                    " | exact native backup contains missing, unexpected or duplicated IDs: "+primary);
            return {presets:presets,propertyFallbacks:[]};
        }catch(e){
            if(e.code!=="GEO_PROBE_UNSAFE_SELECTION")throw e;
            firstError=e;
        }
        coverage=geoNativeBackupCoverage(primary,names);
        if(coverage.extra.length||coverage.duplicate.length||!coverage.present.length)
            throw problem("GEO_BACKUP_UNSAFE_CONTENT",String(shell.getLabel())+
                " | native backup has extraneous/duplicate/no surface IDs; original error="+errorText(firstError)+
                " | extra="+coverage.extra.join(", ")+" | duplicate="+coverage.duplicate.join(", ")+
                " | file="+inLibrary(primary));
        if(!coverage.missing.length)throw problem("GEO_BACKUP_UNSAFE_CONTENT",
            String(shell.getLabel())+" | native export reported a mismatch but no missing surfaces were identified: "+inLibrary(primary));
        if(coverage.missing.length>16)throw problem("GEO_BACKUP_TOO_MANY_MISSING",
            String(shell.getLabel())+" | native exporter omitted "+coverage.missing.length+
            " surfaces; refusing a large series of single-surface backups. "+inLibrary(primary));
        log("WARN","GEO_BACKUP_SPLIT_REQUIRED",String(shell.getLabel())+
            " | initiallyExported="+coverage.present.length+
            " | missing="+coverage.missing.join(", ")+" | primary="+primary+
            " | original exact coverage not bypassed");
        var fallback=[],discarded=[];
        for(var mi=0;mi<coverage.missing.length;mi++){
            var missing=coverage.missing[mi],supplement="Materials/"+unique("geo_before_split")+".duf";
            var propertyCount="unavailable",uvState="unavailable";
            try{
                var obj=shell.getObject(),shape=obj?obj.getCurrentShape():null,
                    mat=shape?shape.findMaterial(missing):null;
                if(mat){
                    var propertyList=mat.getPropertyList();
                    propertyCount=propertyList?String(propertyList.length):"none";
                    var uv=mat.getUVSetControl();
                    uvState=uv?String(uv.getStringValue()):"no UV control";
                }
            }catch(missingDiagnosticError){propertyCount="read error: "+errorText(missingDiagnosticError);}
            log("INFO","GEO_BACKUP_MISSING_SURFACE_DIAGNOSTIC",String(shell.getLabel())+
                " | missing="+missing+" | nativeProperties="+propertyCount+" | UV="+uvState);
            try{exportProbeGeoShellMaterials(shell,[missing],"before_"+serial+"_split_"+mi,supplement);}
            catch(splitError){
                // Only the documented "no material_library" outcome for an
                // actually-present surface is eligible. Other native errors
                // remain strict preflight failures; nothing is transferred.
                if(splitError.code!=="GEO_PROBE_DSON")
                    throw problem("GEO_BACKUP_SURFACE_UNEXPORTABLE",String(shell.getLabel())+
                        " | cannot save surface '"+missing+"'. Native export error: "+errorText(splitError)+
                        ". Inspect "+inLibrary(primary)+" and "+inLibrary(supplement));
                var propFallback=geoCapturePropertyBackup(shell,missing,beforeSnapshot);
                fallback.push(propFallback);discarded.push(supplement);
                log("WARN","GEO_BACKUP_NATIVE_PROPERTY_FALLBACK",shell.getLabel()+" / "+missing+
                    " | native filter omitted surface; backed up all "+propFallback.properties.length+
                    " properties with DAZ's DzSettings API. Restored on rollback only when changed. "+
                    "Never counted as a DSON material_library segment.");
                continue;
            }
            presets.push(supplement);
            log("PASS","GEO_BACKUP_SPLIT_SURFACE",String(shell.getLabel())+
                " | surface="+missing+" | preset="+supplement);
        }
        // Exact coverage accounting across native DSON segments AND the
        // separate property-based fallbacks. No duplicate/overlapping ownership.
        var combined={},count=0;
        for(var pi=0;pi<presets.length;pi++){
            var part=geoNativeBackupCoverage(presets[pi],names);
            if(part.extra.length||part.duplicate.length)
                throw problem("GEO_BACKUP_SPLIT_CONTENT",String(shell.getLabel())+
                    " | extra or duplicate DSON entries in "+presets[pi]);
            for(var si=0;si<part.present.length;si++){
                var k="$"+part.present[si];
                if(own(combined,k))throw problem("GEO_BACKUP_SPLIT_OVERLAP",
                    String(shell.getLabel())+" | surface repeated across backups: "+part.present[si]);
                combined[k]=true;count++;
            }
        }
        for(var fi=0;fi<fallback.length;fi++){
            var fallbackName=fallback[fi].surface;
            if(own(combined,"$"+fallbackName))throw problem("GEO_BACKUP_SPLIT_OVERLAP",
                shell.getLabel()+" | fallback and native segments repeat "+fallbackName);
            combined["$"+fallbackName]=true;count++;
        }
        if(count!==names.length)throw problem("GEO_BACKUP_SPLIT_INCOMPLETE",
            String(shell.getLabel())+" | requested="+names.length+" | protected="+count);
        for(var ni=0;ni<names.length;ni++)if(!own(combined,"$"+names[ni]))
            throw problem("GEO_BACKUP_SPLIT_INCOMPLETE",String(shell.getLabel())+" | missing="+names[ni]);
        log("PASS","GEO_BACKUP_SPLIT_COMPLETE",String(shell.getLabel())+
            " | protectedSurfaces="+count+" | nativePresets="+presets.length+
            " | nativePropertyFallbacks="+fallback.length+
            " | complete protection required before transfer");
        return {presets:presets,propertyFallbacks:fallback,discardedNativePaths:discarded};
    }
    function captureUndoShellMaterials(shells){
        var token=profileBegin("geo_undo_snapshot");
        try{return captureUndoShellMaterialsImpl(shells);}finally{profileEnd(token);}
    }
    function captureUndoShellMaterialsImpl(shells){
        var records=[],flags=Number(DzProperty.IncludeDefault)|Number(DzProperty.CurrentValue),settings=new DzSettings(),attrs=new DzPropertySettings();
        for(var i=0;i<shells.length;i++){
            var shell=shells[i],shape=shell.getObject().getCurrentShape(),row={elementID:Number(shell.elementID),surfaces:[]};
            for(var j=0;j<shape.getNumMaterials();j++){
                var mat=shape.getMaterial(j),uv=mat.getUVSetControl(),surface={name:String(mat.getName()),shaderClass:String(mat.className()),uv:uv?String(uv.getStringValue()):"",properties:[]},props=mat.getPropertyList();
                for(var k=0;k<props.length;k++){
                    settings.clear();props[k].addValueToSettings(settings,flags);
                    if(!settings.getNumValues())throw problem("GEO_UNDO_PROPERTY","Cannot serialize "+String(props[k].name));
                    attrs.clear();props[k].getAttributes(attrs);
                    surface.properties.push({name:String(props[k].name),settings:String(settings.toJsonString()),attributes:String(attrs.toJsonString())});
                }
                row.surfaces.push(surface);
            }
            records.push(row);
        }
        return records;
    }
    function prepareGeoMaterialUndo(){
        var fig=ctx.target,name="matewWardrobeMaterialUndo_v1",list=fig.getPrivatePropertyList(),marker=null;
        for(var i=0;i<list.length;i++)if(String(list[i].name)===name)marker=list[i];
        var path=resourcePath("Wearable Manager Undo Materials.dsa");if(!readable(path))throw problem("GEO_UNDO_SCRIPT",path);
        var mgr=App.getCallBackMgr(),callbackName="Wearable Manager Materials "+key(fig),callback=mgr.getCallBack(callbackName);
        if(callback)callback.setDynamicProperty("busy",true);
        UndoStack.lock();try{
            if(!marker){marker=new DzStringProperty(name,false);marker.setHidden(true);fig.addPrivateProperty(marker);}
            marker.setValue(JSON.stringify({operation:ctx.id,phase:"before",records:ctx.geoUndoBefore}));
        }finally{UndoStack.unlock();}
        if(!callback){
            callback=mgr.createCallBack(callbackName,path,false);callback.setDynamicProperty("busy",true);
            callback.setProcessAsEvent(true);callback.setBlockedDuringSceneLoad(false);
            if(!callback.setConnection(marker,"currentValueChanged()",true))throw problem("GEO_UNDO_CONNECTION","Material Undo callback unavailable.");
        }
        ctx.geoUndoMarker=marker;ctx.geoUndoCallback=callback;
    }
    function commitGeoMaterialUndo(){
        if(!ctx.geoUndoMarker)return;
        var keys=Object.keys(ctx.geoMaterialTxn.figures),shells=[],seen={};
        for(var i=0;i<keys.length;i++){
            var fig=live(keys[i]);if(!fig)continue;var group=geoShellsOnFigure(fig,true);
            for(var j=0;j<group.length;j++)if(!seen[key(group[j])]){seen[key(group[j])]=true;shells.push(group[j]);}
        }
        ctx.geoUndoMarker.setValue(JSON.stringify({operation:ctx.id,phase:"after",records:captureUndoShellMaterials(shells)}));
        log("PASS","GEO_UNDO_READY","Native material snapshots retained with Undo history; shells="+shells.length);
    }
    function geoPrepareShellBackups(fig,force){
        if(["apply","partial_apply","undress_all","store_registered","return_registered","unregister_registered","bulk_move","remove_set"].indexOf(ctx.action)<0||!app.experimentalGeoShellRecovery)return;
        if(!ctx.geoMaterialTxn)ctx.geoMaterialTxn={figures:{},records:[],allowed:{},attempted:false};
        var fk=key(fig);if(ctx.geoMaterialTxn.figures[fk])return;
        // Include stored shells in rollback backups because DAZ may keep a
        // graft target reference even while their node lives in the wardrobe.
        var shells=geoShellsOnFigure(fig,true);
        ctx.geoMaterialTxn.figures[fk]=true;
        ctx.geoUndoBefore=(ctx.geoUndoBefore||[]).concat(captureUndoShellMaterials(shells));
        prepareGeoMaterialUndo();
        for(var i=0;i<shells.length;i++){
            var shell=shells[i],snap=materials(shell),names=[];
            for(var j=0;j<snap.surfaces.length;j++)names.push(snap.surfaces[j].name);
            if(!names.length)continue;
            var complete=geoExportCompleteShellBackup(shell,names,i,snap),nativePresets=complete.presets;
            var record={nodeKey:key(shell),figureKey:fk,preset:nativePresets[0],
                presets:nativePresets,propertyFallbacks:complete.propertyFallbacks,
                discardedNativePaths:complete.discardedNativePaths||[],
                before:snap,wasRestored:false};
            ctx.geoMaterialTxn.records.push(record);
            ctx.geoMaterialTxn.allowed[record.nodeKey]=true;
            log("PASS","GEO_APPLY_BACKUP",String(shell.getLabel())+
                " | surfaces="+names.length+" | presets="+nativePresets.join(", ")+
                " | propertyFallbacks="+(complete.propertyFallbacks||[]).length);
        }
    }
    function geoImportToShell(shell,relative){
        validateNativeMaterialPresetRelative(relative);
        if(!readable(inLibrary(relative)))throw problem("GEO_RESTORE_PRESET_MISSING",relative);
        var content=App.getContentMgr(),held=false;
        if(!content||typeof content.openFile!=="function")throw problem("GEO_RESTORE_LOADER","Native content loader missing.");
        try{
            beginNodeSelectionHold();held=true;Scene.selectAllNodes(false);Scene.setPrimarySelection(shell);
            var ok=content.openFile(inLibrary(relative),true);
            if(ok!==true)throw problem("GEO_RESTORE_LOAD",relative+" | result="+String(ok));
        }finally{if(held)restoreNodeSelectionHold();}
        try{Scene.update();}catch(ignoreUpdate){}
    }
    function geoFindTargetShell(fig,rec){
        var shells=geoShellsOnFigure(fig),hits=[],i,identity;
        for(i=0;i<shells.length;i++){
            identity=geoSetShellIdentity(shells[i]);
            // A shell with a different asset type must never receive an
            // existing shell's materials just because surface names match.
            if(identity.name!==rec.shellName)continue;
            if(rec.shellAssetId&&identity.assetId&&identity.assetId!==rec.shellAssetId)continue;
            hits.push(shells[i]);
        }
        if(hits.length>1)throw problem("GEO_RESTORE_AMBIGUOUS_SHELL",
            "More than one target GeoShell matches "+rec.shellName+". No materials applied.");
        return hits.length?hits[0]:null;
    }
    function geoRestoreSavedSet(st,fig){
        if(!app.experimentalGeoShellRecovery||(ctx.action!=="apply"&&ctx.action!=="partial_apply")||
            !st.geoShellSnapshots||!st.geoShellSnapshots.length)return;
        if(!ctx.geoMaterialTxn)geoPrepareShellBackups(fig,true);
        var inv=inventory(fig,app.db),count=0,skipped=0,loadedFull={};
        for(var i=0;i<st.geoShellSnapshots.length;i++){
            var rec=st.geoShellSnapshots[i],graft=inv[rec.graftItemID];
            if(!graft||graft.where!=="active"){
                log("INFO","GEO_RESTORE_GRAFT_ABSENT","Skipped surfaces of a GeoGraft not worn on the target figure: "+rec.graftItemID);continue;
            }
            var shell=geoFindTargetShell(fig,rec);
            if(!shell){skipped++;log("INFO","GEO_RESTORE_SHELL_ABSENT",rec.shellName+" | no compatible existing target shell; no new shell created.");continue;}
            var before=materials(shell),names={},actual={};
            for(var b=0;b<before.surfaces.length;b++)actual[before.surfaces[b].name]=true;
            for(var r=0;r<rec.surfaceNames.length;r++){
                var name=rec.surfaceNames[r];names[name]=true;
                if(!actual[name])throw problem("GEO_RESTORE_SURFACE_MISSING",rec.shellName+" / "+name+
                    ": graft is worn but its dependent shell surface was not recreated. Do not overwrite the saved scene.");
            }
            // A registered shell is itself part of the outfit; restoring
            // all its materials is intended. Reuse its existing full preset
            // exactly once even when several grafts reference that shell.
            var fullKey=key(shell)+"|"+rec.nativePreset,shouldLoad=rec.mode!=="registered_full"||!loadedFull[fullKey];
            if(shouldLoad){
                ctx.geoMaterialTxn.attempted=true;
                geoImportToShell(shell,rec.nativePreset);
                if(rec.mode==="registered_full")loadedFull[fullKey]=true;
            }
            if(rec.mode==="registered_full")log("INFO","GEO_RESTORE_SHARED_PRESET",
                rec.shellName+" | reused full registered material snapshot | loaded="+shouldLoad);
            var after=materials(shell),afterNames={};
            for(var a=0;a<after.surfaces.length;a++)afterNames[after.surfaces[a].name]=after.surfaces[a];
            for(r=0;r<rec.surfaceNames.length;r++)if(!afterNames[rec.surfaceNames[r]])
                throw problem("GEO_RESTORE_SURFACE_LOST",rec.shellName+" / "+rec.surfaceNames[r]);
            // Apply the DAZ-tested UV correction ONLY for saved graft-added
            // surfaces. v0.9.10.4 baselines without surfaceUVs use DUF only.
            var uvSaved=rec.surfaceUVs||{},shape=shell.getObject().getCurrentShape();
            if(!rec.surfaceUVs&&rec.mode==="registered_full"){
                // v0.9.10.4 already stored the UVs in the registered
                // shell's full material JSON; no baseline recapture needed.
                var full=st.materialSnapshots&&st.materialSnapshots[rec.shellItemID];
                if(full)for(var fp=0;fp<full.parts.length;fp++){
                    var oldSurfaces=full.parts[fp].snapshot.surfaces;
                    for(var fs=0;fs<oldSurfaces.length;fs++)if(rec.surfaceNames.indexOf(oldSurfaces[fs].name)>=0)
                        uvSaved[oldSurfaces[fs].name]=oldSurfaces[fs].uv;
                }
            }
            if(!Object.keys(uvSaved).length)log("WARN","GEO_RESTORE_LEGACY_UV",
                rec.shellName+" | baseline has no explicit UV values; relying on native DUF.");
            for(r=0;r<rec.surfaceNames.length;r++){
                name=rec.surfaceNames[r];if(!Object.prototype.hasOwnProperty.call(uvSaved,name))continue;
                var mat=shape.findMaterial(name),ctrl=mat?mat.getUVSetControl():null;
                if(!ctrl)throw problem("GEO_RESTORE_UV_CONTROL",rec.shellName+" / "+name);
                if(String(ctrl.getStringValue())!==String(uvSaved[name])){
                    ctrl.setValueFromString(String(uvSaved[name]));
                    if(String(ctrl.getStringValue())!==String(uvSaved[name]))
                        throw problem("GEO_RESTORE_UV_FAILED",rec.shellName+" / "+name);
                }
            }
            if(rec.mode==="partial"){
                var unrelatedBefore=before.surfaces.filter(function(m){return !names[m.name];});
                var unrelatedAfter=materials(shell).surfaces.filter(function(m){return !names[m.name];});
                if(!closeNumbers(unrelatedBefore,unrelatedAfter))
                    throw problem("GEO_RESTORE_OTHER_SURFACES",rec.shellName+": unrelated readable shell material values changed.");
            }
            count++;
            log("PASS","GEO_SET_RESTORED",rec.shellName+" | graft="+rec.graftItemID+
                " | restoredSurfaces="+rec.surfaceNames.join(", ")+" | preset="+rec.nativePreset);
        }
        ctx.geoMaterialsRestored=count;
        log("INFO","GEO_RESTORE_SUMMARY","restored="+count+" | missing target shells="+skipped+
            " | some shader values cannot be verified by DAZ scripting.");
    }
    function geoRollbackMaterialBackups(errors){
        if(!ctx||!ctx.geoMaterialTxn)return;
        var records=ctx.geoMaterialTxn.records,tx=ctx.transferTxn,verifyOnly=false;
        if(tx&&!ctx.geoMaterialTxn.attempted&&ctx.loadCalls===0){
            verifyOnly=true;var txIDs=Object.keys(tx.records);
            for(var txi=0;txi<txIDs.length;txi++)if(tx.records[txIDs[txi]].touched)verifyOnly=false;
        }
        for(var i=records.length-1;i>=0;i--){
            var rec=records[i],shell=live(rec.nodeKey);
            if(!shell){errors.push("Original GeoShell disappeared: "+rec.nodeKey);continue;}
            try{
                var segments=rec.presets&&rec.presets.length?rec.presets:[rec.preset];
                if(verifyOnly){
                    // A failed preflight with no transfers must never import
                    // materials merely because earlier backups succeeded.
                    if(!closeNumbers(rec.before,materials(shell)))
                        throw problem("GEO_PRE_TRANSFER_MATERIAL_DRIFT",shell.getLabel());
                    var passive=rec.propertyFallbacks||[];
                    for(var pf=0;pf<passive.length;pf++)geoVerifyPropertyBackup(shell,passive[pf],"PREFLIGHT_ABORT");
                    log("PASS","GEO_ROLLBACK_MATERIALS_NOOP",shell.getLabel()+
                        " | verified unchanged; no native material writes during preflight abort.");
                    continue;
                }
                // A split backup is atomic at the verification boundary:
                // restore every disjoint native surface segment and ONLY THEN
                // compare the complete pre-operation material snapshot.
                for(var seg=0;seg<segments.length;seg++)geoImportToShell(shell,segments[seg]);
                // Native DUFs cover disjoint surfaces. Restore missing native
                // export surfaces from their full DAZ property-settings backup.
                // No fallback shader mutation unless a real difference exists.
                var fallbacks=rec.propertyFallbacks||[];
                for(var f=0;f<fallbacks.length;f++)geoRestorePropertyBackup(shell,fallbacks[f]);
                var after=materials(shell);
                // Surface topology must be restored first by the wardrobe
                // rollback. Readable fields are checked after native import.
                if(!closeNumbers(rec.before,after))throw problem("GEO_ROLLBACK_MISMATCH",String(shell.getLabel()));
                log("PASS","GEO_ROLLBACK_MATERIALS",String(shell.getLabel())+
                    " | nativeSegments="+segments.join(", "));
            }catch(e){errors.push("GeoShell "+String(shell.getLabel())+": "+errorText(e)+
                "; backups="+(rec.presets&&rec.presets.length?rec.presets:[rec.preset]).map(function(p){return inLibrary(p);}).join(", "));}
        }
    }
    function geoCleanupBackupsOnSuccess(){
        if(!ctx||!ctx.geoMaterialTxn)return;
        var list=ctx.geoMaterialTxn.records;
        for(var i=0;i<list.length;i++){
            var segments=list[i].presets&&list[i].presets.length?list[i].presets:[list[i].preset];
            // A known-empty native split attempt was replaced by a complete
            // in-memory DzSettings backup; delete its temporary unusable DUF
            // on successful commit, but retain it after a failed operation.
            segments=segments.concat(list[i].discardedNativePaths||[]);
            for(var p=0;p<segments.length;p++)try{
                cleanupTemporaryMaterialPreset(segments[p]);
            }catch(e){log("WARN","GEO_BACKUP_CLEANUP",errorText(e)+" | "+segments[p]);}
        }
    }

    function saveSet(spec, fig) {
        var token = profileBegin("save_set");
        try { return saveSetImpl(spec, fig); }
        finally { profileEnd(token); }
    }
    function handPosesForSave(spec, old, fig) {
        var poses={}, sides=["right","left"];
        for(var i=0;i<sides.length;i++){
            var side=sides[i];
            if(spec[side+"HandPose"]!==true)continue;
            // Editing names, membership or materials must not silently replace
            // a saved pose with the unrelated pose currently on the figure.
            if(old&&old.handPoses&&old.handPoses[side]&&spec[side+"HandPoseRecapture"]!==true)
                poses[side]=clonePlain(old.handPoses[side]);
            else poses[side]=captureHandPose(fig,side);
        }
        return validateHandPoses(poses);
    }
    function saveSetImpl(spec, fig) {
        validateEditorIconSpec(spec);
        assertNoPending(fig); inventory(fig, app.db);
        if (spec.baseCommit && spec.baseCommit !== app.db.commitID) throw problem("EDITOR_STALE", "The catalog changed after this editor opened. Reopen the set before saving; no stale edit was applied.");
        var originalFile = app.catalogFile, next = clonePlain(app.db), old = spec.id ? next.sets[spec.id] : null;
        if (spec.id && !old) throw problem("SET_MISSING", spec.id);
        if (!trim(spec.name)) throw problem("SET_NAME", "Enter a set name.");
        if (old && old.figureType !== String(fig.objectName)) throw problem("FIGURE_TYPE", "Edit this set using its original Genesis type.");
        // Validate group assignment before registering items or changing scene metadata.
        var selectedGroup=resolveSetGroupForSave(spec,old,next);
        var can = candidates(fig), canKeys = can.map(function(n){return key(n);}), chosen = spec.nodes || [], seen = {}, memberIDs = spec.items.slice(0), owner, nodeItemMap={};
        for (var z = 0; z < memberIDs.length; z++) {
            if (!own(next.items,memberIDs[z]) || next.items[memberIDs[z]].figureType !== String(fig.objectName)) throw problem("MEMBER_MISSING", memberIDs[z]);
            seen[memberIDs[z]] = true;
        }
        if (!memberIDs.length && !chosen.length) throw problem("EMPTY_SET", "Choose at least one item.");
        // Revalidate dialog node handles before tagging anything.
        for (var c = 0; c < chosen.length; c++) if (canKeys.indexOf(chosen[c]) < 0 || !live(chosen[c])) throw problem("EDITOR_SOURCE_CHANGED", "A chosen wearable is no longer on the selected figure.");
        observe([key(fig)].concat(chosen), "SAVE_SET_PRE", true);
        ctx.rollbackPose = poseRecord(fig);
        owner = figureIdentity(fig,true);
        for (var i = 0; i < chosen.length; i++) {
            var id = registerItem(live(chosen[i]),fig,next);nodeItemMap[String(chosen[i])]=id;
            if (!own(seen,id)) { memberIDs.push(id); seen[id]=true; }
        }
        var scope = {kind:spec.scope};
        if (spec.scope === "figure") scope.figureID = old && old.scope.kind === "figure" && !spec.rebindFigure ? old.scope.figureID : owner;
        else if (spec.scope === "label") { scope.label=figureIconBaseLabel(trim(spec.scopeLabel)); if (!scope.label) throw problem("SCOPE_LABEL","Enter a figure label."); }
        else if (spec.scope !== "type") throw problem("SCOPE","Unsupported scope.");
        var normalizedProperties=normalizeEditorPropertyOverrides(spec.properties||[],fig,next,memberIDs,nodeItemMap);
        var handPoses=handPosesForSave(spec,old,fig);
        // Material capture never modifies scene materials. Unchecked items have no
        // set-level snapshot, and removal of a set member removes its snapshot.
        // The storage group contains REAL scene instances, not unloaded assets.
        // Capture native shader state from either active or stored registered
        // items; do not move/fit/enable a stored garment merely to read it.
        var setID=old?old.id:unique("set");
        var wanted=spec.materialRequests||[],wantedIDs={},materialSnapshots={},newInv=null,nativeUnconfirmed=[];
        if(!Array.isArray(wanted))throw problem("MATERIAL_REQUEST","Invalid Save Materials selection.");
        for(var mr=0;mr<wanted.length;mr++){
            var request=wanted[mr],mid=String(request.itemID||"");
            if(!mid&&request.nodeKey)mid=String(nodeItemMap[String(request.nodeKey)]||"");
            if(!mid||memberIDs.indexOf(mid)<0||own(wantedIDs,mid))
                throw problem("MATERIAL_REQUEST","Invalid or duplicate material item selection.");
            wantedIDs[mid]=true;
        }
        newInv=inventory(fig,next);
        var registeredGrafts=geoSetGraftInfo(fig,newInv,memberIDs);
        var graftIDs={};for(var gg=0;gg<registeredGrafts.length;gg++)graftIDs[registeredGrafts[gg].id]=true;
        for(var gid in graftIDs)if(own(graftIDs,gid))wantedIDs[gid]=true;
        // An old GeoShell full preset shared with a GeoGraft must stay in
        // the Set's material snapshot collection even when the user edits
        // the Set while its GeoGraft is currently stored.
        var oldGeo=old&&old.geoShellSnapshots?old.geoShellSnapshots:[];
        for(var oi=0;oi<oldGeo.length;oi++)if(oldGeo[oi].mode==="registered_full"&&
                memberIDs.indexOf(oldGeo[oi].shellItemID)>=0)
            wantedIDs[oldGeo[oi].shellItemID]=true;
        // A GeoShell explicitly included in the same set shares its existing
        // full native Material Preset rather than duplicating graft subpresets.
        if(registeredGrafts.length){
            var allNodes=sceneNodes();
            for(var gn=0;gn<allNodes.length;gn++){
                var shellNode=allNodes[gn];if(!shellNode||!shellNode.inherits("DzGeometryShellNode"))continue;
                var target=null;try{target=shellNode.getTarget();}catch(ignoreTarget){}
                if(!target||!same(target,fig))continue;
                for(var mm=0;mm<memberIDs.length;mm++){
                    var m=memberIDs[mm];if(newInv[m]&&newInv[m].root&&same(newInv[m].root,shellNode))wantedIDs[m]=true;
                }
            }
        }
        for(var mi=0;mi<memberIDs.length;mi++){
            var materialID=memberIDs[mi];if(!own(wantedIDs,materialID))continue;
            var matItem=next.items[materialID],where=newInv[materialID];
            // A stored donor GeoGraft has no graft-derived surfaces on an
            // otherwise worn GeoShell. Re-exporting that shell would truncate
            // its old complete Set baseline. Preserve only in THIS case;
            // attached donors are recaptured as a consistent JSON+DUF pair.
            var preserveStoredDonor=false;
            for(var og=0;og<oldGeo.length;og++)if(oldGeo[og].mode==="registered_full"&&
                    oldGeo[og].shellItemID===materialID&&memberIDs.indexOf(oldGeo[og].graftItemID)>=0&&
                    !own(graftIDs,oldGeo[og].graftItemID))preserveStoredDonor=true;
            if(preserveStoredDonor&&old&&old.materialSnapshots&&
                    own(old.materialSnapshots,materialID)&&old.materialSnapshots[materialID].nativePreset){
                materialSnapshots[materialID]=clonePlain(old.materialSnapshots[materialID]);
                log("WARN","GEO_SET_MATERIAL_REFRESH_DEFERRED",matItem.name+
                    " | one or more saved donor GeoGrafts are not attached. Old complete JSON and DUF retained; " +
                    "wear the donor graft and edit/save this Set to refresh added surfaces.");
                continue;
            }
            if(where&&(where.where==="active"||where.where==="stored")&&where.root&&where.parts){
                if(where.where==="stored")log("INFO","MATERIAL_CAPTURE_STORED",matItem.name+
                    " | Capturing shader state directly from registered storage, without wearing or moving it.");
                var materialRecord=captureItemMaterials(matItem,where).record;
                var verifiedNative="";
                try{verifiedNative=saveNativeMaterialPreset(matItem,where,materialRecord,true);}
                catch(nativeExportError){
                    // Some DAZ versions cannot export a native preset from a
                    // hidden storage-group member. Preserve the JSON baseline,
                    // but never link an unverified DUF for automatic Restore.
                    if(where.where!=="stored")throw nativeExportError;
                    log("WARN","MATERIAL_STORED_NATIVE_UNAVAILABLE",matItem.name+
                        " | Saved JSON snapshot; native preset export from storage unavailable: "+errorText(nativeExportError));
                }
                if(verifiedNative){
                    geoVerifySetShellPresetCoverage(matItem,where,materialRecord,verifiedNative,"SET_SAVE");
                    materialRecord.nativePreset=verifiedNative;
                }
                else if(graftIDs[materialID])throw problem("GEO_SET_GRAFT_MATERIALS",
                    "A GeoGraft requires a verified native material preset: "+matItem.name);
                else nativeUnconfirmed.push(matItem.name);
                materialSnapshots[materialID]=materialRecord;
            }else if(old&&old.materialSnapshots&&own(old.materialSnapshots,materialID)){
                materialSnapshots[materialID]=clonePlain(old.materialSnapshots[materialID]);
            }else throw problem("MATERIAL_CAPTURE_UNAVAILABLE",matItem.name+
                " has no valid registered scene instance from which to capture materials. "+
                "Keep an existing saved snapshot, or load the garment before first capture.");
        }
        var geoShellSnapshots=captureGeoShellSetBaselines(fig,memberIDs,newInv,old,materialSnapshots);
        var partStates=captureSetPartStates(memberIDs,newInv,old,next);
        var st = {id:setID,name:trim(spec.name),figureType:String(fig.objectName),scope:scope,groupID:selectedGroup,
            replaceWithinGroup:spec.replaceWithinGroup===true,items:memberIDs,properties:normalizedProperties,partStates:partStates,materialSnapshots:materialSnapshots,
            geoShellSnapshots:geoShellSnapshots,handPoses:handPoses,
            icon:old ? old.icon||"" : "",created:old ? old.created : String(new Date()),modified:String(new Date())};
        if (spec.clearIcon) st.icon=""; if (spec.iconPath) st.icon=importIcon(spec.iconPath);
        if (spec.builtinIcon) st.icon=saveBuiltinIcon(spec.builtinIcon);
        next.sets[st.id]=st;
        commitCatalog(next,originalFile); ctx.catalogCommitted=true;
        log("PASS","SET_SAVED",st.name+" | members="+st.items.length+" | propertyOverrides="+st.properties.length+
            " | partStates="+partStateEntries(st).length+" | materialSnapshots="+Object.keys(st.materialSnapshots).length+
            " | geoShellSnapshots="+st.geoShellSnapshots.length+
            " | nativePresets="+Object.keys(st.materialSnapshots).filter(function(id){return !!st.materialSnapshots[id].nativePreset;}).length+
            " | revision="+app.db.revision);
        ctx.outcome="Saved "+st.name+". Items stay where they are. Save the scene to keep registration metadata."+
            (nativeUnconfirmed.length?" Material JSON snapshots were saved, but native Material Restore is unavailable for: "+
                nativeUnconfirmed.join(", ")+". See report for unlinked diagnostic DUFs.":"");
    }
    function duplicateSet(id,fig) {
        var src=app.db.sets[id];if(!src)throw problem("SET_MISSING",id);
        if(src.figureType!==String(fig.objectName)||scopeProblem(src,fig))
            throw problem("DUPLICATE_SCOPE","Select the compatible figure before duplicating the set.");
        var next=clonePlain(app.db),st=clonePlain(src),newID=unique("set"),name=src.name+" Copy",number=2;
        var nameUsed=function(n){var all=Object.keys(next.sets);for(var i=0;i<all.length;i++)
            if(next.sets[all[i]].name===n&&next.sets[all[i]].figureType===src.figureType)return true;
            return false;};
        while(nameUsed(name)){name=src.name+" Copy ("+(number++)+")";}
        // A distinct set definition, not a new wearable or .duf. All itemIDs,
        // Property Overrides, optional set-level material snapshots, scope and
        // icon relative path, and cosmetic groupID remain unchanged.
        st.id=newID;st.name=name;st.items=src.items.slice(0);
        st.properties=clonePlain(setPropertyOverrides(src));st.scope=clonePlain(src.scope);
        st.icon=String(src.icon||"");st.created=String(new Date());st.modified=st.created;
        next.sets[newID]=st;commitCatalog(next,app.catalogFile);ctx.catalogCommitted=true;
        ctx.diag.duplicateSetID=newID;
        log("PASS","SET_DUPLICATED",src.name+" => "+st.name+" | shared itemIDs="+st.items.length+" | newSetID="+newID);
        ctx.outcome="Duplicated "+src.name+" as "+st.name+". No clothes or DUF presets were copied.";
    }
    function deleteSet(id) {
        var next=clonePlain(app.db), st=next.sets[id]; if (!st) throw problem("SET_MISSING",id);
        delete next.sets[id]; commitCatalog(next,app.catalogFile); ctx.catalogCommitted=true;
        log("PASS","SET_DELETED",st.name+": only the set definition was removed. Scene items, shared presets and older catalog revisions remain.");
        ctx.outcome="Deleted set: "+st.name+". No clothing or item files were deleted.";
    }
    function inspectWardrobe(fig) {
        var token = profileBegin("inspect");
        try { return withReadScope(function () { return inspectWardrobeImpl(fig); }, false); }
        finally { profileEnd(token); }
    }
    function inspectWardrobeImpl(fig) {
        var inv=inventory(fig,app.db), ids=Object.keys(inv); assertNoPending(fig);
        log("INFO","FIGURE_ID",figureIdentity(fig,false)||"Not registered yet");
        for(var i=0;i<ids.length;i++) {
            var it=app.db.items[ids[i]], inf=inv[ids[i]];
            if(inf.where==="stored") validateRecovery(it,inf,fig,null,true); else nativeLinkCheck(it,inf,fig);
            log("PASS","INVENTORY",it.name+" | "+inf.where+" | instance="+inf.instanceID+" | rootNode="+inf.rootID+" | preset="+(readable(inLibrary(it.preset))?"present":"missing (scene reuse still possible)"));
        }
        var active = ids.filter(function(id){return inv[id].where === "active";}).sort();
        var setIDs = Object.keys(app.db.sets);
        for (var q = 0; q < setIDs.length; q++) {
            var st = app.db.sets[setIDs[q]], why = scopeProblem(st, fig);
            var exact = !why && active.join("|") === st.items.slice(0).sort().join("|");
            log("INFO", "SET_MEMBERS", st.name + " | setID=" + st.id + " | members=" + describeIDs(st.items) +
                " | matchesCurrentRegisteredOutfit=" + exact + (why ? " | unavailable=" + why : ""));
        }
        logWardrobeCoverage(fig, inv, "INSPECT");
        ctx.outcome="Inventory checked: "+ids.length+" registered items for this figure. See report for durable IDs, candidate exclusions and exact set membership.";
    }
    function itemSetUsage(itemID) {
        var out=[],ids=Object.keys(app.db.sets);
        for(var i=0;i<ids.length;i++){var st=app.db.sets[ids[i]];if(st.items.indexOf(itemID)>=0)out.push({id:st.id,name:st.name});}
        out.sort(function(a,b){return a.name.localeCompare(b.name);});return out;
    }
    function registeredItemRows(fig) {
        return withReadScope(function(){
            var inv=inventory(fig,app.db),ids=Object.keys(inv),rows=[];
            for(var i=0;i<ids.length;i++){
                var id=ids[i],it=app.db.items[id],usage=itemSetUsage(id),inf=inv[id];
                rows.push({itemID:id,name:it.name,where:inf.where,instanceID:inf.instanceID,
                    rootKey:inf.root?key(inf.root):"",usage:usage,transition:itemTransitionPolicy(it)});
            }
            rows.sort(function(a,b){return a.name.localeCompare(b.name);});return rows;
        },false);
    }
    function rememberRegisteredItemMetadata(it,inf) {
        for(var i=0;i<it.parts.length;i++){var n=inf.parts[it.parts[i].id],k=key(n);if(!own(ctx.metaBefore,k))ctx.metaBefore[k]=dataObject(n);}
    }
    function maintainRegisteredItem(fig,itemID,unregister) {
        frameGuard();assertNoPending(fig);
        var inv=inventory(fig,app.db),inf=inv[itemID],it=app.db.items[itemID];
        if(!it||!inf)throw problem("REGISTERED_ITEM_MISSING","The selected registered item is no longer available on this figure or in its wardrobe.");
        var usage=itemSetUsage(itemID);
        if(unregister&&usage.length)throw problem("ITEM_STILL_USED","Remove "+it.name+" from all saved sets before unregistering it. Used by: "+usage.map(function(r){return r.name;}).join(", "));
        if(inf.where!=="active"&&inf.where!=="stored")throw problem("INVENTORY_LOCATION",it.name);
        if(inf.where==="active")nativeLinkCheck(it,inf,fig);else validateRecovery(it,inf,fig,null,true);
        observe([key(fig)].concat(inf.partKeys),"REGISTERED_ITEM_PRE",true);
        inv=inventory(fig,app.db);inf=inv[itemID];
        var locationRecord=durableRecord(it,inf,fig),beforeMeasured=measured(inf.partKeys,true),beforePose=figurePoseAuditEnabled()?poseRecord(fig):null;
        rememberRegisteredItemMetadata(it,inf);
        ctx.rollbackRecords[itemID]=locationRecord;ctx.rollbackMeasurements=beforeMeasured;ctx.rollbackPose=beforePose;
        ctx.registeredMaintenanceTxn={itemID:itemID,originalWhere:inf.where,locationRecord:locationRecord,unregister:unregister===true};
        ctx.pending={schemaVersion:1,operationID:ctx.id,libraryID:app.db.libraryID,action:unregister?"UnregisterRegisteredItem":"ReturnRegisteredItem",itemID:itemID,ownerFigureID:figureIdentity(fig,false)};
        txData(fig,{Pending:jsonText(ctx.pending)});
        var restoredRecord=null;
        if(inf.where==="stored"){
            if(app.experimentalGeoShellRecovery&&geoShellsOnFigure(fig,true).length&&
                (geoIsGraft(fig,itemID,inf,null)||
                 (inf.root&&inf.root.inherits("DzGeometryShellNode"))))
                geoPrepareShellBackups(fig,true);
            restoredRecord=restoreItem(it,inf,fig);
        }
        if(restoredRecord&&!unregister){
            try{Scene.update();processEvents();}catch(ignoreGeoReturnUpdate){}
            var returns=[];
            if(inf.root&&inf.root.inherits("DzGeometryShellNode")){
                var ri=inventory(fig,app.db),rk=Object.keys(ri);
                for(var rr=0;rr<rk.length;rr++)if(ri[rk[rr]].where==="active"&&
                    value(ri[rk[rr]].root,"GeoWardrobeSnapshot"))returns.push(rk[rr]);
            }else returns=[itemID];
            geoWardrobeRestoreActive(fig,returns);
        }
        var after=inventory(fig,app.db),active=after[itemID];
        if(!active||active.where!=="active")throw problem("RETURN_REGISTERED_FAILED",it.name+" did not return to the selected figure.");
        if(restoredRecord)actualReferencesMatch(restoredRecord,"RETURN_REGISTERED_LINKS");
        if(restoredRecord)compareMeasured(beforeMeasured,active.partKeys,"RETURN_REGISTERED_LOCAL_STATE","restore");
        if(!unregister){
            unsetData(active.root,"Recovery");unsetData(fig,"Pending");ctx.pending=null;
            log("PASS","REGISTERED_ITEM_RETURNED",it.name+" | instance="+active.instanceID+" | remains registered");
            ctx.outcome=it.name+" returned to "+fig.getLabel()+" and remains registered. A later outfit that does not include it may store it again.";return;
        }
        // Unregister only this live scene instance. Historical item definitions/presets
        // remain in immutable library revisions and are not deleted here.
        for(var p=0;p<it.parts.length;p++){var n=active.parts[it.parts[p].id];putData(n,null);if(dataObject(n))throw problem("UNREGISTER_VERIFY",n.getLabel());}
        unsetData(fig,"Pending");ctx.pending=null;
        var finalInv=inventory(fig,app.db);
        if(own(finalInv,itemID))throw problem("UNREGISTER_VERIFY",it.name+" is still present in registered inventory.");
        log("PASS","REGISTERED_ITEM_UNREGISTERED",it.name+" | returned=true | setReferences=0 | historical preset retained");
        ctx.outcome=it.name+" returned to "+fig.getLabel()+" and unregistered from this scene instance. It is no longer managed by outfit switching. Save the scene to retain this change.";
    }
    function storeRegisteredItem(fig,itemID) {
        if(!ctx || ctx.action!=="store_registered" || !same(ctx.target,fig))
            throw problem("STORE_REGISTERED_CONTEXT","Store Registered Item requires its own action and selected figure.");
        frameGuard();assertNoPending(fig);
        var inv=inventory(fig,app.db),inf=inv[itemID],it=app.db.items[itemID];
        if(!it||!inf)throw problem("REGISTERED_ITEM_MISSING","The selected registered item is no longer available on this figure or in its wardrobe.");
        if(inf.where==="stored"){
            ctx.fastNoop=true;ctx.outcome=it.name+" is already in "+fig.getLabel()+"'s wardrobe.";return;
        }
        if(inf.where!=="active")throw problem("INVENTORY_LOCATION",it.name);
        nativeLinkCheck(it,inf,fig);
        var ids=Object.keys(inv),active=[];
        for(var i=0;i<ids.length;i++)if(ids[i]!==itemID&&inv[ids[i]].where==="active")active.push(ids[i]);
        var target={id:"",name:"Store "+it.name,figureType:String(fig.objectName),scope:{kind:"type"},items:active};
        ctx.diag.storeRegistered={itemID:itemID,name:it.name,policy:"single_registered_item_v0611"};
        applySet(target,fig);
        resetAppliedPropertyStateForFigure(fig,"manual Wardrobe move");
        var after=inventory(fig,app.db);
        if(!after[itemID]||after[itemID].where!=="stored")throw problem("STORE_REGISTERED_FAILED",it.name+" did not move to wardrobe storage.");
        log("PASS","REGISTERED_ITEM_STORED",it.name+" | owner="+fig.getLabel()+" | other active registered items preserved");
        ctx.outcome=it.name+" moved to "+fig.getLabel()+"'s wardrobe. Save the scene to retain this wardrobe state.";
    }
    function preflightManualWardrobeReset(fig){
        var state=readAppliedPropertyState(fig);
        if(!state.entries.length)return;
        var inv=inventory(fig,app.db),checked=0;
        for(var i=0;i<state.entries.length;i++){
            var rec=state.entries[i];
            if(optionalPropertyAccess(rec,"manual reset preflight",function(){
                var n=propertyTargetNode(rec,fig,inv),p=propertyHandleForOverride(n,rec);
                checkPropertyOverrideValue(p,rec,Number(rec.resetValue),"manual reset preflight");
                return true;
            }))checked++;
        }
        log("INFO","WARDROBE_RESET_PREFLIGHT","recorded="+state.entries.length+
            " | resolvable="+checked+" | no values written");
    }
    // Move Selected is a single same-figure transaction, not a loop of
    // single-item maintenance actions. Both directions are captured before
    // any mutation; no selected row can refer to another owner or stale
    // catalog revision. Nonselected items are kept verbatim.
    function checkedWardrobeMovePlan(fig,payload){
        if(!payload||payload.libraryID!==app.db.libraryID||payload.commitID!==app.db.commitID ||
           !Array.isArray(payload.storeIDs)||!Array.isArray(payload.restoreIDs))
            throw problem("BULK_MOVE_STALE","Reopen Wardrobe: the catalog or selection changed.");
        if(!payload.storeIDs.length&&!payload.restoreIDs.length)
            throw problem("BULK_MOVE_EMPTY","Select at least one item to move.");
        var inv=inventory(fig,app.db),ids=Object.keys(inv),seen={},stores=[],returns=[],active=[],i;
        for(i=0;i<ids.length;i++)if(inv[ids[i]].where==="active")active.push(ids[i]);
        function add(id,direction){
            if(typeof id!=="string"||!id||seen["$"+id]||!own(inv,id)||!own(app.db.items,id))
                throw problem("BULK_MOVE_SELECTION","Invalid, duplicate or missing registered item: "+String(id));
            seen["$"+id]=true;
            var inf=inv[id],it=app.db.items[id];
            if(inf.where!==direction)
                throw problem("BULK_MOVE_LOCATION",it.name+" changed sides. Reopen Wardrobe before moving.");
            if(direction==="active"){nativeLinkCheck(it,inf,fig);stores.push(id);}
            else {validateRecovery(it,inf,fig,null,true);returns.push(id);}
        }
        for(i=0;i<payload.storeIDs.length;i++)add(payload.storeIDs[i],"active");
        for(i=0;i<payload.restoreIDs.length;i++)add(payload.restoreIDs[i],"stored");
        var desired=active.filter(function(id){return stores.indexOf(id)<0;}).concat(returns);
        return {stores:stores,returns:returns,desired:desired,before:undressInventorySnapshot(inv),
            target:{id:"",name:"Wardrobe Move Selected",figureType:String(fig.objectName),scope:{kind:"type"},items:desired}};
    }
    function verifyExplicitWardrobeMove(before,expected,fig,code){
        var inv=inventory(fig,app.db),ids=Object.keys(before).sort(),actual=Object.keys(inv).sort();
        if(!closeNumbers(ids,actual))throw problem(code,"Registered items appeared/disappeared during this action.");
        var count=0;
        for(var i=0;i<ids.length;i++){
            var id=ids[i],old=before[id],now=inv[id],where=own(expected,id)?expected[id]:old.where;
            if(!now || now.where!==where || now.rootID!==old.rootID || now.instanceID!==old.instanceID ||
               key(now.root)!==old.rootKey || !closeNumbers(now.partKeys.slice(0).sort(),old.partKeys) ||
               !closeNumbers(now.allKeys.slice(0).sort(),old.allKeys))
                throw problem(code,app.db.items[id].name+": owner, identity or resulting Wardrobe location differs.");
            if(own(expected,id))count++;
        }
        log("PASS",code,"Verified "+ids.length+" original registered instances; selected transitions="+count+
            "; all nonselected item locations and IDs unchanged.");
    }
    function moveSelectedWardrobeItems(fig,payload){
        if(!ctx||ctx.action!=="bulk_move"||!same(ctx.target,fig))
            throw problem("BULK_MOVE_CONTEXT","Move Selected requires one selected figure.");
        frameGuard();assertNoPending(fig);
        var plan=checkedWardrobeMovePlan(fig,payload),expected={};
        for(var i=0;i<plan.stores.length;i++)expected[plan.stores[i]]="stored";
        for(i=0;i<plan.returns.length;i++)expected[plan.returns[i]]="active";
        ctx.diag.bulkMove={storeIDs:plan.stores.slice(0),restoreIDs:plan.returns.slice(0),
            policy:"single_transient_owner_txn_v024",preflightCount:Object.keys(plan.before).length,
            libraryID:app.db.libraryID,propertyResets:0};
        log("INFO","BULK_MOVE_PLAN","store="+describeIDs(plan.stores)+" | return="+describeIDs(plan.returns)+
            " | keep="+describeIDs(plan.desired.filter(function(id){return plan.returns.indexOf(id)<0;})));
        if(plan.stores.length)preflightManualWardrobeReset(fig);
        var started=new Date().getTime();
        applySet(plan.target,fig);
        var applied=ctx.diag.plan;
        if(!applied||applied.load.length||!closeNumbers(applied.store.slice(0).sort(),plan.stores.slice(0).sort())||
            !closeNumbers(applied.restore.slice(0).sort(),plan.returns.slice(0).sort()))
            throw problem("BULK_MOVE_PLAN_CHANGED","Apply performed a different transition than the checked rows.");
        verifyExplicitWardrobeMove(plan.before,expected,fig,"BULK_MOVE_VERIFIED");
        ctx.diag.bulkMove.completed={stored:plan.stores.length,returned:plan.returns.length};
        ctx.diag.bulkMove.elapsedMs=new Date().getTime()-started;
        log("INFO","PERF_WARDROBE_BULK","elapsedMs="+ctx.diag.bulkMove.elapsedMs+
            " | stored="+plan.stores.length+" | returned="+plan.returns.length+
            " | verifiedOriginalInstances="+Object.keys(plan.before).length);
        ctx.outcome="Moved "+plan.stores.length+" item(s) into "+fig.getLabel()+"'s Wardrobe and returned "+
            plan.returns.length+" to the figure. All other registered items were left unchanged. " +
            "Save the scene to retain this wardrobe state.";
    }
    function takeOffSavedSet(fig,payload){
        if(!ctx||ctx.action!=="remove_set"||!same(ctx.target,fig))
            throw problem("REMOVE_SET_CONTEXT","Take Off Set requires one selected figure.");
        frameGuard();assertNoPending(fig);
        if(!payload||payload.libraryID!==app.db.libraryID||payload.commitID!==app.db.commitID)
            throw problem("REMOVE_SET_STALE","The catalog changed. Reopen the main window.");
        var st=app.db.sets[payload.id];if(!st)throw problem("SET_MISSING",String(payload.id));
        if(scopeProblem(st,fig))throw problem("REMOVE_SET_SCOPE","Selected Set does not apply to this figure.");
        var inv=inventory(fig,app.db),ids=Object.keys(inv),active=[],stores=[],i;
        for(i=0;i<ids.length;i++)if(inv[ids[i]].where==="active")active.push(ids[i]);
        for(i=0;i<st.items.length;i++)if(inv[st.items[i]]&&inv[st.items[i]].where==="active")
            stores.push(st.items[i]);
        if(!stores.length)throw problem("REMOVE_SET_EMPTY","No member of this Set is currently worn. Refresh the main window.");
        var before=undressInventorySnapshot(inv),wanted=active.filter(function(id){return stores.indexOf(id)<0;}),expected={};
        for(i=0;i<stores.length;i++)expected[stores[i]]="stored";
        var target={id:"",name:"Take Off Set: "+st.name,figureType:String(fig.objectName),
            scope:{kind:"type"},items:wanted};
        ctx.diag.requestedSet={resolvedName:st.name,resolvedID:st.id};
        ctx.diag.removeSet={setID:st.id,setName:st.name,storeIDs:stores.slice(0),propertyResets:0,
            ignoredPolicies:true,transient:true,unmanagedUntouched:true};
        log("INFO","REMOVE_SET_PLAN",st.name+" | worn members to store="+describeIDs(stores)+
            " | leave other registered items worn="+describeIDs(wanted)+
            " | all currently recorded PropertyState values will Reset");
        preflightManualWardrobeReset(fig);
        var started=new Date().getTime();
        ctx.handTransition=prepareHandRemoval(fig,stores,st.id);
        applySet(target,fig);
        var executed=ctx.diag.plan;
        if(!executed||executed.load.length||executed.restore.length||
           !closeNumbers(executed.store.slice(0).sort(),stores.slice(0).sort()))
            throw problem("REMOVE_SET_PLAN_CHANGED","Take Off Set changed the expected list of items.");
        verifyExplicitWardrobeMove(before,expected,fig,"REMOVE_SET_VERIFIED");
        ctx.diag.removeSet.elapsedMs=new Date().getTime()-started;
        log("INFO","PERF_WARDROBE_REMOVE_SET","elapsedMs="+ctx.diag.removeSet.elapsedMs+
            " | stored="+stores.length+" | verifiedOtherRegistered="+(Object.keys(before).length-stores.length));
        if(value(fig,"PropertyState"))throw problem("REMOVE_SET_PROPERTIES","Applied properties were not fully cleared.");
        applyHandTransition(ctx.handTransition,fig);
        ctx.outcome="Taken off "+stores.length+" worn member(s) of Set '"+st.name+"' from "+fig.getLabel()+
            ", ignoring all Keep/Replace policies. All recorded applied Property Overrides were reset; " +
            "other worn registered items and unregistered objects were not removed.";
    }
    // Catalog-only transition policy edits. Never rewrite scene metadata.
    function saveItemTransitionPolicy(payload,fig){
        if(!payload||payload.commitID!==app.db.commitID||payload.libraryID!==app.db.libraryID)
            throw problem("TRANSITION_STALE","Catalog changed. Reopen Wardrobe and try again.");
        var src=app.db.items[payload.itemID];
        if(!src||String(fig.objectName)!==src.figureType)throw problem("TRANSITION_ITEM","Selected item is no longer compatible with the figure.");
        var proposed={mode:String(payload.mode||""),replacementIDs:clonePlain(payload.replacementIDs||[])};
        validateItemTransitionPolicy(proposed,payload.itemID,app.db.items);
        var next=clonePlain(app.db),changed=[];
        next.items[payload.itemID].transitionPolicy=proposed;
        changed.push({itemID:payload.itemID,name:src.name,mode:proposed.mode,replacements:proposed.replacementIDs.length});
        if(payload.addReciprocal===true&&proposed.mode==="replace"){
            // Only items explicitly chosen by the user can be modified.
            for(var i=0;i<proposed.replacementIDs.length;i++){
                var id=proposed.replacementIDs[i],it=next.items[id],old=itemTransitionPolicy(it);
                var replacements=old.mode==="replace"?old.replacementIDs.slice(0):[];
                if(replacements.indexOf(payload.itemID)<0)replacements.push(payload.itemID);
                var target={mode:"replace",replacementIDs:replacements};
                validateItemTransitionPolicy(target,id,next.items);
                it.transitionPolicy=target;
                changed.push({itemID:id,name:it.name,mode:target.mode,replacements:target.replacementIDs.length});
            }
        }
        // Existing scenes and DUFs are left unchanged; one immutable commit.
        commitCatalog(next,app.catalogFile);ctx.catalogCommitted=true;
        ctx.diag.transitionPolicyEdit={sourceID:payload.itemID,reciprocal:payload.addReciprocal===true,changed:changed};
        log("PASS","TRANSITION_POLICY_SAVED",jsonText(changed));
        ctx.outcome="Transition policy saved for "+src.name+" ("+changed.length+" item(s) updated). Existing outfits and scene were not changed.";
    }
    // Styled button-radio palette, consistent with Partial Sets and Choose Sources.
    // These are exclusive by controller logic (not Qt autoExclusive), so the
    // same selection remains consistent on DAZ Studio 4 and 6.
    function wardrobeTransitionStyle(button,selected,enabled){
        var border=selected?"#69B58A":"#696A70",background=selected?"#33483D":"#37383C";
        if(!enabled){border="#515256";background="#292A2D";}
        button.sizedFromIcon=false;
        try{button.getWidget().setStyleSheet(
            'QPushButton { color: '+(enabled?'#F1F1F1':'#929397')+'; font-weight: '+(selected?'bold':'normal')+'; '+
            'background-color: '+background+'; border: 1px solid '+border+'; border-radius: 4px; '+
            'padding: 3px 5px; }'+
            'QPushButton:hover { border: 2px solid '+border+'; }'+
            'QPushButton:pressed { background-color: #54565A; }');}
        catch(ignoreTransitionStyle){}
    }
    function wardrobePolicyActionStyle(button,caption,width,border,background){
        button.text=caption;button.autoDefault=false;button.sizedFromIcon=false;
        button.setFixedSize(width,36);
        try{button.getWidget().setStyleSheet('QPushButton { color: #F0F0F0; font-weight: bold; '+
            'background-color: '+background+'; border: 1px solid '+border+'; border-radius: 4px; padding: 3px 9px; }'+
            'QPushButton:hover { border: 2px solid '+border+'; }'+
            'QPushButton:pressed { background-color: #55565A; }');}
        catch(ignorePolicyActionStyle){}
    }
    // Only invoked from the enabled Replace "..." action. Replacement IDs
    // are a SET of registered item IDs, not a single radio selection. DAZ's
    // button-styled checkboxes can be selected together; sorting follows the
    // visible catalog order rather than QObject/scene-list traversal order.
    function itemTransitionPolicyDialog(itemID){
        var item=app.db.items[itemID];if(!item)return null;
        var existing=itemTransitionPolicy(item),choices=[],ids=Object.keys(app.db.items);
        for(var i=0;i<ids.length;i++){
            var other=app.db.items[ids[i]];
            if(ids[i]!==itemID&&other.figureType===item.figureType)choices.push({id:ids[i],name:String(other.name)});
        }
        choices.sort(function(a,b){return a.name.localeCompare(b.name)||a.id.localeCompare(b.id);});
        var dlg=newGeorgiaDialog();dlg.caption=TITLE+" - Replacement for: "+item.name;
        dlg.showHelpButton(false);dlg.showAcceptButton(false);dlg.showCancelButton(false);
        var box=new DzVGroupBox(dlg);box.insideMargin=8;box.insideSpacing=7;
        var heading=label(box,"Choose the registered items that can replace "+item.name+":");
        heading.wordWrap=true;heading.setFixedSize(588,46);
        var search=new DzLineEdit(box);search.text="";search.setFixedSize(588,30);
        search.toolTip="Filter by name. Selected replacements stay checked even when filtered out.";
        var scroll=new DzScrollArea(box);scroll.widgetResizable=true;scroll.setHorizontalScrollbarDisplay(false);
        var listHeight=Math.max(94,Math.min(350,choices.length*35+12));
        scroll.setFixedSize(588,listHeight);
        var list=new DzVGroupBox(scroll);flattenGroupBox(list);list.insideMargin=4;list.insideSpacing=4;
        scroll.setWidget(list);
        var selectedIDs={},choiceButtons=[],nameCounts={};
        if(existing.mode==="replace")for(i=0;i<existing.replacementIDs.length;i++)selectedIDs[existing.replacementIDs[i]]=true;
        for(i=0;i<choices.length;i++)nameCounts[choices[i].name]=(nameCounts[choices[i].name]||0)+1;
        for(i=0;i<choices.length;i++)(function(opt){
            var b=new DzPushButton(list);
            b.text=opt.name+(nameCounts[opt.name]>1?" ("+opt.id.slice(-6)+")":"");
            b.autoDefault=false;b.checkable=true;b.setFixedSize(552,30);
            b.toolTip=opt.name+"\nRegistered item ID: "+opt.id+"\nClick to include or exclude this replacement.";
            choiceButtons.push({item:opt,button:b});
            connect(b,"clicked()",function(){
                if(selectedIDs[opt.id])delete selectedIDs[opt.id];else selectedIDs[opt.id]=true;
                refreshChoiceButtons();
            });
        })(choices[i]);
        if(!choices.length)label(list,"No other registered items for this figure type.");
        var note=label(box,"");note.wordWrap=true;note.setFixedSize(588,26);
        var reciprocal=new DzCheckBox(box);reciprocal.text="Also add the reverse Replace rule";
        reciprocal.checked=false;reciprocal.setFixedHeight(24);
        reciprocal.toolTip="Add a reverse Replace rule to EACH selected item. Other reverse links are preserved.";
        var footer=new DzHGroupBox(box);flattenGroupBox(footer);
        footer.insideMargin=0;footer.insideSpacing=10;footer.setFixedHeight(46);
        var spacer=new DzLabel(footer);spacer.text="";spacer.minWidth=276;
        var save=new DzPushButton(footer),cancel=new DzPushButton(footer);
        wardrobePolicyActionStyle(save,"Save Policy",140,"#69B58A","#33483D");
        wardrobePolicyActionStyle(cancel,"Cancel",120,"#B87B7B","#453737");
        function selectedCount(){
            var count=0;for(var k=0;k<choices.length;k++)if(selectedIDs[choices[k].id])count++;
            return count;
        }
        function refreshChoiceButtons(){
            var term=trim(String(search.text)).toLowerCase(),visible=0;
            for(var j=0;j<choiceButtons.length;j++){
                var row=choiceButtons[j],show=!term||row.item.name.toLowerCase().indexOf(term)>=0;
                if(show){row.button.show();visible++;}else row.button.hide();
                var selected=selectedIDs[row.item.id]===true;
                row.button.checked=selected;
                wardrobeTransitionStyle(row.button,selected,true);
            }
            var count=selectedCount();save.enabled=count>0;
            note.text=!choices.length?"Register another compatible item before using Replace.":
                (!visible?"No items match the filter. Selected: "+count:
                "Selected replacements: "+count+" (multiple selection allowed)");
        }
        connect(search,"textChanged(const QString&)",refreshChoiceButtons);
        var accepted=false,saveReverse=false;
        connect(save,"clicked()",function(){if(save.enabled){accepted=true;saveReverse=reciprocal.checked;dlg.close();}});
        connect(cancel,"clicked()",function(){accepted=false;dlg.close();});
        refreshChoiceButtons();dlg.addWidget(box);
        // DzBasicDialog otherwise retains a very tall height and shows a
        // blank area after the footer. Bound it to the actual list content.
        dlg.setFixedSize(620,Math.max(395,Math.min(690,listHeight+300)));
        try{dlg.exec();}finally{dlg.deleteLater();}
        if(!accepted)return null;
        var replacements=[];
        for(i=0;i<choices.length;i++)if(selectedIDs[choices[i].id]===true)replacements.push(choices[i].id);
        if(!replacements.length)return null;
        return {itemID:itemID,mode:"replace",replacementIDs:replacements,addReciprocal:saveReverse,
            commitID:app.db.commitID,libraryID:app.db.libraryID};
    }
    function registeredItemsDialog(fig) {
        var rows=registeredItemRows(fig),dlg=newGeorgiaDialog();dlg.caption=TITLE+" - Wardrobe";
        dlg.showHelpButton(false);dlg.showCancelButton(false);dlg.showAcceptButton(false);

        var box=new DzVGroupBox(dlg),titleFont=newGeorgiaFont(),detailFont=newGeorgiaFont();
        titleFont.pixelSize=14;detailFont.pixelSize=11;

        var cols=new DzHGroupBox(box),leftPanel=new DzVGroupBox(cols),rightPanel=new DzVGroupBox(cols);
        flattenGroupBox(cols);flattenGroupBox(leftPanel);flattenGroupBox(rightPanel);
        leftPanel.setFixedWidth(665);rightPanel.setFixedWidth(600);

        var leftScroll=new DzScrollArea(leftPanel),rightScroll=new DzScrollArea(rightPanel);
        leftScroll.widgetResizable=true;rightScroll.widgetResizable=true;
        leftScroll.setHorizontalScrollbarDisplay(false);rightScroll.setHorizontalScrollbarDisplay(false);

        var leftContent=new DzVGroupBox(leftScroll),rightContent=new DzVGroupBox(rightScroll);
        flattenGroupBox(leftContent);flattenGroupBox(rightContent);
        leftScroll.setWidget(leftContent);rightScroll.setWidget(rightContent);

        var leftEmpty=label(leftContent,"[No registered items on this figure]"),
            rightEmpty=label(rightContent,"[Wardrobe is empty]"),
            controls=[],status=null,moveSelected=null;

        function rowIcon(button,r){
            var pseudo={name:r.name,itemID:r.itemID,nodeKey:r.rootKey||""};
            button.setFixedSize(91,91);button.toolTip=r.name;setWardrobeEditorItemIcon(button,pseudo);
        }
        function makeCenteredInfo(parent,r){
            var info=new DzVGroupBox(parent);flattenGroupBox(info);info.setFixedHeight(108);info.setFixedWidth(355);
            var nm=label(info,r.name),
                detail=label(info,"Used by: "+(r.usage.length?r.usage.map(function(x){return x.name;}).join(", "):"None"));
            // Explicit label width avoids name truncation in DAZ 4/6.
            nm.setFixedWidth(355);nm.wordWrap=true;nm.setFixedHeight(44);
            detail.setFixedWidth(355);detail.setFixedHeight(18);
            nm.toolTip=r.name;detail.toolTip="Used by: "+r.usage.map(function(x){return x.name;}).join(", ");
            nm.font=titleFont;detail.font=detailFont;nm.alignment=0x81;detail.alignment=0x81;
            // Distinct, warm gold wearable names without recoloring Usage and
            // Transition controls. Applied on both active and stored cards.
            try{nm.getWidget().setStyleSheet("QLabel { color: #E9CD84; }");}catch(ignoreNameTint){}
            var policyRow=new DzHGroupBox(info);flattenGroupBox(policyRow);
            policyRow.insideMargin=0;policyRow.insideSpacing=5;policyRow.setFixedSize(355,30);
            var prefix=label(policyRow,"Transition:");prefix.setFixedSize(74,27);
            prefix.toolTip="What happens when this item is absent from the incoming Set.";
            var remove=new DzPushButton(policyRow),keep=new DzPushButton(policyRow),
                replace=new DzPushButton(policyRow),more=new DzPushButton(policyRow);
            var modeButtons=[{mode:"remove",button:remove},{mode:"keep",button:keep},{mode:"replace",button:replace}];
            var widths=[72,60,78];
            for(var k=0;k<modeButtons.length;k++){
                var b=modeButtons[k].button;b.text=["Remove","Keep","Replace"][k];
                b.autoDefault=false;b.checkable=true;b.setFixedSize(widths[k],27);
            }
            remove.toolTip="Remove this item when another full Set does not include it.";
            keep.toolTip="Keep this item when another full Set does not include it.";
            replace.toolTip="Replace only when the incoming Set contains the selected replacement item.";
            more.text="...";more.autoDefault=false;more.setFixedSize(34,27);
            more.toolTip="Choose which registered item replaces this one.";
            var record={box:info,name:nm,detail:detail,policyRow:policyRow,
                modes:modeButtons,more:more};
            updateWardrobeTransitionInfo(record,r.transition.mode);
            return record;
        }
        function updateWardrobeTransitionInfo(info,mode){
            for(var k=0;k<info.modes.length;k++){
                var entry=info.modes[k],selected=entry.mode===mode;
                entry.button.checked=selected;
                wardrobeTransitionStyle(entry.button,selected,true);
            }
            info.more.enabled=mode==="replace";
            wardrobeTransitionStyle(info.more,false,mode==="replace");
        }
        function makeLeftRow(r){
            var line=new DzHGroupBox(leftContent);flattenGroupBox(line);line.minHeight=112;
            var check=new DzCheckBox(line);check.text="";check.checked=false;
            check.setFixedSize(28,32);check.toolTip="Include "+r.name+" in Move Selected";
            var icon=new DzPushButton(line);rowIcon(icon,r);
            var info=makeCenteredInfo(line,r);
            var move=new DzPushButton(line);move.text="";move.setFixedSize(60,40);move.sizedFromIcon=true;move.buttonStyle=DzPushButton.BTool;
            setResourceButtonIcon(move,"Wearable Manager - Arrow Right.png",52,32);
            move.toolTip="Move "+r.name+" to wardrobe";
            var unreg=new DzPushButton(line);unreg.text="";unreg.setFixedSize(48,48);unreg.sizedFromIcon=true;unreg.buttonStyle=DzPushButton.BTool;
            setResourceButtonIcon(unreg,"Wearable Manager Unregister.png",40,40);
            unreg.toolTip="Unregister "+r.name;
            return {group:line,check:check,move:move,unreg:unreg,info:info};
        }
        function makeRightRow(r){
            var line=new DzHGroupBox(rightContent);flattenGroupBox(line);line.minHeight=112;
            var move=new DzPushButton(line);move.text="";move.setFixedSize(60,40);move.sizedFromIcon=true;move.buttonStyle=DzPushButton.BTool;
            setResourceButtonIcon(move,"Wearable Manager - Arrow Left.png",52,32);
            move.toolTip="Return "+r.name+" to "+fig.getLabel();
            var check=new DzCheckBox(line);check.text="";check.checked=false;
            check.setFixedSize(28,32);check.toolTip="Include "+r.name+" in Move Selected";
            var icon=new DzPushButton(line);rowIcon(icon,r);
            var info=makeCenteredInfo(line,r);
            return {group:line,check:check,move:move,info:info};
        }

        for(var i=0;i<rows.length;i++)(function(r){
            var left=makeLeftRow(r),right=makeRightRow(r);
            var c={row:r,left:left,right:right,alive:true,draftMode:null};controls.push(c);

            connect(left.check,"clicked()",function(){updateMoveSelectedEnabled();});
            connect(right.check,"clicked()",function(){updateMoveSelectedEnabled();});
            connect(left.move,"clicked()",function(){runMaintenance(c,"store_registered");});
            connect(right.move,"clicked()",function(){runMaintenance(c,"return_registered");});
            for(var mi=0;mi<left.info.modes.length;mi++)(function(mode){
                connect(left.info.modes[mi].button,"clicked()",function(){setTransitionMode(c,mode);});
                connect(right.info.modes[mi].button,"clicked()",function(){setTransitionMode(c,mode);});
            })(left.info.modes[mi].mode);
            connect(left.info.more,"clicked()",function(){editTransition(c);});
            connect(right.info.more,"clicked()",function(){editTransition(c);});
            connect(left.unreg,"clicked()",function(){
                if(!c.alive)return;
                if(c.row.usage.length){
                    MessageBox.warning("'"+c.row.name+"' is still used by saved set(s):\n\n"+
                        c.row.usage.map(function(x){return x.name;}).join("\n")+
                        "\n\nRemove it from those sets before unregistering it.",TITLE+" - Cannot Unregister","&OK");return;
                }
                if(MessageBox.warning("'"+c.row.name+"' will no longer be managed by Wardrobe Sets. Historical library presets are retained.",
                        TITLE+" - Unregister Item","&Unregister","&Cancel")===0)runMaintenance(c,"unregister_registered");
            });
        })(rows[i]);

        function selectedTransitionMode(c){return c.draftMode||c.row.transition.mode;}
        function setTransitionAppearance(c){
            var mode=selectedTransitionMode(c);
            updateWardrobeTransitionInfo(c.left.info,mode);
            updateWardrobeTransitionInfo(c.right.info,mode);
        }
        function applyTransitionPolicy(c,request){
            try{
                box.enabled=false;status.text="Saving transition policy...";
                var report=runAction("set_transition_policy",key(fig),request);
                presentActionReport(report);status.text=shortActionStatus(report);
                if(report&&report.ok){
                    // This action only edits catalog transition policies. It
                    // cannot change scene item locations/usage. A second full
                    // inventory and per-figure native hierarchy scan here is
                    // unnecessary and was particularly costly in DAZ 4.
                    for(var pi=0;pi<controls.length;pi++){
                        var row=controls[pi],item=app.db.items[row.row.itemID];
                        if(!row.alive||!item)continue;
                        row.row.transition=itemTransitionPolicy(item);
                        row.draftMode=null;setTransitionAppearance(row);
                    }
                    updateMoveSelectedEnabled();return true;
                }
            }catch(e){MessageBox.critical(userErrorText(e),TITLE,"&OK");}
            finally{box.enabled=true;updateMoveSelectedEnabled();}
            c.draftMode=null;setTransitionAppearance(c);
            return false;
        }
        function setTransitionMode(c,mode){
            if(!c||!c.alive||!box.enabled)return;
            if(mode==="replace"){
                if(c.row.transition.mode==="replace")c.draftMode=null;
                else{
                    c.draftMode="replace";
                    status.text="Click ... to choose a replacement, then Save Policy.";
                }
                setTransitionAppearance(c);
                return;
            }
            if(mode!=="remove"&&mode!=="keep")return;
            if(c.row.transition.mode===mode){c.draftMode=null;setTransitionAppearance(c);return;}
            var request={itemID:c.row.itemID,mode:mode,replacementIDs:[],addReciprocal:false,
                commitID:app.db.commitID,libraryID:app.db.libraryID};
            applyTransitionPolicy(c,request);
        }
        function editTransition(c){
            if(!c||!c.alive||!box.enabled||selectedTransitionMode(c)!=="replace")return;
            var request=itemTransitionPolicyDialog(c.row.itemID);
            if(!request){
                // Replace was only a draft until a replacement is saved. Cancel
                // restores the persisted mode; never commit an empty policy.
                c.draftMode=null;setTransitionAppearance(c);return;
            }
            applyTransitionPolicy(c,request);
        }
        function checkedWardrobeRows(){
            var stores=[],returns=[];
            for(var j=0;j<controls.length;j++){
                var c=controls[j];if(!c.alive)continue;
                if(c.row.where==="active"&&c.left.check.checked)stores.push(c.row.itemID);
                else if(c.row.where==="stored"&&c.right.check.checked)returns.push(c.row.itemID);
            }
            return {storeIDs:stores,restoreIDs:returns};
        }
        function updateMoveSelectedEnabled(){
            if(!moveSelected)return;
            var selected=checkedWardrobeRows();
            moveSelected.enabled=(selected.storeIDs.length+selected.restoreIDs.length)>0&&box.enabled;
            moveSelected.toolTip="Store "+selected.storeIDs.length+" checked active item(s) and return "+
                selected.restoreIDs.length+" checked stored item(s) in one transaction.";
        }
        function currentRowsMap(){
            var fresh=registeredItemRows(fig),map={};
            for(var i=0;i<fresh.length;i++)map[fresh[i].itemID]=fresh[i];
            return map;
        }
        function refreshFromScene(){
            var map=currentRowsMap(),leftCount=0,rightCount=0;
            for(var i=0;i<controls.length;i++){
                var c=controls[i],fresh=map[c.row.itemID];
                if(!fresh){
                    c.alive=false;c.left.group.hide();c.right.group.hide();continue;
                }
                if(c.row.where!==fresh.where){c.left.check.checked=false;c.right.check.checked=false;}
                c.alive=true;c.row=fresh;
                var used=fresh.usage.length?fresh.usage.map(function(x){return x.name;}).join(", "):"None";
                c.left.info.name.text=fresh.name;c.right.info.name.text=fresh.name;
                c.left.info.detail.text="Used by: "+used;c.right.info.detail.text="Used by: "+used;
                setTransitionAppearance(c);
                if(fresh.where==="stored"){
                    c.left.group.hide();c.right.group.show();rightCount++;
                }else{
                    c.right.group.hide();c.left.group.show();leftCount++;
                }
            }
            if(leftCount)leftEmpty.hide();else leftEmpty.show();
            if(rightCount)rightEmpty.hide();else rightEmpty.show();
            var visible=Math.max(leftCount,rightCount,1),listHeight=Math.max(150,Math.min(530,visible*116+16));
            leftScroll.setFixedHeight(listHeight);rightScroll.setFixedHeight(listHeight);
            try{dlg.setFixedSize(1310,Math.max(320,Math.min(690,listHeight+105)));}catch(ignoreResize){}
            updateMoveSelectedEnabled();
        }
        function runMaintenance(c,type){
            if(!c||!c.alive)return;
            try{
                box.enabled=false;status.text=type==="store_registered"?"Moving to wardrobe...":(type==="return_registered"?"Returning to figure...":"Unregistering...");
                var report=runAction(type,key(fig),{itemID:c.row.itemID});
                presentActionReport(report);status.text=shortActionStatus(report);
                if(report&&report.ok){
                    c.draftMode=null;
                    c.left.check.checked=false;c.right.check.checked=false;
                    refreshFromScene();
                }
                if(app.abortRequested)dlg.close();
            }catch(e){MessageBox.critical(userErrorText(e),TITLE,"&OK");}
            finally{box.enabled=true;updateMoveSelectedEnabled();}
        }

        // One flat footer, not a status row plus an empty black bordered panel.
        var bottom=new DzHGroupBox(box);flattenGroupBox(bottom);
        bottom.insideMargin=0;bottom.insideSpacing=9;bottom.setFixedHeight(43);
        status=label(bottom,"");status.wordWrap=false;status.minWidth=725;status.setFixedHeight(37);
        moveSelected = new DzPushButton(bottom); moveSelected.text ="           Move Selected";
        moveSelected.setFixedSize(120,36);moveSelected.autoDefault=false;
        // The icon stays ON the text button and retains its native size in
        // both DAZ 4 and 6; do not create a second icon-only companion.
        try{
            setPathButtonPixmap(moveSelected,resourcePath("Wearable Manager Select All.png"),120,32,true,true);
        }catch(ignoreMoveSelectedIcon){}
        moveSelected.text="           Move Selected";moveSelected.sizedFromIcon=true;
        var close=new DzPushButton(bottom);
        close.setFixedSize(120,36);close.text="Close";close.sizedFromIcon=true;close.autoDefault=false;
        setTextButtonResourceIconCandidates(close,["Wearable Manager Close.png"],24,24,true);
        connect(close,"clicked()",function(){dlg.close();});
        connect(moveSelected,"clicked()",function(){
            if(!box.enabled)return;
            var selected=checkedWardrobeRows(),count=selected.storeIDs.length+selected.restoreIDs.length;
            if(!count)return;
            try{
                box.enabled=false;status.text="Moving "+count+" checked item(s)...";
                selected.commitID=app.db.commitID;selected.libraryID=app.db.libraryID;
                var report=runAction("bulk_move",key(fig),selected);
                presentActionReport(report);status.text=shortActionStatus(report);
                if(report&&report.ok){
                    for(var di=0;di<controls.length;di++)controls[di].draftMode=null;
                    for(var k=0;k<controls.length;k++){
                        if(selected.storeIDs.indexOf(controls[k].row.itemID)>=0||
                           selected.restoreIDs.indexOf(controls[k].row.itemID)>=0){
                            controls[k].left.check.checked=false;controls[k].right.check.checked=false;
                        }
                    }
                    refreshFromScene();
                }
                if(app.abortRequested)dlg.close();
            }catch(e){MessageBox.critical(userErrorText(e),TITLE,"&OK");}
            finally{box.enabled=true;updateMoveSelectedEnabled();}
        });
        refreshFromScene();
        dlg.addWidget(box);
        try{dlg.exec();}finally{dlg.deleteLater();}
        return null;
    }
    function saveActionReport() {
        var token = profileBegin("report_export");
        try { return saveActionReportImpl(); }
        finally { profileEnd(token); }
    }
    function saveActionReportImpl() {
        ctx.diag.version=VERSION;ctx.diag.action=ctx.action;ctx.diag.operationID=ctx.id;ctx.diag.libraryID=app.db.libraryID;
        ctx.diag.operations=ctx.operations;ctx.diag.loaderCalls=ctx.loadCalls;ctx.diag.results=ctx.results;
        ctx.diag.rollbackRecords=ctx.rollbackRecords;ctx.diag.pending=ctx.pending;
        if (ctx.diag.materialLoads) flushMaterialDiagnostics();
        // Reports are not authoritative recovery data. Scene metadata is.
        try { writeText(ctx.directory+"/diagnostics.json",jsonText(ctx.diag),false); }
        catch(e){log("WARN","DIAGNOSTICS_WRITE",errorText(e));}
    }
    function partialSelectionTarget(st,fig,choice,db) {
        // All selection IDs/keys come from this current immutable catalog
        // revision, not from displayed labels or raw scene node pointers.
        if(!choice || ["keep_all","follow_rules","take_all"].indexOf(choice.removalMode)<0 || !Array.isArray(choice.items) ||
            !Array.isArray(choice.propertyKeys) || !Array.isArray(choice.partStateKeys||[]) || choice.commitID!==db.commitID ||
            choice.libraryID!==db.libraryID)throw problem("PARTIAL_STALE","Reopen Partial Sets; the saved catalog or selection changed.");
        var selectedItems=[],wantedIDs={},i,id;
        for(i=0;i<choice.items.length;i++){
            id=String(choice.items[i]);
            if(st.items.indexOf(id)<0||own(wantedIDs,id))throw problem("PARTIAL_ITEMS","Invalid or repeated partial item ID.");
            wantedIDs[id]=true;selectedItems.push(id);
        }
        var properties=setPropertyOverrides(st),byKey={},selectedProperties=[],seenKeys={};
        for(i=0;i<properties.length;i++)byKey[propertyOverrideKey(properties[i])]=properties[i];
        for(i=0;i<choice.propertyKeys.length;i++){
            var k=String(choice.propertyKeys[i]);
            if(!own(byKey,k)||own(seenKeys,k))throw problem("PARTIAL_PROPERTIES","Invalid or repeated selected property.");
            seenKeys[k]=true;selectedProperties.push(clonePlain(byKey[k]));
        }
        if(!selectedItems.length&&!selectedProperties.length&&!(choice.partStateKeys||[]).length&&choice.removalMode!=="take_all")
            throw problem("PARTIAL_EMPTY","Select an item, part state or property, or choose Take Off All.");
        var inv=inventory(fig,db),keys=Object.keys(inv),active=[];
        for(i=0;i<keys.length;i++)if(inv[keys[i]].where==="active")active.push(keys[i]);
        var groupDomain=choice.removalMode==="follow_rules"?groupScopedDomain(st,fig,db):null;
        if(groupDomain)assertGroupRemovalUnambiguous(st,fig,active,selectedItems,groupDomain,db);
        var ids=transitionEffectiveIDs(selectedItems,active,db.items,choice.removalMode,groupDomain);
        var activeAfter={};for(i=0;i<ids.length;i++)activeAfter[ids[i]]=true;
        var removed=[];for(i=0;i<active.length;i++)if(!own(activeAfter,active[i]))removed.push(active[i]);
        if(ctx&&ctx.partialChoice){ctx.partialChoice.removedIDs=removed.slice(0);ctx.partialChoice.retainedIDs=ids.filter(function(k){return selectedItems.indexOf(k)<0;});}
        var geoSnapshots=[],partialMaterials={};
        for(i=0;i<(st.geoShellSnapshots||[]).length;i++)if(own(wantedIDs,st.geoShellSnapshots[i].graftItemID))
            geoSnapshots.push(clonePlain(st.geoShellSnapshots[i]));
        // Partial selection never inherits the full Set's other material
        // snapshots. A chosen graft carries only its own immutable baseline.
        for(i=0;i<selectedItems.length;i++)if(st.materialSnapshots&&own(st.materialSnapshots,selectedItems[i])){
            var selectedInf=inv[selectedItems[i]];
            if(geoIsGraft(fig,selectedItems[i],selectedInf,st))
                partialMaterials[selectedItems[i]]=clonePlain(st.materialSnapshots[selectedItems[i]]);
        }
        var selectedPartStates={},savedPartStates=setPartStates(st),seenPartStates={};
        for(i=0;i<(choice.partStateKeys||[]).length;i++){
            var selectedKey=String(choice.partStateKeys[i]),matched=null,allParts=partStateEntries(st);
            if(own(seenPartStates,selectedKey))throw problem("PARTIAL_PART_STATES","Duplicate selected Part State.");
            seenPartStates[selectedKey]=true;
            for(var spi=0;spi<allParts.length;spi++)if(allParts[spi].itemID+"|"+allParts[spi].partID===selectedKey){matched=allParts[spi];break;}
            if(!matched)throw problem("PARTIAL_PART_STATES","Selected Part State is not in this Set.");
            if(ids.indexOf(matched.itemID)<0)throw problem("PARTIAL_PART_STATE_TARGET",
                "Select or keep the parent item before applying its child visibility: "+app.db.items[matched.itemID].name);
            if(!own(wantedIDs,matched.itemID)&&(!inv[matched.itemID]||inv[matched.itemID].where!=="active"))
                throw problem("PARTIAL_PART_STATE_TARGET","Wear the parent item before choosing visibility-only Partial Apply: "+app.db.items[matched.itemID].name);
            if(!selectedPartStates[matched.itemID])selectedPartStates[matched.itemID]={};
            selectedPartStates[matched.itemID][matched.partID]=clonePlain(matched.state);
        }
        return {id:"",name:"Partial: "+st.name,figureType:st.figureType,scope:clonePlain(st.scope),
            items:ids,properties:selectedProperties,partStates:selectedPartStates,
            geoShellSnapshots:geoSnapshots,materialSnapshots:partialMaterials};
    }
    // Selection button artwork is 120 x 32 with the illustration on the left
    // and transparent space reserved for overlaid button text on the right.
    // Treat it as a *background*, not as an icon alongside the caption:
    // the latter would clip the text in DAZ Studio 4 and 6.
    function partialSelectionButton(button,caption,imageName) {
        button.text=caption;button.autoDefault=false;button.sizedFromIcon=false;
        button.setFixedSize(120,32);
        button.toolTip=caption+" clothing and property overrides";
        try{
            var path=resourcePath(imageName);
            if(!readable(path))return;
            var px=new Pixmap(path);
            if(!px||px.isNull())return;
            var native=button.getWidget();
            // Qt 4 / Qt 6 QPushButton stylesheet: painting order keeps the
            // text above the transparent PNG, instead of after a 120px icon.
            var safe=String(path).replace(/\\/g,"/").replace(/\"/g,"%22");
            var css='QPushButton { background-image: url("'+safe+'"); background-repeat: no-repeat; '+
                'background-position: center center; padding-left: 28px; '+
                'color: #EDEDED; font-weight: bold; border: 1px solid #656568; border-radius: 3px; }'+
                'QPushButton:pressed { background-color: #55565A; }'+
                'QPushButton:disabled { color: #898989; }';
            native.setStyleSheet(css);
        }catch(e){print(TITLE+" Partial Sets button icon: "+String(e));}
    }
    function partialSetDialog(st,fig) {
        if(!fig||scopeProblem(st,fig))return null;
        var dlg=newGeorgiaDialog();dlg.caption=TITLE+" - Partial Sets: "+st.name;
        // Own the footer: DAZ's default buttons may be positioned below a
        // fixed-height content area or grow the dialog on different versions.
        dlg.showHelpButton(false);dlg.showAcceptButton(false);dlg.showCancelButton(false);
        var box=new DzVGroupBox(dlg);box.insideMargin=8;box.insideSpacing=7;
        var itemChecks=[],propChecks=[],p,i;
        var list=setPropertyOverrides(st),parts=partStateEntries(st),wornItems=[],wornError=null;
        // Snapshot is read-only and used solely to populate Currently Worn.
        // The Apply operation rechecks the real scene independently.
        try{
            var inv=inventory(fig,app.db),ids=Object.keys(inv);
            for(i=0;i<ids.length;i++)if(inv[ids[i]].where==="active"){
                var wornItem=app.db.items[ids[i]];
                wornItems.push({id:ids[i],name:wornItem?wornItem.name:ids[i]});
            }
        }catch(readWornError){wornError=readWornError;}
        // Size the list areas for the amount of actual content, with a modest
        // minimum and a scrollable maximum. Avoid the large blank dialog tail.
        var rows=Math.max(st.items.length,list.length+1,wornItems.length+4,1);
        var scrollHeight=Math.max(190,Math.min(350,rows*27+22));
        var sectionHeight=34+5+scrollHeight;
        var columns=new DzHGroupBox(box);flattenGroupBox(columns);
        columns.insideMargin=0;columns.insideSpacing=10;
        columns.setFixedHeight(sectionHeight+6);
        function section(titleText,headingColor,width) {
            var col=new DzVGroupBox(columns);flattenGroupBox(col);
            col.insideMargin=0;col.insideSpacing=5;col.setFixedSize(width,sectionHeight);
            var title=label(col,titleText),font=newGeorgiaFont();
            font.pixelSize=18;font.bold=true;
            title.font=font;title.alignment=0x84;title.setFixedSize(width,34);
            try{title.getWidget().setStyleSheet("QLabel { color: "+headingColor+"; font-weight: bold; }");}
            catch(ignoreHeadingStyle){}
            var scroll=new DzScrollArea(col);scroll.widgetResizable=true;
            scroll.setHorizontalScrollbarDisplay(false);scroll.setFixedSize(width,scrollHeight);
            var content=new DzVGroupBox(scroll);flattenGroupBox(content);
            content.insideMargin=5;content.insideSpacing=3;
            scroll.setWidget(content);
            return {content:content};
        }
        var clothing=section("Clothing Items","#87CEEB",354),
            properties=section("Property Overrides","#E8C879",370),
            worn=section("Currently Worn","#85DEA8",254);
        var itemContent=clothing.content,propertyContent=properties.content,
            wornContent=worn.content;
        for(i=0;i<st.items.length;i++){
            var item=app.db.items[st.items[i]],cb=new DzCheckBox(itemContent);
            cb.text=item?item.name:st.items[i];cb.checked=true;
            cb.setFixedHeight(24);cb.toolTip=st.items[i];
            itemChecks.push({id:st.items[i],check:cb});
        }
        if(!st.items.length){var noItems=label(itemContent,"No clothing items in this set.");noItems.setFixedHeight(26);}
        for(i=0;i<list.length;i++){
            p=list[i];var propertyBox=new DzCheckBox(propertyContent),owner=p.targetKind==="figure"?"Figure":
                (app.db.items[p.itemID]?app.db.items[p.itemID].name:String(p.itemID));
            propertyBox.text=owner+" / "+String(p.propertyLabel||p.propertyName)+" (Apply: "+p.applyValue+")";
            propertyBox.checked=true;propertyBox.setFixedHeight(24);
            propertyBox.toolTip="Override: "+p.propertyName+"; Reset: "+p.resetValue;
            propChecks.push({key:propertyOverrideKey(p),check:propertyBox});
        }
        if(!list.length){var noProps=label(propertyContent,"No Properties");noProps.setFixedHeight(26);}
        if(wornError){
            var unavailable=label(wornContent,"Current wardrobe unavailable; Apply will verify it.");
            unavailable.setFixedHeight(40);unavailable.toolTip=errorText(wornError);
        }else{
            for(i=0;i<wornItems.length;i++){
                var wornName=label(wornContent,wornItems[i].name);
                wornName.setFixedHeight(24);wornName.wordWrap=false;
                wornName.toolTip=wornItems[i].name;
            }
            if(!wornItems.length){var empty=label(wornContent,"No registered items currently worn.");empty.setFixedHeight(26);}
        }
        // Three mutually exclusive modes, in the Currently Worn panel.
        var ruleTitle=label(wornContent,"Remove unselected items:");ruleTitle.setFixedHeight(24);
        var keepAll=new DzRadioButton(wornContent);keepAll.text="Keep All";keepAll.checked=true;
        var byRules=new DzRadioButton(wornContent);byRules.text="Follow Item Rules";
        var takeAll=new DzRadioButton(wornContent);takeAll.text="Take Off All";
        keepAll.setFixedHeight(27);byRules.setFixedHeight(27);takeAll.setFixedHeight(27);
        keepAll.toolTip="Do not remove any currently worn registered item.";
        byRules.toolTip="Keep or replace already worn items using each item's saved Transition Policy.";
        takeAll.toolTip="Store every currently worn item not selected for this partial set.";
        // Footer contains all four buttons on one baseline. Custom action
        // buttons replace DzBasicDialog's default Apply/Cancel controls.
        var footer=new DzHGroupBox(box);flattenGroupBox(footer);
        footer.insideMargin=0;footer.insideSpacing=8;footer.setFixedHeight(42);
        var all=new DzPushButton(footer),none=new DzPushButton(footer),
            spacer=new DzLabel(footer),apply=new DzPushButton(footer),cancel=new DzPushButton(footer);
        partialSelectionButton(all,"Select All","Wearable Manager Select All.png");
        partialSelectionButton(none,"Unselect All","Wearable Manager Deselect All.png");
        spacer.text="";spacer.minWidth=420;
        function footerAction(button,caption,width,borderColor,backgroundColor) {
            button.text=caption;button.autoDefault=false;button.sizedFromIcon=false;
            button.setFixedSize(width,36);
            try{button.getWidget().setStyleSheet(
                'QPushButton { color: #F0F0F0; font-weight: bold; background-color: '+backgroundColor+'; '+
                'border: 1px solid '+borderColor+'; border-radius: 4px; padding: 3px 9px; }'+
                'QPushButton:hover { border: 2px solid '+borderColor+'; }'+
                'QPushButton:pressed { background-color: #55565A; }');}
            catch(ignoreFooterStyle){}
        }
        footerAction(apply,"Apply Selected",150,"#69B58A","#33483D");
        footerAction(cancel,"Cancel",120,"#B87B7B","#453737");
        // Show any installed WM2 action artwork next to the label without
        // requiring resources that are absent from some installations.
        var applyIcons=["Wearable Manager - Ok.png"];
        for(i=0;i<applyIcons.length;i++)if(setTextButtonResourceIcon(apply,applyIcons[i],24,24))break;
        setTextButtonResourceIcon(cancel,"Wearable Manager Close.png",24,24);
        connect(all,"clicked()",function(){for(var j=0;j<itemChecks.length;j++)itemChecks[j].check.checked=true;
            for(var k=0;k<propChecks.length;k++)propChecks[k].check.checked=true;});
        connect(none,"clicked()",function(){for(var j=0;j<itemChecks.length;j++)itemChecks[j].check.checked=false;
            for(var k=0;k<propChecks.length;k++)propChecks[k].check.checked=false;});
        var accepted=false;
        connect(apply,"clicked()",function(){accepted=true;dlg.close();});
        connect(cancel,"clicked()",function(){dlg.close();});
        dlg.addWidget(box);
        // DzBasicDialog otherwise remembers an overly tall size from the
        // previous iteration on both DAZ 4/6. Fix both dimensions explicitly.
        dlg.setFixedSize(1030,Math.max(330,Math.min(545,sectionHeight+102)));
        var result=null;
        try{dlg.exec();
            if(accepted){
                result={items:[],propertyKeys:[],partStateKeys:[],removalMode:takeAll.checked?"take_all":
                    (byRules.checked?"follow_rules":"keep_all"),
                    commitID:app.db.commitID,libraryID:app.db.libraryID};
                for(i=0;i<itemChecks.length;i++)if(itemChecks[i].check.checked)result.items.push(itemChecks[i].id);
                for(i=0;i<propChecks.length;i++)if(propChecks[i].check.checked)result.propertyKeys.push(propChecks[i].key);
                // Saved visibility follows selected clothing; it is not a user Property Override.
                for(i=0;i<parts.length;i++)if(result.items.indexOf(parts[i].itemID)>=0)
                    result.partStateKeys.push(parts[i].itemID+"|"+parts[i].partID);
                if(!result.items.length&&!result.propertyKeys.length&&!result.partStateKeys.length&&result.removalMode!=="take_all"){
                    MessageBox.warning("Select items or properties, or choose Take Off All.",TITLE,"&OK");result=null;
                }
            }
        }finally{dlg.deleteLater();}
        return result;
    }

    function runAction(action, figKey, payload) {
        var actionStartedMs = new Date().getTime();
        // A Transition Policy is a pure catalog edit. Unlike a wearable
        // transfer it never mutates the DAZ scene, and needs neither an
        // initial full-scene snapshot nor a native Undo/selection hold.
        var preflightFailure=payload&&payload.preflightError;
        var catalogOnly=action==="set_transition_policy"||!!preflightFailure;
        ctx={id:unique("operation"),action:action,target:null,frame:null,lines:[],results:[],warned:{},metaBefore:{},created:{},originalNodes:catalogOnly?{}:sceneIndex(),
            rollbackRecords:{},rollbackMeasurements:null,rollbackPose:null,propertyRollback:[],partStateRollback:[],pending:null,operations:[],loadCalls:0,logPath:"",logBroken:false,directory:"",catalogCommitted:false,outcome:"",diag:{observations:[],comparisons:[]}};
        ctx.optimizeReads = app.optimizeReads !== false;
        ctx.bulkChannels = app.bulkChannels !== false;
        ctx.reuseChannelBindings = app.reuseChannelBindings !== false;
        ctx.verificationMode = app.verificationMode;
        ctx.blockViewportRedraw = app.blockViewportRedraw === true;
        ctx.profile = {startedMs:actionStartedMs, rows:{}, counters:{}, current:null};
        var held=false,undo=false,ok=false;
        try {
            lockLibrary();app.db=readCatalog();ctx.target=live(figKey);
            if(!ctx.target||!isFigure(ctx.target))throw problem("FIGURE_MISSING","Choose a human figure.");
            ctx.frame=typeof Scene.getFrame==="function"?Number(Scene.getFrame()):null;frameGuard();
            ctx.directory=inLibrary("Logs/"+ctx.id);mkdir(ctx.directory);ctx.logPath=ctx.directory+"/report.txt";
            log("INFO","ENVIRONMENT",TITLE+" | DAZ Studio "+App.versionString+" | "+new Date());
            log("INFO","LIBRARY",app.libraryPath+" | "+app.db.libraryID+" | revision="+app.db.revision);
            log("INFO","ACTION",action+" | figure="+ctx.target.getLabel()+" | type="+ctx.target.objectName);
            ctx.diag.verificationPolicy = verificationPolicy();
            log("INFO","VERIFICATION_PROFILE",ctx.diag.verificationPolicy.id + " | " + ctx.diag.verificationPolicy.limitations);
            log("INFO","FIGURE_POSE_AUDIT",figurePoseAuditEnabled() ?
                "enabled_full_or_maintenance | Existing whole-figure diagnostic checks retained; pose reader="+
                    (ctx.optimizeReads?"optimized_own_bones_linear":"legacy_descendant_scan")+"." :
                "disabled_operational | No human skeleton/root-scalar pose snapshots at Apply/import/material follow-up/rollback. Root and item observations remain; no pose-preservation claim.");
            log("INFO","PERF_MODE",ctx.optimizeReads ? (ctx.bulkChannels ? "optimized | owner-scoped fresh property lists; actual usage in PERF_CHANNEL_READER" : "optimized | v0.3.5 direct single-resolution channel reads") : "reference | original lookup strategy");
            log("INFO","VERIFICATION_SETTING_AUDIT","requested="+ctx.verificationMode+
                " | effective="+verificationPolicy().effective+
                " | action="+action+
                " | ordinaryObservation="+(operationalVerification()?"8/80/1":"80/800/5")+
                " | poseWalker="+(figurePoseAuditEnabled() ? (ctx.optimizeReads?"own_bones_linear":"legacy_descendants") : "disabled")+
                " | materialRecheck=80/800/5 | rollback=80/800/5");
            viewportDiagnostic();
            log("INFO","VIEWPORT_POLICY","requested="+ctx.blockViewportRedraw+" | available="+viewportLockSupported()+" | redraw only during store/restore; disabled for no-op/imports/observation");
            if(preflightFailure){
                ctx.diag.requestedSet={resolvedName:app.db.sets[payload.id]?app.db.sets[payload.id].name:"",resolvedID:payload.id||""};
                log("INFO","UI_PREFLIGHT","Set="+ctx.diag.requestedSet.resolvedName+" | No operation started; scene unchanged.");
                throw preflightFailure;
            }
            if(!catalogOnly){
                beginChannelSession();
                beginNodeSelectionHold();held=true;
                if(action!=="inspect"&&action!=="geo_probe"){beginUndo();undo=true;}
            }else{
                log("INFO","CATALOG_ONLY","Transition policy: no scene writes, no Undo group, no whole-scene snapshot.");
            }
            if(action==="save")saveSet(payload,ctx.target);
            else if(action==="fork_composite")createCompositeVariant(ctx.target,payload);
            else if(action==="delete")deleteSet(payload.id);
            else if(action==="duplicate")duplicateSet(payload.id,ctx.target);
            else if(action==="set_transition_policy")saveItemTransitionPolicy(payload,ctx.target);
            else if(action==="rebind_set")rebindSetToFigure(payload,ctx.target);
            else if(action==="apply") {var st=app.db.sets[payload.id];if(!st)throw problem("SET_MISSING",payload.id);validateSetSelection(st,payload,ctx.target);
                if(payload.similarLabelMatches&&payload.similarLabelMatches.length){ctx.diag.similarLabelMatches=clonePlain(payload.similarLabelMatches);
                    log("INFO","POSSIBLE_UNREGISTERED_LABEL_MATCH","User continued after "+payload.similarLabelMatches.length+" advisory label match(es). Labels were not used as identity or mutation keys.");}
                // Set the retention guard BEFORE property preflight: otherwise
                // a property on an intentionally kept accessory would be
                // preflight-checked as if it were about to be reset.
                var prepared=effectiveSetForTransition(st,ctx.target,"follow_rules");
                ctx.transitionRetainedIDs=prepared.retained;
                preflightSetPropertyOverrides(st,ctx.target);
                ctx.handTransition=prepareHandTransition(st,ctx.target,prepared.set.items);
                applyWithSourceChoices(st,ctx.target,payload.sources,prepared);
                applyHandTransition(ctx.handTransition,ctx.target);}
            else if(action==="partial_apply"){
                var partialSet=app.db.sets[payload.id];if(!partialSet)throw problem("SET_MISSING",payload.id);
                validateSetSelection(partialSet,payload,ctx.target);
                ctx.partialChoice={sourceID:partialSet.id,mode:payload.partial.removalMode,
                    removeCurrent:payload.partial.removalMode==="take_all",removedIDs:[],retainedIDs:[]};
                var partialTarget=partialSelectionTarget(partialSet,ctx.target,payload.partial,app.db);
                ctx.diag.partial={sourceSetID:partialSet.id,sourceSetName:partialSet.name,
                    chosenItems:payload.partial.items.slice(0),chosenProperties:payload.partial.propertyKeys.slice(0),chosenPartStates:(payload.partial.partStateKeys||[]).slice(0),
                    removalMode:ctx.partialChoice.mode,removedIDs:ctx.partialChoice.removedIDs.slice(0),
                    plannedActiveItems:partialTarget.items.slice(0),
                    transient:true,importsFromOwnCatalogOnly:true};
                preflightSetPropertyOverrides(partialTarget,ctx.target);
                ctx.handTransition=prepareHandRemoval(ctx.target,ctx.partialChoice.removedIDs,"");
                applySet(partialTarget,ctx.target);
                applyHandTransition(ctx.handTransition,ctx.target);
                ctx.outcome="Partial set "+partialSet.name+" applied: "+payload.partial.items.length+
                    " selected item(s), "+payload.partial.propertyKeys.length+" selected property override(s), "+
                    (payload.partial.partStateKeys||[]).length+" selected part state(s)."+
                    (ctx.partialChoice.mode==="take_all"?" All unselected registered clothes were stored.":
                     (ctx.partialChoice.mode==="follow_rules"?" Item transition rules determined which clothes were stored.":
                     " Existing worn registered clothes were kept."))+
                    " Full Worn status is determined by the actual complete wardrobe only.";
            }
            else if(action==="restore_materials"){
                var materialSet=app.db.sets[payload.id];
                if(!materialSet||payload.commitID!==app.db.commitID)
                    throw problem("MATERIAL_RESTORE_STALE","The set or catalog changed. Reopen Materials.");
                if(scopeProblem(materialSet,ctx.target))
                    throw problem("MATERIAL_RESTORE_SCOPE","The chosen set does not apply to this figure.");
                restoreSelectedItemMaterials(materialSet,ctx.target,payload.itemIDs||
                    (payload.itemID?[String(payload.itemID)]:[]));
            }
            else if(action==="restore_hand_poses"){
                var handSet=app.db.sets[payload.id];
                if(!handSet||payload.commitID!==app.db.commitID)throw problem("HAND_POSE_STALE","The set or library changed. Reopen Wardrobe.");
                if(scopeProblem(handSet,ctx.target))throw problem("HAND_POSE_SCOPE","This set does not apply to the selected figure.");
                ctx.handTransition=prepareSavedHandRestore(handSet,ctx.target);
                applyHandTransition(ctx.handTransition,ctx.target);
                ctx.outcome="Saved hand poses restored for "+handSet.name+".";
            }
            else if(action==="restore_properties"){
                var restoreSet=app.db.sets[payload.id];if(!restoreSet)throw problem("SET_MISSING",payload.id);
                validateSetSelection(restoreSet,payload,ctx.target);
                restoreOutfitProperties(restoreSet,ctx.target);
            }
            else if(action==="undress_all"){
                ctx.handTransition=prepareHandTransition(null,ctx.target);
                undressAllRegistered(ctx.target);applyHandTransition(ctx.handTransition,ctx.target);
            }
            else if(action==="bulk_move")moveSelectedWardrobeItems(ctx.target,payload);
            else if(action==="remove_set")takeOffSavedSet(ctx.target,payload);
            else if(action==="store_registered")storeRegisteredItem(ctx.target,payload.itemID);
            else if(action==="return_registered")maintainRegisteredItem(ctx.target,payload.itemID,false);
            else if(action==="unregister_registered")maintainRegisteredItem(ctx.target,payload.itemID,true);
            else if(action==="geo_probe")probeGeoShells(ctx.target,false);
            else if(action==="geo_import_probe")probeGeoShells(ctx.target,true,false);
            else if(action==="geo_recovery_probe")probeGeoShells(ctx.target,true,true);
            else if(action==="inspect")inspectWardrobe(ctx.target);
            else throw problem("ACTION","Unknown action.");
            if(["apply","partial_apply","undress_all","remove_set","bulk_move","store_registered","return_registered","unregister_registered"].indexOf(action)>=0)
                restoreRemovedHandSessions();
            commitGeoMaterialUndo();
            ok=true;
        } catch(e) {
            // A disabled GeoShell recovery option is a normal preflight block, not
            // an action failure, but ONLY when nothing has been changed.
            // If something was written before the guard, retain full rollback
            // and critical error semantics rather than hiding a real problem.
            try{
                var handExtras=ctx.additionalHandTransitions||[];
                for(var hi=handExtras.length-1;hi>=0;hi--)rollbackHandTransition(handExtras[hi].transition,handExtras[hi].figure);
                rollbackHandTransition(ctx.handTransition,ctx.target);
            }catch(handRollbackError){
                ctx.handRollbackFailed=true;app.abortRequested=true;log("FAIL","HAND_POSE_ROLLBACK",errorText(handRollbackError));
            }
            var requiresRecovery=ctx.catalogCommitted||Object.keys(ctx.metaBefore).length||
                Object.keys(ctx.created).length||Object.keys(ctx.rollbackRecords).length||
                (ctx.propertyRollback&&ctx.propertyRollback.length)||
                (ctx.partStateRollback&&ctx.partStateRollback.length)||
                (ctx.geoMaterialTxn&&ctx.geoMaterialTxn.attempted)||ctx.operations.length||ctx.loadCalls;
            if(e&&e.code==="GEO_SHELL_SAFETY"&&!requiresRecovery&&!viewportLocksOwned) {
                ctx.diag.blocked="GEO_SHELL_SAFETY";
                log("INFO","GEO_SHELL_BLOCKED","GeoGraft change blocked: GeoShell Material Recovery is off. Enable it in Settings before retrying with a saved scene copy.");
                ctx.outcome="GeoGraft/GeoShell transition blocked by Settings. No wardrobe items or materials were changed.";
            } else {
                if(!e.recorded)log("FAIL","ERROR",errorText(e));ctx.diag.failure=errorText(e);
                if(viewportLocksOwned) {
                    try{releaseWardrobeViewportLocks("before_rollback");}
                    catch(vre){app.abortRequested=true;log("FAIL","VIEWPORT_RELEASE_RETRY",errorText(vre));}
                }
                if(ctx.catalogCommitted)log("WARN","COMMITTED","The catalog was committed before this later error; it was not rolled back.");
                else if(requiresRecovery)ctx.rollbackComplete=rollbackAction();
                else ctx.rollbackComplete=true;
                ctx.outcome=preflightFailure?"Stopped before applying the set. No scene changes were made. See Last Report for the conflicting objects.":"Operation stopped. Read the report; do not overwrite your saved test scene after an incomplete rollback.";
            }
        } finally {
            if(viewportLocksOwned) {
                try{releaseWardrobeViewportLocks("action_finally");}
                catch(vre2){ok=false;app.abortRequested=true;log("FAIL","VIEWPORT_RELEASE_FINAL",errorText(vre2)+". Closing script to release its native locks.");}
            }
            finishViewportDiagnostics();
            if(held){try{restoreNodeSelectionHold();}catch(e1){log("WARN","SELECTION",errorText(e1));}}
            if(undo){try{if(!ok&&ctx.rollbackComplete&&!ctx.handRollbackFailed&&!ctx.catalogCommitted)dropUndo();else acceptUndo("Wardrobe Sets - "+action);}catch(e2){log("WARN","UNDO_GROUP",errorText(e2));}}
            if(ctx.geoUndoCallback)ctx.geoUndoCallback.setDynamicProperty("busy",false);
            if(ok && ctx.geoMaterialTxn)geoCleanupBackupsOnSuccess();
            if(ctx.geoWardrobeTxn){
                log("INFO","GEO_WARDROBE_PERSISTENCE","newFiles="+ctx.geoWardrobeTxn.created.length+
                    " | storedGrafts="+ctx.geoWardrobeTxn.stored+
                    " | restoredShellGroups="+ctx.geoWardrobeTxn.restored+
                    " | immutable manifest/native DUFs are retained for scene-save durability, even after action failure.");
            }
            if(ok && ctx.geoMaterialsRestored)ctx.outcome += " GeoShell materials restored on "+ctx.geoMaterialsRestored+" shell(s).";
            if(ok && ctx.autoMaterialsRestored)ctx.outcome +=
                " Saved materials automatically restored for "+ctx.autoMaterialsRestored+" item(s).";
            if(ok && (ctx.materialCompatibilityOmissions || ctx.materialCompatibilityAdditions))ctx.outcome +=
                " Compatibility notice: "+(ctx.materialCompatibilityOmissions||0)+" absent and "+(ctx.materialCompatibilityAdditions||0)+
                " extra value/map entries accepted on import; see LOADED_MATERIALS_COMPAT. This is not exact cross-version material equality.";
            log("INFO","FINISHED","success="+ok+" | blocked="+(ctx.diag.blocked||"none")+" | imports="+ctx.loadCalls+" | compatibilityOmissions="+(ctx.materialCompatibilityOmissions||0)+
                " | compatibilityAdditions="+(ctx.materialCompatibilityAdditions||0)+
                " | verification=" + verificationPolicy().effective + " | scene changes remain on successful actions; save the scene explicitly.");
            if(!catalogOnly){
                try { endChannelSession(ok); } catch(bindingCleanupError) { log("WARN","CHANNEL_BINDING_CLEANUP",String(bindingCleanupError)); }
            }
            logPerformanceSummary();
            if(ctx.directory)saveActionReport();
            try{unlockLibrary();}catch(e3){log("WARN","UNLOCK",errorText(e3));}
            finishPerformanceReport();
            releasePropertyHelper();
            readScope = null;
        }
        ctx.outcome += " Verification profile: " + verificationPolicy().effective +
            (ctx.fastNoop ? ". Structural no-op only; pose/material/settling measurements intentionally not run." :
             (operationalVerification() ? ". Fast ordinary observation and item checks retained. Whole-figure pose snapshots/comparisons omitted, including import and rollback; no pose-preservation claim." : "."));
        var counts=reportCounts(ctx.results);
        app.lastReport={lines:ctx.lines.slice(0),folder:ctx.directory,outcome:ctx.outcome,ok:ok,
            blocked:ctx.diag.blocked||"",action:action,fastNoop:ctx.fastNoop===true,undressedCount:typeof ctx.undressedCount === "number" ? ctx.undressedCount : null,
            setName:ctx.diag.requestedSet?ctx.diag.requestedSet.resolvedName:"",
            duplicateSetID:ctx.diag.duplicateSetID||"",
            figureLabel:ctx.target?String(ctx.target.getLabel()):"",
            elapsedMs:Math.max(0,new Date().getTime()-actionStartedMs),
            warningCount:counts.warnings,failureCount:counts.failures,warningMessages:counts.warningMessages,
            unavailableProperties:clonePlain(ctx.diag.unavailableProperties||[])};
        ctx=null;return app.lastReport;
    }

    function showReport(report) {
        if(!report)return;
        var dlg=newGeorgiaDialog();dlg.caption=TITLE+" - Report";dlg.showHelpButton(false);dlg.showCancelButton(false);dlg.setAcceptButtonText("Close");
        var box=new DzVGroupBox(dlg);label(box,report.outcome);label(box,"Report folder: "+(report.folder||"not created"));
        var t=new DzTextEdit(box);t.readOnly=true;t.acceptRichText=false;t.plainText=["Report folder: "+(report.folder||"not created"),""].concat(report.lines).join("\n");t.setFixedSize(900,500);
        var b=new DzPushButton(box);b.text="Copy Report";connect(b,"clicked()",function(){t.selectAll();t.copy();});
        dlg.addWidget(box);dlg.exec();dlg.deleteLater();
    }

    function scriptDirectory() {
        var f=new DzFileInfo(String(getScriptFileName()||""));
        try { return String(f.path()||"").replace(/\\/g,"/").replace(/\/+$/,""); }
        finally { f.deleteLater(); }
    }
// Resolve renamed packaged assets without rewriting saved rules or libraries.
function WM2ResourceName(directory,name) {
    name=String(name);
    if(directory.exists(name))return name;
    var candidate=name.replace(/^Wearables Manager /,"Wearable Manager ")
        .replace(/^Wardrobe Sets /,"Wearable Manager Wardrobe Sets ")
        .replace(/^(?:Wearable Manager )?Verified Outfit Hanger Icon\.png$/i,"Wearable Manager Worn.png")
        .replace(/^Wearable Manager Wardrobe Sets Settings\.png$/i,"Wearable Manager Settings.png");
    // Retain saved references to the historical misspelling.
    candidate=candidate.replace(/^Wearable Manager - Coffe\.png$/i,"Wearable Manager - Coffee.png");
    if(candidate!==name&&directory.exists(candidate))return candidate;
    // JSON, scripts and button icons stay in Resources. Item images moved
    // beside it; keep saved basenames and historical filename aliases valid.
    if(/^[^\\/:]+\.png$/i.test(name)) {
        if(directory.exists("../Default Items/"+name))return "../Default Items/"+name;
        if(candidate!==name&&directory.exists("../Default Items/"+candidate))return "../Default Items/"+candidate;
    }
    return name;
}
    var wardrobeResourceDirectory=null;
    function resourcePath(name) {
        if(wardrobeResourceDirectory===null)wardrobeResourceDirectory=scriptDirectory()+"/Resources";
        var dir=new DzDir(wardrobeResourceDirectory);
        try {
            // Existing preferences and edited automatic maps retain precedence.
            if(name==="Wearable Manager Settings.json"&&dir.exists("WM2 Settings.json"))name="WM2 Settings.json";
            if(name==="Wearable Manager.json"&&dir.exists("Wearables Manager.json"))name="Wearables Manager.json";
            return wardrobeResourceDirectory+"/"+WM2ResourceName(dir,name);
        } finally { dir.deleteLater(); }
    }
    function scalePixmapTo(px,maxW,maxH,allowUpscale) {
        if(!px||px.isNull()) return px;
        var w=Number(px.width),h=Number(px.height);
        if(!(w>0&&h>0)) return px;
        var ratio=Math.min(Number(maxW)/w,Number(maxH)/h);
        if(!allowUpscale) ratio=Math.min(1,ratio);
        if(Math.abs(ratio-1)>0.0001) px.resize(Math.max(1,Math.round(w*ratio)),Math.max(1,Math.round(h*ratio)));
        return px;
    }
    function setPathButtonPixmap(button,path,maxW,maxH,sizedFromIcon,allowUpscale) {
        button.text="";
        button.sizedFromIcon=sizedFromIcon===true;
        if(!path || !readable(path)) return false;
        var px=new Pixmap(path);if(!px||px.isNull())return false;
        scalePixmapTo(px,maxW,maxH,allowUpscale===true);
        button.pixmap=px;
        if(parseInt(App.versionString,10)>=6)button.getWidget().iconSize=new Size(Number(px.width),Number(px.height));
        return true;
    }
    function figureProfileIconPath(profile) {
        if(!profile)return "";
        if(profile.iconPath && readable(profile.iconPath))return profile.iconPath;
        return profile.resource?resourcePath(profile.resource):"";
    }

    // Copy Library is intentionally independent of scene actions and of
    // catalog commits. It holds the normal library write lock while taking a
    // read-only snapshot, then verifies EVERY byte copied through DzFile.
    // No existing target files are overwritten; no implicit migration occurs.
    function copyLibraryPathKey(path){
        return String(path).replace(/\\/g,"/").replace(/\/+$/g,"").toLowerCase();
    }
    function copyLibraryEntries(path){
        var d=new DzDir(path);
        try{
            if(!d.exists()||!d.isReadable())throw problem("COPY_DIRECTORY", "Cannot enumerate "+path);
            return d.entryList("*", DzDir.AllEntries|DzDir.Hidden|DzDir.System|DzDir.NoDotAndDotDot, DzDir.Name);
        }finally{d.deleteLater();}
    }
    function copyLibraryScan(root,skipWriteLock){
        var dirs=[""],files=[],pending=[{rel:"",depth:0}],total=0;
        var rootKey=copyLibraryPathKey(root);
        while(pending.length){
            var entry=pending.shift();
            if(entry.depth>64)throw problem("COPY_DEPTH","Library contains too many nested directories.");
            var folder=root+(entry.rel?"/"+entry.rel:"");
            var names=copyLibraryEntries(folder);
            for(var i=0;i<names.length;i++){
                var name=String(names[i]);
                if(!entry.rel && skipWriteLock && name===".matew-write-lock")continue;
                if(!name||name==="."||name==="..")throw problem("COPY_ENTRY","Unsafe folder entry: "+name);
                var rel=safeRelative(entry.rel?entry.rel+"/"+name:name),p=root+"/"+rel;
                var info=new DzFileInfo(p),isDir=false,isFile=false,size=0,canonical="";
                try{
                    if(!info.exists()||info.isSymLink())throw problem("COPY_LINK","Unresolved or linked entry in library: "+rel);
                    isDir=info.isDir();isFile=info.isFile();
                    if(!isDir&&!isFile)throw problem("COPY_ENTRY_TYPE","Unsupported library entry: "+rel);
                    canonical=String(info.canonicalFilePath()||"");
                    if(!canonical||copyLibraryPathKey(canonical).indexOf(rootKey+"/")!==0)
                        throw problem("COPY_OUTSIDE_ROOT","Library entry leaves its folder: "+rel);
                    if(isFile){
                        if(!info.isReadable())throw problem("COPY_UNREADABLE","Cannot read "+rel);
                        size=Number(info.size());
                        if(!isFinite(size)||size<0||size>9007199254740991)throw problem("COPY_FILE_SIZE","Invalid file size: "+rel);
                    }
                }finally{info.deleteLater();}
                if(isDir){dirs.push(rel);pending.push({rel:rel,depth:entry.depth+1});}
                else{files.push({rel:rel,size:size});total+=size;}
                if(files.length+dirs.length>200000)throw problem("COPY_ENTRIES","Library has too many entries.");
            }
        }
        dirs.sort();files.sort(function(a,b){return a.rel<b.rel?-1:a.rel>b.rel?1:0;});
        return {dirs:dirs,files:files,bytes:total};
    }
    // Binary checks in DAZ's native ByteArray implementation: do not execute
    // byteAt() hundreds of millions of times in the script interpreter.
    // toHex() is available in DAZ 4.24 and 6.25; compare its lossless contents.
    function copyLibraryCompareBytes(from,to,size,rel,checkCancel){
        var left=new DzFile(from),right=new DzFile(to),openLeft=false,openRight=false;
        var sinceUI=0;
        try{
            if(!left.open(DzFile.ReadOnly))throw problem("COPY_READ","Cannot open original: "+rel);
            openLeft=true;
            if(!right.open(DzFile.ReadOnly))throw problem("COPY_READ","Cannot open copied file: "+rel);
            openRight=true;
            var remaining=size;
            while(remaining>0){
                var bytes=Math.min(131072,remaining),a=null,b=null,ah=null,bh=null;
                try{
                    a=left.read(bytes);b=right.read(bytes);
                    if(!a||!b||Number(a.length)!==bytes||Number(b.length)!==bytes)
                        throw problem("COPY_READ","Incomplete binary read: "+rel);
                    ah=a.toHex();bh=b.toHex();
                    if(!ah||!bh||ah.convertToString()!==bh.convertToString())
                        throw problem("COPY_CONTENT_MISMATCH","Copied data differs: "+rel);
                }finally{
                    if(ah)ah.deleteLater();if(bh)bh.deleteLater();
                    if(a)a.deleteLater();if(b)b.deleteLater();
                }
                remaining-=bytes;
                sinceUI+=bytes;
                if(sinceUI>=4194304){
                    sinceUI=0;
                    if(checkCancel)checkCancel();
                }
            }
            if(checkCancel)checkCancel();
        }finally{
            if(openLeft)left.close();if(openRight)right.close();
            left.deleteLater();right.deleteLater();
        }
    }
    function copyLibraryValidateDestination(destination){
        if(!app.libraryPath||!app.db)throw problem("COPY_NO_LIBRARY","Open an existing wardrobe library first.");
        // Validate the destination BEFORE asking for confirmation or locking.
        var source=canonicalDirectory(app.libraryPath,false),target=canonicalDirectory(destination,false);
        var a=copyLibraryPathKey(source),b=copyLibraryPathKey(target);
        if(a===b||a.indexOf(b+"/")===0||b.indexOf(a+"/")===0)
            throw problem("COPY_OVERLAP","Choose a separate empty folder, not the current library or its parent/child.");
        if(copyLibraryEntries(target).length)
            throw problem("COPY_TARGET_NOT_EMPTY","The selected folder is not empty. Please choose another empty folder.\n"+target);
        return {source:source,target:target};
    }
    function copyLibrarySnapshot(destination){
        var paths=copyLibraryValidateDestination(destination),source=paths.source,target=paths.target;
        if(app.lockToken)throw problem("COPY_BUSY","Another wardrobe operation is already active.");
        var fileBefore=app.catalogFile,dbBefore=app.db,complete=false,stats=null,hasLock=false,copyError=null;
        var progressStarted=false,progressAt=0;
        function checkCancel(){
            // Allows the progress dialog to repaint and the user to cancel.
            processEvents();
            if(progressIsCancelled())throw problem("COPY_CANCELLED","Backup cancelled by user. The destination may contain an INCOMPLETE copy.");
        }
        function showStep(info){
            if(!progressStarted)return;
            setProgressInfo(info);
            updateProgress(++progressAt);
            checkCancel();
        }
        try{
            lockLibrary();hasLock=true;
            try{
                var fresh=readCatalog();
                if(fresh.libraryID!==dbBefore.libraryID||fresh.revision!==dbBefore.revision||
                   fresh.commitID!==dbBefore.commitID||app.catalogFile!==fileBefore)
                    throw problem("COPY_STALE","The library changed. Close and reopen Settings before copying.");
                if(copyLibraryEntries(target).length)throw problem("COPY_TARGET_NOT_EMPTY","The destination became nonempty. Choose another empty folder.");
                var plan=copyLibraryScan(source,true);
                if(plan.files.length===0)throw problem("COPY_EMPTY_SOURCE","No library files found.");
                // A visible native progress dialog prevents a long verification
                // from looking like a frozen DAZ application.
                startProgress("Copying Wardrobe library",plan.files.length*2+1,true,true);
                progressStarted=true;
                checkCancel();
                for(var d=0;d<plan.dirs.length;d++)if(plan.dirs[d])mkdir(target+"/"+plan.dirs[d]);
                for(var i=0;i<plan.files.length;i++){
                    checkCancel();
                    var item=plan.files[i],from=source+"/"+item.rel,to=target+"/"+item.rel;
                    if(pathExists(to))throw problem("COPY_TARGET_CHANGED","The destination already contains "+item.rel);
                    setProgressInfo("Copying "+(i+1)+" / "+plan.files.length+": "+item.rel);
                    var file=new DzFile(from);
                    try{
                        if(!file.copy(to))throw problem("COPY_FILE","Could not copy "+item.rel+": "+String(file.errorString()||"unknown file error"));
                    }finally{file.deleteLater();}
                    showStep("Copied "+(i+1)+" / "+plan.files.length+" files");
                }
                var after=copyLibraryScan(target,false);
                if(after.dirs.length!==plan.dirs.length||after.files.length!==plan.files.length)
                    throw problem("COPY_TREE","Destination directory/file count does not match the source.");
                for(var di=0;di<plan.dirs.length;di++)if(plan.dirs[di]!==after.dirs[di])
                    throw problem("COPY_TREE","Destination directories differ: "+plan.dirs[di]);
                for(var j=0;j<plan.files.length;j++){
                    checkCancel();
                    var expect=plan.files[j],found=after.files[j];
                    if(expect.rel!==found.rel||expect.size!==found.size)
                        throw problem("COPY_TREE","Copied filename/size differs: "+expect.rel);
                    setProgressInfo("Verifying "+(j+1)+" / "+plan.files.length+": "+expect.rel);
                    copyLibraryCompareBytes(source+"/"+expect.rel,target+"/"+expect.rel,expect.size,expect.rel,checkCancel);
                    showStep("Verified "+(j+1)+" / "+plan.files.length+" files");
                }
                checkCancel();
                var sourceAfter=copyLibraryScan(source,true);
                if(sourceAfter.dirs.length!==plan.dirs.length||sourceAfter.files.length!==plan.files.length)
                    throw problem("COPY_SOURCE_CHANGED","Source files changed while making the backup.");
                for(var si=0;si<plan.dirs.length;si++)if(plan.dirs[si]!==sourceAfter.dirs[si])
                    throw problem("COPY_SOURCE_CHANGED","Source directory changed during backup.");
                for(var sj=0;sj<plan.files.length;sj++)if(plan.files[sj].rel!==sourceAfter.files[sj].rel||
                    plan.files[sj].size!==sourceAfter.files[sj].size)
                    throw problem("COPY_SOURCE_CHANGED","Source file changed during backup: "+plan.files[sj].rel);
                var finalCatalog=readCatalog();
                if(finalCatalog.commitID!==fresh.commitID||finalCatalog.revision!==fresh.revision||app.catalogFile!==fileBefore)
                    throw problem("COPY_SOURCE_CHANGED","Source catalog changed while copying.");
                var header=readJSON(target+"/library.json"),catalog=readJSON(target+"/Catalog/"+fileBefore);
                if(header.libraryID!==fresh.libraryID||catalog.libraryID!==fresh.libraryID||
                   catalog.commitID!==fresh.commitID||catalog.revision!==fresh.revision)
                    throw problem("COPY_CATALOG","Copied catalog/header does not match the active source revision.");
                stats={path:target,files:plan.files.length,folders:plan.dirs.length-1,bytes:plan.bytes,
                    revision:fresh.revision,libraryID:fresh.libraryID};
                complete=true;
                showStep("Backup verified. Finishing...");
            }catch(e){copyError=e;}
        }finally{
            // Close progress BEFORE opening further dialogs. Unlock regardless
            // of success, failure or cancellation; never remove others' locks.
            if(progressStarted){
                try{finishProgress();}catch(progressError){
                    copyError=copyError||problem("COPY_PROGRESS","Could not finish progress: "+String(progressError));
                    complete=false;
                }
            }
            if(hasLock){
                try{unlockLibrary();}catch(unlockError){
                    copyError=copyError||problem("COPY_UNLOCK","Backup copied but the source lock could not be released: "+errorText(unlockError));
                    complete=false;
                }
            }
        }
        if(copyError||!complete)throw problem("LIBRARY_COPY_FAILED",errorText(copyError||"Backup incomplete")+
            "\nDestination: "+target+"\nThis folder may contain an INCOMPLETE copy. Do not use it as your library. "+
            "The original library was not switched or intentionally rewritten.");
        return stats;
    }
    function copyLibraryInputWarning(e){
        var code=String(e&&e.code||"");
        if(code==="COPY_TARGET_NOT_EMPTY")return "The selected folder is not empty. Please choose another EMPTY folder.";
        if(code==="COPY_OVERLAP")return "The destination cannot be inside or above the active library. Choose a different empty folder.";
        if(code==="LIBRARY_UNAVAILABLE"||code==="COPY_DIRECTORY")return "The selected folder does not exist or is not accessible. Choose an existing empty folder.";
        return String(e&&e.message||e);
    }
    function copyLibraryDialog(){
        if(!app.db||!app.libraryPath){MessageBox.warning("Open an existing library before copying.",TITLE,"&OK");return null;}
        var dlg=newGeorgiaDialog();dlg.caption=TITLE+" - Copy Library";
        dlg.showHelpButton(false);dlg.showAcceptButton(false);dlg.showCancelButton(false);
        var box=new DzVGroupBox(dlg);
        label(box,"Source (current active library):\n"+app.libraryPath);
        label(box,"Choose a separate, EXISTING EMPTY folder for the backup. All catalog revisions, items, materials, icons, logs and other library files will be copied and verified byte for byte.");
        var line=new DzHGroupBox(box),target=new DzLineEdit(line),browse=new DzPushButton(line);
        target.minWidth=540;target.text="";browse.text="Browse...";
        connect(browse,"clicked()",function(){
            var p=FileDialog.doDirectoryDialog("Choose EMPTY destination folder", "", String(target.text||app.libraryPath),dlg);
            if(p)target.text=p;
        });
        label(box,"Your active library and Settings will not change. Temporary write locks are not copied. External Runtime/Textures and other content outside the library are NOT included.");
        var footer=new DzHGroupBox(box),start=new DzPushButton(footer),cancel=new DzPushButton(footer);
        start.text="Copy Library";start.setFixedSize(160,36);start.autoDefault=false;
        cancel.text="Cancel";cancel.setFixedSize(120,36);cancel.autoDefault=false;
        var choice=null;
        connect(start,"clicked()",function(){
            if(!trim(String(target.text))){MessageBox.warning("Choose an existing empty destination folder.",TITLE,"&OK");return;}
            var candidate=String(target.text);
            try{copyLibraryValidateDestination(candidate);}catch(validationError){
                // Expected input error, not a crash/report. Stay in the dialog.
                MessageBox.warning(copyLibraryInputWarning(validationError),TITLE+" - Copy Library","&OK");
                return;
            }
            choice=candidate;dlg.close();
        });
        connect(cancel,"clicked()",function(){dlg.close();});
        dlg.addWidget(box);dlg.setFixedWidth(800);
        try{dlg.exec();}finally{dlg.deleteLater();}
        if(!choice)return null;
        // Check again before confirmation in case another process added files.
        try{copyLibraryValidateDestination(choice);}catch(validationError){
            MessageBox.warning(copyLibraryInputWarning(validationError),TITLE+" - Copy Library","&OK");
            return null;
        }
        var prompt="Make a verified backup of the CURRENT active library?\n\nSource: "+app.libraryPath+
            "\nDestination: "+choice+"\n\nNo files will be overwritten or deleted. The active library will remain unchanged.";
        if(MessageBox.warning(prompt,TITLE+" - Copy Library","&Copy Library","&Cancel")!==0)return null;
        return choice;
    }

    function settingsDialog(first,selectedFigure) {
        dropChannelSession("library_settings");
        var dlg=newGeorgiaDialog(true);dlg.caption=TITLE+" - Settings";
        var settingsLayout=new DzVBoxLayout(dlg);settingsLayout.margin=0;settingsLayout.spacing=0;
        var box=new DzWidget(dlg),contentLayout=new DzVBoxLayout(box),settingsWidgets=[];
        contentLayout.margin=10;contentLayout.spacing=10;
        function settingsWidget(widget,height){widget.setFixedHeight(height);contentLayout.addWidget(widget);settingsWidgets.push({widget:widget,height:height});return widget;}
        function sectionTitle(textValue){
            var t=label(box,textValue),f=newGeorgiaFont();f.pixelSize=18;t.font=f;t.alignment=0x84;t.setFixedHeight(28);
            try{t.getWidget().setStyleSheet("QLabel { color: #87CEEB; font-weight: bold; }");}catch(ignoreTitleStyle){}
            return settingsWidget(t,28);
        }
        function sectionGap(){var g=new DzLabel(box);g.text="";return settingsWidget(g,10);}

        sectionTitle("WARDROBE LIBRARY");
        settingsWidget(label(box,"Library folder. Choosing a different folder does not migrate existing definitions or DUF files:"),20);
        var row=new DzHGroupBox(box),path=new DzLineEdit(row),browse=new DzPushButton(row);browse.text="Browse...";path.minWidth=550;
        flattenGroupBox(row);row.insideMargin=0;row.insideSpacing=10;settingsWidget(row,32);
        var base=String(App.getContentMgr().getContentDirectoryPath(0)||App.getAppDataPath());
        path.text=app.libraryPath||base+"/Presets/matew/WardrobeSetsPrototype";
        connect(browse,"clicked()",function(){var p=FileDialog.doDirectoryDialog("Choose wardrobe library folder","",String(path.text),dlg);if(p)path.text=p;});
        var create=new DzCheckBox(box);create.text="Create a NEW library if absent (empty folder only)";create.checked=!!first;
        settingsWidget(create,24);
        var backupRow=new DzHGroupBox(box),backupButton=new DzPushButton(backupRow);
        flattenGroupBox(backupRow);backupRow.insideMargin=0;backupRow.insideSpacing=10;settingsWidget(backupRow,36);
        backupButton.text="Copy Library...";backupButton.setFixedSize(165,36);backupButton.autoDefault=false;
        backupButton.enabled=!!(app.libraryPath&&app.db);
        backupButton.toolTip="Create a verified backup of the CURRENT active library in a separate empty folder. Does not switch libraries.";
        connect(backupButton,"clicked()",function(){
            try{
                var destination=copyLibraryDialog();if(!destination)return;
                var result=copyLibrarySnapshot(destination);
                MessageBox.information("Library backup verified.\n\nDestination: "+result.path+
                    "\nFiles: "+result.files+" | Folders: "+result.folders+
                    "\nBytes: "+result.bytes+" | Catalog revision: "+result.revision+
                    "\n\nThe active library and its settings were not changed.",TITLE+" - Copy Library","&OK");
            }catch(e){
                var errText=errorText(e);
                if(errText.indexOf("COPY_TARGET_NOT_EMPTY")>=0||errText.indexOf("COPY_CANCELLED")>=0||errText.indexOf("COPY_TARGET_CHANGED")>=0)
                    MessageBox.warning(errText.indexOf("COPY_CANCELLED")>=0?
                        "Backup cancelled. The chosen folder may contain an incomplete copy; choose a different EMPTY folder next time.":
                        "The destination folder is no longer empty. Please choose another empty folder.",TITLE+" - Copy Library","&OK");
                else MessageBox.critical(errText,TITLE+" - Copy Library","&OK");
            }
        });

        sectionGap();
        var maintenanceTitle=sectionTitle("REPORTS / MAINTENANCE");
        var maintenance=new DzHGroupBox(box),inspect=new DzPushButton(maintenance),report=new DzPushButton(maintenance);
        flattenGroupBox(maintenance);maintenance.insideMargin=0;maintenance.insideSpacing=10;settingsWidget(maintenance,32);
        inspect.text="Inspect Selected Figure";report.text="Last Report";inspect.autoDefault=report.autoDefault=false;
        inspect.enabled=!!selectedFigure;report.enabled=!!app.lastReport;
        inspect.toolTip=selectedFigure?"Inspect "+selectedFigure.getLabel()+" using the current saved Settings.":"Open Settings from the main window after selecting a scene figure.";
        connect(inspect,"clicked()",function(){
            if(!selectedFigure)return;
            try{var r=runAction("inspect",key(selectedFigure),{});showReport(r);report.enabled=true;}
            catch(e){MessageBox.critical(userErrorText(e),TITLE,"&OK");}
        });
        connect(report,"clicked()",function(){if(app.lastReport)showReport(app.lastReport);});


        // Debug mode controls visibility only. All saved performance flags keep
        // their values while hidden; this remains local UI settings schema 3.
        var debugRow=new DzWidget(box),debugLayout=new DzHBoxLayout(debugRow);debugLayout.margin=0;debugLayout.spacing=0;
        var debugToggle=new DzPushButton(debugRow);debugToggle.checkable=true;
        debugLayout.addWidget(debugToggle);debugLayout.addStretch(1);settingsWidget(debugRow,32);
        debugToggle.checked=!!app.debugMode;debugToggle.autoDefault=false;
        debugToggle.text="Debug Mode";debugToggle.setFixedSize(120,32);
        debugToggle.toolTip="Show diagnostic reports and maintenance tools.";

        function flag(textValue,checked){var f=new DzCheckBox(box);f.text=textValue;f.checked=checked;return settingsWidget(f,24);}
        var verificationRow=new DzHGroupBox(box);flattenGroupBox(verificationRow);
        verificationRow.insideMargin=0;verificationRow.insideSpacing=10;settingsWidget(verificationRow,32);
        label(verificationRow,"Verification:");var mode=new DzComboBox(verificationRow);
        mode.addItem("Full diagnostic");mode.addItem("Operational - fast");
        mode.currentItem=app.verificationMode==="operational"?1:0;
        var optimize=flag("Optimized reads",app.optimizeReads),
            bulk=flag("Bulk channel lookup",app.bulkChannels),
            reuse=flag("Reuse verified channel bindings between switching actions (Operational only)",app.reuseChannelBindings);
        sectionGap();
        var redraw=flag("Pause Viewport Redraw",app.blockViewportRedraw),
            geoRecovery=flag("GeoShell Material Recovery",app.experimentalGeoShellRecovery);
        redraw.toolTip="Pause viewport updates during Wardrobe store/restore where supported.";
        geoRecovery.toolTip="Protect GeoShell materials when changing or transferring GeoGrafts. Save a scene copy before complex transfers.";
        if(!viewportLockSupported()){
            redraw.enabled=false;redraw.checked=false;
            redraw.toolTip="Viewport redraw pause is not available in this DAZ Studio version.";
        }
        function refreshDebugControls(){
            var visible=!!debugToggle.checked;
            var diagnosticWidgets=[maintenanceTitle,maintenance];
            for(var d=0;d<diagnosticWidgets.length;d++)if(visible)diagnosticWidgets[d].show();else diagnosticWidgets[d].hide();
            verificationRow.hide();optimize.hide();bulk.hide();reuse.hide();
            wardrobeTransitionStyle(debugToggle,visible,true);
            // Derive height from the same visible rows and 10px layout spacing.
            // Do not retain Qt's previous expanded minimum after hiding Debug.
            var debugOnly=diagnosticWidgets.concat([verificationRow,optimize,bulk,reuse]),settingsHeight=20,count=0;
            for(var si=0;si<settingsWidgets.length;si++)if([verificationRow,optimize,bulk,reuse].indexOf(settingsWidgets[si].widget)<0 && (visible||debugOnly.indexOf(settingsWidgets[si].widget)<0)){
                settingsHeight+=settingsWidgets[si].height;count++;
            }
            settingsHeight+=Math.max(0,count-1)*10;
            box.setFixedHeight(settingsHeight);dlg.setFixedHeight(settingsHeight);
        }
        connect(debugToggle,"clicked()",function(){refreshDebugControls();});

        var footer=new DzWidget(box),footerLayout=new DzHBoxLayout(footer);
        footerLayout.margin=0;footerLayout.spacing=10;settingsWidget(footer,36);
        var saveButton=new DzPushButton(footer),cancelButton=new DzPushButton(footer);
        footerLayout.addStretch(1);footerLayout.addWidget(saveButton);footerLayout.addWidget(cancelButton);
        saveButton.text="        Save Settings";saveButton.setFixedSize(150,36);
        saveButton.autoDefault=false;saveButton.sizedFromIcon=true;
        setTextButtonResourceIconCandidates(saveButton,["Wearable Manager Save Settings.png"],150,36,true);
        cancelButton.text="Cancel";cancelButton.setFixedSize(120,36);
        cancelButton.autoDefault=false;cancelButton.sizedFromIcon=true;
        setTextButtonResourceIconCandidates(cancelButton,["Wearable Manager Close.png"],24,24,true);
        var accepted=false;
        connect(saveButton,"clicked()",function(){accepted=true;dlg.close();});
        connect(cancelButton,"clicked()",function(){dlg.close();});
        settingsLayout.addWidget(box);dlg.setFixedWidth(820);refreshDebugControls();
        var request=null;
        try{dlg.exec();}finally{dlg.deleteLater();}
        if(accepted)request={path:String(path.text),create:create.checked,ui:{schemaVersion:3,
            verificationMode:mode.currentItem===1?"operational":"full",optimizeReads:optimize.checked,
            bulkChannels:bulk.checked,reuseChannelBindings:reuse.checked,
            blockViewportRedraw:redraw.checked,experimentalGeoShellRecovery:geoRecovery.checked,
            debugMode:debugToggle.checked,showSuccessReports:false,
            onlyCompatible:true,figureIconBindings:clonePlain(app.figureIconBindings||{specific:{},label:{}})}};
        if(!request)return false;
        var oldUI=uiSettingsSnapshot();
        try{applyUISettings(request.ui);attachLibrary(request.path,request.create);}
        catch(e){applyUISettings(oldUI);throw e;}
        return true;
    }
