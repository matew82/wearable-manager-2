    // v0.4.2: editor-only icon resources. No shared scene/metadata cache.
    var builtinIconCache = {};
    function builtinIconDefinition(id) {
        for (var i=0;i<BUILTIN_ICONS.length;i++) if (BUILTIN_ICONS[i].id===id) return BUILTIN_ICONS[i];
        throw problem("BUILTIN_ICON_ID", "Unknown built-in icon: " + String(id));
    }
    function builtinIconText(id) {
        var d=builtinIconDefinition(id);
        return "/* XPM */\nstatic const char *matew_wardrobe_icon[] = {\n" +
            d.xpm.map(function(line){return JSON.stringify(line);}).join(",\n") + "\n};\n";
    }
    function builtinIconPreviewPath(id) {
        builtinIconDefinition(id);
        var text=builtinIconText(id), folder=app.configPath+"/BuiltinIcons_v1", path=folder+"/"+id+".xpm";
        if (own(builtinIconCache,id) && readable(builtinIconCache[id]) && readText(builtinIconCache[id])===text)
            return builtinIconCache[id];
        mkdir(folder);
        // This is a regenerable local preview cache, not an authoritative library asset.
        // Do not overwrite a foreign/different file at the normal cache path.
        if (pathExists(path) && readText(path)!==text) path=folder+"/"+unique("preview_"+id)+".xpm";
        if (!pathExists(path)) writeText(path,text,false);
        if (!readable(path) || readText(path)!==text) throw problem("ICON_CACHE_VERIFY",path);
        var px=new Pixmap(path);
        if (!px || px.isNull()) throw problem("ICON_XPM_LOAD", "Cannot load the built-in preview: " + id);
        builtinIconCache[id]=path; return path;
    }
    function saveBuiltinIcon(id) {
        var source=builtinIconPreviewPath(id), px=new Pixmap(source), rel, target, tries=0;
        if (!px || px.isNull()) throw problem("ICON_XPM_LOAD",id);
        do {
            if (++tries>20) throw problem("ICON_UNIQUE_PATH", "Could not allocate a new icon filename.");
            rel="Icons/"+unique("icon_builtin_"+id)+".png";target=inLibrary(rel);
        } while(pathExists(target));
        // Pixmap.save is documented as void. Verify bytes can be read and decoded;
        // do not interpret undefined as a failed save or overwrite an old image.
        var temp=inLibrary("Icons/"+unique("icon_pending")+".png");
        if (pathExists(temp)) throw problem("ICON_TEMP_EXISTS",temp);
        px.save(temp);
        if (!readable(temp)) throw problem("ICON_PNG_WRITE",temp);
        var check=new Pixmap(temp);
        if (!check || check.isNull() || Number(check.width)!==64 || Number(check.height)!==64)
            throw problem("ICON_PNG_VERIFY",temp);
        renameNew(temp,target);
        log("PASS","BUILTIN_ICON_SAVED",builtinIconDefinition(id).name+" | "+rel+" | portable PNG; no DUF rewritten");
        return rel;
    }
    function validateEditorIconSpec(spec) {
        if (spec.builtinIcon !== undefined && typeof spec.builtinIcon !== "string")
            throw problem("BUILTIN_ICON_ID", "Built-in icon ID must be a string.");
        if (spec.builtinIcon) {
            builtinIconDefinition(spec.builtinIcon);
            if (spec.iconPath || spec.clearIcon) throw problem("ICON_SELECTION", "Choose one icon source.");
        }
    }
    function editorImagePath(path) {
        var p=trim(path), ext=/\.([a-zA-Z0-9]+)$/.exec(p);
        if (!ext || ["png","jpg","jpeg","bmp"].indexOf(ext[1].toLowerCase())<0)
            throw problem("ICON_FORMAT", "Use PNG, JPG, JPEG or BMP.");
        if (!readable(p)) throw problem("ICON_READ",p);
        var px=new Pixmap(p); if (!px || px.isNull()) throw problem("ICON_IMAGE",p);
        return p;
    }


    function builtinIconDialog(current) {
        var STANDARD_SET_ICONS=[
            {name:"Default Outfit",kind:"builtin",id:"outfit"},
            {name:"Casual Dress",kind:"resource",resource:"Wearable Manager - Dress.png"},
            {name:"Casual Shirt",kind:"resource",resource:"Wearable Manager - Shirt.png"},
            {name:"Business",kind:"resource",resource:"Wearable Manager - Suit.png"},
            {name:"Office",kind:"resource",resource:"Wearable Manager - Tie.png"},
            {name:"Work",kind:"resource",resource:"Wearable Manager - Overall.png"},
            {name:"Outdoor Sport",kind:"resource",resource:"Wearable Manager - TShirt.png"},
            {name:"Gym and Yoga",kind:"resource",resource:"Wearable Manager - Leotard.png"},
            {name:"Swimming Suit",kind:"resource",resource:"Wearable Manager Wardrobe Sets Swimming Suit.png"},
            {name:"Shopping",kind:"resource",resource:"Wearable Manager Wardrobe Sets Shopping.png"},
            {name:"Study",kind:"resource",resource:"Wearable Manager Wardrobe Sets Study.png"},
            {name:"Travel",kind:"resource",resource:"Wearable Manager Wardrobe Sets Travel.png"},
            {name:"Homewear",kind:"resource",resource:"Wearable Manager Wardrobe Sets Homewear.png"},
            {name:"Sleepwear",kind:"resource",resource:"Wearable Manager - Nightie.png"},
            {name:"Lingerie",kind:"resource",resource:"Wearable Manager - Lingerie.png"},
            {name:"Fighting",kind:"resource",resource:"Wearable Manager - Sword.png"},
            {name:"Evening Dress",kind:"resource",resource:"Wearable Manager - Dress.png"},
            {name:"Suit",kind:"resource",resource:"Wearable Manager - Suit.png"}
        ];
        var dlg=newGeorgiaDialog();dlg.caption="Wardrobe Sets - Standard Icons";dlg.showHelpButton(false);dlg.showAcceptButton(false);dlg.showCancelButton(false);
        var box=new DzVGroupBox(dlg),result=null,row=null;
        function iconPath(def){return def.kind==="builtin"?builtinIconPreviewPath(def.id):resourcePath(def.resource);}
        for(var i=0;i<STANDARD_SET_ICONS.length;i++)(function(def,index){
            if(index%6===0){
                row=new DzHGroupBox(box);
                flattenGroupBox(row);
            }
            var cell=new DzVGroupBox(row),b=new DzPushButton(cell);
            flattenGroupBox(cell);
            cell.setFixedSize(128,128);
            b.setFixedSize(120,120);b.text="";b.autoDefault=false;b.sizedFromIcon=true;b.buttonStyle=DzPushButton.BTool;b.toolTip=def.name;
            try{
                var p=iconPath(def);
                if(!setPathButtonPixmap(b,p,112,112,true,true))throw problem("ICON_PREVIEW",p);
            }catch(e){b.enabled=false;b.toolTip=def.name+" - "+errorText(e);}
            connect(b,"clicked()",function(){result=clonePlain(def);dlg.close();});
        })(STANDARD_SET_ICONS[i],i);
        var footer=new DzHGroupBox(box),spacer=label(footer,""),cancel=new DzPushButton(footer);
        flattenGroupBox(footer);spacer.minWidth=700;
        cancel.text="Cancel";cancel.setFixedSize(120,36);cancel.autoDefault=false;cancel.sizedFromIcon=true;
        setTextButtonResourceIconCandidates(cancel, ["Wearable Manager Close.png"],32,32,true);
        connect(cancel,"clicked()",function(){dlg.close();});
        dlg.addWidget(box);dlg.setFixedSize(810,455);
        try{dlg.exec();}finally{dlg.deleteLater();}
        return result;
    }
    function editorActiveGeoGraft(fig,node){
        if(!node||!node.inherits("DzFigure"))return false;
        try{
            if(typeof fig.getNumGraftFigures==="function"&&typeof fig.getGraftFigure==="function"){
                var count=Number(fig.getNumGraftFigures());
                if(isFinite(count)&&count>=0&&count<=128)
                    for(var i=0;i<count;i++)if(same(node,fig.getGraftFigure(i)))return true;
            }
        }catch(ignoreGraftUI){}
        // Stored grafts may no longer be enumerated on the owner figure.
        try{if(typeof node.getNumWeldPoints==="function"&&Number(node.getNumWeldPoints())>0)return true;}
        catch(ignoreWeldUI){}
        return false;
    }
    function editorRemoteIconSources(old,localNodeKeys) {
        // Only the UI may use these foreign nodes. NEVER place them in the
        // editor's local nodeKey (which is used for selection/material edits).
        var needed={},found={},remaining=0;
        if(!old)return found;
        for(var i=0;i<old.items.length;i++){
            var itemID=old.items[i];
            if(!localNodeKeys[itemID]&&!own(needed,itemID)){needed[itemID]=true;remaining++;}
        }
        if(!remaining)return found;
        var nodes=sceneNodes();
        for(var j=0;j<nodes.length&&remaining;j++){
            var n=nodes[j],d=dataObject(n);
            if(!d||d.LibraryID!==app.db.libraryID||d.Role!=="ItemRoot"||!own(needed,d.ItemID))continue;
            found[d.ItemID]=key(n);delete needed[d.ItemID];remaining--;
        }
        return found;
    }
    function collectEditorRows(old,fig) {
        return withReadScope(function(){
            var can=candidates(fig),onFigure={},nodeForItem={},saved={},rows=[],entries=[],i;
            var inv=inventory(fig,app.db),invIDs=Object.keys(inv);
            for(i=0;i<invIDs.length;i++)if(inv[invIDs[i]]&&inv[invIDs[i]].root)nodeForItem[invIDs[i]]=key(inv[invIDs[i]].root);
            for(i=0;i<can.length;i++) {
                var n=can[i],d=dataObject(n),id=d&&d.LibraryID===app.db.libraryID?d.ItemID:"";
                entries.push({nodeKey:key(n),name:String(n.getLabel()),itemID:id||""});
                if(id){onFigure[id]=true;nodeForItem[id]=key(n);}
            }
            var remoteIconKeys=editorRemoteIconSources(old,nodeForItem);
            if(old)for(i=0;i<old.items.length;i++) {
                var it=app.db.items[old.items[i]];
                if(!it)throw problem("MEMBER_MISSING",old.items[i]);
                saved[it.id]=true;
                rows.push({kind:"saved",itemID:it.id,nodeKey:nodeForItem[it.id]||"",
                    iconNodeKey:nodeForItem[it.id]||remoteIconKeys[it.id]||"",
                    name:it.name,selected:true,initialSelected:true,
                    detail:onFigure[it.id]?"Saved member | worn by this figure":"Saved member | stored or not currently worn",
                    saveMaterials:!!(old.materialSnapshots&&own(old.materialSnapshots,it.id))});
            }
            for(i=0;i<entries.length;i++) {
                var e=entries[i];if(e.itemID&&own(saved,e.itemID))continue;
                rows.push({kind:"available",itemID:"",nodeKey:e.nodeKey,name:e.name,selected:false,initialSelected:false,
                    detail:e.itemID?"On figure | registered definition will be reused":"On figure | new item to register",saveMaterials:false});
            }
            for(var gr=0;gr<rows.length;gr++){
                var row=rows[gr],rn=row.nodeKey?live(row.nodeKey):null;
                row.geoGraft=editorActiveGeoGraft(fig,rn);
                if(row.geoGraft)row.saveMaterials=true;
            }
            return rows;
        },false);
    }
    function editorRowShown(row,search,selectedOnly) {
        if(selectedOnly&&!row.selected)return false;
        var needle=trim(search).toLowerCase();
        return !needle||(String(row.name)+" "+String(row.detail)).toLowerCase().indexOf(needle)>=0;
    }
    function editorSelectionSummary(rows) {
        var out={total:0,kept:0,removed:0,added:0,saved:0,available:0};
        for(var i=0;i<rows.length;i++) {
            var r=rows[i];if(r.selected)out.total++;
            if(r.kind==="saved") {out.saved++;if(r.selected)out.kept++;else out.removed++;}
            else {out.available++;if(r.selected)out.added++;}
        }
        return out;
    }

    function editorPayload(rows,fields) {
        var out={id:fields.id||"",baseCommit:fields.baseCommit,rebindFigure:!!fields.rebindFigure,
            name:String(fields.name),scope:fields.scope,scopeLabel:String(fields.scopeLabel),
            groupID:String(fields.groupID||""),newGroupName:String(fields.newGroupName||""),
            replaceWithinGroup:fields.replaceWithinGroup===true,
            iconPath:fields.iconPath||"",builtinIcon:fields.builtinIcon||"",clearIcon:!!fields.clearIcon,
            properties:clonePlain(fields.properties||[]),rightHandPose:fields.rightHandPose===true,leftHandPose:fields.leftHandPose===true,
            rightHandPoseRecapture:fields.rightHandPoseRecapture===true,leftHandPoseRecapture:fields.leftHandPoseRecapture===true,
            items:[],nodes:[],materialRequests:[]};
        for(var i=0;i<rows.length;i++)if(rows[i].selected) {
            if(rows[i].kind==="saved")out.items.push(rows[i].itemID);else out.nodes.push(rows[i].nodeKey);
            if(rows[i].saveMaterials)out.materialRequests.push({itemID:rows[i].itemID||"",nodeKey:rows[i].nodeKey||""});
        }
        validateEditorIconSpec(out);return out;
    }
    
    function findSetIconCamera(fig) {
        var id=figureUIIdentity(fig,false);if(!id)return null;
        var cams=Scene.getCameraList();
        for(var i=0;i<cams.length;i++)if(value(cams[i],"Role")==="SetIconCamera"&&value(cams[i],"SetIconOwnerUIID")===id)return cams[i];
        return null;
    }
    function createSetIconCamera(fig) {
        if(!MainWindow)throw problem("SET_ICON_CAMERA","Main window is unavailable.");
        var id=figureUIIdentity(fig,true),cam=new DzBasicCamera();
        cam.setName("Wardrobe Sets Set Icon Camera "+id);cam.setLabel("Wardrobe Sets Set Icon - "+figureDisplayLabel(fig));
        Scene.addNode(cam);updateData(cam,{Schema:"1",Role:"SetIconCamera",SetIconOwnerUIID:id});
        try{cam.useLocalDimensions=true;cam.pixelsWidth=100;cam.pixelsHeight=128;cam.proportionsConstrained=true;cam.depthOfField=false;}catch(ignore){}
        var vp=MainWindow.getViewportMgr().getActiveViewport().get3DViewport();
        beginNodeSelectionHold();
        try{
            Scene.selectAllNodes(false);Scene.setPrimarySelection(fig);vp.setCamera(cam);
            vp.frameCameraOnSelectedNodes();vp.aimCameraAtPrimaryNode();vp.aspectOn=true;
        }finally{restoreNodeSelectionHold();}
        return cam;
    }
    function renderSetIconFromCamera(fig,cam) {
        var folder=String(App.getTempPath())+"/matew/WardrobeSetsSetIcons";mkdir(folder);
        var target=folder+"/"+unique("set_icon_render")+".png";
        var rm=App.getRenderMgr(),iray=rm.findRenderer("DzIrayRenderer");
        if(!iray)throw problem("IRAY_UNAVAILABLE","NVIDIA Iray renderer could not be found.");
        var oldRenderer=rm.getActiveRenderer(),opt=null,handler=null,ok=false;
        try{
            rm.setActiveRenderer(iray);
            opt=new DzRenderOptions();opt.copyFrom(rm.getRenderOptions());
            opt.isCurrentFrameRender=true;opt.renderImgToId=DzRenderOptions.DirectToFile;opt.renderImgFilename=target;
            opt.isAspectConstrained=true;opt.setAspectRatio(100,128);opt.imageSize=new Size(100,128);opt.showPreview=false;
            handler=new DzImageRenderHandler(new Size(100,128),Scene.getTime().valueOf(),target);handler.writeToFile=true;handler.setCreateThumbnail(false);
            ok=iray.render(handler,cam,opt);
        }finally{
            if(oldRenderer)try{rm.setActiveRenderer(oldRenderer);}catch(ignoreRenderer){}
            if(handler&&typeof handler.deleteLater==="function")handler.deleteLater();
            if(opt&&typeof opt.deleteLater==="function")opt.deleteLater();
        }
        if(!ok||!readable(target))throw problem("SET_ICON_RENDER","Iray render did not create the set icon.");
        var px=new Pixmap(target);
        if(!px||px.isNull()||Number(px.width)!==100||Number(px.height)!==128)
            throw problem("SET_ICON_RENDER_SIZE","Expected a 100 x 128 render.");
        return target;
    }


    var wardrobeEditorIconResolver=null,wardrobeEditorIconConfig=null,wardrobeEditorSupportAttempted=false;
    function wardrobeEditorFallbackIconName(name) {
        var s=String(name||"").toLowerCase();
        function any(words){for(var i=0;i<words.length;i++)if(s.indexOf(words[i])>=0)return true;return false;}
        if(any(["hair","ponytail","pigtail","scalp","updo"]))return "Wearable Manager - Hair.png";
        if(any(["dress","sundress","tunic"]))return "Wearable Manager - Dress.png";
        if(any(["skirt"]))return "Wearable Manager - Skirt.png";
        if(any(["shirt","blouse","sweater","vest"]))return "Wearable Manager - Shirt.png";
        if(any(["t-shirt","tshirt","tanktop","camisole","jersey"]))return "Wearable Manager - TShirt.png";
        if(any(["leotard","unitard","monokini"]))return "Wearable Manager - Leotard.png";
        if(any(["panties","panty","thong","underwear","swimwear","bikini"]))return "Wearable Manager - Panties.png";
        if(any(["lingerie","stocking","garter","pantyhose"]))return "Wearable Manager - Lingerie.png";
        if(any(["shoe","boot","sandal","sneaker","footwear"]))return "Wearable Manager - Shoes.png";
        if(any(["heel","stiletto"]))return "Wearable Manager - Heels.png";
        if(any(["pants","jeans","trousers","chaps"]))return "Wearable Manager - Pants.png";
        if(any(["shorts"]))return "Wearable Manager - Shorts.png";
        if(any(["suit","blazer"]))return "Wearable Manager - Suit.png";
        if(any(["jacket","coat"]))return "Wearable Manager - Jacket.png";
        if(any(["necklace","earring","bracelet","bangle","jewel","pendant"]))return "Wearable Manager - Jewelry.png";
        if(any(["belt"]))return "Wearable Manager - Belt.png";
        if(any(["glasses","eyewear","sunglasses"]))return "Wearable Manager - Sunglasses.png";
        if(any(["bag","backpack","handbag","suitcase"]))return "Wearable Manager - Bag.png";
        if(any(["nightie","nightgown","pajama","sleep"]))return "Wearable Manager - Nightie.png";
        return "Wearable Manager - Prop.png";
    }
    function ensureWardrobeEditorIconResolver() {
        if(wardrobeEditorSupportAttempted)return wardrobeEditorIconResolver;
        wardrobeEditorSupportAttempted=true;
        try{
            var support=resourcePath("Wearable Manager Support.dsa");
            if(typeof WM2Support==="undefined"&&readable(support))include(support);
            if(typeof WM2Support!=="undefined"&&WM2Support&&typeof WM2Support.load==="function"&&typeof WM2Support.createIconResolver==="function"){
                wardrobeEditorIconConfig=WM2Support.load(scriptDirectory()+"/Resources").config;
                wardrobeEditorIconResolver=WM2Support.createIconResolver(scriptDirectory()+"/Resources",function(){
                    return wardrobeEditorIconConfig&&Array.isArray(wardrobeEditorIconConfig.iconRules)?wardrobeEditorIconConfig.iconRules:[];
                });
            }
        }catch(e){print(TITLE+" wearable icon resolver: "+String(e));wardrobeEditorIconResolver=null;}
        return wardrobeEditorIconResolver;
    }
    function wardrobeEditorCatalogIconProxy(row) {
        // UI-only fallback for an item with no surviving scene instance.
        // Catalog v1 has the item's label and native root class, but does
        // not guarantee its original internal node name or asset ID.
        if(!row.itemID||!app.db||!app.db.items||!own(app.db.items,row.itemID))return null;
        var item=app.db.items[row.itemID],root=item.parts&&item.parts.length?item.parts[0]:null;
        if(!root)return null;
        var lbl=String(item.name||row.name||""),cls=String(root.className||"DzNode");
        return {name:lbl,objectName:lbl,getLabel:function(){return lbl;},className:function(){return cls;}};
    }
    // WM2Support is optional in Wardrobe Sets; its DAZ include() may not
    // publish a global when invoked from this script's IIFE. Icon rules,
    // unlike garment operations, can safely use the already-validated,
    // read-only Wearable Manager Settings.json config directly.
    function wardrobeEditorIconInfo(row,n) {
        var item=row.itemID&&app.db&&app.db.items?app.db.items[row.itemID]:null;
        var root=item&&item.parts&&item.parts.length?item.parts[0]:null;
        var name=String(root&&root.name||row.name||""),label=String(row.name||""),cls=String(root&&root.className||"DzNode"),assetId="";
        if(n){
            try{if(typeof n.name==="string")name=n.name;else if(typeof n.getName==="function")name=String(n.getName()||name);}catch(ignoreName){}
            try{if(typeof n.getLabel==="function")label=String(n.getLabel()||label);}catch(ignoreLabel){}
            try{if(typeof n.className==="function")cls=String(n.className()||cls);}catch(ignoreClass){}
            try{
                var uri=n.assetUri,path=uri&&typeof uri.filePath==="string"?uri.filePath:"",segments=path.split("/");
                if(segments.length===6)assetId=String(segments[4]||"");
            }catch(ignoreURI){}
            if(!assetId)try{if(typeof n.assetId==="string")assetId=n.assetId;}catch(ignoreAsset){}
        }
        return {name:name,label:label,className:cls,assetId:assetId};
    }
    function wardrobeEditorIconWord(textValue,pattern) {
        var text=String(textValue||"").toLowerCase(),sample=String(pattern||"").toLowerCase(),off=0,pos,end;
        if(!sample)return false;
        while((pos=text.indexOf(sample,off))>=0){
            end=pos+sample.length;
            if((pos===0||/[\s0-9_!\-\u2010-\u2015]/.test(text.charAt(pos-1)))&&
               (end===text.length||/[\s0-9_!\-\u2010-\u2015]/.test(text.charAt(end))))return true;
            off=pos+1;
        }
        return false;
    }
    function wardrobeEditorMatchIconRules(info) {
        var config=wm2Figures&&wm2Figures.config,rules=config&&Array.isArray(config.iconRules)?config.iconRules:[];
        var name=info.name.toLowerCase(),label=info.label.toLowerCase(),assetId=info.assetId.toLowerCase();
        var best=null;
        for(var i=0;i<rules.length;i++){
            var rule=rules[i];if(!rule||rule.enabled===false||!rule.pattern||!rule.icon)continue;
            var pattern=String(rule.pattern).toLowerCase(),rank=3,fieldRank=0,found=false,wordLength=0;
            if(rule.kind==="exactName"){rank=0;found=name===pattern;}
            else if(rule.kind==="exactLabel"){rank=1;found=label.replace(/ \([0-9]+\)$/,"")===pattern.replace(/ \([0-9]+\)$/,"");}
            else if(rule.kind==="exactAssetId"){rank=2;found=!!assetId&&assetId===pattern;}
            else if(rule.kind==="labelWord"){fieldRank=0;wordLength=pattern.length;found=wardrobeEditorIconWord(label,pattern);}
            else if(rule.kind==="nameWord"){fieldRank=1;wordLength=pattern.length;found=wardrobeEditorIconWord(name,pattern);}
            else if(rule.kind==="assetIdWord"){fieldRank=2;wordLength=pattern.length;found=!!assetId&&wardrobeEditorIconWord(assetId,pattern);}
            else if(rule.kind==="labelPrefix"){rank=4;found=label.indexOf(pattern)===0;}
            else if(rule.kind==="namePrefix"){rank=4;found=name.indexOf(pattern)===0;}
            if(!found)continue;
            if(!best||rank<best.rank||(rank===best.rank&&rank>=3&&
                (wordLength>best.wordLength||(wordLength===best.wordLength&&fieldRank<best.fieldRank))))
                best={icon:String(rule.icon),rank:rank,wordLength:wordLength,fieldRank:fieldRank};
        }
        return best?best.icon:"";
    }
    function wardrobeEditorWM2LegacyWord(full,part) {
        // Mirror the legacy name/label word boundary and camel-case handling.
        var s=String(full||""),p=String(part||"");if(!p)return false;
        var f=s.toLowerCase(),term=p.toLowerCase(),at=f.indexOf(term);
        if(at<0)return false;
        var previous=at>0?s.charAt(at-1):"",following=s.charAt(at+p.length);
        var edges=" _-@()0123456789!.";
        var left=at===0||edges.indexOf(previous)>=0||
            (previous===previous.toLowerCase()&&s.charAt(at)!==s.charAt(at).toLowerCase());
        var end=at+p.length,right=end===s.length||edges.indexOf(following)>=0||
            (following.toLowerCase()==="s"&&(end+1===s.length||edges.indexOf(s.charAt(end+1))>=0));
        return !!(left&&right);
    }
    var wardrobeEditorLegacyIconMaps=null;
    function wardrobeEditorLegacyMaps() {
        if(wardrobeEditorLegacyIconMaps!==null)return wardrobeEditorLegacyIconMaps;
        wardrobeEditorLegacyIconMaps={};
        var path=resourcePath("Wearable Manager.json");
        if(!readable(path))return wardrobeEditorLegacyIconMaps;
        try{
            var data=readJSON(path);
            if(data&&data.NamedIcons&&data.InharitanceIcons&&
               typeof data.NamedIcons==="object"&&typeof data.InharitanceIcons==="object")
                wardrobeEditorLegacyIconMaps={named:data.NamedIcons,inherited:data.InharitanceIcons};
        }catch(e){print(TITLE+" WM2 legacy icon map unavailable: "+String(e));}
        return wardrobeEditorLegacyIconMaps;
    }
    function wardrobeEditorLegacyMapIcon(info) {
        var maps=wardrobeEditorLegacyMaps(),inherited=maps.inherited||{},named=maps.named||{};
        function inheritance(){
            var keys=Object.keys(inherited);
            for(var i=0;i<keys.length;i++){
                var classes=inherited[keys[i]];
                if((typeof classes==="string"&&classes===info.className)||
                   (Array.isArray(classes)&&classes.indexOf(info.className)>=0))return keys[i]+".PNG";
            }return "";
        }
        function names(){
            var keys=Object.keys(named),fields=[info.name,info.label];
            for(var f=0;f<fields.length;f++){
                for(var i=0;i<keys.length;i++){
                    var values=Array.isArray(named[keys[i]])?named[keys[i]]:[named[keys[i]]];
                    for(var j=0;j<values.length;j++)if(fields[f]===values[j])return keys[i].replace(/^2-/,"")+".PNG";
                }
                for(i=0;i<keys.length;i++){
                    values=Array.isArray(named[keys[i]])?named[keys[i]]:[named[keys[i]]];
                    for(j=0;j<values.length;j++)if(wardrobeEditorWM2LegacyWord(fields[f],values[j]))
                        return keys[i].replace(/^2-/,"")+".PNG";
                }
            }return "";
        }
        if(info.className==="DzGeometryShellNode"||info.className==="DzPointLight")return names()||inheritance();
        return inheritance()||names();
    }
    function wardrobeEditorBuiltinIcon(info) {
        var s=(info.name+" "+info.label).toLowerCase();
        if(info.className==="DzGeometryShellNode"){
            if(/new genitalia|female genitalia|golden palace|goldenpalace/.test(s))return "Wearable Manager - Fgen.PNG";
            if(/breast|nipple/.test(s))return "Wearable Manager - Breasts.PNG";
            return "Wearable Manager - Shell.PNG";
        }
        if(/new genitalia|female genitalia|golden palace|goldenpalace|vagina|pussy/.test(s))return "Wearable Manager - Fgen.PNG";
        if(/armpit/.test(s))return "Wearable Manager - Armpits.PNG";
        if(/eyelash|lashes|eyebrow|brows/.test(s))return "Wearable Manager - Eyelashes.PNG";
        if(/breast|nipple/.test(s))return "Wearable Manager - Breasts.PNG";
        if(info.className==="DzGroupNode")return "Wearable Manager - Group.PNG";
        return wardrobeEditorFallbackIconName(info.label||info.name);
    }
    function wardrobeEditorPixmapFromFilename(name){
        if(!name||!readable(resourcePath(name)))return null;
        var pixmap=new Pixmap(resourcePath(name));
        return pixmap&&!pixmap.isNull()?pixmap:null;
    }
    var wardrobeEditorIconAuditSeen={};
    function wardrobeEditorReportIcon(row,info,kind,filename,pixmap){
        var token=String(row.itemID||row.nodeKey||row.name||"");
        if(!own(wardrobeEditorIconAuditSeen,token)){
            wardrobeEditorIconAuditSeen[token]=true;
            print(TITLE+" WM2_ICON_RESOLVED: "+info.label+" | source="+kind+
                " | file="+filename+" | node="+(row.iconNodeKey||row.nodeKey?"live":"catalog")+
                " | assetId="+(info.assetId?"present":"unavailable"));
        }
        return pixmap;
    }
    function wardrobeEditorItemPixmap(row) {
        var nodeKey=row.iconNodeKey||row.nodeKey||"",n=nodeKey?live(nodeKey):null;
        var source=n||wardrobeEditorCatalogIconProxy(row),info=wardrobeEditorIconInfo(row,n),px=null;
        // Rules from the same validated Wearable Manager Settings.json used for figures.
        var ruleFilename=wardrobeEditorMatchIconRules(info);
        if(ruleFilename){px=wardrobeEditorPixmapFromFilename(ruleFilename);if(px)return wardrobeEditorReportIcon(row,info,"wm2_settings_rule",ruleFilename,px);}
        // Prefer the WM Menu's shared full icon resolver if it is available.
        var resolver=ensureWardrobeEditorIconResolver(),result=null;
        try{
            if(source&&resolver&&typeof resolver.resolve==="function"){
                result=resolver.resolve(source);
                if(result&&result.source!=="default"&&result.pixmap&&!result.pixmap.isNull())return wardrobeEditorReportIcon(row,info,"wm2_runtime_"+result.source,result.icon,result.pixmap);
            }else if(source&&resolver&&typeof resolver.GetIconForWearable==="function"){
                px=resolver.GetIconForWearable(source);if(px&&!px.isNull())return wardrobeEditorReportIcon(row,info,"wm2_runtime_legacy","(resolver)",px);
            }
        }catch(e){print(TITLE+" WM2 runtime icon lookup failed for "+info.label+": "+String(e));}
        // Independent WM2 legacy JSON names/inheritance lookup, followed by
        // the compatible standard categories when WM2Support is unavailable.
        var legacyName=wardrobeEditorLegacyMapIcon(info);
        px=wardrobeEditorPixmapFromFilename(legacyName);if(px)return wardrobeEditorReportIcon(row,info,"wm2_legacy_json",legacyName,px);
        var builtinName=wardrobeEditorBuiltinIcon(info);
        px=wardrobeEditorPixmapFromFilename(builtinName);if(px)return wardrobeEditorReportIcon(row,info,"wm2_builtin",builtinName,px);
        if(result&&result.pixmap&&!result.pixmap.isNull())return wardrobeEditorReportIcon(row,info,"wm2_runtime_default",result.icon,result.pixmap);
        px=wardrobeEditorPixmapFromFilename("Wearable Manager - Prop.png");if(px)return wardrobeEditorReportIcon(row,info,"default","Wearable Manager - Prop.png",px);
        print(TITLE+" WM2_ICON_UNAVAILABLE: "+info.label+" | resourceDir="+scriptDirectory()+"/Resources"+
            " | WM2Support="+(resolver?"available":"unavailable")+" | assetId="+(info.assetId?"present":"not available"));
        return null;
    }
    function setWardrobeEditorItemIcon(button,row) {
        button.text="";button.sizedFromIcon=true;button.buttonStyle=DzPushButton.BTool;
        var px=wardrobeEditorItemPixmap(row);if(!px||px.isNull())return false;
        // Wearables Manager artwork is authored for a 91 x 91 slot. Keep that
        // native contract instead of squeezing the source into a smaller button.
        try{
            if(typeof WM2Support!=="undefined"&&WM2Support&&typeof WM2Support.setMenuPixmap==="function"){
                WM2Support.setMenuPixmap(button,px,new Size(87,87));return true;
            }
        }catch(ignoreWM2MenuPixmap){}
        button.pixmap=px;
        if(parseInt(App.versionString,10)>=6)button.getWidget().iconSize=new Size(87,87);
        return true;
    }

    function propertyEditorTargets(fig,rows,existing) {
        var out=[{targetKind:"figure",label:"Figure: "+String(fig.getLabel()),nodeKey:key(fig),itemID:"",partID:""}];
        for(var i=0;i<rows.length;i++){
            var r=rows[i],matchesExisting=!!(existing&&existing.targetKind==="item"&&((existing.itemID&&r.itemID===existing.itemID)||(!existing.itemID&&existing.nodeKey===r.nodeKey)));
            if((!r.selected&&!matchesExisting)||!r.nodeKey||!live(r.nodeKey))continue;
            var it=app.db.items[r.itemID],rootID=it&&it.parts.length?it.parts[0].id:"";
            out.push({targetKind:"item",label:"Item: "+String(r.name)+(r.selected?"":" (not currently in set)"),nodeKey:String(r.nodeKey),itemID:String(r.itemID||""),partID:rootID});
        }
        return out;
    }
    function propertyInternalName(p) {
        try{if(p&&p.name!==undefined&&String(p.name))return String(p.name);}catch(ignoreName){}
        try{if(p&&typeof p.getName==="function")return String(p.getName());}catch(ignoreGetName){}
        return "";
    }
    function overrideCandidateProperties(node) {
        var list=[];
        try{
            var tree=node&&typeof node.getPropertyGroups==="function"?node.getPropertyGroups():null;
            if(tree&&typeof tree.getAllProperties==="function")list=tree.getAllProperties();
            else if(node&&typeof node.getPropertyList==="function")list=node.getPropertyList();
        }catch(e){list=[];}
        var counts={},tmp=[],i;
        for(i=0;i<list.length;i++){
            var p=list[i];if(!p)continue;
            if(!(p.inherits("DzNumericProperty")||p.inherits("DzBoolProperty"))||typeof p.setValue!=="function")continue;
            try{if(typeof p.isHidden==="function"&&p.isHidden())continue;}catch(ignoreHidden){}
            var name=propertyInternalName(p);if(!name)continue;
            counts[name]=(counts[name]||0)+1;tmp.push({property:p,name:name});
        }
        var out=[];
        for(i=0;i<tmp.length;i++)if(counts[tmp[i].name]===1){
            var q=tmp[i].property,labelText="";
            try{labelText=String(q.getLabel());}catch(ignoreLabel){labelText=tmp[i].name;}
            var valueNow=Number(q.getValue());if(!isFinite(valueNow))continue;
            var def;
            try{def=overrideNativeDefaultValue(q,labelText||tmp[i].name);}
            catch(unsupportedDefault){continue;}
            out.push({handle:q,name:tmp[i].name,label:labelText||tmp[i].name,current:valueNow,defaultValue:def});
        }
        out.sort(function(a,b){return (a.label+"|"+a.name).localeCompare(b.label+"|"+b.name);});return out;
    }
    function overrideEditorUsesPercent(candidate) {
        try{return !!(candidate&&candidate.handle&&typeof candidate.handle.getDisplayAsPercent==="function"&&candidate.handle.getDisplayAsPercent()===true);}catch(ignore){return false;}
    }
    function overrideEditorValueText(value,candidate) {
        var n=Number(value);
        if(!isFinite(n))return String(value);
        return overrideEditorUsesPercent(candidate)?String(Math.round(n*1000000)/10000)+"%":String(n);
    }
    function parseOverrideNumber(text,what,candidate) {
        var s=trim(String(text)),hasPercent=/%$/.test(s);if(hasPercent)s=trim(s.slice(0,-1));
        if(!s)throw problem("PROPERTY_VALUE",what+" cannot be empty.");
        var n=Number(s);if(!isFinite(n))throw problem("PROPERTY_VALUE",what+" must be a finite number or percentage.");
        // In a percent-displaying property, the editor is in display units:
        // a plain 100 means 100%; native storage remains the scalar 1.0.
        return (hasPercent||overrideEditorUsesPercent(candidate))?n/100:n;
    }


    // v0.7.2: the native DAZ popup is the authority for choosing an override.
    // The popup is only available for live figure/item nodes; archived overrides
    // can still be edited as numbers or removed without loading their items.
    function overrideNativeDefaultValue(p,propertyLabel) {
        // The Reset value is the actual native DAZ default, not the lower
        // bound. Scale in particular often has an enormous negative minimum.
        if(!p || typeof p.getDefaultValue!=="function")
            throw problem("PROPERTY_DEFAULT",String(propertyLabel||"Property")+" does not expose a native default value. Choose another property or set a Reset manually.");
        var raw;
        try{raw=p.getDefaultValue();}
        catch(e){throw problem("PROPERTY_DEFAULT",String(propertyLabel||"Property")+": failed to read native default: "+String(e));}
        if(typeof raw!=="number" && typeof raw!=="boolean")
            throw problem("PROPERTY_DEFAULT",String(propertyLabel||"Property")+": native default must be numeric or boolean.");
        var n=Number(raw);
        if(!isFinite(n))throw problem("PROPERTY_DEFAULT",String(propertyLabel||"Property")+": native default is non-finite.");
        return n;
    }
    function setWardrobePropertyPreview(labelWidget,target,fig,node) {
        // DzPushButton.enabled=false was making even valid colored icons gray.
        // A noninteractive DzLabel keeps its full-color pixmap in both DAZ4/6.
        labelWidget.text="";labelWidget.alignment=target.targetKind==="figure"?0x84:0x82; // item 91px pixmap right-aligned in a 128px slot
        var px=null;
        try{
            if(target.targetKind==="figure") {
                var pth=figureVisualIconPath(fig);
                if(pth && readable(pth))px=new Pixmap(pth);
            } else {
                px=wardrobeEditorItemPixmap({name:target.label,nodeKey:node?target.nodeKey:""});
            }
            if(px && !px.isNull()) {
                if(target.targetKind==="figure")scalePixmapTo(px,128,211,false);
                else scalePixmapTo(px,91,91,false);
                labelWidget.pixmap=px;
                return true;
            }
        }catch(e){print(TITLE+" Set Properties preview: "+String(e));}
        labelWidget.text="No icon";
        return false;
    }
    function chooseNewSetOverride(node,target) {
        if(!node) return null;
        var dlg=newGeorgiaDialog();dlg.caption=TITLE+" - Add New Property";dlg.showHelpButton(false);
        dlg.setAcceptButtonText("Add Property");
        var box=new DzVGroupBox(dlg);
        label(box,"Choose a numeric property for "+target.label+".");
        var picker=new DzPropertySelectionComboBox(box);
        picker.setNode(node);picker.setNumericOnly(true);picker.setShowHidden(false);
        try{picker.setPopUpHeight(480);picker.setPopUpMinWidth(500);}catch(ignorePopupSize){}
        label(box,"Apply starts at the current value if modified, otherwise the native maximum. Reset starts at the native default. Both can be edited.");
        dlg.addWidget(box);dlg.setFixedWidth(680);
        var chosen=null;
        try{
            if(dlg.exec()) {
                var p=picker.getSelectedProperty();
                if(!p)throw problem("PROPERTY_PICK","Choose a property before pressing Add Property.");
                if(!(p.inherits("DzNumericProperty")||p.inherits("DzBoolProperty"))||typeof p.setValue!=="function")
                    throw problem("PROPERTY_TYPE","Only writable numeric properties can be added.");
                var name=propertyInternalName(p);if(!name)throw problem("PROPERTY_NAME","Selected property has no internal name.");
                var rec={targetKind:target.targetKind,itemID:target.itemID||"",nodeKey:target.nodeKey||"",partID:target.partID||"",
                    propertyName:name,propertyLabel:String(p.getLabel()||name),applyValue:0,resetValue:0};
                var loc=overrideLocatorForSelected(node,p);
                rec.propertyNodePath=loc.propertyNodePath;
                if(loc.propertyGroupPath)rec.propertyGroupPath=loc.propertyGroupPath;
                if(loc.propertyOwnerName)rec.propertyOwnerName=loc.propertyOwnerName;
                // The editor and Apply MUST use the same persistent locator.
                // Do not save a property selected on a bone if Apply only sees
                // the root, and do not silently choose a same-name property.
                var resolved=propertyHandleForOverride(node,rec);
                rec.resetValue=overrideNativeDefaultValue(resolved,rec.propertyLabel||rec.propertyName);
                rec.applyValue=initialOverrideApplyValue(resolved,rec.propertyLabel||rec.propertyName);
                checkPropertyOverrideValue(resolved,rec,rec.applyValue,"new Apply");
                checkPropertyOverrideValue(resolved,rec,rec.resetValue,"new Reset");
                chosen=rec;
            }
        }finally{dlg.deleteLater();}
        return chosen;
    }
    function setOverrideTargetMatches(rec,target) {
        if(rec.targetKind!==target.targetKind)return false;
        if(rec.targetKind==="figure")return true;
        if(rec.itemID&&target.itemID)return rec.itemID===target.itemID&&
            String(rec.partID||"")===String(target.partID||"");
        return !!rec.nodeKey&&rec.nodeKey===target.nodeKey;
    }
    function propertyOverridesDialog(input,fig,rows) {
        var working=clonePlain(input||[]),dlg=newGeorgiaDialog(true);
        dlg.caption=TITLE+" - Set Properties";
        var dialogLayout=new DzVBoxLayout(dlg);dialogLayout.margin=0;dialogLayout.spacing=0;
        var box=new DzVGroupBox(dlg);flattenGroupBox(box);box.insideMargin=0;box.insideSpacing=0;
        var area=new DzScrollArea(box);
        area.widgetResizable=true;area.setHorizontalScrollbarDisplay(false);
        // Height follows real property rows, not a memorized/tall DAZ dialog.
        // Longer lists scroll rather than expanding the dialog indefinitely.
        var content=new DzVGroupBox(area);area.setWidget(content);flattenGroupBox(content);
        var targets=[{targetKind:"figure",itemID:"",nodeKey:key(fig),label:"Figure: "+String(fig.getLabel()),row:null}],i,j;
        // Show every currently selected garment, including those whose saved
        // instances are absent. Also retain a deselected old member if it has
        // overrides so the user can explicitly remove those records.
        for(i=0;i<rows.length;i++){
            var r=rows[i],included=r.selected,hasOld=false;
            for(j=0;j<working.length;j++)if(working[j].targetKind==="item"&&
                ((working[j].itemID&&r.itemID&&working[j].itemID===r.itemID)||
                 (!working[j].itemID&&working[j].nodeKey&&working[j].nodeKey===r.nodeKey)))hasOld=true;
            if(!included&&!hasOld)continue;
            var realItemID=String(r.itemID||""),item=app.db.items[realItemID],rootPartID=item&&item.parts.length?item.parts[0].id:"";
            targets.push({targetKind:"item",itemID:realItemID,partID:rootPartID,nodeKey:String(r.nodeKey||""),label:String(r.name),row:r,inSet:included});
            // A composite item is still ONE atomic wardrobe Item, but its
            // own non-bone PartIDs are first-class property owners. Select
            // these in Set Properties without creating nested Items.
            if(item&&r.nodeKey){
                var liveRoot=live(r.nodeKey),partInfo=null;
                if(liveRoot)try{partInfo=inspectInstance(item,liveRoot);}catch(ignoreNonCurrentComposition){}
                if(partInfo&&partInfo.parts)for(var cp=1;cp<item.parts.length;cp++){
                    var child=item.parts[cp],childNode=partInfo.parts[child.id];
                    if(!childNode)continue;
                    targets.push({targetKind:"item",itemID:realItemID,partID:child.id,nodeKey:key(childNode),
                        label:"    " + String(r.name) + " / " + String(child.name||childNode.getLabel()),row:r,inSet:included});
                }
            }
        }
        // Never silently discard an archived override if its row can no
        // longer be matched. It remains editable/removable but not addable.
        for(i=0;i<working.length;i++)if(working[i].targetKind==="item"){
            var found=false;
            for(j=1;j<targets.length;j++)if(setOverrideTargetMatches(working[i],targets[j])){found=true;break;}
            if(!found)targets.push({targetKind:"item",itemID:String(working[i].itemID||""),partID:String(working[i].partID||""),
                nodeKey:String(working[i].nodeKey||""),label:"Saved Part / Item "+String(working[i].itemID||"(unresolved)"),row:null,inSet:false});
        }
        var allEntries=[],sections=[],propertyLayoutReady=false,loadedForProperties={};
        try{loadedForProperties=inventory(fig,app.db);}catch(ignoreEditorInventory){}
        function loadedOverrideNode(rec,fallback){
            if(rec.targetKind==="figure")return fig;
            if(rec.itemID&&own(loadedForProperties,rec.itemID))
                return propertyTargetNode(rec,fig,loadedForProperties);
            // A catalog item not in the current scene cannot be diagnosed as
            // missing. Preserve its stored override without false warnings.
            return rec.itemID?null:fallback;
        }
        function refreshPropertyDialogHeight(){
            if(!propertyLayoutReady)return;
            var total=12;
            for(var h=0;h<sections.length;h++){
                var sec=sections[h],active=0;
                for(var k=0;k<sec.entries.length;k++)if(!sec.entries[k].removed)active++;
                total+=Math.max(sec.target.targetKind==="figure"?220:116,98+active*40)+8;
            }
            var viewport=Math.max(175,Math.min(570,total));
            area.setFixedHeight(viewport);
            try{dlg.setFixedSize(1320,viewport+56);}catch(ignoreHeight){}
        }
        var nameFont=newGeorgiaFont();nameFont.pixelSize=14;nameFont.bold=true;
        var propertyFont=newGeorgiaFont();propertyFont.pixelSize=15;propertyFont.bold=true;
        for(i=0;i<targets.length;i++)(function(target){
            var node=target.targetKind==="figure"?fig:(target.nodeKey?live(target.nodeKey):null);
            var panel=new DzHGroupBox(content);flattenGroupBox(panel);
            // Both target previews occupy the same horizontal slot (128 px).
            // Clothing pixmaps stay at 91x91 and align right: 128-91=37 px.
            var icon=new DzLabel(panel);
            icon.setFixedSize(128,target.targetKind==="figure"?211:91);
            setWardrobePropertyPreview(icon,target,fig,node);
            var nameBox=new DzVGroupBox(panel);flattenGroupBox(nameBox);nameBox.setFixedWidth(275);
            nameBox.setFixedHeight(target.targetKind==="figure"?211:91);
            var namePad=new DzLabel(nameBox);namePad.setFixedHeight(target.targetKind==="figure"?70:19);
            var nm=label(nameBox,target.label);nm.font=nameFont;nm.wordWrap=true;
            if(target.targetKind==="figure")try{nm.getWidget().setStyleSheet("QLabel { color: #E7CA76; font-weight: bold; }");}catch(ignoreNameStyle){}
            var stateText=node?(target.inSet===false?"Not in this set":"Loaded") : "Not loaded";
            var state=label(nameBox,stateText);state.toolTip=stateText;
            if(stateText==="Loaded")try{state.getWidget().setStyleSheet("QLabel { color: #71DFA0; }");}catch(ignoreLoadedStyle){}
            var right=new DzHGroupBox(panel);flattenGroupBox(right);right.minWidth=780;
            var list=new DzVGroupBox(right);flattenGroupBox(list);list.minWidth=705;
            var add=new DzPushButton(right);add.setFixedSize(64,64);
            add.autoDefault=false;add.enabled=!!node&&target.inSet!==false;
            add.toolTip=add.enabled?"Add New Property":"Not loaded or not in this set: edit or remove saved overrides only.";
            setResourceButtonIcon(add,"Wearable Manager Add.png",64,64);
            var section={target:target,node:node,panel:panel,list:list,entries:[]};sections.push(section);
            function sizePanel(){
                var required=55+section.entries.filter(function(e){return !e.removed;}).length*40+43;
                panel.setFixedHeight(Math.max(target.targetKind==="figure"?220:116,required));
                refreshPropertyDialogHeight();
            }
            function addEditor(rec) {
                var entry={rec:clonePlain(rec),removed:false,node:node},line=new DzHGroupBox(list);flattenGroupBox(line);
                line.setFixedHeight(38);entry.line=line;
                var propName=label(line,String(rec.propertyLabel||rec.propertyName));propName.setFixedWidth(220);
                propName.font=propertyFont;propName.toolTip=String(rec.propertyName);
                var applyCaption=label(line,"Value on apply");applyCaption.setFixedWidth(100);
                var ae=new DzLineEdit(line);ae.setFixedWidth(90);
                var resetCaption=label(line,"Value on reset");resetCaption.setFixedWidth(100);
                var re=new DzLineEdit(line);re.setFixedWidth(90);
                var remove=new DzPushButton(line);remove.setFixedSize(32,32);remove.autoDefault=false;
                remove.toolTip="Remove this property override";
                setResourceButtonIcon(remove,"Wearable Manager Delete.png",24,24);
                // Explicit horizontal layout: precise 10 / 20 / 10 px control gaps.
                var valueLayout=new DzBoxLayout(line);
                valueLayout.addWidget(propName);valueLayout.addWidget(applyCaption);
                valueLayout.addSpacing(10);valueLayout.addWidget(ae);
                valueLayout.addSpacing(20);valueLayout.addWidget(resetCaption);
                valueLayout.addSpacing(10);valueLayout.addWidget(re);valueLayout.addWidget(remove);
                entry.apply=ae;entry.reset=re;entry.nameWidget=propName;
                var candidate=null;
                if(node)try{
                    var nativeNode=loadedOverrideNode(rec,node);
                    if(nativeNode)candidate={handle:propertyHandleForOverride(nativeNode,rec)};
                }catch(propertyError){
                    if(!unavailableOverrideError(propertyError))throw propertyError;
                    entry.missingReason=String(propertyError);
                }
                if(entry.missingReason){
                    try{propName.getWidget().setStyleSheet("QLabel { color: #FF5454; font-weight: bold; }");}catch(ignoreMissingColor){}
                    propName.toolTip="Missing Property: "+entry.missingReason;
                    line.toolTip=propName.toolTip;
                }
                ae.text=overrideEditorValueText(rec.applyValue,candidate);
                re.text=overrideEditorValueText(rec.resetValue,candidate);
                connect(remove,"clicked()",function(){entry.removed=true;line.hide();sizePanel();});
                section.entries.push(entry);allEntries.push(entry);sizePanel();
            }
            for(var q=0;q<working.length;q++)if(setOverrideTargetMatches(working[q],target))addEditor(working[q]);
            connect(add,"clicked()",function(){
                try{
                    var rec=chooseNewSetOverride(node,target);if(!rec)return;
                    var id=propertyOverrideKey(rec);
                    for(var e=0;e<allEntries.length;e++)if(!allEntries[e].removed&&propertyOverrideKey(allEntries[e].rec)===id){
                        MessageBox.warning("This property already has an override.",TITLE,"&OK");return;
                    }
                    addEditor(rec);
                }catch(error){MessageBox.warning(userErrorText(error),TITLE,"&OK");}
            });
            sizePanel();
        })(targets[i]);
        // A 36px action row plus exactly 10px padding on each side.
        // Plain DzDialog avoids the hidden DzBasicDialog button-row reserve.
        var footer=new DzWidget(box),footerLayout=new DzHBoxLayout(footer);
        footerLayout.margin=10;footerLayout.spacing=10;footer.setFixedHeight(56);
        var save=new DzPushButton(footer),cancel=new DzPushButton(footer);
        wardrobePolicyActionStyle(save,"Use Properties",150,"#69B58A","#33483D");
        wardrobePolicyActionStyle(cancel,"Cancel",120,"#B87B7B","#453737");
        footerLayout.addStretch(1);footerLayout.addWidget(save);footerLayout.addWidget(cancel);
        var result=null;
        connect(cancel,"clicked()",function(){dlg.close();});
        connect(save,"clicked()",function(){
            try{
                var out=[],seen={};
                for(var e=0;e<allEntries.length;e++){
                    var entry=allEntries[e];if(entry.removed)continue;
                    var r=clonePlain(entry.rec),p=null,candidate=null;
                    if(entry.node){
                        try{
                            var nativeNode=loadedOverrideNode(r,entry.node);
                            if(nativeNode){p=propertyHandleForOverride(nativeNode,r);candidate={handle:p};entry.missingReason="";}
                        }catch(propertyError){
                            if(!unavailableOverrideError(propertyError))throw propertyError;
                            entry.missingReason=String(propertyError);
                            try{entry.nameWidget.getWidget().setStyleSheet("QLabel { color: #FF5454; font-weight: bold; }");}catch(ignoreMissingColor){}
                            entry.nameWidget.toolTip="Missing Property: "+entry.missingReason;
                        }
                    }
                    r.applyValue=parseOverrideNumber(entry.apply.text,"Apply for "+r.propertyName,candidate);
                    r.resetValue=parseOverrideNumber(entry.reset.text,"Reset for "+r.propertyName,candidate);
                    if(p){
                        checkPropertyOverrideValue(p,r,r.applyValue,"editor Apply");
                        checkPropertyOverrideValue(p,r,r.resetValue,"editor Reset");
                    }
                    var k=propertyOverrideKey(r);if(!k||own(seen,k))throw problem("PROPERTY_DUPLICATE","Duplicate override: "+r.propertyName);
                    seen[k]=true;out.push(r);
                }
                result=out;dlg.close();
            }catch(error){MessageBox.warning(userErrorText(error),TITLE,"&OK");}
        });
        dialogLayout.addWidget(box);propertyLayoutReady=true;refreshPropertyDialogHeight();
        try{dlg.exec();}finally{dlg.deleteLater();}
        // Ask on closing the Properties dialog, whether saved or cancelled.
        // Cancel discards other edits; confirmed cleanup alone is returned to
        // the outer Set Editor (which still requires Save Set to persist it).
        var missingEntries=[];
        for(var me=0;me<allEntries.length;me++){
            var record=allEntries[me];
            if(!record.removed&&record.missingReason)missingEntries.push(record);
        }
        if(missingEntries.length){
            var seenMissing={},names=[];
            for(var mi=0;mi<missingEntries.length;mi++){
                var mr=missingEntries[mi].rec,mk=propertyOverrideKey(mr);
                if(!own(seenMissing,mk)){
                    seenMissing[mk]=true;
                    names.push("- "+String(mr.propertyLabel||mr.propertyName));
                }
            }
            var removeMissing=MessageBox.warning(names.length+" unresolved Property Override(s):\n"+
                names.slice(0,15).join("\n")+(names.length>15?"\n...":"")+
                "\n\nRemove them from this outfit set? Choosing Keep preserves the entries so they can work again if their properties return. Changes are saved only after you press Save Set in the outfit editor.",
                TITLE+" - Missing Properties","&Remove Missing","&Keep");
            if(removeMissing===0){
                if(result===null)result=clonePlain(working);
                var cleaned=[];
                for(var ri=0;ri<result.length;ri++)if(!own(seenMissing,propertyOverrideKey(result[ri])))cleaned.push(result[ri]);
                result=cleaned;
            }
        }
        return result;
    }

    // DAZ Studio 4.24+ provides DzDesktopWidget::availableGeometry(QWidget).
    // The work area excludes taskbars; position within it with a safety
    // margin instead of hoping the window manager centers a fixed 720px UI.
    function resizeEditorToWorkArea(dlg,width,wantedHeight,preservePosition){
        var rect=null,work=null;
        function rectNumber(record,key){
            if(!record)return NaN;
            try{var v=record[key];return Number(typeof v==="function"?v.call(record):v);}catch(ignore){return NaN;}
        }
        try{
            var desktop=new DzDesktopWidget();
            var main=MainWindow&&typeof MainWindow.getWidget==="function"?MainWindow.getWidget():null;
            rect=main?desktop.availableGeometry(main):desktop.availableGeometry();
            var x=rectNumber(rect,"x"),y=rectNumber(rect,"y"),w=rectNumber(rect,"width"),h=rectNumber(rect,"height");
            if(isFinite(x)&&isFinite(y)&&isFinite(w)&&isFinite(h)&&w>400&&h>400)
                work={x:x,y:y,width:w,height:h};
        }catch(ignoreDesktopGeometry){}
        // In very old/unsupported Qt wrappers the original safe cap remains.
        var height=work?Math.max(300,Math.min(wantedHeight,work.height-80)):
            Math.min(wantedHeight,720);
        dlg.setFixedSize(width,height);
        if(preservePosition)return;
        if(!work)return;
        var left=work.x+Math.max(10,Math.floor((work.width-width)/2));
        var top=work.y+Math.max(22,Math.floor((work.height-height)/2));
        top=Math.min(top,work.y+work.height-height-35);
        top=Math.max(work.y+12,top);
        // setGeometry for top-level DzDialog uses desktop coordinates.
        // On a standard monitor with y=0, the title remains strictly above 0.
        try{dlg.setGeometry(Math.round(left),Math.round(top),width,height);}catch(ignorePlacement){}
    }

    // Remap durable identifiers, including metadata JSON embedded in DUF strings.
    function remapBindingIDs(value,map) {
        if(typeof value==="string"){var ids=Object.keys(map);for(var i=0;i<ids.length;i++)value=value.split(ids[i]).join(map[ids[i]]);return value;}
        if(value===null||typeof value!=="object")return value;
        if(value instanceof Array)return value.map(function(v){return remapBindingIDs(v,map);});
        var out={},keys=Object.keys(value);
        for(var j=0;j<keys.length;j++)out[remapBindingIDs(keys[j],map)]=remapBindingIDs(value[keys[j]],map);
        return out;
    }
    function rebindSetToFigure(payload,fig) {
        if(!payload||payload.commitID!==app.db.commitID)throw problem("REBIND_STALE","The library changed. Reopen the Set Editor.");
        var src=app.db.sets[payload.id],type=String(fig.objectName);
        if(!src||src.scope.kind!=="figure")throw problem("REBIND_SCOPE","Choose a saved Specific Figure set.");
        var cross=type!==src.figureType;
        if(cross&&payload.confirmedTargetType!==type)throw problem("BIND_CONFIRM","Confirm the different Genesis type in the figure picker.");
        var targetID=figureIdentity(fig,true);
        if(src.scope.figureID===targetID)throw problem("BIND_OWNER","Choose another figure.");
        var next=clonePlain(app.db),st=clonePlain(src),map={},presets=[];
        if(cross){
            // Independent item definitions preserve the source set and its native presets.
            for(var i=0;i<src.items.length;i++){
                var original=app.db.items[src.items[i]];validatePreset(original);
                map[original.id]=unique("item");map[original.variantID]=unique("variant");
                for(var j=0;j<original.parts.length;j++)map[original.parts[j].id]=unique("part");
            }
            for(var k=0;k<src.items.length;k++){
                var old=app.db.items[src.items[k]],item=remapBindingIDs(old,map);
                item.figureType=type;item.preset="Items/"+item.id+".duf";item.created=String(new Date());
                if(item.transitionPolicy){
                    item.transitionPolicy.replacementIDs=item.transitionPolicy.replacementIDs.filter(function(id){return Object.keys(map).some(function(key){return map[key]===id;});});
                }
                next.items[item.id]=item;
                presets.push({item:item,data:remapBindingIDs(readJSON(inLibrary(old.preset)),map)});
            }
            st=remapBindingIDs(st,map);st.properties=[];st.handPoses={};
        }
        st.id=unique("set");st.figureType=type;st.scope={kind:"figure",figureID:targetID};
        var base=src.name+" - "+String(fig.getLabel()),name=base,n=2;
        while(Object.keys(next.sets).some(function(id){return next.sets[id].name===name;}))name=base+" ("+(n++)+")";
        st.name=name;st.created=String(new Date());st.modified=st.created;
        next.sets[st.id]=st;
        validateCatalog(next,next.libraryID);
        for(var q=0;q<presets.length;q++){
            writeNewJSON(inLibrary(presets[q].item.preset),presets[q].data);
            validatePreset(presets[q].item);
        }
        commitCatalog(next,app.catalogFile);ctx.catalogCommitted=true;ctx.diag.duplicateSetID=st.id;
        ctx.outcome="Created "+st.name+". Original set unchanged; no clothing applied."+
            (cross?" Property Overrides and hand poses omitted. DAZ fitting occurs when the copy is applied.":"");
        log("PASS","SET_BOUND_COPY",ctx.outcome);
    }
    function rebindFigurePicker(st,commitID) {
        var figures=sceneNodes().filter(function(n){return isFigure(n)&&figureIdentity(n,false)!==st.scope.figureID;}),
            dlg=newGeorgiaDialog(true),result=null,selected=-1,buttons=[];
        dlg.caption=TITLE+" - Bind to Another Figure";
        var layout=new DzVBoxLayout(dlg);layout.margin=8;layout.spacing=6;
        layout.addWidget(label(dlg,"Create a copy of '"+st.name+"' for another scene figure. The original stays unchanged."));
        var scroll=new DzScrollArea(dlg);scroll.widgetResizable=true;
        var body=new DzWidget(scroll),rows=new DzVBoxLayout(body);rows.margin=4;rows.spacing=5;
        function refresh(){
            for(var i=0;i<buttons.length;i++){
                var cross=String(figures[i].objectName)!==st.figureType,on=i===selected;
                var bg=cross?(on?"#ffd0a0":"#70451f"):(on?"#b7e6b7":"#234b30");
                buttons[i].getWidget().setStyleSheet("QPushButton { text-align: left; padding: 10px; border: 1px solid #888; background-color: "+bg+"; color: "+(on?"#182018":"#ffffff")+"; }");
            }
            go.enabled=selected>=0;
        }
        for(var i=0;i<figures.length;i++)(function(index){
            var f=figures[index],button=new DzPushButton(body);
            button.text=String(f.getLabel())+"  ["+String(f.objectName)+"]"+
                (String(f.objectName)!==st.figureType?"  - different Genesis type":"");
            button.autoDefault=false;button.setFixedHeight(52);rows.addWidget(button);buttons.push(button);
            connect(button,"clicked()",function(){selected=index;refresh();});
        })(i);
        rows.addStretch(1);scroll.setWidget(body);layout.addWidget(scroll);
        if(!figures.length)layout.addWidget(label(dlg,"No other supported figures in the scene."));
        var footer=new DzWidget(dlg),bar=new DzHBoxLayout(footer);bar.margin=0;
        var go=new DzPushButton(footer),cancel=new DzPushButton(footer);
        go.text="Create Bound Copy";cancel.text="Cancel";go.autoDefault=cancel.autoDefault=false;
        go.setFixedHeight(32);cancel.setFixedHeight(32);bar.addWidget(go);bar.addWidget(cancel);layout.addWidget(footer);
        connect(cancel,"clicked()",function(){dlg.close();});
        connect(go,"clicked()",function(){
            var target=selected>=0?live(key(figures[selected])):null;
            if(!target||!isFigure(target)){MessageBox.warning("The selected figure is no longer in the scene.",TITLE,"&OK");return;}
            var type=String(target.objectName),cross=type!==st.figureType;
            var message="Create a copy of '"+st.name+"' bound to '"+target.getLabel()+"'? The original set stays unchanged. No clothing will be applied. Unsaved Set Editor changes are not included.";
            if(cross)message+="\n\nDifferent Genesis type: "+st.figureType+" -> "+type+". Property Overrides and hand poses will be removed from the copy. DAZ may ask you to AutoFit clothing when applying it; results depend on the clothing and available converters.";
            if(MessageBox.question(message,TITLE+(cross?" - Different Genesis Type":""),"&Create Copy","&Cancel")!==0)return;
            result={id:st.id,commitID:commitID,figureKey:key(target),confirmedTargetType:type};dlg.close();
        });
        refresh();dlg.setFixedSize(650,Math.min(520,150+Math.max(1,figures.length)*57));
        try{dlg.exec();}finally{dlg.deleteLater();}return result;
    }
    function editorDialog(id,fig) {
        var old=id?app.db.sets[id]:null;if(id&&!old)throw problem("SET_MISSING",id);
        if(old&&old.figureType!==String(fig.objectName))throw problem("FIGURE_TYPE","Select "+old.figureType+" to edit this set.");
        var baseCommit=app.db.commitID,rows=collectEditorRows(old,fig),kindNames=["type","label","figure"];
        var dlg=newGeorgiaDialog();dlg.caption=TITLE+(old?" - Edit Outfit Set":" - New Outfit Set");
        dlg.showHelpButton(false);dlg.showAcceptButton(false);dlg.showCancelButton(false);
        var userSaveRequested=false,editorSaveButton=null,editorCanSave=false,editorPlaced=false,acceptedPayload=null,rebindRequest=null;
        // DAZ 4 can place a tall fixed dialog partly above the screen.
        // Scroll the entire editor, not just the outfit-item columns; this
        // keeps its title, availability and icon controls reachable.
        var editorScroll=new DzScrollArea(dlg);
        editorScroll.widgetResizable=true;
        editorScroll.setHorizontalScrollbarDisplay(false);
        var box=new DzVGroupBox(editorScroll);
        function sectionHeading(textValue,parent){
            var heading=label(parent||box,textValue),font=newGeorgiaFont();
            font.pixelSize=17;font.bold=true;heading.font=font;
            heading.alignment=0x84;heading.setFixedHeight(30);
            try{heading.getWidget().setStyleSheet("QLabel { color: #87CEEB; font-weight: bold; }");}catch(ignoreSectionStyle){}
            return heading;
        }
        var figProfile=figureProfileForType(String(fig.objectName),true),figTypeLabel=figProfile?figProfile.name:String(fig.objectName);
        var figureTitle=label(box,"Figure: "+fig.getLabel()+" ["+figTypeLabel+"]"),figureTitleFont=newGeorgiaFont();
        figureTitleFont.pixelSize=20;figureTitleFont.bold=true;figureTitle.font=figureTitleFont;figureTitle.alignment=0x84;
        try{figureTitle.getWidget().setStyleSheet("QLabel { color: #87CEEB; font-weight: bold; }");}catch(ignoreFigureTitleStyle){}
        var nr=new DzHGroupBox(box);label(nr,"Name:");var name=new DzLineEdit(nr);name.text=old?old.name:"New Wardrobe Set";name.minWidth=520;

        var groupRow=new DzHGroupBox(box);label(groupRow,"Group:");
        var groupCombo=new DzComboBox(groupRow),newGroupButton=new DzPushButton(groupRow),
            editorGroups=[{id:"",name:"Default"}].concat(setGroupEntries(app.db));
        groupCombo.minWidth=380;
        for(var gx=0;gx<editorGroups.length;gx++)groupCombo.addItem(editorGroups[gx].name);
        var initialGroup=old?setGroupID(old):"";
        for(gx=0;gx<editorGroups.length;gx++)if(editorGroups[gx].id===initialGroup){groupCombo.currentItem=gx;break;}
        newGroupButton.text="Manage Groups...";newGroupButton.setFixedSize(145,32);newGroupButton.autoDefault=false;
        newGroupButton.toolTip="Create, rename or delete groups. Changes are saved to the library immediately.";
        connect(newGroupButton,"clicked()",function(){
            var originallySelected=editorGroups[groupCombo.currentItem]||editorGroups[0];
            var selectedID=originallySelected.id;
            try{
                selectedID=manageGroupsDialog(selectedID);
                // The Group Manager commits a new catalog revision independently.
                // Preserve all unsaved Set fields, but rebase this editor so its
                // eventual Save Set does not fail with an artificial stale ID.
                app.db=readCatalog();baseCommit=app.db.commitID;
                editorGroups=[{id:"",name:"Default"}].concat(setGroupEntries(app.db));
                groupCombo.clear();
                var nextIndex=0;
                for(var gi=0;gi<editorGroups.length;gi++){
                    groupCombo.addItem(editorGroups[gi].name);
                    if(editorGroups[gi].id===selectedID)nextIndex=gi;
                }
                groupCombo.currentItem=nextIndex;
            }catch(groupError){
                MessageBox.warning(userErrorText(groupError),TITLE+" - Manage Groups","&OK");
            }
        });

        var groupScoped=new DzCheckBox(box);
        groupScoped.text="Replace Items Within This Group Only";
        groupScoped.checked=!!(old&&old.replaceWithinGroup===true);
        groupScoped.toolTip="When applying this Set, change only registered items belonging to compatible Sets in the same Group. Outside groups stay worn; explicit item Keep/Replace rules still apply.";
        groupScoped.setFixedHeight(28);

        var sr=new DzHGroupBox(box);label(sr,"Available for:");
        var scopeIndex=old?kindNames.indexOf(old.scope.kind):0,scopeButtons=[],scopeNames=["Genesis Type","Exact Figure Label","Specific Figure"];
        function setScope(index){
            scopeIndex=index;
            for(var bi=0;bi<scopeButtons.length;bi++){
                var chosen=(bi===scopeIndex);
                scopeButtons[bi].checked=chosen;
                wardrobeTransitionStyle(scopeButtons[bi],chosen,true);
            }
            refreshScope();
            if(typeof refreshRows==="function" && typeof controls!=="undefined" && controls)refreshRows();
        }
        for(var si=0;si<scopeNames.length;si++)(function(index){
            var b=new DzPushButton(sr);b.text=scopeNames[index];b.checkable=true;b.autoDefault=false;b.setFixedHeight(36);b.minWidth=180;
            scopeButtons.push(b);connect(b,"clicked()",function(){setScope(index);});
        })(si);
        var scopeLabel=new DzLineEdit(box);scopeLabel.text=figureIconBaseLabel(old&&old.scope.kind==="label"?old.scope.label:fig.getLabel());scopeLabel.toolTip="Matches this label and its numbered copies, such as Helen (2) and Helen (3).";scopeLabel.minWidth=300;
        var rebind=new DzPushButton(box);rebind.text="Bind to Another Figure...";rebind.autoDefault=false;rebind.setFixedHeight(32);
        connect(rebind,"clicked()",function(){try{var request=rebindFigurePicker(old,baseCommit);if(request){rebindRequest=request;dlg.close();}}catch(e){MessageBox.warning(userErrorText(e),TITLE,"&OK");}});
        function refreshScope(){
            scopeLabel.enabled=scopeIndex===1;
            if(scopeIndex===1)scopeLabel.show();else scopeLabel.hide();
            rebind.enabled=!!(old&&old.scope.kind==="figure"&&scopeIndex===2);
            if(rebind.enabled)rebind.show();else rebind.hide();
        }
        setScope(scopeIndex);

        var propertyOverrides=clonePlain(old&&Array.isArray(old.properties)?old.properties:[]);
        // v0.7.9: One horizontal, borderless section. Set Icon on the left,
        // Set Properties on the right, with independent heading and controls.
        var setVisuals=new DzHGroupBox(box),setIconColumn=new DzVGroupBox(setVisuals),setPropertyColumn=new DzVGroupBox(setVisuals);
        flattenGroupBox(setVisuals);flattenGroupBox(setIconColumn);flattenGroupBox(setPropertyColumn);
        setVisuals.insideMargin=0;setVisuals.insideSpacing=12;setVisuals.setFixedHeight(255);
        setIconColumn.setFixedWidth(422);setPropertyColumn.minWidth=500;
        sectionHeading("Set Icon",setIconColumn);
        sectionHeading("Set Properties",setPropertyColumn);

        // Ten-pixel left inset. The icon caption is BELOW the preview, not over
