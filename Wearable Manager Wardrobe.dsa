                persistControls();
                action={type:"restore_materials",id:st.id,itemIDs:chosen,commitID:app.db.commitID,figureKey:key(fig)};
                dlg.close();
            }catch(e){MessageBox.warning(userErrorText(e),TITLE+" - Restore Materials","&OK");}
        }
