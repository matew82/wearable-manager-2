    function channelTimingSummary(samples) {
        var out={}, fields=["controls","controlRequests","controlResolutionMs","evaluatedMs","rawMs",
            "controllerCountMs","lockedMs","formatMs","rawUnavailable","controllerCountUnavailable","lockedUnavailable"];
        for(var i=0;i<samples.length;i++) {
            var s=samples[i],r=out[s.kind];
            if(!r) {
                r=out[s.kind]={sampledNodes:0,completeNodes:0,classes:{}};
                for(var j=0;j<fields.length;j++)r[fields[j]]=0;
            }
            r.sampledNodes++;if(s.complete)r.completeNodes++;
            r.classes[s.nodeClass]=(r.classes[s.nodeClass]||0)+1;
            for(var k=0;k<fields.length;k++)r[fields[k]]+=s[fields[k]]||0;
        }
        return out;
    }


    function skeletonBonePath(n, owner) {
        var path = [], b = n;
        while (b && b.inherits("DzBone")) { path.unshift(String(b.name)); b = b.getNodeParent(); }
        return same(b, owner) ? path : null;
    }
    function resolveBonePath(owner, path) {
        var node = owner;
        for (var i = 0; node && i < path.length; i++) {
            var children = node.getNodeChildren(false), matches = [];
            for (var j = 0; j < children.length; j++)
                if (children[j].inherits("DzBone") && String(children[j].name) === path[i]) matches.push(children[j]);
            if (matches.length !== 1) return null;
            node = matches[0];
        }
        return node;
    }
    // Item transition rules belong to the registered catalog item, NOT to a
    // particular Outfit Set. Old catalogs default to Remove. Replacement IDs
    // refer only to stable registered Item IDs of the SAME figure type.
    function itemTransitionPolicy(item){
        var p=item&&item.transitionPolicy;
        if(!p)return {mode:"remove",replacementIDs:[]};
        return {mode:String(p.mode),replacementIDs:Array.isArray(p.replacementIDs)?p.replacementIDs.slice(0):[]};
    }
    function validateItemTransitionPolicy(policy,id,catalog){
        if(policy===undefined||policy===null)return;
        expectObject(policy,"Transition policy");
        var keys=Object.keys(policy).sort();
        if(keys.join("|")!=="mode|replacementIDs")throw problem("TRANSITION_SCHEMA","Expected mode and replacementIDs for "+id);
        if(["remove","keep","replace"].indexOf(policy.mode)<0)throw problem("TRANSITION_MODE",id);
        expectList(policy.replacementIDs,"Replacement IDs");
        if(policy.replacementIDs.length>256)throw problem("TRANSITION_LIST","Too many replacements for "+id);
        if(policy.mode!=="replace"&&policy.replacementIDs.length)throw problem("TRANSITION_LIST","Only Replace If Needed has replacements: "+id);
        var seen={};
        for(var t=0;t<policy.replacementIDs.length;t++){
            var other=policy.replacementIDs[t];checkedID(other,"Replacement ID");
            if(other===id||own(seen,other)||!own(catalog,other)||catalog[other].figureType!==catalog[id].figureType)
                throw problem("TRANSITION_REPLACEMENT","Invalid replacement for "+id+": "+other);
            seen[other]=true;
        }
    }
    function transitionCanRemain(item,incomingIDs){
        var p=itemTransitionPolicy(item);
        if(p.mode==="keep")return true;
        if(p.mode!=="replace")return false;
        for(var i=0;i<p.replacementIDs.length;i++)if(incomingIDs.indexOf(p.replacementIDs[i])>=0)return false;
        return true;
    }
    // v0.9.8: Group-scoped transitions are a property of a SET, not a
    // permanent grouping of the underlying registered item. The domain is
    // the union of itemIDs in compatible sets of the same presentation group.
    // Unknown or disabled scopes never authorize removing a live item.
    function groupScopedDomain(st,fig,db){
        if(!st||st.replaceWithinGroup!==true)return null;
        var groupID=setGroupID(st),domain={},ids=Object.keys(db.sets);
        for(var i=0;i<ids.length;i++){
            var other=db.sets[ids[i]];
            if(other.figureType!==st.figureType||setGroupID(other)!==groupID)continue;
            if(fig){try{if(scopeProblem(other,fig))continue;}catch(scopeError){continue;}}
            for(var j=0;j<other.items.length;j++)domain[other.items[j]]=true;
        }
        for(i=0;i<st.items.length;i++)domain[st.items[i]]=true;
        return domain;
    }
    function assertGroupRemovalUnambiguous(st,fig,activeIDs,desiredIDs,domain,db){
        if(!domain)return;
        var requested={},others=Object.keys(db.sets);
        for(var i=0;i<desiredIDs.length;i++)requested[desiredIDs[i]]=true;
        for(i=0;i<activeIDs.length;i++){
            var itemID=activeIDs[i];
            if(!own(domain,itemID)||own(requested,itemID))continue;
            if(transitionCanRemain(db.items[itemID],desiredIDs))continue;
            for(var j=0;j<others.length;j++){
                var outside=db.sets[others[j]];
                if(outside.figureType!==st.figureType||setGroupID(outside)===setGroupID(st)||
                    outside.items.indexOf(itemID)<0)continue;
                try{if(scopeProblem(outside,fig))continue;}catch(ignoreScope){continue;}
                throw problem("GROUP_SHARED_ITEM",db.items[itemID].name+
                    " belongs to sets in both '"+groupDisplayName(st,db)+"' and '"+
                    groupDisplayName(outside,db)+"'. A group-scoped Apply cannot remove it safely. "+
                    "Use an explicit Keep/Replace rule for this item or separate the group membership.");
            }
        }
    }
    function transitionEffectiveIDs(desiredIDs,activeIDs,catalog,mode,groupDomain){
        if(["follow_rules","keep_all","take_all"].indexOf(mode)<0)
            throw problem("TRANSITION_MODE","Unsupported outfit removal mode: "+mode);
        var result=desiredIDs.slice(0),want={};
        for(var i=0;i<result.length;i++){
            if(!own(catalog,result[i])||own(want,result[i]))throw problem("TRANSITION_ITEM","Unknown or repeated desired item: "+result[i]);
            want[result[i]]=true;
        }
        for(i=0;i<activeIDs.length;i++){
            var id=activeIDs[i],item=catalog[id];
            if(!item)throw problem("TRANSITION_ITEM","Unknown active registered item: "+id);
            if(own(want,id))continue;
            if(mode==="keep_all"||(mode==="follow_rules"&&
                (groupDomain&&!own(groupDomain,id)||transitionCanRemain(item,desiredIDs)))){
                result.push(id);want[id]=true;
            }
        }
        return result;
    }
    function effectiveSetForTransition(st,fig,mode){
        var inv=inventory(fig,app.db),ids=Object.keys(inv),active=[];
        for(var i=0;i<ids.length;i++)if(inv[ids[i]].where==="active")active.push(ids[i]);
        var groupDomain=mode==="follow_rules"?groupScopedDomain(st,fig,app.db):null;
        if(groupDomain)assertGroupRemovalUnambiguous(st,fig,active,st.items,groupDomain,app.db);
        var idsWanted=transitionEffectiveIDs(st.items,active,app.db.items,mode,groupDomain),retained={};
        for(i=0;i<idsWanted.length;i++)if(st.items.indexOf(idsWanted[i])<0)retained[idsWanted[i]]=true;
        var copy=clonePlain(st);copy.items=idsWanted;
        // Material presets and Property Overrides remain limited to the
        // requested Set; retained accessories are NOT silently restyled.
        return {set:copy,retained:retained,active:active};
    }
    function transitionPropertyShouldRemain(rec){
        return !!(ctx&&ctx.action==="apply"&&ctx.transitionRetainedIDs&&rec&&rec.targetKind==="item"&&
            own(ctx.transitionRetainedIDs,rec.itemID));
    }

    function calculatePlan(activeIDs, desiredIDs, inventory, catalog) {
        var wanted = {}, current = {}, plan = {keep: [], store: [], restore: [], load: [], desired: desiredIDs.slice(0)};
        for (var i = 0; i < desiredIDs.length; i++) {
            var id = desiredIDs[i];
            if (!own(catalog, id)) throw problem("UNKNOWN_ITEM", id);
            if (own(wanted, id)) throw problem("DUPLICATE_SET_ITEM", id);
            wanted[id] = true;
        }
        for (var a = 0; a < activeIDs.length; a++) {
            var aid = activeIDs[a];
            if (own(current, aid) || !own(catalog, aid) || !inventory[aid] || inventory[aid].where !== "active")
                throw problem("INVALID_INVENTORY", aid);
            current[aid] = true;
            if (own(wanted, aid)) plan.keep.push(aid); else plan.store.push(aid);
        }
        for (var j = 0; j < desiredIDs.length; j++) {
            var did = desiredIDs[j], location = inventory[did] ? inventory[did].where : "missing";
            if (own(current, did)) continue;
            if (location === "stored") plan.restore.push(did);
            else if (location === "missing") plan.load.push(did);
            else throw problem("INVALID_INVENTORY", did + " / " + location);
        }
        plan.noop = !plan.store.length && !plan.restore.length && !plan.load.length;
        return plan;
    }
    function newGeorgiaFont() {
        var f = new Font();
        try { f.family = "Georgia"; } catch (ignoreGeorgiaFamily) {}
        return f;
    }
    function newGeorgiaDialog(plain) {
        var d = plain ? new DzDialog() : new DzBasicDialog();
        try { d.font = newGeorgiaFont(); } catch (ignoreGeorgiaDialogFont) {}
        try { d.getWidget().setStyleSheet("QWidget { font-family: 'Georgia'; }"); }
        catch (ignoreGeorgiaDialogStyle) {}
        return d;
    }
    function label(parent, text) { var w = new DzLabel(parent); w.text = text; w.wordWrap = true; return w; }

    // Persistent library format. Each catalog revision is immutable. A staged
    // file is verified and renamed to a NEW final name; old revisions survive.
    function jsonText(o) {
        return JSON.stringify(o, null, 2).replace(/[\u007f-\uffff]/g, function (c) {
            return "\\u" + ("0000" + c.charCodeAt(0).toString(16)).slice(-4);
        });
    }
    function pathExists(path) {
        var f = new DzFileInfo(path);
        try { return f.exists(); } finally { f.deleteLater(); }
    }
    function readable(path) {
        var f = new DzFile(path);
        try { return f.exists() && f.size() > 0 && f.open(DzFile.ReadOnly); }
        finally { f.close(); f.deleteLater(); }
    }
    function listFiles(dirPath, pattern) {
        var d = new DzDir(dirPath);
        try {
            if (!d.exists() || !d.isReadable()) throw problem("DIRECTORY_UNREADABLE", dirPath);
            return d.entryList(pattern, DzDir.Files, DzDir.Name);
        } finally { d.deleteLater(); }
    }
    function canonicalDirectory(path, create) {
        var s = trim(path).replace(/\\/g, "/"), d;
        if (!s) throw problem("LIBRARY_PATH", "Choose a library folder.");
        if (create) mkdir(s);
        d = new DzDir(s);
        try {
            if (!d.exists() || !d.isReadable()) throw problem("LIBRARY_UNAVAILABLE", s + ". Reconnect the correct library; no empty replacement was created.");
            var p = String(d.canonicalPath() || d.absolutePath()).replace(/\\/g, "/");
            return p.replace(/\/+$/, "");
        } finally { d.deleteLater(); }
    }
    function safeRelative(s) {
        if (typeof s !== "string" || !s || s.indexOf("\\") >= 0 || /^\//.test(s) || /[:\x00-\x1f]/.test(s))
            throw problem("INVALID_RELATIVE_PATH", String(s));
        var a = s.split("/");
        for (var i = 0; i < a.length; i++) if (!a[i] || a[i] === "." || a[i] === "..") throw problem("INVALID_RELATIVE_PATH", s);
        return s;
    }
    function inLibrary(s) { return app.libraryPath + "/" + safeRelative(s); }
    function readJSON(path) {
        try { return JSON.parse(readText(path).replace(/^\uFEFF/, "")); }
        catch (e) { throw problem("JSON_READ", path + " / " + String(e)); }
    }
    function renameNew(from, to) {
        if (pathExists(to)) throw problem("FILE_ALREADY_EXISTS", to);
        var f = new DzFile(from);
        try { if (!f.rename(to)) throw problem("FILE_RENAME", from + " -> " + to); }
        finally { f.deleteLater(); }
        if (!pathExists(to)) throw problem("FILE_RENAME_VERIFY", to);
    }
    function writeNewJSON(path, o) {
        if (pathExists(path)) throw problem("FILE_ALREADY_EXISTS", path);
        var tmp = path + ".pending_" + unique("write");
        writeText(tmp, jsonText(o), false);
        if (jsonText(readJSON(tmp)) !== jsonText(o)) throw problem("FILE_VERIFY", tmp);
        renameNew(tmp, path);
        return path;
    }
    function padRevision(n) { return ("0000000000" + n).slice(-10); }
    function checkedID(s, context) {
        if (typeof s !== "string" || !/^matew_[a-zA-Z0-9_]+$/.test(s)) throw problem("INVALID_ID", context);
        return s;
    }
    function expectObject(o, message) {
        if (!o || typeof o !== "object" || Array.isArray(o)) throw problem("SCHEMA", message);
    }
    function expectList(a, message) { if (!Array.isArray(a)) throw problem("SCHEMA", message); }
    function validatePortableRef(d, partIDs) {
        expectObject(d, "Reference descriptor");
        if (d.kind === "none" || d.kind === "figure") return;
        if (d.kind === "part" || d.kind === "part-bone") {
            if (!own(partIDs, d.partID)) throw problem("SCHEMA", "Reference to an unknown part.");
            if (d.kind === "part") return;
        } else if (d.kind !== "figure-bone") throw problem("SCHEMA", "Unsupported portable reference " + d.kind);
        expectList(d.path, "Bone path");
        if (!d.path.length) throw problem("SCHEMA", "Empty bone path");
        for (var i = 0; i < d.path.length; i++) if (typeof d.path[i] !== "string" || !d.path[i]) throw problem("SCHEMA", "Invalid bone path");
    }
    function propertyOverrideKey(rec) {
        if (!rec) return "";
        // Native picker can select a control on a figure bone or a provider.
        // Include the explicit stable locator; missing fields retain v0.7.3 keys.
        var suffix=String(rec.propertyName||"")+"|"+JSON.stringify(rec.propertyNodePath||[])+"|"+
            String(rec.propertyGroupPath||"")+"|"+String(rec.propertyOwnerName||"");
        if (rec.targetKind === "figure") return "figure|"+suffix;
        if (rec.targetKind === "item") return "item|"+String(rec.itemID||(rec.nodeKey?"@"+rec.nodeKey:""))+"|"+
            String(rec.partID||"")+"|"+suffix;
        return "";
    }
    function propertyLocatorFields(rec) {
        var path=rec.propertyNodePath;
        if(path!==undefined){
            if(!Array.isArray(path)||path.length>64)throw problem("PROPERTY_LOCATOR","Invalid owner node path.");
            for(var i=0;i<path.length;i++)if(typeof path[i]!=="string"||!path[i])
                throw problem("PROPERTY_LOCATOR","Invalid node name in property owner path.");
        }
        if(rec.propertyGroupPath!==undefined&&typeof rec.propertyGroupPath!=="string")throw problem("PROPERTY_LOCATOR","Invalid property group path.");
        if(rec.propertyOwnerName!==undefined&&typeof rec.propertyOwnerName!=="string")throw problem("PROPERTY_LOCATOR","Invalid property owner name.");
    }
    function validateSetPropertyOverrides(list, db, st) {
        if (list === undefined || list === null) return [];
        expectList(list, "Set property overrides");
        var seen = {}, out = [];
        for (var i = 0; i < list.length; i++) {
            var r = list[i]; expectObject(r, "Property override");
            if (r.targetKind !== "figure" && r.targetKind !== "item") throw problem("SCHEMA", "Property target kind");
            if (typeof r.propertyName !== "string" || !r.propertyName) throw problem("SCHEMA", "Property internal name");
            if (typeof r.propertyLabel !== "string") throw problem("SCHEMA", "Property label");
            if (typeof r.applyValue !== "number" || !isFinite(r.applyValue) || typeof r.resetValue !== "number" || !isFinite(r.resetValue))
                throw problem("SCHEMA", "Property Apply/Reset values");
            propertyLocatorFields(r);
            var copy = {targetKind:r.targetKind,propertyName:String(r.propertyName),propertyLabel:String(r.propertyLabel),
                applyValue:Number(r.applyValue),resetValue:Number(r.resetValue)};
            if(r.propertyNodePath!==undefined)copy.propertyNodePath=r.propertyNodePath.slice(0);
            if(r.propertyGroupPath!==undefined)copy.propertyGroupPath=r.propertyGroupPath;
            if(r.propertyOwnerName!==undefined)copy.propertyOwnerName=r.propertyOwnerName;
            if (r.targetKind === "item") {
                if (typeof r.itemID !== "string" || !own(db.items,r.itemID) || st.items.indexOf(r.itemID) < 0) throw problem("SCHEMA", "Property item target");
                var it = db.items[r.itemID], partID = String(r.partID || (it.parts.length ? it.parts[0].id : "")), found = false;
                for (var p = 0; p < it.parts.length; p++) if (it.parts[p].id === partID) { found = true; break; }
                if (!found) throw problem("SCHEMA", "Property item part target");
                copy.itemID = r.itemID; copy.partID = partID;
            }
            var k = propertyOverrideKey(copy);
            if (!k || own(seen,k)) throw problem("SCHEMA", "Repeated property override target");
            seen[k] = true; out.push(copy);
        }
        return out;
    }

    // v0.9.10.33: Set-owned local part states, keyed by durable ItemID/PartID.
    // This is deliberately separate from immutable Item Definitions / DUF files.
    // Legacy sets without partStates retain original native-preset visibility.
    function setPartStates(st) {
        return st && st.partStates && typeof st.partStates === "object" ? st.partStates : {};
    }
    function validateSetPartStates(raw,db,st) {
        if(raw===undefined||raw===null)return {};
        expectObject(raw,"Set part states");
        var ids=Object.keys(raw),out={};
        if(ids.length>256)throw problem("PART_STATE_SCHEMA","Too many saved item states.");
        for(var i=0;i<ids.length;i++){
            var itemID=ids[i],it=db.items[itemID];
            if(st.items.indexOf(itemID)<0||!it)throw problem("PART_STATE_SCHEMA","Unknown Set part owner: "+itemID);
            expectObject(raw[itemID],"Item part states");
            var entries=raw[itemID],keys=Object.keys(entries),valid={},dst={};
            if(keys.length>500)throw problem("PART_STATE_SCHEMA","Too many parts for "+it.name);
            for(var p=0;p<it.parts.length;p++)valid[it.parts[p].id]=true;
            for(var j=0;j<keys.length;j++){
                var partID=keys[j],row=entries[partID];
                if(!own(valid,partID))throw problem("PART_STATE_SCHEMA","Unknown PartID: "+partID);
                expectObject(row,"Part visibility record");
                // Explicit local visibility: do not infer hidden from a parent
                // or a storage group. All four flags are native DzNode fields.
                var fields=["visible","viewport","render","simulation"];
                for(var f=0;f<fields.length;f++)if(typeof row[fields[f]]!=="boolean")
                    throw problem("PART_STATE_SCHEMA","Invalid "+fields[f]+" for "+partID);
                if(Object.keys(row).length!==fields.length)throw problem("PART_STATE_SCHEMA","Unknown Part State field for "+partID);
                dst[partID]={visible:row.visible,viewport:row.viewport,render:row.render,simulation:row.simulation};
            }
            if(keys.length)out[itemID]=dst;
        }
        return out;
    }
    function readPartVisibility(node) {
        if(!node)throw problem("PART_STATE_NODE","Missing node for visibility snapshot.");
        var reader={visible:"isVisible",viewport:"isVisibleInViewport",render:"isVisibleInRender",simulation:"isVisibleInSimulation"},o={},keys=Object.keys(reader);
        for(var i=0;i<keys.length;i++){
            var name=keys[i],method=reader[name];
            if(typeof node[method]!=="function")throw problem("PART_STATE_UNSUPPORTED",String(node.getLabel())+" lacks "+method);
            var got=node[method]();
            if(typeof got!=="boolean")throw problem("PART_STATE_READ",String(node.getLabel())+" / "+method+" returned a non-boolean.");
            o[name]=got;
        }
        return o;
    }
    function captureSetPartStates(memberIDs,inv,old,db) {
        var existing=setPartStates(old),out={};
        for(var i=0;i<memberIDs.length;i++){
            var id=memberIDs[i],it=db.items[id],inf=inv[id],parts={};
            // A stored item is hidden by its wardrobe container. Its saved
            // Set state must NEVER be overwritten with those effective flags.
            if(inf&&inf.where==="active"){
                for(var p=0;p<it.parts.length;p++){
                    var partID=it.parts[p].id,n=inf.parts[partID];
                    if(!n)throw problem("PART_STATE_PART_MISSING",it.name+" / "+partID);
                    parts[partID]=readPartVisibility(n);
                }
                out[id]=parts;
                log("INFO","PART_STATES_CAPTURED",it.name+" | parts="+Object.keys(parts).length+" | current worn figure");
            }else if(own(existing,id)){
                out[id]=clonePlain(existing[id]);
                log("INFO","PART_STATES_PRESERVED",it.name+" | stored or absent; previous Set state retained");
            }else{
                // Legacy saved Sets can have no part states. Preserve that
                // behavior rather than manufacturing an arbitrary Hidden state.
                log("INFO","PART_STATES_DEFERRED",it.name+" | wear this item and save the Set to record part visibility");
            }
        }
        return out;
    }
    function partStateEntries(st) {
        var out=[],byItem=setPartStates(st),itemIDs=Object.keys(byItem);
        for(var i=0;i<itemIDs.length;i++){
            var id=itemIDs[i],parts=byItem[id],partIDs=Object.keys(parts);
            for(var j=0;j<partIDs.length;j++)out.push({itemID:id,partID:partIDs[j],state:parts[partIDs[j]]});
        }
        return out;
    }
    function partStateNode(row,inv) {
        var inf=inv[row.itemID];
        if(!inf||inf.where!=="active"||!inf.parts[row.partID])
            throw problem("PART_STATE_TARGET","Selected part must be worn before applying its Set state: "+row.itemID+" / "+row.partID);
        return inf.parts[row.partID];
    }
    function partStateTransitionNeeded(st,fig) {
        var entries=partStateEntries(st);
        if(!entries.length)return false;
        try{
            var inv=inventory(fig,app.db);
            for(var i=0;i<entries.length;i++)if(!closeNumbers(readPartVisibility(partStateNode(entries[i],inv)),entries[i].state))return true;
            return false;
        }catch(ignore){return true;}
    }
    function rememberPartStateRollback(node) {
        if(!ctx.partStateRollback)ctx.partStateRollback=[];
        var k=key(node);
        for(var i=0;i<ctx.partStateRollback.length;i++)if(ctx.partStateRollback[i].key===k)return;
        ctx.partStateRollback.push({key:k,state:readPartVisibility(node)});
    }
    function writePartVisibility(node,want,phase) {
        var before=readPartVisibility(node);
        if(closeNumbers(before,want))return false;
        rememberPartStateRollback(node);
        // setVisible may also change subordinate visibility channels; restore
        // all explicitly from the complete requested state afterwards.
        if(before.visible!==want.visible)node.setVisible(want.visible);
        if(node.isVisibleInViewport()!==want.viewport)node.setVisibleInViewport(want.viewport);
        if(node.isVisibleInRender()!==want.render)node.setVisibleInRender(want.render);
        if(node.isVisibleInSimulation()!==want.simulation)node.setVisibleInSimulation(want.simulation);
        if(!closeNumbers(readPartVisibility(node),want))throw problem("PART_STATE_WRITE",
            "Native visibility did not accept Set state: "+node.getLabel()+" ("+phase+")");
        return true;
    }
    function rollbackPartStateWrites(errors) {
        if(!ctx||!ctx.partStateRollback||!ctx.partStateRollback.length)return true;
        var okay=true;
        for(var i=ctx.partStateRollback.length-1;i>=0;i--){
            var rec=ctx.partStateRollback[i];
            try{
                var n=live(rec.key);if(!n){if(ctx.created&&own(ctx.created,rec.key))continue;
                    throw problem("PART_STATE_ROLLBACK_NODE",rec.key);}
                // Rollback writes must not append to the rollback log.
                var was=readPartVisibility(n),want=rec.state;
                if(was.visible!==want.visible)n.setVisible(want.visible);
                if(n.isVisibleInViewport()!==want.viewport)n.setVisibleInViewport(want.viewport);
                if(n.isVisibleInRender()!==want.render)n.setVisibleInRender(want.render);
                if(n.isVisibleInSimulation()!==want.simulation)n.setVisibleInSimulation(want.simulation);
                if(!closeNumbers(readPartVisibility(n),want))throw problem("PART_STATE_ROLLBACK_VALUE",n.getLabel());
            }catch(e){okay=false;if(errors)errors.push(errorText(e));}
        }
        if(okay)log("PASS","PART_STATES_ROLLBACK",ctx.partStateRollback.length+" original part visibility snapshots restored.");
        return okay;
    }
    function applySavedSetPartStates(st,fig) {
        if(!ctx||["apply","partial_apply","restore_properties"].indexOf(ctx.action)<0)return;
        var entries=partStateEntries(st);if(!entries.length)return;
        requireUnscoped("applySavedSetPartStates");
        var inv=inventory(fig,app.db),prepared=[],i;
        // Preflight all parts BEFORE the first visibility setter.
        for(i=0;i<entries.length;i++){
            var r=entries[i],n=partStateNode(r,inv);
            readPartVisibility(n);prepared.push({node:n,want:r.state,itemID:r.itemID,partID:r.partID});
        }
        var ownPending=false;
        if(!value(fig,"Pending")){
            ctx.pending={schemaVersion:1,operationID:ctx.id,libraryID:app.db.libraryID,action:"ApplySetPartStates",setID:String(st.id||""),ownerFigureID:figureIdentity(fig,true)};
            txData(fig,{Pending:jsonText(ctx.pending)});ownPending=true;
        }
        var changed=0;
        for(i=0;i<prepared.length;i++)if(writePartVisibility(prepared[i].node,prepared[i].want,"apply"))changed++;
        if(changed)try{Scene.update();processEvents();}catch(ignorePartStateUpdate){}
        for(i=0;i<prepared.length;i++)if(!closeNumbers(readPartVisibility(prepared[i].node),prepared[i].want))
            throw problem("PART_STATE_VERIFY","Part visibility changed during Apply: "+prepared[i].node.getLabel());
        if(ownPending)unsetData(fig,"Pending");
        ctx.diag.partStates={setID:String(st.id||""),targetCount:prepared.length,changed:changed,verified:prepared.length};
        log("PASS","SET_PART_STATES",String(st.name||"Set")+" | parts="+prepared.length+" | changed="+changed+" | verified="+prepared.length);
    }

    // v0.9.10.4: Set-owned, immutable geo-graft surface material baselines.
    // These are NOT wardrobe item registrations. A referenced GeoShell may be
    // completely unknown to Wardrobe Sets. v0.9.10.5 consumes them only under
    // explicit material-recovery opt-in; multi-owner graft transfer stays blocked.
    function validateGeoShellSetSnapshots(raw,db,st){
        if(raw===undefined||raw===null)return [];
        expectList(raw,"GeoShell Set material records");
        if(raw.length>256)throw problem("GEO_SET_SCHEMA","Too many GeoShell material records.");
        var out=[],seen={};
        for(var i=0;i<raw.length;i++){
            var rec=raw[i];expectObject(rec,"GeoShell material record");
            if(rec.schemaVersion!==1||typeof rec.graftItemID!=="string"||st.items.indexOf(rec.graftItemID)<0||!db.items[rec.graftItemID])
                throw problem("GEO_SET_SCHEMA","GeoShell record has an invalid graft item.");
            if(typeof rec.shellName!=="string"||!rec.shellName||rec.shellName.length>512||
                typeof rec.shellAssetId!=="string"||rec.shellAssetId.length>2048||
                typeof rec.captured!=="string"||!rec.captured)
                throw problem("GEO_SET_SCHEMA","Invalid GeoShell identity or captured date.");
            if(rec.mode!=="partial"&&rec.mode!=="registered_full")
                throw problem("GEO_SET_SCHEMA","Unknown GeoShell preset mode.");
            if(rec.mode==="registered_full" && (typeof rec.shellItemID!=="string"||st.items.indexOf(rec.shellItemID)<0||
               !st.materialSnapshots[rec.shellItemID]||st.materialSnapshots[rec.shellItemID].nativePreset!==rec.nativePreset))
                throw problem("GEO_SET_SCHEMA","Shared registered GeoShell must refer to its saved full native preset.");
            validateNativeMaterialPresetRelative(rec.nativePreset);
            if(rec.surfaceUVs!==undefined){
                expectObject(rec.surfaceUVs,"GeoShell saved UV values");
                var uvKeys=Object.keys(rec.surfaceUVs);
                if(uvKeys.length>500)throw problem("GEO_SET_SCHEMA","Too many saved UVs.");
                for(var u=0;u<uvKeys.length;u++)if(typeof rec.surfaceUVs[uvKeys[u]]!=="string"||uvKeys[u].length>512)
                    throw problem("GEO_SET_SCHEMA","Invalid saved GeoShell UV.");
            }
            expectList(rec.surfaceNames,"GeoShell surface names");
            if(!rec.surfaceNames.length||rec.surfaceNames.length>500)throw problem("GEO_SET_SCHEMA","Invalid number of graft surfaces.");
            var names={};for(var j=0;j<rec.surfaceNames.length;j++){
                var n=rec.surfaceNames[j];if(typeof n!=="string"||!n||n.length>512||names["$"+n])
                    throw problem("GEO_SET_SCHEMA","Duplicate or invalid graft surface.");names["$"+n]=true;
            }
            var recKey=rec.graftItemID+"|"+rec.shellAssetId+"|"+rec.shellName+"|"+rec.surfaceNames.join("~");
            if(seen[recKey])throw problem("GEO_SET_SCHEMA","Duplicate GeoShell material record.");
            seen[recKey]=true;
            out.push(clonePlain(rec));
        }
        return out;
    }

    function validateCatalog(db, libraryID) {
        expectObject(db, "Catalog");
        if (db.format !== FORMAT || db.schemaVersion !== 1 || db.libraryID !== libraryID)
            throw problem("CATALOG_VERSION", "Wrong library or unsupported schema.");
        checkedID(db.libraryID, "Library ID");
        if (typeof db.revision !== "number" || db.revision < 0 || db.revision !== Math.floor(db.revision) || db.revision > 9999999999)
            throw problem("SCHEMA", "Revision");
        expectObject(db.items, "Catalog items"); expectObject(db.sets, "Catalog sets");
        // Old catalog revisions have no groups. They remain valid in format v1.
        if(!own(db,"groups"))db.groups={};
        expectObject(db.groups,"Catalog groups");
        var groupIDs=Object.keys(db.groups),groupNames={};
        for(var gi=0;gi<groupIDs.length;gi++){
            var gid=groupIDs[gi],g=db.groups[gid];checkedID(gid,"Group ID");
            expectObject(g,"Group");
            if(g.id!==gid)throw problem("SCHEMA","Group key/ID mismatch");
            if(typeof g.name!=="string"||validateGroupName(g.name)!==g.name)
                throw problem("SCHEMA","Group name must be trimmed and valid");
            var normalized=g.name.toLowerCase();
            if(own(groupNames,normalized))throw problem("SCHEMA","Duplicate group name: "+g.name);
            groupNames[normalized]=true;
        }
        var ids = Object.keys(db.items), seenVariants = {}, seenParts = {};
        for (var i = 0; i < ids.length; i++) {
            var it = db.items[ids[i]]; expectObject(it, "Item");
            checkedID(ids[i], "Item key");
            if (it.id !== ids[i] || !it.name || !catalogFigureTypeAllowed(it.figureType)) throw problem("SCHEMA", "Item identity/type");
            checkedID(it.variantID, "Variant ID");
            if (own(seenVariants, it.variantID)) throw problem("SCHEMA", "Repeated variant ID"); seenVariants[it.variantID] = true;
            safeRelative(it.preset); if (!/^Items\/[a-zA-Z0-9_]+\.duf$/.test(it.preset)) throw problem("SCHEMA", "Preset location");
            expectList(it.parts, "Parts"); if (!it.parts.length) throw problem("SCHEMA", "Empty item");
            var pids = {}, roots = 0;
            for (var p = 0; p < it.parts.length; p++) {
                var part = it.parts[p]; expectObject(part, "Part"); checkedID(part.id, "Part ID");
                if (own(pids, part.id) || own(seenParts, part.id)) throw problem("SCHEMA", "Repeated part ID");
                pids[part.id] = true; seenParts[part.id] = true;
                if (part.root === true) roots++;
                if (typeof part.className !== "string" || !part.className) throw problem("SCHEMA", "Part class");
                expectObject(part.refs, "Part references"); expectObject(part.materials, "Material snapshot");
            }
            if (roots !== 1 || it.parts[0].root !== true) throw problem("SCHEMA", "Exactly one first root required");
            for (var q = 0; q < it.parts.length; q++) for (var r = 0; r < REF_FIELDS.length; r++)
                validatePortableRef(it.parts[q].refs[REF_FIELDS[r]], pids);
        }
        // Validate AFTER reading every item: replacement references may point
        // to registered items appearing later in the JSON object.
        for(var ti=0;ti<ids.length;ti++)validateItemTransitionPolicy(db.items[ids[ti]].transitionPolicy,ids[ti],db.items);
        var sets = Object.keys(db.sets);
        for (var s = 0; s < sets.length; s++) {
            var st = db.sets[sets[s]]; expectObject(st, "Set"); checkedID(st.id, "Set ID");
            if (st.id !== sets[s] || typeof st.name !== "string" || !trim(st.name) || !catalogFigureTypeAllowed(st.figureType))
                throw problem("SCHEMA", "Set name/type");
            expectList(st.items, "Set items"); expectObject(st.scope, "Scope");
            if (["type", "label", "figure"].indexOf(st.scope.kind) < 0) throw problem("SCHEMA", "Scope kind");
            if (st.scope.kind === "figure") checkedID(st.scope.figureID, "Scope figure");
            if (st.scope.kind === "label" && (typeof st.scope.label !== "string" || !st.scope.label)) throw problem("SCHEMA", "Scope label");
            var seen = {};
            if (!st.items.length) throw problem("SCHEMA", "Empty sets are not enabled in this prototype.");
            for (var j = 0; j < st.items.length; j++) {
                var id = st.items[j];
                if (!own(db.items, id) || own(seen, id) || db.items[id].figureType !== st.figureType) throw problem("SCHEMA", "Invalid set item");
                seen[id] = true;
            }
            if(st.groupID!==undefined&&(typeof st.groupID!=="string" ||
                (st.groupID && !own(db.groups,st.groupID))))
                throw problem("SCHEMA","Unknown Set group: "+String(st.groupID));
            // Catalog schema v1 remains unchanged. Legacy sets default to false.
            if(st.replaceWithinGroup!==undefined&&typeof st.replaceWithinGroup!=="boolean")
                throw problem("SCHEMA","Group-scoped transition must be a boolean.");
            if (st.icon) safeRelative(st.icon);
            st.properties = validateSetPropertyOverrides(own(st,"properties") ? st.properties : [], db, st);
            st.handPoses = validateHandPoses(st.handPoses);
            st.partStates = validateSetPartStates(own(st,"partStates") ? st.partStates : {}, db, st);
            st.materialSnapshots = validateSetMaterialSnapshots(own(st,"materialSnapshots")?st.materialSnapshots:{},db,st);
            st.geoShellSnapshots = validateGeoShellSetSnapshots(own(st,"geoShellSnapshots")?st.geoShellSnapshots:[],db,st);
        }
        return db;
    }
    function readCatalog() {
        var token = profileBegin("catalog_read");
        try { return readCatalogImpl(); }
        finally { profileEnd(token); }
    }
    function readCatalogImpl() {
        var h = readJSON(app.libraryPath + "/library.json");
        if (h.format !== FORMAT || h.schemaVersion !== 1) throw problem("LIBRARY_VERSION", "Unsupported library header.");
        checkedID(h.libraryID, "Library ID");
        var names = listFiles(app.libraryPath + "/Catalog", "rev_*.json"), best = null, rev = -1;
        for (var i = 0; i < names.length; i++) {
            var m = /^rev_(\d{10})_([a-zA-Z0-9_]+)\.json$/.exec(String(names[i]));
            if (!m) throw problem("CATALOG_FILENAME", String(names[i]));
            var n = Number(m[1]);
            if (n === rev) throw problem("CATALOG_FORK", "Two catalog commits at revision " + n + ". Nothing will be overwritten.");
            if (n > rev) { rev = n; best = String(names[i]); }
        }
        if (!best) throw problem("CATALOG_MISSING", "Library header exists but no committed catalog was found. Not replaced with an empty catalog.");
        var db = validateCatalog(readJSON(app.libraryPath + "/Catalog/" + best), h.libraryID);
        if (db.revision !== rev || best.indexOf(db.commitID) < 0) throw problem("CATALOG_MISMATCH", best);
        app.catalogFile = best; return db;
    }
    function lockLibrary() {
        if (app.lockToken) throw problem("REENTRANT", "A library operation is already active.");
        var p = app.libraryPath + "/.matew-write-lock", d = new DzDir(p);
        try {
            if (d.exists() || !d.mkdir()) throw problem("LIBRARY_LOCKED", "Another operation owns " + p + ". Close other DAZ sessions. After a crash, rename this lock folder only after verifying no process is using the library.");
        } finally { d.deleteLater(); }
        app.lockToken = unique("lock");
        try { writeNewJSON(p + "/owner.json", {token: app.lockToken, created: String(new Date()), version: VERSION}); }
        catch (e) { app.lockToken = ""; throw e; }
    }
    function unlockLibrary() {
        if (!app.lockToken) return;
        var token = app.lockToken, p = app.libraryPath + "/.matew-write-lock"; app.lockToken = "";
        if (readJSON(p + "/owner.json").token !== token) throw problem("LOCK_OWNER_CHANGED", p);
        var d = new DzDir(p);
        try {
            if (!d.remove("owner.json") || !d.rmdir()) throw problem("LOCK_RELEASE", p);
        } finally { d.deleteLater(); }
    }
    function commitCatalog(next, previousFile) {
        if (!app.lockToken) throw problem("NO_WRITE_LOCK", "Catalog writes require an owned lock.");
        var old = readCatalog();
        if (app.catalogFile !== previousFile || old.revision !== next.revision) throw problem("CATALOG_CHANGED", "Reopen the editor and try again.");
        next.revision = old.revision + 1;
        next.commitID = unique("commit"); next.parentCommit = old.commitID;
        validateCatalog(next, old.libraryID);
        writeNewJSON(app.libraryPath + "/Catalog/rev_" + padRevision(next.revision) + "_" + next.commitID + ".json", next);
        // The rename is the commit point. No disk cleanup or fallible validation
