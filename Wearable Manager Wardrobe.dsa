        var id = unique("library"), db = {format: FORMAT, schemaVersion: 1, libraryID: id, revision: 0,
            commitID: unique("commit"), parentCommit: "", items: {}, sets: {}, groups: {}};
        writeNewJSON(app.libraryPath + "/Catalog/rev_" + padRevision(0) + "_" + db.commitID + ".json", db);
        writeNewJSON(app.libraryPath + "/library.json", {format: FORMAT, schemaVersion: 1, libraryID: id, created: String(new Date())});
