        });
        refreshPropertySummary();

        // Preserve the original icons and their 250x32 artwork. Glyph is on the
        // left, wording on the right. Look first in existing Resources, then sources.
        function setSetIconButtonArt(button,filename){
            var locations=[resourcePath(filename),scriptDirectory()+"/sources/"+filename,scriptDirectory()+"/Sources/"+filename];
            for(var li=0;li<locations.length;li++){
                try{
                    if(!readable(locations[li]))continue;
                    var px=new Pixmap(locations[li]);if(!px||px.isNull())continue;
                    if(Number(px.width)!==250||Number(px.height)!==32)px.resize(250,32);
                    button.pixmap=px;button.sizedFromIcon=true;
                    if(parseInt(App.versionString,10)>=6)button.getWidget().iconSize=new Size(250,32);
                    return true;
                }catch(iconError){print(TITLE+" set button icon: "+String(iconError));}
            }
            print(TITLE+" set button icon not found: "+filename);
            return false;
        }
        setSetIconButtonArt(standard,"Wearable Manager Standard Icons.png");
        setSetIconButtonArt(browse,"Wearable Manager Choose Image.png");
        setSetIconButtonArt(renderIcon,"Wearable Manager Render Image.png");
        setSetIconButtonArt(useDefault,"Wearable Manager Use Default.png");
        setSetIconButtonArt(restore,"Wearable Manager Restore Saved Icon.png");
        var oldIcon=old?old.icon||"":"",iconChoice=oldIcon?{mode:"keep",id:"",path:"",standardName:""}:{mode:"builtin",id:"outfit",path:"",standardName:"Default Outfit"},cameraCreated=false,cameraSaveAfter=false;
        function previewIcon(){
            var path="",caption="No icon",warning="";
            try{
                if(iconChoice.mode==="builtin"){path=builtinIconPreviewPath(iconChoice.id);caption="Standard: "+(iconChoice.standardName||builtinIconDefinition(iconChoice.id).name);}
                else if(iconChoice.mode==="file"){path=iconChoice.path;caption=iconChoice.standardName?"Standard: "+iconChoice.standardName:"Custom image";}
                else if(iconChoice.mode==="keep"&&oldIcon){path=inLibrary(oldIcon);caption="Saved icon";}
                preview.clear();
                if(path){
                    var px=new Pixmap(path);if(!px||px.isNull())throw problem("ICON_PREVIEW",path);
                    scalePixmapTo(px,100,128,true);preview.pixmap=px;
                }else preview.text="No icon";
            }catch(e){preview.clear();preview.text="Preview unavailable";warning=" | "+userErrorText(e);}
            iconInfo.text=caption+warning;iconInfo.toolTip=path||caption;
            // If an existing set has a saved icon, restoring it is always a
            // valid explicit action. Keeping this enabled avoids a stale UI
            // state after file/gallery/render selections in DAZ 4/6.
            restore.enabled=!!oldIcon;
            renderIcon.text=findSetIconCamera(fig)?"Render from Set Icon Camera":"Create Set Icon Camera";
        }
        connect(standard,"clicked()",function(){
            try{
                var chosen=builtinIconDialog(iconChoice.mode==="builtin"?iconChoice.id:"");
                if(!chosen)return;
                if(chosen.kind==="builtin")iconChoice={mode:"builtin",id:chosen.id,path:"",standardName:chosen.name};
                else iconChoice={mode:"file",id:"",path:resourcePath(chosen.resource),standardName:chosen.name};
                previewIcon();
            }catch(e){MessageBox.warning(userErrorText(e),TITLE,"&OK");}
        });
        connect(browse,"clicked()",function(){
            var p=FileDialog.doFileDialog(true,"Choose set icon",iconChoice.path||"","Images (*.png *.jpg *.jpeg *.bmp)");
            if(!p)return;
            try{p=editorImagePath(p);iconChoice={mode:"file",path:p,id:"",standardName:""};previewIcon();}catch(e){MessageBox.warning(userErrorText(e),TITLE,"&OK");}
        });
        connect(useDefault,"clicked()",function(){iconChoice={mode:"builtin",path:"",id:"outfit",standardName:"Default Outfit"};previewIcon();});
        connect(restore,"clicked()",function(){iconChoice={mode:"keep",path:"",id:"",standardName:""};previewIcon();});
        connect(renderIcon,"clicked()",function(){
            try{
                var cam=findSetIconCamera(fig);
                if(!cam){
                    // Closing the editor without Save used to discard a pending
                    // New Group and every unsaved Set edit. Confirm first.
                    // Cancel is button 0, including DAZ Escape handling.
                    var decision=MessageBox.warning("The Set Editor has unsaved changes. Save the Set (including its Group) before creating the icon camera?",
                        TITLE+" - Create Set Icon Camera","&Cancel","&Save Set and Continue","&Continue Without Saving");
                    if(decision===0)return;
                    if(decision===1){
                        if(!editorCanSave){MessageBox.warning("Enter a set name and choose at least one item before saving. For Label scope, also enter a figure label.",TITLE,"&OK");return;}
                        acceptedPayload=currentEditorPayload();cameraSaveAfter=true;dlg.close();return;
                    }
                    if(decision!==2)return;
                    createSetIconCamera(fig);cameraCreated=true;
                    MessageBox.information("A 100 x 128 Wardrobe Sets set-icon camera was created and aimed/framed on "+figureDisplayLabel(fig)+". Adjust the view from that camera in the viewport, then run Wardrobe Sets and open this Set Editor again. The next Render command will use NVIDIA Iray with your current Iray settings.","Wardrobe Sets - Set Icon Camera","&OK");
                    dlg.close();return;
                }
                var rendered=renderSetIconFromCamera(fig,cam);
                iconChoice={mode:"file",path:rendered,id:"",standardName:""};previewIcon();
            }catch(e){MessageBox.warning(userErrorText(e),TITLE,"&OK");}
        });
        previewIcon();

        sectionHeading("Outfit Items");
        // Both bulk buttons act on the COMPLETE list (including rows outside
        // the scroll viewport). No catalog change occurs until Save Set.
        var bulkRow=new DzHGroupBox(box),addAllItems=new DzPushButton(bulkRow),removeAllItems=new DzPushButton(bulkRow);
        flattenGroupBox(bulkRow);bulkRow.insideMargin=0;bulkRow.insideSpacing=8;bulkRow.setFixedHeight(38);
        addAllItems.text="        Add All";addAllItems.setFixedSize(120,32);addAllItems.autoDefault=false;
        removeAllItems.text="     Remove All";removeAllItems.setFixedSize(120,32);removeAllItems.autoDefault=false;
        // DAZ 4/6: keep the native button-sized artwork, no separate icon control.
        setSourcePickerTextIcon(addAllItems,"Wearable Manager Select All.png",120,24);
        setSourcePickerTextIcon(removeAllItems,"Wearable Manager Deselect All.png",120,24);
        addAllItems.toolTip="Move every available clothing item to this Set; changes are saved only with Save Set.";
        removeAllItems.toolTip="Move every selected item out of this Set. Empty Sets cannot be saved.";
        var selectionCount=label(box,""),cols=new DzHGroupBox(box),leftPanel=new DzVGroupBox(cols),rightPanel=new DzVGroupBox(cols);
        leftPanel.minWidth=445;rightPanel.minWidth=445;flattenGroupBox(leftPanel);flattenGroupBox(rightPanel);
        var leftScroll=new DzScrollArea(leftPanel),rightScroll=new DzScrollArea(rightPanel);
        leftScroll.widgetResizable=true;rightScroll.widgetResizable=true;
        leftScroll.setHorizontalScrollbarDisplay(false);rightScroll.setHorizontalScrollbarDisplay(false);
        var leftContent=new DzVGroupBox(leftScroll),rightContent=new DzVGroupBox(rightScroll);
        flattenGroupBox(leftContent);flattenGroupBox(rightContent);
        leftScroll.setWidget(leftContent);rightScroll.setWidget(rightContent);
        var leftEmpty=label(leftContent,"[No items in this set]"),rightEmpty=label(rightContent,"[No additional items available]");
        var controls=[],fontName=newGeorgiaFont(),fontDetail=newGeorgiaFont();fontName.pixelSize=14;fontDetail.pixelSize=11;
        function makeRow(parent,r,leftSide){
            var group=new DzHGroupBox(parent),move=null,icon=null,textBox=null,nm=null,detail=null,marker=null,materialCheck=null;
            group.minHeight=110;flattenGroupBox(group);
            try{group.getWidget().setStyleSheet("QGroupBox { border: 0px; margin: 0px; padding: 0px; background: transparent; }");}catch(ignoreRowStyle){}
            if(leftSide){
                icon=new DzPushButton(group);textBox=new DzVGroupBox(group);move=new DzPushButton(group);
            }else{
                move=new DzPushButton(group);icon=new DzPushButton(group);textBox=new DzVGroupBox(group);
            }
            flattenGroupBox(textBox);
            var nameRow=new DzHGroupBox(textBox);flattenGroupBox(nameRow);
            nameRow.insideMargin=0;nameRow.insideSpacing=2;nameRow.setFixedWidth(245);
            nm=label(nameRow,r.name);
            marker=new DzLabel(nameRow);marker.setFixedSize(24,24);marker.alignment=0x84;
            marker.toolTip="This item has Property Overrides in the outfit set.";
            if(!setLabelResourcePixmap(marker,"Wearable Manager Edit.png",24,24)){
                marker.text="P";marker.toolTip+=" (Wearable Manager Edit.png not found in Resources)";
            }
            detail=label(textBox,r.detail);
            if(r.geoGraft){
                materialCheck=label(textBox,"GeoGraft: materials always saved");
                materialCheck.toolTip="Own materials and matching existing GeoShell graft surfaces are captured automatically in this Set.";
            }else{
                materialCheck=new DzCheckBox(textBox);materialCheck.text="Save Materials";
                materialCheck.checked=r.saveMaterials===true;materialCheck.toolTip=
                    "Save a JSON comparison snapshot AND a native DAZ material preset for this item. Restore explicitly through Restore Materials... on its outfit card.";
                connect(materialCheck,"clicked()",function(){r.saveMaterials=materialCheck.checked===true;
                    for(var k=0;k<controls.length;k++)if(controls[k].row===r){
                        controls[k].left.materialCheck.checked=r.saveMaterials;
                        controls[k].right.materialCheck.checked=r.saveMaterials;break;}
                });
            }
            nm.font=fontName;detail.font=fontDetail;nm.setFixedWidth(217);detail.minWidth=245;
            try{nm.getWidget().setStyleSheet("QLabel { color: #E9CD84; }");}catch(ignoreEditorItemTint){}
            icon.setFixedSize(91,91);icon.toolTip=r.name;setWardrobeEditorItemIcon(icon,r);
            if(r.nodeKey)connect(icon,"clicked()",function(){var n=live(r.nodeKey);if(n){Scene.selectAllNodes(false);Scene.setPrimarySelection(n);}});
            move.text="";move.setFixedSize(60,40);move.sizedFromIcon=true;move.buttonStyle=DzPushButton.BTool;
            setResourceButtonIcon(move,leftSide?"Wearable Manager - Arrow Right.png":"Wearable Manager - Arrow Left.png",52,32);
            move.toolTip=(leftSide?"Remove ":"Add ")+r.name+(leftSide?" from this set.":" to this set.");
            connect(move,"clicked()",function(){r.selected=!leftSide;refreshRows();});
            return {group:group,move:move,icon:icon,name:nm,detail:detail,marker:marker,materialCheck:materialCheck};
        }
        for(var i=0;i<rows.length;i++)(function(r){
            var left=makeRow(leftContent,r,true),right=makeRow(rightContent,r,false);
            controls.push({row:r,left:left,right:right});
        })(rows[i]);

        // The icon denotes an item-specific override, not a figure override.
        // Match the durable catalog itemID (nodeKey only for legacy rows).
        function refreshPropertyMarkers(){
            var badgeInv=null;
            for(var idx=0;idx<controls.length;idx++){
                var c=controls[idx],count=0,missing=0,r=c.row;
                for(var pi=0;pi<propertyOverrides.length;pi++){
                    var propRec=propertyOverrides[pi];
                    if(propRec.targetKind!=="item")continue;
                    if(!((r.itemID&&propRec.itemID&&r.itemID===propRec.itemID)||
                       ((!r.itemID||!propRec.itemID)&&r.nodeKey&&propRec.nodeKey===r.nodeKey)))continue;
                    count++;
                    // An unloaded garment is not proof that its override has
                    // disappeared. Probe only loaded catalog parts in the scene.
                    if(badgeInv===null)try{badgeInv=inventory(fig,app.db);}catch(ignoreBadgeInventory){badgeInv={};}
                    try{
                        var owner=null;
                        if(propRec.itemID&&own(badgeInv,propRec.itemID))
                            owner=propertyTargetNode(propRec,fig,badgeInv);
                        else if(!propRec.itemID&&r.nodeKey)owner=live(r.nodeKey);
                        if(owner)propertyHandleForOverride(owner,propRec);
                    }catch(propertyError){if(unavailableOverrideError(propertyError))missing++;}
                }
                var art=missing?"Wearable Manager Missing Property.png":"Wearable Manager Edit.png";
                var tip=missing?(missing+" of "+count+" Property Overrides missing or unresolved in this set"):
                    (count+" Property Override"+(count===1?"":"s")+" in this set");
                var sides=[c.left.marker,c.right.marker];
                for(var side=0;side<sides.length;side++){
                    var marker=sides[side];marker.clear();
                    if(count){
                        if(!setLabelResourcePixmap(marker,art,24,24))marker.text=missing?"!":"P";
                        marker.toolTip=tip;marker.show();
                    }else marker.hide();
                }
            }
        }
        refreshPropertyMarkers();
        connect(addAllItems,"clicked()",function(){
            for(var bi=0;bi<rows.length;bi++)rows[bi].selected=true;
            refreshRows();
        });
        connect(removeAllItems,"clicked()",function(){
            for(var bi=0;bi<rows.length;bi++)rows[bi].selected=false;
            refreshRows();
        });

        function refreshRows(){
            var summary=editorSelectionSummary(rows),leftCount=0,rightCount=0;
            for(var j=0;j<controls.length;j++){
                var c=controls[j];
                if(c.row.selected){c.left.group.show();c.right.group.hide();leftCount++;}
                else{c.left.group.hide();c.right.group.show();rightCount++;}
            }
            if(leftCount===0)leftEmpty.show();else leftEmpty.hide();
            if(rightCount===0)rightEmpty.show();else rightEmpty.hide();
            var visibleRows=Math.max(leftCount,rightCount,1),listHeight=Math.max(120,Math.min(500,visibleRows*114+18));
            leftScroll.setFixedHeight(listHeight);rightScroll.setFixedHeight(listHeight);
            leftPanel.setFixedHeight(listHeight+4);rightPanel.setFixedHeight(listHeight+4);cols.setFixedHeight(listHeight+8);
            selectionCount.text=summary.total?
                ("Set will contain "+summary.total+" item(s). GeoGraft materials are always saved; other item materials are optional."):
                "No items selected. Add at least one item before saving.";
            editorCanSave=summary.total>0&&!!trim(name.text)&&(scopeIndex!==1||!!trim(scopeLabel.text));
            if(editorSaveButton)editorSaveButton.enabled=editorCanSave;
            // Use real monitor work-area geometry, not a hard 720px cap.
            // This prevents DAZ 4 from centering a tall dialog above the
            // screen on otherwise spacious displays. Keep scroll as fallback.
            var targetHeight=Math.max(580,Math.min(1080,568+listHeight+48));
            resizeEditorToWorkArea(dlg,1000,targetHeight,editorPlaced);editorPlaced=true;
        }
        connect(name,"textChanged(const QString&)",refreshRows);
        connect(scopeLabel,"textChanged(const QString&)",refreshRows);
        function currentEditorPayload(){
            var chosenGroup=editorGroups[groupCombo.currentItem]||editorGroups[0];
            return editorPayload(rows,{id:id||"",baseCommit:baseCommit,
                name:name.text,scope:kindNames[scopeIndex],scopeLabel:scopeLabel.text,properties:propertyOverrides,
                rightHandPose:rightHand.checked,leftHandPose:leftHand.checked,
                rightHandPoseRecapture:handPoseRecapture.right,leftHandPoseRecapture:handPoseRecapture.left,
                groupID:chosenGroup.id,newGroupName:chosenGroup.id==="__new_group__"?chosenGroup.name:"",
                replaceWithinGroup:groupScoped.checked,
                iconPath:iconChoice.mode==="file"?iconChoice.path:"",builtinIcon:iconChoice.mode==="builtin"?iconChoice.id:"",clearIcon:false});
        }
        editorScroll.setWidget(box);
        dlg.addWidget(editorScroll);
        // Space the custom action row 10px below the scrolling editor.
        var editorFooterTopGap=new DzLabel(dlg);
        editorFooterTopGap.text="";editorFooterTopGap.setFixedHeight(10);
        dlg.addWidget(editorFooterTopGap);
        // Native DzBasicDialog buttons have platform-dependent colors and
        // squeeze the scroll area. Keep this custom footer always visible.
        var editorFooter=new DzHGroupBox(dlg);flattenGroupBox(editorFooter);
        editorFooter.insideMargin=0;editorFooter.insideSpacing=10;editorFooter.setFixedHeight(46);
        var footerSpace=new DzLabel(editorFooter);
        editorSaveButton=new DzPushButton(editorFooter);
        var editorCancel=new DzPushButton(editorFooter);
        var editorFooterRightGap=new DzLabel(editorFooter);
        editorFooterRightGap.text="";editorFooterRightGap.setFixedWidth(10);
        // Save Set first, then Cancel: right-aligned native layout order.
        wardrobePolicyActionStyle(editorCancel,"Cancel",120,"#B87B7B","#453737");
        wardrobePolicyActionStyle(editorSaveButton,"Save Set",150,"#69B58A","#33483D");
        footerSpace.text="";footerSpace.minWidth=580;
        // Save is enabled only for valid nonempty Sets, just as before.
        connect(editorSaveButton,"clicked()",function(){
            if(!editorCanSave)return;
            try{acceptedPayload=currentEditorPayload();userSaveRequested=true;dlg.close();}
            catch(e){MessageBox.warning(userErrorText(e),TITLE,"&OK");}
        });
        connect(editorCancel,"clicked()",function(){dlg.close();});
        dlg.addWidget(editorFooter);dlg.setFixedWidth(1000);refreshRows();var result=null;
        try{
            dlg.exec();
            if(rebindRequest)result={__rebindRequest:rebindRequest};
            else if(cameraSaveAfter){result=acceptedPayload;result.__cameraSaveAfter=true;}
            else if(cameraCreated)result={__cameraSetupExit:true};
            else if(userSaveRequested)result=acceptedPayload;
        }finally{dlg.deleteLater();}
        return result;
    }

    function scopeDisplayText(st) {
        if(st.scope.kind==="type")return "Any "+st.figureType+" figure";
        if(st.scope.kind==="label")return "Label: "+figureIconBaseLabel(st.scope.label)+" (including numbered copies)";
        if(st.scope.kind==="figure")return "Specific tagged figure";
        return String(st.scope.kind);
    }


    function setResourceButtonIcon(button,name,maxW,maxH) {
        button.text="";button.sizedFromIcon=true;button.buttonStyle=DzPushButton.BTool;
        try{return setPathButtonPixmap(button,resourcePath(name),maxW,maxH,true,true);}
        catch(e){print(TITLE+" resource icon: "+String(e));return false;}
    }
    function setResourceButtonIconCandidates(button,names,maxW,maxH) {
        for(var i=0;i<names.length;i++){
            try{var p=resourcePath(names[i]);if(readable(p)&&setPathButtonPixmap(button,p,maxW,maxH,true,true))return true;}catch(ignore){}
        }
        return false;
    }
    function flattenGroupBox(group) {
        try{group.flat=true;}catch(ignoreFlat){}
        try{group.getWidget().setStyleSheet("QGroupBox { border: 0px; margin: 0px; padding: 0px; }");}catch(ignore){}
    }
    function setLabelResourcePixmap(widget,name,maxW,maxH) {
        try{
            var p=resourcePath(name);if(!readable(p))return false;
            var px=new Pixmap(p);if(!px||px.isNull())return false;
            scalePixmapTo(px,maxW,maxH,true);widget.pixmap=px;
            return true;
        }catch(e){print(TITLE+" label resource icon: "+String(e));return false;}
    }
    function setSourcePickerTextIcon(button,name,sizeW, sizeH){
        try{
            var path=resourcePath(name);if(!readable(path))return false;
            var px=new Pixmap(path);if(!px||px.isNull())return false;
            button.pixmap=px;button.sizedFromIcon=true;
            scalePixmapTo(px, sizeW, sizeH, true);
            try { button.getWidget().iconSize = new Size(sizeW, sizeH); } catch (ignoreIconSize) { }
            return true;
        }catch(error){print(TITLE+" Choose Sources action icon: "+String(error));return false;}
    }
    function setTextButtonResourceIcon(button,name,maxW,maxH) {
        try{
            var p=resourcePath(name);if(!readable(p))return false;
            var px=new Pixmap(p);if(!px||px.isNull())return false;
            scalePixmapTo(px,maxW,maxH,true);button.pixmap=px;button.sizedFromIcon=false;
            if(parseInt(App.versionString,10)>=6)button.getWidget().iconSize=new Size(Number(px.width),Number(px.height));
            return true;
        }catch(e){print(TITLE+" text button resource icon: "+String(e));return false;}
    }
    function setTextButtonResourceIconCandidates(button,names,maxW,maxH,sized) {
        for(var i=0;i<names.length;i++){
            try{
                var p=resourcePath(names[i]);if(!readable(p))continue;
                var px=new Pixmap(p);if(!px||px.isNull())continue;
                button.pixmap = px; button.sizedFromIcon = sized === true;
                if(parseInt(App.versionString,10)>=6)button.getWidget().iconSize=new Size(Number(px.width),Number(px.height));
                return true;
            }catch(ignore){}
        }
        return false;
    }
    function setCardIcon(button,st) {
        var path="";
        button.text="";button.sizedFromIcon=true;button.buttonStyle=DzPushButton.BTool;
        try{
            path=st.icon?inLibrary(st.icon):builtinIconPreviewPath("outfit");
            if(!readable(path))path=builtinIconPreviewPath("outfit");
            return setPathButtonPixmap(button,path,100,128,true,true);
        }catch(e){
            try{return setPathButtonPixmap(button,builtinIconPreviewPath("outfit"),100,128,true,true);}
            catch(e2){print(TITLE+" set icon: "+String(e2));return false;}
        }
    }
    function figureUIIdentity(fig,create) {
        var id=value(fig,"FigureUIID");
        if(id)return id;
        if(!create)return "";
        id=unique("figureui");updateData(fig,{Schema:"1",FigureUIID:id});return id;
    }
    function isStandardFigureLabel(fig) {
        var d=defaultFigureProfileForType(String(fig.objectName));
        return !!d && trim(String(fig.getLabel()))===d.name;
    }
    function figureDisplayLabel(fig) {
        var p=figureProfileForType(String(fig.objectName),true),s=trim(String(fig.getLabel()));
        return s || (p?p.name:String(fig.objectName));
    }
    // Figure icon preferences are normally kept under App.getAppDataPath(),
    // which is different for DAZ Studio 4 and 6. Store explicit icon binding
    // changes in the shared wardrobe library as immutable events. Newest event
    // for a key wins; a deleted binding is represented by an empty relative
    // path (tombstone), so stale per-version preferences cannot resurrect it.
    function figureIconBindingJournalDir(){return app.libraryPath+"/FigureIcons/Bindings";}
    function writeSharedFigureIconBinding(scope,bindingKey,relative,previous){
        if(!app.db||!app.libraryPath||!bindingKey)throw problem("FIGURE_ICON_BINDING","Missing library or icon binding key.");
        if(scope!=="specific"&&scope!=="label")throw problem("FIGURE_ICON_BINDING","Invalid binding scope.");
        if(relative) safeRelative(relative);
        var dir=figureIconBindingJournalDir();mkdir(dir);
        var ms=String((new Date()).getTime());
        while(ms.length<15)ms="0"+ms;
        writeNewJSON(dir+"/binding_"+ms+"_"+unique("icon_binding")+".json",{
            schemaVersion:1,libraryID:String(app.db.libraryID),scope:scope,key:String(bindingKey),relative:String(relative||""),previous:String(previous||"")});
    }
    function mergeSharedFigureIconBindings(){
        if(!app.db||!app.libraryPath)return;
        var path=figureIconBindingJournalDir(),local=validateFigureIconBindings(app.figureIconBindings||{specific:{},label:{}}),
            events={},names=[],i,k,kind;
        // Migrate numbered legacy labels. An explicit base label wins a local
        // conflict; shared events below remain authoritative in time order.
        var oldLabels=local.label,normalizedLabels={},labelKeys=Object.keys(oldLabels).sort();
        for(i=0;i<labelKeys.length;i++){
            k=labelKeys[i];if(figureIconBaseLabel(k)===k)normalizedLabels[k]=oldLabels[k];
        }
        for(i=0;i<labelKeys.length;i++){
            k=figureIconBaseLabel(labelKeys[i]);if(!own(normalizedLabels,k))normalizedLabels[k]=oldLabels[labelKeys[i]];
        }
        local.label=normalizedLabels;
        if(pathExists(path)){
            names=listFiles(path,"binding_*.json");names.sort();
            for(i=0;i<names.length;i++){
                var event=readJSON(path+"/"+names[i]);
                if(!event||event.schemaVersion!==1||event.libraryID!==String(app.db.libraryID)||
                   (event.scope!=="specific"&&event.scope!=="label")||
                   typeof event.key!=="string"||!event.key||typeof event.relative!=="string")
                    throw problem("FIGURE_ICON_JOURNAL","Invalid icon binding event: "+names[i]);
                if(event.key.indexOf(figureIconLibraryKey()+"|"+event.scope+"|")!==0)
                    throw problem("FIGURE_ICON_JOURNAL","Binding does not belong to this library: "+names[i]);
                if(event.relative)safeRelative(event.relative);
                if(event.scope==="label")event.key=figureIconBaseLabel(event.key);
                if(!events[event.scope])events[event.scope]={};
                events[event.scope][event.key]=event.relative;
            }
        }
        // Migrate old per-version settings only for keys the shared journal
        // has never seen. Never overwrite a newer shared event (or tombstone).
        for(i=0;i<2;i++){
            kind=i===0?"specific":"label";
            var localKeys=Object.keys(local[kind]);
            for(var j=0;j<localKeys.length;j++){
                k=localKeys[j];
                if(k.indexOf(figureIconLibraryKey()+"|"+kind+"|")!==0)continue;
                if(events[kind]&&own(events[kind],k))continue;
                var legacy=local[kind][k];
                if(!legacy||!readableFigureIconRelative(legacy))continue;
                writeSharedFigureIconBinding(kind,k,legacy);
                if(!events[kind])events[kind]={};
                events[kind][k]=legacy;
            }
        }
        for(i=0;i<2;i++){
            kind=i===0?"specific":"label";
            if(!events[kind])continue;
            var sharedKeys=Object.keys(events[kind]);
            for(var n=0;n<sharedKeys.length;n++){
                k=sharedKeys[n];
                if(events[kind][k])local[kind][k]=events[kind][k];
                else delete local[kind][k];
            }
        }
        app.figureIconBindings=local;
        var tombstones={};
        for(i=0;i<2;i++){
            kind=i===0?"specific":"label";
            if(!events[kind])continue;
            var keys=Object.keys(events[kind]);
            for(var t=0;t<keys.length;t++)if(!events[kind][keys[t]])tombstones[keys[t]]=true;
        }
        app.figureIconTombstones=tombstones;
    }

    function figureIconLibraryKey() {
        return app.db&&app.db.libraryID?String(app.db.libraryID):String(app.libraryPath||"");
    }
    function figureIconBaseLabel(label) {
        return String(label).replace(/\s+\([0-9]+\)$/, "");
    }
    function figureIconLabelKey(fig) {
        return figureIconLibraryKey()+"|label|"+String(fig.objectName)+"|"+figureIconBaseLabel(fig.getLabel());
    }
    function figureIconSpecificIdentity(fig,create) {
        var id="";
        try{id=figureIdentity(fig,false)||"";}catch(ignoreFigureID){}
        if(id)return "figure:"+id;
        id=figureUIIdentity(fig,!!create);
        return id?"ui:"+id:"";
    }
    function figureIconSpecificKey(fig,create) {
        var id=figureIconSpecificIdentity(fig,create);
        return id?figureIconLibraryKey()+"|specific|"+id:"";
    }
    function readableFigureIconRelative(rel) {
        if(!rel)return "";
        try{safeRelative(rel);return readable(inLibrary(rel))?rel:"";}catch(e){return "";}
    }
    function figureLabelIconRelative(fig) {
        var b=app.figureIconBindings||{specific:{},label:{}},key=figureIconLabelKey(fig);
        return readableFigureIconRelative(b.label&&b.label[key]);
    }
    function figureSpecificIconRelative(fig) {
        var b=app.figureIconBindings||{specific:{},label:{}},key=figureIconSpecificKey(fig,false),rel="";
        if(key&&b.specific)rel=readableFigureIconRelative(b.specific[key]);
        if(rel)return rel;
        // A shared deletion outranks stale icon metadata in an older scene.
        if(key&&app.figureIconTombstones&&app.figureIconTombstones[key])return "";
        rel=value(fig,"FigureIcon");
        return readableFigureIconRelative(rel);
    }
    function figureCustomIconRelative(fig) {
        // Specific figure ALWAYS wins over exact-Label binding.
        return figureSpecificIconRelative(fig)||figureLabelIconRelative(fig);
    }
    function figureVisualIconPath(fig) {
        var custom=figureCustomIconRelative(fig);
        if(custom)return inLibrary(custom);
        var p=figureProfileForType(String(fig.objectName),true);
        return p?figureProfileIconPath(p):"";
    }
    function previousFigureIcon(fig,scope) {
        var bindingKey=scope==="label"?figureIconLabelKey(fig):figureIconSpecificKey(fig,false);
        if(!bindingKey||!app.db)return "";
        var current=scope==="label"?figureLabelIconRelative(fig):figureSpecificIconRelative(fig);
        var dir=figureIconBindingJournalDir();if(!pathExists(dir))return "";
        var names=listFiles(dir,"binding_*.json");names.sort();
        for(var i=names.length-1;i>=0;i--){
            var e=readJSON(dir+"/"+names[i]);
            if(!e||e.schemaVersion!==1||e.libraryID!==String(app.db.libraryID)||e.scope!==scope||(scope==="label"?figureIconBaseLabel(e.key):e.key)!==bindingKey)continue;
            var candidates=[e.relative,e.previous];
            for(var j=0;j<candidates.length;j++){
                var rel=readableFigureIconRelative(candidates[j]);
                if(rel&&rel!==current)return rel;
            }
        }
        return "";
    }
    function restorePreviousFigureIcon(fig,scope) {
        var previous=previousFigureIcon(fig,scope);
        if(!previous)throw problem("FIGURE_ICON_HISTORY","No previous icon is available for this binding.");
        return setFigureIconBinding(fig,previous,scope);
    }
    function setFigureIconBinding(fig,rel,scope) {
        rel=readableFigureIconRelative(rel);if(!rel)throw problem("FIGURE_ICON_VERIFY","Saved figure icon is missing.");
        var previous=scope==="label"?figureLabelIconRelative(fig):figureSpecificIconRelative(fig);
        var b=validateFigureIconBindings(app.figureIconBindings||{specific:{},label:{}});
        if(scope==="label"){
            b.label[figureIconLabelKey(fig)]=rel;
        }else if(scope==="specific"){
            var sk=figureIconSpecificKey(fig,true);if(!sk)throw problem("FIGURE_ICON_ID","Could not create a specific-figure icon identity.");
            b.specific[sk]=rel;
            updateData(fig,{Schema:"1",FigureUIID:figureUIIdentity(fig,true),FigureIcon:rel});
        }else throw problem("FIGURE_ICON_SCOPE",String(scope));
        app.figureIconBindings=b;persistUISettings();
        var bindingKey=scope==="label"?figureIconLabelKey(fig):figureIconSpecificKey(fig,false);
        writeSharedFigureIconBinding(scope,bindingKey,rel,previous);
        if(app.figureIconTombstones)delete app.figureIconTombstones[bindingKey];
        return rel;
    }
    function importFigureIcon(fig,path,scope) {
        path=editorImagePath(path);mkdir(app.libraryPath+"/FigureIcons");
        var source=materialCanonicalMapPath(path),root=canonicalDirectory(app.libraryPath+"/FigureIcons",false).replace(/\\/g,"/").replace(/\/$/,"")+"/";
        if(source.resolved){
            var sourcePath=source.path,insensitive=/^[A-Za-z]:/.test(root),left=insensitive?sourcePath.toLowerCase():sourcePath,right=insensitive?root.toLowerCase():root;
            if(left.indexOf(right)===0){
                var existing="FigureIcons/"+sourcePath.slice(root.length);
                safeRelative(existing);
                return setFigureIconBinding(fig,existing,scope);
            }
        }
        var rel="FigureIcons/"+unique("figure_icon")+".png",target=inLibrary(rel),px=new Pixmap(path);
        if(!px||px.isNull())throw problem("FIGURE_ICON_IMAGE",path);
        px.save(target);
        if(!readable(target))throw problem("FIGURE_ICON_WRITE",target);
        var check=new Pixmap(target);if(!check||check.isNull())throw problem("FIGURE_ICON_VERIFY",target);
        return setFigureIconBinding(fig,rel,scope);
    }
    function clearFigureIcon(fig,scope) {
        var previous=scope==="label"?figureLabelIconRelative(fig):figureSpecificIconRelative(fig);
        var b=validateFigureIconBindings(app.figureIconBindings||{specific:{},label:{}});
        if(scope==="label"){
            delete b.label[figureIconLabelKey(fig)];
        }else if(scope==="specific"){
            var sk=figureIconSpecificKey(fig,false);if(sk)delete b.specific[sk];
            var o=dataObject(fig);if(o&&own(o,"FigureIcon")){delete o.FigureIcon;putData(fig,o);}
        }else throw problem("FIGURE_ICON_SCOPE",String(scope));
        app.figureIconBindings=b;persistUISettings();
        var bindingKey=scope==="label"?figureIconLabelKey(fig):figureIconSpecificKey(fig,false);
        // Clearing an unassigned specific figure has no persistent key to erase.
        if(bindingKey){
            writeSharedFigureIconBinding(scope,bindingKey,"",previous);
            if(!app.figureIconTombstones)app.figureIconTombstones={};
            app.figureIconTombstones[bindingKey]=true;
        }
    }
    function findFigureIconCamera(fig) {
        var id=figureUIIdentity(fig,false);if(!id)return null;
        var cams=Scene.getCameraList();
        for(var i=0;i<cams.length;i++)if(value(cams[i],"Role")==="FigureIconCamera"&&value(cams[i],"FigureIconOwnerUIID")===id)return cams[i];
        return null;
    }
    function createFigureIconCamera(fig,scope) {
        if(!MainWindow)throw problem("FIGURE_ICON_CAMERA","Main window is unavailable.");
        var id=figureUIIdentity(fig,true),cam=new DzBasicCamera();
        cam.setName("Wardrobe Sets Icon Camera "+id);cam.setLabel("Wardrobe Sets Icon - "+figureDisplayLabel(fig));
        Scene.addNode(cam);updateData(cam,{Schema:"1",Role:"FigureIconCamera",FigureIconOwnerUIID:id,FigureIconBindingScope:scope==="label"?"label":"specific"});
        try{cam.useLocalDimensions=true;cam.pixelsWidth=128;cam.pixelsHeight=211;cam.proportionsConstrained=true;cam.depthOfField=false;}catch(ignore){}
        var vp=MainWindow.getViewportMgr().getActiveViewport().get3DViewport();
        beginNodeSelectionHold();
        try{
            Scene.selectAllNodes(false);Scene.setPrimarySelection(fig);vp.setCamera(cam);
            vp.frameCameraOnSelectedNodes();vp.aimCameraAtPrimaryNode();vp.aspectOn=true;
        }finally{restoreNodeSelectionHold();}
        return cam;
    }
    function renderFigureIconFromCamera(fig,cam,scope) {
        mkdir(app.libraryPath+"/FigureIcons");
        var id=figureUIIdentity(fig,true),rel="FigureIcons/"+id+"_"+unique("render")+".png",target=inLibrary(rel);
        var rm=App.getRenderMgr(),iray=rm.findRenderer("DzIrayRenderer");
        if(!iray)throw problem("IRAY_UNAVAILABLE","NVIDIA Iray renderer could not be found.");
        var oldRenderer=rm.getActiveRenderer(),opt=null,handler=null,ok=false;
        try{
            rm.setActiveRenderer(iray);
            opt=new DzRenderOptions();opt.copyFrom(rm.getRenderOptions());
            opt.isCurrentFrameRender=true;opt.renderImgToId=DzRenderOptions.DirectToFile;opt.renderImgFilename=target;
            opt.isAspectConstrained=true;opt.setAspectRatio(128,211);opt.imageSize=new Size(128,211);opt.showPreview=false;
            handler=new DzImageRenderHandler(new Size(128,211),Scene.getTime().valueOf(),target);handler.writeToFile=true;handler.setCreateThumbnail(false);
            ok=iray.render(handler,cam,opt);
        }finally{
            if(oldRenderer)try{rm.setActiveRenderer(oldRenderer);}catch(ignoreRenderer){}
            if(handler&&typeof handler.deleteLater==="function")handler.deleteLater();
            if(opt&&typeof opt.deleteLater==="function")opt.deleteLater();
        }
        if(!ok||!readable(target))throw problem("FIGURE_ICON_RENDER","Iray render did not create the figure icon.");
        var px=new Pixmap(target);
        if(!px||px.isNull()||Number(px.width)!==128||Number(px.height)!==211)
            throw problem("FIGURE_ICON_RENDER_SIZE","Expected a 128 x 211 render.");
        return setFigureIconBinding(fig,rel,scope);
    }
    function figureIconDialog(fig) {
        if(isStandardFigureLabel(fig))return "unchanged";
        var dlg=newGeorgiaDialog();dlg.caption=TITLE+" - Figure Icon - "+figureDisplayLabel(fig);dlg.showHelpButton(false);dlg.showCancelButton(false);dlg.showAcceptButton(false);
        var box=new DzVGroupBox(dlg),body=new DzHGroupBox(box),preview=new DzLabel(body);preview.setFixedSize(128,211);preview.alignment=0x84;
        var options=new DzVGroupBox(body),scopeRow=new DzHGroupBox(options),scopeLabel=label(scopeRow,"Assign icon to:"),binding=new DzComboBox(scopeRow);
        binding.addItem("This specific figure");
        binding.addItem("Any "+String(fig.objectName)+" with Label '"+figureIconBaseLabel(fig.getLabel())+"' (including numbered copies)");
        var cam0=findFigureIconCamera(fig),specific0=figureSpecificIconRelative(fig),label0=figureLabelIconRelative(fig);
        binding.currentItem=cam0&&value(cam0,"FigureIconBindingScope")==="label"?1:(!specific0&&label0?1:0);
        var info=label(options,""),choose=new DzPushButton(options),render=new DzPushButton(options),restore=new DzPushButton(options),standard=new DzPushButton(options);
        options.minWidth=410;scopeLabel.minWidth=95;
        choose.text="Choose Image...";
        render.text=findFigureIconCamera(fig)?"Render from Icon Camera":"Create Icon Camera";
        restore.text="Restore Previous Icon";restore.setFixedHeight(36);restore.autoDefault=false;
        standard.text="Clear Selected Binding";
        choose.setFixedHeight(36);render.setFixedHeight(36);standard.setFixedHeight(36);
        choose.autoDefault=render.autoDefault=standard.autoDefault=false;
        var changed=false,cameraCreated=false,renderRequest=null;
        function selectedScope(){return binding.currentItem===1?"label":"specific";}
        function refresh(){
            restore.enabled=!!previousFigureIcon(fig,selectedScope());
            var p=figureVisualIconPath(fig),specific=figureSpecificIconRelative(fig),byLabel=figureLabelIconRelative(fig);preview.clear();
            try{if(p){var px=new Pixmap(p);if(px&&!px.isNull()){scalePixmapTo(px,128,211,true);preview.pixmap=px;}}}catch(ignore){}
            var effective=specific?"specific figure":(byLabel?"Label family":"standard "+String(fig.objectName));
            info.text="Editing: "+(selectedScope()==="specific"?"this specific figure":"Label '"+figureIconBaseLabel(fig.getLabel())+"' and numbered copies")+
                "\nEffective icon: "+effective+
                (specific&&byLabel?"\nSpecific figure icon overrides the Label icon on this figure.":"")+
                (selectedScope()==="specific"&&!figureIdentity(fig,false)&&!figureUIIdentity(fig,false)?"\nSave the scene after assigning a specific-figure icon so its unique identity persists.":"");
            render.text=findFigureIconCamera(fig)?"Render from Icon Camera":"Create Icon Camera";
        }
        connect(binding,"activated(int)",refresh);
        connect(choose,"clicked()",function(){
            var p=FileDialog.doFileDialog(true,"Choose figure icon","","Images (*.png *.jpg *.jpeg *.bmp)");
            if(!p)return;
            try{importFigureIcon(fig,p,selectedScope());changed=true;refresh();}catch(e){MessageBox.warning(userErrorText(e),TITLE,"&OK");}
        });
        connect(restore,"clicked()",function(){
            try{restorePreviousFigureIcon(fig,selectedScope());changed=true;refresh();}catch(e){MessageBox.warning(userErrorText(e),TITLE,"&OK");}
        });
        connect(standard,"clicked()",function(){
            try{clearFigureIcon(fig,selectedScope());changed=true;refresh();}catch(e){MessageBox.warning(userErrorText(e),TITLE,"&OK");}
        });
        connect(render,"clicked()",function(){
            try{
                var cam=findFigureIconCamera(fig);
                if(!cam){
                    renderRequest={type:"create_figure_icon_camera",figureKey:key(fig),scope:selectedScope()};
                    dlg.close();return;
                }
                render.enabled=false;choose.enabled=false;restore.enabled=false;standard.enabled=false;binding.enabled=false;close.enabled=false;
                try{renderFigureIconFromCamera(fig,cam,selectedScope());changed=true;}
                finally{render.enabled=true;choose.enabled=true;standard.enabled=true;binding.enabled=true;close.enabled=true;refresh();}
            }catch(e){MessageBox.warning(userErrorText(e),TITLE,"&OK");}
        });
        var closeRow=new DzHGroupBox(box),closeSpacer=label(closeRow,""),close=new DzPushButton(closeRow);closeSpacer.minWidth=470;
        close.setFixedSize(120,36);close.text="Close";close.sizedFromIcon=true;close.autoDefault=false;
        setTextButtonResourceIconCandidates(close,["Wearable Manager Close.png"],24,24,true);
        connect(close,"clicked()",function(){dlg.close();});
        refresh();dlg.addWidget(box);dlg.setFixedSize(660,355);
        try{dlg.exec();}finally{dlg.deleteLater();}
        return renderRequest||(cameraCreated?"camera_created":(changed?"changed":"unchanged"));
    }
    
    function setScopeCardBorder(group,kind) {
        var color=kind==="figure"?"#C69B42":(kind==="label"?"#5E8FD8":"#777777");
        try{
            var w=group.getWidget();w.objectName="WardrobeScopeCard";
            w.setStyleSheet("QGroupBox#WardrobeScopeCard { border: 2px solid "+color+"; border-radius: 5px; margin-top: 2px; padding: 4px; }");
        }catch(ignore){}
    }
    function setFigureSelectedStyle(button,selected) {
        try{button.getWidget().setStyleSheet(selected?"QPushButton { border: 3px solid #D7B04D; }":"");}catch(ignore){}
    }
    function setModifiedTime(st) {
        var s=st.modified||st.created||"",t=new Date(s).getTime();
        return isFinite(t)?t:0;
    }
    function setScopeRank(st) {
        return st.scope.kind==="figure"?0:(st.scope.kind==="label"?1:2);
    }
    function compatibleDialogSetIDs(db,fig) {
        // Switching the selected figure recreates this dialog. Sets excluded
        // by scope would be hidden for its entire lifetime; do not build them.
        if(!fig)return [];
        return Object.keys(db.sets).filter(function(id){
            try{return !scopeProblem(db.sets[id],fig);}catch(ignoreScope){return false;}
        });
    }
    function mainDialog() {
        var dlg=newGeorgiaDialog(true);dlg.caption=TITLE;
        var mainLayout=new DzVBoxLayout(dlg);mainLayout.margin=0;mainLayout.spacing=0;
        var box = new DzVGroupBox(dlg);

        var header = new DzHGroupBox(box), leftHeaderPad = new DzLabel(header), heading = label(header, " < span style = 'font-size:20px;font-family:georgia;color:#87CEEB' >Figures in scene</span >"), editFigureIcon = new DzPushButton(header);
        flattenGroupBox(header);header.insideMargin=0;header.setFixedHeight(40);leftHeaderPad.setFixedWidth(44); heading.alignment = 0x84; heading.minWidth = 700; header.flat = true;
        var headingFont=newGeorgiaFont();headingFont.pixelSize=20;heading.font=headingFont;
        editFigureIcon.setFixedSize(36,36);editFigureIcon.toolTip="Edit the selected scene figure icon.";
        setResourceButtonIcon(editFigureIcon,"Wearable Manager Edit.png",30,30);

        var scene=sceneNodes(),figs=[],preferred=humanAncestor(Scene.getPrimarySelection()),selectedIndex=0;
        if(!preferred&&Scene.getPrimarySelection())preferred=humanAncestor(follow(Scene.getPrimarySelection()));
        for(var i=0;i<scene.length;i++)if(figureVisibleInWM2(scene[i]))figs.push(scene[i]);
        for(i=0;i<figs.length;i++)if(key(figs[i])===app.lastFigureKey||(!app.lastFigureKey&&same(figs[i],preferred)))selectedIndex=i;

        var figureScroll=new DzScrollArea(box);figureScroll.widgetResizable=false;
        figureScroll.setFixedHeight(270); figureScroll.setHorizontalScrollbarDisplay(true);
        try{figureScroll.setVerticalScrollbarDisplay(false);}catch(ignoreVScroll){}
        var figureContent = new DzHGroupBox(figureScroll); figureScroll.setWidget(figureContent); figureContent.flat = true;
        figureContent.setFixedSize(Math.max(140,figs.length*140),242);
        var figureButtons=[];
        for(i=0;i<figs.length;i++)(function(fig,index){
            var cell=new DzVGroupBox(figureContent),btn=new DzPushButton(cell),nm=label(cell,figureDisplayLabel(fig));
            cell.setFixedSize(136,238);
            btn.setFixedSize(128,211);btn.text="";btn.sizedFromIcon=true;btn.buttonStyle=DzPushButton.BTool;
            btn.toolTip=figureDisplayLabel(fig)+" ["+fig.objectName+"]";
            if(!setPathButtonPixmap(btn,figureVisualIconPath(fig),124,207,true,true))btn.text=figureDisplayLabel(fig);
            nm.alignment=0x84;nm.setFixedWidth(128);
            figureButtons.push({button:btn,label:nm,figure:fig});
            connect(btn,"clicked()",function(){if(selectedIndex===index)return;selectedIndex=index;app.lastFigureKey=key(fig);action={type:"refresh",figureKey:key(fig)};dlg.close();});
        })(figs[i],i);
        if(!figs.length){
            var reason;
            if(!wm2Figures.available&&!wm2Figures.fallback){
                reason="Shared WM2 figures unavailable: "+wm2Figures.reason+". Check Resources/Wearable Manager Settings.json.";
            }else if(wm2Figures.available){
                var found=[],seenFound={};
                for(var di=0;di<scene.length;di++){
                    var dn=scene[di];
                    if(dn&&dn.inherits("DzFigure")){
                        var dName=String(dn.objectName||"")+" ("+wm2FigureName(dn)+")";
                        if(!seenFound["$"+dName]){found.push(dName);seenFound["$"+dName]=true;}
                    }
                }
                reason="No matching supported figures. WM2 supportedFigures: "+
                    wm2Figures.config.supportedFigures.slice(0,10).join(", ")+
                    (wm2Figures.config.supportedFigures.length>10?"...":"")+
                    ". DzFigure nodes: "+(found.length?found.slice(0,6).join(", "):"none")+".";
            }else reason="No supported figures are present in this scene.";
            label(figureContent,reason);editFigureIcon.enabled=false;
        }

        var filterRow=new DzHGroupBox(box),filterLabelCol=new DzVGroupBox(filterRow),filterEditCol=new DzVGroupBox(filterRow),
            groupFilterLabelCol=new DzVGroupBox(filterRow),groupFilterEditCol=new DzVGroupBox(filterRow);
        flattenGroupBox(filterRow);filterRow.insideMargin=0;filterRow.setFixedHeight(36);flattenGroupBox(filterLabelCol);flattenGroupBox(filterEditCol);
        flattenGroupBox(groupFilterLabelCol);flattenGroupBox(groupFilterEditCol);
        var filterLabelPad=new DzLabel(filterLabelCol);filterLabelPad.setFixedHeight(5);label(filterLabelCol,"Find outfits:");
        var filterEditPad=new DzLabel(filterEditCol);filterEditPad.setFixedHeight(5);var search=new DzLineEdit(filterEditCol);
        search.text=app.searchText||"";search.minWidth=330;
        var groupFilterPad=new DzLabel(groupFilterLabelCol);groupFilterPad.setFixedHeight(5);label(groupFilterLabelCol,"Group:");
        var groupEditPad=new DzLabel(groupFilterEditCol);groupEditPad.setFixedHeight(5);
        var groupFilter=new DzComboBox(groupFilterEditCol),groupFilterRows=[{id:"__all__",name:"All Groups"},
            {id:"__default__",name:"Default"}].concat(setGroupEntries(app.db));
        groupFilter.minWidth=195;
        for(var gf=0;gf<groupFilterRows.length;gf++)groupFilter.addItem(groupFilterRows[gf].name);
        var rememberedGroup=String(app.groupFilterID||"__all__");groupFilter.currentItem=0;
        for(gf=0;gf<groupFilterRows.length;gf++)if(groupFilterRows[gf].id===rememberedGroup){groupFilter.currentItem=gf;break;}

        var actions=new DzHGroupBox(box);flattenGroupBox(actions);actions.setFixedHeight(72);var actionsLayout=new DzBoxLayout(actions);
        var create=new DzPushButton(actions),registered=new DzPushButton(actions),takeOffAll=new DzPushButton(actions);
        create.text = "                 New Set..."; registered.text = "                      Wardrobe..."; takeOffAll.text = "                           Take Off All";
        create.setFixedSize(250,64);registered.setFixedSize(250,64);takeOffAll.setFixedSize(250,64);
        actionsLayout.addSpacing(25);actionsLayout.addWidget(create);actionsLayout.addSpacing(20);actionsLayout.addWidget(registered);actionsLayout.addSpacing(20);actionsLayout.addWidget(takeOffAll);actionsLayout.addSpacing(25);
        setTextButtonResourceIconCandidates(create,["Wearable Manager New Set.png","Wearable Manager Wardrobe Sets New Set.png"],64,64,true);
        setTextButtonResourceIconCandidates(registered, ["Wearable Manager Registered Items.png", "Wearable Manager Wardrobe Sets Registered Items.png"], 64, 64, true);
        setTextButtonResourceIconCandidates(takeOffAll, ["Wearable Manager Take Off All.png", "Wearable Manager Wardrobe Sets Take Off All.png"], 64, 64, true);
        registered.toolTip="Manage registered items on the figure and in its wardrobe.";
        takeOffAll.toolTip="Store all currently worn registered items for the selected figure. Unregistered scene items remain unchanged.";
        create.enabled=registered.enabled=!!figs.length;takeOffAll.autoDefault=false;takeOffAll["default"]=false;

        var sceneStatus=label(box,""),scroll=new DzScrollArea(box);scroll.widgetResizable=true;
        scroll.setFixedHeight(430);scroll.setHorizontalScrollbarDisplay(false);
        var content=new DzVGroupBox(scroll);scroll.setWidget(content);
        sceneStatus.setFixedHeight(22);var status=label(box,shortActionStatus(app.lastReport));status.setFixedHeight(22);

        var bottom=new DzHGroupBox(box),settings=new DzPushButton(bottom),bottomStatus=label(bottom,""),close=new DzPushButton(bottom);
        flattenGroupBox(bottom);bottom.insideMargin=0;bottom.setFixedHeight(40);settings.setFixedSize(36,36);settings.text="";settings.toolTip="Settings";settings.sizedFromIcon=true;settings.buttonStyle=DzPushButton.BTool;
        setResourceButtonIconCandidates(settings,["Wearable Manager Settings.png"],32,32);
        bottomStatus.text="";bottomStatus.minWidth=620;
        close.setFixedSize(120,36);close.text="Close";close.sizedFromIcon=true;close.autoDefault=false;
        setTextButtonResourceIconCandidates(close, ["Wearable Manager Close.png"],24,24,true);

        var sortFigure=figs.length?figs[selectedIndex]:null,sortSummary=sortFigure?readOutfitSummary(sortFigure):{valid:false,activeIDs:[],message:""};
        var sets=compatibleDialogSetIDs(app.db,sortFigure),cards=[],busy=false,action=null,summary=sortSummary,
            recoverableComposite=null,shownCommit=app.db.commitID;
        sets.sort(function(a,b){
            var aa=app.db.sets[a],bb=app.db.sets[b],aw=false,bw=false;
            if(sortFigure&&sortSummary.valid){
                try{aw=!scopeProblem(aa,sortFigure)&&outfitMatches(aa,sortSummary);}catch(ignoreAW){}
                try{bw=!scopeProblem(bb,sortFigure)&&outfitMatches(bb,sortSummary);}catch(ignoreBW){}
            }
            if(aw!==bw)return aw?-1:1;
            var ra=setScopeRank(aa),rb=setScopeRank(bb);
            if(ra!==rb)return ra-rb;
            var ta=setModifiedTime(aa),tb=setModifiedTime(bb);if(ta!==tb)return tb-ta;
            return aa.name.localeCompare(bb.name);
        });
        function currentFigure(){return figs.length?figs[selectedIndex]:null;}
        function selectedGroupFilter(){var row=groupFilterRows[groupFilter.currentItem];return row?row.id:"__all__";}
        function persistControls(){app.searchText=String(search.text);app.groupFilterID=selectedGroupFilter();app.onlyCompatible=true;persistUISettings();}
        function updateFigureSelection(){
            var fig=currentFigure();
            for(var j=0;j<figureButtons.length;j++){
                var selected=j===selectedIndex;setFigureSelectedStyle(figureButtons[j].button,selected);
                // ASCII-only script literal: DAZ 4 otherwise displays UTF-8 bytes
                // as mojibake (e.g. "a-circumflex" glyphs) instead of the arrow.
                figureButtons[j].label.text=(selected?"\u25B6 ":"")+figureDisplayLabel(figureButtons[j].figure);
            }
            var editable=!!fig&&!isStandardFigureLabel(fig);
            if(editable)editFigureIcon.show();else editFigureIcon.hide();
            editFigureIcon.enabled=editable&&!busy;
        }
        function renderCards(refreshDiagnostics){
            var fig=currentFigure(),visible=0;
            // An incomplete registered composite must NEVER be undressed by
            // the ordinary inventory transaction. Instead expose the safe
            // variant-resolution path in the same toolbar position.
            recoverableComposite=null;
            if(fig&&!summary.valid)try{recoverableComposite=compositeAdditionOnFigure(fig);}catch(ignoreUnsafeComposite){}
            takeOffAll.enabled=!!fig&&!busy&&(
                (summary.valid&&summary.activeIDs.length>0)||!!recoverableComposite);
            takeOffAll.text=recoverableComposite?"                  Resolve Changed Wearable...":
                "Take Off All"+(summary.valid&&summary.activeIDs.length?" ("+summary.activeIDs.length+")":"");
            takeOffAll.toolTip=recoverableComposite?
                "Create a new registered variant for the changed child hierarchy; active old-item Overrides can be safely reset with confirmation. Ordinary Take Off All remains unavailable until the hierarchy is valid.":
                "Store all currently worn registered items for the selected figure.";
            create.enabled=registered.enabled=!!fig&&!busy;
            editFigureIcon.enabled=!!fig&&!isStandardFigureLabel(fig)&&!busy;
            // Every structurally worn Set is evaluated independently. Identical
            // item lists can have different material snapshots; neither the
            // last Apply ID nor PropertyState alone selects the visual Worn Set.
            var propertiesBySet={},materialsBySet={},needsStatusRead=false;
            if(refreshDiagnostics!==false){
                for(var sidx=0;sidx<cards.length;sidx++){
                    var candidate=cards[sidx],candidateCompatible=false;
                    try{candidateCompatible=!!fig&&!scopeProblem(candidate.set,fig);}catch(ignoreScope){}
                    if(candidateCompatible&&outfitMatches(candidate.set,summary)){
                        var overrideCount=setPropertyOverrides(candidate.set).length;
                        propertiesBySet[candidate.set.id]={worn:true,status:"worn",changed:[],missing:[],total:overrideCount};
                        materialsBySet[candidate.set.id]={tracked:0,matched:0,changed:[],unavailable:[],compatible:0};
                        if(overrideCount||partStateEntries(candidate.set).length||hasSetMaterialSnapshots(candidate.set))needsStatusRead=true;
                    }
                }
                if(needsStatusRead){
                    try{withReadScope(function(){
                        var inv=inventory(fig,app.db);
                        for(var di=0;di<cards.length;di++){
                            var setRec=cards[di].set,id=setRec.id;
                            if(!propertiesBySet[id])continue;
                            if(setPropertyOverrides(setRec).length||partStateEntries(setRec).length){
                                try{propertiesBySet[id]=diagnoseOutfitProperties(setRec,fig,summary,inv);}
                                catch(propError){propertiesBySet[id]={worn:true,status:"unavailable",changed:[],missing:[
                                    {target:"Scene",name:"Property status",propertyName:"",reason:String(propError)}],total:setPropertyOverrides(setRec).length};}
                            }
                            if(hasSetMaterialSnapshots(setRec)){
                                try{materialsBySet[id]=diagnoseOutfitMaterialStatus(setRec,inv,fig);}
                                catch(materialError){materialsBySet[id]={tracked:Object.keys(setMaterialSnapshots(setRec)).length,
                                    matched:0,changed:[],unavailable:[String(materialError)],compatible:0};}
                            }
                        }
                    },false);}catch(readError){
                        for(var ri=0;ri<cards.length;ri++){
                            var affected=cards[ri].set,aid=affected.id;
                            if(!propertiesBySet[aid])continue;
                            propertiesBySet[aid]={worn:true,status:"unavailable",changed:[],missing:[
                                {target:"Scene",name:"Status",propertyName:"",reason:String(readError)}],total:setPropertyOverrides(affected).length};
                            if(hasSetMaterialSnapshots(affected))materialsBySet[aid]={tracked:Object.keys(setMaterialSnapshots(affected)).length,
                                matched:0,changed:[],unavailable:[String(readError)],compatible:0};
                        }
                    }
                }
            }else{
                // Search/group changes only filter the current display snapshot.
                // Scene actions and dialog reopen always read fresh diagnostics.
                for(var ci=0;ci<cards.length;ci++){
                    propertiesBySet[cards[ci].set.id]=cards[ci].diagnosis;
                    materialsBySet[cards[ci].set.id]=cards[ci].materialDiagnosis;
                }
            }
            for(var j=0;j<cards.length;j++){
                var rec=cards[j],why="No figure selected";
                try{if(fig)why=scopeProblem(rec.set,fig);}catch(e){why=String(e);}
                var compatible=!!fig&&!why,match=compatible&&outfitMatches(rec.set,summary),diagnosis=propertiesBySet[rec.set.id]||null;
                rec.diagnosis=diagnosis;rec.materialDiagnosis=materialsBySet[rec.set.id]||null;
                rec.apply.enabled=compatible&&!busy;rec.partial.enabled=compatible&&!busy;rec.edit.enabled=compatible&&!busy;rec.dup.enabled=compatible&&!busy;rec.del.enabled=compatible&&!busy;
                // A Set is removable when ANY of its registered members is worn;
                // unlike the green Worn indicator, full membership is not required.
                var hasWornMember=compatible&&summary.valid&&rec.set.items.some(function(id){return summary.activeIDs.indexOf(id)>=0;});
                if(hasWornMember)rec.removeSet.show();else rec.removeSet.hide();
                rec.removeSet.enabled=hasWornMember&&!busy;
                if(match)rec.worn.show();else rec.worn.hide();
                if(match||hasSetMaterialSnapshots(rec.set)||hasSavedHandPoses(rec.set))rec.propertyRow.show();else rec.propertyRow.hide();
                if(hasSetMaterialSnapshots(rec.set))rec.materialDetails.show();else rec.materialDetails.hide();
                rec.materialDetails.enabled=compatible&&!busy;
                if(hasSavedHandPoses(rec.set))rec.restoreHands.show();else rec.restoreHands.hide();
                rec.restoreHands.enabled=compatible&&!busy;
                if(match){
                    var propStatus=diagnosis?diagnosis.status:"unavailable",materialStatus=rec.materialDiagnosis;
                    var wornStatus=outfitCombinedWornStatus(diagnosis,materialStatus);
                    var materialChanged=!!(materialStatus&&materialStatus.changed.length);
                    var materialUnknown=!!(materialStatus&&materialStatus.unavailable.length);
                    rec.worn.toolTip="All required set clothes are worn. Property overrides: "+propStatus+
                        "; materials: "+(materialChanged?"modified":(materialUnknown?"status unavailable":"matching saved snapshot or not specified"))+".";
                    var limited=outfitHasPartiallyVerifiedMaterials(diagnosis,materialStatus);
                    if(limited)rec.partiallyVerifiedRow.show();else rec.partiallyVerifiedRow.hide();
                    // Fixed 128px icon plus small top/bottom gutters; taller
                    // only when the partial-verification status needs a row.
                    rec.group.setFixedHeight(limited?165:143);
                    rec.right.setFixedSize(272,limited?155:133);
                    // Partial verification is the sole visible warning when
                    // material coverage is limited; never stack Modified too.
                    rec.propertyLabel.text=limited?"":outfitCombinedStatusText(wornStatus);
                    try{rec.propertyLabel.getWidget().setStyleSheet("QLabel { color: "+(wornStatus==="worn"?"#71DFA0":"#E7CA76")+"; font-weight: bold; }");}catch(ignoreStatusStyle){}
                    // A material-only mismatch must not reveal a property-only
                    // restore button that would fail with NO_PROPERTY_CHANGE.
                    if(diagnosis&&diagnosis.changed.length)rec.restoreProperties.show();else rec.restoreProperties.hide();
                    rec.restoreProperties.enabled=compatible&&!busy;

                }else{
                    rec.partiallyVerifiedRow.hide();
                    rec.group.setFixedHeight(143);rec.right.setFixedSize(272,133);
                    rec.propertyLabel.text="";rec.restoreProperties.hide();
                }
                rec.items.text=describeIDs(rec.set.items);
                rec.scope.text=scopeDisplayText(rec.set);
                rec.scope.toolTip="Group: "+groupDisplayName(rec.set,app.db);
                var showCard=cardVisible(rec.set,compatible,String(search.text)) &&
                    groupFilterMatches(rec.set,selectedGroupFilter());
                if(showCard){rec.group.show();visible++;}else rec.group.hide();
            }
            sceneStatus.text=summary.valid?summary.activeIDs.length+" registered item(s) currently worn | "+visible+" compatible outfit set(s) shown":summary.message;
        }
        function readSceneStatus(){
            // One read scope for summary inventory + Worn-card material/property
            // diagnostics. Nested withReadScope/inventory reuse this scope.
            withReadScope(function(){
                var fig=currentFigure();summary=fig?readOutfitSummary(fig):{valid:false,activeIDs:[],message:"No supported scene figure selected."};
                updateFigureSelection();renderCards();
            },false);
        }
        function leave(type,id){
            if(busy||action)return;
            try{persistControls();}catch(e){MessageBox.warning("Could not save preferences: "+userErrorText(e),TITLE,"&OK");return;}
            action={type:type,id:id||"",figureKey:currentFigure()?key(currentFigure()):""};dlg.close();
        }
        function applyCard(st){
            var fig=currentFigure();if(busy||action||!fig)return;
            busy=true;box.enabled=false;status.text="Applying "+st.name+"...";
            var r=null;
            try{
                persistControls();app.lastFigureKey=key(fig);
                // A changed registered hierarchy cannot pass strict inventory.
                // Guide the user to the dedicated, transactional new-variant
                // workflow instead of printing an ITEM_HIERARCHY stack.
                if(!summary.valid&&compositeAdditionOnFigure(fig)){
                    action={type:"resolve_composite",figureKey:key(fig)};dlg.close();return;
                }
                var labelCheck=confirmPossibleUnregisteredLabelMatches(st,fig);
                if(!labelCheck.accepted){status.text="Cancelled. No wardrobe items changed.";return;}
                var sourceChoice=chooseOutfitSources(st,fig);
                if(sourceChoice===null){status.text="Cancelled. No wardrobe items changed.";return;}
                r=runAction("apply",key(fig),{id:st.id,selection:setSelectionSnapshot(st,"Apply: "+st.name),sources:sourceChoice,similarLabelMatches:labelCheck.matches});
                status.text=shortActionStatus(r);
                if(presentActionReport(r)==="settings") {
                    action={type:"settings",figureKey:key(fig)};
                    dlg.close();return;
                }
                if(app.abortRequested){action={type:"abort",figureKey:key(fig)};dlg.close();return;}
                if(shownCommit!==app.db.commitID){action={type:"refresh",figureKey:key(fig)};dlg.close();return;}
                if(r&&r.ok){action={type:"refresh",figureKey:key(fig)};dlg.close();return;}
                readSceneStatus();
            }catch(e){
                r=runAction("apply",key(fig),{id:st.id,preflightError:e});
                status.text=shortActionStatus(r);presentActionReport(r);
            }
            finally{busy=false;box.enabled=true;renderCards();}
        }
        function freshPropertyDiagnosis(st,fig) {
            var latest=readOutfitSummary(fig);
            if(!latest.valid)throw problem("PROPERTY_STATUS",latest.message);
            if(!outfitMatches(st,latest))return {worn:false,status:"not_worn",changed:[],missing:[],total:setPropertyOverrides(st).length};
            return withReadScope(function(){return diagnoseOutfitProperties(st,fig,latest,inventory(fig,app.db));},false);
        }

