                readSceneStatus();
            }catch(e){status.text="Stopped - "+userErrorText(e);MessageBox.critical(userErrorText(e),TITLE,"&OK");}
            finally{busy=false;box.enabled=true;renderCards();}
        }
        function takeOffCardSet(st){
            var fig=currentFigure();if(!fig||busy||action)return;
            var count=0;
            if(summary.valid)for(var i=0;i<st.items.length;i++)if(summary.activeIDs.indexOf(st.items[i])>=0)count++;
            if(!count)return;
            // Direct action by explicit user request; all original transactional
            // preflight checks, safety guards and rollback remain in runAction.
            busy=true;box.enabled=false;status.text="Taking off Set "+st.name+"...";
            try{
                persistControls();app.lastFigureKey=key(fig);
                var result=runAction("remove_set",key(fig),{id:st.id,commitID:app.db.commitID,libraryID:app.db.libraryID});
                status.text=shortActionStatus(result);presentActionReport(result);
                if(app.abortRequested){action={type:"abort",figureKey:key(fig)};dlg.close();return;}
                if(shownCommit!==app.db.commitID){action={type:"refresh",figureKey:key(fig)};dlg.close();return;}
                readSceneStatus();
            }catch(e){status.text="Stopped - "+userErrorText(e);MessageBox.critical(userErrorText(e),TITLE,"&OK");}
            finally{busy=false;box.enabled=true;renderCards();}
        }
        function takeOffRegistered(){
            var fig=currentFigure();if(busy||action||!fig)return;
            if(recoverableComposite){
                try{persistControls();action={type:"resolve_composite",figureKey:key(fig)};dlg.close();}
                catch(resolveError){if(!compositeDialogError(resolveError))MessageBox.warning(userErrorText(resolveError),TITLE,"&OK");}
                return;
            }
            if(!summary.valid||!summary.activeIDs.length)return;
            if(MessageBox.warning("Take off ALL currently worn registered items ("+summary.activeIDs.length+")?"+
                "\n\nThis ignores Keep and Replace If Needed rules. Unregistered scene items are unaffected.",
                TITLE+" - Take Off All","&Take Off All","&Cancel")!==0)return;
            busy=true;box.enabled=false;status.text="Taking off registered items...";
            try{
                persistControls();app.lastFigureKey=key(fig);
                var r=runAction("undress_all",key(fig),{});status.text=shortActionStatus(r);presentActionReport(r);
                if(app.abortRequested){action={type:"abort",figureKey:key(fig)};dlg.close();return;}
                if(shownCommit!==app.db.commitID){action={type:"refresh",figureKey:key(fig)};dlg.close();return;}
                readSceneStatus();
            }catch(e){status.text="Stopped - "+userErrorText(e);MessageBox.critical(userErrorText(e),TITLE,"&OK");}
            finally{busy=false;box.enabled=true;renderCards();}
        }
        connect(takeOffAll,"clicked()",takeOffRegistered);
        var cardTitleFont=newGeorgiaFont();cardTitleFont.pixelSize=18;cardTitleFont.bold=true;
        for(i=0;i<sets.length;i++)(function(st){
            var group=new DzHGroupBox(content),apply=new DzPushButton(group),middle=new DzVGroupBox(group),right=new DzVGroupBox(group);
            group.setFixedHeight(143);setScopeCardBorder(group,st.scope.kind);flattenGroupBox(middle);
            // Main card content begins at the same top inset as the icon.
            middle.insideMargin=0;middle.insideSpacing=2;
            apply.text="";apply.setFixedSize(100,128);apply.sizedFromIcon=true;apply.buttonStyle=DzPushButton.BTool;
            apply.toolTip="Apply "+st.name+". Contents: "+describeIDs(st.items);setCardIcon(apply,st);

            var title=label(middle,st.name),items=label(middle,describeIDs(st.items)),infoGap=new DzLabel(middle),scope=label(middle,scopeDisplayText(st));
            title.font=cardTitleFont;title.toolTip="Contents: "+describeIDs(st.items);
            title.alignment=0x21; // Qt AlignLeft | AlignTop
            title.setFixedHeight(24);
            try{title.getWidget().setStyleSheet("QLabel { font-family: 'Georgia'; color: #F0D98A; font-weight: bold; }");}catch(ignoreCardTitleStyle){}
            items.wordWrap=true;items.minWidth=520;items.toolTip=title.toolTip;scope.toolTip=title.toolTip;
            // Both the exact figure Label and the Genesis type scope are metadata.
            // The requested italic face distinguishes them from outfit contents.
            var scopeFont=newGeorgiaFont();scopeFont.italic=true;scope.font=scopeFont;
            try{scope.getWidget().setStyleSheet("QLabel { font-family: 'Georgia'; font-style: italic; }");}catch(ignoreScopeItalic){}
            infoGap.setFixedHeight(2);
            // Limited-coverage warning replaces the Modified text when both
            // apply. Diagnostics/restore actions still expose real differences.
            var partiallyVerifiedRow=new DzHGroupBox(middle);flattenGroupBox(partiallyVerifiedRow);
            partiallyVerifiedRow.setFixedHeight(22);
            var partiallyVerifiedLabel=label(partiallyVerifiedRow,"Worn \u00B7 Partially Verified");
            partiallyVerifiedLabel.setFixedWidth(245);
            partiallyVerifiedLabel.toolTip="Some shader fields cannot be verified. See Settings > Last Report for technical diagnostics.";
            try{partiallyVerifiedLabel.getWidget().setStyleSheet("QLabel { color: #BCD967; font-weight: bold; }");}catch(ignorePartialStyle){}
            partiallyVerifiedRow.hide();
            // Keep wardrobe-worn and property-state status independent. Restore
            // applies numeric overrides only; it never undresses the figure.
            var propertyRow=new DzHGroupBox(middle);flattenGroupBox(propertyRow);
            propertyRow.insideMargin=0;propertyRow.insideSpacing=6;propertyRow.setFixedHeight(34);
            var propertyLabel=label(propertyRow,""),restoreProperties=new DzPushButton(propertyRow);
            var materialDetails=new DzPushButton(propertyRow),restoreHands=new DzPushButton(propertyRow);
            restoreHands.setFixedSize(32,32);restoreHands.autoDefault=false;
            restoreHands.toolTip="Restore Hand Poses: restore only the saved right and/or left hand pose for this set.";
            if(!setResourceButtonIcon(restoreHands,"Wearable Manager Restore Hand Poses.png",32,32))restoreHands.text="H";
            propertyLabel.setFixedWidth(160);
            // Icon-only restoration controls. Keep the existing click handlers
            // and the guarded visibility/enabled logic in renderCards().
            restoreProperties.setFixedSize(32,32);restoreProperties.autoDefault=false;
            restoreProperties.toolTip="Restore Properties: restore this set's Apply values without changing registered clothes.";
            if(!setResourceButtonIcon(restoreProperties,"Wearable Manager Restore Properties.png",32,32)){
                restoreProperties.text="P"; // visible fallback if the icon resource is missing
            }
            // Materials is NOT diagnostics-only: it restores saved native
            // presets for selected worn items through a verified transaction.
            materialDetails.setFixedSize(32,32);materialDetails.autoDefault=false;
            materialDetails.toolTip="Restore Materials: manually restore saved materials for selected worn items; each restore is backed up and verified.";
            if(!setResourceButtonIcon(materialDetails,"Wearable Manager Restore Materials.png",32,32)){
                materialDetails.text="M"; // visible fallback if the icon resource is missing
            }

            // Compact icon toolbar, in the requested action order.  No action
            // semantics or preflight rules change; this only changes the UI.
            right.setFixedSize(272,133);flattenGroupBox(right);
            var wornRow=new DzHGroupBox(right),wornSpacer=new DzLabel(wornRow),worn=new DzLabel(wornRow);flattenGroupBox(wornRow);
            wornRow.setFixedHeight(32);wornSpacer.setFixedWidth(214);worn.setFixedSize(32,32);worn.toolTip="This outfit is currently worn.";
            setLabelResourcePixmap(worn,"Wearable Manager Worn.png",30,30);
            var toolGap=new DzLabel(right);toolGap.setFixedHeight(2);
            var tools=new DzHGroupBox(right),edit=new DzPushButton(tools),dup=new DzPushButton(tools),
                partial=new DzPushButton(tools),removeSet=new DzPushButton(tools),
                toolbarDivider=label(tools,"|"),del=new DzPushButton(tools);
            flattenGroupBox(tools);tools.setFixedHeight(48);
            edit.setFixedSize(42,42);dup.setFixedSize(42,42);partial.setFixedSize(42,42);
            removeSet.setFixedSize(42,42);del.setFixedSize(42,42);
            toolbarDivider.setFixedSize(11,42);toolbarDivider.alignment=0x84;
            try{toolbarDivider.getWidget().setStyleSheet("QLabel { color: #A5A5A5; font-weight: bold; }");}catch(ignoreToolbarDivider){}
            edit.toolTip="Edit "+st.name;
            dup.toolTip="Duplicate "+st.name+" and open the duplicate in Set Editor";
            partial.toolTip="Partial Sets: apply selected items and property overrides.";
            removeSet.toolTip="Take Off Set: store all worn members of this Set regardless of Keep/Replace policy, and reset its active Property Overrides. Other items stay worn.";
            del.toolTip="Delete "+st.name;
            edit.autoDefault=false;dup.autoDefault=false;partial.autoDefault=false;
            removeSet.autoDefault=false;del.autoDefault=false;
            // Match the existing icon-only toolbar controls on DAZ 4 and 6.
            dup.buttonStyle=DzPushButton.BTool;partial.buttonStyle=DzPushButton.BTool;
            removeSet.buttonStyle=DzPushButton.BTool;
            setResourceButtonIcon(edit,"Wearable Manager Edit.png",36,36);
            if(!setResourceButtonIconCandidates(dup,["Wearable Manager Duplicate.png"],36,36))dup.text="Dup";
            if(!setResourceButtonIconCandidates(partial,["Wearable Manager Partial Set.png"],36,36))partial.text="Partial";
            if(!setResourceButtonIconCandidates(removeSet,["Wearable Manager Take Off Set.png"],36,36))removeSet.text="Off";
            setResourceButtonIcon(del,"Wearable Manager Clothing Deletion.png",36,36);

            cards.push({set:st,group:group,right:right,apply:apply,partial:partial,removeSet:removeSet,edit:edit,dup:dup,del:del,worn:worn,items:items,scope:scope,title:title,
                partiallyVerifiedRow:partiallyVerifiedRow,
                propertyRow:propertyRow,propertyLabel:propertyLabel,restoreProperties:restoreProperties,
                materialDetails:materialDetails,restoreHands:restoreHands,diagnosis:null});
            connect(apply,"clicked()",function(){applyCard(st);});
            connect(removeSet,"clicked()",function(){takeOffCardSet(st);});
            connect(partial,"clicked()",function(){
                var fig=currentFigure();if(!fig||busy||action)return;
                var selected=partialSetDialog(st,fig);if(!selected)return;
                try{persistControls();}catch(e){MessageBox.warning(userErrorText(e),TITLE,"&OK");return;}
                action={type:"partial_apply",id:st.id,partial:selected,figureKey:key(fig)};dlg.close();
            });
            connect(edit,"clicked()",function(){leave("edit",st.id);});
            connect(dup,"clicked()",function(){leave("duplicate",st.id);});connect(del,"clicked()",function(){leave("delete",st.id);});
            connect(restoreProperties,"clicked()",function(){restoreCardProperties(st);});
            connect(materialDetails,"clicked()",function(){showCardMaterialDetails(st);});
            connect(restoreHands,"clicked()",function(){restoreCardHandPoses(st);});
        })(app.db.sets[sets[i]]);
        if(!sets.length)label(content,"No compatible outfit sets. Choose a figure or click New Set...");
        connect(search,"textChanged(const QString&)",function(){if(!busy)renderCards(false);});
        connect(groupFilter,"activated(int)",function(){if(!busy){app.groupFilterID=selectedGroupFilter();renderCards(false);}});
        connect(settings,"clicked()",function(){leave("settings");});
        connect(close,"clicked()",function(){if(!busy)dlg.close();});
        connect(create,"clicked()",function(){leave("create");});connect(registered,"clicked()",function(){leave("registered");});
        connect(editFigureIcon,"clicked()",function(){
            var fig=currentFigure();if(!fig||busy||isStandardFigureLabel(fig))return;
            var result=figureIconDialog(fig);
            if(result&&(result.type==="render_figure_icon"||result.type==="create_figure_icon_camera")){action=result;dlg.close();}
            else if(result==="camera_created"){action={type:"camera_setup_exit",figureKey:key(fig)};dlg.close();}
            else if(result==="changed"){action={type:"refresh",figureKey:key(fig)};dlg.close();}
        });
        // sortSummary was just read synchronously for this same figure. No
        // scene action or event loop occurred while constructing these widgets.
        updateFigureSelection();renderCards();
        flattenGroupBox(box);box.insideMargin=4;box.insideSpacing=4;box.setFixedHeight(968);mainLayout.addWidget(box);dlg.setFixedSize(1020,968);
        try{dlg.exec();try{persistControls();}catch(pe){MessageBox.warning("Preferences were not saved: "+userErrorText(pe),TITLE,"&OK");}}
        finally{dlg.deleteLater();releasePropertyHelper();}
        return action;
    }
    function referenceRestoreFigures() {
        var nodes=sceneNodes(), bindings={}, result=[], i;
        for(i=0;i<nodes.length;i++){
            var n=nodes[i],d=n.findDataItem("MatewWearables"),s=d?d.getSettings():null;
            var id=s?s.getStringValue("ID",""):"";if(!id)continue;
            var token="$"+id,b=bindings[token]||(bindings[token]={figures:[],groups:[]});
            if(isFigure(n))b.figures.push(n);
            else if(n.inherits("DzGroupNode"))b.groups.push(n);
        }
        var ids=Object.keys(bindings);
        for(i=0;i<ids.length;i++){
            var pair=bindings[ids[i]];if(pair.figures.length!==1||pair.groups.length!==1)continue;
            var group=pair.groups[0],children=group.getNodeChildren(false),hasItems=false;
            for(var j=0;j<children.length;j++){
                var child=children[j],data=child.findDataItem("MatewWearables"),settings=data?data.getSettings():null;
                var proxy=child.inherits("DzGroupNode")&&
                    ((settings&&settings.getStringValue("WM2Role","")==="BoneProxy")||String(child.name).indexOf(String(group.name)+"_")===0);
                if(!child.inherits("DzBone")&&(!proxy||child.getNodeChildren(false).length)){hasItems=true;break;}
            }
            if(hasItems)result.push(pair.figures[0]);
        }
        return result;
    }
    function offerReferenceRestore() {
        var figures=referenceRestoreFigures();if(!figures.length)return;
        var labels=[];for(var i=0;i<figures.length;i++)labels.push(String(figures[i].getLabel()));
        if(MessageBox.warning("Some items were moved to Wearable Manager storage for:\n\n"+labels.join("\n")+
            "\n\nWe recommend returning them to their figures before working in Wardrobe. Return them now using Wearable Manager Put On?"+
            "\n\nYou can continue without returning them. Items in WM storage will remain outside Wardrobe.",
            TITLE,"&Return Items","&Continue Anyway")!==0)return;
        var script=null,held=false,busy=g_matewWardrobeSetsPrototypeBusy;
        try{
            script=new DzScript();
            if(!script.loadFromFile(scriptDirectory()+"/Wearable Manager Put On.dsa"))throw new Error("Cannot load Wearable Manager Put On.dsa: "+script.errorMessage());
            beginNodeSelectionHold();held=true;
            // The synchronous Put On call runs before Wardrobe opens its UI or
            // starts a transaction. Its normal WM lock and recovery checks apply.
            g_matewWardrobeSetsPrototypeBusy=false;
            for(i=0;i<figures.length;i++){
                var current=live(key(figures[i]));if(!current)continue;
                Scene.selectAllNodes(false);Scene.setPrimarySelection(current);
                if(!script.execute())throw new Error("Wearable Manager Put On failed: "+script.errorMessage());
                invalidateReadScope();
            }
            g_matewWardrobeSetsPrototypeBusy=busy;
            if(referenceRestoreFigures().length)MessageBox.warning("Some items remain in Wearable Manager storage. You can continue in Wardrobe; use Put On to review their recovery when ready.",TITLE,"&Continue");
        }catch(e){MessageBox.warning("Items could not all be returned: "+userErrorText(e)+"\n\nWardrobe will continue. Items in WM storage remain excluded.",TITLE,"&Continue");}
        finally{
            g_matewWardrobeSetsPrototypeBusy=busy;
            try{if(held)restoreNodeSelectionHold();}
            finally{if(script)script.deleteLater();invalidateReadScope();}
        }
    }
    function main() {
        refreshWM2Figures();
        try{offerReferenceRestore();}
        catch(restoreCheckError){MessageBox.warning("Could not check Wearable Manager storage: "+userErrorText(restoreCheckError)+"\n\nWardrobe will continue.",TITLE,"&Continue");}
        var pref=loadPreferences(),initialCatalogReady=false;applyUISettings(pref.uiSettings);
        if(pref.libraryPath){
            app.libraryPath=pref.libraryPath;
            try{app.libraryPath=canonicalDirectory(pref.libraryPath,false);app.db=readCatalog();initialCatalogReady=true;}
            catch(e){MessageBox.warning(userErrorText(e),TITLE,"&OK");if(!settingsDialog(false,null))return;}
        }else if(!settingsDialog(true,null))return;
        while(true){
            try{
                // WM2 settings may have been edited in another DAZ session.
                refreshWM2Figures();
                // The first validated catalog has not crossed an event/dialog
                // boundary. Reopen/action paths still reread the shared library.
                if(!initialCatalogReady)app.db=readCatalog();
                initialCatalogReady=false;
                // Refresh explicit icon bindings from the shared library on
                // every dialog reopen, including after changing library paths.
                mergeSharedFigureIconBindings();
            }catch(e1){MessageBox.warning(userErrorText(e1),TITLE,"&OK");if(!settingsDialog(false,null))break;continue;}
            var a=mainDialog();if(!a||a.type==="abort"||a.type==="camera_setup_exit"||app.abortRequested)break;app.lastFigureKey=a.figureKey;
            if(a.type==="refresh")continue;
            if(a.type!=="apply" && a.type!=="report")dropChannelSession("non_apply_dialog");
            try{
                if(a.type==="create_figure_icon_camera"){
                    var cameraFigure=live(a.figureKey);
                    if(!cameraFigure)throw problem("FIGURE_ICON_CAMERA","The selected figure is no longer available.");
                    createFigureIconCamera(cameraFigure,a.scope);
                    MessageBox.information("A 128 x 211 icon camera was created for "+figureDisplayLabel(cameraFigure)+". Adjust its view in the viewport, then launch Wardrobe and open Figure Icon again to render. The binding choice is remembered on the camera.",TITLE+" - Figure Icon Camera","&OK");
                    break;
                }
                if(a.type==="render_figure_icon"){
                    var renderFigure=live(a.figureKey),renderCamera=live(a.cameraKey);
                    if(!renderFigure||!renderCamera||!same(findFigureIconCamera(renderFigure),renderCamera))throw problem("FIGURE_ICON_CAMERA","The figure or its icon camera is no longer available.");
                    renderFigureIconFromCamera(renderFigure,renderCamera,a.scope);continue;
                }
                if(a.type==="settings"){settingsDialog(false,live(a.figureKey));continue;}
                if(a.type==="report"){showReport(app.lastReport);continue;}
                if(a.type==="registered"){
                    app.db=readCatalog();registeredItemsDialog(live(a.figureKey));continue;
                }else if(a.type==="create"||a.type==="edit"||a.type==="resolve_composite"){
                    var visibleCommit=app.db.commitID,latest=readCatalog();app.db=latest;
                    if(a.type==="edit"&&visibleCommit!==latest.commitID){
                        MessageBox.warning("The wardrobe library changed while the main window was open (for example, in another DAZ Studio session). The list has been refreshed. Open Edit again so you edit the latest revision.",TITLE,"&OK");continue;
                    }
                    // Registered item definitions are immutable. When a new
                    // untagged child is parented under a saved item, offer an
                    // explicit NEW variant instead of crashing before reports
                    // or silently attaching it to the old wearable preset.
                    var composite=compositeAdditionOnFigure(live(a.figureKey));
                    if(composite){
                        var hasOverrides=composite.activeOverrideCount>0;
                        var consent=MessageBox.warning(
                            composite.originalName+" has changed.\n\n"+
                            (hasOverrides?
                                "Click Reset and Create Variant to reset its old Overrides and register the new combination.":
                                "Click Create Variant to register the new combination.")+
                            "\nExisting Sets stay unchanged.",
                            TITLE+" - New Composite Variant",
                            hasOverrides?"&Reset and Create Variant":"&Create Variant","&Cancel");
                        if(consent===0){
                            composite.resetOverrides=hasOverrides;
                            var variantReport=runAction("fork_composite",a.figureKey,composite);
                            presentActionReport(variantReport);
                        }
                        continue;
                    }
                    if(a.type==="resolve_composite"){
                        MessageBox.information("The registered wearable hierarchy is no longer changed. Reopen the Set you want to apply.",TITLE,"&OK");
                        continue;
                    }
                    var spec=editorDialog(a.type==="edit"?a.id:"",live(a.figureKey));if(!spec)continue;
                    if(spec.__rebindRequest){var rr=spec.__rebindRequest;presentActionReport(runAction("rebind_set",rr.figureKey,rr));app.lastFigureKey=rr.figureKey;continue;}
                    if(spec.__cameraSetupExit)break;
                    var saved=runAction("save",a.figureKey,spec);
                    // A newly created/moved Set must not appear to vanish behind
                    // the group filter that was active before opening its editor.
                    if(saved.ok && app.groupFilterID!=="__all__" &&
                        (spec.groupID==="__new_group__" ||
                            (spec.groupID||"__default__")!==app.groupFilterID))
                        app.groupFilterID="__all__";
                    presentActionReport(saved);
                    if(spec.__cameraSaveAfter&&saved.ok){
                        createSetIconCamera(live(a.figureKey));
                        MessageBox.information("The Set and Group were saved. A 100 x 128 icon camera was created. Adjust it in the viewport and reopen the Set Editor to render the icon.",TITLE,"&OK");
                        break;
                    }
                }else if(a.type==="duplicate"){
                    // Always recheck the catalog before creating a new set.
                    var visibleCommit=app.db.commitID,latest=readCatalog();app.db=latest;
                    if(visibleCommit!==latest.commitID){
                        MessageBox.warning("The wardrobe library changed. The list has been refreshed; select Duplicate again.",TITLE,"&OK");continue;
                    }
                    var copyResult=runAction("duplicate",a.figureKey,{id:a.id});
                    presentActionReport(copyResult);
                    if(!copyResult.ok||!copyResult.duplicateSetID||app.abortRequested)continue;
                    app.db=readCatalog();
                    var copySpec=editorDialog(copyResult.duplicateSetID,live(a.figureKey));
                    if(!copySpec)continue; // The new copy remains saved if Cancel was pressed.
                    if(copySpec.__rebindRequest){var cr=copySpec.__rebindRequest;presentActionReport(runAction("rebind_set",cr.figureKey,cr));app.lastFigureKey=cr.figureKey;continue;}
                    if(copySpec.__cameraSetupExit)break;
                    var copySaved=runAction("save",a.figureKey,copySpec);
                    presentActionReport(copySaved);
                    if(copySpec.__cameraSaveAfter&&copySaved.ok){
                        createSetIconCamera(live(a.figureKey));
                        MessageBox.information("Set changes saved. Icon camera created; reopen the Set Editor after adjusting the camera.",TITLE,"&OK");
                        break;
                    }
                }else if(a.type==="partial_apply"){
                    presentActionReport(runAction("partial_apply",a.figureKey,{id:a.id,partial:a.partial}));
                }else if(a.type==="restore_materials"){
                    // Preserve the selected IDs and commit across dialog close.
                    presentActionReport(runAction("restore_materials",a.figureKey,
                        {id:a.id,itemIDs:a.itemIDs,commitID:a.commitID}));
                }else if(a.type==="delete"){
                    var st=app.db.sets[a.id];if(!st)continue;
                    if(MessageBox.warning("Delete set '"+st.name+"'? Only its library definition is removed. Scene clothes, shared item files and old catalog revisions remain.",TITLE,"&Delete Set","&Cancel")!==0)continue;
                    presentActionReport(runAction("delete",a.figureKey,{id:a.id}));
                }else presentActionReport(runAction(a.type,a.figureKey,{id:a.id,selection:a.selection}));
            }catch(e2){if(!compositeDialogError(e2))MessageBox.critical(userErrorText(e2),TITLE,"&OK");}
        }
    }
    // TEST_ENTRY_POINT: the mock harness evaluates functions without the native UI.
    if (typeof g_matewWearablesStatus !== "undefined" && g_matewWearablesStatus > 0) {
        MessageBox.warning("Wearable Manager is open or working. Close it before opening Wardrobe.", TITLE, "&OK"); return;
    }
    if (typeof g_matewWardrobeSetsPrototypeBusy !== "undefined" && g_matewWardrobeSetsPrototypeBusy) {
        MessageBox.warning("Another Wardrobe Sets dialog/operation is open. Close it first.", TITLE, "&OK"); return;
    }
    g_matewWardrobeSetsPrototypeBusy = true;
    try { main(); }
    catch (fatal) { print(TITLE + ": " + errorText(fatal)); MessageBox.critical(errorText(fatal), TITLE, "&OK"); }
    finally {
        try { if(viewportLocksOwned) releaseWardrobeViewportLocks("script_finally"); }
        finally { try { closeChannelSession(); releaseBulkBindings(); releasePropertyHelper(); } finally { readScope=null;g_matewWardrobeSetsPrototypeBusy=false; } }
    }

})();
