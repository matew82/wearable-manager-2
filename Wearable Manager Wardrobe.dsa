        var ir=new DzHGroupBox(setIconColumn);flattenGroupBox(ir);
        ir.insideMargin=0;ir.insideSpacing=8;ir.setFixedSize(418,205);
        var iconLeftInset=new DzLabel(ir);iconLeftInset.setFixedWidth(10);
        var previewColumn=new DzVGroupBox(ir);flattenGroupBox(previewColumn);
        previewColumn.insideMargin=0;previewColumn.insideSpacing=5;previewColumn.setFixedSize(108,202);
        var preview=new DzLabel(previewColumn);preview.setFixedSize(100,128);preview.alignment=0x84;
        var iconInfo=label(previewColumn,"");iconInfo.setFixedSize(106,62);
        iconInfo.wordWrap=true;iconInfo.alignment=0x24;
        iconInfo.toolTip="Full icon description";

        var ic=new DzVGroupBox(ir),standard=new DzPushButton(ic),browse=new DzPushButton(ic),renderIcon=new DzPushButton(ic),useDefault=new DzPushButton(ic),restore=new DzPushButton(ic);
        flattenGroupBox(ic);ic.insideMargin=0;ic.insideSpacing=5;ic.setFixedSize(270,194);
        standard.text="Standard Icons...";
        browse.text="Choose Image...";
        renderIcon.text=findSetIconCamera(fig)?"Render from Set Icon Camera":"Create Set Icon Camera";
        useDefault.text="Use Default";
        restore.text="Restore Saved Icon";
        var setIconControls=[standard,browse,renderIcon,useDefault,restore];
        for(var ci=0;ci<setIconControls.length;ci++){
            var control=setIconControls[ci];
            control.setFixedSize(250,32);control.autoDefault=false;control.sizedFromIcon=true;
        }

        var propertyButtonRow=new DzHGroupBox(setPropertyColumn),propertyIndent=label(propertyButtonRow,""),propertyButton=new DzPushButton(propertyButtonRow);
        flattenGroupBox(propertyButtonRow);propertyButtonRow.insideMargin=0;propertyButtonRow.insideSpacing=0;
        propertyButtonRow.setFixedHeight(32);
        propertyIndent.setFixedWidth(130);
        propertyButton.text="Properties...";propertyButton.setFixedSize(250,32);propertyButton.autoDefault=false;
        setSourcePickerTextIcon(propertyButton,"Wearable Manager Generate32.png",250,32);
        propertyButton.toolTip="Choose numeric or Boolean Apply/Reset overrides for the figure, an item, or a registered child Part. Per-Set part visibility is captured automatically when you Save Set.";
        setPropertyColumn.insideSpacing=0;
        var handTopGap=label(setPropertyColumn,"");handTopGap.setFixedHeight(5);
        var handRow=new DzWidget(setPropertyColumn),handLayout=new DzHBoxLayout(handRow);
        handLayout.margin=0;handLayout.spacing=10;handRow.setFixedHeight(32);
        var rightHand=new DzPushButton(handRow),leftHand=new DzPushButton(handRow);
        handLayout.addStretch(1);handLayout.addWidget(rightHand);handLayout.addWidget(leftHand);handLayout.addStretch(1);
        var handPoseRecapture={right:false,left:false};
        function handToggle(button,caption,selected,side){
            button.text=caption;button.checkable=true;button.checked=selected;button.autoDefault=false;button.setFixedSize(170,32);
            button.toolTip="Selected: include this hand pose. Existing saved poses are kept when editing the set. To replace a saved pose with the current hand, finger bones and Pose Controls, switch this button off and on, then Save Set. The previous session pose returns when its outfit is removed.";
            wardrobeTransitionStyle(button,selected,true);
            connect(button,"clicked()",function(){handPoseRecapture[side]=!!button.checked;wardrobeTransitionStyle(button,!!button.checked,true);});
        }
        handToggle(rightHand,"Right Hand Pose",!!(old&&old.handPoses&&old.handPoses.right),"right");
        handToggle(leftHand,"Left Hand Pose",!!(old&&old.handPoses&&old.handPoses.left),"left");
        var handBottomGap=label(setPropertyColumn,"");handBottomGap.setFixedHeight(10);
        var propertySummary=label(setPropertyColumn,"");propertySummary.minWidth=485;
        propertySummary.wordWrap=true;propertySummary.alignment=0x24;
        function refreshPropertySummary(){
            var names=[];
            for(var pi=0;pi<propertyOverrides.length;pi++){
                var p=propertyOverrides[pi],propertyName=trim(String(p.propertyLabel||p.propertyName||""));
                if(propertyName&&names.indexOf(propertyName)<0)names.push(propertyName);
            }
            propertySummary.text=names.length?names.map(function(n){return "- "+n;}).join("\n"):"No Properties";
            propertySummary.toolTip=names.join(", ");
            // Keep layout stable; the complete list remains in the tooltip if
