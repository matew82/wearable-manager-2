        var old = channelSession.registry || {}, reuse = {}, stale = {}, ids = Object.keys(old);
        // A list/tree signal may have invalidated one node between actions.
        // Reconnect/re-certify that node rather than keeping a disabled record.
        for (var i = 0; i < ids.length; i++) {
            var rec = old[ids[i]];
