        if (old) return old;
        var rec = {key:nk,nodeClass:String(n.className()),bindings:null,serial:0,
            connected:[],enabled:true,alive:true,reason:""};
        ctx.bulkBindings[nk] = rec;
        if (BULK_NATIVE_CLASSES.indexOf(rec.nodeClass) < 0 || typeof n.getPropertyList !== "function") {
            rec.enabled = false; rec.reason = "unsupported_native_class_or_property_list"; return rec;
        }
        var signals = ["propertyListChanged()", "propertyTreeChanged()", "removed()"];
        rec.invalidate = function () {
