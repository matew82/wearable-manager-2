            controlRequests:0, controlResolutionMs:0, evaluatedMs:0, rawMs:0,
            controllerCountMs:0, lockedMs:0, formatMs:0, rawUnavailable:0,
            controllerCountUnavailable:0, lockedUnavailable:0, complete:false};
