    }
    function standardControlPointers(n) {
        // Independent audit. No getValue/getRawValue, setters, or bound methods.
        return [n.getXPosControl(),n.getYPosControl(),n.getZPosControl(),
            n.getXRotControl(),n.getYRotControl(),n.getZRotControl(),
            n.getScaleControl(),n.getXScaleControl(),n.getYScaleControl(),n.getZScaleControl()];
    }

    function auditBulkBindings(keys, code) {
        if (!bulkChannelsEnabled() || !ctx.bulkBindings) return;
        if (operationalVerification() && ordinaryApplyWindow(code)) {
            bulkStat("operationalAuditWindowsSkipped");
            log("INFO", "CHANNEL_READER_AUDIT_" + code,
                "Not run in Operational profile: initial native certification and fresh owner/name/type/value reads remain active. Full diagnostic profile retains the repeated dual-reader audit.");
            return;
        }
        var token = profileBegin("channel_binding_audit"), count = 0, map = sceneIndex();
        try {
            for (var i = 0; i < keys.length; i++) {
                var rec = ctx.bulkBindings[keys[i]];
                if (!rec || !rec.enabled || !rec.bindings) continue;
                var n = map[keys[i]], fresh = null, nativeControls = null;
                if (!n) throw problem("CHANNEL_AUDIT_NODE_MISSING", keys[i]);
                try {
