        } else bulkStat("issueDetailsTruncated");
    }
    function channelActualUsage() {
        if (!ctx) return "no_action";
        if (ctx.fastNoop) return "not_requested_structural_noop";
        if (!ctx.optimizeReads) return "reference_double_resolution";
        if (!ctx.bulkChannels) return "direct_single_resolution";
        var s=ctx.bulkStats||{};
        if (s.bulkSnapshots) return s.fallbackSnapshots ? "bulk_with_direct_fallbacks" : "bulk_after_native_certification";
        return s.certifications ? "certified_but_no_bulk_snapshot" : "direct_only_bulk_not_certified";
