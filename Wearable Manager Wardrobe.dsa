        if(out.Schema&&out.Schema!=="1")throw problem("DATA_VERSION","Unsupported Wardrobe scene metadata.");
        return out;
    }
    function readDataNative(n) {
        var undoState=undoMetadataProperty(n);if(undoState){profileCount("metadataNativeReads",1);return readUndoMetadata(undoState);}
        if (!optimizedReads()) return readDataNativeReference(n);
