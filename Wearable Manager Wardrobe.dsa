        } catch (e) { return {available: false, reason: String(e)}; }
    }

    function storageOptional(p, method) {
        if (typeof p[method] !== "function") return {ok: false, reason: method + " unavailable"};
        try { return {ok: true, value: p[method]()}; }
        catch (e) { return {ok: false, reason: String(e)}; }
    }

    function storageChannels(n) {
        var token = profileBegin("channels");
        try { return storageChannelsImpl(n); }
        finally { profileEnd(token); }
    }
    function storageChannelsImpl(n) {
        return optimizedReads() ? storageChannelsDirect(n) : storageChannelsReference(n);
    }

    function storageChannelsReference(n) {
        var values = transformValuesReference(n), result = [];
        for (var i = 0; i < values.length; i++) {
            var v = values[i], p = n[v.method](), raw = storageOptional(p, "getRawValue");
            var controllers = storageOptional(p, "getNumControllers"), locked = storageOptional(p, "isLocked");
            if (!isFinite(v.value)) throw new Error("Non-finite transform: " + n.getLabel() + " / " + v.method);
            var rawOK = raw.ok && typeof raw.value === "number" && isFinite(raw.value);
            result.push({method: v.method, propertyName: String(p.name), value: v.value,
                rawAvailable: rawOK, raw: rawOK ? Number(raw.value) : null,
                rawIssue: rawOK ? "" : (raw.reason || "Raw value is not a finite number"),
                controllers: controllers.ok ? Number(controllers.value) : null,
                locked: locked.ok ? Boolean(locked.value) : null});
        }
        return result;
    }

    // v0.3.5: each standard control is resolved ONCE per synchronous node
    // snapshot, then used for its evaluated/raw/controller/lock reads. These
    // local handles are discarded before returning. No handle/value survives
    // an event-loop boundary or the next node snapshot; no getters are bound
    // to a different QObject. The reference reader remains available unchanged.
    // Static native calls reduce repeated computed-member dispatch; their real
    // performance must be measured in DAZ, not inferred from a Node.js mock.
    // v0.3.6: native accessors certify a method -> property-name binding per node.
