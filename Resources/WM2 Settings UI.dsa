    var scale = Math.max(1, Math.min(1.75, isFinite(base) ? base / 10 : 1));
    return { margin:Math.ceil(10*scale), spacing:Math.ceil(8*scale), fieldHeight:Math.ceil(28*scale), buttonHeight:Math.ceil(30*scale), iconSize:18, listHeight:Math.ceil(120*scale), previewHeight:Math.ceil(90*scale) };
}
function WM2SettingsCSS(widget, css) {
    try {
        var native = widget.getWidget();
        if (typeof native.setStyleSheet == "function") native.setStyleSheet(css);
        else native.styleSheet = css;
        return true;
    } catch (e) { return false; }
}
function WM2SettingsSetPlainText(label, text) {
    if (typeof DzLabel.PlainText != "undefined") { label.textFormat = DzLabel.PlainText; label.text = String(text); }
    else label.text = String(text).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
}
function WM2SettingsSetVisible(widget, visible) { if(visible)widget.show();else widget.hide(); }
function WM2SettingsPlainLabel(parent, text) {
    var label = new DzLabel(parent);
    label.wordWrap = true;WM2SettingsSetPlainText(label,text);
    return label;
}
function WM2SettingsHeading(parent, text, color) {
    var label = WM2SettingsPlainLabel(parent, text);
