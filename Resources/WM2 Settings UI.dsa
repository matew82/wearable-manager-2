    for(var i=0;i<kinds.length;i++) {
        var filename="Wearables Manager - Match "+names[i]+".png",onFilename="Wearables Manager - Match "+names[i]+" On.png";
        var button=WM2SettingsButton(row.widget,fallback[i],resourcePath,filename,false,32);
        button.wm2ModeNormalFilename=filename;button.wm2ModeOnFilename=onFilename;button.wm2ModeFallback=fallback[i];
