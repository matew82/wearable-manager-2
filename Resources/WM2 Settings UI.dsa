// Shared settings UI proposal. ES5; loading this file does not construct widgets,
// read/write preferences, or touch the scene. Root owns product integration.
// Requires the central WM2Support object before calling either public dialog.

function WM2SettingsFont(widget, heading) {
    var font;
    try { font = new Font(widget.font); } catch (e) { font = new Font(); }
    var base = Number(font.pointSize);
    if (!isFinite(base) || base <= 0) base = 10;
    font.pointSize = heading ? Math.max(16, base * 1.45) : base;
    font.bold = !!heading;
    if (heading) {
        var families = [], candidates = ["Georgia", "Segoe UI", "Arial", "DejaVu Sans", "Liberation Sans"];
        try { if (typeof font.families == "function") families = font.families(); } catch (e) {}
        var chosen = "Sans Serif";
        for (var i = 0; i < candidates.length; i++) {
            for (var j = 0; j < families.length; j++) {
                if (String(families[j]).toLowerCase() === candidates[i].toLowerCase()) { chosen = String(families[j]); break; }
            }
            if (chosen !== "Sans Serif") break;
        }
        font.family = chosen;
    }
    return font;
}
function WM2SettingsMetrics(widget) {
    var font = WM2SettingsFont(widget, false), base = Number(font.pointSize);
    var scale = Math.max(1, Math.min(1.75, isFinite(base) ? base / 10 : 1));
    return { margin:Math.ceil(10*scale), spacing:Math.ceil(8*scale), fieldHeight:Math.ceil(28*scale), buttonHeight:Math.ceil(30*scale), iconSize:18, listHeight:Math.ceil(120*scale), previewHeight:Math.ceil(90*scale) };
}
function WM2SettingsCSS(widget, css) {
    try {
        var native = widget.getWidget();
        if (typeof native.setStyleSheet == "function") native.setStyleSheet(css);
        else native.styleSheet = css;
        return true;
    } catch (e) { return false; }
}
function WM2SettingsPlainLabel(parent, text) {
    var label = new DzLabel(parent);
    label.wordWrap = true;
    if (typeof DzLabel.PlainText != "undefined") { label.textFormat = DzLabel.PlainText; label.text = String(text); }
    else label.text = String(text).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
    return label;
}
function WM2SettingsHeading(parent, text, color) {
    var label = WM2SettingsPlainLabel(parent, text);
    label.font = WM2SettingsFont(label, true);
    label.alignment = DzLabel.AlignHCenter;
    var safeColor = /^#[0-9a-f]{6}$/i.test(String(color)) ? String(color) : "#87c9ff";
    WM2SettingsCSS(label, "QLabel { color:" + safeColor + "; }");
    return label;
}
function WM2SettingsButton(parent, text, resourcePath, iconFilename, rotateClockwise) {
    var button = new DzPushButton(parent), metrics = WM2SettingsMetrics(button);
    button.text = String(text); button.font = WM2SettingsFont(button, false); button.minHeight = metrics.buttonHeight;
    var textWidth = String(text).length * 7;
    try { if (typeof button.font.size == "function") textWidth = Number(button.font.size(String(text)).width); } catch (e) {}
    if (!isFinite(textWidth)) textWidth = String(text).length * 7;
    button.minWidth = Math.max(80, Math.ceil(textWidth) + metrics.iconSize + 30);
    var loaded = false, image = null, scaledImage = null, rotatedImage = null;
    try {
        if (typeof resourcePath == "string" && resourcePath && typeof iconFilename == "string" && /^[^\\/:\x00-\x1f]+\.png$/i.test(iconFilename)) {
            var pixmap = new Pixmap(resourcePath.replace(/[\\/]+$/, "") + "/" + iconFilename);
            if (pixmap && !pixmap.isNull()) {
                // Scale the native pixmap for DAZ4; Qt6 also needs an explicit iconSize.
                image = pixmap.toImage();
                var width = Number(pixmap.width), height = Number(pixmap.height), factor = metrics.iconSize / Math.max(width, height);
                if (width > 0 && height > 0 && typeof image.smoothScale == "function") {
                    var scaled = new Pixmap();
                    scaledImage=image.smoothScale(Math.max(1,Math.round(width*factor)),Math.max(1,Math.round(height*factor)));
                    scaled.fromImage(scaledImage);
                    if (!scaled.isNull()) pixmap = scaled;
                }
                if(rotateClockwise) {
                    var pixels=scaledImage || image,w=Number(pixels.width),h=Number(pixels.height);
                    if(w<=0 || h<=0 || w>metrics.iconSize || h>metrics.iconSize || typeof pixels.pixel!=="function" || typeof Image==="undefined" || typeof Image.Format_ARGB32==="undefined")throw new Error("Arrow rotation is unavailable.");
                    rotatedImage=new Image(h,w,Image.Format_ARGB32);
                    for(var y=0;y<h;y++)for(var x=0;x<w;x++)rotatedImage.setPixel(h-1-y,x,pixels.pixel(x,y));
                    var vertical=new Pixmap();vertical.fromImage(rotatedImage);if(vertical.isNull())throw new Error("Arrow rotation failed.");pixmap=vertical;
                }
                button.pixmap = pixmap; loaded = true;
                try { button.getWidget().iconSize = new Size(metrics.iconSize,metrics.iconSize); } catch (e) {}
            }
        }
    } catch (e) { loaded = false; }
    finally { try { if(rotatedImage && typeof rotatedImage.deleteLater==="function")rotatedImage.deleteLater(); }catch(e){} try { if (scaledImage && typeof scaledImage.deleteLater == "function") scaledImage.deleteLater(); } catch (e) {} try { if (image && typeof image.deleteLater == "function") image.deleteLater(); } catch (e) {} }
    // Keep the icon slot in the text fallback as well as the button's minimum width.
    WM2SettingsCSS(button, "QPushButton { padding:5px 8px;" + (loaded ? "" : " padding-left:32px;") + " }");
    return button;
}
function WM2SettingsDialog(title, resourcePath) {
    var dialog = new DzBasicDialog();
    dialog.caption = String(title); dialog.sizeGripEnabled = true;
    dialog.showHelpButton(false); dialog.showApplyButton(false);
    dialog.setAcceptButtonText("Save"); dialog.setCancelButtonText("Cancel");
    // Documented custom button slots provide existing PNGs without searching for
    // undocumented names of the built-in buttons.
    dialog.showAcceptButton(false); dialog.showCancelButton(false);
    var saveButton=WM2SettingsButton(dialog,"Save",resourcePath,"Wearables Manager - Save.png"),cancelButton=WM2SettingsButton(dialog,"Cancel",resourcePath,"Wearables Manager - Cancel.png");
    dialog.addButton(saveButton,1);dialog.addButton(cancelButton,2);
    dialog.setAcceptButton(saveButton);dialog.setRejectButton(cancelButton);
    if(typeof dialog.setDefaultButton=="function")dialog.setDefaultButton(saveButton);
    var metrics = WM2SettingsMetrics(dialog);
    dialog.minWidth = 440; dialog.minHeight = 280;
    // No fixed sizes, physical-DPI multiplier, or screen-height assumption.
    var content = new DzWidget(dialog), layout = new DzVBoxLayout(content);
    layout.margin = metrics.margin; layout.spacing = metrics.spacing;
    dialog.addWidget(content, 1);
    return {dialog:dialog,content:content,layout:layout,metrics:metrics,saveButton:saveButton,cancelButton:cancelButton};
}
function WM2SettingsRow(parent, layout) {
    var row = new DzWidget(parent), rowLayout = new DzHBoxLayout(row);
    rowLayout.margin = 0; rowLayout.spacing = WM2SettingsMetrics(row).spacing;
    layout.addWidget(row); return {widget:row,layout:rowLayout};
}
function WM2SettingsIcons(resourcePath) {
    var directory = new DzDir(resourcePath), entries = [], result = [];
    try { entries = directory.entryList(["*.png","*.PNG"], DzDir.Files, DzDir.Name); }
    finally { directory.deleteLater(); }
    for (var i=0;i<entries.length;i++) {
        var name=String(entries[i]);
        if (/^[^\\/:\x00-\x1f]+\.png$/i.test(name) && result.indexOf(name)<0) result.push(name);
    }
    return result;
}
function WM2SettingsValidate(support, config) {
    var result = support.validate(config);
    return result && result.ok === true ? {ok:true,config:result.config || config} : {ok:false,message:result && result.message ? String(result.message) : "Settings did not pass validation."};
}
function WM2SettingsIsLegacyKind(kind) { return kind == "namePrefix" || kind == "labelPrefix"; }
function WM2SettingsKindLabel(kind) {
    if(kind == "exactName")return "Exact name";
    if(kind == "exactLabel")return "Exact label";
    if(kind == "nameWord")return "Word in name";
    if(kind == "labelWord")return "Word in label";
    if(kind == "namePrefix")return "Legacy: name prefix";
    if(kind == "labelPrefix")return "Legacy: label prefix";
    return String(kind);
}
function WM2SettingsModel(support, resourcePath, firstIcon) {
    var loaded;
    try { loaded = support.load(resourcePath); }
    catch (e) { loaded={config:support.defaults(),status:"read-error",message:String(e),rawToken:null}; }
    var model={config:support.clone(loaded.config),rawToken:loaded.rawToken,status:String(loaded.status || "ok"),message:String(loaded.message || ""),active:-1,form:null,baseline:""};
    model.editable = loaded.readOnly !== true && !/unsupported|future|read-error/i.test(model.status);
    function response(ok,message) { return {ok:ok,message:String(message || "")}; }
    model.clear = function () { model.active=-1;model.form={kind:"exactName",pattern:"",icon:firstIcon || ""};model.baseline=JSON.stringify(model.form); };
    model.dirty = function () { return JSON.stringify(model.form)!==model.baseline; };
    model.setForm = function (form) { model.form={kind:String(form.kind),pattern:String(form.pattern),icon:String(form.icon)}; };
    model.commit = function (asNew) {
        if (!model.editable) return response(false,"These settings are read-only: "+model.message);
        if (WM2SettingsIsLegacyKind(model.form.kind) || (!asNew && model.active>=0 && WM2SettingsIsLegacyKind(model.config.iconRules[model.active].kind))) return response(false,"Legacy prefix rules are preserved read-only. Use Clear Draft to create an exact or word rule.");
        var next=support.clone(model.config),index=!asNew&&model.active>=0?model.active:next.iconRules.length;
        if (!model.form.pattern) return response(false,"Enter a rule pattern before adding or updating it.");
        if (!model.form.icon) return response(false,"Choose an icon before adding or updating the rule.");
        var old=index<next.iconRules.length?next.iconRules[index]:null;
        var unchangedKey=old && old.kind===model.form.kind && old.pattern.toLowerCase()===model.form.pattern.toLowerCase();
        if(!unchangedKey)for(var existing=0;existing<next.iconRules.length;existing++){
            var other=next.iconRules[existing];
            if(existing!==index && other.kind===model.form.kind && other.pattern.toLowerCase()===model.form.pattern.toLowerCase())return response(false,"A rule of this kind and pattern already exists (ignoring case). Update that row instead.");
        }
