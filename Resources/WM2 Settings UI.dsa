}
function WM2SettingsRenderMenuPreview(scroll,result) {
    var body=new DzWidget(scroll),layout=new DzVBoxLayout(body),metrics=WM2SettingsMetrics(body);
    layout.margin=metrics.margin;layout.spacing=metrics.spacing;
    if(result.title)layout.addWidget(WM2SettingsPlainLabel(body,result.title));
    if(result.message)layout.addWidget(WM2SettingsPlainLabel(body,result.message));
    var sourceRows=result.rows||[],rows=[],stored=[],section="";
    for(var r=0;r<sourceRows.length;r++)(sourceRows[r].isInGroup?stored:rows).push(sourceRows[r]);
    rows=rows.concat(stored);
    for(var i=0;i<rows.length;i++){
        var item=rows[i],next=item.isInGroup?"Stored":"On figure";
        if(result.title!=="Selected item"&&next!==section){layout.addWidget(WM2SettingsPlainLabel(body,next));section=next;}
        var row=WM2SettingsRow(body,layout),image=new DzPushButton(row.widget);
        image.text="";image.buttonStyle=DzPushButton.BTool;image.sizedFromIcon=true;image.minWidth=91;image.minHeight=91;
        image.toolTip=item.usable?item.label:"Icon unavailable";
        WM2Support.setMenuPixmap(image,item.pixmap);row.layout.addWidget(image);
        var label=WM2SettingsPlainLabel(row.widget,(item.parentLabel?item.parentLabel+" > ":"")+item.label);
        label.font=WM2SettingsFont(label,false);label.font.bold=true;row.layout.addWidget(label,1);
        if(!item.usable)row.layout.addWidget(WM2SettingsPlainLabel(row.widget,"Icon unavailable"));
        row.layout.margin=Math.min(10,item.depth)*16;
        // Images deliberately have no click connection or transfer controls.
    }
    scroll.setWidget(body);scroll.wm2Preview=result;
}
function WM2SettingsPromptIconName(parent, currentName) {
    var dialog=new DzBasicDialog();dialog.caption="Choose another icon filename";
    dialog.showHelpButton(false);dialog.showApplyButton(false);dialog.setAcceptButtonText("Use Filename");dialog.setCancelButtonText("Cancel");
    var content=new DzWidget(dialog),layout=new DzVBoxLayout(content);layout.margin=10;layout.spacing=8;
    layout.addWidget(WM2SettingsPlainLabel(content,"The icon filename already exists or is invalid. Enter another PNG basename. Existing files will not be overwritten."));
    var filename=new DzLineEdit(content);filename.text=String(currentName||"");layout.addWidget(filename);dialog.addWidget(content);
    try { return dialog.exec()?String(filename.text):null; }
    finally { dialog.deleteLater(); }
}
function WM2ShowIconRules(resourcePath,getPreviewContext) {
