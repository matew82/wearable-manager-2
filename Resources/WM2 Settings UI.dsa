// Shared settings UI proposal. ES5; loading this file does not construct widgets,
// read/write preferences, or touch the scene. Root owns product integration.
// Requires the central WM2Support object before calling either public dialog.

function WM2SettingsFont(widget, heading) {
    var font;
    try { font = new Font(widget.font); } catch (e) { font = new Font(); }
    var base = Number(font.pointSize);
    if (!isFinite(base) || base <= 0) base = 10;
    font.pointSize = heading ? Math.max(16, base * 1.45) : base;
    font.bold = !!heading;
    if (heading) {
        var families = [], candidates = ["Georgia", "Segoe UI", "Arial", "DejaVu Sans", "Liberation Sans"];
        try { if (typeof font.families == "function") families = font.families(); } catch (e) {}
        var chosen = "Sans Serif";
        for (var i = 0; i < candidates.length; i++) {
            for (var j = 0; j < families.length; j++) {
                if (String(families[j]).toLowerCase() === candidates[i].toLowerCase()) { chosen = String(families[j]); break; }
            }
            if (chosen !== "Sans Serif") break;
        }
        font.family = chosen;
    }
    return font;
}
function WM2SettingsMetrics(widget) {
    var font = WM2SettingsFont(widget, false), base = Number(font.pointSize);
    var scale = Math.max(1, Math.min(1.75, isFinite(base) ? base / 10 : 1));
    return { margin:Math.ceil(10*scale), spacing:Math.ceil(8*scale), fieldHeight:Math.ceil(28*scale), buttonHeight:Math.ceil(30*scale), iconSize:18, listHeight:Math.ceil(120*scale), previewHeight:Math.ceil(90*scale) };
}
function WM2SettingsCSS(widget, css) {
    try {
        var native = widget.getWidget();
        if (typeof native.setStyleSheet == "function") native.setStyleSheet(css);
        else native.styleSheet = css;
        return true;
    } catch (e) { return false; }
}
function WM2SettingsPlainLabel(parent, text) {
    var label = new DzLabel(parent);
    label.wordWrap = true;
    if (typeof DzLabel.PlainText != "undefined") { label.textFormat = DzLabel.PlainText; label.text = String(text); }
    else label.text = String(text).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
    return label;
}
function WM2SettingsHeading(parent, text, color) {
    var label = WM2SettingsPlainLabel(parent, text);
    label.font = WM2SettingsFont(label, true);
    label.alignment = DzLabel.AlignHCenter;
    var safeColor = /^#[0-9a-f]{6}$/i.test(String(color)) ? String(color) : "#87c9ff";
    WM2SettingsCSS(label, "QLabel { color:" + safeColor + "; }");
    return label;
}
function WM2SettingsButton(parent, text, resourcePath, iconFilename, rotateClockwise) {
    var button = new DzPushButton(parent), metrics = WM2SettingsMetrics(button);
    button.text = String(text); button.font = WM2SettingsFont(button, false); button.minHeight = metrics.buttonHeight;
    var textWidth = String(text).length * 7;
    try { if (typeof button.font.size == "function") textWidth = Number(button.font.size(String(text)).width); } catch (e) {}
    if (!isFinite(textWidth)) textWidth = String(text).length * 7;
    button.minWidth = Math.max(80, Math.ceil(textWidth) + metrics.iconSize + 30);
    var loaded = false, image = null, scaledImage = null, rotatedImage = null;
    try {
        if (typeof resourcePath == "string" && resourcePath && typeof iconFilename == "string" && /^[^\\/:\x00-\x1f]+\.png$/i.test(iconFilename)) {
            var pixmap = new Pixmap(resourcePath.replace(/[\\/]+$/, "") + "/" + iconFilename);
            if (pixmap && !pixmap.isNull()) {
                // Scale the native pixmap for DAZ4; Qt6 also needs an explicit iconSize.
                image = pixmap.toImage();
                var width = Number(pixmap.width), height = Number(pixmap.height), factor = metrics.iconSize / Math.max(width, height);
                if (width > 0 && height > 0 && typeof image.smoothScale == "function") {
                    var scaled = new Pixmap();
                    scaledImage=image.smoothScale(Math.max(1,Math.round(width*factor)),Math.max(1,Math.round(height*factor)));
                    scaled.fromImage(scaledImage);
                    if (!scaled.isNull()) pixmap = scaled;
                }
                if(rotateClockwise) {
                    var pixels=scaledImage || image,w=Number(pixels.width),h=Number(pixels.height);
                    if(w<=0 || h<=0 || w>metrics.iconSize || h>metrics.iconSize || typeof pixels.pixel!=="function" || typeof Image==="undefined" || typeof Image.Format_ARGB32==="undefined")throw new Error("Arrow rotation is unavailable.");
                    rotatedImage=new Image(h,w,Image.Format_ARGB32);
                    for(var y=0;y<h;y++)for(var x=0;x<w;x++)rotatedImage.setPixel(h-1-y,x,pixels.pixel(x,y));
                    var vertical=new Pixmap();vertical.fromImage(rotatedImage);if(vertical.isNull())throw new Error("Arrow rotation failed.");pixmap=vertical;
                }
                button.pixmap = pixmap; loaded = true;
                try { button.getWidget().iconSize = new Size(metrics.iconSize,metrics.iconSize); } catch (e) {}
            }
        }
    } catch (e) { loaded = false; }
    finally { try { if(rotatedImage && typeof rotatedImage.deleteLater==="function")rotatedImage.deleteLater(); }catch(e){} try { if (scaledImage && typeof scaledImage.deleteLater == "function") scaledImage.deleteLater(); } catch (e) {} try { if (image && typeof image.deleteLater == "function") image.deleteLater(); } catch (e) {} }
    // Keep the icon slot in the text fallback as well as the button's minimum width.
    WM2SettingsCSS(button, "QPushButton { padding:5px 8px;" + (loaded ? "" : " padding-left:32px;") + " }");
    return button;
}
function WM2SettingsDialog(title, resourcePath) {
    var dialog = new DzBasicDialog();
    dialog.caption = String(title); dialog.sizeGripEnabled = true;
    dialog.showHelpButton(false); dialog.showApplyButton(false);
    dialog.setAcceptButtonText("Save"); dialog.setCancelButtonText("Cancel");
    // Documented custom button slots provide existing PNGs without searching for
    // undocumented names of the built-in buttons.
    dialog.showAcceptButton(false); dialog.showCancelButton(false);
    var saveButton=WM2SettingsButton(dialog,"Save",resourcePath,"Wearables Manager - Save.png"),cancelButton=WM2SettingsButton(dialog,"Cancel",resourcePath,"Wearables Manager - Cancel.png");
    dialog.addButton(saveButton,1);dialog.addButton(cancelButton,2);
    dialog.setAcceptButton(saveButton);dialog.setRejectButton(cancelButton);
    if(typeof dialog.setDefaultButton=="function")dialog.setDefaultButton(saveButton);
    var metrics = WM2SettingsMetrics(dialog);
    dialog.minWidth = 440; dialog.minHeight = 280;
    // No fixed sizes, physical-DPI multiplier, or screen-height assumption.
    var content = new DzWidget(dialog), layout = new DzVBoxLayout(content);
    layout.margin = metrics.margin; layout.spacing = metrics.spacing;
    dialog.addWidget(content, 1);
    return {dialog:dialog,content:content,layout:layout,metrics:metrics,saveButton:saveButton,cancelButton:cancelButton};
}
function WM2SettingsRow(parent, layout) {
    var row = new DzWidget(parent), rowLayout = new DzHBoxLayout(row);
    rowLayout.margin = 0; rowLayout.spacing = WM2SettingsMetrics(row).spacing;
    layout.addWidget(row); return {widget:row,layout:rowLayout};
}
function WM2SettingsIcons(resourcePath) {
    var directory = new DzDir(resourcePath), entries = [], result = [];
    try { entries = directory.entryList(["*.png","*.PNG"], DzDir.Files, DzDir.Name); }
    finally { directory.deleteLater(); }
    for (var i=0;i<entries.length;i++) {
        var name=String(entries[i]);
        if (/^[^\\/:\x00-\x1f]+\.png$/i.test(name) && result.indexOf(name)<0) result.push(name);
    }
    return result;
}
function WM2SettingsValidate(support, config) {
    var result = support.validate(config);
    return result && result.ok === true ? {ok:true,config:result.config || config} : {ok:false,message:result && result.message ? String(result.message) : "Settings did not pass validation."};
}
function WM2SettingsIsLegacyKind(kind) { return kind == "namePrefix" || kind == "labelPrefix"; }
function WM2SettingsKindLabel(kind) {
    if(kind == "exactName")return "Exact name";
    if(kind == "exactLabel")return "Exact label";
    if(kind == "nameWord")return "Word in name";
    if(kind == "labelWord")return "Word in label";
    if(kind == "namePrefix")return "Legacy: name prefix";
    if(kind == "labelPrefix")return "Legacy: label prefix";
    return String(kind);
}
function WM2SettingsModel(support, resourcePath, firstIcon) {
    var loaded;
    try { loaded = support.load(resourcePath); }
    catch (e) { loaded={config:support.defaults(),status:"read-error",message:String(e),rawToken:null}; }
    var model={config:support.clone(loaded.config),rawToken:loaded.rawToken,status:String(loaded.status || "ok"),message:String(loaded.message || ""),active:-1,form:null,baseline:""};
    model.editable = loaded.readOnly !== true && !/unsupported|future|read-error/i.test(model.status);
    function response(ok,message) { return {ok:ok,message:String(message || "")}; }
    model.clear = function () { model.active=-1;model.form={kind:"exactName",pattern:"",icon:firstIcon || ""};model.baseline=JSON.stringify(model.form); };
    model.dirty = function () { return JSON.stringify(model.form)!==model.baseline; };
    model.setForm = function (form) { model.form={kind:String(form.kind),pattern:String(form.pattern),icon:String(form.icon)}; };
    model.commit = function (asNew) {
        if (!model.editable) return response(false,"These settings are read-only: "+model.message);
        if (WM2SettingsIsLegacyKind(model.form.kind) || (!asNew && model.active>=0 && WM2SettingsIsLegacyKind(model.config.iconRules[model.active].kind))) return response(false,"Legacy prefix rules are preserved read-only. Use Clear Draft to create an exact or word rule.");
        var next=support.clone(model.config),index=!asNew&&model.active>=0?model.active:next.iconRules.length;
        if (!model.form.pattern) return response(false,"Enter a rule pattern before adding or updating it.");
        if (!model.form.icon) return response(false,"Choose an icon before adding or updating the rule.");
        var old=index<next.iconRules.length?next.iconRules[index]:null;
        var unchangedKey=old && old.kind===model.form.kind && old.pattern.toLowerCase()===model.form.pattern.toLowerCase();
        if(!unchangedKey)for(var existing=0;existing<next.iconRules.length;existing++){
            var other=next.iconRules[existing];
            if(existing!==index && other.kind===model.form.kind && other.pattern.toLowerCase()===model.form.pattern.toLowerCase())return response(false,"A rule of this kind and pattern already exists (ignoring case). Update that row instead.");
        }
        next.iconRules[index]=support.clone(model.form);
        var checked=WM2SettingsValidate(support,next);if(!checked.ok)return checked;
        model.config=support.clone(checked.config);model.active=index;model.baseline=JSON.stringify(model.form);return {ok:true,index:index};
    };
    model.resetDraft = function () {
        if(!model.editable)return response(false,"These settings are read-only.");
        model.clear();return response(true);
    };
    model.select = function (index) {
        if (model.dirty()) { var committed=model.commit(false);if(!committed.ok)return committed; }
        if(index<0||index>=model.config.iconRules.length){model.clear();return response(true);}
        model.active=index;model.form=support.clone(model.config.iconRules[index]);model.baseline=JSON.stringify(model.form);return response(true);
    };
    model.remove = function () {
        if(!model.editable)return response(false,"These settings are read-only.");
        if(model.active<0)return response(false,"Select a rule to remove.");
        model.config.iconRules.splice(model.active,1);model.clear();return response(true);
    };
    model.move = function (direction) {
        if(!model.editable)return response(false,"These settings are read-only.");
        if(model.active<0)return response(false,"Select a rule to move.");
        if(model.dirty()){var committed=model.commit(false);if(!committed.ok)return committed;}
        var index=model.active,target=index+direction;
        if(target<0||target>=model.config.iconRules.length)return response(false,"The rule is already at the end of the list.");
        var item=model.config.iconRules[index];model.config.iconRules[index]=model.config.iconRules[target];model.config.iconRules[target]=item;model.active=target;
        return response(true);
    };
    model.save = function () {
        if(!model.editable)return response(false,"These settings are read-only: "+model.message);
        if(model.dirty()){var committed=model.commit(false);if(!committed.ok)return committed;}
        var checked=WM2SettingsValidate(support,model.config);if(!checked.ok)return checked;
        var saved=support.save(resourcePath,checked.config,model.rawToken);
        if(!saved||saved.ok!==true)return response(false,saved&&saved.message?saved.message:"Settings could not be saved.");
        model.config=support.clone(saved.config || checked.config);model.rawToken=saved.rawToken;return {ok:true,config:model.config,message:String(saved.message || "")};
    };
    model.clear();return model;
}
function WM2SettingsPreviewText(result) {
    if(!result || result.ok===false)return "Preview unavailable: "+(result&&result.message?String(result.message):"No preview data was returned.");
    var lines=["Matched "+result.matched+" of "+result.scanned+" scanned scene items"+(result.truncated?" (limited to "+result.limit+" of "+result.total+")":"")+"."];
    if(result.scanned===0)lines.push("The scene is empty; there are no items to preview.");
    else if(result.matched===0)lines.push("No icon rule matches these items. Their automatic icons remain in use.");
    for(var i=0;i<result.rows.length;i++){
        var row=result.rows[i],match=row.match;
        lines.push((row.name||"<unnamed>")+" | "+(row.label||"<unlabeled>")+" -> "+(match&&match.matched?match.icon+" (rule "+(match.ruleIndex+1)+", "+WM2SettingsKindLabel(match.kind)+")":"automatic icon"));
    }
    return lines.join("\n");
}
function WM2SettingsPromptIconName(parent, currentName) {
    var dialog=new DzBasicDialog();dialog.caption="Choose another icon filename";
    dialog.showHelpButton(false);dialog.showApplyButton(false);dialog.setAcceptButtonText("Use Filename");dialog.setCancelButtonText("Cancel");
    var content=new DzWidget(dialog),layout=new DzVBoxLayout(content);layout.margin=10;layout.spacing=8;
    layout.addWidget(WM2SettingsPlainLabel(content,"The icon filename already exists or is invalid. Enter another PNG basename. Existing files will not be overwritten."));
    var filename=new DzLineEdit(content);filename.text=String(currentName||"");layout.addWidget(filename);dialog.addWidget(content);
    try { return dialog.exec()?String(filename.text):null; }
    finally { dialog.deleteLater(); }
}
function WM2ShowIconRules(resourcePath) {
    var support=WM2Support,icons=[],iconError="";
    try { icons=WM2SettingsIcons(resourcePath); } catch(e) { iconError="Icon listing failed: "+String(e); }
    var model=WM2SettingsModel(support,resourcePath,icons.length?icons[0]:""),ui=WM2SettingsDialog("Wearables Manager - Icon Rules",resourcePath),dialog=ui.dialog,content=ui.content,layout=ui.layout,metrics=ui.metrics;
    layout.addWidget(WM2SettingsHeading(content,"Icon Rules","#87c9ff"));
    layout.addWidget(WM2SettingsPlainLabel(content,"Clear Draft resets the form. Add Rule adds a new draft row; Update Rule replaces the selected row. Save writes settings and commits a changed valid form. Matching ignores case and uses literal text. Word edges are start/end, whitespace, digits 0-9, hyphen/dash, underscore or !. Exact name wins before exact label, then longer word rules, then legacy prefixes; label and earlier row break ties. Only exact labels ignore a final ' (digits)' copy suffix."));
    var status=WM2SettingsPlainLabel(content,""),list=new DzListBox(content);list.selectionMode=DzListBox.Single;list.minHeight=metrics.listHeight;layout.addWidget(list,1);
    var kindRow=WM2SettingsRow(content,layout),kind=new DzComboBox(kindRow.widget),kinds=["exactName","exactLabel","nameWord","labelWord"];
    kindRow.layout.addWidget(WM2SettingsPlainLabel(kindRow.widget,"Match"));for(var i=0;i<kinds.length;i++)kind.addItem(WM2SettingsKindLabel(kinds[i]));kind.minHeight=metrics.fieldHeight;kindRow.layout.addWidget(kind,1);
    var patternRow=WM2SettingsRow(content,layout),pattern=new DzLineEdit(patternRow.widget);pattern.minHeight=metrics.fieldHeight;patternRow.layout.addWidget(WM2SettingsPlainLabel(patternRow.widget,"Pattern"));patternRow.layout.addWidget(pattern,1);
    var iconRow=WM2SettingsRow(content,layout),icon=new DzComboBox(iconRow.widget),iconValues=icons.slice(0),browse=WM2SettingsButton(iconRow.widget,"Browse PNG",resourcePath,"Wearables Manager - Prop.png");icon.minHeight=metrics.fieldHeight;iconRow.layout.addWidget(WM2SettingsPlainLabel(iconRow.widget,"Icon"));iconRow.layout.addWidget(icon,1);iconRow.layout.addWidget(browse);
    for(var j=0;j<icons.length;j++)icon.addItem(icons[j]);
    var actions=WM2SettingsRow(content,layout),selectionActions=WM2SettingsRow(content,layout),moving=WM2SettingsRow(content,layout),populating=false,selection=null,connectedSelection=false;
    var add=WM2SettingsButton(actions.widget,"Add Rule",resourcePath,"Wearables Manager - Prop.png"),update=WM2SettingsButton(actions.widget,"Update Rule",resourcePath,"Wearables Manager - Ok.png"),remove=WM2SettingsButton(actions.widget,"Remove",resourcePath,"Wearables Manager - Cancel.png"),clearDraft=WM2SettingsButton(actions.widget,"Clear Draft",resourcePath,"Wearables Manager - Empty.png");
    actions.layout.addWidget(clearDraft);actions.layout.addWidget(add);actions.layout.addWidget(update);actions.layout.addWidget(remove);
    var useName=WM2SettingsButton(selectionActions.widget,"Use Selected Name",resourcePath,"Wearables Manager - Prop.png"),useLabel=WM2SettingsButton(selectionActions.widget,"Use Selected Label",resourcePath,"Wearables Manager - Prop.png");selectionActions.layout.addWidget(useName);selectionActions.layout.addWidget(useLabel);
    var up=WM2SettingsButton(moving.widget,"Move Up",resourcePath,"Wearables Manager - Arrow Left.png",true),down=WM2SettingsButton(moving.widget,"Move Down",resourcePath,"Wearables Manager - Arrow Right.png",true),previewButton=WM2SettingsButton(moving.widget,"Preview Scene",resourcePath,"Wearables Manager - Group.png");moving.layout.addWidget(up);moving.layout.addWidget(down);moving.layout.addWidget(previewButton);
    layout.addWidget(WM2SettingsPlainLabel(content,"Results show the selected item or a scene sample. Preview Scene scans up to 2,000 scene nodes and includes a valid current form as an unsaved candidate. It changes no nodes and saves no settings. Legacy prefix forms are read-only; use Clear Draft for a new rule."));
    var preview=new DzTextEdit(content);preview.readOnly=true;preview.acceptRichText=false;preview.minHeight=metrics.previewHeight;layout.addWidget(preview,1);layout.addWidget(status);
    function say(text){status.text=String(text);}
    function refreshSelection(){
        selection=support.iconSelection(Scene);
        var editable=model.editable&&!WM2SettingsIsLegacyKind(model.form.kind),value=model.form.pattern.toLowerCase();
        useName.enabled=editable&&selection.ok&&value!==support.iconNodeName(selection.node).toLowerCase();
        useLabel.enabled=editable&&selection.ok&&value!==support.iconNodeLabel(selection.node).toLowerCase();
        if(!selection.ok)say(selection.message);
        return selection;
    }
    function capture(){if(!populating&&!WM2SettingsIsLegacyKind(model.form.kind)){model.setForm({kind:kinds[kind.currentItem]||"exactName",pattern:String(pattern.text),icon:iconValues[icon.currentItem]||""});refreshSelection();}}
    function renderPreview(wholeScene, includeForm){
        try {
            var rules=support.clone(model.config.iconRules),note="";
            if(includeForm && model.form.pattern && model.form.icon && !WM2SettingsIsLegacyKind(model.form.kind)) {
                var next=support.clone(model.config),index=model.active>=0?model.active:next.iconRules.length;next.iconRules[index]=support.clone(model.form);
                var checked=WM2SettingsValidate(support,next);
                if(checked.ok){rules=checked.config.iconRules;note="Current form included as an unsaved candidate.\n";}
                else note="Current form is not included: "+checked.message+"\n";
            }
            var current=selection || support.iconSelection(Scene),nodes;
            if(!wholeScene && current.ok)nodes={ok:true,nodes:[current.node],total:1,truncated:false};
            else nodes=support.iconSceneNodes(Scene,false,wholeScene?2000:200);
            if(!nodes.ok){preview.plainText=note+"Preview unavailable: "+nodes.message;return;}
            var result=support.previewIconRules(rules,nodes.nodes,wholeScene?2000:200);
            result.total=nodes.total;result.truncated=result.scanned<nodes.total;
            preview.plainText=note+WM2SettingsPreviewText(result);
        }catch(e){preview.plainText="Preview unavailable: "+String(e);}
    }
    function populate(){populating=true;try{
        list.clear();for(var n=0;n<model.config.iconRules.length;n++){var rule=model.config.iconRules[n];list.insertItem((n+1)+". "+WM2SettingsKindLabel(rule.kind)+" | "+rule.pattern+" -> "+rule.icon);}
        for(var selected=0;selected<model.config.iconRules.length;selected++)list.setSelected(selected,false);
        list.currentItem=model.active;if(model.active>=0)list.setSelected(model.active,true);
        kind.currentItem=kinds.indexOf(model.form.kind);pattern.text=model.form.pattern;
        var index=iconValues.indexOf(model.form.icon);if(index<0&&model.form.icon){iconValues.push(model.form.icon);icon.addItem(model.form.icon+" [missing]");index=iconValues.length-1;}icon.currentItem=index;
        var hasSelection=model.editable&&model.active>=0,canEdit=model.editable&&!WM2SettingsIsLegacyKind(model.form.kind);
        kind.enabled=canEdit;pattern.enabled=canEdit;icon.enabled=canEdit;browse.enabled=canEdit;add.enabled=canEdit;clearDraft.enabled=model.editable;
        update.enabled=hasSelection&&canEdit;remove.enabled=hasSelection;up.enabled=hasSelection&&model.active>0;down.enabled=hasSelection&&model.active<model.config.iconRules.length-1;
    }finally{populating=false;}refreshSelection();renderPreview(false,false);}
    function perform(fn,clear){capture();try{var result=fn();if(!result.ok){say(result.message);return;}if(clear)model.clear();populate();say("Draft list updated. Save writes these changes.");}catch(e){say(String(e));}}
    function edited(){if(populating)return;capture();renderPreview(false,true);}
    connect(kind,"currentIndexChanged(int)",edited);connect(pattern,"textChanged(const QString&)",edited);connect(icon,"currentIndexChanged(int)",edited);
    connect(list,"selectionChanged(int)",function(index){if(populating)return;capture();var result=model.select(Number(index));if(!result.ok){populating=true;try{for(var n=0;n<model.config.iconRules.length;n++)list.setSelected(n,false);list.currentItem=model.active;if(model.active>=0)list.setSelected(model.active,true);}finally{populating=false;}say(result.message);return;}populate();});
    connect(clearDraft,"clicked()",function(){perform(model.resetDraft,false);say("Form cleared; no rule was added.");});
    connect(add,"clicked()",function(){perform(function(){return model.commit(true);},true);});connect(update,"clicked()",function(){perform(function(){return model.active<0?{ok:false,message:"Select a rule to update."}:model.commit(false);},true);});connect(remove,"clicked()",function(){perform(model.remove,false);});
    connect(up,"clicked()",function(){perform(function(){return model.move(-1);},false);});connect(down,"clicked()",function(){perform(function(){return model.move(1);},false);});
    function useSelected(label){try{var current=refreshSelection();if(!current.ok){say(current.message);return;}capture();model.setForm({kind:model.form.kind,pattern:label?support.iconNodeLabel(current.node):support.iconNodeName(current.node),icon:model.form.icon});populate();renderPreview(false,true);say("Selected text copied to Pattern; Match mode kept. Add Rule, Update Rule or Save applies the changed form.");}catch(e){say(String(e));}}
    connect(useName,"clicked()",function(){useSelected(false);});connect(useLabel,"clicked()",function(){useSelected(true);});
    connect(browse,"clicked()",function(){try{
        var selectedPath=String(FileDialog.doFileDialog(true,"Choose PNG Icon",resourcePath,"PNG Images (*.png *.PNG)",0,dialog));if(!selectedPath)return;
        var name,result;
        for(var attempt=0;attempt<16;attempt++){
            result=support.importIcon(resourcePath,selectedPath,name);
            if(result.ok){capture();var index=iconValues.indexOf(result.icon);if(index<0){iconValues.push(result.icon);icon.addItem(result.icon);index=iconValues.length-1;}icon.currentItem=index;capture();renderPreview(false,true);say(result.message);return;}
            if(result.status!=="collision"&&result.status!=="invalid-name"){say(result.message);return;}
            name=WM2SettingsPromptIconName(dialog,result.name || name || "");if(name===null){say("Icon import cancelled; current icon kept.");return;}
        }
        say("Icon import stopped after repeated invalid or conflicting filenames. Current icon kept.");
    }catch(e){say("Icon import failed; current icon kept. "+String(e));}});
    connect(previewButton,"clicked()",function(){capture();renderPreview(true,true);});
    function selectionChanged(){var current=refreshSelection();if(current.ok)say("Selected: "+support.iconNodeName(current.node)+" | "+support.iconNodeLabel(current.node));renderPreview(false,true);}
    try{connect(Scene,"nodeSelectionListChanged()",selectionChanged);connectedSelection=true;}catch(e){}
    selection=support.iconSelection(Scene);
    if(selection.ok){model.setForm({kind:"exactLabel",pattern:support.iconNodeLabel(selection.node),icon:model.form.icon});model.baseline=JSON.stringify(model.form);}
    dialog.setAcceptButtonEnabled(model.editable);ui.saveButton.enabled=model.editable;
    populate();say((model.message||("Settings: "+model.status+"."))+(iconError?" "+iconError:"")+(selection.ok?"":" "+selection.message));
    try { while(dialog.exec()){capture();try{var saved=model.save();if(saved.ok)return {saved:true,config:support.clone(model.config),message:saved.message};populate();say(saved.message);}catch(e){say(String(e));}}return {saved:false}; }
    finally { try{if(connectedSelection)disconnect(Scene,"nodeSelectionListChanged()",selectionChanged);}catch(e){} dialog.deleteLater(); }
}

function WM2SettingsResetGenesis(support, config) {
    var next=support.clone(config),defaults=support.defaults().supportedFigures;
    for(var i=0;i<defaults.length;i++)if(next.supportedFigures.indexOf(defaults[i])<0)next.supportedFigures.push(defaults[i]);
    return next;
}
function WM2NoEligibleTransfers() {
    MessageBox.information("Nothing is eligible to move. Review transfer marks and Supported Figures > Protected Children. New custom types protect their current attachments, including clothing. Remove protection for the clothing you want to move, then reopen Wearables Manager.", "Wearables Manager", "&OK");
}
function WM2ShowProtectedChildren(resourcePath, config, figureName) {
    var support=WM2Support,children=support.protectedChildNames(config,figureName),ui=WM2SettingsDialog("Protected Children: "+figureName,resourcePath),dialog=ui.dialog,content=ui.content,layout=ui.layout,metrics=ui.metrics;
    layout.addWidget(WM2SettingsHeading(content,"Protected Children: "+figureName,"#FA8072"));
    layout.addWidget(WM2SettingsPlainLabel(content,"These exact internal child names stay attached, including their subtrees. An ancestor carrying any protected child also stays attached. Names apply to every instance of this figure type. Add a name manually or select a child in Scene. Removing a name explicitly allows that item to move; automatic graft safety still applies. Save updates the parent draft; Save there writes settings."));
    var list=new DzListBox(content),row=WM2SettingsRow(content,layout),name=new DzLineEdit(row.widget),status=WM2SettingsPlainLabel(content,"");
    list.selectionMode=DzListBox.Single;list.minHeight=metrics.listHeight;layout.addWidget(list,1);row.layout.addWidget(WM2SettingsPlainLabel(row.widget,"Child internal name"));row.layout.addWidget(name,1);
    var actions=WM2SettingsRow(content,layout),add=WM2SettingsButton(actions.widget,"Protect Name",resourcePath,"Wearables Manager - Prop.png"),selected=WM2SettingsButton(actions.widget,"Use Selected Child",resourcePath,"Wearables Manager - Group.png"),remove=WM2SettingsButton(actions.widget,"Remove Protection",resourcePath,"Wearables Manager - Cancel.png"),reset=WM2SettingsButton(actions.widget,"Restore Genesis Protection",resourcePath,"Wearables Manager - Ok.png");
    actions.layout.addWidget(add);actions.layout.addWidget(selected);actions.layout.addWidget(remove);actions.layout.addWidget(reset);layout.addWidget(status);
    function say(message){status.text=String(message);}
    function populate(){list.clear();for(var i=0;i<children.length;i++)list.insertItem(children[i]);list.currentItem=-1;remove.enabled=false;}
    connect(list,"selectionChanged(int)",function(index){remove.enabled=Number(index)>=0&&Number(index)<children.length;});
    connect(add,"clicked()",function(){try{var child=String(name.text),next=children.slice(0);if(next.indexOf(child)>=0){say("That exact child name is already protected.");return;}next.push(child);var checked=support.setProtectedChildNames(config,figureName,next);if(!checked.ok){say(checked.message);return;}children=next;name.text="";populate();say("Protected "+child+" in this draft.");}catch(e){say(String(e));}});
    connect(selected,"clicked()",function(){try{
        var node=Scene.getPrimarySelection(),nodes=Scene.getNodeList(),current=node,seen=[],owner=null;
        if(!node || node.inherits("DzBone")){say("Select a nonbone child in Scene.");return;}
        while(current){if(support.isSupportedFigure(current,config)){owner=current;break;}for(var i=0;i<seen.length;i++)if(String(seen[i].elementID)===String(current.elementID))throw new Error("Child ancestry contains a cycle.");seen.push(current);if(seen.length>nodes.length)throw new Error("Child ancestry is unavailable.");current=current.getNodeParent();}
        if(!owner || String(owner.elementID)===String(node.elementID) || support.figureInternalName(owner)!==figureName){say("Select an attached child of "+figureName+".");return;}
        name.text=support.figureInternalName(node);say("Internal name: "+String(name.text)+" | Visible label: "+support.iconNodeLabel(node)+". Protect Name adds it.");
    }catch(e){say(String(e));}});
    connect(remove,"clicked()",function(){var index=Number(list.currentItem);if(index<0||index>=children.length)return;var child=children.splice(index,1)[0];if(String(name.text)===child)name.text="";populate();say("Removed protection for "+child+" in this draft.");});
    connect(reset,"clicked()",function(){var defaults=support.defaultProtectedChildren();for(var i=0;i<defaults.length;i++)if(defaults[i].figure===figureName)for(var c=0;c<defaults[i].children.length;c++)if(children.indexOf(defaults[i].children[c])<0)children.push(defaults[i].children[c]);populate();say("Genesis child defaults restored; custom protection kept.");});
    populate();say("Protected child names: "+children.length+".");
    try{while(dialog.exec()){var next=children.slice(0),pending=String(name.text);if(pending && next.indexOf(pending)<0)next.push(pending);var result=support.setProtectedChildNames(config,figureName,next);if(result.ok)return {saved:true,config:result.config};say(result.message);}return {saved:false};}
    finally{dialog.deleteLater();}
}
function WM2ShowSupportedFigures(resourcePath) {
    var support=WM2Support,model=WM2SettingsModel(support,resourcePath,""),ui=WM2SettingsDialog("Wearables Manager - Supported Figures",resourcePath),dialog=ui.dialog,content=ui.content,layout=ui.layout,metrics=ui.metrics;
    layout.addWidget(WM2SettingsHeading(content,"Supported Figures","#FA8072"));
    layout.addWidget(WM2SettingsPlainLabel(content,"The registry uses exact internal figure names, not labels. Select an independent figure or one of its bones, then Add Selected Figure. New custom types initially protect their current attachments, including clothing: select the type and open Protected Children to allow movable items. Figure choices apply on the next run; saved protection also applies to an open transfer dialog."));
    var defaults=support.defaults().supportedFigures,list=new DzListBox(content),status=WM2SettingsPlainLabel(content,"");list.selectionMode=DzListBox.Single;list.minHeight=metrics.listHeight;layout.addWidget(list,1);
    var actions=WM2SettingsRow(content,layout),add=WM2SettingsButton(actions.widget,"Add Selected Figure",resourcePath,"Wearables Manager - Prop.png"),remove=WM2SettingsButton(actions.widget,"Remove",resourcePath,"Wearables Manager - Cancel.png"),reset=WM2SettingsButton(actions.widget,"Reset Genesis Defaults",resourcePath,"Wearables Manager - Group.png"),protect=WM2SettingsButton(actions.widget,"Protected Children...",resourcePath,"Wearables Manager - Ok.png");actions.layout.addWidget(add);actions.layout.addWidget(remove);actions.layout.addWidget(reset);actions.layout.addWidget(protect);layout.addWidget(status);
    function say(text){status.text=String(text);}
    function populate(){list.clear();for(var i=0;i<model.config.supportedFigures.length;i++){var name=model.config.supportedFigures[i];list.insertItem(name+(defaults.indexOf(name)>=0?" [Genesis default]":" [custom figure]")+" | protected children: "+support.protectedChildNames(model.config,name).length);list.setSelected(i,false);}list.currentItem=-1;remove.enabled=false;protect.enabled=false;}
    connect(list,"selectionChanged(int)",function(index){remove.enabled=protect.enabled=model.editable&&Number(index)>=0&&Number(index)<model.config.supportedFigures.length;});
    connect(add,"clicked()",function(){try{var result=support.addSupportedFigure(model.config,Scene.getPrimarySelection());if(!result.ok){say(result.message);return;}model.config=support.clone(result.config);populate();say("Internal name: "+support.figureInternalName(result.figure)+" | Visible label: "+support.iconNodeLabel(result.figure)+". "+result.message+" Save to apply.");}catch(e){say(String(e));}});
    connect(protect,"clicked()",function(){try{var index=Number(list.currentItem);if(index<0||index>=model.config.supportedFigures.length)return;var result=WM2ShowProtectedChildren(resourcePath,model.config,model.config.supportedFigures[index]);if(result.saved){model.config=support.clone(result.config);populate();say("Protected children updated in this draft. Save to apply.");}}catch(e){say(String(e));}});
    connect(remove,"clicked()",function(){var index=Number(list.currentItem);if(index<0||index>=model.config.supportedFigures.length){say("Select a registry entry to remove.");return;}var removed=model.config.supportedFigures[index];model.config.supportedFigures.splice(index,1);populate();say("Removed "+removed+" from this draft. Save to apply on the next run.");});
    connect(reset,"clicked()",function(){model.config=WM2SettingsResetGenesis(support,model.config);populate();say("Genesis defaults restored; custom entries kept. Save to apply on the next run.");});
    add.enabled=model.editable;reset.enabled=model.editable;dialog.setAcceptButtonEnabled(model.editable);ui.saveButton.enabled=model.editable;populate();say(model.message||("Settings: "+model.status+"."));
    try { while(dialog.exec()){try{var saved=model.save();if(saved.ok)return {saved:true,config:support.clone(model.config),message:saved.message};say(saved.message);}catch(e){say(String(e));}}return {saved:false}; }
    finally { dialog.deleteLater(); }
}
