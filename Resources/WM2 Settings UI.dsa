                    var pixels=scaledImage || image,w=Number(pixels.width),h=Number(pixels.height);
                    if(w<=0 || h<=0 || w>iconSize || h>iconSize || typeof pixels.pixel!=="function" || typeof Image==="undefined" || typeof Image.Format_ARGB32==="undefined")throw new Error("Arrow rotation is unavailable.");
