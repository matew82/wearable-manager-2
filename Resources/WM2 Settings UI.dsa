            WM2SettingsCSS(row.widget,"QWidget#WM2EditorRow"+i+" { background-color:"+(selected?"#293c49":"transparent")+"; border:1px solid "+(selected?"#87c9ff":"#777777")+"; border-radius:4px; }");
            WM2SettingsCSS(row.label,"QLabel { "+(selected?"color:#87c9ff; ":"")+"border:0; background:transparent; }");
            WM2SettingsCSS(row.detailLabel,"QLabel { "+(selected?"color:#dddddd; ":"")+"border:0; background:transparent; }");
        }
