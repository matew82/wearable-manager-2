function WM2SettingsButton(parent, text, resourcePath, iconFilename, rotateClockwise, iconSize) {
    var button = new DzPushButton(parent), metrics = WM2SettingsMetrics(button);
    if(iconSize===32){metrics.iconSize=32;metrics.buttonHeight=Math.max(metrics.buttonHeight,44);}
    button.text = String(text); button.font = WM2SettingsFont(button, false); button.minHeight = metrics.buttonHeight;
