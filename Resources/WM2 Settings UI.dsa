    var model=WM2SettingsModel(support,resourcePath,icons.length?icons[0]:""),ui=WM2SettingsDialog("Wearables Manager - Icon Rules",resourcePath),dialog=ui.dialog,content=ui.content,layout=ui.layout,metrics=ui.metrics;
    layout.addWidget(WM2SettingsHeading(content,"Icon Rules","#87c9ff"));
    layout.addWidget(WM2SettingsPlainLabel(content,"Clear Draft resets the form. Add Rule adds a new draft row; Update Rule replaces the selected row. Save writes settings and commits a changed valid form. Matching ignores case and uses literal text. Word edges are start/end, whitespace, digits 0-9, hyphen/dash, underscore or !. Exact name wins before exact label, then longer word rules, then legacy prefixes; label and earlier row break ties. Only exact labels ignore a final ' (digits)' copy suffix."));
    var status=WM2SettingsPlainLabel(content,""),list=new DzListBox(content);list.selectionMode=DzListBox.Single;list.minHeight=metrics.listHeight;layout.addWidget(list,1);
    var kindRow=WM2SettingsRow(content,layout),kind=new DzComboBox(kindRow.widget),kinds=["exactName","exactLabel","nameWord","labelWord"];
    kindRow.layout.addWidget(WM2SettingsPlainLabel(kindRow.widget,"Match"));for(var i=0;i<kinds.length;i++)kind.addItem(WM2SettingsKindLabel(kinds[i]));kind.minHeight=metrics.fieldHeight;kindRow.layout.addWidget(kind,1);
    var patternRow=WM2SettingsRow(content,layout),pattern=new DzLineEdit(patternRow.widget);pattern.minHeight=metrics.fieldHeight;patternRow.layout.addWidget(WM2SettingsPlainLabel(patternRow.widget,"Pattern"));patternRow.layout.addWidget(pattern,1);
    var iconRow=WM2SettingsRow(content,layout),icon=new DzComboBox(iconRow.widget),iconValues=icons.slice(0),browse=WM2SettingsButton(iconRow.widget,"Browse PNG",resourcePath,"Wearables Manager - Prop.png");icon.minHeight=metrics.fieldHeight;iconRow.layout.addWidget(WM2SettingsPlainLabel(iconRow.widget,"Icon"));iconRow.layout.addWidget(icon,1);iconRow.layout.addWidget(browse);
    for(var j=0;j<icons.length;j++)icon.addItem(icons[j]);
    var actions=WM2SettingsRow(content,layout),selectionActions=WM2SettingsRow(content,layout),moving=WM2SettingsRow(content,layout),populating=false,selection=null,connectedSelection=false;
    var add=WM2SettingsButton(actions.widget,"Add Rule",resourcePath,"Wearables Manager - Prop.png"),update=WM2SettingsButton(actions.widget,"Update Rule",resourcePath,"Wearables Manager - Ok.png"),remove=WM2SettingsButton(actions.widget,"Remove",resourcePath,"Wearables Manager - Cancel.png"),clearDraft=WM2SettingsButton(actions.widget,"Clear Draft",resourcePath,"Wearables Manager - Empty.png");
    actions.layout.addWidget(clearDraft);actions.layout.addWidget(add);actions.layout.addWidget(update);actions.layout.addWidget(remove);
    var useName=WM2SettingsButton(selectionActions.widget,"Use Selected Name",resourcePath,"Wearables Manager - Prop.png"),useLabel=WM2SettingsButton(selectionActions.widget,"Use Selected Label",resourcePath,"Wearables Manager - Prop.png");selectionActions.layout.addWidget(useName);selectionActions.layout.addWidget(useLabel);
    var up=WM2SettingsButton(moving.widget,"Move Up",resourcePath,"Wearables Manager - Arrow Left.png",true),down=WM2SettingsButton(moving.widget,"Move Down",resourcePath,"Wearables Manager - Arrow Right.png",true),previewButton=WM2SettingsButton(moving.widget,"Preview Scene",resourcePath,"Wearables Manager - Group.png");moving.layout.addWidget(up);moving.layout.addWidget(down);moving.layout.addWidget(previewButton);
    layout.addWidget(WM2SettingsPlainLabel(content,"Preview shows the selected item with its Menu icon. Preview Scene shows that item's figure and its Menu items. Valid draft edits are included. Legacy prefix forms are read-only; use Clear Draft for a new rule."));
    var preview=new DzScrollArea(content);preview.widgetResizable=true;preview.minHeight=Math.max(180,metrics.previewHeight);layout.addWidget(preview,1);layout.addWidget(status);
    var previewWholeFigure=false,iconResolver=support.createIconResolver(resourcePath,function(){return model.config.iconRules;});
    function say(text){status.text=String(text);}
    function refreshSelection(){
