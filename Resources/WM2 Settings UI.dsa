        try{if(button.pixmap&&!button.pixmap.isNull())button.text="";}catch(e){}
        button.minWidth=44;button.minHeight=44;button.maxWidth=44;button.maxHeight=44;if(typeof button.setCheckable==="function")button.setCheckable(true);else try{button.getWidget().checkable=true;}catch(e){}try{button.getWidget().autoDefault=false;}catch(e){}button.wm2ModeKind=kinds[i];button.toolTip=WM2SettingsKindLabel(kinds[i]);row.layout.addWidget(button);picker.buttons.push(button);
        (function(index,control){connect(control,"clicked()",function(){if(picker.enabled&&control.enabled){picker.select(index,true);try{control.getWidget().setFocus();}catch(e){}}});})(i,button);
    }
