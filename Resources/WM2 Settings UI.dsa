        var caption=WM2SettingsPlainLabel(column,"");textLayout.addWidget(caption);line.layout.addWidget(column,1);
        var unavailable=WM2SettingsPlainLabel(line.widget,"Icon unavailable");line.layout.addWidget(unavailable);
        var row={widget:widget,heading:heading,image:image,label:label,caption:caption,unavailable:unavailable,layout:line.layout,active:false,item:null};
        connect(image,"clicked()",function(){
            if(state.dispatching||!row.active||!image.enabled||!row.item||typeof state.onSelect!=="function")return;
            state.dispatching=true;try{state.onSelect(row.item.node);}finally{state.dispatching=false;}
        });
        return row;
    }
    for(var i=0;i<rows.length;i++){
        var item=rows[i],next=item.isInGroup?"Stored":"On Figure",row=state.pool[i];if(!row){row=createRow();state.pool.push(row);}
        row.active=true;row.item=item;WM2SettingsSetVisible(row.widget,true);row.image.enabled=true;row.image.wm2EditingNode=item.node;row.image.toolTip=item.usable?item.label:"Icon unavailable";
        WM2SettingsSetVisible(row.heading,result.title!=="Selected item"&&next!==section);WM2SettingsSetPlainText(row.heading,next);section=next;
        WM2Support.setMenuPixmap(row.image,item.pixmap);
        WM2SettingsSetPlainText(row.label,(item.parentLabel?item.parentLabel+" > ":"")+item.label);WM2SettingsSetPlainText(row.caption,item.assetCaption||"");WM2SettingsSetVisible(row.caption,!!item.assetCaption);WM2SettingsSetVisible(row.unavailable,!item.usable);
        row.layout.margin=Math.min(10,item.depth)*16;
    }
    for(var j=rows.length;j<state.pool.length;j++){var spare=state.pool[j];spare.active=false;spare.item=null;WM2SettingsSetVisible(spare.widget,false);spare.image.enabled=false;spare.image.wm2EditingNode=null;}
    scroll.wm2Preview=result;
}
function WM2SettingsPromptIconName(parent, currentName) {
    var dialog=new DzBasicDialog();dialog.caption="Choose another icon filename";
    dialog.showHelpButton(false);dialog.showApplyButton(false);dialog.setAcceptButtonText("Use Filename");dialog.setCancelButtonText("Cancel");
    var content=new DzWidget(dialog),layout=new DzVBoxLayout(content);layout.margin=10;layout.spacing=8;
    layout.addWidget(WM2SettingsPlainLabel(content,"The icon filename already exists or is invalid. Enter another PNG basename. Existing files will not be overwritten."));
    var filename=new DzLineEdit(content);filename.text=String(currentName||"");layout.addWidget(filename);dialog.addWidget(content);
    try { return dialog.exec()?String(filename.text):null; }
    finally { dialog.deleteLater(); }
}
function WM2ShowIconRules(resourcePath,getPreviewContext) {
    var support=WM2Support,icons=[],iconError="";
    try { icons=WM2SettingsIcons(resourcePath); } catch(e) { iconError="Icon listing failed: "+String(e); }
    var model=WM2SettingsModel(support,resourcePath,icons.length?icons[0]:""),ui=WM2SettingsDialog("Icon rules for no active item",resourcePath),dialog=ui.dialog,content=ui.content,layout=ui.layout,metrics=ui.metrics;
    var heading=WM2SettingsHeading(content,"Icon rules for no active item","#87c9ff");layout.addWidget(heading);
    var boundaries=WM2SettingsPlainLabel(content,"Words match literal text, ignoring case. Boundaries are start/end, whitespace, digits, dashes, _ or ! outside the entire pattern.");boundaries.font=WM2SettingsFont(boundaries,true);layout.addWidget(boundaries);
    var status=WM2SettingsPlainLabel(content,""),list=WM2SettingsEditorRows(content,layout,resourcePath,"No icon rules.",selectRule);
    list.scroll.wm2IconRules=true;
    var kind=WM2SettingsModePicker(content,layout,resourcePath,edited),kinds=kind.kinds;
    var patternRow=WM2SettingsRow(content,layout),pattern=new DzLineEdit(patternRow.widget);pattern.minHeight=metrics.fieldHeight;patternRow.layout.addWidget(WM2SettingsPlainLabel(patternRow.widget,"Pattern"));patternRow.layout.addWidget(pattern,1);
    var iconRow=WM2SettingsRow(content,layout),icon=new DzComboBox(iconRow.widget),iconValues=icons.slice(0),browse=WM2SettingsButton(iconRow.widget,"Browse PNG",resourcePath,"Wearables Manager - Prop.png");icon.minHeight=metrics.fieldHeight;iconRow.layout.addWidget(WM2SettingsPlainLabel(iconRow.widget,"Icon"));iconRow.layout.addWidget(icon,1);iconRow.layout.addWidget(browse);
    for(var j=0;j<icons.length;j++)icon.addItem(icons[j]);
    var actions=WM2SettingsRow(content,layout),selectionActions=WM2SettingsRow(content,layout),moving=WM2SettingsRow(content,layout),populating=false,selection=null,connectedSelection=false;
    var add=WM2SettingsButton(actions.widget,"Add Rule",resourcePath,"Wearables Manager - Prop.png"),update=WM2SettingsButton(actions.widget,"Update Rule",resourcePath,"Wearables Manager - Ok.png"),remove=WM2SettingsButton(actions.widget,"Remove",resourcePath,"Wearables Manager - Cancel.png"),clearDraft=WM2SettingsButton(actions.widget,"Clear Draft",resourcePath,"Wearables Manager - Empty.png");
    actions.layout.addWidget(clearDraft);actions.layout.addWidget(add);actions.layout.addWidget(update);actions.layout.addWidget(remove);
    var useName=WM2SettingsButton(selectionActions.widget,"Use Selected Name",resourcePath,"Wearables Manager - Prop.png"),useLabel=WM2SettingsButton(selectionActions.widget,"Use Selected Label",resourcePath,"Wearables Manager - Prop.png"),useAssetId=WM2SettingsButton(selectionActions.widget,"Use Selected AssetId",resourcePath,"Wearables Manager - Prop.png");selectionActions.layout.addWidget(useName);selectionActions.layout.addWidget(useLabel);selectionActions.layout.addWidget(useAssetId);
    var assetValue=WM2SettingsPlainLabel(content,"");layout.addWidget(assetValue);
    var up=WM2SettingsButton(moving.widget,"Move Up",resourcePath,"Wearables Manager - Arrow Left.png",true),down=WM2SettingsButton(moving.widget,"Move Down",resourcePath,"Wearables Manager - Arrow Right.png",true),previewButton=WM2SettingsButton(moving.widget,"Preview Scene",resourcePath,"Wearables Manager - Group.png");moving.layout.addWidget(up);moving.layout.addWidget(down);moving.layout.addWidget(previewButton);
    var preview=new DzScrollArea(content);preview.widgetResizable=true;preview.minHeight=Math.max(180,metrics.previewHeight);layout.addWidget(preview,1);layout.addWidget(status);
    var previewWholeFigure=false,editingTarget=null,iconResolver=support.createIconResolver(resourcePath,function(){return model.config.iconRules;});
    function say(text){WM2SettingsSetPlainText(status,text);}
    function refreshSelection(){
        if(editingTarget){
            try {var target=support.menuGraph(Scene,model.config).live(editingTarget);selection=target&&support.isIconNode(target)?{ok:true,node:target,total:1,message:""}:{ok:false,node:null,total:0,message:"The editing item is unavailable; choose a live Scene item."};}
            catch(e){selection={ok:false,node:null,total:0,message:"The editing item is unavailable: "+String(e)};}
        }else selection=support.iconSelection(Scene);
        var caption="Icon rules for "+(selection.ok?support.iconNodeLabel(selection.node)+" ["+support.iconNodeName(selection.node)+"]":"no active item");
        dialog.caption=caption;WM2SettingsSetPlainText(heading,caption);
        var actualAssetId=selection.ok?support.iconNodeAssetId(selection.node):"";
        WM2SettingsSetPlainText(assetValue,actualAssetId?"AssetId: "+actualAssetId:"AssetId unavailable");
        var editable=model.editable&&!WM2SettingsIsLegacyKind(model.form.kind),value=model.form.pattern.toLowerCase();
        useName.enabled=editable&&selection.ok&&value!==support.iconNodeName(selection.node).toLowerCase();
        useLabel.enabled=editable&&selection.ok&&value!==support.iconNodeLabel(selection.node).toLowerCase();
        useAssetId.enabled=editable&&selection.ok&&actualAssetId.length>0&&value!==actualAssetId.toLowerCase();
        if(!selection.ok)say(selection.message);
        return selection;
    }
    function capture(){if(!populating&&!WM2SettingsIsLegacyKind(model.form.kind)){model.setForm({kind:kinds[kind.currentItem]||"exactName",pattern:String(pattern.text),icon:iconValues[icon.currentItem]||""});refreshSelection();}}
    function renderPreview(wholeScene, includeForm){
        try {
            if(typeof wholeScene==="boolean")previewWholeFigure=wholeScene;
            var next=support.clone(model.config),note="";
            if(includeForm && model.dirty() && model.form.pattern && model.form.icon && !WM2SettingsIsLegacyKind(model.form.kind)) {
                var index=model.active>=0?model.active:next.iconRules.length;next.iconRules[index]=model.ruleFromForm(index);
                var checked=WM2SettingsValidate(support,next);
                if(checked.ok)next=checked.config;
                else {next=support.clone(model.config);note="Draft is invalid; preview keeps the rule list.";}
            }
            var context=typeof getPreviewContext==="function"?getPreviewContext():null;
            var result=support.previewMenu(Scene,next,iconResolver,previewWholeFigure,context,editingTarget);
            if(note)result.message=note+(result.message?" "+result.message:"");
            WM2SettingsRenderMenuPreview(preview,result,function(node){choosePreviewTarget(node,result.owner);},function(owner){returnToOwner(owner,result.activeNode);},resourcePath);
        }catch(e){WM2SettingsRenderMenuPreview(preview,{ok:false,message:"Preview unavailable: "+String(e),rows:[]});}
    }
    function populate(whole,includeForm){populating=true;try{
        var entries=[];for(var n=0;n<model.config.iconRules.length;n++){var rule=model.config.iconRules[n],enabled=WM2SettingsRuleEnabled(rule);entries.push({name:"rule"+n,text:rule.pattern,detail:(!enabled?"Disabled | ":"")+WM2SettingsKindLabel(rule.kind)+" | "+rule.icon,enabled:enabled});}
        list.populate(entries,model.active>=0?"rule"+model.active:null);
        kind.select(kinds.indexOf(model.form.kind),false,model.form.kind);pattern.text=model.form.pattern;
        var index=iconValues.indexOf(model.form.icon);if(index<0&&model.form.icon){iconValues.push(model.form.icon);icon.addItem(model.form.icon+" [missing]");index=iconValues.length-1;}icon.currentItem=index;
        var hasSelection=model.editable&&model.active>=0,canEdit=model.editable&&!WM2SettingsIsLegacyKind(model.form.kind);
        kind.setEnabled(canEdit);pattern.enabled=canEdit;icon.enabled=canEdit;browse.enabled=canEdit;add.enabled=canEdit;clearDraft.enabled=model.editable;
        update.enabled=hasSelection&&canEdit;remove.enabled=hasSelection;up.enabled=hasSelection&&model.active>0;down.enabled=hasSelection&&model.active<model.config.iconRules.length-1;
    }finally{populating=false;}refreshSelection();renderPreview(typeof whole==="boolean"?whole:false,includeForm===true);}
    function perform(fn,clear){capture();try{var result=fn();if(!result.ok){say(result.message);return;}if(clear)model.clear();populate();say("Draft list updated. Save writes these changes.");}catch(e){say(String(e));}}
    function edited(){if(populating)return;capture();renderPreview(null,true);}
    connect(pattern,"textChanged(const QString&)",edited);connect(icon,"currentIndexChanged(int)",edited);
    function selectRule(index){if(populating)return;capture();var result=model.select(Number(index));if(!result.ok){populating=true;try{list.select(model.active,false);}finally{populating=false;}say(result.message);return;}populate();if(model.active>=0){populating=true;try{list.select(model.active,true);}finally{populating=false;}}}
    connect(clearDraft,"clicked()",function(){perform(model.resetDraft,false);say("Form cleared; no rule was added.");});
    connect(add,"clicked()",function(){perform(function(){return model.commit(true);},true);});connect(update,"clicked()",function(){perform(function(){return model.active<0?{ok:false,message:"Select a rule to update."}:model.commit(false);},true);});connect(remove,"clicked()",function(){perform(model.remove,false);});
    connect(up,"clicked()",function(){perform(function(){return model.move(-1);},false);});connect(down,"clicked()",function(){perform(function(){return model.move(1);},false);});
    function returnToOwner(owner,source){try{
        var graph=support.menuGraph(Scene,model.config),liveOwner=graph.live(owner),liveSource=graph.live(source),selected=support.iconSceneNodes(Scene,true,2);
        var active=editingTarget?graph.live(editingTarget):selected.ok&&selected.total===1?graph.live(selected.nodes[0]):null;
        if(!liveOwner||!liveSource||!active||!graph.same(active,liveSource)){say("That owner navigation is unavailable; the active item changed.");return;}
        if(!graph.same(graph.owner(liveSource),liveOwner)){say("That item no longer belongs to the previewed figure.");return;}
        choosePreviewTarget(liveOwner,liveOwner,true);
    }catch(e){say("The owner could not be selected: "+String(e));}}
    function choosePreviewTarget(node,expectedOwner,wholeFigure){try{
        var graph=support.menuGraph(Scene,model.config),target=graph.live(node);
        if(!target || !support.isIconNode(target)){say("That preview item is unavailable.");return;}
        if(expectedOwner&&!graph.same(graph.owner(target),expectedOwner)){say("That item no longer belongs to the previewed figure.");return;}
        capture();
        if(model.dirty()){var committed=model.commit(false);if(!committed.ok){say("Keep this draft: "+committed.message+" Correct it or Clear Draft before choosing another item.");return;}}
        editingTarget=target;
        var matched=support.matchIcon(model.config.iconRules,target);
        if(matched.matched){var selectedRule=model.select(matched.ruleIndex);if(!selectedRule.ok){say(selectedRule.message);return;}}
        else {model.clear();model.setForm({kind:"exactLabel",pattern:support.iconNodeLabel(target),icon:model.form.icon});model.baseline=JSON.stringify(model.form);}
        var keepWhole=wholeFigure===true?true:previewWholeFigure;populate(keepWhole,false);
        say("Editing "+support.iconNodeLabel(target)+". Prior valid edits remain in the draft list; Save applies all changes.");
    }catch(e){say("Editing target could not be changed: "+String(e));}}
    function useSelected(field){try{var current=refreshSelection();if(!current.ok){say(current.message);return;}var text=field==="asset"?support.iconNodeAssetId(current.node):field==="label"?support.iconNodeLabel(current.node):support.iconNodeName(current.node);if(!text){say("The active item has no "+(field==="asset"?"assetId":field)+" value.");return;}capture();model.setForm({kind:model.form.kind,pattern:text,icon:model.form.icon});populate(false,true);say("Selected text copied to Pattern; Match mode kept. Add Rule, Update Rule or Save applies the changed form.");}catch(e){say(String(e));}}
    connect(useName,"clicked()",function(){useSelected("name");});connect(useLabel,"clicked()",function(){useSelected("label");});connect(useAssetId,"clicked()",function(){useSelected("asset");});
    connect(browse,"clicked()",function(){try{
        var selectedPath=String(FileDialog.doFileDialog(true,"Choose PNG Icon",resourcePath,"PNG Images (*.png *.PNG)",0,dialog));if(!selectedPath)return;
        var name,result;
        for(var attempt=0;attempt<16;attempt++){
            result=support.importIcon(resourcePath,selectedPath,name);
            if(result.ok){capture();var index=iconValues.indexOf(result.icon);if(index<0){iconValues.push(result.icon);icon.addItem(result.icon);index=iconValues.length-1;}icon.currentItem=index;capture();renderPreview(false,true);say(result.message);return;}
            if(result.status!=="collision"&&result.status!=="invalid-name"){say(result.message);return;}
            name=WM2SettingsPromptIconName(dialog,result.name || name || "");if(name===null){say("Icon import cancelled; current icon kept.");return;}
        }
        say("Icon import stopped after repeated invalid or conflicting filenames. Current icon kept.");
    }catch(e){say("Icon import failed; current icon kept. "+String(e));}});
    connect(previewButton,"clicked()",function(){capture();renderPreview(true,true);});
    function selectionChanged(){editingTarget=null;var current=refreshSelection();if(current.ok)say("Selected: "+support.iconNodeLabel(current.node));renderPreview(null,true);}
    try{connect(Scene,"nodeSelectionListChanged()",selectionChanged);connectedSelection=true;}catch(e){}
    selection=support.iconSelection(Scene);
    if(selection.ok){model.setForm({kind:"exactLabel",pattern:support.iconNodeLabel(selection.node),icon:model.form.icon});model.baseline=JSON.stringify(model.form);}
    dialog.setAcceptButtonEnabled(model.editable);ui.saveButton.enabled=model.editable;
    populate();say((model.message||("Settings: "+model.status+"."))+(iconError?" "+iconError:"")+(selection.ok?"":" "+selection.message));
    try { while(dialog.exec()){capture();try{var saved=model.save();if(saved.ok)return {saved:true,config:support.clone(model.config),message:saved.message};populate();say(saved.message);}catch(e){say(String(e));}}return {saved:false}; }
    finally { try{if(connectedSelection)disconnect(Scene,"nodeSelectionListChanged()",selectionChanged);}catch(e){} dialog.deleteLater(); }
}

function WM2SettingsResetGenesis(support, config) {
    var next=support.clone(config),defaults=support.defaults().supportedFigures;
    for(var i=0;i<defaults.length;i++)if(next.supportedFigures.indexOf(defaults[i])<0)next.supportedFigures.push(defaults[i]);
    return next;
}
function WM2NoEligibleTransfers() {
    MessageBox.information("Nothing is eligible to move. Review transfer marks and Supported Figures > Protected Children. New custom types protect their current attachments, including clothing. Remove protection for the clothing you want to move, then reopen Wearables Manager.", "Wearables Manager", "&OK");
}
function WM2ShowProtectedChildren(resourcePath, config, figureName) {
    var support=WM2Support,children=support.protectedChildNames(config,figureName),ui=WM2SettingsDialog("Protected Children: "+figureName,resourcePath),dialog=ui.dialog,content=ui.content,layout=ui.layout,metrics=ui.metrics;
    layout.addWidget(WM2SettingsHeading(content,"Protected Children: "+figureName,"#FA8072"));
    layout.addWidget(WM2SettingsPlainLabel(content,"Select attached children in Scene, then Add Selected Children. Select this supported figure or one of its own bones to add every current attachment missing from the list. Intrinsic bones always stay attached and need no list entry; attached props and figures, including Tail and children beneath bones, are eligible. Protection uses actual internal child names and applies to every instance of this figure type. Protected subtrees and their carrying ancestors stay attached. Remove Protection allows selected list entries to move; automatic graft safety still applies. Save updates the parent draft; Save there writes settings."));
    var status=WM2SettingsPlainLabel(content,""),list=WM2SettingsEditorRows(content,layout,resourcePath,"No protected children. Select attached items in Scene, then Add Selected Children.",function(index){remove.enabled=index>=0&&index<children.length;});
    var actions=WM2SettingsRow(content,layout),add=WM2SettingsButton(actions.widget,"Add Selected Children",resourcePath,"Wearables Manager - Group.png"),remove=WM2SettingsButton(actions.widget,"Remove Protection",resourcePath,"Wearables Manager - Cancel.png");
    actions.layout.addWidget(add);actions.layout.addWidget(remove);layout.addWidget(status);
    function say(message){status.text=String(message);}
    function populate(selectedName,focus){var entries=[];for(var i=0;i<children.length;i++)entries.push({name:children[i],text:children[i],detail:""});list.populate(entries,selectedName,focus);}
    connect(add,"clicked()",function(){try{
        var base=support.setProtectedChildNames(config,figureName,children);if(!base.ok){say(base.message);return;}
        var result=support.addSelectedProtectedChildren(base.config,figureName,Scene);if(!result.ok){say(result.message);return;}
        var selectedName=list.currentItem>=0?list.entries[list.currentItem].name:null;
        if(!selectedName)for(var i=0;i<result.children.length;i++)if(children.indexOf(result.children[i])<0){selectedName=result.children[i];break;}
        children=result.children.slice(0);populate(selectedName,true);say(result.message+" Save updates this draft.");
    }catch(e){say(String(e));}});
    connect(remove,"clicked()",function(){var index=Number(list.currentItem);if(index<0||index>=children.length)return;var child=children.splice(index,1)[0];populate(children.length?children[Math.min(index,children.length-1)]:null,true);if(!children.length)try{add.getWidget().setFocus();}catch(e){}say("Removed protection for "+child+" in this draft.");});
    populate();say("Select children, their supported figure or one of its bones, then Add Selected Children. Missing names are added only on this explicit action; Save applies the draft.");
    try{while(dialog.exec()){var result=support.setProtectedChildNames(config,figureName,children);if(result.ok)return {saved:true,config:result.config};say(result.message);}return {saved:false};}
    finally{dialog.deleteLater();}
}
function WM2ShowSupportedFigures(resourcePath) {
    var support=WM2Support,model=WM2SettingsModel(support,resourcePath,""),ui=WM2SettingsDialog("Wearables Manager - Supported Figures",resourcePath),dialog=ui.dialog,content=ui.content,layout=ui.layout,metrics=ui.metrics;
    layout.addWidget(WM2SettingsHeading(content,"Supported Figures","#FA8072"));
    layout.addWidget(WM2SettingsPlainLabel(content,"The registry uses exact internal figure names, not labels. Select an independent figure or one of its bones, then Add Selected Figure. A new registry entry adds every current nonbone attachment, including clothing, Tail and children beneath bones, to any retained profile. Intrinsic bones always stay attached. Already registered customized profiles stay unchanged; Protected Children can explicitly fill missing names or allow movable items. Figure choices apply on the next run; saved protection also applies to an open transfer dialog."));
    var defaults=support.defaults().supportedFigures,status=WM2SettingsPlainLabel(content,""),list=WM2SettingsEditorRows(content,layout,resourcePath,"No visible supported figures. Select a figure in Scene, then Add Selected Figure.",function(index){remove.enabled=protect.enabled=model.editable&&index>=0&&index<list.entries.length;});
    var actions=WM2SettingsRow(content,layout),add=WM2SettingsButton(actions.widget,"Add Selected Figure",resourcePath,"Wearables Manager - Prop.png"),remove=WM2SettingsButton(actions.widget,"Remove",resourcePath,"Wearables Manager - Cancel.png"),reset=WM2SettingsButton(actions.widget,"Reset Genesis Defaults",resourcePath,"Wearables Manager - Group.png"),protect=WM2SettingsButton(actions.widget,"Protected Children...",resourcePath,"Wearables Manager - Ok.png");actions.layout.addWidget(add);actions.layout.addWidget(remove);actions.layout.addWidget(reset);actions.layout.addWidget(protect);layout.addWidget(status);
    function say(text){status.text=String(text);}
    function populate(selectedName,focus){var entries=[];for(var i=0;i<model.config.supportedFigures.length;i++){var name=model.config.supportedFigures[i];if(WM2SettingsVisibleFigure(name))entries.push({name:name,text:name,detail:(defaults.indexOf(name)>=0?"Genesis default":"Custom figure")+" | protected children: "+support.protectedChildNames(model.config,name).length});}list.populate(entries,selectedName,focus);}
    function selectedName(){var index=Number(list.currentItem);return index>=0&&index<list.entries.length?list.entries[index].name:null;}
    connect(add,"clicked()",function(){if(!model.editable)return;try{var result=support.addSupportedFigure(model.config,Scene.getPrimarySelection());if(!result.ok){say(result.message);return;}model.config=support.clone(result.config);populate(support.figureInternalName(result.figure),true);say("Internal name: "+support.figureInternalName(result.figure)+" | Visible label: "+support.iconNodeLabel(result.figure)+". "+result.message+" Save to apply.");}catch(e){say(String(e));}});
    connect(protect,"clicked()",function(){if(!model.editable)return;try{var name=selectedName();if(!name||model.config.supportedFigures.indexOf(name)<0)return;var result=WM2ShowProtectedChildren(resourcePath,model.config,name);if(result.saved){model.config=support.clone(result.config);populate(name,true);say("Protected children updated in this draft. Save to apply.");}}catch(e){say(String(e));}});
    connect(remove,"clicked()",function(){if(!model.editable)return;var removed=selectedName(),index=model.config.supportedFigures.indexOf(removed),visibleIndex=list.currentItem;if(index<0){say("Select a registry entry to remove.");return;}model.config.supportedFigures.splice(index,1);populate(null);if(list.entries.length)list.select(Math.min(visibleIndex,list.entries.length-1),true);else try{add.getWidget().setFocus();}catch(e){}say("Removed "+removed+" from this draft. Save to apply on the next run.");});
    connect(reset,"clicked()",function(){if(!model.editable)return;model.config=WM2SettingsResetGenesis(support,model.config);populate();say("Genesis defaults restored; custom entries kept. Save to apply on the next run.");});
    add.enabled=model.editable;reset.enabled=model.editable;dialog.setAcceptButtonEnabled(model.editable);ui.saveButton.enabled=model.editable;populate();say(model.message||("Settings: "+model.status+"."));
    try { while(dialog.exec()){try{var saved=model.save();if(saved.ok)return {saved:true,config:support.clone(model.config),message:saved.message};say(saved.message);}catch(e){say(String(e));}}return {saved:false}; }
    finally { dialog.deleteLater(); }
}
