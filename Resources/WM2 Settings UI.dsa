        var item=model.config.iconRules[index];model.config.iconRules[index]=model.config.iconRules[target];model.config.iconRules[target]=item;model.active=target;
        return response(true);
    };
    model.save = function () {
        if(!model.editable)return response(false,"These settings are read-only: "+model.message);
        if(model.dirty()){var committed=model.commit(false);if(!committed.ok)return committed;}
        var checked=WM2SettingsValidate(support,model.config);if(!checked.ok)return checked;
        var saved=support.save(resourcePath,checked.config,model.rawToken);
        if(!saved||saved.ok!==true)return response(false,saved&&saved.message?saved.message:"Settings could not be saved.");
        model.config=support.clone(saved.config || checked.config);model.rawToken=saved.rawToken;return {ok:true,config:model.config,message:String(saved.message || "")};
    };
