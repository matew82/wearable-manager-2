            return { ok: true, config: oFinal.config, message: bExisting ? "Figure type '" + sName + "' is already supported." : "Figure type '" + sName + "' is now supported.", figure: oFigure };
        } catch (e) { return { ok: false, config: oConfig, message: String(e), figure: oFigure }; }
    };
    oSupport.isProtectedCustomAttachment = function (oNode, oOwner, oConfig) {
        var arrNodes = sceneNodes(), oLiveOwner = live(oOwner, arrNodes);
        if (!supported(oLiveOwner, oConfig, arrNodes) || arrBuiltInNames.indexOf(internalName(oLiveOwner)) >= 0) return false;
        var oCurrent = live(oNode, arrNodes);
