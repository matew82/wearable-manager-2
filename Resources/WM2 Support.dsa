(function () {
var methods = {
/* ES5 members to append to WM2Support. No filesystem, scene mutation or UI calls. */
normalizeCopyLabel: function (value) {
    if (typeof value != "string") return "";
    return value.replace(/ \([0-9]+\)$/, "");
},

iconNodeName: function (node) {
    if (!node) return "";
    try {
        if (typeof node.name == "string") return node.name;
        if (typeof node.objectName == "string") return node.objectName;
        if (typeof node.getName == "function") {
            var value = node.getName();
            if (typeof value == "string") return value;
        }
        if (typeof node.objectName == "function") {
            var value = node.objectName();
            if (typeof value == "string") return value;
        }
    } catch (e) {}
    return "";
},

iconNodeLabel: function (node) {
    if (!node) return "";
    try {
        if (typeof node.getLabel == "function") {
            var value = node.getLabel();
            if (typeof value == "string") return value;
        }
        if (typeof node.label == "string") return node.label;
    } catch (e) {}
    return "";
},

// Literal matching: both edges must be a string edge or an allowed separator.
containsIconWord: function (value, pattern) {
    if (typeof value != "string" || typeof pattern != "string" || pattern.length == 0) return false;
    value=value.toLowerCase();pattern=pattern.toLowerCase();
