    oSupport.isCustomFigure = function (oNode, oConfig) {
        return supported(oNode, oConfig, sceneNodes()) && arrBuiltInNames.indexOf(internalName(oNode)) < 0;
    };
    oSupport.addSupportedFigure = function (oConfig, oNode) {
        var oFigure = null;
        try {
            if (typeof oSupport.validate !== "function" || typeof oSupport.clone !== "function") throw new Error("Supported-figure configuration services are unavailable.");
            var oValidated = oSupport.validate(oConfig);
            if (!oValidated.ok) return { ok: false, config: oConfig, message: oValidated.message, figure: null };
            oFigure = selected(oNode, sceneNodes());
            if (!oFigure) return { ok: false, config: oConfig, message: "Select a live independent figure or one of its bones. A fitted wearable or attached figure cannot be registered as an owner.", figure: null };
            var sName = internalName(oFigure);
            if (!sName) return { ok: false, config: oConfig, message: "The figure must have a nonempty internal name.", figure: oFigure };
            var oNext = oSupport.clone(oValidated.config), bExisting = oNext.supportedFigures.indexOf(sName) >= 0;
            if (!bExisting) oNext.supportedFigures.push(sName);
            var oFinal = oSupport.validate(oNext);
