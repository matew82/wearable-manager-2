        if ((index == 0 || /[\s0-9_!\-\u2010-\u2015]/.test(value.charAt(index - 1))) &&
            (end == value.length || /[\s0-9_!\-\u2010-\u2015]/.test(value.charAt(end)))) return true;
        offset = index + 1;
    }
    return false;
},

matchIcon: function (rules, node) {
