    if (!node || !Array.isArray(rules)) return none;
    var name = this.iconNodeName(node).toLowerCase(), label = this.iconNodeLabel(node).toLowerCase();
    var exactLabel = this.normalizeCopyLabel(label), best = null;
    for (var i = 0; i < rules.length; i++) {
        var rule = rules[i];
        if (!rule || typeof rule.pattern != "string" || rule.pattern.length == 0 || typeof rule.icon != "string" || rule.icon.length == 0) continue;
        var rank = 2, length = 0, fieldRank = 0, matched = false;
