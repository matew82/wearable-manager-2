        var arrNames = names(oConfig), oLive = live(oNode, sceneNodes());
        if (!arrNames || !oLive || !figureType(oLive)) return false;
        var sName = internalName(oLive);
        return !!sName && arrNames.indexOf(sName) >= 0;
    };
    oSupport.isCustomFigure = function (oNode, oConfig) {
        return supported(oNode, oConfig, sceneNodes()) && arrBuiltInNames.indexOf(internalName(oNode)) < 0;
    };
    oSupport.addSupportedFigure = function (oConfig, oNode) {
        var oFigure = null;
        try {
            if (typeof oSupport.validate !== "function" || typeof oSupport.clone !== "function") throw new Error("Supported-figure configuration services are unavailable.");
            var oValidated = oSupport.validate(oConfig);
            if (!oValidated.ok) return { ok: false, config: oConfig, message: oValidated.message, figure: null };
            oFigure = selected(oNode, sceneNodes());
            if (!oFigure) return { ok: false, config: oConfig, message: "Select a live independent figure or one of its bones. A fitted wearable or attached figure cannot be registered as an owner.", figure: null };
            var sName = internalName(oFigure);
            if (!sName) return { ok: false, config: oConfig, message: "The figure must have a nonempty internal name.", figure: oFigure };
            var oNext = oSupport.clone(oValidated.config), bExisting = oNext.supportedFigures.indexOf(sName) >= 0;
            if (!bExisting) oNext.supportedFigures.push(sName);
            var seeded=0,hasProfile=false;
            for(var p=0;p<oNext.protectedChildren.length;p++)if(oNext.protectedChildren[p].figure===sName)hasProfile=true;
            if(arrBuiltInNames.indexOf(sName)<0 && !hasProfile) {
                var nodes=sceneNodes(),children=[],seen={};
                if(!nodes || nodes.length>20000)throw new Error("Cannot safely enumerate this figure's attached children.");
                validateSubtree(oFigure,nodes);
                for(var c=0;c<nodes.length;c++) {
                    var child=live(nodes[c],nodes);
                    if(!child)throw new Error("Scene contains ambiguous or unavailable node identities.");
                    if(same(child,oFigure) || child.inherits("DzBone"))continue;
                    if(!below(child,oFigure,nodes))continue;
                    var childName=internalName(child);
                    if(!childName)throw new Error("An attached child has no readable internal name; registration was not applied.");
                    if(!Object.prototype.hasOwnProperty.call(seen,"_"+childName)){seen["_"+childName]=true;children.push(childName);}
                }
                oNext.protectedChildren.push({figure:sName,children:children});seeded=children.length;
            }
            var oFinal = oSupport.validate(oNext);
            if (!oFinal.ok) return { ok: false, config: oConfig, message: oFinal.message, figure: oFigure };
            return { ok: true, config: oFinal.config, message: (bExisting ? "Figure type '" + sName + "' is already supported." : "Figure type '" + sName + "' is now supported.") + (seeded ? " Protected " + seeded + " attached child names, including clothing. Review Protected Children to allow movable items." : ""), figure: oFigure };
        } catch (e) { return { ok: false, config: oConfig, message: String(e), figure: oFigure }; }
    };
    oSupport.isProtectedCustomAttachment = function (oNode, oOwner, oConfig, knownNodes) {
        var arrNodes = knownNodes || sceneNodes(), oLiveOwner = live(oOwner, arrNodes);
        if (!supported(oLiveOwner, oConfig, arrNodes) || arrBuiltInNames.indexOf(internalName(oLiveOwner)) >= 0) return false;
        var oCurrent = live(oNode, arrNodes);
        if (!oCurrent) return true;
        try {
            if (same(oCurrent, oLiveOwner)) return true;
            // DzSkeleton has no graft list; DzFigure provides this documented API.
            if (!oLiveOwner.inherits("DzFigure")) return false;
            if (typeof oLiveOwner.getNumGraftFigures !== "function" || typeof oLiveOwner.getGraftFigure !== "function") return true;
            var nCount = oLiveOwner.getNumGraftFigures(), arrGrafts = [];
            if (typeof nCount !== "number" || !isFinite(nCount) || nCount < 0 || Math.floor(nCount) !== nCount || nCount > arrNodes.length) return true;
            for (var i = 0; i < nCount; i++) {
                var oGraft = live(oLiveOwner.getGraftFigure(i), arrNodes);
                if (!oGraft) return true; // Unknown graft ownership is preserved, not guessed.
                arrGrafts.push(oGraft);
            }
            var arrSeen = [];
            while (oCurrent && !same(oCurrent, oLiveOwner)) {
                for (var i = 0; i < arrGrafts.length; i++) if (same(oCurrent, arrGrafts[i])) return true;
                for (var i = 0; i < arrSeen.length; i++) if (same(oCurrent, arrSeen[i])) return true;
                arrSeen.push(oCurrent);
                if (arrSeen.length > arrNodes.length) return true;
                var oParent = oCurrent.getNodeParent();
                if (!oParent) return false;
                oCurrent = live(oParent, arrNodes);
                if (!oCurrent) return true;
            }
            return false;
        } catch (e) { return true; }
    };
    function below(node,ancestor,nodes) {
        var current=node,seen=[];
        while(current) {
            if(same(current,ancestor))return true;
            for(var i=0;i<seen.length;i++)if(same(seen[i],current))throw new Error("Child ancestry contains a cycle.");
            seen.push(current);if(seen.length>nodes.length)throw new Error("Child ancestry is unavailable.");
            current=current.getNodeParent();
            if(current){current=live(current,nodes);if(!current)throw new Error("Child ancestry is ambiguous or unavailable.");}
        }
        return false;
    }
    function validateSubtree(root,nodes) {
        if(typeof root.getNodeChildren!=="function")throw new Error("Child enumeration is unavailable.");
        var queue=[root],seen=[];
        while(queue.length){
            var parent=queue.pop();
            for(var s=0;s<seen.length;s++)if(same(seen[s],parent))throw new Error("Child hierarchy contains a cycle or duplicate.");
            seen.push(parent);if(seen.length>nodes.length)throw new Error("Child hierarchy exceeds live Scene nodes.");
            if(typeof parent.getNodeChildren!=="function")throw new Error("Child enumeration is unavailable.");
            var children=parent.getNodeChildren(false),count=children && children.length;
            if(typeof count!=="number" || !isFinite(count) || count<0 || Math.floor(count)!==count || count>nodes.length)throw new Error("Child enumeration is unavailable.");
            for(var c=0;c<count;c++){
                var child=live(children[c],nodes);
                if(!child || !same(live(child.getNodeParent(),nodes),parent))throw new Error("Child ownership changed or its node is unavailable.");
                queue.push(child);
            }
        }
    }
    oSupport.figureInternalName=internalName;
    oSupport.protectedChildNames=function(config,figureName) {
        var checked=oSupport.validate(config);if(!checked.ok)throw new Error(checked.message);
        for(var i=0;i<checked.config.protectedChildren.length;i++)if(checked.config.protectedChildren[i].figure===figureName)return checked.config.protectedChildren[i].children.slice(0);
        return [];
    };
    oSupport.setProtectedChildNames=function(config,figureName,children) {
        try {
        var checked=oSupport.validate(config);if(!checked.ok)return checked;
        var next=oSupport.clone(checked.config),found=false;
        for(var i=0;i<next.protectedChildren.length;i++)if(next.protectedChildren[i].figure===figureName){next.protectedChildren[i].children=oSupport.clone(children);found=true;break;}
        if(!found)next.protectedChildren.push({figure:figureName,children:oSupport.clone(children)});
        return oSupport.validate(next);
        }catch(e){return {ok:false,config:null,message:"Protected children could not be updated: "+String(e)};}
    };
    oSupport.isProtectedTransfer=function(node,owner,config,knownNodes) {
        try {
            var nodes=knownNodes || sceneNodes(),current=live(node,nodes),main=live(owner,nodes);
            if(!nodes || nodes.length>20000 || !current || !supported(main,config,nodes) || same(current,main) || current.inherits("DzBone"))return true;
            validateSubtree(current,nodes);
            if(!below(current,main,nodes))return true;
            var protectedNames=oSupport.protectedChildNames(config,internalName(main)),ancestor=current;
            while(ancestor && !same(ancestor,main)){
                if(protectedNames.indexOf(internalName(ancestor))>=0)return true;
                ancestor=live(ancestor.getNodeParent(),nodes);
            }
            if(oSupport.isProtectedCustomAttachment(current,main,config,nodes))return true;
            // Reparenting carries a whole subtree, including descendants omitted
            // from the UI. Check its live graph again before any mutation.
            for(var n=0;n<nodes.length;n++){
                var child=live(nodes[n],nodes);if(!child)return true;
                if(child.inherits("DzBone") || same(child,current) || !below(child,current,nodes))continue;
                if(protectedNames.indexOf(internalName(child))>=0 || oSupport.isProtectedCustomAttachment(child,main,config,nodes) || (figureType(child) && names(config).indexOf(internalName(child))>=0))return true;
            }
            return false;
        }catch(e){return true;}
    };
    return oSupport;
}
WM2InstallSupportedFigures(WM2Support);

