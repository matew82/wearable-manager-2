// ES5 module extension. Append to the central WM2Support module and invoke once:
// WM2InstallSupportedFigures(WM2Support). No Scene/configuration writes occur here.
function WM2InstallSupportedFigures(oSupport) {
    if (!oSupport || typeof oSupport !== "object") throw new Error("Wearables support module is unavailable.");
    if (typeof oSupport.defaults !== "function") throw new Error("Wearables support defaults are unavailable.");
    var oDefaults = oSupport.defaults();
    if (!oDefaults || oDefaults.schema !== 1 || !Array.isArray(oDefaults.supportedFigures)) throw new Error("Wearables support defaults are invalid.");
    // The shared configuration factory is the sole source of shipped defaults.
    var arrBuiltInNames = oDefaults.supportedFigures.slice(0);

    function key(oNode) {
        if (!oNode) return null;
        try {
            if (!oNode.inherits("DzNode")) return null;
            var vID = oNode.elementID;
            if (vID === null || typeof vID === "undefined") return null;
            var sID = String(vID), sClass = String(oNode.className());
            return sID && sClass ? { id: sID, type: sClass } : null;
        } catch (e) { return null; }
    }
    function same(oA, oB) {
        var a = key(oA), b = key(oB);
        return !!(a && b && a.id === b.id && a.type === b.type);
    }
    function sceneNodes() {
        try { return Scene.getNodeList(); } catch (e) { return null; }
    }
    function live(oNode, arrNodes) {
        var oKey = key(oNode), oFound = null;
        if (!oKey || !arrNodes) return null;
        for (var i = 0; i < arrNodes.length; i++) {
            if (!same(oNode, arrNodes[i])) continue;
            if (oFound) return null; // Repeated session identity is ambiguous, regardless of name.
            oFound = arrNodes[i];
        }
        return oFound;
    }
    function internalName(oNode) {
        try { return typeof oNode.name === "string" ? oNode.name : ""; } catch (e) { return ""; }
    }
    function names(oConfig) {
        if (!oConfig && typeof oSupport.defaults === "function") oConfig = oSupport.defaults();
        return oConfig && oConfig.schema === 1 && Array.isArray(oConfig.supportedFigures) ? oConfig.supportedFigures : null;
    }
    function skeleton(oNode) {
        return !!(oNode && oNode.inherits("DzSkeleton") && !oNode.inherits("DzBone") && !oNode.inherits("DzGroupNode"));
    }
    function figureType(oNode) {
        try { return !!(skeleton(oNode) && typeof oNode.getFollowTarget === "function" && !oNode.getFollowTarget()); }
        catch (e) { return false; }
    }
    function mainFigure(oNode, arrNodes) {
        try {
            if (!figureType(oNode)) return false;
            // A figure still parented under another skeleton/bone is an attachment,
            // even while its FitTo is temporarily detached for storage.
            var oParent = oNode.getNodeParent(), arrSeen = [];
            while (oParent) {
                oParent = live(oParent, arrNodes);
                if (!oParent || oParent.inherits("DzBone") || oParent.inherits("DzSkeleton")) return false;
                for (var i = 0; i < arrSeen.length; i++) if (same(arrSeen[i], oParent)) return false;
                arrSeen.push(oParent);
                if (arrSeen.length > arrNodes.length) return false;
                oParent = oParent.getNodeParent();
            }
            return true;
        } catch (e) { return false; }
    }
    function selected(oNode, arrNodes) {
        oNode = live(oNode, arrNodes);
        if (!oNode) return null;
        try {
            if (!oNode.inherits("DzBone")) return mainFigure(oNode, arrNodes) ? oNode : null;
            var oBone = oNode, oCurrent = oBone, arrSeen = [];
            while (oCurrent && oCurrent.inherits("DzBone")) {
                for (var i = 0; i < arrSeen.length; i++) if (same(arrSeen[i], oCurrent)) return null;
                arrSeen.push(oCurrent);
                if (arrSeen.length > arrNodes.length) return null;
                oCurrent = live(oCurrent.getNodeParent(), arrNodes);
            }
            if (!oCurrent || !mainFigure(oCurrent, arrNodes)) return null;
            // getSkeleton is documented on DzNode. If available, it must agree with
            // the bone-only parent chain; never cross an arbitrary group or prop.
            if (typeof oBone.getSkeleton === "function" && !same(oBone.getSkeleton(), oCurrent)) return null;
            return oCurrent;
        } catch (e) { return null; }
    }
    function supported(oNode, oConfig, arrNodes) {
        var arrNames = names(oConfig), oLive = live(oNode, arrNodes);
        if (!arrNames || !oLive || !mainFigure(oLive, arrNodes)) return false;
        var sName = internalName(oLive);
        return !!sName && arrNames.indexOf(sName) >= 0;
    }

    oSupport.builtInFigureNames = function () { return arrBuiltInNames.slice(0); };
    oSupport.selectedFigure = function (oNode) { return selected(oNode, sceneNodes()); };
    oSupport.isSupportedFigure = function (oNode, oConfig) { return supported(oNode, oConfig, sceneNodes()); };
