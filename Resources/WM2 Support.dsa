            rank = 3; length = rule.pattern.length; fieldRank = 0;
            matched = label.indexOf(rule.pattern.toLowerCase()) == 0;
        } else if (rule.kind == "namePrefix") {
            rank = 3; length = rule.pattern.length; fieldRank = 1;
            matched = name.indexOf(rule.pattern.toLowerCase()) == 0;
        } else continue;
        if (!matched) continue;
        if (!best || rank < best.rank || (rank == best.rank && rank >= 2 && (length > best.length || (length == best.length && fieldRank < best.fieldRank)))) {
            best = {rank:rank, length:length, fieldRank:fieldRank, icon:rule.icon, ruleIndex:i, kind:rule.kind, pattern:rule.pattern};
        }
    }
    return best ? {matched:true, icon:best.icon, ruleIndex:best.ruleIndex, kind:best.kind, pattern:best.pattern} : none;
},

// Host lists are indexed collections, not necessarily native JavaScript Arrays.
iconNodeCollection: function (nodes, limit) {
    if(nodes === null || typeof nodes === "undefined")nodes=[];
